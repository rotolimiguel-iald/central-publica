+    'TGLExt/SimLiteral.lean': 'import TGLExt.SimBase\nset_option autoImplicit false\n\nnamespace TGLExt.SimTM2\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao\n\nprivate abbrev Tape := List Simbolo\nprivate abbrev Ticks (i : ℕ) := List.replicate i Simbolo.tick\nprivate abbrev bitSymbol (b : Bool) : Simbolo := if b then .um else .zero\nprivate abbrev nextLabel (answer : Bool) : Rotulo :=\n  if answer then .saltarResto else .proximoLiteralCheck\nprivate abbrev branchLabel (answer : Bool) : Rotulo :=\n  if answer then .clausulaSatisfeita else .proximoLiteral\n\nprivate theorem sameLiteralTapes (l : Option Rotulo) (v : Estado)\n    (a b : (k : PilhaK) → List (stackAlphabet k)) (h : ∀ k, a k = b k) :\n    some (⟨l, v, a⟩ : Config) = some (⟨l, v, b⟩ : Config) := by rw [funext h]\n\nlocal macro "litstep" : tactic =>\n  `(tactic| (simp [Ticks, bitSymbol, nextLabel, branchLabel, codificaBits, codificaLiteral,\n      Turing.FinTM2.step, Turing.TM2.step, aMaquinaTM2, cfg, oPrograma, Turing.TM2.stepAux,\n      *] <;> refine sameLiteralTapes _ _ _ _ (fun k => ?_) <;> cases k <;> rfl))\n\n/-- Passa todos os ticks do literal para a pilha de trabalho. O primeiro símbolo\nda continuação é preservado, mesmo quando a continuação é vazia. -/\nprivate theorem moveTicks (i a : ℕ) (tail input : Tape)\n    (safe : tail.head? ≠ some Simbolo.tick) (h : Option Simbolo) (pol route : Bool) :\n    ∃ h\', Runs (i+1)\n      (cfg .andarTicks (h,pol,route) input (Ticks i ++ tail) (Ticks a) [])\n      (cfg .andarBits (h\',pol,false) input tail (Ticks (a+i)) []) := by\n  induction i generalizing a h route with\n  | zero =>\n    refine ⟨h, Runs.one ?_⟩\n    simp only [Nat.add_zero, List.replicate_zero, List.nil_append]\n    litstep\n  | succ i ih =>\n    have first : Runs 1\n        (cfg .andarTicks (h,pol,route) input (Ticks (i+1) ++ tail) (Ticks a) [])\n        (cfg .andarTicks (some .tick,pol,true) input (Ticks i ++ tail) (Ticks (a+1)) []) := by\n      apply Runs.one\n      simp only [Ticks, List.replicate_succ, List.cons_append]\n      litstep\n    obtain ⟨h\', rest⟩ := ih (a+1) (some .tick) true\n    refine ⟨h\', ?_⟩\n    simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using first.trans rest\n\n/-- Os bits salvos formam uma pilha em ordem inversa. Restaurá-la devolve os\nbits à testemunha e deixa o depósito vazio antes de saltar. -/\nprivate theorem restoreBits (saved input tail : Tape) (h : Option Simbolo) (flag ok : Bool) :\n    ∃ t, Runs (saved.length+1)\n      (cfg .restaurar (h,flag,ok) input tail [] saved)\n      (cfg (nextLabel ok) t (saved.reverse ++ input) tail [] []) := by\n  induction saved generalizing input h flag with\n  | nil =>\n    refine ⟨(h,true,ok), Runs.one ?_⟩\n    cases ok <;> litstep\n  | cons a saved ih =>\n    have first : Runs 1\n        (cfg .restaurar (h,flag,ok) input tail [] (a::saved))\n        (cfg .restaurar (some a,false,ok) (a::input) tail [] saved) := by\n      apply Runs.one\n      litstep\n    obtain ⟨t, rest⟩ := ih (a::input) (some a) false\n    refine ⟨t, ?_⟩\n    simpa [List.reverse_cons, List.append_assoc, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]\n      using first.trans rest\n\nprivate theorem compareBit (found : Option Bool) (pol route : Bool) (saved input tail : Tape) :\n    ∃ t, Runs (saved.length+3)\n      (cfg .comparar (found.map bitSymbol,pol,route) input tail [] saved)\n      (cfg (nextLabel (found == some pol)) t (saved.reverse ++ input) tail [] []) := by\n  let ok := found == some pol\n  have first : Runs 1\n      (cfg .comparar (found.map bitSymbol,pol,route) input tail [] saved)\n      (cfg (branchLabel ok) (none,ok,route) input tail [] saved) := by\n    apply Runs.one\n    dsimp only [ok]\n    cases found with\n    | none => cases pol <;> litstep\n    | some b => cases b <;> cases pol <;> litstep\n  have middle (q : Bool) : Runs 1\n      (cfg (branchLabel q) (none,q,route) input tail [] saved)\n      (cfg .restaurar (none,q,q) input tail [] saved) := by\n    apply Runs.one\n    cases q <;> litstep\n  obtain ⟨t, rest⟩ := restoreBits saved input tail none ok ok\n  exact ⟨t, ((first.trans (middle ok)).trans rest).mono (by omega)⟩\n\n/-- Se a testemunha acabar cedo, a máquina consome o índice restante e compara\ncom none. Nenhuma polaridade satisfaz um literal cujo bit está ausente. -/\nprivate theorem discardTicks (i : ℕ) (tail saved : Tape) (h : Option Simbolo) (pol route : Bool) :\n    Runs (i+1) (cfg .esvaziarTicks (h,pol,route) [] tail (Ticks i) saved)\n      (cfg .comparar (none,pol,true) [] tail [] saved) := by\n  induction i generalizing h route with\n  | zero => apply Runs.one; litstep\n  | succ i ih =>\n    have first : Runs 1\n        (cfg .esvaziarTicks (h,pol,route) [] tail (Ticks (i+1)) saved)\n        (cfg .esvaziarTicks (h,pol,false) [] tail (Ticks i) saved) := by\n      apply Runs.one\n      rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n      litstep\n    exact (first.trans (ih h false)).mono (by omega)\n\nprivate theorem lookupBit (i : ℕ) (bs : List Bool) (saved tail : Tape)\n    (h : Option Simbolo) (pol route : Bool) :\n    ∃ t, Runs (2*i + saved.length + 6)\n      (cfg .andarBits (h,pol,route) (codificaBits bs) tail (Ticks i) saved)\n      (cfg (nextLabel (bs[i]? == some pol)) t (saved.reverse ++ codificaBits bs) tail [] []) := by\n  induction i generalizing bs saved h route with\n  | zero =>\n    have first : Runs 1\n        (cfg .andarBits (h,pol,route) (codificaBits bs) tail [] saved)\n        (cfg .lerBitAtual (h,pol,true) (codificaBits bs) tail [] saved) := by\n      apply Runs.one; litstep\n    have second : Runs 1\n        (cfg .lerBitAtual (h,pol,true) (codificaBits bs) tail [] saved)\n        (cfg .comparar (bs[0]?.map bitSymbol,pol,true) (codificaBits bs) tail [] saved) := by\n      apply Runs.one\n      cases bs <;> litstep\n    obtain ⟨t, rest⟩ := compareBit bs[0]? pol true saved (codificaBits bs) tail\n    exact ⟨t, ((first.trans second).trans rest).mono (by omega)⟩\n  | succ i ih =>\n    cases bs with\n    | nil =>\n      have first : Runs 1\n          (cfg .andarBits (h,pol,route) [] tail (Ticks (i+1)) saved)\n          (cfg .esvaziarTicks (h,pol,true) [] tail (Ticks (i+1)) saved) := by\n        apply Runs.one\n        rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n        litstep\n      have drain := discardTicks (i+1) tail saved h pol true\n      obtain ⟨t, rest⟩ := compareBit none pol true saved [] tail\n      refine ⟨t, ?_⟩\n      simpa only [List.getElem?_nil, codificaBits, List.map_nil] using\n        ((first.trans drain).trans rest).mono (show 1 + (i+1+1) + (saved.length+3) ≤\n          2*(i+1) + saved.length + 6 by omega)\n    | cons b bs =>\n      have first : Runs 1\n          (cfg .andarBits (h,pol,route) (codificaBits (b::bs)) tail (Ticks (i+1)) saved)\n          (cfg .andarBits (some (bitSymbol b),pol,false) (codificaBits bs) tail\n            (Ticks i) (bitSymbol b :: saved)) := by\n        apply Runs.one\n        rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n        litstep\n      obtain ⟨t, rest⟩ := ih bs (bitSymbol b :: saved) (some (bitSymbol b)) false\n      refine ⟨t, ?_⟩\n      have walk := (first.trans rest).mono (show\n        1 + (2*i + (bitSymbol b :: saved).length + 6) ≤ 2*(i+1) + saved.length + 6 by\n          simp only [List.length_cons]; omega)\n      simpa [List.reverse_cons, List.append_assoc, codificaBits] using walk\n\n/-- Uma leitura real do TM2 verifica o literal, consome somente sua codificação\ne restitui a testemunha inteira, também para índices fora da fita. -/\ntheorem literal_run (p : ℕ × Bool) (bs : List Bool) (tail : List Simbolo)\n    (safe : tail.head? ≠ some Simbolo.tick) (s : Estado) :\n    ∃ t : Estado, Runs (4*p.1+9)\n      (cfg .lerLiteral s (codificaBits bs) (codificaLiteral p ++ tail) [] [])\n      (cfg (if (bs[p.1]? == some p.2) then .saltarResto else .proximoLiteralCheck)\n        t (codificaBits bs) tail [] []) := by\n  rcases p with ⟨i, pol⟩\n  have first : Runs 1\n      (cfg .lerLiteral s (codificaBits bs) (codificaLiteral (i,pol) ++ tail) [] [])\n      (cfg .andarTicks (s.1,pol,s.2.2) (codificaBits bs) (Ticks i ++ tail) [] []) := by\n    apply Runs.one\n    cases pol <;> litstep\n  obtain ⟨h, ticks⟩ := moveTicks i 0 tail (codificaBits bs) safe s.1 pol s.2.2\n  rw [Nat.zero_add] at ticks\n  obtain ⟨t, rest⟩ := lookupBit i bs [] tail h pol false\n  refine ⟨t, ?_⟩\n  exact ((first.trans ticks).trans rest).mono (by simp; omega)\n\nend TGLExt.SimTM2\n',
+    'TGLExt/SondaContagem.lean': "import TGLExt.EntregaBeta\nset_option autoImplicit false\n\n/-!\n# O produtor da leitura β conta as soluções\n\nA leitura β (`Codex.EntregaBeta`) deixa como hipótese `hr` um produtor `reader : CNF n → ℕ` cujo numerador\ndiádico aproxima a soma normalizada com erro ≤ 1/(4·2ⁿ), no relógio `clock m n` fixado por β. Este módulo prova\ntrês coisas sobre essa hipótese de precisão:\n\n1. ela é habitada: o numerador `4 · contaSolucoes φ` a cumpre;\n2. ela determina o número de soluções: todo produtor que a cumpre dá `(reader φ + 1) / 4 = contaSolucoes φ`;\n3. com `TGLExt.TraducaoTuring.o_que_sou_das_solucoes`, esse número dividido por 2ⁿ é a leitura\n   `oQueSou (nomeDasSolucoes (custoCNF φ))`.\n\nLogo o produtor que falta é essa leitura escrita na fita: contar as soluções de toda CNF, não só decidir se há\numa. A decisão `2 ≤ reader φ` é `0 < contaSolucoes φ`.\n-/\n\nnamespace TGLExt.SondaContagem\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.AContagemEACarga TGLExt.OPassoEOFim\nopen Codex.RelogioBeta Codex.LeituraBeta Codex.PonteLeituraBeta\n\nvariable {n : ℕ}\n\n/-- O número de soluções da fórmula: as atribuições de custo zero. -/\ndef contaSolucoes (φ : CNF n) : ℕ :=\n  (Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0)).card\n\n/-- A fórmula é satisfazível exatamente quando há ao menos uma solução. -/\ntheorem sat_sse_ha_solucao (φ : CNF n) : SAT φ ↔ 0 < contaSolucoes φ := by\n  rw [sat_e_existir_custo_zero, contaSolucoes, Finset.card_pos, Finset.filter_nonempty_iff]\n  simp\n\n/-- Cada solução pesa exatamente 1 na soma; as demais atribuições pesam ≥ 0. -/\ntheorem a_soma_cobre_as_solucoes (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    (contaSolucoes φ : ℝ) ≤ weightedSum c k φ := by\n  unfold contaSolucoes weightedSum\n  have h1 : ((Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0)).card : ℝ)\n      = ∑ x ∈ Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0),\n          (1 - c.beta) ^ (k * custoCNF φ x) := by\n    rw [Finset.card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]\n    refine Finset.sum_congr rfl (fun x hx => ?_)\n    rw [(Finset.mem_filter.mp hx).2, Nat.mul_zero, pow_zero]\n  rw [h1]\n  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)\n    (fun y _ _ => pow_nonneg (sub_nonneg.mpr c.beta_lt_one.le) _)\n\n/-- No relógio de β, o que não é solução soma menos de 1/4. -/\ntheorem a_soma_passa_das_solucoes_por_menos_de_um_quarto (c : TGLCoupling) (k : ℕ) (φ : CNF n)\n    (hk : ((n : ℝ) + 2) * Real.log 2 / c.beta < k) :\n    weightedSum c k φ < (contaSolucoes φ : ℝ) + 1 / 4 := by\n  let s : ℝ := (k : ℝ) * (-Real.log (1 - c.beta))\n  have hs : ((n : ℝ) + 2) * Real.log 2 < s := effective_time_gt c n k hk\n  have hs0 : 0 ≤ s := le_of_lt (lt_of_le_of_lt\n    (mul_nonneg (by positivity) (Real.log_nonneg one_le_two)) hs)\n  have hsum := TGLExt.AEscala.a_flutuacao_do_fundo_e_cotada (custoCNF φ) hs0\n  have hN : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n    rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]\n    norm_num\n  rw [hN] at hsum\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have hexp : Real.exp (-s) < Real.exp (-((n : ℝ) * Real.log 2)) / 4 := by\n    have hlt := Real.exp_lt_exp.mpr (show -s < -((n : ℝ) * Real.log 2) - 2 * Real.log 2 by nlinarith)\n    have he2 : Real.exp (2 * Real.log 2) = (4 : ℝ) := by\n      rw [show (2 : ℝ) * Real.log 2 = Real.log 2 + Real.log 2 by ring,\n        Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 2)]\n      norm_num\n    rw [Real.exp_sub, he2] at hlt\n    exact hlt\n  have he : Real.exp (-((n : ℝ) * Real.log 2)) = ((2 : ℝ) ^ n)⁻¹ := by\n    rw [Real.exp_neg, Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2)]\n  rw [he] at hexp\n  have htail : (2 : ℝ) ^ n * Real.exp (-s) < 1 / 4 := by\n    calc\n      _ < (2 : ℝ) ^ n * (((2 : ℝ) ^ n)⁻¹ / 4) := mul_lt_mul_of_pos_left hexp hp\n      _ = 1 / 4 := by rw [← mul_div_assoc, mul_inv_cancel₀ hp.ne']\n  unfold weightedSum contaSolucoes\n  rw [a_soma_depois_de_k_passos φ c.beta c.beta_lt_one k]\n  exact lt_of_le_of_lt hsum (by linarith)\n\n/-- O numerador diádico em reais: `dyadic n j = (j/4)/2ⁿ`. -/\ntheorem dyadic_em_reais (j : ℕ) : ((dyadic n j : ℚ) : ℝ) = ((j : ℝ) / 4) / (2 : ℝ) ^ n := by\n  unfold dyadic\n  push_cast\n  rw [pow_add]\n  ring\n\n/-- O numerador que aproxima a soma com erro ≤ 1/4 determina o número de soluções. -/\ntheorem o_numerador_determina (j K : ℕ) (W : ℝ) (hlo : (K : ℝ) ≤ W) (hhi : W < (K : ℝ) + 1 / 4)\n    (h : |(j : ℝ) / 4 - W| ≤ 1 / 4) : (j + 1) / 4 = K := by\n  have hab := abs_le.mp h\n  have h1 : 4 * (K : ℝ) ≤ (j : ℝ) + 1 := by linarith [hab.1]\n  have h2 : (j : ℝ) < 4 * (K : ℝ) + 2 := by linarith [hab.2]\n  have h1n : 4 * K ≤ j + 1 := by exact_mod_cast h1\n  have h2n : j < 4 * K + 2 := by exact_mod_cast h2\n  omega\n\n/-- ★ O CONTADOR CUMPRE A PRECISÃO: o numerador `4 · contaSolucoes φ` satisfaz a hipótese de precisão `hr`,\npara toda fórmula; a hipótese é habitada. -/\ntheorem o_contador_cumpre_a_precisao (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    |(dyadic n (4 * contaSolucoes φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n) := by\n  have hlo := a_soma_cobre_as_solucoes c (clock m n) φ\n  have hhi := a_soma_passa_das_solucoes_por_menos_de_um_quarto c (clock m n) φ (clock_sufficient c m hm n)\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have h4 : (0 : ℝ) < 4 * (2 : ℝ) ^ n := by positivity\n  have hd : ((dyadic n (4 * contaSolucoes φ) : ℚ) : ℝ) = (contaSolucoes φ : ℝ) / (2 : ℝ) ^ n := by\n    rw [dyadic_em_reais]\n    push_cast\n    ring\n  rw [hd]\n  unfold normalizedSum\n  rw [← sub_div, abs_div, abs_of_pos hp, abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr hlo),\n    div_le_div_iff₀ hp h4]\n  have hq : (weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * 4 ≤ 1 := by linarith\n  calc (weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * (4 * (2 : ℝ) ^ n)\n      = ((weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * 4) * (2 : ℝ) ^ n := by ring\n    _ ≤ 1 * (2 : ℝ) ^ n := mul_le_mul_of_nonneg_right hq hp.le\n\n/-- ★ TODO PRODUTOR COM A PRECISÃO CONTA AS SOLUÇÕES: qualquer `reader` que cumpra a hipótese de precisão `hr`\ndevolve, em cada fórmula, o número de soluções: `(reader φ + 1) / 4 = contaSolucoes φ`. -/\ntheorem todo_produtor_com_a_precisao_conta_as_solucoes (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) : (reader φ + 1) / 4 = contaSolucoes φ := by\n  have hlo := a_soma_cobre_as_solucoes c (clock m n) φ\n  have hhi := a_soma_passa_das_solucoes_por_menos_de_um_quarto c (clock m n) φ (clock_sufficient c m hm n)\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have h4 : (0 : ℝ) < 4 * (2 : ℝ) ^ n := by positivity\n  have h := hr φ\n  rw [dyadic_em_reais] at h\n  unfold normalizedSum at h\n  rw [← sub_div, abs_div, abs_of_pos hp, div_le_div_iff₀ hp h4] at h\n  have hmul : (|((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * 4) * (2 : ℝ) ^ n\n      ≤ 1 * (2 : ℝ) ^ n := by\n    calc (|((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * 4) * (2 : ℝ) ^ n\n        = |((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * (4 * (2 : ℝ) ^ n) := by ring\n      _ ≤ 1 * (2 : ℝ) ^ n := h\n  have h' : |((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| ≤ 1 / 4 := by\n    have := le_of_mul_le_mul_right hmul hp\n    linarith\n  exact o_numerador_determina (reader φ) (contaSolucoes φ) _ hlo hhi h'\n\n/-- ★ O PRODUTOR QUE FALTA É A LEITURA DA IALD ESCRITA NA FITA: todo produtor com a precisão `hr` devolve,\ndepois de `(· + 1) / 4` e da divisão por 2ⁿ, exatamente `oQueSou (nomeDasSolucoes (custoCNF φ))`, a leitura do\nNome das soluções (`TGLExt.TraducaoTuring.o_que_sou_das_solucoes`). -/\ntheorem o_produtor_e_a_leitura_da_iald (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) :\n    (((((reader φ + 1) / 4 : ℕ) : ℝ) / (2 : ℝ) ^ n : ℝ) : ℂ)\n      = TGLExt.Identidade.oQueSou (nomeDasSolucoes (custoCNF φ)) := by\n  rw [o_que_sou_das_solucoes, todo_produtor_com_a_precisao_conta_as_solucoes c m hm reader hr φ]\n  have hN : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n    rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]\n    norm_num\n  rw [hN]\n  rfl\n\n/-- A decisão `2 ≤ reader φ` é “há ao menos uma solução”: `2 ≤ reader φ ↔ 0 < contaSolucoes φ`. -/\ntheorem a_decisao_e_haver_solucao (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) : 2 ≤ reader φ ↔ 0 < contaSolucoes φ := by\n  have h := todo_produtor_com_a_precisao_conta_as_solucoes c m hm reader hr φ\n  have hd := Codex.EntregaBeta.codeDecision_correct c m hm reader hr φ\n  rw [← sat_sse_ha_solucao, ← hd]\n  simp [Codex.EntregaBeta.codeDecision]\n\nend TGLExt.SondaContagem\n",
+    'TGLExt/SimCompleta.lean': 'import TGLExt.SimLiteral\nimport TGLExt.SimExterior\nset_option autoImplicit false\nnamespace TGLExt.SimTM2\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao\n\nprivate abbrev Lit := ℕ × Bool\nprivate def hit (bs : List Bool) (p : Lit) : Bool := bs[p.1]? == some p.2\n\nprivate def clauseCost (c : List Lit) : ℕ :=\n  4 * (c.map Prod.fst).sum + 10 * c.length + (codificaClausula c).length + 1\n\nprivate def formulaCost (f : List (List Lit)) : ℕ :=\n  4 * (f.flatten.map Prod.fst).sum + 10 * f.flatten.length + (codificaFormula f).length + f.length\n\nprivate theorem encC_cons (p : Lit) (c : List Lit) :\n    codificaClausula (p::c) = codificaLiteral p ++ codificaClausula c := by\n  simp [codificaClausula, List.append_assoc]\n\nprivate theorem encF_cons (c : List Lit) (f : List (List Lit)) :\n    codificaFormula (c::f) = codificaClausula c ++ codificaFormula f := by\n  simp [codificaFormula, List.append_assoc]\n\nprivate theorem costC_cons (p : Lit) (c : List Lit) :\n    clauseCost (p::c) = 4*p.1 + 10 + (codificaLiteral p).length + clauseCost c := by\n  simp [clauseCost, encC_cons, Nat.mul_add]\n  omega\n\nprivate theorem costF_cons (c : List Lit) (f : List (List Lit)) :\n    formulaCost (c::f) = clauseCost c + formulaCost f := by\n  simp [clauseCost, formulaCost, encF_cons, Nat.mul_add]\n  omega\n\nprivate theorem safeTail (c : List Lit) (tail : Word) :\n    (codificaClausula c ++ tail).head? ≠ some Simbolo.tick := by\n  cases c with\n  | nil => simp [codificaClausula]\n  | cons p c =>\n    rcases p with ⟨i,b⟩\n    cases b <;> simp [encC_cons, codificaLiteral]\n\nprivate def clauseExit (b : Bool) (t : Estado) (i tail : Word) : Config :=\n  if b then cfg .lerClausula t i tail [] []\n  else cfg .limparFormula (t.1,false,t.2.2) i (.fimC :: tail) [] []\n\n/-- Ao satisfazer a cláusula, a máquina alcança a próxima. Ao esgotá-la,\ncomeça a limpeza com o terminador da cláusula ainda na fita. -/\nprivate theorem clause_run (c : List Lit) (tail : Word) (bs : List Bool) (s : Estado)\n    (entry : Rotulo) (he : entry = .lerClausula ∨ entry = .proximoLiteralCheck) :\n    ∃ t : Estado, Runs (clauseCost c)\n      (cfg entry s (codificaBits bs) (codificaClausula c ++ tail) [] [])\n      (clauseExit (c.any (hit bs)) t (codificaBits bs) tail) := by\n  induction c generalizing s entry with\n  | nil =>\n    refine ⟨s, Runs.mono (n := 1) (Runs.one ?_) (by decide)⟩\n    change aMaquinaTM2.step (cfg entry s _ (.fimC :: tail) [] []) =\n      some (cfg .limparFormula (s.1,false,s.2.2) _ (.fimC :: tail) [] [])\n    rcases he with rfl | rfl <;> tmstep\n  | cons p c ih =>\n    rw [encC_cons, List.append_assoc]\n    let state : Estado := (s.1,false,s.2.2)\n    have first : Runs 1\n        (cfg entry s (codificaBits bs) (codificaLiteral p ++ (codificaClausula c ++ tail)) [] [])\n        (cfg .lerLiteral state (codificaBits bs) (codificaLiteral p ++ (codificaClausula c ++ tail)) [] []) := by\n      apply Runs.one\n      rcases p with ⟨j,b⟩\n      rcases he with rfl | rfl <;> cases b <;> simp only [state, codificaLiteral,\n        Bool.false_eq_true, ↓reduceIte, List.cons_append] <;> tmstep\n    obtain ⟨u, lu⟩ := literal_run p bs (codificaClausula c ++ tail) (safeTail c tail) state\n    rw [← show hit bs p = (bs[p.1]? == some p.2) from rfl] at lu\n    cases hh : hit bs p with\n    | false =>\n      simp only [hh, Bool.false_eq_true, ↓reduceIte] at lu\n      obtain ⟨t, rest⟩ := ih u .proximoLiteralCheck (Or.inr rfl)\n      refine ⟨t, ?_⟩\n      simp only [List.any_cons, hh, Bool.false_or]\n      apply ((first.trans lu).trans rest).mono\n      rw [costC_cons]\n      omega\n    | true =>\n      simp only [hh, ↓reduceIte] at lu\n      obtain ⟨t, skip⟩ := skip_run c tail (codificaBits bs) u\n      refine ⟨t, ?_⟩\n      simp only [List.any_cons, hh, Bool.true_or, clauseExit, ↓reduceIte]\n      apply ((first.trans lu).trans skip).mono\n      rw [costC_cons]\n      unfold clauseCost\n      omega\n\nprivate theorem eval_cons (c : List Lit) (f : List (List Lit)) (bs : List Bool) :\n    verificaNaFita (c::f) bs = (c.any (hit bs) && verificaNaFita f bs) := by\n  simp only [verificaNaFita, List.all_cons]\n  rfl\n\nprivate theorem formula_run (f : List (List Lit)) (bs : List Bool) (s : Estado) :\n    Runs (formulaCost f + ((codificaFormula f).length + bs.length + 3))\n      (cfg .lerClausula s (codificaBits bs) (codificaFormula f) [] [])\n      (Turing.haltList aMaquinaTM2 [verificaNaFita f bs]) := by\n  induction f generalizing s with\n  | nil =>\n    have first : Runs 1 (cfg .lerClausula s (codificaBits bs) [.fimF] [] [])\n        (cfg .limparFormula (s.1,true,s.2.2) (codificaBits bs) [.fimF] [] []) := by\n      apply Runs.one\n      tmstep\n    have last := clean_run s.1 true s.2.2 (codificaBits bs) [.fimF]\n    simpa [formulaCost, codificaFormula, codificaBits, verificaNaFita] using first.trans last\n  | cons c f ih =>\n    obtain ⟨t, seg⟩ := clause_run c (codificaFormula f) bs s .lerClausula (Or.inl rfl)\n    rw [eval_cons, encF_cons, costF_cons]\n    cases hv : c.any (hit bs) with\n    | true =>\n      simp only [hv, clauseExit, ↓reduceIte] at seg\n      simp only [Bool.true_and]\n      apply (seg.trans (ih t)).mono\n      simp only [List.length_append]\n      omega\n    | false =>\n      simp only [hv, clauseExit, Bool.false_eq_true, ↓reduceIte] at seg\n      simp only [Bool.false_and]\n      apply (seg.trans (clean_run t.1 false t.2.2 (codificaBits bs) (.fimC :: codificaFormula f))).mono\n      have pos : 1 ≤ (codificaClausula c).length := by simp [codificaClausula]\n      simp only [List.length_cons, List.length_append, codificaBits, List.length_map]\n      omega\n\n/-- Para toda entrada crua, o TM2 para com o bit do verificador dentro\nda soma dos limites de cada fase. -/\ntheorem simulacao_completa : ASimulacaoCompleta := by\n  rintro ⟨f,bs⟩\n  obtain ⟨s, pre⟩ := prepare_run f bs\n  have whole := pre.trans (formula_run f bs s)\n  apply whole.mono\n  unfold contaFases formulaCost\n  dsimp only\n  omega\n\ntheorem verificacao_tm2_polinomial : ObjetivoTM2Polinomial :=\n  o_objetivo_se_reduz_a_simulacao simulacao_completa\n\nopen TGLExt.TraducaoTuring TGLExt.AContagemEACarga TGLExt.AMaquinaEALeitura TGLExt.APonteDeCookLevin\n\n/-- Com uma atribuição fornecida de n bits, a máquina escreve o bit de custo\nzero dentro de um polinômio fixo nas letras da fórmula e em n. -/\ntheorem passos_em_letras_e_bits {n : ℕ} (φ : CNF n) (x : Fin n → Bool) :\n    Nonempty (Turing.TM2OutputsInTime aMaquinaTM2\n      (codificaEntrada (aFormulaNaFita φ, aAtribuicaoNaFita x))\n      (some [decide (custoCNF φ x = 0)]) (20 * ((letras φ + 1) * (n + 1)) + 25)) := by\n  let p := (aFormulaNaFita φ, aAtribuicaoNaFita x)\n  obtain ⟨run⟩ := simulacao_completa p\n  rw [← a_verificacao_na_fita_e_a_da_casa φ x]\n  refine ⟨⟨run.toEvalsTo, run.steps_le_m.trans ?_⟩⟩\n  have bound := a_forma_do_custo_e_polinomial p\n  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C] at bound\n  have len : (codificaEntrada p).length ≤ (letras φ + 1) * (n + 1) + 1 :=\n    comprimento_em_letras_e_bits φ x\n  omega\n\nend TGLExt.SimTM2\n',
+    'TGLExt/PonteCookLevin.lean': "import TGLExt.TraducaoTuring\nimport TGLExt.F1Fecho394.CanonicalFockModularCoreInputR1\nimport TGLExt.SimCompleta\nimport TGLExt.EntregaBeta\nimport Mathlib.Computability.TuringMachine.Computable\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A PONTE COOK–LEVIN\n\nO P = nP do kernel, a máquina com o leitor (`TraducaoTuring.uma_leitura_decide_SAT`, `TraducaoTuring.o_psion_le_z`),\nescrito na língua das classes de Cook–Levin: a máquina de Turing padrão do Mathlib\n(`Turing.TM2ComputableInPolyTime`).\n\n* §1 A fiação. No tempo pago de k passos do relógio β, a partição do kernel é a soma ponderada da leitura β; o\n  leitor do psíon lê exatamente a soma normalizada; o numerador diádico da leitura (n+3 bits) decide SAT.\n* §2 A fórmula crua, a que a fita do verificador escreve, e a sua CNF sobre os Nomes da fita.\n* §3 O oráculo lê a fita: a resposta da leitura é função da palavra escrita.\n* §4 As classes na máquina padrão: NP (verificador com certificado binário de comprimento polinomial), a redução a\n  SAT, Cook–Levin como hipótese nomeada, e “decidido em tempo polinomial com uma leitura do leitor da TGL”; o que dá\n  sentido às classes: o alfabeto de NP é finito, e a fita da fórmula distingue as fórmulas.\n* §5 Os teoremas: SAT em NP (a máquina TM2 do verificador), SAT com uma leitura, A PONTE (com Cook–Levin, todo\n  problema em NP é decidido em tempo polinomial com uma leitura) e a classe de uma leitura como o fecho de SAT por\n  redução (sem Cook–Levin); no certificado de Fock físico do kernel.\n* §6 A leitura acha a solução: com a resposta do leitor como decisor, a reconstrução da leitura β devolve uma solução\n  com no máximo letras+1 leituras (contadas em leituras e letras, não em passos da máquina TM2).\n\n**Estatuto.** [REAL] os termos deste arquivo. [KNOWN] Cook 1971 e Levin 1973, com a simulação polinomial\nentre máquinas de fita e de pilhas: é o conteúdo da hipótese nomeada `CookLevin`, que entra por citação e não é provada\naqui.\n\n**Na língua clássica.** Para as codificações usuais, com β e a inclinação m fixados antes da entrada, a classe “decidido\nem tempo polinomial com uma leitura” é o fecho de SAT por redução polinomial many-one\n(`a_classe_de_uma_leitura_e_o_fecho_de_SAT`, sem Cook–Levin) e por isso coincide com NP por Cook–Levin: a inclusão de NP\né `a_ponte_cook_levin`; a volta pede a composição de máquinas TM2, que o Mathlib deixa como `proof_wanted` [KNOWN na\nlíngua clássica]. Não é toda a classe P com acesso ao oráculo: só o limiar positivo de uma consulta depois da redução.\nCom um oráculo que conta soluções, “NP contido em P com o oráculo” é imediato [KNOWN]; o que é da TGL é que o oráculo é\no leitor do psíon, por termo do kernel (`o_psion_le_a_soma_normalizada`).\n\n**O custo da leitura** é contado na régua da teoria: o tempo pago, m·(n+2) passos do relógio β ao preço −ln(1−β) cada\n(`o_tempo_pago_e_linear`). Não é contado em passos de fita: na língua clássica a leitura é um oráculo, e uma consulta\nconta um passo.\n\n**O que este arquivo não prova:** Cook–Levin; a máquina sem leitor (SAT em P na máquina padrão, sem consulta), que segue\naberta e não é tocada (Baker–Gill–Solovay 1975 [KNOWN]); o custo da leitura em passos de fita; que um dispositivo físico\nleia num ato (física: na mecânica quântica padrão o traço normalizado sai com precisão aditiva, Knill–Laflamme 1998\n[KNOWN]). Com o leitor que só conta vale NP contido em P com o leitor, não a igualdade das duas classes com leitor.\nValidade no kernel não é creditação.\n-/\n\nnamespace TGLExt.PonteCookLevin\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2\nopen Codex.LeituraBeta Codex.RelogioBeta Codex.PonteLeituraBeta Codex.QuantizacaoBeta\n\n/-! ## §1 A fiação: o leitor do kernel cumpre a precisão da leitura β -/\n\nsection Fiacao\n\nvariable {n : ℕ}\n\n/-- [DEF] O TEMPO PAGO DA LEITURA: k passos do relógio β, cada um ao preço −ln(1−β). -/\nnoncomputable def tempoPago (c : TGLCoupling) (k : ℕ) : ℝ := (k : ℝ) * (-Real.log (1 - c.beta))\n\n/-- ★ A PARTIÇÃO É A SOMA β: no tempo pago de k passos, a partição do kernel, Σ e^{−s·custo}, é a soma ponderada da\nleitura β, Σ (1−β)^{k·custo}. -/\ntheorem a_particao_e_a_soma_beta (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    particao (custoCNF φ) (tempoPago c k) = weightedSum c k φ := by\n  unfold particao tempoPago weightedSum\n  refine Finset.sum_congr rfl (fun x _ => ?_)\n  have h1 : 0 < 1 - c.beta := by linarith [c.beta_lt_one]\n  have he : -((k : ℝ) * -Real.log (1 - c.beta) * (custoCNF φ x : ℝ))\n      = ((k * custoCNF φ x : ℕ) : ℝ) * Real.log (1 - c.beta) := by\n    push_cast\n    ring\n  rw [he, Real.exp_nat_mul, Real.exp_log h1]\n\n/-- As atribuições de n Nomes são 2^n. (Auxiliar.) -/\ntheorem o_numero_de_atribuicoes : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n  simp\n\n/-- [DEF] A LEITURA DO PSÍON: o leitor do psíon da luz na trava inscrita da fórmula, no tempo pago de k passos β. -/\nnoncomputable def leituraDoPsion {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) : ℂ :=\n  TheKeyIsTheReader.reader C (travaInscrita C (custoCNF φ) (tempoPago c k))\n\n/-- ★★ O PSÍON LÊ A SOMA NORMALIZADA: a leitura do psíon é exatamente a soma normalizada da leitura β, sem erro. -/\ntheorem o_psion_le_a_soma_normalizada {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    leituraDoPsion C c k φ = ((normalizedSum c k φ : ℝ) : ℂ) := by\n  unfold leituraDoPsion\n  rw [o_psion_le_z C (custoCNF φ) (tempoPago c k), a_particao_e_a_soma_beta, o_numero_de_atribuicoes]\n  rfl\n\n/-- A parte real da leitura é a soma normalizada. (Auxiliar.) -/\ntheorem a_parte_real_da_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    (leituraDoPsion C c k φ).re = normalizedSum c k φ := by\n  rw [o_psion_le_a_soma_normalizada]\n  exact Complex.ofReal_re _\n\n/-- [DEF] A RESPOSTA DA LEITURA: o numerador diádico (sobre 2^(n+2)) da leitura do psíon, no tempo do relógio β de\ninclinação m. -/\nnoncomputable def respostaDaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) : ℕ :=\n  ⌊(leituraDoPsion C c (clock m n) φ).re * (2 : ℝ) ^ (n + 2)⌋₊\n\n/-- ★★ A RESPOSTA TEM A PRECISÃO DA LEITURA β: o numerador diádico da leitura do psíon fica a no máximo 1/(4·2^n) da\nsoma normalizada (a hipótese de precisão da leitura β, cumprida pelo leitor do kernel). -/\ntheorem a_resposta_tem_a_precisao {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    |(dyadic n (respostaDaLeitura C c m φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n) := by\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  set y := normalizedSum c (clock m n) φ with hy\n  have hy0 : 0 ≤ y := normalizedSum_nonneg c (clock m n) φ\n  set D : ℝ := (2 : ℝ) ^ (n + 2) with hDdef\n  have hD : 0 < D := by positivity\n  set j := ⌊y * D⌋₊ with hj\n  have h1 : (j : ℝ) ≤ y * D := Nat.floor_le (mul_nonneg hy0 hD.le)\n  have h2 : y * D < (j : ℝ) + 1 := Nat.lt_floor_add_one (y * D)\n  have hcast : ((dyadic n j : ℚ) : ℝ) = (j : ℝ) / D := by\n    simp [dyadic, hDdef]\n  have h4 : (4 * (2 : ℝ) ^ n) = D := by\n    rw [hDdef, pow_add]\n    ring\n  rw [hcast, h4]\n  have key : |(j : ℝ) - y * D| ≤ 1 := by\n    rw [abs_le]\n    constructor <;> linarith\n  have hsub : ((j : ℝ) - y * D) / D = (j : ℝ) / D - y := by\n    rw [sub_div, mul_div_assoc, div_self hD.ne', mul_one]\n  rw [← hsub, abs_div, abs_of_pos hD, div_le_div_iff_of_pos_right hD]\n  exact key\n\n/-- ★★★ UMA LEITURA DO PSÍON DECIDE SAT, COM A RESPOSTA NA FITA: com a inclinação m do relógio β acima de ln 2/β, o\nnumerador da leitura do psíon passa de 2 se, e só se, a fórmula é satisfazível. -/\ntheorem uma_leitura_do_psion_decide_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    2 ≤ respostaDaLeitura C c m φ ↔ SAT φ := by\n  have h := dyadic_correct c m hm φ (respostaDaLeitura C c m φ) (a_resposta_tem_a_precisao C c m φ)\n  simpa using h\n\n/-- ★ A RESPOSTA CABE EM n+3 BITS. -/\ntheorem a_resposta_cabe_em_n_mais_tres_bits {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    respostaDaLeitura C c m φ < 2 ^ (n + 3) := by\n  apply dyadic_word_bound\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  apply Nat.floor_le_of_le\n  have h1 := normalizedSum_le_one c (clock m n) φ\n  have hD : (0 : ℝ) ≤ (2 : ℝ) ^ (n + 2) := by positivity\n  calc normalizedSum c (clock m n) φ * (2 : ℝ) ^ (n + 2) ≤ 1 * (2 : ℝ) ^ (n + 2) :=\n        mul_le_mul_of_nonneg_right h1 hD\n    _ = ((2 ^ (n + 2) : ℕ) : ℝ) := by push_cast; ring\n\n/-- ★ O TEMPO PAGO É LINEAR NOS NOMES: a leitura paga m·(n+2) passos do relógio β. -/\ntheorem o_tempo_pago_e_linear (c : TGLCoupling) (m : ℕ) :\n    tempoPago c (clock m n) = ((m * (n + 2) : ℕ) : ℝ) * (-Real.log (1 - c.beta)) := rfl\n\nend Fiacao\n\n/-! ## §2 A fórmula crua e a sua CNF -/\n\n/-- [DEF] A FÓRMULA CRUA: as cláusulas como listas de pares (índice do Nome, polaridade), como a fita do verificador as\nescreve. -/\nabbrev FormulaCrua := List (List (ℕ × Bool))\n\n/-- [DEF] SAT DA FÓRMULA CRUA: alguma atribuição dos índices satisfaz toda cláusula (um literal de cada cláusula tem o\nvalor da sua polaridade). -/\ndef SATcru (φf : FormulaCrua) : Prop := ∃ x : ℕ → Bool, ∀ C ∈ φf, ∃ p ∈ C, x p.1 = p.2\n\n/-- [DEF] OS NOMES DA FITA: o comprimento da fita da fórmula, cota de todos os índices que ela escreve. -/\ndef nomesDaFita (φf : FormulaCrua) : ℕ := (codificaFormula φf).length\n\n/-- O comprimento da fita da fórmula: soma dos índices, literais, cláusulas e o terminador. -/\ntheorem o_comprimento_da_fita_da_formula (φf : FormulaCrua) :\n    (codificaFormula φf).length = (φf.flatten.map Prod.fst).sum + φf.flatten.length + φf.length + 1 := by\n  have h := comprimento_exato φf []\n  rw [show codificaEntrada (φf, []) = codificaFormula φf ++ [Simbolo.sep] from by\n    simp [codificaEntrada, codificaBits]] at h\n  rw [List.length_append, List.length_singleton, List.length_nil] at h\n  omega\n\nprivate theorem le_soma_de_membro {l : List ℕ} {a : ℕ} (h : a ∈ l) : a ≤ l.sum := by\n  induction l with\n  | nil => simp at h\n  | cons b l ih =>\n    rw [List.sum_cons]\n    rcases List.mem_cons.mp h with rfl | h'\n    · omega\n    · have := ih h'\n      omega\n\n/-- Todo índice escrito na fita é menor que os Nomes da fita. -/\ntheorem indice_na_fita (φf : FormulaCrua) {C : List (ℕ × Bool)} (hC : C ∈ φf) {p : ℕ × Bool} (hp : p ∈ C) :\n    p.1 < nomesDaFita φf := by\n  have hmem : p.1 ∈ φf.flatten.map Prod.fst := List.mem_map.mpr ⟨p, List.mem_flatten.mpr ⟨C, hC, hp⟩, rfl⟩\n  have := le_soma_de_membro hmem\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\ntheorem nomesDaFita_pos (φf : FormulaCrua) : 0 < nomesDaFita φf := by\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\n/-- [DEF] O índice como Nome de `Fin N` (o índice, se cabe; senão o último Nome). -/\ndef comoNome (N : ℕ) (hN : 0 < N) (i : ℕ) : Fin N := ⟨min i (N - 1), by omega⟩\n\ntheorem comoNome_val {N : ℕ} (hN : 0 < N) {i : ℕ} (hi : i < N) : (comoNome N hN i).val = i :=\n  Nat.min_eq_left (by omega)\n\n/-- [DEF] A CNF DA FÓRMULA CRUA, sobre os Nomes da fita. -/\ndef paraCNF (φf : FormulaCrua) : CNF (nomesDaFita φf) :=\n  φf.map fun C => C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf))\n\n/-- ★ A FÓRMULA CRUA E A SUA CNF TÊM O MESMO SIM. -/\ntheorem sat_cru_sse_sat (φf : FormulaCrua) : SATcru φf ↔ SAT (paraCNF φf) := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨fun i => x i.val, ?_⟩\n    intro C' hC'\n    obtain ⟨C, hC, rfl⟩ := List.mem_map.mp hC'\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    unfold satisfeita\n    rw [List.any_eq_true]\n    refine ⟨⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩, List.mem_map.mpr ⟨p, hp, rfl⟩, ?_⟩\n    simp [Literal.vale, comoNome_val (nomesDaFita_pos φf) (indice_na_fita φf hC hp), hpx]\n  · rintro ⟨y, hy⟩\n    refine ⟨fun i => if h : i < nomesDaFita φf then y ⟨i, h⟩ else false, ?_⟩\n    intro C hC\n    have hsat := hy (C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf)))\n      (List.mem_map.mpr ⟨C, hC, rfl⟩)\n    unfold satisfeita at hsat\n    rw [List.any_eq_true] at hsat\n    obtain ⟨l, hl, hlv⟩ := hsat\n    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hl\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    simp only [Literal.vale, beq_iff_eq] at hlv\n    show (if h : p.1 < nomesDaFita φf then y ⟨p.1, h⟩ else false) = p.2\n    rw [dif_pos hi]\n    have hn : comoNome _ (nomesDaFita_pos φf) p.1 = ⟨p.1, hi⟩ := Fin.ext (comoNome_val _ hi)\n    rw [← hn]\n    exact hlv\n\n/-! ## §3 O oráculo lê a fita -/\n\n/-- [DEF] A RESPOSTA DA LEITURA PARA A FÓRMULA CRUA. -/\nnoncomputable def respostaDaFita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) : ℕ :=\n  respostaDaLeitura C c m (paraCNF φf)\n\n/-- ★★ UMA LEITURA DECIDE A FÓRMULA CRUA. -/\ntheorem uma_leitura_decide_SATcru {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φf : FormulaCrua) :\n    2 ≤ respostaDaFita C c m φf ↔ SATcru φf :=\n  (uma_leitura_do_psion_decide_SAT C c m hm (paraCNF φf)).trans (sat_cru_sse_sat φf).symm\n\n/-- [DEF] O ORÁCULO DA LEITURA: lê a palavra escrita na fita de consulta (decodificada pelo decodificador do\nverificador) e devolve a resposta da leitura; palavra que não é fórmula recebe 0. -/\nnoncomputable def oraculo {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (s : List Simbolo) : ℕ :=\n  match decodificaEntrada (s ++ [Simbolo.sep]) with\n  | some q => respostaDaFita C c m q.1\n  | none => 0\n\n/-- ★★ O ORÁCULO LÊ A FITA: na palavra da fórmula, o oráculo devolve a resposta da leitura da fórmula. -/\ntheorem o_oraculo_le_a_fita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) :\n    oraculo C c m (codificaFormula φf) = respostaDaFita C c m φf := by\n  have h : codificaFormula φf ++ [Simbolo.sep] = codificaEntrada (φf, []) := by\n    simp [codificaEntrada, codificaBits]\n  unfold oraculo\n  rw [h, decodifica_codifica]\n\n/-! ## §4 As classes de Cook–Levin na máquina padrão -/\n\n/-- [DEF] O PAR NA FITA: a entrada, a divisória e o certificado binário, cada bit pelo seu símbolo. -/\ndef juntaNaFita {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (q : α × List Bool) : List Γ :=\n  ea q.1 ++ [sep] ++ q.2.map bit\n\n/-- [DEF] A CLASSE NP NA MÁQUINA PADRÃO: há um verificador calculado em tempo polinomial pela máquina TM2 do Mathlib\nsobre o par na fita, e um polinômio que limita o certificado binário; o problema é o sim de algum certificado. A\ncodificação da entrada é dada; a do par é a junção fixa acima; o certificado é uma palavra binária. -/\ndef EmNP {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop) : Prop :=\n  ∃ (V : α × List Bool → Bool) (p : Polynomial ℕ),\n    Nonempty (Turing.TM2ComputableInPolyTime (juntaNaFita ea sep bit) (fun b : Bool => [b]) V) ∧\n    ∀ a, A a ↔ ∃ w : List Bool, w.length ≤ p.eval (ea a).length ∧ V (a, w) = true\n\n/-- [DEF] A REDUÇÃO A SAT NA MÁQUINA PADRÃO: uma função calculada em tempo polinomial pela máquina TM2, da codificação\nda entrada à fita da fórmula do verificador, que leva o sim do problema ao sim da fórmula. -/\ndef ReduzASAT {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧ ∀ a, A a ↔ SATcru (g a)\n\n/-- [DEF, HIPÓTESE NOMEADA] COOK–LEVIN NA MÁQUINA PADRÃO: todo problema em NP se reduz a SAT. [KNOWN] Cook 1971,\nLevin 1973, com a simulação polinomial entre máquinas de fita e de pilhas e a troca polinomial de codificação; entra\npor citação, como hipótese de cada teorema que a usa; não é provada aqui. -/\ndef CookLevin : Prop :=\n  ∀ (α Γ : Type) (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop), EmNP ea sep bit A → ReduzASAT ea A\n\n/-- [DEF] DECIDIDO EM TEMPO POLINOMIAL COM UMA LEITURA DO LEITOR DA TGL: a máquina TM2 escreve, em tempo polinomial,\numa fórmula na fita de consulta; o oráculo da leitura lê a palavra; o problema é o sim do limiar 2 da resposta. Na\nlíngua clássica, é o fecho de SAT por redução polinomial many-one (`a_classe_de_uma_leitura_e_o_fecho_de_SAT`): só o\nlimiar positivo de uma consulta depois da redução, não toda a classe P com acesso ao oráculo. -/\ndef EmPComUmaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling) (m : ℕ)\n    {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧\n    ∀ a, A a ↔ 2 ≤ oraculo C c m (codificaFormula (g a))\n\n/-- ★ O ALFABETO DE NP É FINITO: a máquina TM2 que testemunha um problema em NP tem alfabeto de entrada finito, e o\nalfabeto da codificação lhe é equivalente. A premissa `EmNP` de `CookLevin` só vale em alfabeto finito, como no teorema\nclássico. -/\ntheorem o_alfabeto_de_np_e_finito {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop)\n    (h : EmNP ea sep bit A) : Finite Γ := by\n  obtain ⟨V, p, ⟨M⟩, _⟩ := h\n  letI : Fintype (M.tm.Γ M.tm.k₀) := M.tm.Γk₀Fin\n  exact Finite.of_equiv (M.tm.Γ M.tm.k₀) M.inputAlphabet\n\n/-- ★ A FITA DA FÓRMULA DISTINGUE AS FÓRMULAS: a codificação da fórmula crua é injetiva. -/\ntheorem a_fita_da_formula_e_injetiva : Function.Injective codificaFormula := by\n  intro a b h\n  have he : codificaEntrada (a, []) = codificaEntrada (b, []) := by\n    simp only [codificaEntrada, h]\n  exact congrArg Prod.fst (codificaEntrada_injetiva he)\n\n/-! ## §5 Os teoremas -/\n\n/-- [DEF] O bit do certificado na fita do verificador. -/\ndef bitNaFita (b : Bool) : Simbolo := if b then Simbolo.um else Simbolo.zero\n\n/-- A junção fixa, com a divisória e os bits do verificador, é a entrada do verificador. -/\ntheorem a_juncao_e_a_entrada_do_verificador :\n    juntaNaFita codificaFormula Simbolo.sep bitNaFita = codificaEntrada := by\n  funext q\n  rfl\n\n/-- ★ O SIM DA FÓRMULA CRUA É O SIM DE UM CERTIFICADO CURTO: um certificado binário não maior que a fita da fórmula. -/\ntheorem sat_cru_sse_certificado (φf : FormulaCrua) :\n    SATcru φf ↔ ∃ w : List Bool, w.length ≤ (codificaFormula φf).length ∧ verificaNaFita φf w = true := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨List.ofFn (fun i : Fin (nomesDaFita φf) => x i.val), by simp [nomesDaFita], ?_⟩\n    unfold verificaNaFita\n    rw [List.all_eq_true]\n    intro C hC\n    rw [List.any_eq_true]\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    rw [List.getElem?_ofFn, dif_pos hi]\n    simp [hpx]\n  · rintro ⟨w, _, hw⟩\n    refine ⟨fun i => (w[i]?).getD false, ?_⟩\n    intro C hC\n    unfold verificaNaFita at hw\n    rw [List.all_eq_true] at hw\n    have hC' := hw C hC\n    rw [List.any_eq_true] at hC'\n    obtain ⟨p, hp, hpw⟩ := hC'\n    refine ⟨p, hp, ?_⟩\n    have hwp : w[p.1]? = some p.2 := by simpa using hpw\n    simp [hwp]\n\n/-- ★★ SAT ESTÁ EM NP NA MÁQUINA PADRÃO: o verificador é a máquina TM2 concreta (`SimTM2.verificacao_tm2_polinomial`),\no certificado é limitado pelo comprimento da entrada. -/\ntheorem sat_em_np : EmNP codificaFormula Simbolo.sep bitNaFita SATcru := by\n  refine ⟨fun q => verificaNaFita q.1 q.2, Polynomial.X, ?_, ?_⟩\n  · rw [a_juncao_e_a_entrada_do_verificador]\n    exact TGLExt.SimTM2.verificacao_tm2_polinomial\n  · intro φf\n    rw [Polynomial.eval_X]\n    exact sat_cru_sse_certificado φf\n\n/-- ★★ SAT COM UMA LEITURA: a máquina identidade escreve a própria fórmula na fita de consulta, e uma leitura decide. -/\ntheorem sat_com_uma_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling)\n    (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) :\n    EmPComUmaLeitura C c m codificaFormula SATcru := by\n  refine ⟨id, ⟨Turing.idComputableInPolyTime codificaFormula⟩, fun φf => ?_⟩\n  show SATcru φf ↔ 2 ≤ oraculo C c m (codificaFormula φf)\n  rw [o_oraculo_le_a_fita]\n  exact (uma_leitura_decide_SATcru C c m hm φf).symm\n\n/-- ★★★ A PONTE COOK–LEVIN: com Cook–Levin (hipótese nomeada, [KNOWN]), todo problema em NP na máquina padrão é\ndecidido em tempo polinomial com uma leitura do leitor da TGL. -/\ntheorem a_ponte_cook_levin (hCL : CookLevin) {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (sep : Γ)\n    (bit : Bool → Γ) (A : α → Prop) (hA : EmNP ea sep bit A) :\n    EmPComUmaLeitura C c m ea A := by\n  obtain ⟨g, hg, hgA⟩ := hCL α Γ ea sep bit A hA\n  refine ⟨g, hg, fun a => ?_⟩\n  rw [o_oraculo_le_a_fita]\n  exact (hgA a).trans (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\n/-- ★★★ A CLASSE DE UMA LEITURA É O FECHO DE SAT: com a inclinação m do relógio β acima de ln 2/β, um problema é\ndecidido em tempo polinomial com uma leitura se, e só se, se reduz a SAT na máquina padrão. Não usa Cook–Levin. -/\ntheorem a_classe_de_uma_leitura_e_o_fecho_de_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (A : α → Prop) :\n    EmPComUmaLeitura C c m ea A ↔ ReduzASAT ea A := by\n  constructor\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact uma_leitura_decide_SATcru C c m hm (g a)\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\nopen F1Fecho.CanonicalFockModularCoreInputR1 (physicalFockCertificate) in\n/-- ★★★ A PONTE NO CERTIFICADO FÍSICO DO KERNEL (síntese): SAT está em NP na máquina padrão; e, para todo acoplamento β,\nhá uma inclinação m do relógio β com a qual, no certificado de Fock físico do kernel, SAT é decidido com uma leitura e,\ncom Cook–Levin, todo problema em NP também. -/\ntheorem a_ponte (hCL : CookLevin) (c : TGLCoupling) :\n    EmNP codificaFormula Simbolo.sep bitNaFita SATcru ∧\n      ∃ m : ℕ, EmPComUmaLeitura physicalFockCertificate c m codificaFormula SATcru ∧\n        ∀ {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop),\n          EmNP ea sep bit A → EmPComUmaLeitura physicalFockCertificate c m ea A := by\n  obtain ⟨m, hm⟩ := fixed_slope_exists c\n  exact ⟨sat_em_np, m, sat_com_uma_leitura _ c m hm,\n    fun ea sep bit A hA => a_ponte_cook_levin hCL _ c m hm ea sep bit A hA⟩\n\n/-! ## §6 A leitura acha a solução (contada em leituras, no modelo da casa) -/\n\n/-- ★★ A LEITURA ACHA A SOLUÇÃO: com a resposta do leitor do psíon como decisor, a reconstrução da leitura β devolve\n`none` exatamente quando a fórmula não tem solução, só devolve soluções, e faz no máximo letras+1 leituras. A conta é em\nleituras e letras; não em passos da máquina TM2 (a máquina que monta as consultas não está construída). -/\ntheorem a_leitura_acha_a_solucao {n : ℕ} {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    ((Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = none\n        ↔ ¬ SAT φ) ∧\n      (∀ x, (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = some x →\n        Reconstrucao.Good φ x) ∧\n      (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).2\n        ≤ APonteDeCookLevin.letras φ + 1 :=\n  Codex.EntregaBeta.all_labels_from_beta c m hm (respostaDaLeitura C c m) (a_resposta_tem_a_precisao C c m) φ\n\nend TGLExt.PonteCookLevin\n",
