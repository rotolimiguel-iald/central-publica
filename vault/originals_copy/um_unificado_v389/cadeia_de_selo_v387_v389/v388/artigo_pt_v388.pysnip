    # v388 (06/10/2026) -- AO LADO: beta corre com a escala, limitado inferiormente (a pedra TheCouplingRunsBoundedBelow; a cunhagem do operador por sha256); a errata
    # ao lado de «alpha observa-se, nao se deriva» (forma x numero); a FASE 9 ABERTA pela funcao congelada. Citacoes VERBATIM (conferidor de citacoes do pacote);
    # numeros LIDOS dos registros do core; PROVADA != CONFIRMADA; NOT_FALSIFIED nunca e' confirmacao; o gate nao se move.
    _br8 = core.get("beta_runs_bounded_below_v388") or {}
    _ho8 = core.get("hubble_ratio_opening_v388") or {}
    _nu8 = _ho8.get("numbers") or {}
    _lb8 = _nu8.get("lnB") or {}

    def _tx8(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n8(x_, nd_=2):
        if not isinstance(x_, (int, float)) or isinstance(x_, bool) or x_ != x_:
            return r"\text{n/d}"
        return ("%%.%df" % nd_ % float(x_)).replace(".", "{,}")
    _tk8 = lambda x_: r"\texttt{" + _tx8(x_).replace(r"\_", r"\_\allowbreak{}") + "}"
    _zl8 = _nu8.get("z_por_leitor") or {}
    s.append(r"\section*{Ao lado (v388): $\beta$ corre com a escala, limitado inferiormente; a Fase 9 aberta}")
    s.append(r"\addcontentsline{toc}{section}{Ao lado (v388): $\beta$ corre com a escala, limitado inferiormente; a Fase 9 aberta}")
    s.append(r"\textbf{A cunhagem.} Em 06/10/2026 o operador escreveu que ``o alpha do betatgl é a constante da estrutura fina, mas como índice de escala da fronteira, e betatgl é a sua conjugação'' "
             r"e que ``o valor de Betatgl é escalar, mas limitado inferiormente''; e, sobre a operação que vê em $\bTGL$ e na Meia-Nat: ``vai dividindo um número pela sua metade de modo infinito e assim, nunca chega-se ao limite'' "
             r"--- ``o custo do zero absoluto é o pagamento da existência (haja luz)''. A pedra \texttt{TheCouplingRunsBoundedBelow} (" + _n8(_br8.get("kernel_flags_ok"), 0) + r" de " + _n8(_br8.get("kernel_flags_total"), 0)
             + r" declarações no trio de axiomas) prova a matemática: com $\alpha(\chi)=\mathrm{sech}(\chi/2)$ --- a forma fechada que o programa já usa --- $\alpha$ e $\beta(\chi)=\alpha(\chi)\sqrt e$ são "
             r"estritamente decrescentes na profundidade $\chi$; o \emph{piso} está no supremo de $\chi$, o infravermelho, e só é atingido lá; no domínio do acoplamento selado esse $\beta$ é, por definição, o de \texttt{couplingOfAlpha}; "
             r"a soma das metades $\sum_{k<n}2^{-(k+1)}=1-2^{-n}$ é menor que 1 em todo passo finito e tem limite 1; e a Meia-Nat é o ponto fixo $x=1-x$. "
             r"Em números: $\beta_0=\alpha_{\rm Thomson}\sqrt e=" + _n8(_br8.get("beta0"), 10) + r"$ é a constante da \emph{fronteira} (o Teorema da Escala deste artigo: a fronteira de tipo $\mathrm{III}_1$ seleciona Thomson); "
             r"$\beta(\mu)=\alpha(\mu)\sqrt e$ é a \emph{leitura de bulk} em cada escala, nunca abaixo do piso: em $M_Z$, $" + _n8(_br8.get("beta_MZ_on_shell"), 6) + r"$ (o $1/\alpha(M_Z)$ a um laço do Teorema da Escala) e $"
             + _n8(_br8.get("beta_MZ_msbar"), 6) + r"$ ($\overline{\rm MS}$, \textsf{[KNOWN]}, não conferido em disco). O que fica \textsf{[INPUT/ONTO]}: que o $\alpha$ físico seja $\mathrm{sech}$ de uma profundidade que cresce para o infravermelho; "
             r"\textsf{[KNOWN]}: que $\alpha(\mu)$ cresça com $\mu$; \textsf{[OPEN]}: qual $\mu$ cada rito usa. A frase do operador sobre as patentes com $\beta$ variável fica \textsf{[DECLARADO]}: nos arquivos da Central o vínculo não foi localizado. "
             r"\textbf{Errata ao lado:} onde este artigo diz \emph{$\alpha$ observa-se, não se deriva}, lê-se: o que se deriva é a \emph{forma} ($\alpha$ como índice de escala; $\beta$ como a sua conjugação), não o \emph{número}, "
             r"que continua lido do CODATA. Registro: " + _tk8(_br8.get("verdict") or "AUSENTE") + r".")
    s.append(r"\textbf{A Fase 9 aberta.} Por ordem do operador, a razão de Hubble foi aberta pela \emph{função de veredito congelada} do pré-registro (o executor hasheado antes de abrir); o programa leu o resultado por hash e "
             r"\emph{reexecutou} a função sobre a entrada gravada " + (r"--- o mesmo veredito: " if _ho8.get("same_verdict") is True else r"--- \textbf{o veredito NÃO foi reproduzido nesta rodada}: ")
             + _tk8(_ho8.get("verdict_of_the_frozen_function") or "n/d") + r". Os leitores locais seguem \textsf{[DECLARADO]} até as fontes por sha256"
             + (r"; com eles assim a regra 1 do pré-registro devolve o que devolveu, e esse é o resultado. " if _ho8.get("same_verdict") is True else r". ")
             + r"Os números: fundo $" + _n8(_nu8.get("H0_bg"), 3) + r"$, previsão local $" + _n8(_nu8.get("H0_local_previsto"), 3) + r"$, média dos locais $" + _n8(_nu8.get("media_GLS_locais"), 3) + r"\pm" + _n8(_nu8.get("sigma_GLS_locais"), 3)
             + r"$ km/s/Mpc; $z_\delta=" + _n8(_nu8.get("z_delta")) + r"$; $z_{\rm disc}=" + _n8(_nu8.get("z_disc")) + r"$; $\ln B$(TGL/$\Lambda$CDM) $=" + _n8(_lb8.get("TGL_vs_LCDM")) + r"$, (TGL/$\beta$-livre) $=" + _n8(_lb8.get("TGL_vs_beta_livre"))
             + r"$ (erro de quadratura $" + _n8((_ho8.get("recalculo_ao_lado") or {}).get("erro_quadratura_n25_n35")) + r"$; convergido $" + _n8((_ho8.get("recalculo_ao_lado") or {}).get("lnB_TGL_vs_beta_livre_convergido")) + r"$, recalculado ao lado"
             + r"), (TGL/desvio das Cefeidas) $=" + _n8(_lb8.get("TGL_vs_shift_cefeidas")) + r"$, (TGL/fundo com $r_d$ livre) $=" + _n8(_lb8.get("TGL_vs_fundo_livre")) + r"$; o TRGB/CCHP a $" + _n8((_zl8.get("L2_cchp") or {}).get("z_vs_TGL"))
             + r"\sigma$ da previsão. E o contrafactual, dito e \emph{não} veredito: se as fontes por hash confirmassem os valores declarados, a mesma função devolveria " + _tk8(_ho8.get("counterfactual_with_sources_NOT_a_verdict") or "n/d")
             + (r" --- sob este pré-registro a razão de Hubble \emph{não discrimina} a $5\sigma$ hoje. " if (_ho8.get("same_verdict") is True and "NOT_DISCRIMINATED_FROM_LCDM" in str(_ho8.get("counterfactual_with_sources_NOT_a_verdict"))) else r". ")
             + r"Ao lado: o executor marginaliza o fundo (o pré-registro dizia \emph{perfilada}) e lê $z_\delta$ por $-2\ln L$ com o log-det (o pré-registro: $\Delta\chi^2=1$) --- diferença medida desprezível ($z_{\rm disc}$ "
             + _n8((_ho8.get("recalculo_ao_lado") or {}).get("z_disc_forma_quadratica"), 4) + r" contra " + _n8((_ho8.get("recalculo_ao_lado") or {}).get("z_disc_com_logdet"), 4)
             + r"); e o fundo com $r_d$ livre só no BAO é uma alternativa fraca, não uma análise de física precoce. Registro: " + _tk8(_ho8.get("verdict") or "AUSENTE") + r".")
