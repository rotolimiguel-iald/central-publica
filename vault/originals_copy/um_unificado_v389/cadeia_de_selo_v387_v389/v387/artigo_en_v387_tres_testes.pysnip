         r"yes", r"no (1--3$\sigma$; Phase 7 reduces it)")
    _R3s(r"Hubble tension --- D1 via CAMB V3 (dressed background) --- R6, beside", _tk3s(_lo3s("R6")) + r" (ledger R6: $z=" + _n3s(_ln3s("R6"), 2) + r"$); not blind",
         r"$\Delta\chi^2=" + _n3s(_d3.get("delta_chi2"), 2) + r"$ ($n=" + _i3s(_d3.get("n_data")) + r"$); $\beta=" + _n3s(_g3s(_d3, "beta_posterior", "median"), 4) + r"\pm" + _n3s(_g3s(_d3, "beta_posterior", "sigma"), 4) + r"$; $\alpha\sqrt e$ at $" + _n3s(_d3.get("z_alpha_sqrt_e"), 2) + r"\sigma$",
         r"yes in the $\beta\to0$ limit", r"$" + _n3s(_d3.get("z_alpha_sqrt_e"), 2) + r"\sigma$ AGAINST $\bTGL$ in the dressed background; tension is not falsification")
    _R3s(r"SNe --- canonical Pantheon+ (1593)", _seg3s(_g3s(_fv3, "channels", "pantheon_canonical_1593", "verdict") or _ce3.get("verdict"), 1) + r" (theory at $" + _n3s(_ce3.get("d_theory_sigma"), 2) + r"\sigma$; not preferred by BIC with free $\beta$)",
         r"$\hat\beta=" + _n3s(_g3s(_ce3, "source_INPUT", "beta_hat"), 4) + r"\pm" + _n3s(_g3s(_ce3, "source_INPUT", "sigma"), 4) + r"$; zero at $" + _n3s(_ce3.get("d_zero_sigma"), 2) + r"\sigma$; $\Delta\mathrm{BIC}=" + _n3s(_g3s(_ce3, "source_INPUT", "delta_BIC"), 2) + r"$",
         r"yes ($\hat\beta$ at $" + _n3s(_ce3.get("d_zero_sigma"), 2) + r"\sigma$ from zero)", r"no ($\sigma/\bTGL\approx" + _n3s((_g3s(_ce3, "source_INPUT", "sigma") / _b3s) if (isinstance(_g3s(_ce3, "source_INPUT", "sigma"), (int, float)) and _b3s) else None, 2) + r"$)")
    _la3 = _g3s(_fv3, "channels", "l_A_compressed_cmb") or {}
    _R3s(r"Compressed CMB $\ell_A$ and de-circularised BBN", _st3s(_la3.get("verdict"), "NOT_FALSIFIED") + r" / " + _st3s(_g3s(_fv3, "channels", "bbn", "verdict"), "NON_DISCRIMINANT"),
         r"$\ell_A$: $\beta=" + _n3s(_la3.get("primary_beta"), 4) + r"$, $" + _n3s(_la3.get("d_vs_theory_sigma"), 2) + r"\sigma$ from theory; BBN: $\hat\beta=" + _n3s(_g3s(core, "evidence_audit", "values", "bbn_decirc", "beta_hat"), 4) + r"\pm" + _n3s(_g3s(core, "evidence_audit", "values", "bbn_decirc", "sigma"), 4) + r"$", r"yes", r"no ($\ell_A$ at $" + _n3s(_la3.get("d_vs_theory_sigma"), 1) + r"\sigma$; BBN does not discriminate)")
    _n2 = core.get("nivel2_rite") or {}
    _R3s(r"Full CMB spectrum (Level 2)", _st3s(_n2.get("verdict"), "N2_INCAPAZ", "NOT_CONVERGED", "NOT_SEALED") + r" (refusal)",
         r"S: $\beta=" + _n3s(_g3s(_n2, "values", "variantes", "S", "mediana"), 4) + r"\pm" + _n3s(_g3s(_n2, "values", "variantes", "S", "sigma"), 4) + r"$", r"yes (consistent)", r"no (incapable)")
    _R3s(r"GW echoes --- Phase 6 (244 BBH O1--O4; 3 readings $\times$ 2 laws) + V4/V5; the " + _i3s(_er3.get("n")) + r" pairs OUTSIDE the ledger",
         _i3s(_er3.get("excluded_by_data")) + r" \texttt{EXCLUDED\_BY\_DATA} + " + _i3s(_er3.get("inconclusive")) + r" \texttt{INCONCLUSIVE}; the PAIR falls, not the theory",
         r"$z_{\rm det}=" + _n3s(_g3s(_f6, "todos_KMS", "z_det"), 2) + r"$; $z_{\rm excl}$ R1/R2 (KMS) $" + _n3s(_g3s(_f6, "todos_KMS", "z_excl_R1"), 1) + r"$/$" + _n3s(_g3s(_f6, "todos_KMS", "z_excl_R2"), 1) + r"$; DEC $" + _n3s(_g3s(_bf5, "emenda_v5", "todos_DEC", "z_excl_R1"), 1) + r"$/$" + _n3s(_g3s(_bf5, "emenda_v5", "todos_DEC", "z_excl_R2"), 1) + r"$",
         r"yes (no echo detected: GR predicts no echo)", r"no (operator's decision of 02/10: outside the ledger)")
    _e1, _ek, _ea, _ep, _es = (core.get("gw_echo_rite") or {}), (core.get("gw_echo_kms_rite") or {}), (core.get("echo_anchored_result_v2") or {}), (core.get("echo_pe_result_v2") or {}), (core.get("echo_search_result") or {})
    _R3s(r"Echoes --- coupled V1 / KMS V1 / anchored V2 / PE V2 / long-delay search", _st3s(_e1.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ek.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ea.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ep.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_es.get("verdict"), "NOT_FALSIFIED_UNDERPOWERED"),
         r"$a/\sqrt{\bTGL}=" + _n3s(_g3s(_e1, "stack", "a_over_sqrt_beta"), 2) + r"\pm" + _n3s(_g3s(_e1, "stack", "sigma"), 2) + r"$ (power $" + _n3s(_g3s(_e1, "stack", "power_sigma"), 1) + r"\sigma$); KMS $" + _n3s(_g3s(_ek, "stack", "a_over_sqrt_beta"), 2) + r"\pm" + _n3s(_g3s(_ek, "stack", "sigma"), 2) + r"$ ($" + _n3s(_g3s(_ek, "stack", "power_sigma"), 1) + r"\sigma$); search: $N_{\rm on}=" + _i3s(_g3s(_es, "summary", "N_on")) + r"$, $B=" + _n3s(_g3s(_es, "summary", "B_exp"), 1) + r"$",
         r"yes (no echo $=$ GR)", r"no (power $<5\sigma$)")
    _R3s(r"Ringdown --- canonical branch $\tau_\star=t_{\rm Planck}$ (V2; GW250114) --- F2", _tk3s(_lo3s("F2")) + r" (ledger F2: by the systematic); branch A $=$ GR by construction",
         r"$\Delta\tau=" + _n3s(_g3s(_rd3, "stacks", "3.0", "delta_tau"), 3) + r"\pm" + _n3s(_g3s(_rd3, "stacks", "3.0", "sigma"), 3) + r"$ ($z_{\rm GR}=" + _n3s(_rd3.get("z_vs_GR"), 2) + r"$); $\delta^{A}_{\rm pred}=" + _sci3s(_rs3.get("delta_pred_A_v2"), 1) + r"$; branch-B power $" + _n3s(_rd3.get("power_B"), 2) + r"$ of $5\sigma$",
         r"yes ($\Delta\tau$ at $" + _n3s(_rd3.get("z_vs_GR"), 1) + r"\sigma$ from GR)", r"no (branch A invisible; branch B underpowered)")
    _R3s(r"Ringdown --- branch B by preregistration ($\tau_\star=k\,GM_f/c^3$) --- F2b, beside", _st3s(_rb3.get("verdict"), "AWAITING_DATA", "AWAITING") + r" (F2b: " + _tx3s(_rb3.get("F2b_status")) + ")",
         r"set D $n=" + _i3s(_rb3.get("conjunto_D_n")) + r"$ (blind); exact power A31 $" + _n3s(_g3s(_rb3, "pins", "poder_exato_A31", "read"), 1) + r"\sigma$, B10 $" + _n3s(_g3s(_rb3, "pins", "poder_exato_B10", "read"), 1) + r"\sigma$, C $" + _n3s(_g3s(_rb3, "pins", "poder_exato_C", "read"), 1) + r"\sigma$; nothing opened: " + _tx3s(_rb3.get("nothing_opened")),
         r"n/a (awaiting)", r"awaiting (v387)")
    _R3s(r"GW propagation --- R2", _tk3s(_lo3s("R2")) + r" (estimator to be built, \textsf{[DECLARED]})", r"law $\Gamma_\omega=\tfrac12\bTGL\tau_\star\omega^2$, $n=-2$", r"n/a", r"awaiting")
    _cnt3s = _lg3s.get("counts") or {}
    _R3s(r"Ledger of charges v383 (" + _i3s(len(_L3s)) + r" charges; outcome per channel) --- synthesis", "; ".join(_tx3s(i_) + "=" + _tk3s(_lo3s(i_)) for i_ in ("R1", "R2", "R3", "R4", "R6", "F1", "F2", "F3a", "F3b", "F3c", "F4")),
         r"NOT\_FALSIFIED " + _i3s(_cnt3s.get("NOT_FALSIFIED")) + r"; FALSIFIED " + _i3s(_cnt3s.get("FALSIFIED")) + r"; INCONCLUSIVE " + _i3s(_cnt3s.get("INCONCLUSIVE")) + r"; AWAITING " + _i3s(_cnt3s.get("AWAITING")) + r"; EXCLUDED\_IN\_READING " + _i3s(_cnt3s.get("EXCLUDED_IN_READING")),
         r"yes in every channel read", r"no: " + _i3s(_cnt3s.get("FALSIFIED")) + r" falsified", True)
    _R3s(r"Final verdict machine (" + _i3s(_fv3.get("channels_total")) + r" channels) --- synthesis", _st3s(_fv3.get("verdict"), "NOT_REFUTED_BY_PUBLIC_DATA_AT_CURRENT_SENSITIVITY", "NOT_REFUTED"),
         r"channels emitted " + _i3s(_fv3.get("channels_emitted")) + "/" + _i3s(_fv3.get("channels_total")) + r"; refuted " + _i3s(len(_fv3.get("refuted_channels") or [])) + r"; exclusions " + _i3s(_fv3.get("exclusions_count")), r"yes (no channel refuted)", r"no", True)
    _dr3, _ea3 = (core.get("dephasing_reach") or {}), (core.get("evidence_audit") or {})
    _R3s(r"Dephasing reach; evidence audit", _st3s(_dr3.get("verdict"), "ARMED") + r"; " + _st3s(_ea3.get("verdict"), "RECLASSIFIED"),
         r"deficit $^{229}$Th $" + _n3s(_dr3.get("deficit_orders_Th229"), 1) + r"$ orders, Sr $" + _n3s(_dr3.get("deficit_orders_Sr"), 1) + r"$; fifth entry live $" + _n3s(_g3s(_ea3, "values", "fifth_entry_live"), 3) + r"$", r"n/a", r"no (ten orders; the convergence reclassified)")

    # ---- the counts (the v387 record if present; otherwise the section counts alone, by the same guard, and says so) ----
    _acc3s = []

    def _walk3s(o_, p_):
        if isinstance(o_, dict):
            for k_, v_ in o_.items():
                _walk3s(v_, p_ + "/" + str(k_))
        elif isinstance(o_, list):
            for i_, v_ in enumerate(o_):
                _walk3s(v_, p_ + "[%d]" % i_)
        elif isinstance(o_, str) and o_.startswith("TGL_") and p_.rsplit("/", 1)[-1] == "verdict":
            _acc3s.append((p_, o_))
    _walk3s(core, "core")
    _rxf3s = _re3s.compile("(?<!NOT_)(?<!UN)FALSIFIED")
    _c3s = {
        "n": _t3s.get("n_verdicts") if _t3s else len(_acc3s),
        "nf": _t3s.get("n_not_falsified") if _t3s else sum(1 for _, v_ in _acc3s if "NOT_FALSIFIED" in v_),
        "inc": _t3s.get("n_inconclusive") if _t3s else sum(1 for _, v_ in _acc3s if "INCONCLUSIVE" in v_),
        "aw": _t3s.get("n_awaiting") if _t3s else sum(1 for _, v_ in _acc3s if "AWAITING" in v_),
        "fal_paths": _t3s.get("falsified_substring_paths") if _t3s else [p_ for p_, v_ in _acc3s if _rxf3s.search(v_)],
        "forb": _t3s.get("n_forbidden_word_as_verdict") if _t3s else sum(1 for _, v_ in _acc3s if _rx3s.search(v_)),
    }
    _fonte3s = r"source: the record \texttt{three\_stress\_tests\_v387}, computed by the rite's guard" if _t3s else r"source: a count made by this section, on the same core, by the same guard --- the record \texttt{three\_stress\_tests\_v387} is not in this run, and this is stated"
    _nsim3s = sum(1 for r_ in _rows3s if r_[3].startswith("yes") and not r_[5])   # synthesis rows (ledger, machine) are not counted twice
    _napl3s = sum(1 for r_ in _rows3s if not r_[3].startswith("n/a") and not r_[5])
    _nnao3s = sum(1 for r_ in _rows3s if r_[3].startswith("no") and not r_[5])
    _kf3s = core.get("kernel_formalization") or {}
    _ar3s = _kf3s.get("axiom_report") or {}
    _trio3s = {"propext", "Classical.choice", "Quot.sound"}
    _arn3s = len(_ar3s) if isinstance(_ar3s, dict) else None
    _arin3s = sum(1 for v_ in _ar3s.values() if isinstance(v_, list) and set(v_) <= _trio3s) if isinstance(_ar3s, dict) else None
    _ncl3s = _g3s(core, "external_ladder", "n_theorems_clean")
    _nex3s = _g3s(core, "external_ladder", "n_theorems_expected")
    _qg3s = core.get("qg_closure") or {}
    _fl3s = [v_ for d_ in ("formal_flags", "physics_flags", "experiment_flags") for v_ in ((_qg3s.get(d_) or {}).values())]
    _nfl3s, _nflt3s = sum(1 for v_ in _fl3s if v_ is True), len(_fl3s)
    _qp3s = core.get("quantum_pillar_v384") or {}
    _sm3s = _qp3s.get("summary") or {}
    _t1, _t2, _t3, _t4, _d128, _cpu, _env = (_sm3s.get("T1") or {}), (_sm3s.get("T2") or {}), (_sm3s.get("T3") or {}), (_sm3s.get("T4") or {}), (_sm3s.get("D128") or {}), (_sm3s.get("cpuref") or {}), (_sm3s.get("env") or {})
    _eng3s = _sm3s.get("engine") or []
    _qr3s = core.get("quantum_pillar_reuse_v386") or {}
    _jc3s = core.get("joint_coincidence_result_v3") or {}
    _jc1s = core.get("joint_coincidence_result") or {}
    _ctrl3s = _t3.get("controls") or {}
    _ctrl_ok3s = all(bool(_g3s(_ctrl3s, d_, n_)) for d_ in _ctrl3s for n_ in ("N1_dephasing_only", "N4_negative_rate_not_cp", "N5_time_reversal_not_cp")) if _ctrl3s else None
    _n3lin = _t3.get("N3_linear_law") or {}
    _n3ok3s = all((_g3s(_n3lin, d_, "root_law_rejected") == 1.0) for d_ in _n3lin) if _n3lin else None
    _t1ok3s = all((_g3s(_t1, "per_d", d_, "pass_sigma0") == 1.0) for d_ in (_t1.get("per_d") or {})) if _t1.get("per_d") else None

    _sec3s = []
    _sec3s.append(r"\section*{The three stress tests, taken together (v387)}")
    _sec3s.append(r"\addcontentsline{toc}{section}{The three stress tests, taken together (v387): the rites on public data, the kernel and the numerical experiment on the GPU count together}")
    _sec3s.append(r"\textbf{The operator's coinage} \textsf{[INPUT/ONTO]} (2026-10-05, 23:00:29 UTC, verbatim in Portuguese; cuts marked by …). "
                  + _qt3s("V1") + r" [sic]; " + _qt3s("V2") + r" [sic]; … " + _qt3s("V3") + r" [sic]; … " + _qt3s("V4") + r" [sic]; … " + _qt3s("V5") + r". "
                  r"This section obeys the order --- the three count together, and this is made explicit --- and places BESIDE each sentence what the number read in this run sustains, by the house ruler: GR is the theory's classical limit, not a rival (to coincide is correspondence recovered; what is stated is the size of the $\bTGL$ correction against the available $\sigma$); \emph{proved} is a theorem in the kernel, \emph{confirmed} is the observer's judgement about nature; not falsified is never confirmation.")
    _sec3s.append(r"\textbf{What the program does in one run --- and why these are three stress tests, not one.} The same execution, from the same posted One ($\omega(I)=1$, \textsf{[POSTO]}), (1) runs the pre-registered rites against public data, (2) materializes and audits the formal kernel, and (3) computes on the GPU the theory's open quantum system. "
                  r"Each can fail in its own way: a rite can return \texttt{FALSIFIED} where the channel's law admits it; the kernel can fail to compile, or compile with \texttt{sorry}, or leave the trio of axioms; the pillar can find a non-unique attractor, a blind instrument that does not recover the injected law, controls that do not fail, identities that break under stress, or disagreement with the CPU. "
                  + (r"None of the three failed in this run (read: ledger without a falsified charge, clean ladder = expected, GPU without disagreement)" if not _falhas3x else (r"In this run NOT ALL pillars passed --- failed: " + ", ".join(_falhas3x))) + r", and that none of them fails is what is measured --- not what is declared. The table below is the state read, channel by channel, pillar by pillar.")
    _hdr3s = r"\textbf{channel} & \textbf{state read} & \textbf{number read in this run} & \textbf{GR?} & \textbf{discriminates?} \\ \hline"
    _mc3s = lambda t_: r"\multicolumn{5}{@{}p{0.98\textwidth}@{}}{" + t_ + r"} \\ \hline"
    _tab3s = [r"\begin{footnotesize}\begin{longtable}{@{}p{0.22\textwidth}p{0.20\textwidth}p{0.33\textwidth}p{0.11\textwidth}p{0.11\textwidth}@{}}",
              _hdr3s, r"\endfirsthead", _hdr3s, r"\endhead",
              _mc3s(r"\textbf{Pillar 1 --- the rites on public data} (each row: verdict read from the core; «GR?» = correspondence with GR/$\Lambda$CDM recovered in the channel, the management's reading per row; «discriminates?» = does the channel separate TGL from GR at $5\sigma$?)")]
    for _r3 in _rows3s:
        _tab3s.append(_r3[0] + " & " + _r3[1] + " & " + _r3[2] + " & " + _r3[3] + " & " + _r3[4] + r" \\")
    _tab3s.append(r"\hline " + _mc3s(r"\textbf{Pillar 2 --- the formal kernel (Lean 4)}"))
    _tab3s.append(r"External ladder; axiom report; fail-closed seal & " + _st3s(_kf3s.get("verdict"), "TGL_KERNEL_STAGE1_VERIFIED") + r" & clean theorems " + _i3s(_ncl3s) + "/" + _i3s(_nex3s) + r"; declarations within the trio $\{$propext, choice, quot$\}$: " + _i3s(_arin3s) + "/" + _i3s(_arn3s) + r"; sorryAx absent: " + _tx3s(_kf3s.get("sorryAx_absent")) + r"; custom TGL axioms absent: " + _tx3s(_kf3s.get("custom_TGL_axioms_absent")) + r"; Lean " + _lv3s(_kf3s.get("lean_version")) + r" & yes: the correspondence with GR is a proved implication (\texttt{QGSolutionComplete}; $\bTGL$ is not one of its hypotheses) & n/a (a proof does not discriminate nature) \\")
    _tab3s.append(r"The gate (6 formal + 6 physical + 6 experimental) & " + _st3s(_g3s(_qg3s, "gate", "verdict"), "TGL_QG_MODEL_FORMALLY_CLOSED") + r" & flags true " + _i3s(_nfl3s) + "/" + _i3s(_nflt3s) + r"; \texttt{full\_static\_witness\_exists}=" + _tx3s(_g3s(_qg3s, "gate", "full_static_witness_exists")) + r" (by theorem); $\omega(I)=1$ tagged " + _tx3s(_g3s(core, "the_axiom_v385", "tag_for_omega_I") or "n/a") + r"; the Axiom " + _i3s(_g3s(core, "the_axiom_v385", "kernel_flags_ok")) + "/" + _i3s(_g3s(core, "the_axiom_v385", "kernel_flags_total")) + r"; the Verb " + _i3s(_g3s(core, "the_verb_v386", "kernel_flags_ok")) + "/" + _i3s(_g3s(core, "the_verb_v386", "kernel_flags_total")) + r" & --- & no: the experimental flags come from V11 (one-sided; erratum of 01/10) \\")
    _tab3s.append(r"\hline " + _mc3s(r"\textbf{Pillar 3 --- the numerical quantum experiment on the GPU} (deterministic computation of the theory's open system, \textsf{[COMPUTED]}; not language-model inference; measurement in the simulated environment, not of nature)"))
    _tab3s.append(r"T2 --- the form at scale (unique attractor on the grid) & " + _st3s(_qp3s.get("verdict"), "ATTRACTOR_UNIQUE_ALL_672_ON_THE_GRID", "ATTRACTOR_UNIQUE") + r" & unique " + _i3s(_t2.get("unique")) + "/" + _i3s(_t2.get("points")) + r" (ambiguous " + _i3s(_t2.get("ambiguous")) + r", degenerate " + _i3s(_t2.get("degenerate")) + r"); CP/TP/PSD/Spohn/zero-mode identities checked in " + _i3s(_g3s(_t2, "identities_checked", "CP")) + r" & n/a (measures the theory's system) & n/a (simulated environment) \\")
    _tab3s.append(r"T1 --- the instrument, blind & " + ("root law recovered at every $d$" if _t1ok3s else (r"\textbf{failed at some $d$}" if _t1ok3s is False else "n/a")) + r" & injections " + _i3s(_t1.get("injections")) + r"; errors " + _i3s(_t1.get("errors")) + r"; pass($\sigma_0$) per $d$: " + ", ".join(_tx3s(d_) + "=" + _n3s(_g3s(_t1, "per_d", d_, "pass_sigma0"), 2) for d_ in sorted((_t1.get("per_d") or {}).keys(), key=lambda k_: int(k_) if str(k_).isdigit() else 0)) + r" & n/a & n/a \\")
    _tab3s.append(r"T3 --- the controls that had to fail & " + ("failed as required" if _ctrl_ok3s else (r"\textbf{some control did not fail}" if _ctrl_ok3s is False else "n/a")) + r" & N1/N4/N5 at " + _i3s(len(_ctrl3s)) + r" sizes; N3 (linear law injected $\to$ root law rejected): " + ("100\\%" if _n3ok3s else ("\\textbf{no}" if _n3ok3s is False else "n/a")) + r" & n/a & n/a \\")
    _tab3s.append(r"T4 --- the stress; D128; the CPU reference & " + _st3s(_qp3s.get("verdict"), "CPU_REFERENCE_AGREES", "CPU_REFERENCE") + r" & instances " + _i3s(_t4.get("instances")) + r", unique " + _i3s(_t4.get("unique")) + r", identities checked in " + _i3s(_t4.get("all_identities_checked")) + r"; $d=128$: " + _tx3s(_d128.get("status")) + r"; CPU: " + _i3s(_cpu.get("compared")) + r" comparisons, " + _i3s(_cpu.get("disagreements")) + r" disagreements; engine " + _i3s(sum(1 for c_ in _eng3s if isinstance(c_, dict) and c_.get("ok"))) + "/" + _i3s(len(_eng3s)) + r" & n/a & n/a \\")
