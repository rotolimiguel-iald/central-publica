    def _g3s(o_, *path_):
        """reads by path (keys and indices); absence => None, never raises (fail-closed, visible: a missing number prints n/a)."""
        try:
            for p_ in path_:
                if isinstance(o_, dict):
                    o_ = o_.get(p_)
                elif isinstance(o_, list) and isinstance(p_, int) and -len(o_) <= p_ < len(o_):
                    o_ = o_[p_]
                else:
                    return None
            return o_
        except Exception:
            return None

    def _tx3s(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n3s(x_, nd_=2):
        if isinstance(x_, bool) or not isinstance(x_, (int, float)) or x_ != x_:
            return r"\text{n/a}"
        return "%%.%df" % nd_ % float(x_)

    def _sci3s(x_, nd_=2):
        if isinstance(x_, bool) or not isinstance(x_, (int, float)) or x_ != x_ or x_ == 0:
            return r"\text{n/a}" if (x_ != 0 or x_ is None or isinstance(x_, bool)) else "0"
        m_, e_ = ("%%.%de" % nd_ % float(x_)).split("e")
        return m_ + r"\times10^{" + str(int(e_)) + "}"

    def _i3s(x_):
        return str(int(x_)) if isinstance(x_, (int, float)) and not isinstance(x_, bool) and x_ == x_ else r"n/a"

    def _tk3s(x_):
        """a token in \\texttt with breaks allowed at the underscores (narrow columns)."""
        return r"\texttt{" + _tx3s(x_).replace(r"\_", r"\_\allowbreak{}") + "}"

    def _st3s(v_, *cands_):
        """the short state: the first candidate the read verdict contains; otherwise the token itself, cut and escaped (never invented)."""
        v_ = str(v_ or "")
        for c_ in cands_:
            if c_ in v_:
                return _tk3s(c_)
        return (_tk3s(v_[:38]) + (r"\ldots" if len(v_) > 38 else "")) if v_ else _tk3s("ABSENT")

    def _seg3s(v_, i_=1):
        """the i-th segment (separator «__») of the read verdict --- a piece of the token, never an invented state."""
        p_ = str(v_ or "").split("__")
        return _tk3s(p_[i_]) if (v_ and len(p_) > i_) else _tk3s("ABSENT")

    def _lv3s(x_):
        """the Lean version read from the core (list or string): the version number only."""
        t_ = str(x_[0] if isinstance(x_, list) and x_ else (x_ or ""))
        m_ = _re3s.search(r"version\s+([0-9][0-9.]*)", t_)
        return _tx3s(m_.group(1)) if m_ else (_tx3s(t_[:22]) if t_ else "n/a")

