    # v387 (2026-10-06) -- BESIDE: the Hubble ratio (Phase 9) and the radiation era (Phase 8) PREREGISTERED by hash on the Bench; the law of proof of 2026-10-05
    # («postdiction» is never a demerit: retrodiction without adjustment, use-novelty). The operator's quotations are VERBATIM in Portuguese (checked by the
    # package's citation checker against the file by sha256), translations OUTSIDE the quotes; numbers READ from the core records; nothing opened; the gate does not move.
    _hr7 = core.get("hubble_ratio_v387") or {}
    _pr7 = core.get("primordial_v387") or {}
    _rr7 = core.get("retrodiction_reading_v387") or {}
    _ht7 = _hr7.get("transcribed") or {}
    _pt7 = _pr7.get("transcribed") or {}

    def _tx7(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n7(x_, nd_=2):
        if not isinstance(x_, (int, float)) or isinstance(x_, bool) or x_ != x_:
            return r"\text{n/a}"
        return "%%.%df" % nd_ % float(x_)

    def _e7(x_):
        if not isinstance(x_, (int, float)) or isinstance(x_, bool) or x_ != x_ or x_ == 0:
            return r"\text{n/a}"
        m_, e_ = ("%.2e" % float(x_)).split("e")
        return m_ + r"\times10^{" + str(int(e_)) + "}"
    _tk7 = lambda x_: r"\texttt{" + _tx7(x_).replace(r"\_", r"\_\allowbreak{}") + "}"
    _b7 = _ht7.get("BG1_H0"); _K7 = _ht7.get("K_no_fundo_nu")
    _prev7 = (_b7 * _K7) if isinstance(_b7, (int, float)) and isinstance(_K7, (int, float)) else None
    _cr7 = _pt7.get("controle_D3_razao_E_menos_1") or []
    _br7 = _pt7.get("bracket_DeltaN_BBN") or [None, None]
    s.append(r"\section*{Beside (v387): the Hubble ratio and the radiation era preregistered; retrodiction without adjustment}")
    s.append(r"\addcontentsline{toc}{section}{Beside (v387): the Hubble ratio and the radiation era preregistered; retrodiction without adjustment}")
    s.append(r"\textbf{The law of proof.} On 2026-10-05 the operator fixed the criterion: ``estudar hipóteses para depois formular testes para saber o caminho correto do teste também não é pós-dicção'' "
             r"(\emph{studying hypotheses in order to then formulate tests, to know the right path of the test, is not postdiction either}); and a criterion that no derivation by the author could "
             r"satisfy ``é a própria prova diabólica do Direito'' (\emph{is the law's own probatio diabolica}). The value of evidence is measured by \emph{use-novelty} --- no parameter of the "
             r"theory fitted to the datum --- not by temporal novelty; the precedent is Mercury's perihelion, an anomaly known since 1859 and explained in 1915 with no free parameter \textsf{[KNOWN]}. "
             r"Hence, in this paper, where it read \emph{declared postdiction} it now reads \emph{retrodiction without adjustment (use-novelty)}, BESIDE: the sealed Coma token and the neutrino "
             r"frozen record (v141, hashed in its preregistration) stay as record. Record: " + _tk7(_rr7.get("verdict") or "ABSENT") + r".")
    s.append(r"\textbf{The Hubble ratio (Phase 9), preregistered.} Law D1b predicts that every local distance calibrator reads $K\cdot H_0^{\rm bg}$, with $K=E_{\Lambda\rm CDM}(z_\star)^{2\beta/3}="
             + _n7(_K7, 6) + r"$ (zero free parameters; $z_\star=" + _n7(_ht7.get("z_star"), 2) + r"$), and every face (CMB, BAO) reads $H_0^{\rm bg}$. The primary background is the \emph{bare} one, "
             r"without the ladder: $H_0^{\rm bg}=" + _n7(_b7, 3) + r"\pm" + _n7(_ht7.get("BG1_sigma"), 3) + r"$ (compressed Planck + DESI DR2), and the local prediction is $" + _n7(_prev7, 2)
             + r"$ km/s/Mpc. The prior power, with public $\sigma$'s only, is $" + _n7(_ht7.get("poder_previo_primario"), 2) + r"\sigma$ in the primary family ($" + _n7(_ht7.get("poder_nao_cefeida"), 2)
             + r"\sigma$ without the Cepheids; the readers' $\sigma$'s remain \textsf{[DECLARADO]} until the sources by hash). "
             + (r"There is \emph{one} verdict function, frozen by hash with the preregistration on the Bench; use-novelty is checked on the \emph{parameters}. " if _hr7.get("read_ok") is True
                else r"\textbf{In this run the V1 was NOT read by hash}: nothing said here counts as preregistration. ")
             + r""
             r"\textbf{Nothing was opened}: fetching the public sources with sha256 and opening the composite are the operator's acts; opening before the sources would return, by the function itself, "
             + _tk7(_ht7.get("se_abrir_hoje_predeterminado") or "n/a") + r". Record: " + _tk7(_hr7.get("verdict") or "ABSENT") + r".")
    s.append((r"" if _pr7.get("read_ok") is True else r"\textbf{In this run the Phase 8 V1 was NOT read by hash}: nothing that follows counts as preregistration. ")
             + r"\textbf{The radiation era (Phase 8), preregistered.} The law dresses the total fluid --- $\rho_{\rm TGL}=\beta(\rho+p)$, a kernel identity --- and therefore gives its \emph{maximum} in the "
             r"radiation era: $H^2=(1+4\beta/3)\rho_r+(1+\beta)\rho_m+\rho_\Lambda$, i.e.\ $\Delta N_{\rm eff}=+" + _n7(_pt7.get("delta_N_eff"), 4) + r"$ ($N_{\rm eff}^{\rm TGL}=" + _n7(_pt7.get("N_eff_TGL"), 4)
             + r"$); at nucleosynthesis the equivalent lies between $" + _n7(_br7[0], 4) + r"$ and $" + _n7(_br7[1], 4) + r"$, and the exact form is the speed-up $S=" + _n7(_pt7.get("S_BBN"), 6) + r"$. "
             r"The $N_{\rm eff}$ channel was wired on the Bench \emph{before} the terminal program, with a single entry of $\beta$ per instrument; the control against double counting (the radiation-era "
             r"$H(z)$ from the engine with $\Phi_{\rm total}$ against $\Lambda$CDM with shifted $N_{\rm eff}$) " + (r"passed: $" + _e7(_cr7[0] if len(_cr7) > 0 else None) + r"$ and $" + _e7(_cr7[1] if len(_cr7) > 1 else None) + r"$"
             if _pt7.get("controle_D3_passou") is True else r"\textbf{did not pass or was not read}") + r". Today's power is $" + _n7(_pt7.get("poder_melhor_independente"), 2)
             + r"\sigma$ in the best independent analysis: the maximal outcome is \emph{not falsified, underpowered}, and this is said beforehand; $5\sigma$ requires $\sigma(N_{\rm eff})\le" + _n7(_pt7.get("sigma_N_eff_para_5sigma"), 4)
             + r"$. The reading \emph{Big Bang as the originary inscription} remains \textsf{[ONTO]}: the kernel proves a theorem about the \emph{flow}, not about $t=0$. Record: " + _tk7(_pr7.get("verdict") or "ABSENT") + r".")
