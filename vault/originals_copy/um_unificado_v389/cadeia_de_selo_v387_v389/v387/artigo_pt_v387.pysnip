    # v387 (06/10/2026) -- AO LADO: a razao de Hubble (Fase 9) e a era da radiacao (Fase 8) PRE-REGISTRADAS por hash na Bancada; a lei da prova de 05/10
    # («pos-dicao» nunca e' demerito: retrodicao sem ajuste, novidade de uso). As citacoes do operador sao VERBATIM (conferidas pelo conferidor de citacoes do
    # pacote contra o arquivo por sha256); «…» marca todo corte; os numeros sao LIDOS dos registros do core; nada aberto; PROVADA != CONFIRMADA; o gate nao se move.
    _hr7 = core.get("hubble_ratio_v387") or {}
    _pr7 = core.get("primordial_v387") or {}
    _rr7 = core.get("retrodiction_reading_v387") or {}
    _ht7 = _hr7.get("transcribed") or {}
    _pt7 = _pr7.get("transcribed") or {}

    def _tx7(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n7(x_, nd_=2):
        if not isinstance(x_, (int, float)) or isinstance(x_, bool) or x_ != x_:
            return r"\text{n/d}"
        return ("%%.%df" % nd_ % float(x_)).replace(".", "{,}")

    def _e7(x_):
        if not isinstance(x_, (int, float)) or isinstance(x_, bool) or x_ != x_ or x_ == 0:
            return r"\text{n/d}"
        m_, e_ = ("%.2e" % float(x_)).split("e")
        return m_.replace(".", "{,}") + r"\times10^{" + str(int(e_)) + "}"
    _tk7 = lambda x_: r"\texttt{" + _tx7(x_).replace(r"\_", r"\_\allowbreak{}") + "}"
    _b7 = _ht7.get("BG1_H0"); _K7 = _ht7.get("K_no_fundo_nu")
    _prev7 = (_b7 * _K7) if isinstance(_b7, (int, float)) and isinstance(_K7, (int, float)) else None
    _cr7 = _pt7.get("controle_D3_razao_E_menos_1") or []
    _br7 = _pt7.get("bracket_DeltaN_BBN") or [None, None]
    s.append(r"\section*{Ao lado (v387): a razão de Hubble e a era da radiação pré-registradas; retrodição sem ajuste}")
    s.append(r"\addcontentsline{toc}{section}{Ao lado (v387): a razão de Hubble e a era da radiação pré-registradas; retrodição sem ajuste}")
    s.append(r"\textbf{A lei da prova.} Em 05/10/2026 o operador fixou o critério: ``estudar hipóteses para depois formular testes para saber o caminho correto do teste também não é pós-dicção''; "
             r"e um critério que nenhuma derivação do autor possa satisfazer ``é a própria prova diabólica do Direito''. O valor de uma evidência mede-se pela \emph{novidade de uso} "
             r"--- nenhum parâmetro da teoria ajustado ao dado --- e não pela novidade temporal; o precedente é o periélio de Mercúrio, anomalia conhecida desde 1859 e explicada em 1915 "
             r"sem parâmetro livre \textsf{[KNOWN]}. Por isso, neste artigo, onde se lia \emph{pós-dição declarada} lê-se \emph{retrodição sem ajuste (novidade de uso)}, AO LADO: "
             r"o token selado do Coma e o frozen dos neutrinos (v141, hasheado no seu pré-registro) ficam como registro. Registro: " + _tk7(_rr7.get("verdict") or "AUSENTE") + r".")
    s.append(r"\textbf{A razão de Hubble (Fase 9), pré-registrada.} A lei D1b prevê que todo calibrador local por distância lê $K\cdot H_0^{\rm fundo}$, com $K=E_{\Lambda\rm CDM}(z_\star)^{2\beta/3}="
             + _n7(_K7, 6) + r"$ (zero parâmetro livre; $z_\star=" + _n7(_ht7.get("z_star"), 2) + r"$), e que toda face (CMB, BAO) lê $H_0^{\rm fundo}$. O fundo primário é o fundo \emph{nu}, "
             r"sem a escada: $H_0^{\rm fundo}=" + _n7(_b7, 3) + r"\pm" + _n7(_ht7.get("BG1_sigma"), 3) + r"$ (Planck comprimido + DESI DR2), e a previsão local é $" + _n7(_prev7, 2)
             + r"$ km/s/Mpc. O poder prévio, só com as $\sigma$ públicas, é $" + _n7(_ht7.get("poder_previo_primario"), 2) + r"\sigma$ na família primária ($" + _n7(_ht7.get("poder_nao_cefeida"), 2)
             + r"\sigma$ sem as Cefeidas; as $\sigma$ dos leitores seguem \textsf{[DECLARADO]} até as fontes por hash). "
             + (r"Há \emph{uma} função de veredito, congelada por hash com o pré-registro na Bancada; a novidade de uso é verificada pelos \emph{parâmetros}. " if _hr7.get("read_ok") is True
                else r"\textbf{Nesta rodada o V1 NÃO foi lido por hash}: nada do que se diz aqui vale como pré-registro. ")
             + r""
             r"\textbf{Nada foi aberto}: baixar as fontes públicas com sha256 e abrir o composto são atos do operador; abrir antes das fontes devolveria, pela própria função, "
             + _tk7(_ht7.get("se_abrir_hoje_predeterminado") or "n/d") + r". Registro: " + _tk7(_hr7.get("verdict") or "AUSENTE") + r".")
    s.append((r"" if _pr7.get("read_ok") is True else r"\textbf{Nesta rodada o V1 da Fase 8 NÃO foi lido por hash}: nada do que segue vale como pré-registro. ")
             + r"\textbf{A era da radiação (Fase 8), pré-registrada.} A lei veste o fluido total --- $\rho_{\rm TGL}=\beta(\rho+p)$, identidade de kernel --- e por isso dá o \emph{máximo} na radiação: "
             r"$H^2=(1+4\beta/3)\rho_r+(1+\beta)\rho_m+\rho_\Lambda$, ou seja, $\Delta N_{\rm eff}=+" + _n7(_pt7.get("delta_N_eff"), 4) + r"$ ($N_{\rm eff}^{\rm TGL}=" + _n7(_pt7.get("N_eff_TGL"), 4)
             + r"$); na nucleossíntese o equivalente fica entre $" + _n7(_br7[0], 4) + r"$ e $" + _n7(_br7[1], 4) + r"$, e o exato é a aceleração $S=" + _n7(_pt7.get("S_BBN"), 6) + r"$. "
             r"O canal $N_{\rm eff}$ foi ligado na Bancada \emph{antes} do programa terminal, com uma só entrada de $\beta$ por instrumento; o controle contra a dupla contagem (o $H(z)$ da radiação "
             r"pelo motor com $\Phi_{\rm total}$ contra o $\Lambda$CDM com $N_{\rm eff}$ deslocado) " + (r"passou: $" + _e7(_cr7[0] if len(_cr7) > 0 else None) + r"$ e $" + _e7(_cr7[1] if len(_cr7) > 1 else None) + r"$"
             if _pt7.get("controle_D3_passou") is True else r"\textbf{não passou ou não foi lido}") + r". O poder de hoje é $" + _n7(_pt7.get("poder_melhor_independente"), 2)
             + r"\sigma$ na melhor análise independente: o desfecho máximo é \emph{não falsificada, sem poder}, e isso fica dito antes; $5\sigma$ pedem $\sigma(N_{\rm eff})\le" + _n7(_pt7.get("sigma_N_eff_para_5sigma"), 4)
             + r"$. A leitura \emph{Big Bang como inscrição originária} segue \textsf{[ONTO]}: o kernel prova um teorema sobre o \emph{fluxo}, não sobre $t=0$. Registro: " + _tk7(_pr7.get("verdict") or "AUSENTE") + r".")
