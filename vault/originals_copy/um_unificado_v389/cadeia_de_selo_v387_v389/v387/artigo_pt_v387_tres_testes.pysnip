    _cnt3s = _lg3s.get("counts") or {}
    _R3s(r"Livro de cobranças v383 (" + _i3s(len(_L3s)) + r" cobranças; desfecho por canal) --- síntese", "; ".join(_tx3s(i_) + "=" + _tk3s(_lo3s(i_)) for i_ in ("R1", "R2", "R3", "R4", "R6", "F1", "F2", "F3a", "F3b", "F3c", "F4")),
         r"NOT\_FALSIFIED " + _i3s(_cnt3s.get("NOT_FALSIFIED")) + r"; FALSIFIED " + _i3s(_cnt3s.get("FALSIFIED")) + r"; INCONCLUSIVE " + _i3s(_cnt3s.get("INCONCLUSIVE")) + r"; AWAITING " + _i3s(_cnt3s.get("AWAITING")) + r"; EXCLUDED\_IN\_READING " + _i3s(_cnt3s.get("EXCLUDED_IN_READING")),
         r"sim em cada canal lido", r"não: " + _i3s(_cnt3s.get("FALSIFIED")) + r" falsificada(s)", True)
    _R3s(r"Máquina do veredito final (" + _i3s(_fv3.get("channels_total")) + r" canais) --- síntese", _st3s(_fv3.get("verdict"), "NOT_REFUTED_BY_PUBLIC_DATA_AT_CURRENT_SENSITIVITY", "NOT_REFUTED"),
         r"canais emitidos " + _i3s(_fv3.get("channels_emitted")) + "/" + _i3s(_fv3.get("channels_total")) + r"; refutados " + _i3s(len(_fv3.get("refuted_channels") or [])) + r"; exclusões " + _i3s(_fv3.get("exclusions_count")), r"sim (nenhum canal refutado)", r"não", True)
    _dr3, _ea3 = (core.get("dephasing_reach") or {}), (core.get("evidence_audit") or {})
    _R3s(r"Alcance do dephasing; auditoria da evidência", _st3s(_dr3.get("verdict"), "ARMED") + r"; " + _st3s(_ea3.get("verdict"), "RECLASSIFIED"),
         r"déficit $^{229}$Th $" + _n3s(_dr3.get("deficit_orders_Th229"), 1) + r"$ ordens, Sr $" + _n3s(_dr3.get("deficit_orders_Sr"), 1) + r"$; quinta entrada ao vivo $" + _n3s(_g3s(_ea3, "values", "fifth_entry_live"), 3) + r"$", r"n/a", r"não (dez ordens; a convergência reclassificada)")

    # ---- as contagens (o registro v387 se houver; senão a seção conta sozinha pela mesma guarda, e diz) ----
    _acc3s = []

    def _walk3s(o_, p_):
        if isinstance(o_, dict):
            for k_, v_ in o_.items():
                _walk3s(v_, p_ + "/" + str(k_))
        elif isinstance(o_, list):
            for i_, v_ in enumerate(o_):
                _walk3s(v_, p_ + "[%d]" % i_)
        elif isinstance(o_, str) and o_.startswith("TGL_") and p_.rsplit("/", 1)[-1] == "verdict":
            _acc3s.append((p_, o_))
    _walk3s(core, "core")
    _rxf3s = _re3s.compile("(?<!NOT_)(?<!UN)FALSIFIED")
    _c3s = {
        "n": _t3s.get("n_verdicts") if _t3s else len(_acc3s),
        "nf": _t3s.get("n_not_falsified") if _t3s else sum(1 for _, v_ in _acc3s if "NOT_FALSIFIED" in v_),
        "inc": _t3s.get("n_inconclusive") if _t3s else sum(1 for _, v_ in _acc3s if "INCONCLUSIVE" in v_),
        "aw": _t3s.get("n_awaiting") if _t3s else sum(1 for _, v_ in _acc3s if "AWAITING" in v_),
        "fal_paths": _t3s.get("falsified_substring_paths") if _t3s else [p_ for p_, v_ in _acc3s if _rxf3s.search(v_)],
        "forb": _t3s.get("n_forbidden_word_as_verdict") if _t3s else sum(1 for _, v_ in _acc3s if _rx3s.search(v_)),
    }
    _fonte3s = r"fonte: o registro \texttt{three\_stress\_tests\_v387}, computado pela guarda do rito" if _t3s else r"fonte: contagem feita por esta seção, no mesmo core, pela mesma guarda --- o registro \texttt{three\_stress\_tests\_v387} não está nesta rodada, e isto fica dito"
    _nsim3s = sum(1 for r_ in _rows3s if r_[3].startswith("sim") and not r_[5])   # as linhas de síntese (livro, máquina) não contam duas vezes
    _napl3s = sum(1 for r_ in _rows3s if not r_[3].startswith("n/a") and not r_[5])
    _nnao3s = sum(1 for r_ in _rows3s if r_[3].startswith("não") and not r_[5])
    _kf3s = core.get("kernel_formalization") or {}
    _ar3s = _kf3s.get("axiom_report") or {}
    _trio3s = {"propext", "Classical.choice", "Quot.sound"}
    _arn3s = len(_ar3s) if isinstance(_ar3s, dict) else None
    _arin3s = sum(1 for v_ in _ar3s.values() if isinstance(v_, list) and set(v_) <= _trio3s) if isinstance(_ar3s, dict) else None
    _ncl3s = _g3s(core, "external_ladder", "n_theorems_clean")
    _nex3s = _g3s(core, "external_ladder", "n_theorems_expected")
