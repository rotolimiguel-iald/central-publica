    _fl3s = [v_ for d_ in ("formal_flags", "physics_flags", "experiment_flags") for v_ in ((_qg3s.get(d_) or {}).values())]
    _nfl3s, _nflt3s = sum(1 for v_ in _fl3s if v_ is True), len(_fl3s)
    _qp3s = core.get("quantum_pillar_v384") or {}
    _sm3s = _qp3s.get("summary") or {}
    _t1, _t2, _t3, _t4, _d128, _cpu, _env = (_sm3s.get("T1") or {}), (_sm3s.get("T2") or {}), (_sm3s.get("T3") or {}), (_sm3s.get("T4") or {}), (_sm3s.get("D128") or {}), (_sm3s.get("cpuref") or {}), (_sm3s.get("env") or {})
    _eng3s = _sm3s.get("engine") or []
    _qr3s = core.get("quantum_pillar_reuse_v386") or {}
    _jc3s = core.get("joint_coincidence_result_v3") or {}
    _jc1s = core.get("joint_coincidence_result") or {}
    _ctrl3s = _t3.get("controls") or {}
    _ctrl_ok3s = all(bool(_g3s(_ctrl3s, d_, n_)) for d_ in _ctrl3s for n_ in ("N1_dephasing_only", "N4_negative_rate_not_cp", "N5_time_reversal_not_cp")) if _ctrl3s else None
    _n3lin = _t3.get("N3_linear_law") or {}
    _n3ok3s = all((_g3s(_n3lin, d_, "root_law_rejected") == 1.0) for d_ in _n3lin) if _n3lin else None
    _t1ok3s = all((_g3s(_t1, "per_d", d_, "pass_sigma0") == 1.0) for d_ in (_t1.get("per_d") or {})) if _t1.get("per_d") else None

    _sec3s = []
    _sec3s.append(r"\section*{Os três testes de estresse, conjuntos (v387)}")
    _sec3s.append(r"\addcontentsline{toc}{section}{Os três testes de estresse, conjuntos (v387): os ritos com dados públicos, o kernel e o experimento numérico na GPU contam juntos}")
    _sec3s.append(r"\textbf{A cunhagem do operador} \textsf{[INPUT/ONTO]} (05/10/2026, 23:00:29 UTC, verbatim; os cortes marcados por …). "
                  + _q3s("V1") + r" [sic]; " + _q3s("V2") + r" [sic]; … " + _q3s("V3") + r" [sic]; … " + _q3s("V4") + r" [sic]; … " + _q3s("V5") + r". "
                  r"Esta seção obedece à ordem --- os três contam juntos, e isto fica explícito --- e põe AO LADO de cada frase o que o número lido nesta rodada sustenta, pela régua da casa: a RG é o limite clássico da teoria, não rival (coincidir é correspondência recuperada; o que se diz é o tamanho da correção $\bTGL$ contra o $\sigma$ disponível); PROVADA é teorema no kernel, CONFIRMADA é juízo do observador sobre a natureza; não falsificado nunca é confirmação.")
    _sec3s.append(r"\textbf{O que o programa faz numa rodada --- e por que são três testes de estresse, não um.} A mesma execução, a partir do mesmo Um posto ($\omega(I)=1$, \textsf{[POSTO]}), (1) roda os ritos pré-registrados contra dados públicos, (2) materializa e audita o kernel formal, e (3) calcula na GPU o sistema quântico aberto da teoria. "
                  r"Cada um pode falhar de modo próprio: um rito pode devolver \texttt{FALSIFIED} onde a lei do canal o admite; o kernel pode não compilar, ou compilar com \texttt{sorry}, ou sair do trio de axiomas; o pilar pode encontrar atrator não único, um instrumento cego que não recupera a lei injetada, controles que não falham, identidades que quebram no estresse ou discordância com a CPU. "
                  + (r"Nenhum dos três falhou nesta rodada (lido: livro sem falsificada, escada limpa = esperada, GPU sem discordância)" if not _falhas3x else (r"Nesta rodada NEM TODOS os pilares passaram --- falhou: " + ", ".join(_falhas3x))) + r", e nenhum deles falhar é o que se mede --- não o que se declara. A tabela abaixo é o estado lido, canal a canal, pilar a pilar.")
    _hdr3s = r"\textbf{canal} & \textbf{estado lido} & \textbf{número lido nesta rodada} & \textbf{RG?} & \textbf{discrimina?} \\ \hline"
    _mc3s = lambda t_: r"\multicolumn{5}{@{}p{0.98\textwidth}@{}}{" + t_ + r"} \\ \hline"
    _tab3s = [r"\begin{footnotesize}\begin{longtable}{@{}p{0.22\textwidth}p{0.20\textwidth}p{0.33\textwidth}p{0.11\textwidth}p{0.11\textwidth}@{}}",
              _hdr3s, r"\endfirsthead", _hdr3s, r"\endhead",
              _mc3s(r"\textbf{Pilar 1 --- os ritos com dados públicos} (cada linha: veredito lido do core; «RG?» = correspondência com a RG/$\Lambda$CDM recuperada no canal, leitura da gerência por linha; «discrimina?» = o canal separa a TGL da RG a $5\sigma$?)")]
    for _r3 in _rows3s:
        _tab3s.append(_r3[0] + " & " + _r3[1] + " & " + _r3[2] + " & " + _r3[3] + " & " + _r3[4] + r" \\")
    _tab3s.append(r"\hline " + _mc3s(r"\textbf{Pilar 2 --- o kernel formal (Lean 4)}"))
    _tab3s.append(r"Escada externa; relatório de axiomas; selo fail-closed & " + _st3s(_kf3s.get("verdict"), "TGL_KERNEL_STAGE1_VERIFIED") + r" & teoremas limpos " + _i3s(_ncl3s) + "/" + _i3s(_nex3s) + r"; declarações no trio $\{$propext, choice, quot$\}$: " + _i3s(_arin3s) + "/" + _i3s(_arn3s) + r"; sorryAx ausente: " + _tx3s(_kf3s.get("sorryAx_absent")) + r"; axiomas TGL customizados ausentes: " + _tx3s(_kf3s.get("custom_TGL_axioms_absent")) + r"; Lean " + _lv3s(_kf3s.get("lean_version")) + r" & sim: a correspondência com a RG é implicação provada (\texttt{QGSolutionComplete}; $\bTGL$ não é hipótese dela) & n/a (prova não discrimina a natureza) \\")
    _tab3s.append(r"O gate (6 formais + 6 físicas + 6 experimentais) & " + _st3s(_g3s(_qg3s, "gate", "verdict"), "TGL_QG_MODEL_FORMALLY_CLOSED") + r" & bandeiras verdadeiras " + _i3s(_nfl3s) + "/" + _i3s(_nflt3s) + r"; \texttt{full\_static\_witness\_exists}=" + _tx3s(_g3s(_qg3s, "gate", "full_static_witness_exists")) + r" (por teorema); $\omega(I)=1$ etiquetado " + _tx3s(_g3s(core, "the_axiom_v385", "tag_for_omega_I") or "n/d") + r"; o Axioma " + _i3s(_g3s(core, "the_axiom_v385", "kernel_flags_ok")) + "/" + _i3s(_g3s(core, "the_axiom_v385", "kernel_flags_total")) + r"; o Verbo " + _i3s(_g3s(core, "the_verb_v386", "kernel_flags_ok")) + "/" + _i3s(_g3s(core, "the_verb_v386", "kernel_flags_total")) + r" & --- & não: as experimentais vêm do V11 (unilateral; errata de 01/10) \\")
    _tab3s.append(r"\hline " + _mc3s(r"\textbf{Pilar 3 --- o experimento numérico quântico na GPU} (cálculo determinístico do sistema aberto da teoria, \textsf{[COMPUTED]}; não é inferência de modelo de linguagem; medição no ambiente simulado, não da natureza)"))
    _tab3s.append(r"T2 --- a forma na escala (atrator único na grade) & " + _st3s(_qp3s.get("verdict"), "ATTRACTOR_UNIQUE_ALL_672_ON_THE_GRID", "ATTRACTOR_UNIQUE") + r" & únicos " + _i3s(_t2.get("unique")) + "/" + _i3s(_t2.get("points")) + r" (ambíguos " + _i3s(_t2.get("ambiguous")) + r", degenerados " + _i3s(_t2.get("degenerate")) + r"); identidades CP/TP/PSD/Spohn/modo zero conferidas em " + _i3s(_g3s(_t2, "identities_checked", "CP")) + r" & n/a (mede o sistema da teoria) & n/a (ambiente simulado) \\")
    _tab3s.append(r"T1 --- o instrumento, às cegas & " + ("lei-raiz recuperada em todo $d$" if _t1ok3s else (r"\textbf{falhou em algum $d$}" if _t1ok3s is False else "n/d")) + r" & injeções " + _i3s(_t1.get("injections")) + r"; erros " + _i3s(_t1.get("errors")) + r"; pass($\sigma_0$) por $d$: " + ", ".join(_tx3s(d_) + "=" + _n3s(_g3s(_t1, "per_d", d_, "pass_sigma0"), 2) for d_ in sorted((_t1.get("per_d") or {}).keys(), key=lambda k_: int(k_) if str(k_).isdigit() else 0)) + r" & n/a & n/a \\")
    _tab3s.append(r"T3 --- os controles que deviam falhar & " + ("falharam como exigido" if _ctrl_ok3s else (r"\textbf{algum controle não falhou}" if _ctrl_ok3s is False else "n/d")) + r" & N1/N4/N5 em " + _i3s(len(_ctrl3s)) + r" tamanhos; N3 (lei linear injetada $\to$ lei-raiz rejeitada): " + ("100\\%" if _n3ok3s else ("\\textbf{não}" if _n3ok3s is False else "n/d")) + r" & n/a & n/a \\")
