    def _g3s(o_, *path_):
        """lê por caminho (chaves e índices); ausência => None, nunca levanta (fail-closed visível: o número que falta imprime n/d)."""
        try:
            for p_ in path_:
                if isinstance(o_, dict):
                    o_ = o_.get(p_)
                elif isinstance(o_, list) and isinstance(p_, int) and -len(o_) <= p_ < len(o_):
                    o_ = o_[p_]
                else:
                    return None
            return o_
        except Exception:
            return None

    def _tx3s(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n3s(x_, nd_=2):
        if isinstance(x_, bool) or not isinstance(x_, (int, float)) or x_ != x_:
            return r"\text{n/d}"
        return ("%%.%df" % nd_ % float(x_)).replace(".", "{,}")

    def _sci3s(x_, nd_=2):
        if isinstance(x_, bool) or not isinstance(x_, (int, float)) or x_ != x_ or x_ == 0:
            return r"\text{n/d}" if (x_ != 0 or x_ is None or isinstance(x_, bool)) else "0"
        m_, e_ = ("%%.%de" % nd_ % float(x_)).split("e")
        return m_.replace(".", "{,}") + r"\times10^{" + str(int(e_)) + "}"

    def _i3s(x_):
        return str(int(x_)) if isinstance(x_, (int, float)) and not isinstance(x_, bool) and x_ == x_ else r"n/d"

    def _tk3s(x_):
        """token em \\texttt com quebra permitida nos sublinhados (colunas estreitas)."""
        return r"\texttt{" + _tx3s(x_).replace(r"\_", r"\_\allowbreak{}") + "}"

    def _st3s(v_, *cands_):
        """o estado curto: o primeiro candidato que o veredito lido contém; senão o próprio token, cortado e escapado (nunca inventado)."""
        v_ = str(v_ or "")
        for c_ in cands_:
            if c_ in v_:
                return _tk3s(c_)
        return (_tk3s(v_[:38]) + (r"\ldots" if len(v_) > 38 else "")) if v_ else _tk3s("AUSENTE")

    def _seg3s(v_, i_=1):
        """o i-ésimo segmento (separador «__») do veredito lido --- um pedaço do token, nunca um estado inventado."""
        p_ = str(v_ or "").split("__")
        return _tk3s(p_[i_]) if (v_ and len(p_) > i_) else _tk3s("AUSENTE")

    def _lv3s(x_):
        """a versão do Lean lida do core (lista ou string): só o número da versão."""
        t_ = str(x_[0] if isinstance(x_, list) and x_ else (x_ or ""))
        m_ = _re3s.search(r"version\s+([0-9][0-9.]*)", t_)
        return _tx3s(m_.group(1)) if m_ else (_tx3s(t_[:22]) if t_ else "n/d")

