    _R3s(r"Tensão de Hubble --- D1 via CAMB V3 (fundo vestido) --- R6, ao lado", _tk3s(_lo3s("R6")) + r" (livro R6: $z=" + _n3s(_ln3s("R6"), 2) + r"$); não-cego",
         r"$\Delta\chi^2=" + _n3s(_d3.get("delta_chi2"), 2) + r"$ ($n=" + _i3s(_d3.get("n_data")) + r"$); $\beta=" + _n3s(_g3s(_d3, "beta_posterior", "median"), 4) + r"\pm" + _n3s(_g3s(_d3, "beta_posterior", "sigma"), 4) + r"$; $\alpha\sqrt e$ a $" + _n3s(_d3.get("z_alpha_sqrt_e"), 2) + r"\sigma$",
         r"sim no limite $\beta\to0$", r"$" + _n3s(_d3.get("z_alpha_sqrt_e"), 2) + r"\sigma$ CONTRA $\bTGL$ no fundo vestido; tensão não é falsificação")
    _R3s(r"SNe --- Pantheon+ canônico (1593)", _seg3s(_g3s(_fv3, "channels", "pantheon_canonical_1593", "verdict") or _ce3.get("verdict"), 1) + r" (teoria a $" + _n3s(_ce3.get("d_theory_sigma"), 2) + r"\sigma$; não preferida por BIC com $\beta$ livre)",
         r"$\hat\beta=" + _n3s(_g3s(_ce3, "source_INPUT", "beta_hat"), 4) + r"\pm" + _n3s(_g3s(_ce3, "source_INPUT", "sigma"), 4) + r"$; zero a $" + _n3s(_ce3.get("d_zero_sigma"), 2) + r"\sigma$; $\Delta\mathrm{BIC}=" + _n3s(_g3s(_ce3, "source_INPUT", "delta_BIC"), 2) + r"$",
         r"sim ($\hat\beta$ a $" + _n3s(_ce3.get("d_zero_sigma"), 2) + r"\sigma$ de zero)", r"não ($\sigma/\bTGL\approx" + _n3s((_g3s(_ce3, "source_INPUT", "sigma") / _b3s) if (isinstance(_g3s(_ce3, "source_INPUT", "sigma"), (int, float)) and _b3s) else None, 2) + r"$)")
    _la3 = _g3s(_fv3, "channels", "l_A_compressed_cmb") or {}
    _R3s(r"CMB comprimido $\ell_A$ e BBN descircularizada", _st3s(_la3.get("verdict"), "NOT_FALSIFIED") + r" / " + _st3s(_g3s(_fv3, "channels", "bbn", "verdict"), "NON_DISCRIMINANT"),
         r"$\ell_A$: $\beta=" + _n3s(_la3.get("primary_beta"), 4) + r"$, $" + _n3s(_la3.get("d_vs_theory_sigma"), 2) + r"\sigma$ da teoria; BBN: $\hat\beta=" + _n3s(_g3s(core, "evidence_audit", "values", "bbn_decirc", "beta_hat"), 4) + r"\pm" + _n3s(_g3s(core, "evidence_audit", "values", "bbn_decirc", "sigma"), 4) + r"$", r"sim", r"não ($\ell_A$ a $" + _n3s(_la3.get("d_vs_theory_sigma"), 1) + r"\sigma$; BBN não discrimina)")
    _n2 = core.get("nivel2_rite") or {}
    _R3s(r"CMB espectro completo (Nível 2)", _st3s(_n2.get("verdict"), "N2_INCAPAZ", "NOT_CONVERGED", "NOT_SEALED") + r" (recusa)",
         r"S: $\beta=" + _n3s(_g3s(_n2, "values", "variantes", "S", "mediana"), 4) + r"\pm" + _n3s(_g3s(_n2, "values", "variantes", "S", "sigma"), 4) + r"$", r"sim (consistente)", r"não (incapaz)")
    _R3s(r"Ecos GW --- Fase 6 (244 BBH O1--O4; 3 leituras $\times$ 2 leis) + V4/V5; os " + _i3s(_er3.get("n")) + r" pares FORA do livro",
         _i3s(_er3.get("excluded_by_data")) + r" \texttt{EXCLUDED\_BY\_DATA} + " + _i3s(_er3.get("inconclusive")) + r" \texttt{INCONCLUSIVE}; o PAR cai, não a teoria",
         r"$z_{\rm det}=" + _n3s(_g3s(_f6, "todos_KMS", "z_det"), 2) + r"$; $z_{\rm excl}$ R1/R2 (KMS) $" + _n3s(_g3s(_f6, "todos_KMS", "z_excl_R1"), 1) + r"$/$" + _n3s(_g3s(_f6, "todos_KMS", "z_excl_R2"), 1) + r"$; DEC $" + _n3s(_g3s(_bf5, "emenda_v5", "todos_DEC", "z_excl_R1"), 1) + r"$/$" + _n3s(_g3s(_bf5, "emenda_v5", "todos_DEC", "z_excl_R2"), 1) + r"$",
         r"sim (nenhum eco detectado: a RG não prevê eco)", r"não (decisão do operador de 02/10: fora do livro)")
    _e1, _ek, _ea, _ep, _es = (core.get("gw_echo_rite") or {}), (core.get("gw_echo_kms_rite") or {}), (core.get("echo_anchored_result_v2") or {}), (core.get("echo_pe_result_v2") or {}), (core.get("echo_search_result") or {})
    _R3s(r"Ecos --- acoplado V1 / KMS V1 / ancorado V2 / PE V2 / busca de longo atraso", _st3s(_e1.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ek.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ea.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_ep.get("verdict"), "INCONCLUSIVE_SYSTEMATICS") + r"; " + _st3s(_es.get("verdict"), "NOT_FALSIFIED_UNDERPOWERED"),
         r"$a/\sqrt{\bTGL}=" + _n3s(_g3s(_e1, "stack", "a_over_sqrt_beta"), 2) + r"\pm" + _n3s(_g3s(_e1, "stack", "sigma"), 2) + r"$ (poder $" + _n3s(_g3s(_e1, "stack", "power_sigma"), 1) + r"\sigma$); KMS $" + _n3s(_g3s(_ek, "stack", "a_over_sqrt_beta"), 2) + r"\pm" + _n3s(_g3s(_ek, "stack", "sigma"), 2) + r"$ ($" + _n3s(_g3s(_ek, "stack", "power_sigma"), 1) + r"\sigma$); busca: $N_{\rm on}=" + _i3s(_g3s(_es, "summary", "N_on")) + r"$, $B=" + _n3s(_g3s(_es, "summary", "B_exp"), 1) + r"$",
