         r"conjunto D $n=" + _i3s(_rb3.get("conjunto_D_n")) + r"$ (cego); poder exato A31 $" + _n3s(_g3s(_rb3, "pins", "poder_exato_A31", "read"), 1) + r"\sigma$, B10 $" + _n3s(_g3s(_rb3, "pins", "poder_exato_B10", "read"), 1) + r"\sigma$, C $" + _n3s(_g3s(_rb3, "pins", "poder_exato_C", "read"), 1) + r"\sigma$; nada aberto: " + _tx3s(_rb3.get("nothing_opened")),
         r"n/a (aguardando)", r"aguardando (v387)")
