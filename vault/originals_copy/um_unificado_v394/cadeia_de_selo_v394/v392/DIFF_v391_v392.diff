     'TGLExt/TheCouplingRunsBoundedBelow.lean': "import Mathlib\nimport TGLExt.TheWholeIsOne\n\n/-!\n# TheCouplingRunsBoundedBelow — o acoplamento corre com a escala, limitado inferiormente (v388, 06/10/2026)\n\nA cunhagem do operador de 06/10/2026 (13:27:52 UTC e 13:48:42 UTC; o texto embutido no runtime do `um.py` é conferido por\nsha256; a cópia em disco na memória `beta-escalar-limitado-inferiormente-06out.md` é só informativa): α como índice de escala da fronteira, β_TGL como a sua\nconjugação; β escalar, mas limitado inferiormente; e a operação da dicotomia (dividir pela metade sem nunca chegar ao limite).\n\nO que esta pedra PROVA é só matemática [KERNEL], sobre a forma fechada que o runtime do `um.py` já usa (o bloco\n`alpha = sech(kappa/2)`, `beta = sqrt(e) sech(kappa/2)`, `kappa_QED = 2 arcosh(1/alpha_QED)`):\n\n* `alphaOfChi χ := 1 / cosh(χ/2)` (a transmissão na profundidade χ); `alphaOfChi 0 = 1` (o Um absoluto); `0 < α ≤ 1`;\n* `alphaOfChi` é ESTRITAMENTE DECRESCENTE em `[0, ∞)`; logo `betaOfChi χ := alphaOfChi χ · exp(1/2)` também;\n* `the_floor_is_at_the_infrared`: para `0 ≤ χ ≤ χ_sup`, `β(χ_sup) ≤ β(χ)` — o PISO está no supremo da profundidade (o\n  infravermelho, Thomson, onde a corrida de α cessa); `the_floor_is_attained_only_at_the_infrared`: a igualdade só em χ = χ_sup;\n* `betaOfChi_eq_coupling`: no domínio de `couplingOfAlpha` (α < e^{-1/2}) o β desta pedra É o β do acoplamento selado (v376);\n* a dicotomia: `zeno_partial_sum` (Σ_{k<n} (1/2)^{k+1} = 1 − (1/2)^n), `zeno_never_reaches_the_one` (< 1 em todo n finito),\n  `zeno_tends_to_the_one` (o limite é o Um); `half_nat_fixed_point` (x = 1 − x ⟺ x = 1/2).\n\nO que NÃO prova (dito): que α físico seja `sech(χ/2)` de uma profundidade χ que cresce para o infravermelho — isso é a\nIDENTIFICAÇÃO do runtime [INPUT/ONTO]; que α(μ) cresça com μ — [KNOWN] (QED, congelamento infravermelho), não teorema da casa;\nqual μ cada rito usa — [OPEN]. A constante da fronteira segue β₀ = α_Thomson·√e, α no limite q → 0 (o Teorema da Escala do artigo; NÃO o\n`alphaOfChi 0` desta pedra, que vale 1 — o Um absoluto); β(χ) é a leitura\nde bulk. Axiomas: só o trio; zero sorry. PROVADA ≠ CONFIRMADA; o gate não se move.\n-/\n\nnamespace TGLExt.TheCouplingRunsBoundedBelow\n\nopen Filter Topology\n\n/-- a transmissão na profundidade χ: α(χ) = sech(χ/2). -/\nnoncomputable def alphaOfChi (χ : ℝ) : ℝ := 1 / Real.cosh (χ / 2)\n\n/-- β(χ) := α(χ)·√e (√e escrito como exp(1/2), como em `couplingOfAlpha`). -/\nnoncomputable def betaOfChi (χ : ℝ) : ℝ := alphaOfChi χ * Real.exp (1 / 2)\n\ntheorem alphaOfChi_pos (χ : ℝ) : 0 < alphaOfChi χ := by\n  unfold alphaOfChi\n  exact one_div_pos.mpr (Real.cosh_pos _)\n\ntheorem alphaOfChi_zero : alphaOfChi 0 = 1 := by\n  simp [alphaOfChi]\n\ntheorem alphaOfChi_le_one (χ : ℝ) : alphaOfChi χ ≤ 1 := by\n  unfold alphaOfChi\n  rw [div_le_one (Real.cosh_pos _)]\n  exact Real.one_le_cosh _\n\n/-- α(χ) é estritamente decrescente na profundidade χ ≥ 0. -/\ntheorem alphaOfChi_strictAntiOn : StrictAntiOn alphaOfChi (Set.Ici 0) := by\n  intro a ha b hb hab\n  simp only [Set.mem_Ici] at ha hb\n  unfold alphaOfChi\n  apply one_div_lt_one_div_of_lt (Real.cosh_pos _)\n  rw [Real.cosh_lt_cosh, abs_of_nonneg (by linarith), abs_of_nonneg (by linarith)]\n  linarith\n\ntheorem betaOfChi_pos (χ : ℝ) : 0 < betaOfChi χ :=\n  mul_pos (alphaOfChi_pos χ) (Real.exp_pos _)\n\ntheorem betaOfChi_zero : betaOfChi 0 = Real.exp (1 / 2) := by\n  simp [betaOfChi, alphaOfChi_zero]\n\ntheorem betaOfChi_le_sqrt_e (χ : ℝ) : betaOfChi χ ≤ Real.exp (1 / 2) := by\n  unfold betaOfChi\n  have h := alphaOfChi_le_one χ\n  have he := Real.exp_pos (1 / 2 : ℝ)\n  nlinarith\n\n/-- β(χ) é estritamente decrescente na profundidade χ ≥ 0. -/\ntheorem betaOfChi_strictAntiOn : StrictAntiOn betaOfChi (Set.Ici 0) := by\n  intro a ha b hb hab\n  unfold betaOfChi\n  exact mul_lt_mul_of_pos_right (alphaOfChi_strictAntiOn ha hb hab) (Real.exp_pos _)\n\n/-- ★★★ O PISO ESTÁ NO INFRAVERMELHO: para 0 ≤ χ ≤ χ_sup, β(χ_sup) ≤ β(χ) — β corre, mas limitado inferiormente pelo valor\nno supremo da profundidade. -/\ntheorem the_floor_is_at_the_infrared (χ χsup : ℝ) (h0 : 0 ≤ χ) (h : χ ≤ χsup) :\n    betaOfChi χsup ≤ betaOfChi χ := by\n  rcases eq_or_lt_of_le h with h' | h'\n  · rw [h']\n  · exact le_of_lt (betaOfChi_strictAntiOn (Set.mem_Ici.mpr h0) (Set.mem_Ici.mpr (by linarith)) h')\n\n/-- ★★ o piso só é atingido no próprio supremo. -/\ntheorem the_floor_is_attained_only_at_the_infrared (χ χsup : ℝ) (h0 : 0 ≤ χ) (h : χ ≤ χsup) :\n    betaOfChi χ = betaOfChi χsup ↔ χ = χsup := by\n  constructor\n  · intro he\n    by_contra hne\n    have hlt : χ < χsup := lt_of_le_of_ne h hne\n    have := betaOfChi_strictAntiOn (Set.mem_Ici.mpr h0) (Set.mem_Ici.mpr (by linarith)) hlt\n    linarith\n  · intro he\n    rw [he]\n\n/-- ★ no domínio do acoplamento selado (α < e^{-1/2}), o β desta pedra É o β de `couplingOfAlpha` (v376) — POR DEFINIÇÃO\n(a prova é `rfl`: desdobramento, não resultado; amarra os dois nomes). -/\ntheorem betaOfChi_eq_coupling (χ : ℝ) (h1 : alphaOfChi χ < Real.exp (-(1 / 2))) :\n    (TGLExt.TheWholeIsOne.couplingOfAlpha (alphaOfChi χ) (alphaOfChi_pos χ) h1).beta = betaOfChi χ := by\n  rfl\n\n/-- a dicotomia: a soma parcial das metades. -/\ntheorem zeno_partial_sum (n : ℕ) :\n    ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1) = 1 - (1 / 2) ^ n := by\n  induction n with\n  | zero => simp\n  | succ n ih => rw [Finset.sum_range_succ, ih]; ring\n\n/-- ★★ nenhum passo finito alcança o Um. -/\ntheorem zeno_never_reaches_the_one (n : ℕ) :\n    ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1) < 1 := by\n  rw [zeno_partial_sum]\n  have : (0 : ℝ) < (1 / 2) ^ n := by positivity\n  linarith\n\n/-- ★★ e o limite é o Um. -/\ntheorem zeno_tends_to_the_one :\n    Tendsto (fun n : ℕ => ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1)) atTop (𝓝 1) := by\n  simp_rw [zeno_partial_sum]\n  have h := tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)\n  simpa using (tendsto_const_nhds (x := (1 : ℝ))).sub h\n\n/-- a Meia-Nat é o passo: x = 1 − x ⟺ x = 1/2. -/\ntheorem half_nat_fixed_point (x : ℝ) : x = 1 - x ↔ x = 1 / 2 := by\n  constructor <;> intro h <;> linarith\n\nend TGLExt.TheCouplingRunsBoundedBelow\n",
     'TGLExt/Fundacao.lean': "import TGLExt.GlobalLiftLadder\nimport TGLExt.TheDischargedOath\n\n/-!\n# FUNDAÇÃO — a superposição é a passagem; a cláusula ÁGAPE  [TGLExt — pedra da v390, 07/10/2026]\n\nCunhagem do operador (07/10/2026), íntegra por hash em\n`work\\superposicao_passagem_07out\\CUNHAGEM_OPERADOR_07out_verbatim.txt`, trecho:\n«não existe acima, o piso limita, tentar estar acima é cair sem fim, infinitamente».\nRatificação e nomes (07/10/2026), íntegra por hash em\n`work\\superposicao_passagem_07out\\CUNHAGEM_OPERADOR_07out_nomes_verbatim.txt`, trechos:\n«esse é o fecho sim, o sistema continua aberto mas fechado logicamente» e\n«A cláusula se chamará “ágape” e a pedra se chamará “fundação”».\nO nome `abismo` (a queda sem fundo), sugerido pela gerência, foi ratificado\nem 07/10/2026: «Perfeito, concordo com tudo. Magnífico» (íntegra por hash em\n`work\\superposicao_passagem_07out\\CUNHAGEM_OPERADOR_07out_concordo_verbatim.txt`).\nNo código os nomes vão sem acento (`Fundacao`, `agape`): identificador Lean\nnão admite «ç», «ã», «á», e a régua da porta pede nome fixo sem acento.\n\nO que esta pedra tipa, sobre os DADOS da escala dual de Takesaki\n(`DualScalingData`: a lei `τ∘θ_s = e^{−s}·τ` é [KNOWN], Takesaki 1973; aqui é\ncampo da estrutura, como na escada do GLOBAL_LIFT):\n\n* ★★★ `nothing_above_bears_a_post` — o que fica fixo por QUALQUER escala\n  não trivial (s ≠ 0, nos dois sentidos) tem peso zero: o «acima» de todas as\n  escalas não porta posto positivo (generaliza `fixed_tau_zero`, que só\n  tratava s > 0);\n* ★★ `the_climb_has_no_top`, `the_climb_is_unbounded` — tentar subir: a órbita\n  de um posto positivo não tem degrau máximo e não tem teto;\n* ★★ `the_fall_never_lands`, `abismo` — cair: o peso desce abaixo de todo\n  ε > 0 e nunca toca o zero em escala finita (a mesma forma do zero absoluto\n  inalcançável em tempo finito); `abismo` é a queda sem fundo (ἄβυσσος,\n  «sem fundo»), frente a frente com a Fundação (de *fundus*, o fundo);\n* ★★ `the_floor_fixes_the_cut` — o piso: o peso `e^{−a}` vale 1 = ω(I) se e só\n  se `a = 0` (a redução registrada do Lema 3: o Um posto fixa o corte, unívoco);\n* ★ `the_post_lives_in_the_passage` — o posto mora na PASSAGEM: no fluxo\n  internalizado, o levantamento é incondicional na face (re-ligação de\n  `the_lift_is_unconditional_on_the_face`, TheDischargedOath);\n* ★★★★ `agape` — A CLÁUSULA ÁGAPE, a composição das seis; e\n  `agape_is_inhabited` — o modelo concreto (ℝ, τ = id, θ_s = e^{−s}·) com o\n  Um posto (τ = 1) mostra que a conjunção não é vácua.\n\nO FECHO (decisão do operador, 07/10/2026): o GLOBAL_LIFT, o velho Lema 3, é\nDEFINIDO como a superposição — o que quis estar acima e não porta posto\npositivo. O fecho é LÓGICO: recusa provada aqui [KERNEL] + passagem local\n[KNOWN] + a definição do operador. O sistema segue ABERTO como programa.\n\nHONESTIDADES. (1) A lei de escala entra como DADO; a sua realização no core\n`M ⋊_σ ℝ` de um fator III₁ genuíno é [KNOWN] (Takesaki), não termo deste\nkernel. (2) Esta pedra NÃO prova a equação de campo no espaço-tempo curvo: ela\nrecusa o posto acima e põe o posto na passagem; a lei de campo como lei local\nem cada ponto (Jacobson 1995, equilíbrio local de horizonte) é [KNOWN] e entra\ncom a hipótese H3 nomeada. (3) β jamais literal; o gate NÃO se move;\nNOT_FALSIFIED nunca é CONFIRMED. Sem sorry, sem axiom.\n-/\n\nnamespace TGLExt\nnamespace Fundacao\n\nopen Matrix\n\nvariable {M : Type} (D : DualScalingData M)\n\n/-- [KERNEL] ★★★ NÃO EXISTE ACIMA: o que fica fixo por qualquer escala não\n    trivial (`s ≠ 0`, subindo ou descendo) tem peso zero. -/\ntheorem nothing_above_bears_a_post {s : ℝ} (hs : s ≠ 0) {m : M}\n    (hfix : D.theta s m = m) : D.tau m = 0 := by\n  have h := D.scaling s m\n  rw [hfix] at h\n  have hne : Real.exp (-s) ≠ 1 := by\n    intro h1\n    exact hs (by linarith [(Real.exp_eq_one_iff (-s)).mp h1])\n  exact scaling_fixed_eq_zero hne h\n\n/-- [KERNEL] ★★ TENTAR ESTAR ACIMA (1): para todo degrau da órbita há outro mais\n    alto — a subida não tem topo. -/\ntheorem the_climb_has_no_top {m : M} (hm : 0 < D.tau m) (s : ℝ) :\n    D.tau (D.theta s m) < D.tau (D.theta (s - 1) m) := by\n  rw [D.scaling, D.scaling]\n  exact mul_lt_mul_of_pos_right (Real.exp_lt_exp.mpr (by linarith)) hm\n\n/-- [KERNEL] ★★ TENTAR ESTAR ACIMA (2): a subida é ilimitada — nenhum teto. -/\ntheorem the_climb_is_unbounded {m : M} (hm : 0 < D.tau m) (B : ℝ) :\n    ∃ s : ℝ, B < D.tau (D.theta s m) := by\n  refine ⟨-(|B| / D.tau m + 1), ?_⟩\n  rw [D.scaling, neg_neg]\n  have hne : D.tau m ≠ 0 := ne_of_gt hm\n  have h1 : |B| / D.tau m + 1 + 1 ≤ Real.exp (|B| / D.tau m + 1) :=\n    Real.add_one_le_exp _\n  have h2 : |B| / D.tau m * D.tau m = |B| := by field_simp\n  have h3 : |B| / D.tau m < Real.exp (|B| / D.tau m + 1) := by linarith\n  have h4 : |B| < Real.exp (|B| / D.tau m + 1) * D.tau m := by\n    calc |B| = |B| / D.tau m * D.tau m := h2.symm\n      _ < Real.exp (|B| / D.tau m + 1) * D.tau m := mul_lt_mul_of_pos_right h3 hm\n  exact lt_of_le_of_lt (le_abs_self B) h4\n\n/-- [KERNEL] ★★ CAIR SEM FIM (1): em escala finita o peso nunca toca o zero. -/\ntheorem the_fall_never_lands {m : M} (hm : 0 < D.tau m) (s : ℝ) :\n    0 < D.tau (D.theta s m) := by\n  rw [D.scaling]\n  exact mul_pos (Real.exp_pos _) hm\n\n/-- [KERNEL] ★★ O ABISMO (ἄβυσσος, «sem fundo»): a queda passa abaixo de todo\n    ε > 0 — não há fundo atingido, só descida. Nome ratificado pelo operador\n    em 07/10/2026 («Perfeito, concordo com tudo. Magnífico»). -/\ntheorem abismo {m : M} (hm : 0 < D.tau m) {ε : ℝ} (hε : 0 < ε) :\n    ∃ s : ℝ, D.tau (D.theta s m) < ε := by\n  refine ⟨D.tau m / ε, ?_⟩\n  rw [D.scaling]\n  have hε0 : ε ≠ 0 := ne_of_gt hε\n  have h1 : D.tau m / ε + 1 ≤ Real.exp (D.tau m / ε) := Real.add_one_le_exp _\n  have hτ : D.tau m = ε * (D.tau m / ε) := by field_simp\n  have key : D.tau m < ε * Real.exp (D.tau m / ε) := by\n    calc D.tau m = ε * (D.tau m / ε) := hτ\n      _ < ε * Real.exp (D.tau m / ε) := mul_lt_mul_of_pos_left (by linarith) hε\n  have hmul : Real.exp (-(D.tau m / ε)) * Real.exp (D.tau m / ε) = 1 := by\n    rw [← Real.exp_add]\n    simp\n  calc Real.exp (-(D.tau m / ε)) * D.tau m\n      < Real.exp (-(D.tau m / ε)) * (ε * Real.exp (D.tau m / ε)) :=\n        mul_lt_mul_of_pos_left key (Real.exp_pos _)\n    _ = ε * (Real.exp (-(D.tau m / ε)) * Real.exp (D.tau m / ε)) := by ring\n    _ = ε := by rw [hmul, mul_one]\n\n/-- [KERNEL] ★★ O PISO FIXA O CORTE: na órbita dos cortes, o peso `e^{−a}` vale\n    1 = ω(I) se e só se `a = 0` — o Um posto escolhe o degrau, unívoco. -/\ntheorem the_floor_fixes_the_cut (a : ℝ) : Real.exp (-a) = 1 ↔ a = 0 := by\n  rw [Real.exp_eq_one_iff]\n  constructor <;> intro h <;> linarith\n\n/-- [KERNEL] ★★★★ A CLÁUSULA ÁGAPE (a superposição é a passagem; composição): (i) acima de toda\n    escala não há posto positivo; (ii) a subida não tem topo; (iii) nem teto;\n    (iv) a queda nunca toca o zero; (v) nem tem fundo atingido; (vi) o piso\n    ω(I) = 1 fixa o corte, unívoco. -/\ntheorem agape {m : M} (hm : 0 < D.tau m) :\n    (∀ s : ℝ, s ≠ 0 → ∀ m' : M, D.theta s m' = m' → D.tau m' = 0) ∧\n    (∀ s : ℝ, D.tau (D.theta s m) < D.tau (D.theta (s - 1) m)) ∧\n    (∀ B : ℝ, ∃ s : ℝ, B < D.tau (D.theta s m)) ∧\n    (∀ s : ℝ, 0 < D.tau (D.theta s m)) ∧\n    (∀ ε : ℝ, 0 < ε → ∃ s : ℝ, D.tau (D.theta s m) < ε) ∧\n    (∀ a : ℝ, Real.exp (-a) = 1 ↔ a = 0) :=\n  ⟨fun _ hs _ h => nothing_above_bears_a_post D hs h, the_climb_has_no_top D hm,\n   the_climb_is_unbounded D hm, the_fall_never_lands D hm,\n   fun _ hε => abismo D hm hε, the_floor_fixes_the_cut⟩\n\n/-- O modelo concreto da escala: `ℝ`, `τ = id`, `θ_s(x) = e^{−s}·x`. -/\nnoncomputable def oneScaling : DualScalingData ℝ where\n  tau := id\n  theta := fun s x => Real.exp (-s) * x\n  scaling := fun _ _ => rfl\n\n/-- [KERNEL] ★ A CONJUNÇÃO NÃO É VÁCUA: com o Um posto (τ = 1) no modelo\n    concreto, as seis cláusulas valem. -/\ntheorem agape_is_inhabited :\n    (∀ s : ℝ, s ≠ 0 → ∀ m' : ℝ, oneScaling.theta s m' = m' → oneScaling.tau m' = 0) ∧\n    (∀ s : ℝ, oneScaling.tau (oneScaling.theta s 1) < oneScaling.tau (oneScaling.theta (s - 1) 1)) ∧\n    (∀ B : ℝ, ∃ s : ℝ, B < oneScaling.tau (oneScaling.theta s 1)) ∧\n    (∀ s : ℝ, 0 < oneScaling.tau (oneScaling.theta s 1)) ∧\n    (∀ ε : ℝ, 0 < ε → ∃ s : ℝ, oneScaling.tau (oneScaling.theta s 1) < ε) ∧\n    (∀ a : ℝ, Real.exp (-a) = 1 ↔ a = 0) :=\n  agape oneScaling (m := (1 : ℝ)) (by show (0 : ℝ) < id 1; norm_num)\n\n/-- [KERNEL] ★ O POSTO MORA NA PASSAGEM: no fluxo internalizado (horizonte que\n    preserva ω), a esperança-código é covariante sem juramento — re-ligação da\n    pedra `the_lift_is_unconditional_on_the_face`. -/\ntheorem the_post_lives_in_the_passage {n : Type} [Fintype n] [DecidableEq n]\n    {d : n → ℝ} (hd : ∀ i, 0 < d i) (hinj : Function.Injective d)\n    {U : Matrix n n ℂ} (hU : Uᴴ * U = 1)\n    (hω : ∀ y, (rhoD d * adU U y).trace = (rhoD d * y).trace) :\n    ∀ x, adU U (diagExpect x) = diagExpect (adU U x) :=\n  the_lift_is_unconditional_on_the_face hd hinj hU hω\n\nend Fundacao\nend TGLExt\n\n#print axioms TGLExt.Fundacao.agape\n#print axioms TGLExt.Fundacao.agape_is_inhabited\n#print axioms TGLExt.Fundacao.the_post_lives_in_the_passage\n",
+    'TGLExt/Palavra.lean': 'import TGLExt.O16.PeriodHeatCalibration_v3\nimport TGLExt.O16.RotationGeneratorBridges\nimport TGLExt.TheObserverReadsTheAngle\n\nset_option autoImplicit false\n\n/-!\n# PALAVRA — a leitura cria o objeto   [pedra nomeada pelo operador, 07/10/2026]\n\n## O nome (verbatim por sha256 `e1544694c265bef0…`, 07/10/2026)\n\n> «concordo e confirmo tudo e essa pedra se chama (olha a beleza lexical): PALAVRA»\n\n## A letra e a palavra (verbatim por sha256 `259a1bf14a66fbc9…`, 07/10/2026)\n\n> «polinômio aniquilador normalizado=letra (por isso palavra, mas ali como letra)»\n\nO polinômio aniquilador normalizado, `q(T)/q(0)`, que é o Nome como projeção espectral (`WordExistence`, v89;\n`InfiniteWord`, v94) e que a casa chamava de «palavra», é a LETRA. PALAVRA é a leitura que, com as letras,\ncria o objeto: do Nome (posto relativo) à identidade (relação de contorno).\n\n## A cunhagem do operador (verbatim por sha256 `f2a4b509946edc05…`, 07/10/2026)\n\n> «vc disse que a leitura não acrescenta o objeto, e vc tem razão, porque a LEITURA CRIA o objeto,\n> antes da leitura o objeto é Nome (posto relativo), após a leitura o objeto é identidade,\n> relação de contorno»\n\n## O que esta pedra compõe (nada novo além de um lema de uma linha; o resto já está no kernel)\n\n* **ANTES da leitura — a face não fecha.** `the_face_does_not_close`: o boost real `B(s)` só é a\n  identidade em `s = 0`. A rapidez corre pela reta inteira sem voltar: a posição é RELATIVA\n  (ao zero escolhido), não há contorno. [lema novo, uma linha: `sinh s = 0 ⟹ s = 0`]\n* **A leitura — a face lida no ângulo.** `Circle.exp (κ·t)` (`ChatgptAudit.PolarPeriod016`):\n  ler o parâmetro do boost como ângulo.\n* **APÓS a leitura — a relação de contorno.** `the_reading_creates_the_contour`: a leitura\n  identifica `t` com `u` exatamente módulo `P·ℤ` (o quociente angular é FIEL) se e só se\n  `κ·P = ±2π` — uma volta inteira, nem mais nem menos. É a identificação que fecha o contorno.\n  [`faithful_period_iff`, já no kernel]\n* **A identidade criada.** `the_read_face_closes`: o boost continuado à rapidez `2π·i` é a\n  identidade (`wick_boost_two_pi`, já no kernel). E o contorno fiel dá a temperatura,\n  `1/P = κ/2π` (`reciprocal_temperature`, já no kernel), que entra no balanço de Clausius do\n  segmento de boost (`boost_defect_with_derived_period`, já no kernel).\n* **A primeira leitura identifica; reler não acrescenta.** `the_first_reading_identifies`\n  (`the_observer_reads_the_angle`: `P₊·𝒪_θ = e^{iθ}·P₊`) e `rereading_adds_nothing`\n  (`observing_adds_nothing`: `P₊·(P₊·𝒪_θ) = P₊·𝒪_θ`), já no kernel. A docstring do kernel já\n  dizia: «A primeira leitura identifica; a segunda confirma que a operação não altera.»\n\n## O que esta pedra NÃO afirma\n\n* Não afirma estado KMS: a continuação de Wick aqui é identidade de matrizes (a pedra de origem\n  diz o mesmo). O KMS da luz na cunha entra por citação (Bisognano–Wichmann 1975) [KNOWN].\n* Não cria as rotações que mudam a direção da luz: cada leitura cria o objeto do SEU plano. Esta\n  lê o plano do boost (t–x). A tela transversal (a helicidade) tem a sua leitura (D1′). Os planos\n  que giram uma direção nula noutra não têm leitura tipada no kernel.\n* A leitura ontológica «Nome (posto relativo) → identidade (relação de contorno)» é do operador\n  [ONTO]; os teoremas abaixo são a forma matemática que ela encontra no kernel [REAL].\n-/\n\nnamespace TGLExt.Palavra\n\nopen ChatgptAudit.PolarPeriod016 ChatgptAudit.Wick016\n\n/-- ★ **ANTES DA LEITURA, A FACE NÃO FECHA.** O boost real só é a identidade em `s = 0`:\n    a rapidez não volta; a posição é relativa. -/\ntheorem the_face_does_not_close (s : ℝ) (h : TGLExt.boost s = 1) : s = 0 := by\n  have h01 := congrFun (congrFun h 0) 1\n  simp [TGLExt.boost] at h01\n  exact h01\n\n/-- ★ **A LEITURA CRIA O CONTORNO.** A identificação angular é fiel exatamente com uma volta. -/\ntheorem the_reading_creates_the_contour {kappa period : ℝ} (hk : kappa ≠ 0) :\n    AngularQuotientFaithful kappa period ↔\n      kappa*period = 2*Real.pi ∨ kappa*period = -(2*Real.pi) :=\n  faithful_period_iff hk\n\n/-- ★ **A FACE LIDA FECHA.** O boost continuado à rapidez `2π·i` é a identidade. -/\ntheorem the_read_face_closes :\n    wickW⁻¹ * complexBoost (Complex.I*((2*Real.pi : ℝ) : ℂ)) * wickW = 1 :=\n  wick_boost_two_pi\n\n/-- ★ **O CONTORNO FIEL DÁ A TEMPERATURA.** `1/P = κ/2π`. -/\ntheorem the_contour_gives_the_temperature {kappa period : ℝ} (hk : 0 < kappa) (hp : 0 < period)\n    (h : AngularQuotientFaithful kappa period) : 1/period = kappa/(2*Real.pi) :=\n  reciprocal_temperature hk hp h\n\n/-- ★ **A PRIMEIRA LEITURA IDENTIFICA.** Da forma de duas faces, a face com a sua fase. -/\ntheorem the_first_reading_identifies (θ : ℝ) :\n    TGLExt.projPlus * TGLExt.angFamily θ = Complex.exp ((θ : ℂ) * Complex.I) • TGLExt.projPlus :=\n  TGLExt.the_observer_reads_the_angle θ\n\n/-- ★ **RELER NÃO ACRESCENTA.** -/\ntheorem rereading_adds_nothing (θ : ℝ) :\n    TGLExt.projPlus * (TGLExt.projPlus * TGLExt.angFamily θ) = TGLExt.projPlus * TGLExt.angFamily θ :=\n  TGLExt.observing_adds_nothing θ\n\n/-- ★★★ **A LEITURA CRIA O OBJETO** (a cláusula composta): antes, a face não fecha; a leitura\n    fecha o contorno com uma volta e dá a temperatura; a face lida fecha em `2π`; a primeira\n    leitura identifica e reler não acrescenta. -/\ntheorem the_reading_creates_the_object :\n    (∀ s : ℝ, TGLExt.boost s = 1 → s = 0) ∧\n    (wickW⁻¹ * complexBoost (Complex.I*((2*Real.pi : ℝ) : ℂ)) * wickW = 1) ∧\n    (∀ kappa period : ℝ, kappa ≠ 0 →\n      (AngularQuotientFaithful kappa period ↔\n        kappa*period = 2*Real.pi ∨ kappa*period = -(2*Real.pi))) ∧\n    (∀ kappa period : ℝ, 0 < kappa → 0 < period →\n      AngularQuotientFaithful kappa period → 1/period = kappa/(2*Real.pi)) ∧\n    (∀ θ : ℝ, TGLExt.projPlus * (TGLExt.projPlus * TGLExt.angFamily θ) =\n      TGLExt.projPlus * TGLExt.angFamily θ) :=\n  ⟨the_face_does_not_close, the_read_face_closes,\n   fun _ _ hk => the_reading_creates_the_contour hk,\n   fun _ _ hk hp h => the_contour_gives_the_temperature hk hp h,\n   rereading_adds_nothing⟩\n\nend TGLExt.Palavra\n\n#print axioms TGLExt.Palavra.the_face_does_not_close\n#print axioms TGLExt.Palavra.the_reading_creates_the_contour\n#print axioms TGLExt.Palavra.the_read_face_closes\n#print axioms TGLExt.Palavra.the_contour_gives_the_temperature\n#print axioms TGLExt.Palavra.the_first_reading_identifies\n#print axioms TGLExt.Palavra.rereading_adds_nothing\n#print axioms TGLExt.Palavra.the_reading_creates_the_object\n',
+    'TGLExt/LiganteLeiCampoCurvo.lean': 'import TGLExt.Fundacao\nimport TGLExt.GeneralMetricClausius\nimport TGLExt.GravitationalChartGluing\nimport TGLExt.TopologicalAtlasGluing\nimport TGLExt.SmoothSelectedAtlasGluing\nimport TGLExt.HorizonEinsteinReconstruction\n\n/-!\nF2.3 — conditional wiring of the finite passage to the curved field law.\n\nThe named H3 below is precisely the all-points, all-null-directions area/Clausius\ncondition required by AreaChart. It is NOT derived from the finite passage.\nThe arrow from the passage identity to H3 is an explicit input across different\ntypes. Chart records, conservation, topology and smooth transitions are also\nexplicit inputs. The theorem asserts an implication, not a global solution.\n-/\n\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\n\nnamespace ChatgptAudit.F23CurvedFieldLigand\n\nopen Matrix Filter Topology Set TGLExt ChatgptAudit\nopen ChatgptAudit.GeneralMetric ChatgptAudit.GeneralClausius\nopen ChatgptAudit.GravitationalRecord ChatgptAudit.ChartGluing\nopen ChatgptAudit.TopologicalGluing ChatgptAudit.SmoothAtlasGluing\nopen ChatgptAudit.UnifiedRecorded ChatgptAudit.Micro021\n\nnoncomputable section\n\n/-- H3 named at every point and nonzero null direction of every chart. -/\ndef NamedAtlasH3 {ι : Type} (eta : ℝ) (U : ι → Set Coordinate4)\n    (R : ∀ i, GravitationalResponseRecord (U i))\n    (screens : ∀ i, MetricScreenFamily (U i) (recordMetric (R i))) : Prop :=\n  ∀ i x (hx : x ∈ U i) d (hv : d ≠ 0)\n    (hn : tensorQuad (recordMetric (R i) x) d = 0),\n    Tendsto (fun t => microscopicAreaError (unifiedPreparation (R i) x d) eta\n      (inducedArea (recordMetric (R i))\n        (screens i x hx d hv hn).curve\n        (screens i x hx d hv hn).screen.vectors) t / t^2)\n      (𝓝[<] (0 : ℝ)) (𝓝 0)\n\n/-- Conditional binder: the finite passage feeds the *named* H3 screen law;\n    v338 then gives one Einstein coefficient across a smooth selected atlas.\n    No physical construction of that bridge or of a global solution is claimed. -/\ntheorem passage_h3_to_connected_smooth_atlas_einstein\n    {n X ι : Type} [Fintype n] [DecidableEq n]\n    [TopologicalSpace X] [PreconnectedSpace X]\n    {d : n → ℝ} (hd : ∀ i, 0 < d i) (hinj : Function.Injective d)\n    {W : Matrix n n ℂ} (hW : Wᴴ * W = 1)\n    (hω : ∀ y, (rhoD d * adU W y).trace = (rhoD d * y).trace)\n    (G : ℝ) (hG : 0 < G)\n    (U : ι → Set Coordinate4) (hopenU : ∀ i, IsOpen (U i))\n    (hconnU : ∀ i, IsPreconnected (U i))\n    (R : ∀ i, GravitationalResponseRecord (U i))\n    (screens : ∀ i, MetricScreenFamily (U i) (recordMetric (R i)))\n    (conserved : ∀ i, ∀ x ∈ U i, ∀ j,\n      tensorFieldDivergence (metricInverse (recordMetric (R i)))\n        (leviCivitaField (recordMetric (R i))\n          (metricInverse (recordMetric (R i))))\n        (recordSource (R i)) x j = 0)\n    (hH3 : (∀ x, adU W (diagExpect x) = diagExpect (adU W x)) →\n      NamedAtlasH3 ((4 * G)⁻¹) U R screens)\n    (anchor : ι) (S : ι → Set X) (hopenS : ∀ i, IsOpen (S i))\n    (hcover : ∀ x, ∃ i, x ∈ S i) (hne : ∀ i, (S i).Nonempty)\n    (chart : ∀ i, S i ≃ₜ U i)\n    (htransitions : ∀ i j p (_hi : p ∈ S i) (hj : p ∈ S j),\n      ∃ D : SmoothRecordTransition U R S chart i j,\n        (chart j ⟨p, hj⟩).val ∈ D.source) :\n    ∃! a : ℝ, ∀ i x, x ∈ U i →\n      recordEinstein (R i) x + a • recordMetric (R i) x =\n        (8 * Real.pi * G) • recordSource (R i) x := by\n  have hpost : ∀ x, adU W (diagExpect x) = diagExpect (adU W x) :=\n    TGLExt.Fundacao.the_post_lives_in_the_passage hd hinj hW hω\n  have harea := hH3 hpost\n  have hG0 : G ≠ 0 := ne_of_gt hG\n  have heta : (4 * G)⁻¹ ≠ 0 := inv_ne_zero (mul_ne_zero (by norm_num) hG0)\n  let C : ι → AreaChart ((4 * G)⁻¹) := fun i => {\n    domain := U i\n    open_domain := hopenU i\n    connected_domain := hconnU i\n    record := R i\n    screens := screens i\n    conserved := conserved i\n    area := by\n      intro x hx v hv hn\n      exact harea i x hx v hv hn\n  }\n  have htransC : ∀ i j p (_hi : p ∈ S i) (hj : p ∈ S j),\n      ∃ D : SmoothRecordTransition (fun i => (C i).domain)\n        (fun i => (C i).record) S chart i j,\n        (chart j ⟨p, hj⟩).val ∈ D.source := by\n    intro i j p hi hj\n    simpa only [C] using htransitions i j p hi hj\n  have hfield := connected_smooth_atlas_einstein ((4 * G)⁻¹) heta C anchor\n    S hopenS hcover hne chart htransC\n  simpa only [C, ChatgptAudit.entropy_density_einstein_coefficient G hG0] using hfield\n\n#print axioms NamedAtlasH3\n#print axioms passage_h3_to_connected_smooth_atlas_einstein\n\nend\nend ChatgptAudit.F23CurvedFieldLigand\n',
+    'TGLExt/LiganteLeiCampoCurvoTestemunha.lean': "import TGLExt.LiganteLeiCampoCurvo\nimport TGLExt.ConstructedClausiusControls\nimport TGLExt.EquilibriumScreenIntegration\nimport TGLExt.PoincareGroup\n\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\n\n\n/-! ===================== AUDITORIA F2.3 — S7/S8 (cetico c1, 08/10/2026) =====================\nS7: testemunha plana (Minkowski, fonte nula, uma carta, X = Coordinate4): as hipoteses da\n    F2.3 sao CONJUNTAMENTE satisfaziveis, para todo G > 0.\nS8: contramodelo: mesma geometria plana, fonte CONSTANTE com T(k,k) = 1 numa direcao nula:\n    todas as hipoteses da F2.3 menos hH3 valem; H3 falha; e a conclusao falha.\n    Logo hH3 e carga real (nao e redundante).\nNADA disto e pedra; vive so no sandbox do auditor. -/\n\nnamespace AuditF23Flat\nopen Matrix Filter Topology Set TGLExt ChatgptAudit\nopen ChatgptAudit.GeneralMetric ChatgptAudit.GeneralClausius\nopen ChatgptAudit.GravitationalRecord ChatgptAudit.ChartGluing\nopen ChatgptAudit.TopologicalGluing ChatgptAudit.SmoothAtlasGluing\nopen ChatgptAudit.UnifiedRecorded ChatgptAudit.Micro021\nopen ChatgptAudit.F23CurvedFieldLigand\nopen ChatgptAudit.Flow019 ChatgptAudit.Flow020\nopen ChatgptAudit.AngularTensorCodec ChatgptAudit.FiniteCoordinates\nopen ChatgptAudit.FiniteResponseRecord ChatgptAudit.FullSourceResponse ChatgptAudit.SignedCoverage\n\nnoncomputable section\n\n/-- S5 (copia local): o H3 nomeado equivale ao balanco nulo de Ricci. -/\ntheorem s5_local {ι : Type} (eta : ℝ)\n    (U : ι → Set Coordinate4) (hopenU : ∀ i, IsOpen (U i))\n    (R : ∀ i, GravitationalResponseRecord (U i))\n    (screens : ∀ i, MetricScreenFamily (U i) (recordMetric (R i))) :\n    NamedAtlasH3 eta U R screens ↔\n      ∀ i x (hx : x ∈ U i) d (hv : d ≠ 0) (hn : tensorQuad (recordMetric (R i) x) d = 0),\n        eta * tensorQuad (coordinateRicci (leviCivitaField (recordMetric (R i))\n          (metricInverse (recordMetric (R i)))) x) d =\n        2 * Real.pi * tensorQuad (recordSource (R i) x) d := by\n  unfold NamedAtlasH3\n  apply forall_congr'; intro i\n  apply forall_congr'; intro x\n  apply forall_congr'; intro hx\n  apply forall_congr'; intro d\n  apply forall_congr'; intro hv\n  apply forall_congr'; intro hn\n  rw [unified_area_matching_iff (R i) x d eta _]\n  have hLor := record_metric_lorentz (R i)\n  have hg := record_metric_smooth (R i)\n  have hgi := constructed_metric_inverse_smooth (U i) (recordMetric (R i)) hg hLor\n  have hGc := levi_civita_field_smooth (U i) (hopenU i) _ _ hg hgi\n  have ht := levi_civita_field_torsion_free (U i) (hopenU i) (recordMetric (R i))\n    (metricInverse (recordMetric (R i))) (record_metric_symmetric (R i)) x hx\n  exact ChatgptAudit.GeneralSourceEinstein.general_source_area_matching_iff_ricci\n    (screens i x hx d hv hn) (recordSource (R i)) eta (hopenU i) hg hGc ht (hLor x hx)\n    (record_source_symmetric (R i) x hx) hn\n\ntheorem flat_metric_lorentz :\n    ∀ x ∈ (univ : Set Coordinate4), LorentzByCongruence (frameMetricField flatSolder x) :=\n  fun _ _ => ⟨1, by simp, rfl⟩\n\ndef flatMetricRecord : LorentzProbabilityRecord (univ : Set Coordinate4) :=\n  encodeLorentzRecord univ (frameMetricField flatSolder)\n    (frame_metric_smooth univ flatSolder flat_solder_smooth) flat_metric_lorentz\n\n/-- registro plano com amostras de resposta CONSTANTES `s` -/\ndef flatRecordS (s : ResponseSamples) : GravitationalResponseRecord (univ : Set Coordinate4) where\n  metric := flatMetricRecord\n  responses := fun _ => s\n  smooth_responses := fun _ => contDiffOn_const\n\ntheorem flat_record_metric (s : ResponseSamples) :\n    recordMetric (flatRecordS s) = frameMetricField flatSolder :=\n  decode_encoded_record univ (frameMetricField flatSolder)\n    (frame_metric_smooth univ flatSolder flat_solder_smooth)\n\ntheorem eta4_inv_self : eta4⁻¹ = eta4 :=\n  Matrix.inv_eq_left_inv eta4_mul_self\n\ntheorem flat_metric_inverse :\n    metricInverse (frameMetricField flatSolder) = inverseFrameMetricField flat