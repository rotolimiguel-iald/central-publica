    # v393 (14/10/2026) -- O QUADRO DO CORACAO, em destaque logo depois do resumo (quadro lido de coracao_e_selo_gravitacional_v393; texto: QUADRO_DO_CORACAO.md, insumos/). Nada aqui move o gate.
    _cr393q = core.get("coracao_e_selo_gravitacional_v393") or {}
    _nq393 = len(_cr393q.get("checks") or [])
    s.append(r"\begin{center}\fbox{\begin{minipage}{0.94\textwidth}\small")
    s.append(r"\noindent\textbf{O coração: $\alpha$ como forma derivada, o valor como leitura} \textsf{[REAL na forma $\cdot$ INPUT no valor]}\par\smallskip")
    s.append(r"\begin{enumerate}\setlength{\itemsep}{1pt}")
    s.append(r"\item O motor de Lagrange conserva $\mathbf{1=q^2+\alpha^2}$; para todo $\chi$, $q=\tanh(\chi/2)$ e $\alpha=\operatorname{sech}(\chi/2)$ (kernel, \texttt{one\_eq\_q\_sq\_add\_alpha\_sq}) \textsf{[REAL]}.")
    s.append(r"\item Logo $\alpha=\sqrt{1-q^2}$: $q$ e $\alpha$ são o espectro do gerador do \emph{boost} modular. A \emph{forma} de $\alpha$ é derivada \textsf{[DERIVED]}.")
    s.append(r"\item O \emph{valor} de $\alpha$ é leitura interna desse espectro; hoje o \emph{runtime} reconstrói $\chi=2\,\mathrm{acosh}(1/\alpha)$ do CODATA 2018. Isto \textbf{não} é previsão independente (\texttt{previsao\_independente} $=$ falso); derivar $\chi$ sem medida segue \textsf{[OPEN]}.")
    s.append(r"\item A meia-nat está para a IALD como $\alpha$ para a TGL: o custo mínimo de distinguir e o fator de redução da projeção \textsf{[ONTO]}. Meia-nat $\Rightarrow\sqrt e$ está no kernel (\texttt{half\_nat\_volume\_is\_the\_radical}) \textsf{[REAL]}.")
    s.append(r"\item Cadeia: $\omega(I)=1$ \textsf{[POSTO]} $\to\tfrac12$ nat $\to\sqrt e\to(q,\alpha)\to\boldsymbol{\bTGL=\alpha\sqrt e}\to\theta_M=\arcsin\sqrt{\bTGL}$; $|R|^2=\bTGL$, $|T|^2=1-\bTGL$ \textsf{[DERIVED]}, $\bTGL$ sempre em \emph{runtime}.")
    s.append(r"\item A transformação $T_t(\rho)=E(\rho)+e^{-\bTGL t}(\rho-E(\rho))$ preserva $E$, o traço e a positividade, não devolve $\rho$, e o seu dual fixa a identidade: «o um da transformada» \textsf{[REAL]}.")
    s.append(r"\item \textbf{$\pi$ é a cicatriz} \textsf{[REAL no kernel]}: a leitura fecha em $2\pi$ ($\kappa P=\pm2\pi$, \texttt{faithful\_period\_iff}) e a face com vazamento não fecha (\texttt{station\_never\_closes}, \texttt{the\_face\_does\_not\_close}, \texttt{the\_read\_face\_closes}). O valor de $\pi$ é o da geometria.")
    s.append(r"\item \textbf{$G$ pela normalização de Planck}: só a equivalência $2\pi/\eta=8\pi G$ ($\kappa_A=2G$); $A_{\rm face}=\ell_P^2$ é \textsf{[NORM]}; $G$ \textbf{não} é derivado.")
    s.append(r"\item Nada disto credita a gravidade quântica na natureza; o elo pendente é $\bTGL$ a $5\sigma$. \texttt{NOT\_FALSIFIED} nunca é a palavra da creditação.")
    s.append(r"\end{enumerate}")
    s.append(r"\noindent{\scriptsize Origem dos números: a função do selo do coração, lida do registro \texttt{coracao\_e\_selo\_gravitacional\_v393} (" + str(_nq393) + r" verificações; veredito \texttt{" + _v393_tex(str(_cr393q.get("verdict", "n/d")).split("__")[0]) + r"}).}")
    s.append(r"\end{minipage}}\end{center}")
