+    'TGLExt/RuleQuadraticResidual.lean': 'import TGLExt.TimeGravitonFlow\nimport TGLExt.PageInformation\nimport TGLExt.Bicommutant\n\n/-!\n# The rule as a quadratic residual of the existing reading\n\nThe reading Eg, its flow, the inscription type and the Frobenius form are\nreused. No new network or dynamical hypothesis is introduced. For a target A\nfixed before evaluation, residual A X is the squared Frobenius distance from\nEg X to A, not the distance from the raw state X to A. Its invariance is proved\nfrom reading_flow; it is not assumed and is not a decreasing progress score.\n\nAn inscription is a realizable fixed target. The zero criterion and invariance\nalso hold for arbitrary targets, while an impossible target has positive\nresidual everywhere. Concrete accepted and rejected controls share the same\ntransported density and differ only in the target. The construction is M2;\nits interpretation as a rule is the explicit representation of\nRuleTruthContract. No physical confirmation or global spacetime is asserted.\n-/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nopen Matrix Complex\nnamespace TGLExt.RuleQuadraticResidual\nopen TimeGravitonMatrix TimeGravitonFlow RuleTruthContract\nnoncomputable section\n\ntheorem purityR_nonnegative {n : Type} [Fintype n] [DecidableEq n]\n    (X : Matrix n n ℂ) : 0 ≤ purityR X := by\n  exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ =>\n    Complex.normSq_nonneg (X i j)\n\ntheorem purityR_zero_iff {n : Type} [Fintype n] [DecidableEq n]\n    (X : Matrix n n ℂ) : purityR X = 0 ↔ X = 0 := by\n  have bridge : frob X X = (purityR X : ℂ) := by\n    calc\n      frob X X = purity X := Matrix.trace_mul_comm _ _\n      _ = (purityR X : ℂ) := purityR_eq X\n  constructor\n  · intro h\n    apply (frob_self_eq_zero_iff X).mp\n    rw [bridge, h]\n    simp\n  · rintro rfl\n    simp [purityR]\n\ndef residual (A X : M2) : ℝ := purityR (Eg X - A)\n\ntheorem residual_nonnegative (A X : M2) : 0 ≤ residual A X :=\n  purityR_nonnegative _\n\ntheorem residual_zero_iff (A X : M2) :\n    residual A X = 0 ↔ Admissible Eg A X := by\n  unfold residual Admissible\n  rw [purityR_zero_iff, sub_eq_zero]\n\ntheorem residual_positive_iff (A X : M2) :\n    0 < residual A X ↔ ¬ Admissible Eg A X := by\n  constructor\n  · intro hp ha\n    have hz := (residual_zero_iff A X).mpr ha\n    linarith\n  · intro ha\n    have hn := residual_nonnegative A X\n    by_contra hp\n    have hz : residual A X = 0 := le_antisymm (le_of_not_gt hp) hn\n    exact ha ((residual_zero_iff A X).mp hz)\n\ntheorem residual_flow (A X : M2) (rate omega time : ℝ) :\n    residual A (flow rate omega time X) = residual A X := by\n  simp only [residual, reading_flow]\n\ntheorem residual_time_continuous (A X : M2) (rate omega : ℝ) :\n    Continuous (fun time : ℝ => residual A (flow rate omega time X)) := by\n  simpa only [residual_flow] using\n    (continuous_const : Continuous (fun _ : ℝ => residual A X))\n\ntheorem residual_time_derivative_zero (A X : M2) (rate omega time : ℝ) :\n    HasDerivAt (fun s : ℝ => residual A (flow rate omega s X)) 0 time := by\n  simpa only [residual_flow] using (hasDerivAt_const time (residual A X))\n\ntheorem inscription_has_zero_residual (A : RuleContinuousMotor.Inscription Eg) :\n    residual A.val A.val = 0 := by\n  exact (residual_zero_iff _ _).mpr A.property\n\ntheorem inscription_residual_zero_iff (A X : RuleContinuousMotor.Inscription Eg) :\n    residual A.val X.val = 0 ↔ X = A := by\n  rw [residual_zero_iff]\n  change Eg X.val = A.val ↔ X = A\n  rw [X.property]\n  exact Subtype.ext_iff.symm\n\ntheorem impossible_anchor_positive (A : M2) (ha : Eg A ≠ A) (X : M2) :\n    0 < residual A X := by\n  apply (residual_positive_iff A X).mpr\n  intro h\n  have hi := Eg_idem X\n  change Eg X = A at h\n  rw [h] at hi\n  exact ha hi\n\ndef anchor : M2 := (1/2 : ℂ) • (1 : M2)\n\ntheorem anchor_fixed : Eg anchor = anchor := by\n  simp only [anchor, map_smul, Eg_one]\n\ndef anchorInscription : RuleContinuousMotor.Inscription Eg := ⟨anchor, anchor_fixed⟩\n\ntheorem transported_accepted : residual anchor transportedRho = 0 := by\n  apply (residual_zero_iff _ _).mpr\n  exact transported_reading\n\ntheorem changed_anchor_residual : residual projPlus transportedRho = 1/2 := by\n  unfold residual\n  rw [transported_reading, IALDGraviton.projPlus_entries]\n  norm_num [purityR, Fin.sum_univ_two, Matrix.smul_apply, Matrix.sub_apply,\n    Matrix.one_apply, Complex.normSq_apply]\n\ntheorem transported_is_not_anchor : transportedRho ≠ anchor := by\n  intro h\n  have hc := congrArg (fun X : M2 => X 0 1) h\n  rw [density_transport] at hc\n  norm_num [PxMinus, anchor, hCrossC] at hc\n\ntheorem changed_anchor_rejected (rate omega time : ℝ) :\n    ¬ Admissible Eg projPlus (flow rate omega time transportedRho) := by\n  apply (residual_positive_iff _ _).mp\n  rw [residual_flow, changed_anchor_residual]\n  norm_num\n\ntheorem accepted_along_flow (rate omega time : ℝ) :\n    residual anchor (flow rate omega time transportedRho) = 0 := by\n  rw [residual_flow, transported_accepted]\n\ntheorem inhabited_and_discriminating :\n    ∃ A X : M2, Eg A = A ∧ residual A X = 0 ∧ X ≠ A ∧\n      residual projPlus X = 1/2 :=\n  ⟨anchor, transportedRho, anchor_fixed, transported_accepted,\n    transported_is_not_anchor, changed_anchor_residual⟩\n\nend\nend TGLExt.RuleQuadraticResidual\n\n#print axioms TGLExt.RuleQuadraticResidual.purityR_nonnegative\n#print axioms TGLExt.RuleQuadraticResidual.purityR_zero_iff\n#print axioms TGLExt.RuleQuadraticResidual.residual_nonnegative\n#print axioms TGLExt.RuleQuadraticResidual.residual_zero_iff\n#print axioms TGLExt.RuleQuadraticResidual.residual_positive_iff\n#print axioms TGLExt.RuleQuadraticResidual.residual_flow\n#print axioms TGLExt.RuleQuadraticResidual.residual_time_continuous\n#print axioms TGLExt.RuleQuadraticResidual.residual_time_derivative_zero\n#print axioms TGLExt.RuleQuadraticResidual.inscription_has_zero_residual\n#print axioms TGLExt.RuleQuadraticResidual.inscription_residual_zero_iff\n#print axioms TGLExt.RuleQuadraticResidual.impossible_anchor_positive\n#print axioms TGLExt.RuleQuadraticResidual.anchor_fixed\n#print axioms TGLExt.RuleQuadraticResidual.transported_accepted\n#print axioms TGLExt.RuleQuadraticResidual.changed_anchor_residual\n#print axioms TGLExt.RuleQuadraticResidual.transported_is_not_anchor\n#print axioms TGLExt.RuleQuadraticResidual.changed_anchor_rejected\n#print axioms TGLExt.RuleQuadraticResidual.accepted_along_flow\n#print axioms TGLExt.RuleQuadraticResidual.inhabited_and_discriminating\n',
+    'TGLExt/F1Fecho394/BosonicTwoParticle.lean': 'import TGLExt.LightNetStandardWedgeDataBGL\nimport Mathlib.Analysis.InnerProductSpace.TensorProduct\nimport Mathlib.Analysis.InnerProductSpace.Completion\nimport Mathlib.Analysis.Normed.Operator.Extend\n/-!\nConcrete first bosonic sector on the canonical v392 H1. The algebraic tensor\nproduct is completed, and the two-particle space is the closed fixed subspace\nof the flip. Unitaries act by the completed tensor square, restricted to that\nsubspace. This constructs an actual sector, not a FockCertificate, Weyl net,\nMaxwell field, or general second-quantization theorem.\n-/\nset_option autoImplicit false\nset_option maxHeartbeats 600000\nset_option synthInstance.maxHeartbeats 100000\nnoncomputable section\nopen scoped TensorProduct\nopen UniformSpace\nnamespace F1Rede.BosonicTwoParticle\nopen TGLExt.ImportedSQ\n\nsection CompletionEquiv\nvariable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]\n  [NormedAddCommGroup F] [InnerProductSpace ℂ F]\n\ndef completionEquiv (u : E ≃ₗᵢ[ℂ] F) : Completion E ≃ₗᵢ[ℂ] Completion F :=\n  u.toLinearEquiv.extendOfIsometry\n    (Completion.toComplₗᵢ (𝕜 := ℂ) (E := E)).toLinearMap\n    (Completion.toComplₗᵢ (𝕜 := ℂ) (E := F)).toLinearMap\n    Completion.denseRange_coe Completion.denseRange_coe\n    (fun x => by simp)\n\n@[simp] theorem completionEquiv_coe (u : E ≃ₗᵢ[ℂ] F) (x : E) :\n    completionEquiv u (x : Completion E) = (u x : Completion F) := by\n  exact LinearEquiv.extendOfIsometry_eq _ _ _ _ _ _ x\nend CompletionEquiv\n\nabbrev AlgebraicTwo := H1 ⊗[ℂ] H1\nabbrev CompletedTwo := Completion AlgebraicTwo\n\ndef flip : CompletedTwo ≃ₗᵢ[ℂ] CompletedTwo :=\n  completionEquiv (TensorProduct.commIsometry ℂ H1 H1)\n\n@[simp] theorem flip_coe (x : AlgebraicTwo) :\n    flip (x : CompletedTwo) = (TensorProduct.comm ℂ H1 H1 x : CompletedTwo) := by\n  simp [flip]\n\n@[simp] theorem flip_flip (x : CompletedTwo) : flip (flip x) = x := by\n  refine Completion.induction_on x (isClosed_eq (flip.continuous.comp flip.continuous) continuous_id) ?_\n  intro a\n  simp\n\ndef symmetricSector : Submodule ℂ CompletedTwo where\n  carrier := {x | flip x = x}\n  zero_mem\' := by simp\n  add_mem\' := by intro x y hx hy; simp only [Set.mem_setOf_eq] at *; simp [hx, hy]\n  smul_mem\' := by intro c x hx; simp only [Set.mem_setOf_eq] at *; simp [hx]\n\n@[simp] theorem mem_symmetricSector (x : CompletedTwo) :\n    x ∈ symmetricSector ↔ flip x = x := Iff.rfl\n\ntheorem symmetricSector_closed : IsClosed (symmetricSector : Set CompletedTwo) :=\n  isClosed_eq flip.continuous continuous_id\n\ninstance : CompleteSpace symmetricSector :=\n  symmetricSector_closed.completeSpace_coe\n\ndef pair (x : H1) : symmetricSector :=\n  ⟨((x ⊗ₜ[ℂ] x : AlgebraicTwo) : CompletedTwo), by simp⟩\n\n@[simp] theorem pair_norm (x : H1) : ‖pair x‖ = ‖x‖ * ‖x‖ := by\n  simp [pair]\n\ntheorem pair_ne_zero {x : H1} (hx : x ≠ 0) : pair x ≠ 0 := by\n  intro h\n  have hnorm := pair_norm x\n  rw [h, norm_zero] at hnorm\n  exact (mul_ne_zero (norm_ne_zero_iff.mpr hx) (norm_ne_zero_iff.mpr hx)) hnorm.symm\n\ntheorem symmetricSector_nontrivial : Nontrivial symmetricSector := by\n  haveI := AuditF13v31.H1_nontrivial\n  obtain ⟨x, hx⟩ := exists_ne (0 : H1)\n  exact ⟨⟨pair x, 0, pair_ne_zero hx⟩⟩\n\ndef tensorSquare (u : H1 ≃ₗᵢ[ℂ] H1) : CompletedTwo ≃ₗᵢ[ℂ] CompletedTwo :=\n  completionEquiv (TensorProduct.congrIsometry u u)\n\n@[simp] theorem tensorSquare_coe (u : H1 ≃ₗᵢ[ℂ] H1) (x : AlgebraicTwo) :\n    tensorSquare u (x : CompletedTwo) =\n      (TensorProduct.congr u.toLinearEquiv u.toLinearEquiv x : CompletedTwo) := by\n  rw [tensorSquare, completionEquiv_coe]\n  rfl\n\ntheorem tensorSquare_flip (u : H1 ≃ₗᵢ[ℂ] H1) (x : CompletedTwo) :\n    tensorSquare u (flip x) = flip (tensorSquare u x) := by\n  refine Completion.induction_on x (isClosed_eq\n    ((tensorSquare u).continuous.comp flip.continuous)\n    (flip.continuous.comp (tensorSquare u).continuous)) ?_\n  intro a\n  simp only [flip_coe, tensorSquare_coe]\n  congr 1\n  induction a using TensorProduct.induction_on with\n  | zero => simp\n  | tmul x y => simp\n  | add x y hx hy => simp only [map_add, hx, hy]\n\ntheorem tensorSquare_mem (u : H1 ≃ₗᵢ[ℂ] H1) {x : CompletedTwo}\n    (hx : x ∈ symmetricSector) : tensorSquare u x ∈ symmetricSector := by\n  rw [mem_symmetricSector] at hx ⊢\n  rw [← tensorSquare_flip, hx]\n\ntheorem tensorSquare_inverse (u : H1 ≃ₗᵢ[ℂ] H1) (x : CompletedTwo) :\n    tensorSquare u.symm (tensorSquare u x) = x := by\n  refine Completion.induction_on x (isClosed_eq\n    ((tensorSquare u.symm).continuous.comp (tensorSquare u).continuous) continuous_id) ?_\n  intro a\n  simp only [tensorSquare_coe]\n  congr 1\n  induction a using TensorProduct.induction_on with\n  | zero => simp\n  | tmul x y => simp\n  | add x y hx hy => simp only [map_add, hx, hy]\n\ndef gammaTwo (u : H1 ≃ₗᵢ[ℂ] H1) : symmetricSector ≃ₗᵢ[ℂ] symmetricSector where\n  toFun x := ⟨tensorSquare u x, tensorSquare_mem u x.property⟩\n  invFun x := ⟨tensorSquare u.symm x, tensorSquare_mem u.symm x.property⟩\n  left_inv x := by apply Subtype.ext; exact tensorSquare_inverse u x\n  right_inv x := by apply Subtype.ext; simpa using tensorSquare_inverse u.symm (x : CompletedTwo)\n  map_add\' x y := by apply Subtype.ext; exact (tensorSquare u).map_add x y\n  map_smul\' c x := by apply Subtype.ext; exact (tensorSquare u).map_smul c x\n  norm_map\' x := (tensorSquare u).norm_map x\n\n@[simp] theorem gammaTwo_pair (u : H1 ≃ₗᵢ[ℂ] H1) (x : H1) :\n    gammaTwo u (pair x) = pair (u x) := by\n  apply Subtype.ext\n  change tensorSquare u ((x ⊗ₜ[ℂ] x : AlgebraicTwo) : CompletedTwo) = _\n  simp [pair]\n\ntheorem tensorSquare_trans (u v : H1 ≃ₗᵢ[ℂ] H1) (x : CompletedTwo) :\n    tensorSquare (u.trans v) x = tensorSquare v (tensorSquare u x) := by\n  refine Completion.induction_on x (isClosed_eq\n    (tensorSquare (u.trans v)).continuous\n    ((tensorSquare v).continuous.comp (tensorSquare u).continuous)) ?_\n  intro a\n  simp only [tensorSquare_coe]\n  congr 1\n  induction a using TensorProduct.induction_on with\n  | zero => simp\n  | tmul x y => simp\n  | add x y hx hy => simp only [map_add, hx, hy]\n\ntheorem gammaTwo_trans (u v : H1 ≃ₗᵢ[ℂ] H1) :\n    gammaTwo (u.trans v) = (gammaTwo u).trans (gammaTwo v) := by\n  ext x\n  exact tensorSquare_trans u v x\n\ntheorem gammaTwo_refl : gammaTwo (.refl ℂ H1) = .refl ℂ symmetricSector := by\n  ext x\n  change tensorSquare (.refl ℂ H1) (x : CompletedTwo) = x\n  refine Completion.induction_on (x : CompletedTwo)\n    (isClosed_eq (tensorSquare (.refl ℂ H1)).continuous continuous_id) ?_\n  intro a\n  simp [tensorSquare, TensorProduct.congrIsometry_refl_refl]\n\nend F1Rede.BosonicTwoParticle\n\n#print axioms F1Rede.BosonicTwoParticle.symmetricSector_nontrivial\n#print axioms F1Rede.BosonicTwoParticle.gammaTwo_trans\n#print axioms F1Rede.BosonicTwoParticle.gammaTwo_refl\n#print axioms F1Rede.BosonicTwoParticle.gammaTwo_pair\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    let axs ← collectAxioms n\n    IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n    unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n      throwError "AXIOM_AUDIT_REFUSED: {n}"\n    match ci with\n    | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n    | _ => pure ()\n',
+    'TGLExt/F1Fecho394/BosonicSectors.lean': 'import TGLExt.F1Fecho394.BosonicTwoParticle\nimport Mathlib.Analysis.InnerProductSpace.l2Space\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option synthInstance.maxHeartbeats 100000\nnoncomputable section\nopen UniformSpace\nopen scoped TensorProduct\nnamespace F1Rede.BosonicSectors\nopen TGLExt.ImportedSQ F1Rede.BosonicTwoParticle\n\n/-- Recursively bracketed algebraic tensor powers. We complete each entire\npower and take the closed span of diagonal pure powers as its symmetric sector.\nThe permutation-fixed presentation is not identified by a theorem in this file.\nThe zero algebraic sector is the scalar field. -/\nstructure PreHilbert where\n  carrier : Type\n  [instN : NormedAddCommGroup carrier]\n  [instI : InnerProductSpace ℂ carrier]\nattribute [instance] PreHilbert.instN PreHilbert.instI\n\ndef powerData : ℕ → PreHilbert\n  | 0 => ⟨ℂ⟩\n  | n+1 => ⟨H1 ⊗[ℂ] (powerData n).carrier⟩\n\nabbrev Algebraic (n : ℕ) := (powerData n).carrier\n\ndef algebraicGamma (u : H1 ≃ₗᵢ[ℂ] H1) : (n : ℕ) → Algebraic n ≃ₗᵢ[ℂ] Algebraic n\n  | 0 => LinearIsometryEquiv.refl ℂ ℂ\n  | n+1 => TensorProduct.congrIsometry u (algebraicGamma u n)\n\ndef pureAlgebraic (x : H1) : (n : ℕ) → Algebraic n\n  | 0 => (1 : ℂ)\n  | n+1 => x ⊗ₜ[ℂ] pureAlgebraic x n\n\n@[simp] theorem algebraicGamma_tmul (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : H1) (y : Algebraic n) :\n    algebraicGamma u (n+1) (x ⊗ₜ[ℂ] y) = u x ⊗ₜ[ℂ] algebraicGamma u n y := by\n  change TensorProduct.congrIsometry u (algebraicGamma u n) (x ⊗ₜ[ℂ] y) = _\n  simp\n\ntheorem pureAlgebraic_norm (x : H1) (n : ℕ) :\n    ‖pureAlgebraic x n‖ = ‖x‖ ^ n := by\n  induction n with\n  | zero => change ‖(1 : ℂ)‖ = ‖x‖^0; simp\n  | succ n ih =>\n    change ‖(x ⊗ₜ[ℂ] pureAlgebraic x n : H1 ⊗[ℂ] Algebraic n)‖ = _\n    rw [TensorProduct.norm_tmul, ih, pow_succ, mul_comm]\n\ntheorem algebraicGamma_pure (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : H1) :\n    algebraicGamma u n (pureAlgebraic x n) = pureAlgebraic (u x) n := by\n  induction n with\n  | zero => rfl\n  | succ n ih =>\n    change algebraicGamma u (n+1) (x ⊗ₜ[ℂ] pureAlgebraic x n) = _\n    rw [algebraicGamma_tmul, ih]\n    rfl\n\ntheorem algebraicGamma_refl (n : ℕ) (x : Algebraic n) :\n    algebraicGamma (.refl ℂ H1) n x = x := by\n  induction n with\n  | zero => rfl\n  | succ n ih =>\n    change TensorProduct.congrIsometry (.refl ℂ H1) (algebraicGamma (.refl ℂ H1) n) x = x\n    induction x using TensorProduct.induction_on with\n    | zero => simp\n    | tmul x y => simp [ih]\n    | add x y hx hy => simp only [map_add, hx, hy]\n\ntheorem algebraicGamma_trans (u v : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : Algebraic n) :\n    algebraicGamma (u.trans v) n x = algebraicGamma v n (algebraicGamma u n x) := by\n  induction n with\n  | zero => rfl\n  | succ n ih =>\n    change TensorProduct.congrIsometry (u.trans v) (algebraicGamma (u.trans v) n) x =\n      TensorProduct.congrIsometry v (algebraicGamma v n) (TensorProduct.congrIsometry u (algebraicGamma u n) x)\n    induction x using TensorProduct.induction_on with\n    | zero => simp\n    | tmul x y => simp [ih]\n    | add x y hx hy => simp only [map_add, hx, hy]\n\ntheorem algebraicGamma_inverse (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : Algebraic n) :\n    algebraicGamma u.symm n (algebraicGamma u n x) = x := by\n  induction n with\n  | zero => rfl\n  | succ n ih =>\n    change TensorProduct.congrIsometry u.symm (algebraicGamma u.symm n)\n      (TensorProduct.congrIsometry u (algebraicGamma u n) x) = x\n    induction x using TensorProduct.induction_on with\n    | zero => simp\n    | tmul x y => simp [ih]\n    | add x y hx hy => simp only [map_add, hx, hy]\n\nabbrev TensorHilbert (n : ℕ) := Completion (Algebraic n)\ndef tensorGamma (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) : TensorHilbert n ≃ₗᵢ[ℂ] TensorHilbert n :=\n  completionEquiv (algebraicGamma u n)\n\n@[simp] theorem tensorGamma_coe (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : Algebraic n) :\n    tensorGamma u n (x : TensorHilbert n) = (algebraicGamma u n x : TensorHilbert n) :=\n  completionEquiv_coe _ _\n\ndef pureCompleted (n : ℕ) (x : H1) : TensorHilbert n := pureAlgebraic x n\ndef algebraicSymmetricSpan (n : ℕ) : Submodule ℂ (TensorHilbert n) :=\n  Submodule.span ℂ (Set.range (pureCompleted n))\n/-- Symmetric tensors are constructed as the closed span of diagonal tensor\npowers. No assumed symmetry, density, or unitary action is a field of a contract. -/\ndef symmetricSpace (n : ℕ) : Submodule ℂ (TensorHilbert n) :=\n  (algebraicSymmetricSpan n).topologicalClosure\nabbrev Sector (n : ℕ) := symmetricSpace n\ninstance sectorComplete (n : ℕ) : CompleteSpace (Sector n) :=\n  (algebraicSymmetricSpan n).isClosed_topologicalClosure.completeSpace_coe\n\ntheorem pureCompleted_mem (n : ℕ) (x : H1) : pureCompleted n x ∈ symmetricSpace n :=\n  (algebraicSymmetricSpan n).le_topologicalClosure (Submodule.subset_span ⟨x, rfl⟩)\n\ndef pureTensor (n : ℕ) (x : H1) : Sector n := ⟨pureCompleted n x, pureCompleted_mem n x⟩\n\n@[simp] theorem pureTensor_norm (n : ℕ) (x : H1) : ‖pureTensor n x‖ = ‖x‖ ^ n := by\n  change ‖(pureAlgebraic x n : Completion (Algebraic n))‖ = _\n  rw [Completion.norm_coe, pureAlgebraic_norm]\n\ntheorem sector_nontrivial (n : ℕ) : Nontrivial (Sector n) := by\n  haveI := AuditF13v31.H1_nontrivial\n  obtain ⟨x, hx⟩ := exists_ne (0 : H1)\n  refine ⟨⟨pureTensor n x, 0, ?_⟩⟩\n  intro h\n  have hn := pureTensor_norm n x\n  rw [h, norm_zero] at hn\n  exact (pow_ne_zero n (norm_ne_zero_iff.mpr hx)) hn.symm\n\ntheorem tensorGamma_pure (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : H1) :\n    tensorGamma u n (pureCompleted n x) = pureCompleted n (u x) := by\n  simp only [pureCompleted, tensorGamma_coe, algebraicGamma_pure]\n\ntheorem tensorGamma_mem (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) {x : TensorHilbert n}\n    (hx : x ∈ symmetricSpace n) : tensorGamma u n x ∈ symmetricSpace n := by\n  let S := symmetricSpace n\n  have hbase : algebraicSymmetricSpan n ≤ S.comap (tensorGamma u n).toLinearMap := by\n    apply Submodule.span_le.mpr\n    rintro _ ⟨y, rfl⟩\n    change tensorGamma u n (pureCompleted n y) ∈ S\n    rw [tensorGamma_pure]\n    exact pureCompleted_mem n (u y)\n  have hclosed : IsClosed (S.comap (tensorGamma u n).toLinearMap : Set (TensorHilbert n)) :=\n    (algebraicSymmetricSpan n).isClosed_topologicalClosure.preimage (tensorGamma u n).continuous\n  exact (algebraicSymmetricSpan n).topologicalClosure_minimal hbase hclosed hx\n\ntheorem tensorGamma_inverse (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : TensorHilbert n) :\n    tensorGamma u.symm n (tensorGamma u n x) = x := by\n  refine Completion.induction_on x (isClosed_eq\n    ((tensorGamma u.symm n).continuous.comp (tensorGamma u n).continuous) continuous_id) ?_\n  intro a\n  simp [algebraicGamma_inverse]\n\ndef gammaSector (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) : Sector n ≃ₗᵢ[ℂ] Sector n where\n  toFun x := ⟨tensorGamma u n x, tensorGamma_mem u n x.property⟩\n  invFun x := ⟨tensorGamma u.symm n x, tensorGamma_mem u.symm n x.property⟩\n  left_inv x := by apply Subtype.ext; exact tensorGamma_inverse u n x\n  right_inv x := by apply Subtype.ext; simpa using tensorGamma_inverse u.symm n (x : TensorHilbert n)\n  map_add\' x y := by apply Subtype.ext; exact (tensorGamma u n).map_add x y\n  map_smul\' c x := by apply Subtype.ext; exact (tensorGamma u n).map_smul c x\n  norm_map\' x := (tensorGamma u n).norm_map x\n\n@[simp] theorem gammaSector_pure (u : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : H1) :\n    gammaSector u n (pureTensor n x) = pureTensor n (u x) := by\n  apply Subtype.ext\n  exact tensorGamma_pure u n x\n\ntheorem tensorGamma_trans (u v : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) (x : TensorHilbert n) :\n    tensorGamma (u.trans v) n x = tensorGamma v n (tensorGamma u n x) := by\n  refine Completion.induction_on x (isClosed_eq (tensorGamma (u.trans v) n).continuous\n    ((tensorGamma v n).continuous.comp (tensorGamma u n).continuous)) ?_\n  intro a\n  simp [algebraicGamma_trans]\n\ntheorem gammaSector_trans (u v : H1 ≃ₗᵢ[ℂ] H1) (n : ℕ) :\n    gammaSector (u.trans v) n = (gammaSector u n).trans (gammaSector v n) := by\n  ext x\n  exact tensorGamma_trans u v n x\n\ntheorem gammaSector_refl (n : ℕ) : gammaSector (.refl ℂ H1) n = .refl ℂ (Sector n) := by\n  ext x\n  change tensorGamma (.refl ℂ H1) n (x : TensorHilbert n) = x\n  refine Completion.induction_on (x : TensorHilbert n)\n    (isClosed_eq (tensorGamma (.refl ℂ H1) n).continuous continuous_id) ?_\n  intro a\n  simp [algebraicGamma_refl]\n\ndef vacuumSector : Sector 0 := pureTensor 0 (0 : H1)\n@[simp] theorem vacuumSector_norm : ‖vacuumSector‖ = 1 := by\n  exact (pureTensor_norm 0 (0 : H1)).trans (pow_zero _)\n@[simp] theorem gammaSector_vacuum (u : H1 ≃ₗᵢ[ℂ] H1) :\n    gammaSector u 0 vacuumSector = vacuumSector := by simp [vacuumSector]\n\ndef oneParticleEmbedding : H1 →ₗᵢ[ℂ] Sector 1 where\n  toFun x := pureTensor 1 x\n  map_add\' x y := by\n    apply Subtype.ext\n    change (Completion.toComplₗᵢ (𝕜 := ℂ)) ((x+y) ⊗ₜ[ℂ] (1:ℂ)) =\n      (Completion.toComplₗᵢ (𝕜 := ℂ)) (x ⊗ₜ[ℂ] (1:ℂ)) +\n      (Completion.toComplₗᵢ (𝕜 := ℂ)) (y ⊗ₜ[ℂ] (1:ℂ))\n    rw [TensorProduct.add_tmul, map_add]\n  map_smul\' c x := by\n    apply Subtype.ext\n    change (Completion.toComplₗᵢ (𝕜 := ℂ)) ((c • x) ⊗ₜ[ℂ] (1:ℂ)) =\n      c • (Completion.toComplₗᵢ (𝕜 := ℂ)) (x ⊗ₜ[ℂ] (1:ℂ))\n    rw [← TensorProduct.smul_tmul\', map_smul]\n  norm_map\' x := by exact (pureTensor_norm 1 x).trans (pow_one _)\n\ntheorem gammaSector_oneParticle (u : H1 ≃ₗᵢ[ℂ] H1) (x : H1) :\n    gammaSector u 1 (oneParticleEmbedding x) = oneParticleEmbedding (u x) :=\n  gammaSector_pure u 1 x\n\nend F1Rede.BosonicSectors\n\n#print axioms F1Rede.BosonicSectors.gammaSector\n#print axioms F1Rede.BosonicSectors.gammaSector_trans\n#print axioms F1Rede.BosonicSectors.gammaSector_refl\n#print axioms F1Rede.BosonicSectors.sector_nontrivial\n#print axioms F1Rede.BosonicSectors.oneParticleEmbedding\n#print axioms F1Rede.BosonicSectors.gammaSector_oneParticle\n#print axioms F1Rede.BosonicSectors.gammaSector_vacuum\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM