x)) := by rw [h1]\n\nend F1Fecho.BoundedPairResolvent\n#print axioms F1Fecho.BoundedPairResolvent.domain_relation\n#print axioms F1Fecho.BoundedPairResolvent.equation\n",
+    'TGLExt/F1Fecho394/CanonicalZeroSectorResolventR1.lean': 'import TGLExt.F1Fecho394.CanonicalFockGraphRealizationR3\nimport TGLExt.F1Fecho394.BoundedPairResolventEquationR2\n/-! The actual modular resolvent on the vacuum sector is one half.\nThe proof uses the constructed bounded graph parameters and their resolvent\nequation. It does not assume that the resolvent preserves particle sectors. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen UniformSpace\nnamespace F1Fecho.CanonicalZeroSector\nopen TGLExt.ImportedSQ F1Rede.BosonicSectors F1Rede.BosonicFock\nopen F1Fecho.ExponentialLift F1Fecho.GammaGraph F1Fecho.CanonicalFockPolar\n\ntheorem tensor_zero (A : H1 →L[ℂ] H1) (x : TensorHilbert 0) :\n    BoundedGamma.tensor A 0 x = x := by\n  refine Completion.induction_on x\n    (isClosed_eq (BoundedGamma.tensor A 0).continuous continuous_id) ?_\n  intro z\n  rw [BoundedGamma.tensor_coe]\n  rfl\n\ntheorem sector_zero (A : H1 →L[ℂ] H1) (x : Sector 0) :\n    BoundedGamma.sector A 0 x = x := by\n  apply Subtype.ext\n  exact tensor_zero A x\n\ntheorem GA_zero (x : F) : GA x 0 = x 0 :=\n  sector_zero _ _\n\ntheorem GB_zero (x : F) : GB x 0 = x 0 :=\n  sector_zero _ _\n\ntheorem modularR_zero (x : F) :\n    modularR x 0 = (1/2 : ℂ) • x 0 := by\n  have he := BoundedPairResolvent.equation canonicalLift canonicalLift_selfadjoint\n    GA GB GA_selfadjoint GB_selfadjoint graph_parameters GAB_commute\n  have h := congrArg (fun L : F →L[ℂ] F => L x 0) he\n  change GA (GA (modularR x)) 0 + GB (GB (modularR x)) 0 = GA (GA x) 0 at h\n  simp only [GA_zero,GB_zero] at h\n  have h2 : (2 : ℂ) • (modularR x) 0 = x 0 := by\n    simpa only [two_smul ℂ] using h\n  calc\n    modularR x 0 = (1/2 : ℂ) • ((2 : ℂ) • (modularR x) 0) := by\n      rw [smul_smul]\n      norm_num\n    _ = (1/2 : ℂ) • x 0 := by rw [h2]\n\nend F1Fecho.CanonicalZeroSector\n#print axioms F1Fecho.CanonicalZeroSector.tensor_zero\n#print axioms F1Fecho.CanonicalZeroSector.sector_zero\n#print axioms F1Fecho.CanonicalZeroSector.GA_zero\n#print axioms F1Fecho.CanonicalZeroSector.GB_zero\n#print axioms F1Fecho.CanonicalZeroSector.modularR_zero\n',
+    'TGLExt/F1Fecho394/CanonicalFockModularFlowR2.lean': 'import TGLExt.F1Fecho394.CanonicalFockGraphRealizationR3\nimport TGLExt.V351ResolventImaginaryContinuity\nimport TGLExt.O16.ContentContractProposal\n/-! Actual spectral imaginary powers of the Weyl/vacuum Tomita square.\nThe flow is constructed by CFC from that operator, and is not renamed Gamma(B0).\nEquality to the prescribed geometric boost remains a separate obligation. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1500000\nset_option synthInstance.maxHeartbeats 200000\nnoncomputable section\nnamespace F1Fecho.CanonicalFockPolar\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.ExponentialTomita F1Fecho.WedgePairTomita TGLV350.Regular ORDEM016.D6\n\ndef actualModularFlow : ℝ → F ≃ₗᵢ[ℂ] F :=\n  resolventImaginaryPower modularR modularR_nonneg modularR_le_one\n    modularR_injective modularR_complement_injective\n\ntheorem actualModularFlow_zero (x : F) : actualModularFlow 0 x=x :=\n  resolventImaginaryPower_zero _ _ _ _ _ x\n\ntheorem actualModularFlow_add (s t : ℝ) (x : F) :\n    actualModularFlow s (actualModularFlow t x)=actualModularFlow (s+t) x :=\n  resolventImaginaryPower_add _ _ _ _ _ s t x\n\ntheorem actualModularFlow_continuous (x : F) : Continuous (fun t => actualModularFlow t x) :=\n  resolventImaginaryPower_strongly_continuous _ _ _ _ _ x\n\ntheorem actualModularFlow_readout (t : ℝ) (x : F) :\n    actualModularFlow t (resolventDampingOperator modularR x)=resolventPhaseOperator modularR t x :=\n  resolventImaginaryPower_damping _ _ _ _ _ t x\n\n/-- Analytic realization for the constructed spectral flow, not for the target Gamma boost. -/\ntheorem actual_spectral_pair_measured :\n    PairTomitaAnalyticRealizationMeasured (algebra KWR) vacuum JF actualModularFlow :=\n  ⟨actualGraphRealization,rfl,actualModularFlow_readout⟩\n\nend F1Fecho.CanonicalFockPolar\n#print axioms F1Fecho.CanonicalFockPolar.actualModularFlow\n#print axioms F1Fecho.CanonicalFockPo