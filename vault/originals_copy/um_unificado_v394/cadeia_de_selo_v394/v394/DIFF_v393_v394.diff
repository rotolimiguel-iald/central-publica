n    diagonal b (put i v) = put i (b v) := by\n  apply coord.injective\n  fin_cases i <;> simp [put,diagonal_apply,map_zero]\ntheorem put_take_decomposition (v : H2 (H := H)) :\n    put 0 (take 0 v) + put 1 (take 1 v) = v := by\n  apply coord.injective\n  simp [put,take]\ntheorem take_ext {v w : H2 (H := H)} (h : ∀ i : Fin 2, take i v = take i w) : v=w := by\n  apply coord.injective\n  exact Prod.ext (by simpa [take] using h 0) (by simpa [take] using h 1)\n\ndef block (P : H2 (H := H) →L[ℂ] H2 (H := H)) (i j : Fin 2) : H →L[ℂ] H :=\n  (take i).comp (P.comp (put j))\ntheorem block_commutes (A : StarSubalgebra ℂ (H →L[ℂ] H)) (w : H2 (H := H))\n    (i j : Fin 2) (b : H →L[ℂ] H) (hb : b ∈ A) :\n    block (orbitSpace A w).starProjection i j * b = b * block (orbitSpace A w).starProjection i j := by\n  ext x\n  change take i ((orbitSpace A w).starProjection (put j (b x))) =\n    b (take i ((orbitSpace A w).starProjection (put j x)))\n  rw [← diagonal_put,projection_commutes A w b hb,take_diagonal]\n\ntheorem bicommutant_projection_commutes (A : StarSubalgebra ℂ (H →L[ℂ] H))\n    (a : H →L[ℂ] H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A, b*c=c*b) → a*b=b*a)\n    (w v : H2 (H := H)) :\n    (orbitSpace A w).starProjection (diagonal a v) = diagonal a ((orbitSpace A w).starProjection v) := by\n  let P := (orbitSpace A w).starProjection\n  have hb (i j : Fin 2) : ∀ x : H, a (block P i j x) = block P i j (a x) := by\n    intro x\n    exact congrArg (fun f : H →L[ℂ] H => f x)\n      (ha (block P i j) (fun c hc => block_commutes A w i j c hc))\n  have hp (i : Fin 2) (z : H2 (H := H)) :\n      take i (P z) = block P i 0 (take 0 z) + block P i 1 (take 1 z) := by\n    conv_lhs => rw [← put_take_decomposition z]\n    simp only [map_add]\n    rfl\n  apply take_ext\n  intro i\n  change take i (P (diagonal a v)) = take i (diagonal a (P v))\n  rw [hp,take_diagonal,take_diagonal,take_diagonal,hp,map_add,hb,hb]\n\ntheorem vector_mem_orbit (A : StarSubalgebra ℂ (H →L[ℂ] H)) (w : H2 (H := H)) : w ∈ orbitSpace A w := by\n  apply Submodule.le_topologicalClosure\n  refine ⟨1,?_⟩\n  apply coord.injective\n  simp [orbitMap,diagonal_apply]\n\ntheorem diagonal_bicommutant_mem_orbit (A : StarSubalgebra ℂ (H →L[ℂ] H))\n    (a : H →L[ℂ] H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A, b*c=c*b) → a*b=b*a)\n    (w : H2 (H := H)) : diagonal a w ∈ orbitSpace A w := by\n  apply Submodule.starProjection_eq_self_iff.mp\n  rw [bicommutant_projection_commutes A a ha]\n  rw [Submodule.starProjection_eq_self_iff.mpr (vector_mem_orbit A w)]\n\ntheorem two_vector_density (A : StarSubalgebra ℂ (H →L[ℂ] H))\n    (a : H →L[ℂ] H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A, b*c=c*b) → a*b=b*a)\n    (x y : H) : (a x,a y) ∈ closure {p : H × H | ∃ b ∈ A, p=(b x,b y)} := by\n  let w : H2 (H := H) := coord.symm (x,y)\n  have hw := diagonal_bicommutant_mem_orbit A a ha w\n  have hh : coord '' ((orbitMap A w).range : Set (H2 (H := H))) ⊆\n      {p : H × H | ∃ b ∈ A, p=(b x,b y)} := by\n    rintro p ⟨v,⟨b,rfl⟩,rfl⟩\n    refine ⟨b,b.property,?_⟩\n    simp [orbitMap,diagonal_apply,w]\n  have hc := image_closure_subset_closure_image coord.continuous ⟨diagonal a w,hw,rfl⟩\n  apply closure_mono hh at hc\n  simpa [diagonal_apply,w] using hc\n\nend F1Fecho.BicommutantTwoVector\n#print axioms F1Fecho.BicommutantTwoVector.projection_commutes\n#print axioms F1Fecho.BicommutantTwoVector.bicommutant_projection_commutes\n#print axioms F1Fecho.BicommutantTwoVector.two_vector_density\n",
+    'TGLExt/F1Fecho394/WeylFiniteAlgebraR4.lean': "import TGLExt.F1Fecho394.ExponentialTomitaInclusionR2\nimport TGLExt.F1Fecho394.BicommutantTwoVectorR2\n/-! The complex span of the actual field Weyl operators is a unital star\nalgebra. Its vacuum graph is contained in the constructed exponential Tomita\ngraph. All operators act on the same concrete bosonic Fock space. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nnamespace F1Fecho.WeylFiniteAlgebra\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.Exponential\nopen F1Fecho.ExponentialLift F1Fecho.ExponentialTomita F1Fecho.WeylExponentialCore\nopen F1Rede.CanonicalWedge F1Fecho.WeylCoefficients F1Fecho.ExponentialTomitaInclusion\n\ndef finiteSpan : Submodule ℂ (F →L[ℂ] F) :=\n  Submodule.span ℂ (F1Fecho.WeylNet.generators FieldWeyl.W K)\ntheorem generator_mem (k : H1) (hk : k ∈ K) : FieldWeyl.W k ∈ finiteSpan :=\n  Submodule.subset_span ⟨k,hk,rfl⟩\ntheorem one_mem : (1 : F →L[ℂ] F) ∈ finiteSpan := by\n  simpa only [FieldWeyl.W_zero] using generator_mem 0 K.zero_mem\ntheorem generator_mul_mem (k : H1) (hk : k ∈ K)\n    (b : F →L[ℂ] F) (hb : b ∈ finiteSpan) : FieldWeyl.W k * b ∈ finiteSpan := by\n  induction hb using Submodule.span_induction with\n  | mem b hb =>\n    obtain ⟨f,hf,rfl⟩ := hb\n    rw [FieldWeyl.W_ccr]\n    exact finiteSpan.smul_mem _ (generator_mem _ (K.add_mem hk hf))\n  | zero => simpa only [mul_zero] using finiteSpan.zero_mem\n  | add b c hb hc ihb ihc =>\n    rw [mul_add]; exact finiteSpan.add_mem ihb ihc\n  | smul c b hb ih =>\n    rw [mul_smul_comm]; exact finiteSpan.smul_mem c ih\ntheorem mul_mem (a b : F →L[ℂ] F) (ha : a ∈ finiteSpan) (hb : b ∈ finiteSpan) :\n    a*b ∈ finiteSpan := by\n  induction ha using Submodule.span_induction with\n  | mem a ha =>\n    obtain ⟨k,hk,rfl⟩ := ha\n    exact generator_mul_mem k hk b hb\n  | zero => simpa only [zero_mul] using finiteSpan.zero_mem\n  | add a c ha hc iha ihc =>\n    rw [add_mul]; exact finiteSpan.add_mem iha ihc\n  | smul c a ha ih =>\n    rw [smul_mul_assoc]; exact finiteSpan.smul_mem c ih\ntheorem star_mem (a : F →L[ℂ] F) (ha : a ∈ finiteSpan) : star a ∈ finiteSpan := by\n  induction ha using Submodule.span_induction with\n  | mem a ha =>\n    obtain ⟨k,hk,rfl⟩ := ha\n    rw [FieldWeyl.W_star]\n    exact generator_mem _ (K.neg_mem hk)\n  | zero => simpa only [star_zero (F →L[ℂ] F)] using finiteSpan.zero_mem\n  | add a b ha hb iha ihb =>\n    rw [StarAddMonoid.star_add a b]; exact finiteSpan.add_mem iha ihb\n  | smul c a ha ih =>\n    rw [star_smul]; exact finiteSpan.smul_mem (star c) ih\n\ndef finiteAlgebra : StarSubalgebra ℂ (F →L[ℂ] F) where\n  toSubalgebra := finiteSpan.toSubalgebra one_mem mul_mem\n  star_mem' := fun ha => star_mem _ ha\n\ntheorem finite_mem_R (a : F →L[ℂ] F) (ha : a ∈ finiteAlgebra) : a ∈ FieldWeyl.R K := by\n  have hs : finiteSpan ≤ (FieldWeyl.R K).toStarSubalgebra.toSubalgebra.toSubmodule := by\n    apply Submodule.span_le.mpr\n    rintro a ⟨k,hk,rfl⟩\n    exact FieldWeyl.W_mem_R K k hk\n  exact hs ha\n\ntheorem R_bicommutant_finite (a : F →L[ℂ] F) (ha : a ∈ FieldWeyl.R K) :\n    ∀ b : F →L[ℂ] F, (∀ c ∈ finiteAlgebra, b*c=c*b) → a*b=b*a := by\n  change a ∈ F1Fecho.WeylNet.generatedAlgebra (F1Fecho.WeylNet.generators FieldWeyl.W K) at ha\n  rw [← SetLike.mem_coe,F1Fecho.WeylNet.generatedAlgebra_coe _\n    (F1Fecho.WeylNet.generators_star_closed FieldWeyl.W FieldWeyl.W_star K)] at ha\n  intro b hb\n  apply (ha b ?_).symm\n  rintro c ⟨k,hk,rfl⟩\n  exact (hb _ (generator_mem k hk)).symm\n\ntheorem generator_graph (k : H1) (hk : k ∈ K) :\n    (FieldWeyl.W k vacuum,(star (FieldWeyl.W k)) vacuum) ∈\n      Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) := by\n  apply (Sexp_graph_iff _).mpr\n  have h : (exponential (Complex.I•k),exponential (Complex.I•Jcandidate k)) ∈ closedGraph TW :=\n    (coreGraph TW).le_topologicalClosure (weylCore_le_core (Submodule.subset_span ⟨⟨k,hk⟩,rfl⟩))\n  let q := amplitude (Complex.I•k) 0\n  have hout : JF ((star (FieldWeyl.W k)) vacuum) = q • exponential (Complex.I•Jcandidate k) := by\n    rw [FieldWeyl.W_star,FieldWeyl.W_vacuum]\n    change JF (amplitude (Complex.I•(-k)) 0 • exponential (Complex.I•(-k))) = _\n    rw [smul_neg,vacuum_amplitude_neg,JF.map_smulₛₗ]\n    change star q • JF (exponential (-(Complex.I•k))) = _\n    rw [vacuum_amplitude_star,JF_exponential,map_neg,Jcandidate.map_smulₛₗ]\n    simp only [Complex.conj_I,neg_smul,neg_neg]\n    rfl\n  rw [hout,FieldWeyl.W_vacuum]\n  exact (closedGraph TW).smul_mem q h\n\ntheorem finite_algebra_graph (a : F →L[ℂ] F) (ha : a ∈ finiteAlgebra) :\n    (a vacuum,(star a) vacuum) ∈\n      Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) := by\n  change a ∈ finiteSpan at ha\n  induction ha using Submodule.span_induction with\n  | mem a ha =>\n    obtain ⟨k,hk,rfl⟩ := ha\n    exact generator_graph k hk\n  | zero =>\n    refine ⟨0,?_⟩\n    simp only [ZeroMemClass.coe_zero,map_zero,star_zero (F →L[ℂ] F),ContinuousLinearMap.zero_apply]\n  | add a b ha hb iha ihb =>\n    obtain ⟨x,hx⟩ := iha\n    obtain ⟨y,hy⟩ := ihb\n    refine ⟨x+y,?_⟩\n    have h1 : (x:F)=a vacuum := congrArg Prod.fst hx\n    have h2 : Sexp x=(star a) vacuum := congrArg Prod.snd hx\n    have h3 : (y:F)=b vacuum := congrArg Prod.fst hy\n    have h4 : Sexp y=(star b) vacuum := congrArg Prod.snd hy\n    apply Prod.ext\n    · change (x:F)+(y:F) = _\n      rw [h1,h3]; rfl\n    · change Sexp (x+y) = (star (a+b)) vacuum\n      rw [map_add,h2,h4,StarAddMonoid.star_add a b]\n      rfl\n  | smul c a ha ih =>\n    obtain ⟨x,hx⟩ := ih\n    refine ⟨c•x,?_⟩\n    have h1 : (x:F)=a vacuum := congrArg Prod.fst hx\n    have h2 : Sexp x=(star a) vacuum := congrArg Prod.snd hx\n    apply Prod.ext\n    · change c•(x:F) = _\n      rw [h1]; rfl\n    · change Sexp (c•x) = (star (c•a)) vacuum\n      rw [Sexp.map_smulₛₗ,h2,star_smul]\n      rfl\n\ntheorem R_two_vector_density (a : F →L[ℂ] F) (ha : a ∈ FieldWeyl.R K) (x y : F) :\n    (a x,a y) ∈ closure {p : F × F | ∃ b ∈ finiteAlgebra, p=(b x,b y)} :=\n  BicommutantTwoVector.two_vector_density finiteAlgebra a (R_bicommutant_finite a ha) x y\n\nend F1Fecho.WeylFiniteAlgebra\n#print axioms F1Fecho.WeylFiniteAlgebra.mul_mem\n#print axioms F1Fecho.WeylFiniteAlgebra.star_mem\n#print axioms F1Fecho.WeylFiniteAlgebra.finite_mem_R\n#print axioms F1Fecho.WeylFiniteAlgebra.R_bicommutant_finite\n#print axioms F1Fecho.WeylFiniteAlgebra.generator_graph\n#print axioms F1Fecho.WeylFiniteAlgebra.finite_algebra_graph\n#print axioms F1Fecho.WeylFiniteAlgebra.R_two_vector_density\n",
+    'TGLExt/F1Fecho394/CanonicalWeylKMSFiniteR2.lean': 'import TGLExt.F1Fecho394.WedgeOneParticleStripR2\nimport TGLExt.F1Fecho394.WeylStripFromCoefficientR3\nimport TGLExt.F1Fecho394.WeylFiniteAlgebraR4\n/-! KMS is proved for the actual field-Weyl generators and their complex\nfinite span in the same Fock space. The one-particle continuation is derived\nfrom the canonical multiplier and standard wedge, not assumed in this output.\nExtension to the von Neumann closure is a separate graph-density argument. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nnamespace F1Fecho.CanonicalWeylKMSFinite\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.WeylExponentialCore F1Fecho.WeylFiniteAlgebra\n\ndef boostFlow (t : ℝ) : F ≃ₗᵢ[ℂ] F := gamma (B0 (2*Real.pi*t))\n\ntheorem generator_pair (f g : H1) (hf : f ∈ K) (hg : g ∈ K) :\n    KMSFiniteSpan.Pair vacuum boostFlow (FieldWeyl.W f) (FieldWeyl.W g) := by\n  have hs := WedgeOneParticleStrip.wedge_strip\n    (⟨f,hf⟩ : KWR.toClosedSubmodule) (⟨g,hg⟩ : KWR.toClosedSubmodule)\n  apply WeylStripFromCoefficient.pair_from_coefficient\n    (fun t => B0 (2*Real.pi*t)) f g (CanonicalH1Strip.coefficient f g)\n  · exact hs.1\n  · exact hs.2.1\n  · exact hs.2.2.1\n  · intro t\n    simpa only [mul_neg] using hs.2.2.2 t\n\ntheorem finite_pair (A B : F →L[ℂ] F)\n    (hA : A ∈ finiteAlgebra) (hB : B ∈ finiteAlgebra) :\n    KMSFiniteSpan.Pair vacuum boostFlow A B := by\n  apply KMSFiniteSpan.span_pair (F1Fecho.WeylNet.generators FieldWeyl.W K)\n    (A := A) (B := B) (hA := hA) (hB := hB)\n  rintro _ ⟨f,hf,rfl⟩ _ ⟨g,hg,rfl⟩\n  exact generator_pair f g hf hg\n\nend F1Fecho.CanonicalWeylKMSFinite\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    if (`F1Fecho.CanonicalWeylKMSFinite).isPrefixOf n then\n      let axs ← collectAxioms n\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\n      match ci with\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n      | _ => pure ()\n',
+    'TGLExt/F1Fecho394/StripMaximumR2.lean': "import Mathlib.Analysis.Complex.Hadamard\nimport Mathlib.Analysis.Complex.LocallyUniformLimit\nimport Mathlib.Tactic\n/-! A common bound on both horizontal edges controls the whole closed strip.\nThe global boundedness premise is essential to the three-lines argument. -/\nset_option autoImplicit false\nnoncomputable section\nopen Complex Complex.HadamardThreeLines Set\nnamespace F1Fecho.StripMaximum\n\ndef strip : Set ℂ := {z | 0<z.im ∧ z.im<1}\ndef closedStrip : Set ℂ := {z | 0≤z.im ∧ z.im≤1}\n\ntheorem norm_le_edge_bound {f : ℂ→ℂ} {C : ℝ} (hC : 0≤C)\n    (hd : DiffContOnCl ℂ f strip)\n    (hbound : ∃ M : ℝ, ∀ z ∈ closedStrip, ‖f z‖≤M)\n    (hleft : ∀ z : ℂ, z.im=0 → ‖f z‖≤C)\n    (hright : ∀ z : ℂ, z.im=1 → ‖f z‖≤C)\n    {z : ℂ} (hz : z∈closedStrip) : ‖f z‖≤C := by\n  let g : ℂ→ℂ := fun w => f (I*w)\n  have hdg : DiffContOnCl ℂ g (verticalStrip 0 1) := by\n    apply hd.comp (differentiable_id.const_mul I).diffContOnCl\n    intro w hw\n    simpa [strip,verticalStrip,mul_im] using hw\n  have hbg : BddAbove ((norm ∘ g) '' verticalClosedStrip 0 1) := by\n    obtain ⟨M,hM⟩ := hbound\n    refine ⟨M,?_⟩\n    rintro a ⟨w,hw,rfl⟩\n    exact hM (I*w) (by simpa [closedStrip,verticalClosedStrip] using hw)\n  have hn := norm_le_interp_of_mem_verticalClosedStrip' (f:=g)\n    (a:=C) (b:=C) (by norm_num : (0:ℝ)<1)\n    (z:=-I*z) (by simpa [verticalClosedStrip,closedStrip] using hz) hdg hbg\n    (fun w hw => hleft (I*w) (by simpa using hw))\n    (fun w hw => hright (I*w) (by simpa using hw))\n  have hp (x : ℝ) : C^(1-x)*C^x=C := by\n    rw [← Real.rpow_add' hC (by ring_nf; norm_num : 1-x+x≠0)]\n    simp\n  have hzid : I * (-I*z)=z := by rw [←mul_assoc]; simp\n  dsimp only [g] at hn\n  rw [hzid] at hn\n  simpa only [sub_zero,div_one,hp] using hn\n\nend F1Fecho.StripMaximum\n#print axioms F1Fecho.StripMaximum.norm_le_edge_bound\n",
+    'TGLExt/F1Fecho394/StripUniformLimitR2.lean': "import TGLExt.F1Fecho394.StripMaximumR2\nimport Mathlib.Topology.MetricSpace.Cauchy\n/-! Boundary Cauchy estimates yield an analytic bounded strip limit. This\nis a closure lemma for later use with actual joint algebra/adjoint vectors. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1000000\nnoncomputable section\nopen Filter Set\nopen scoped Topology\nnamespace F1Fecho.StripUniformLimit\nopen F1Fecho.StripMaximum\n\ntheorem closure_strip_subset : closure strip ⊆ closedStrip := by\n  apply closure_minimal\n  · intro z hz; exact ⟨hz.1.le,hz.2.le⟩\n  · exact (isClosed_le continuous_const Complex.continuous_im).inter\n      (isClosed_le Complex.continuous_im continuous_const)\n\ntheorem strip_open : IsOpen strip :=\n  (isOpen_lt continuous_const Complex.continuous_im).inter\n    (isOpen_lt Complex.continuous_im continuous_const)\n\ntheorem cauchy_of_edges (F : ℕ→ℂ→ℂ)\n    (hd : ∀ n, DiffContOnCl ℂ (F n) strip)\n    (hb : ∀ n, ∃ M : ℝ, ∀ z∈closedStrip, ‖F n z‖≤M)\n    (hedge : ∀ ε>0, ∃ N : ℕ, ∀ m≥N, ∀ n≥N,\n      ∀ z : ℂ, (z.im=0 ∨ z.im=1) → ‖F m z-F n z‖≤ε) :\n    UniformCauchySeqOn F atTop closedStrip := by\n  apply Metric.uniformCauchySeqOn_iff.mpr\n  intro ε hε\n  obtain ⟨N,hN⟩ := hedge (ε/2) (by positivity)\n  refine ⟨N,fun m hm n hn z hz => ?_⟩\n  have hd' := (hd m).sub (hd n)\n  have hb' : ∃ M : ℝ, ∀ z∈closedStrip, ‖F m z-F n z‖≤M := by\n    obtain ⟨M,hM⟩ := hb m\n    obtain ⟨L,hL⟩ := hb n\n    exact ⟨M+L,fun z hz => (norm_sub_le _ _).trans (add_le_add (hM z hz) (hL z hz))⟩\n  have he := norm_le_edge_bound (f:=fun z => F m z-F n z) (C:=ε/2)\n    (by positivity) hd' hb'\n    (fun z hz => hN m hm n hn z (Or.inl hz))\n    (fun z hz => hN m hm n hn z (Or.inr hz)) hz\n  rw [dist_eq_norm]\n  exact he.trans_lt (by linarith)\n\ntheorem exists_limit (F : ℕ→ℂ→ℂ)\n    (hd : ∀ n, DiffContOnCl ℂ (F n) strip)\n    (hb : ∀ n, ∃ M : ℝ, ∀ z∈closedStrip, ‖F n z‖≤M)\n    (hc : UniformCauchySeqOn F atTop closedStrip) :\n    ∃ f : ℂ→ℂ, TendstoUniformlyOn F f atTop closedStrip ∧\n      DiffContOnCl ℂ f strip ∧ (∃ M : ℝ, ∀ z∈closedStrip, ‖f z‖≤M) := by\n  classical\n  have hex (z : ℂ) (hz : z∈closedStrip) : ∃ a : ℂ, Tendsto (fun n => F n z) atTop (𝓝 a) :=\n    cauchySeq_tendsto_of_complete (hc.cauchySeq hz)\n  let f : ℂ→ℂ := fun z => if hz : z∈closedStrip then (hex z hz).choose else 0\n  have ht : TendstoUniformlyOn F f atTop closedStrip := by\n    apply hc.tendstoUniformlyOn_of_tendsto\n    intro z hz\n    simpa only [f,dif_pos hz] using (hex z hz).choose_spec\n  have htc := ht.mono closure_strip_subset\n  have hdf : DiffContOnCl ℂ f strip :=\n    ⟨(ht.mono (fun z hz => ⟨hz.1.le,hz.2.le⟩)).tendstoLocallyUniformlyOn.differentiableOn\n      (Eventually.of_forall fun n => (hd n).differentiableOn) strip_open,\n     htc.continuousOn (Filter.Eventually.frequently (Eventually.of_forall fun n => (hd n).continuousOn))⟩\n  have he := Metric.tendstoUniformlyOn_iff.mp ht 1 (by norm_num)\n  obtain ⟨n,hn⟩ := he.exists\n  obtain ⟨M,hM⟩ := hb n\n  refine ⟨f,ht,hdf,M+1,fun z hz => ?_⟩\n  have hz' := hn z hz\n  have hn' : ‖f z-F n z‖<1 := by simpa only [dist_eq_norm] using hz'\n  calc\n    ‖f z‖ ≤ ‖f z-F n z‖+‖F n z‖ := norm_le_norm_sub_add _ _\n    _ ≤ M+1 := by linarith [hM z hz]\n\nend F1Fecho.StripUniformLimit\n#print axioms F1Fecho.StripUniformLimit.cauchy_of_edges\n#print axioms F1Fecho.StripUniformLimit.exists_limit\n",
+    'TGLExt/F1Fecho394/StripBoundaryLimitR1.lean': 'import TGLExt.F1Fecho394.StripUniformLimitR2\n/-! Convergence on both real boundary lines determines a bounded analytic\nlimit throughout the strip. Used with graph-vector convergence, not with an\nassumed bound on approximating algebra operators. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Filter Set\nopen scoped Topology\nnamespace F1Fecho.StripBoundaryLimit\nopen F1Fecho.StripMaximum F1Fecho.StripUniformLimit\n\ntheorem of_boundary_uniform (F : ℕ→ℂ→ℂ) (L U : ℝ→ℂ)\n    (hd : ∀ n, DiffContOnCl ℂ (F n) strip)\n    (hb : ∀ n, ∃ M : ℝ, ∀ z∈closedStrip, ‖F n z‖≤M)\n    (hL : TendstoUniformlyOn (fun (n : ℕ) (t : ℝ) => F n t) L atTop univ)\n    (hU : TendstoUniformlyOn (fun (n : ℕ) (t : ℝ) => F n ((t:ℂ)+Complex.I)) U atTop univ) :\n    ∃ f : ℂ→ℂ, DiffContOnCl ℂ f strip ∧\n      (∃ M : ℝ, ∀ z∈closedStrip, ‖f z‖≤M) ∧\n      (∀ t : ℝ, f t=L t) ∧ (∀ t : ℝ, f ((t:ℂ)+Complex.I)=U t) := by\n  have hc : UniformCauchySeqOn F atTop closedStrip := by\n    apply cauchy_of_edges F hd hb\n    intro ε hε\n    obtain ⟨NL,hNL⟩ := Metric.uniformCauchySeqOn_iff.mp hL.uniformCauchySeqOn ε hε\n    obtain ⟨NU,hNU⟩ := Metric.uniformCauchySeqOn_iff.mp hU.uniformCauchySeqOn ε hε\n    refine ⟨max NL NU,fun m hm n hn z hz => ?_⟩\n    rcases hz with hz|hz\n    · have he : (z.re:ℂ)=z := by apply Complex.ext <;> simp [hz]\n      have h := hNL m (le_trans (le_max_left _ _) hm) n (le_trans (le_max_left _ _) hn) z.re (mem_univ _)\n      simpa only [he,dist_eq_norm] using h.le\n    · have he : (z.re:ℂ)+Complex.I=z := by apply Complex.ext <;> simp [hz]\n      have h := hNU m (le_trans (le_max_right _ _) hm) n (le_trans (le_max_right _ _) hn) z.re (mem_univ _)\n      simpa only [he,dist_eq_norm] using h.le\n  obtain ⟨f,ht,hf,hfb⟩ := exists_limit F hd hb hc\n  refine ⟨f,hf,hfb,?_,?_⟩\n  · intro t\n    exact tendsto_nhds_unique (ht.tendsto_at (by simp [closedStrip])) (hL.tendsto_at (mem_univ t))\n  · intro t\n    exact tendsto_nhds_unique (ht.tendsto_at (by simp [closedStrip])) (hU.tendsto_at (mem_univ t))\n\nend F1Fecho.StripBoundaryLimit\n#print axioms F1Fecho.StripBoundaryLimit.of_boundary_uniform\n',
+    'TGLExt/F1Fecho394/UnitaryCoefficientsUniformR2.lean': 'import Mathlib.Analysis.InnerProductSpace.LinearMap\nimport Mathlib.Topology.MetricSpace.UniformConvergence\nimport Mathlib.Tactic\nset_option autoImplicit false\nnoncomputable section\nopen Filter Set\nopen scoped Topology\nnamespace F1Fecho.UnitaryCoefficientsUniform\nvariable {H X : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n\ntheorem left (U : X→H≃ₗᵢ[ℂ]H) (v : H) (u : ℕ→H) (x : H)\n    (hu : Tendsto u atTop (𝓝 x)) :\n    TendstoUniformlyOn (fun n t => inner ℂ (u n) (U t v))\n      (fun t => inner ℂ x (U t v)) atTop univ := by\n  apply Metric.tendstoUniformlyOn_iff.mpr\n  intro ε hε\n  have ht : Tendsto (fun n => ‖u n-x‖*‖v‖) atTop (𝓝 0) := by\n    simpa using (hu.sub (tendsto_const_nhds (x:=x))).norm.mul_const ‖v‖\n  filter_upwards [ht.eventually (gt_mem_nhds hε)] with n hn\n  intro t _\n  rw [dist_comm,dist_eq_norm,← inner_sub_left]\n  have hb : ‖inner ℂ (u n-x) (U t v)‖ ≤ ‖u n-x‖*‖v‖ := by\n    simpa only [(U t).norm_map] using (norm_inner_le_norm (𝕜:=ℂ) (u n-x) (U t v))\n  exact hb.trans_lt hn\n\ntheorem right (U : X→H≃ₗᵢ[ℂ]H) (v : H) (u : ℕ→H) (x : H)\n    (hu : Tendsto u atTop (𝓝 x)) :\n    TendstoUniformlyOn (fun n t => inner ℂ v (U t (u n)))\n      (fun t => inner ℂ v (U t x)) atTop univ := by\n  apply Metric.tendstoUniformlyOn_iff.mpr\n  intro ε hε\n  have ht : Tendsto (fun n => ‖v‖*‖u n-x‖) atTop (𝓝 0) := by\n    simpa using (hu.sub (tendsto_const_nhds (x:=x))).norm.const_mul ‖v‖\n  filter_upwards [ht.eventually (gt_mem_nhds hε)] with n hn\n  intro t _\n  rw [dist_comm,dist_eq_norm,← inner_sub_right,← map_sub]\n  have hb : ‖inner ℂ v (U t (u n-x))‖ ≤ ‖v‖*‖u n-x‖ := by\n    simpa only [(U t).norm_map] using (norm_inner_le_norm (𝕜:=ℂ) v (U t (u n-x)))\n  exact hb.trans_lt hn\n\nend F1Fecho.UnitaryCoefficientsUniform\n#print axioms F1Fecho.UnitaryCoefficientsUniform.left\n#print axioms F1Fecho.UnitaryCoefficientsUniform.right\n',
+    'TGLExt/F1Fecho394/KMSGraphClosureR3.lean': 'import TGLExt.F1Fecho394.StripBoundaryLimitR1\nimport TGLExt.F1Fecho394.UnitaryCoefficientsUniformR2\n/-! The bounded KMS strip relation is closed in the graph vectors\n(A Omega,A* Omega), separately in each algebra argument. Thus joint strong-star\nvacuum density is sufficient; no operator-norm approximation is assumed. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Filter Set\nopen scoped Topology\nnamespace F1Fecho.KMSGraphClosure\nopen F1Fecho.StripMaximum F1Fecho.StripBoundaryLimit\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n\ndef Pair (α : ℝ→H≃ₗᵢ[ℂ]H) (x y : H×H) : Prop :=\n  ∃ G : ℂ→ℂ, DiffContOnCl ℂ G strip ∧\n    (∃ C : ℝ, ∀ z∈closedStrip, ‖G z‖≤C) ∧\n    (∀ t : ℝ, G t=inner ℂ x.2 (α t y.1)) ∧\n    (∀ t : ℝ, G ((t:ℂ)+Complex.I)=inner ℂ y.2 (α (-t) x.1))\n\ntheorem closed_left (α : ℝ→H≃ₗᵢ[ℂ]H) (y : H×H) :\n    IsClosed {x : H×H | Pair α x y} := by\n  apply isSeqClosed_iff_isClosed.mp\n  intro u x hu hx\n  choose F hd hb hl ht using hu\n  have hL := UnitaryCoefficientsUniform.left α y.1 (fun n => (u n).2) x.2 ((continuous_snd.tendsto x).comp hx)\n  have hU := UnitaryCoefficientsUniform.right (fun t => α (-t)) y.2 (fun n => (u n).1) x.1 ((continuous_fst.tendsto x).comp hx)\n  have hle : (fun (n : ℕ) (t : ℝ) => F n t) =\n      (fun n t => inner ℂ (u n).2 (α t y.1)) := by funext n t; exact hl n t\n  have hue : (fun (n : ℕ) (t : ℝ) => F n ((t:ℂ)+Complex.I)) =\n      (fun n t => inner ℂ y.2 (α (-t) (u n).1)) := by funext n t; exact ht n t\n  rw [←hle] at hL\n  rw [←hue] at hU\n  exact of_boundary_uniform F _ _ hd hb hL hU\n\ntheorem closed_right (α : ℝ→H≃ₗᵢ[ℂ]H) (x : H×H) :\n    IsClosed {y : H×H | Pair α x y} := by\n  apply isSeqClosed_iff_isClosed.mp\n  intro u y hu hy\n  choose F hd hb hl ht using hu\n  have hL := UnitaryCoefficientsUniform.right α x.2 (fun n => (u n).1) y.1 ((continuous_fst.tendsto y).comp hy)\n  have hU := UnitaryCoefficientsUniform.left (fun t => α (-t)) x.1 (fun n => (u n).2) y.2 ((continuous_snd.tendsto y).comp hy)\n  have hle : (fun (n : ℕ) (t : ℝ) => F n t) =\n      (fun n t => inner ℂ x.2 (α t (u n).1)) := by funext n t; exact hl n t\n  have hue : (fun (n : ℕ) (t : ℝ) => F n ((t:ℂ)+Complex.I)) =\n      (fun n t => inner ℂ (u n).2 (α (-t) x.1)) := by funext n t; exact ht n t\n  rw [←hle] at hL\n  rw [←hue] at hU\n  exact of_boundary_uniform F _ _ hd hb hL hU\n\ntheorem of_dense_pairs (α : ℝ→H≃ₗᵢ[ℂ]H) (S : Set (H×H))\n    (h : ∀ x∈S, ∀ y∈S, Pair α x y)\n    (x y : H×H) (hx : x∈closure S) (hy : y∈closure S) : Pair α x y := by\n  have hfirst : ∀ a∈S, Pair α a y := by\n    intro a ha\n    exact (closed_right α a).closure_subset_iff.mpr (h a ha) hy\n  exact (closed_left α y).closure_subset_iff.mpr hfirst hx\n\nend F1Fecho.KMSGraphClosure\n#print axioms F1Fecho.KMSGraphClosure.closed_left\n#print axioms F1Fecho.KMSGraphClosure.closed_right\n#print axioms F1Fecho.KMSGraphClosure.of_dense_pairs\n',
+    'TGLExt/F1Fecho394/StarGraphDensityR3.lean': "import Mathlib.Analysis.InnerProductSpace.Adjoint\nimport Mathlib.Analysis.InnerProductSpace.Dual\nimport Mathlib.Algebra.Star.Subalgebra\nimport Mathlib.Analysis.LocallyConvex.SeparatingDual\nimport Mathlib.Analysis.Normed.Group.Quotient\nimport Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Quotient\n/-! Real graph closure of an algebra-vector pair from simultaneous two-vector\napproximation. The two-vector premise remains explicit here; a separate\nbicommutant theorem must discharge it. No equality of Tomita operators is\nasserted by this generic module. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Filter Topology\nnamespace F1Fecho.StarGraphDensity\n\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nlocal instance : InnerProductSpace ℝ H := InnerProductSpace.rclikeToReal ℂ H\n\ndef starGraph (A : StarSubalgebra ℂ (H →L[ℂ] H)) (Ω : H) : Submodule ℝ (H × H) where\n  carrier := {p | ∃ b ∈ A, p = (b Ω, (star b) Ω)}\n  zero_mem' := by\n    refine ⟨0,A.zero_mem,?_⟩\n    simp only [star_zero,ContinuousLinearMap.zero_apply]\n    rfl\n  add_mem' := by\n    rintro p q ⟨b,hb,rfl⟩ ⟨c,hc,rfl⟩\n    refine ⟨b+c,A.add_mem hb hc,?_⟩\n    simp\n  smul_mem' := by\n    rintro t p ⟨b,hb,rfl⟩\n    refine ⟨(t:ℂ) • b,A.smul_mem hb (t:ℂ),?_⟩\n    change ((t:ℂ) • b Ω,(t:ℂ) • (star b) Ω) = _\n    simp\n\ntheorem mem_starGraph (A : StarSubalgebra ℂ (H →L[ℂ] H)) (Ω : H) (p : H × H) :\n    p ∈ starGraph A Ω ↔ ∃ b ∈ A, p = (b Ω,(star b) Ω) := Iff.rfl\n\nprivate theorem mem_closed_of_real_functionals {E : Type*}\n    [NormedAddCommGroup E] [NormedSpace ℝ E]\n    (L : Submodule ℝ E) (hL : IsClosed (L : Set E)) (x : E)\n    (hx : ∀ l : E →L[ℝ] ℝ, (∀ y ∈ L, l y = 0) → l x = 0) : x ∈ L := by\n  letI : IsClosed (L : Set E) := hL\n  by_contra hn\n  have hq : L.mkQL x ≠ 0 := by\n    intro h\n    exact hn ((Submodule.Quotient.mk_eq_zero L).mp h)\n  obtain ⟨l,hl⟩ := SeparatingDual.exists_ne_zero (R := ℝ) hq\n  apply hl\n  apply hx (l.comp L.mkQL)\n  intro y hy\n  change l (L.mkQL y) = 0\n  have h : L.mkQL y = 0 := (Submodule.Quotient.mk_eq_zero L).mpr hy\n  rw [h,map_zero]\n\nprivate theorem real_functional_pair (l : (H × H) →L[ℝ] ℝ) :\n    ∃ v w : H, ∀ x y : H, l (x,y) = inner ℝ v x + inner ℝ w y := by\n  let v := (InnerProductSpace.toDual ℝ H).symm (l.comp (ContinuousLinearMap.inl ℝ H H))\n  let w := (InnerProductSpace.toDual ℝ H).symm (l.comp (ContinuousLinearMap.inr ℝ H H))\n  refine ⟨v,w,?_⟩\n  intro x y\n  change l (x,y) = inner ℝ ((InnerProductSpace.toDual ℝ H).symm _) x +\n    inner ℝ ((InnerProductSpace.toDual ℝ H).symm _) y\n  rw [InnerProductSpace.toDual_symm_apply,InnerProductSpace.toDual_symm_apply]\n  change l (x,y) = l (x,0) + l (0,y)\n  rw [← map_add]\n  congr 1\n  exact Prod.ext (add_zero x).symm (zero_add y).symm\n\ntheorem real_inner_star_swap (b : H →L[ℂ] H) (Ω w : H) :\n    inner ℝ w ((star b) Ω) = inner ℝ Ω (b w) := by\n  change (inner ℂ w ((star b) Ω)).re = (inner ℂ Ω (b w)).re\n  rw [ContinuousLinearMap.star_eq_adjoint,ContinuousLinearMap.adjoint_inner_right]\n  exact inner_re_symm (𝕜 := ℂ) (b w) Ω\n\n/-- Density is required only for the simultaneous images of two vectors.\nThe conclusion is closure in the real graph topology on both coordinates. -/\ntheorem star_pair_mem_real_closure_of_two_vector_density\n    (A : StarSubalgebra ℂ (H →L[ℂ] H)) (a : H →L[ℂ] H) (Ω : H)\n    (h_two : ∀ x y : H, (a x,a y) ∈\n      closure {p : H × H | ∃ b ∈ A, p = (b x,b y)}) :\n    (a Ω,(star a) Ω) ∈ (starGraph A Ω).topologicalClosure := by\n  apply mem_closed_of_real_functionals _ (starGraph A Ω).isClosed_topologicalClosure\n  intro l hl\n  obtain ⟨v,w,hvw⟩ := real_functional_pair l\n  let g : H × H → ℝ := fun p => inner ℝ v p.1 + inner ℝ Ω p.2\n  have hg : Continuous g := by fun_prop\n  have hzero : ∀ b ∈ A, g (b Ω,b w) = 0 := by\n    intro b hb\n    have h := hl (b Ω,(star b) Ω) ((starGraph A Ω).le_topologicalClosure ⟨b,hb,rfl⟩)\n    rw [hvw,real_inner_star_swap] at h\n    exact h\n  have hcl : closure {p : H × H | ∃ b ∈ A, p = (b Ω,b w)} ⊆ {p | g p = 0} := by\n    apply closure_minimal\n    · rintro p ⟨b,hb,rfl⟩\n      exact hzero b hb\n    · exact isClosed_eq hg continuous_const\n  have ha := hcl (h_two Ω w)\n  rw [hvw,real_inner_star_swap]\n  exact ha\n\ntheorem star_pair_mem_set_closure_of_two_vector_density\n    (A : StarSubalgebra ℂ (H →L[ℂ] H)) (a : H →L[ℂ] H) (Ω : H)\n    (h_two : ∀ x y : H, (a x,a y) ∈\n      closure {p : H × H | ∃ b ∈ A, p = (b x,b y)}) :\n    (a Ω,(star a) Ω) ∈ closure {p : H × H | ∃ b ∈ A, p = (b Ω,(star b) Ω)} := by\n  have h := star_pair_mem_real_closure_of_two_vector_density A a Ω h_two\n  change (a Ω,(star a) Ω) ∈ (starGraph A Ω).topologicalClosure at h\n  change (a Ω,(star a) Ω) ∈ closure (starGraph A Ω : Set (H × H))\n  rw [← Submodule.topologicalClosure_coe]\n  exact h\n\nend F1Fecho.StarGraphDensity\n#print axioms F1Fecho.StarGraphDensity.star_pair_mem_real_closure_of_two_vector_density\n#print axioms F1Fecho.StarGraphDensity.star_pair_mem_set_closure_of_two_vector_density\n",
+    'TGLExt/F1Fecho394/BicommutantStarGraphR1.lean': 'import TGLExt.F1Fecho394.StarGraphDensityR3\nimport TGLExt.F1Fecho394.BicommutantTwoVectorR2\n/-! The two-vector premise is discharged by the finite-amplification theorem.\nThe remaining premise is explicit membership in the operator bicommutant.\nThis module does not assert a Tomita identification for a concrete Fock net. -/\nset_option autoImplicit false\nnoncomputable section\nopen Filter Topology\nnamespace F1Fecho.StarGraphDensity\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nlocal instance : InnerProductSpace ℝ H := InnerProductSpace.rclikeToReal ℂ H\n\ntheorem star_pair_mem_real_closure_of_bicommutant\n    (A : StarSubalgebra ℂ (H →L[ℂ] H)) (a : H →L[ℂ] H) (Ω : H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A,b*c=c*b) → a*b=b*a) :\n    (a Ω,(star a) Ω) ∈ (starGraph A Ω).topologicalClosure :=\n  star_pair_mem_real_closure_of_two_vector_density A a Ω\n    (fun x y => BicommutantTwoVector.two_vector_density A a ha x y)\n\ntheorem star_pair_mem_set_closure_of_bicommutant\n    (A : StarSubalgebra ℂ (H →L[ℂ] H)) (a : H →L[ℂ] H) (Ω : H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A,b*c=c*b) → a*b=b*a) :\n    (a Ω,(star a) Ω) ∈ closure {p : H × H | ∃ b ∈ A,p=(b Ω,(star b) Ω)} :=\n  star_pair_mem_set_closure_of_two_vector_density A a Ω\n    (fun x y => BicommutantTwoVector.two_vector_density A a ha x y)\n\n/-- Any closed real graph containing the algebra-vector pairs also contains\nthe bicommutant-vector pair. No boundedness of the approximating operators is\nclaimed; the topology controls the two graph coordinates. -/\ntheorem closed_real_submodule_contains_bicommutant_pair\n    (A : StarSubalgebra ℂ (H →L[ℂ] H)) (a : H →L[ℂ] H) (Ω : H)\n    (ha : ∀ b : H →L[ℂ] H, (∀ c ∈ A,b*c=c*b) → a*b=b*a)\n    (L : Submodule ℝ (H × H)) (hL : IsClosed (L : Set (H × H)))\n    (hA : ∀ b ∈ A,(b Ω,(star b) Ω) ∈ L) : (a Ω,(star a) Ω) ∈ L := by\n  have h := star_pair_mem_set_closure_of_bicommutant A a Ω ha\n  apply (closure_minimal (t := (L : Set (H × H))) ?_ hL) h\n  rintro p ⟨b,hb,rfl⟩\n  exact hA b hb\n\nend F1Fecho.StarGraphDensity\n#print axioms F1Fecho.StarGraphDensity.star_pair_mem_real_closure_of_bicommutant\n#print axioms F1Fecho.StarGraphDensity.star_pair_mem_set_closure_of_bicommutant\n#print axioms F1Fecho.StarGraphDensity.closed_real_submodule_contains_bicommutant_pair\n',
+    'TGLExt/F1Fecho394/CanonicalWedgeKMSR4.lean': 'import TGLExt.F1Fecho394.CanonicalWeylKMSFiniteR2\nimport TGLExt.F1Fecho394.KMSGraphClosureR3\nimport TGLExt.F1Fecho394.BicommutantStarGraphR1\n/-! The actual bounded KMS condition on the von Neumann wedge algebra.\nFinite Weyl sums supply analytic strips. Proved joint approximation of A Omega\nand A* Omega, plus the strip maximum theorem, supplies the full closure.\nThe physical KMS flow is Gamma(B0(+2*pi*t)); the modular CFC convention has\nnegative sign. No Fock KMS or analytic-domain premise is assumed. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nnamespace F1Fecho.CanonicalWedgeKMS\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.WeylExponentialCore F1Fecho.WeylFiniteAlgebra\nopen F1Fecho.CanonicalWeylKMSFinite\n\ndef finitePairs : Set (F×F) :=\n  {p | ∃ A∈finiteAlgebra,p=(A vacuum,(star A) vacuum)}\n\ntheorem finite_pair_graph (x y : F×F) (hx : x∈finitePairs) (hy : y∈finitePairs) :\n    KMSGraphClosure.Pair boostFlow x y := by\n  obtain ⟨A,hA,rfl⟩ := hx\n  obtain ⟨B,hB,rfl⟩ := hy\n  obtain ⟨G,hd,⟨C,hC⟩,hl,hu⟩ := finite_pair A B hA hB\n  exact ⟨G,hd,⟨C,fun z hz => hC z hz.1 hz.2⟩,hl,hu⟩\n\ntheorem pair_mem_closure (A : F→L[ℂ]F) (hA : A∈FieldWeyl.R K) :\n    (A vacuum,(star A) vacuum)∈closure finitePairs :=\n  StarGraphDensity.star_pair_mem_set_closure_of_bicommutant finiteAlgebra A vacuum\n    (R_bicommutant_finite A hA)\n\ntheorem canonical_bw_kms :\n    KMSBody (FieldWeyl.R KWR.toClosedSubmodule.toSubmodule) vacuum\n      (fun t => gamma (B0 (2*Real.pi*t))) 1 := by\n  intro A hA B hB\n  have hp := KMSGraphClosure.of_dense_pairs boostFlow finitePairs\n    (fun x hx y hy => finite_pair_graph x y hx hy)\n    (A vacuum,(star A) vacuum) (B vacuum,(star B) vacuum)\n    (pair_mem_closure A hA) (pair_mem_closure B hB)\n  obtain ⟨G,hd,⟨C,hC⟩,hl,hu⟩ := hp\n  refine ⟨G,hd,⟨C,fun z h0 h1 => hC z ⟨h0,h1⟩⟩,hl,?_⟩\n  intro t\n  simpa only [Complex.ofReal_one,one_mul,boostFlow] using hu t\n\nend F1Fecho.CanonicalWedgeKMS\n#print axioms F1Fecho.CanonicalWedgeKMS.finite_pair_graph\n#print axioms F1Fecho.CanonicalWedgeKMS.pair_mem_closure\n#print axioms F1Fecho.CanonicalWedgeKMS.canonical_bw_kms\n',
+    'TGLExt/F1Fecho394/GammaGraphParametersR3.lean': 'import TGLExt.F1Fecho394.BoundedGammaPropertiesR2\nimport TGLExt.F1Fecho394.ExponentialLiftR2\n/-! Concrete bounded graph parameters for the unbounded canonical Fock lift.\nThe one-particle square-sum identity is used only to bound WA and WB. Its\nsecond-quantized analogue is NOT assumed and is not generally true. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1800000\nnoncomputable section\nopen scoped InnerProductSpace\nnamespace F1Fecho.GammaGraph\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.Exponential F1Fecho.ExponentialLift F1Fecho.BoundedGamma\nopen ChatgptAudit.Continuous049\n\ntheorem WAB_norm_sq (c : ℝ) (f : H1) : ‖WA c f‖^2 + ‖WB c f‖^2 = ‖f‖^2 := by\n  have h := congrArg (fun L : H1 →L[ℂ] H1 => inner ℂ f (L f)) (WAB_square_sum c)\n  simp only [ContinuousLinearMap.add_apply,ContinuousLinearMap.mul_apply,\n    ContinuousLinearMap.one_apply,inner_add_right] at h\n  have ha : inner ℂ (WA c f) (WA c f) = inner ℂ f (WA c (WA c f)) :=\n    (WA_selfadjoint c).isSymmetric f (WA c f)\n  have hb : inner ℂ (WB c f) (WB c f) = inner ℂ f (WB c (WB c f)) :=\n    (WB_selfadjoint c).isSymmetric f (WB c f)\n  rw [← ha,← hb] at h\n  have hr := congrArg Complex.re h\n  simpa [inner_self_eq_norm_sq_to_K,← Complex.ofReal_pow] using hr\n\ntheorem WA_norm_le (c : ℝ) : ‖WA c‖ ≤ 1 := by\n  apply (WA c).opNorm_le_bound (by norm_num)\n  intro f\n  have h := WAB_norm_sq c f\n  have hn := norm_nonneg (WA c f)\n  have hf := norm_nonneg f\n  nlinarith [sq_nonneg ‖WB c f‖]\n\ntheorem WB_norm_le (c : ℝ) : ‖WB c‖ ≤ 1 := by\n  apply (WB c).opNorm_le_bound (by norm_num)\n  intro f\n  have h := WAB_norm_sq c f\n  have hn := norm_nonneg (WB c f)\n  have hf := norm_nonneg f\n  nlinarith [sq_nonneg ‖WA c f‖]\n\ntheorem WA_denseRange (c : ℝ) : DenseRange (WA c) :=\n  bounded_graph_domain_dense (WA c) (WB c) (WA_injective c) (WA_selfadjoint c)\n\ndef GA : F →L[ℂ] F := BoundedGamma.gamma (WA rootParameter) (WA_norm_le rootParameter)\ndef GB : F →L[ℂ] F := BoundedGamma.gamma (WB rootParameter) (WB_norm_le rootParameter)\n\ntheorem GA_selfadjoint : IsSelfAdjoint GA :=\n  gamma_selfadjoint _ _ (WA_selfadjoint rootParameter)\ntheorem GB_selfadjoint : IsSelfAdjoint GB :=\n  gamma_selfadjoint _ _ (WB_selfadjoint rootParameter)\ntheorem GAB_commute : GA * GB = GB * GA :=\n  gamma_commute _ _ _ _ (WAB_commute rootParameter)\ntheorem GA_denseRange : DenseRange GA :=\n  gamma_denseRange _ _ (WA_denseRange rootParameter)\ntheorem GA_injective : Function.Injective GA :=\n  gamma_injective _ _ (WA_selfadjoint rootParameter) (WA_denseRange rootParameter)\n\ntheorem graph_parameters_exponential (f : H1) :\n    (GA (exponential f),GB (exponential f)) ∈ closedGraph TW := by\n  change (BoundedGamma.gamma _ _ (exponential f),BoundedGamma.gamma _ _ (exponential f)) ∈ _\n  rw [BoundedGamma.gamma_exponential,BoundedGamma.gamma_exponential]\n  apply (coreGraph TW).le_topologicalClosure\n  apply Submodule.subset_span\n  let v : TW.domain := boundedGraphLift (WA rootParameter) (WB rootParameter)\n    (WA_injective rootParameter) f\n  refine ⟨v,?_⟩\n  apply Prod.ext\n  · rfl\n  · change exponential (TW v) = exponential (WB rootParameter f)\n    congr 1\n    exact bounded_graph_lift_apply _ _ _ f\n\ntheorem graph_parameters (x : F) : (GA x,GB x) ∈ canonicalLift.graph := by\n  let L : F →L[ℂ] F × F := GA.prod GB\n  let M := (closedGraph TW).comap L.toLinearMap\n  have hs : Submodule.span ℂ (Set.range exponential) ≤ M := by\n    apply Submodule.span_le.mpr\n    rintro _ ⟨f,rfl⟩\n    exact graph_parameters_exponential f\n  have hc : IsClosed (M : Set F) :=\n    (coreGraph TW).isClosed_topologicalClosure.preimage L.continuous\n  have ht := (Submodule.span ℂ (Set.range exponential)).topologicalClosure_minimal hs hc\n  rw [exponential_total] at ht\n  have hx : (GA x,GB x) ∈ closedGraph TW := ht (Submodule.mem_top (x := x))\n  change (GA x,GB x) ∈ (closedLift TW TW_selfadjoint).graph\n  rw [closedLift_graph_eq]\n  exact hx\n\nend F1Fecho.GammaGraph\n#print axioms F1Fecho.GammaGraph.WAB_norm_sq\n#print axioms F1Fecho.GammaGraph.WA_norm_le\n#print axioms F1Fecho.GammaGraph.WB_norm_le\n#print axioms F1Fecho.GammaGraph.GA_selfadjoint\n#print axioms F1Fecho.GammaGraph.GB_selfadjoint\n#print axioms F1Fecho.GammaGraph.GAB_commute\n#print axioms F1Fecho.GammaGraph.GA_injective\n#print axioms F1Fecho.GammaGraph.graph_parameters\n',
+    'TGLExt/F1Fecho394/BoundedGraphSelfAdjointR4.lean': "import Mathlib.Analysis.InnerProductSpace.LinearPMap\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Tactic\n/-! A maximality criterion from an actual bounded parametrization of a graph.\nNo self-adjoint extension, resolvent estimate, or surjectivity is assumed.\nThe proof uses the orthogonal projection of the L2 product graph. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nnamespace F1Fecho.BoundedGraphSelfAdjoint\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\n\nprivate theorem clm_pairing (A : H →L[ℂ] H) (hA : IsSelfAdjoint A) (x y : H) :\n    inner ℂ (A x) y = inner ℂ x (A y) := hA.isSymmetric x y\n\nprivate theorem bounded_pair_zero (A B : H →L[ℂ] H)\n    (hA : IsSelfAdjoint A) (hB : IsSelfAdjoint B)\n    (hAB : A * B = B * A) (hAi : Function.Injective A)\n    (u v : H) (h0 : A u + B v = 0) (h1 : A v = B u) : u=0 ∧ v=0 := by\n  have hc (x : H) : A (B x) = B (A x) :=\n    congrArg (fun C : H →L[ℂ] H => C x) hAB\n  have hu : A u = -(B v) := eq_neg_of_add_eq_zero_left h0\n  have hdouble : A (A u) + B (B u) = 0 := by\n    rw [hu,map_neg,← h1,hc]\n    exact neg_add_cancel _\n  have hi : inner ℂ (A u) (A u) + inner ℂ (B u) (B u) = 0 := by\n    rw [clm_pairing A hA u (A u),clm_pairing B hB u (B u),← inner_add_right,hdouble,inner_zero_right]\n  have hr : ‖A u‖ ^ 2 + ‖B u‖ ^ 2 = 0 := by\n    simpa only [map_add,inner_self_eq_norm_sq,map_zero] using\n      congrArg (RCLike.re : ℂ → ℝ) hi\n  have hau : A u = 0 := norm_eq_zero.mp (by nlinarith [sq_nonneg ‖B u‖,norm_nonneg (A u)])\n  have hu0 : u=0 := hAi (by simpa only [map_zero] using hau)\n  have hav : A v=0 := by simpa only [hu0,map_zero] using h1\n  exact ⟨hu0,hAi (by simpa only [map_zero] using hav)⟩\n\nprivate theorem graph_constraint (G : H →ₗ.[ℂ] H)\n    (hs : G.IsFormalAdjoint G) (A B : H →L[ℂ] H)\n    (hA : IsSelfAdjoint A) (hB : IsSelfAdjoint B)\n    (hgraph : ∀ x : H, (A x,B x) ∈ G.graph)\n    (p : H × H) (hp : p ∈ G.graph) : A p.2 = B p.1 := by\n  obtain ⟨y,rfl⟩ := G.mem_graph_iff'.mp hp\n  apply ext_inner_left ℂ\n  intro x\n  obtain ⟨z,hz⟩ := G.mem_graph_iff'.mp (hgraph x)\n  have hz1 : (z:H)=A x := congrArg Prod.fst hz\n  have hz2 : G z=B x := congrArg Prod.snd hz\n  have h := hs z y\n  rw [hz1,hz2,clm_pairing B hB x (y:H),clm_pairing A hA x (G y)] at h\n  exact h.symm\n\nprivate theorem adjoint_constraint (G : H →ₗ.[ℂ] H)\n    (hd : Dense (G.domain : Set H)) (A B : H →L[ℂ] H)\n    (hA : IsSelfAdjoint A) (hB : IsSelfAdjoint B)\n    (hgraph : ∀ x : H, (A x,B x) ∈ G.graph)\n    (p : H × H) (hp : p ∈ G.adjoint.graph) : A p.2 = B p.1 := by\n  rw [LinearPMap.adjoint_graph_eq_graph_adjoint hd] at hp\n  have hh := (Submodule.mem_adjoint_iff G.graph p).mp hp\n  apply ext_inner_left ℂ\n  intro x\n  have h := sub_eq_zero.mp (hh (A x) (B x) (hgraph x))\n  rw [clm_pairing B hB x p.1,clm_pairing A hA x p.2] at h\n  exact h.symm\n\ntheorem adjoint_graph_le_of_bounded_pair (G : H →ₗ.[ℂ] H)\n    (hc : G.IsClosed) (hs : G.IsFormalAdjoint G)\n    (hd : Dense (G.domain : Set H)) (A B : H →L[ℂ] H)\n    (hA : IsSelfAdjoint A) (hB : IsSelfAdjoint B)\n    (hAB : A * B = B * A) (hAi : Function.Injective A)\n    (hgraph : ∀ x : H, (A x,B x) ∈ G.graph) :\n    G.adjoint.graph ≤ G.graph := by\n  let E := WithLp 2 (H × H)\n  let e : E ≃L[ℂ] H × H := WithLp.prodContinuousLinearEquiv 2 ℂ H H\n  let L : Submodule ℂ E := G.graph.comap e.toLinearMap\n  have hL : IsClosed (L : Set E) := hc.preimage e.continuous\n  letI : CompleteSpace L := hL.completeSpace_coe\n  intro p hp\n  let w : E := e.symm p\n  let q : E := L.starProjection w\n  let r : E := w-q\n  have hq : e q ∈ G.graph := Submodule.starProjection_apply_mem L w\n  have hwrel : A (e w).2 = B (e w).1 := by\n    simpa only [w,ContinuousLinearEquiv.apply_symm_apply] using\n      adjoint_constraint G hd A B hA hB hgraph p hp\n  have hqrel := graph_constraint G hs A B hA hB hgraph (e q) hq\n  have hrrel : A (e r).2 = B (e r).1 := by\n    change A (e (w-q)).2 = B (e (w-q)).1\n    rw [map_sub]\n    change A ((e w).2-(e q).2) = B ((e w).1-(e q).1)\n    rw [map_sub,map_sub,hwrel,hqrel]\n  have horth (x : H) : inner ℂ r (e.symm (A x,B x)) = 0 := by\n    apply Submodule.starProjection_inner_eq_zero w _\n    change e (e.symm (A x,B x)) ∈ G.graph\n    simpa only [ContinuousLinearEquiv.apply_symm_apply] using hgraph x\n  have hsum : A (e r).1 + B (e r).2 = 0 := by\n    apply (inner_self_eq_zero (𝕜 := ℂ)).mp\n    have h := horth (A (e r).1 + B (e r).2)\n    change inner ℂ (e r).1 (A (A (e r).1+B (e r).2)) +\n      inner ℂ (e r).2 (B (A (e r).1+B (e r).2)) = 0 at h\n    rw [← clm_pairing A hA (e r).1 _,← clm_pairing B hB (e r).2 _,← inner_add_left] at h\n    exact h\n  obtain ⟨hu,hv⟩ := bounded_pair_zero A B hA hB hAB hAi (e r).1 (e r).2 hsum hrrel\n  have hr0 : r=0 := by\n    apply e.injective\n    exact (Prod.ext hu hv).trans (map_zero e).symm\n  have heq : w=q := sub_eq_zero.mp hr0\n  have hw : e w ∈ G.graph := by rw [heq]; exact hq\n  simpa only [w,ContinuousLinearEquiv.apply_symm_apply] using hw\n\ntheorem selfAdjoint_of_bounded_pair (G : H →ₗ.[ℂ] H)\n    (hc : G.IsClosed) (hs : G.IsFormalAdjoint G)\n    (hd : Dense (G.domain : Set H)) (A B : H →L[ℂ] H)\n    (hA : IsSelfAdjoint A) (hB : IsSelfAdjoint B)\n    (hAB : A * B = B * A) (hAi : Function.Injective A)\n    (hgraph : ∀ x : H, (A x,B x) ∈ G.graph) : IsSelfAdjoint G := by\n  apply LinearPMap.isSelfAdjoint_def.mpr\n  exact le_antisymm\n    (LinearPMap.le_of_le_graph (adjoint_graph_le_of_bounded_pair G hc hs hd A B hA hB hAB hAi hgraph))\n    (hs.le_adjoint hd)\n\nend F1Fecho.BoundedGraphSelfAdjoint\n#print axioms F1Fecho.BoundedGraphSelfAdjoint.adjoint_graph_le_of_bounded_pair\n#print axioms F1Fecho.BoundedGraphSelfAdjoint.selfAdjoint_of_bounded_pair\n",
+    'TGLExt/F1Fecho394/ExponentialTomitaEqualityR4.lean': 'import TGLExt.F1Fecho394.WeylFiniteAlgebraR4\nimport TGLExt.F1Fecho394.BicommutantStarGraphR1\n/-! Equality of the actual algebra/vacuum Tomita graph with the concrete\nexponential Tomita graph on the same canonical Fock space. The reverse inclusion\nuses proved two-vector bicommutant density and real graph separation. No graph\ncore or strong-star density is supplied as an additional hypothesis. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.ExponentialTomitaEquality\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.ExponentialLift F1Fecho.ExponentialTomita F1Fecho.ExponentialTomitaInclusion\nopen F1Fecho.WeylExponentialCore F1Fecho.WeylFiniteAlgebra F1Fecho.WedgePairTomita\n\ntheorem algebra_pair_mem_Sexp (a : F →L[ℂ] F) (ha : a ∈ FieldWeyl.R K) :\n    (a vacuum,(star a) vacuum) ∈\n      Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) := by\n  have h := StarGraphDensity.star_pair_mem_set_closure_of_bicommutant finiteAlgebra a vacuum\n    (R_bicommutant_finite a ha)\n  apply (closure_minimal (t := Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)))\n    ?_ Sexp_closed) h\n  rintro p ⟨b,hb,rfl⟩\n  exact finite_algebra_graph b hb\n\ntheorem pair_graph_subset_Sexp_graph :\n    Set.range (fun x : domain KWR => ((x:F),S KWR x)) ⊆\n      Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) := by\n  rw [graph_eq]\n  apply closure_minimal _ Sexp_closed\n  rintro p ⟨a,ha,rfl⟩\n  exact algebra_pair_mem_Sexp a ha\n\ntheorem tomita_graph_eq :\n    Set.range (fun x : domain KWR => ((x:F),S KWR x)) =\n      Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) :=\n  Set.Subset.antisymm pair_graph_subset_Sexp_graph Sexp_graph_subset_pair_graph\n\ntheorem tomita_domain_eq : domain KWR = canonicalLift.domain := by\n  apply le_antisymm\n  · intro x hx\n    have h : (x,S KWR ⟨x,hx⟩) ∈\n        Set.range (fun z : domain KWR => ((z:F),S KWR z)) := ⟨⟨x,hx⟩,rfl⟩\n    rw [tomita_graph_eq] at h\n    obtain ⟨z,hz⟩ := h\n    have he : (z:F)=x := congrArg Prod.fst hz\n    exact he ▸ z.property\n  · intro x hx\n    exact Sexp_domain_inclusion ⟨x,hx⟩\n\ntheorem tomita_action_eq (x : domain KWR) :\n    S KWR x = Sexp ⟨(x:F),tomita_domain_eq ▸ x.property⟩ := by\n  exact Sexp_eq_pair_on_domain ⟨(x:F),tomita_domain_eq ▸ x.property⟩\n\nend F1Fecho.ExponentialTomitaEquality\n#print axioms F1Fecho.ExponentialTomitaEquality.algebra_pair_mem_Sexp\n#print axioms F1Fecho.ExponentialTomitaEquality.pair_graph_subset_Sexp_graph\n#print axioms F1Fecho.ExponentialTomitaEquality.tomita_graph_eq\n#print axioms F1Fecho.ExponentialTomitaEquality.tomita_domain_eq\n#print axioms F1Fecho.ExponentialTomitaEquality.tomita_action_eq\n',
+    'TGLExt/F1Fecho394/PartialSquareGraphR2.lean': 'import TGLExt.ContinuousModularSquare\nimport TGLExt.GenericAntilinearAdjoint\n/-! The exact composition domain and graph of a partial operator square,\nreusing the canonical partialSquareDomain. No selfadjointness of the square\nor imaginary power identification is asserted by this algebraic lemma. -/\nset_option autoImplicit false\nnoncomputable section\nnamespace F1Fecho.PartialSquare\nopen ChatgptAudit.Continuous050\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n\ndef input (T : H →ₗ.[ℂ] H) : partialSquareDomain T →ₗ[ℂ] T.domain :=\n  Submodule.inclusion (fun _ h => h.choose)\n\ndef square (T : H →ₗ.[ℂ] H) : H →ₗ.[ℂ] H where\n  domain := partialSquareDomain T\n  toFun := T.toFun.comp ((T.toFun.comp (input T)).codRestrict\n    T.domain (fun x => x.property.choose_spec))\n\ntheorem square_graph_iff (T : H →ₗ.[ℂ] H) (x y : H) :\n    (x,y) ∈ (square T).graph ↔\n      ∃ hx : x ∈ T.domain, ∃ hTx : T ⟨x,hx⟩ ∈ T.domain, T ⟨T ⟨x,hx⟩,hTx⟩ = y := by\n  rw [LinearPMap.mem_graph_iff]\n  constructor\n  · rintro ⟨v,hv,hy⟩\n    dsimp only [Prod.fst,Prod.snd] at hv hy\n    subst x\n    exact ⟨v.property.choose,v.property.choose_spec,hy⟩\n  · rintro ⟨hx,hTx,hxy⟩\n    exact ⟨⟨x,⟨hx,hTx⟩⟩,rfl,hxy⟩\n\ntheorem square_graph_iff_tomita_comp (T : H →ₗ.[ℂ] H)\n    (J : H ≃ₛₗᵢ[starRingEnd ℂ] H) (hJ : Function.Involutive J) (x y : H) :\n    (x,y) ∈ (square T).graph ↔\n      ∃ hx : x ∈ T.domain,\n        ∃ hSx : genericTomita T J ⟨x,hx⟩ ∈ (genericTomitaAdjoint T J).domain,\n          genericTomitaAdjoint T J ⟨genericTomita T J ⟨x,hx⟩,hSx⟩ = y := by\n  rw [square_graph_iff]\n  constructor\n  · rintro ⟨hx,hTx,hxy⟩\n    refine ⟨hx,(generic_composition_domain T J hJ ⟨x,hx⟩).mpr hTx,?_⟩\n    rw [generic_adjoint_comp T J hJ]\n    exact hxy\n  · rintro ⟨hx,hSx,hxy⟩\n    have hTx := (generic_composition_domain T J hJ ⟨x,hx⟩).mp hSx\n    refine ⟨hx,hTx,?_⟩\n    rw [← generic_adjoint_comp T J hJ ⟨x,hx⟩ hTx]\n    exact hxy\n\ntheorem square_energy (T : H →ₗ.[ℂ] H) (hs : T.IsFormalAdjoint T)\n    (x : (square T).domain) :\n    (inner ℂ (x:H) (square T x)).re = ‖T ⟨x,x.property.choose⟩‖^2 := by\n  let u : T.domain := ⟨x,x.property.choose⟩\n  let v : T.domain := ⟨T u,x.property.choose_spec⟩\n  change (inner ℂ (u:H) (T v)).re = _\n  rw [← hs u v]\n  exact (norm_sq_eq_re_inner (𝕜 := ℂ) (T u)).symm\n\nend F1Fecho.PartialSquare\n#print axioms F1Fecho.PartialSquare.square_graph_iff\n#print axioms F1Fecho.PartialSquare.square_graph_iff_tomita_comp\n#print axioms F1Fecho.PartialSquare.square_energy\n',
+    'TGLExt/F1Fecho394/CanonicalFockPolarR1.lean': 'import TGLExt.F1Fecho394.GammaGraphParametersR3\nimport TGLExt.F1Fecho394.BoundedGraphSelfAdjointR4\nimport TGLExt.F1Fecho394.ExponentialTomitaEqualityR4\nimport TGLExt.F1Fecho394.ExponentialLiftPositiveR2\nimport TGLExt.F1Fecho394.PartialSquareGraphR2\n/-! Concrete positive selfadjoint factor of the ACTUAL Weyl/vacuum Tomita\noperator, on the unchanged Fock. The bounded graph parameters are constructed,\nnot fields. The maximal antilinear adjoint and exact S†S graph are identified.\nNo spectral imaginary-power identity or new KMS analytic-strip theorem is\nasserted in this module. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nopen scoped InnerProductSpace\nnamespace F1Fecho.CanonicalFockPolar\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.ExponentialLift F1Fecho.ExponentialTomita F1Fecho.Antilinear\nopen F1Fecho.ExponentialTomitaEquality F1Fecho.ExponentialTomitaInclusion\nopen F1Fecho.GammaGraph F1Fecho.WedgePairTomita\nopen ChatgptAudit.Continuous050\n\ntheorem canonicalLift_selfadjoint : IsSelfAdjoint canonicalLift :=\n  BoundedGraphSelfAdjoint.selfAdjoint_of_bounded_pair canonicalLift\n    canonicalLift_closed (closedLift_isFormalAdjoint TW TW_selfadjoint)\n    canonicalLift_dense GA GB GA_selfadjoint GB_selfadjoint GAB_commute GA_injective graph_parameters\n\ntheorem actual_tomita_polar (x : domain KWR) :\n    S KWR x = JF (canonicalLift ⟨(x:F),tomita_domain_eq ▸ x.property⟩) :=\n  tomita_action_eq x\n\ntheorem positive_polar_factor :\n    IsSelfAdjoint canonicalLift ∧\n      (∀ x : canonicalLift.domain, 0 ≤ (inner ℂ (x:F) (canonicalLift x)).re) ∧\n      (∀ x : domain KWR,\n        S KWR x = JF (canonicalLift ⟨(x:F),tomita_domain_eq ▸ x.property⟩)) :=\n  ⟨canonicalLift_selfadjoint,ExponentialLiftPositive.canonicalLift_positive,actual_tomita_polar⟩\n\ndef Sdagger : F →ₛₗ.[starRingEnd ℂ] F := genericTomitaAdjoint canonicalLift JF\n\ntheorem actual_adjoint_pairing (x : domain KWR) (y : Sdagger.domain) :\n    inner ℂ (S KWR x) (y:F) = inner ℂ (Sdagger y) (x:F) := by\n  rw [tomita_action_eq]\n  exact generic_adjoint_pairing canonicalLift canonicalLift_selfadjoint JF\n    canonicalFockJ_involutive ⟨(x:F),tomita_domain_eq ▸ x.property⟩ y\n\ntheorem actual_adjoint_maximal {y z : F}\n    (h : ∀ x : domain KWR, inner ℂ (S KWR x) y = inner ℂ z (x:F)) :\n    ∃ hy : y ∈ Sdagger.domain, Sdagger ⟨y,hy⟩ = z := by\n  apply generic_adjoint_maximal canonicalLift canonicalLift_selfadjoint JF canonicalFockJ_involutive\n  intro x\n  have hx := h ⟨(x:F),Sexp_domain_inclusion x⟩\n  rw [Sexp_eq_pair_on_domain] at hx\n  exact hx\n\ntheorem actual_adjoint_domain_iff (y : F) :\n    y ∈ Sdagger.domain ↔ ∃ z : F,\n      ∀ x : domain KWR, inner ℂ (S KWR x) y = inner ℂ z (x:F) := by\n  constructor\n  · intro hy\n    exact ⟨Sdagger ⟨y,hy⟩,fun x => actual_adjoint_pairing x ⟨y,hy⟩⟩\n  · rintro ⟨z,hz⟩\n    exact (actual_adjoint_maximal hz).choose\n\n/-- S†S, with the exact two-application domain, defined as G squared. -/\ndef Delta : F →ₗ.[ℂ] F := PartialSquare.square canonicalLift\n\ntheorem delta_graph_iff_tomita_comp (x y : F) :\n    (x,y) ∈ Delta.graph ↔\n      ∃ hx : x ∈ canonicalLift.domain,\n        ∃ hSx : Sexp ⟨x,hx⟩ ∈ Sdagger.domain,\n          Sdagger ⟨Sexp ⟨x,hx⟩,hSx⟩ = y :=\n  PartialSquare.square_graph_iff_tomita_comp canonicalLift JF canonicalFockJ_involutive x y\n\ntheorem delta_energy (x : Delta.domain) :\n    (inner ℂ (x:F) (Delta x)).re = ‖canonicalLift ⟨x,x.property.choose⟩‖^2 :=\n  PartialSquare.square_energy canonicalLift (closedLift_isFormalAdjoint TW TW_selfadjoint) x\n\ntheorem delta_positive (x : Delta.domain) : 0 ≤ (inner ℂ (x:F) (Delta x)).re := by\n  rw [delta_energy]\n  exact sq_nonneg _\n\nend F1Fecho.CanonicalFockPolar\n#print axioms F1Fecho.CanonicalFockPolar.canonicalLift_selfadjoint\n#print axioms F1Fecho.CanonicalFockPolar.actual_tomita_polar\n#print axioms F1Fecho.CanonicalFockPolar.positive_polar_factor\n#print axioms F1Fecho.CanonicalFockPolar.actual_adjoint_pairing\n#print axioms F1Fecho.CanonicalFockPolar.actual_adjoint_maximal\n#print axioms F1Fecho.CanonicalFockPolar.actual_adjoint_domain_iff\n#print axioms F1Fecho.CanonicalFockPolar.delta_graph_iff_tomita_comp\n#print axioms F1Fecho.CanonicalFockPolar.delta_energy\n#print axioms F1Fecho.CanonicalFockPolar.delta_positive\n',
+    'TGLExt/F1Fecho394/PartialSquareClosedR3.lean': 'import TGLExt.F1Fecho394.PartialSquareGraphR2\nimport Mathlib.Topology.Sequences\n/-! Closedness of the genuine square of a closed symmetric partial operator.\nThe proof controls the middle graph coordinate by Cauchy--Schwarz and uses\ncompleteness; ordinary density is not substituted for graph closedness. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1000000\nnoncomputable section\nopen Filter Topology\nnamespace F1Fecho.PartialSquare\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\n\ndef middle (T : H →ₗ.[ℂ] H) : (square T).domain →ₗ[ℂ] H := T.toFun.comp (input T)\n\ntheorem middle_norm_sq_le (T : H →ₗ.[ℂ] H) (hs : T.IsFormalAdjoint T)\n    (x : (square T).domain) : ‖middle T x‖^2 ≤ ‖(x:H)‖ * ‖square T x‖ := by\n  have h := re_inner_le_norm (𝕜 := ℂ) (x:H) (square T x)\n  change (inner ℂ (x:H) (square T x)).re ≤ ‖(x:H)‖ * ‖square T x‖ at h\n  rw [square_energy T hs x] at h\n  exact h\n\ntheorem square_graph_iff_two (T : H →ₗ.[ℂ] H) (x y : H) :\n    (x,y) ∈ (square T).graph ↔ ∃ z : H, (x,z) ∈ T.graph ∧ (z,y) ∈ T.graph := by\n  rw [square_graph_iff]\n  constructor\n  · rintro ⟨hx,hTx,hxy⟩\n    refine ⟨T ⟨x,hx⟩,?_,?_⟩\n    · exact (LinearPMap.mem_graph_iff T).mpr ⟨⟨x,hx⟩,rfl,rfl⟩\n    · exact (LinearPMap.mem_graph_iff T).mpr ⟨⟨T ⟨x,hx⟩,hTx⟩,rfl,hxy⟩\n  · rintro ⟨z,hxz,hzy⟩\n    obtain ⟨u,hu,hTu⟩ := (LinearPMap.mem_graph_iff T).mp hxz\n    obtain ⟨v,hv,hTv⟩ := (LinearPMap.mem_graph_iff T).mp hzy\n    dsimp only [Prod.fst,Prod.snd] at hu hTu hv hTv\n    subst x\n    have ht : T u = (v:H) := hTu.trans hv.symm\n    have hm : T u ∈ T.domain := ht.symm ▸ v.property\n    refine ⟨u.property,hm,?_⟩\n    have he : (⟨T u,hm⟩ : T.domain) = v := Subtype.ext ht\n    rw [he]\n    exact hTv\n\ntheorem square_formalAdjoint (T : H →ₗ.[ℂ] H) (hs : T.IsFormalAdjoint T) :\n    (square T).IsFormalAdjoint (square T) := by\n  intro x y\n  let u : T.domain := ⟨x,x.property.choose⟩\n  let v : T.domain := ⟨y,y.property.choose⟩\n  let Tu : T.domain := ⟨T u,x.property.choose_spec⟩\n  let Tv : T.domain := ⟨T v,y.property.choose_spec⟩\n  change inner ℂ (T Tu) (v:H) = inner ℂ (u:H) (T Tv)\n  exact (hs Tu v).trans (hs u Tv)\n\ntheorem square_closed (T : H →ₗ.[ℂ] H) (hc : T.IsClosed) (hs : T.IsFormalAdjoint T) :\n    (square T).IsClosed := by\n  apply IsSeqClosed.isClosed\n  intro p q hp hpq\n  choose v hv1 hv2 using (fun n => (LinearPMap.mem_graph_iff (square T)).mp (hp n))\n  have hx : Tendsto (fun n => (v n:H)) atTop (𝓝 q.1) := by\n    simpa only [hv1,Function.comp_def] using (continuous_fst.tendsto q).comp hpq\n  have hy : Tendsto (fun n => square T (v n)) atTop (𝓝 q.2) := by\n    simpa only [hv2,Function.comp_def] using (continuous_snd.tendsto q).comp hpq\n  have hmid : CauchySeq (fun n => middle T (v n)) := by\n    apply Metric.cauchySeq_iff.mpr\n    intro ε hε\n    obtain ⟨Nx,hNx⟩ := Metric.cauchySeq_iff.mp hx.cauchySeq ε hε\n    obtain ⟨Ny,hNy⟩ := Metric.cauchySeq_iff.mp hy.cauchySeq ε hε\n    refine ⟨max Nx Ny,?_⟩\n    intro m hm n hn\n    have hxx : ‖(v m:H)-(v n:H)‖ < ε := by\n      rw [← dist_eq_norm]\n      exact hNx m (le_trans (le_max_left _ _) hm) n (le_trans (le_max_left _ _) hn)\n    have hyy : ‖square T (v m)-square T (v n)‖ < ε := by\n      rw [← dist_eq_norm]\n      exact hNy m (le_trans (le_max_right _ _) hm) n (le_trans (le_max_right _ _) hn)\n    have hb := middle_norm_sq_le T hs (v m-v n)\n    rw [map_sub,LinearPMap.map_sub] at hb\n    change ‖middle T (v m)-middle T (v n)‖^2 ≤\n      ‖(v m:H)-(v n:H)‖ * ‖square T (v m)-square T (v n)‖ at hb\n    have hprod : ‖(v m:H)-(v n:H)‖ * ‖square T (v m)-square T (v n)‖ < ε*ε := by\n      calc\n        _ ≤ ε * ‖square T (v m)-square T (v n)‖ := mul_le_mul_of_nonneg_right hxx.le (norm_nonneg _)\n        _ < ε*ε := mul_lt_mul_of_pos_left hyy hε\n    rw [dist_eq_norm]\n    nlinarith [norm_nonneg (middle T (v m)-middle T (v n))]\n  obtain ⟨z,hz⟩ := cauchySeq_tendsto_of_complete hmid\n  have hfirst : (q.1,z) ∈ T.graph := by\n    apply hc.mem_of_tendsto (hx.prodMk_nhds hz)\n    apply Filter.Eventually.of_forall\n    intro n\n    exact (LinearPMap.mem_graph_iff T).mpr ⟨input T (v n),rfl,rfl⟩\n  have hsecond : (z,q.2) ∈ T.graph := by\n    apply hc.mem_of_tendsto (hz.prodMk_nhds hy)\n    apply Filter.Eventually.of_forall\n    intro n\n    exact (LinearPMap.mem_graph_iff T).mpr\n      ⟨⟨middle T (v n),(v n).property.choose_spec⟩,rfl,rfl⟩\n  exact (square_graph_iff_two T q.1 q.2).mpr ⟨z,hfirst,hsecond⟩\n\nend F1Fecho.PartialSquare\n#print axioms F1Fecho.PartialSquare.middle_norm_sq_le\n#print axioms F1Fecho.PartialSquare.square_graph_iff_two\n#print axioms F1Fecho.PartialSquare.square_formalAdjoint\n#print axioms F1Fecho.PartialSquare.square_closed\n',
+    'TGLExt/F1Fecho394/CanonicalFockDeltaR4.lean': "import TGLExt.F1Fecho394.CanonicalFockPolarR1\nimport TGLExt.F1Fecho394.PartialSquareClosedR3\n/-! The actual S†S operator on canonical Fock is closed and selfadjoint.\nIts bounded graph parameters are GA² and GB²; no false square-sum identity\nfor second quantization is used. Imaginary powers remain a separate task. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nopen scoped InnerProductSpace\nnamespace F1Fecho.CanonicalFockPolar\nopen F1Rede.BosonicFock F1Rede.CanonicalWedge F1Fecho.ExponentialLift F1Fecho.GammaGraph\nopen ChatgptAudit.Continuous049\n\ndef GA2 : F →L[ℂ] F := GA * GA\ndef GB2 : F →L[ℂ] F := GB * GB\n\ntheorem GA2_selfadjoint : IsSelfAdjoint GA2 := by\n  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr\n  intro x y\n  change inner ℂ (GA (GA x)) y = inner ℂ x (GA (GA y))\n  exact (GA_selfadjoint.isSymmetric (GA x) y).trans (GA_selfadjoint.isSymmetric x (GA y))\ntheorem GB2_selfadjoint : IsSelfAdjoint GB2 := by\n  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr\n  intro x y\n  change inner ℂ (GB (GB x)) y = inner ℂ x (GB (GB y))\n  exact (GB_selfadjoint.isSymmetric (GB x) y).trans (GB_selfadjoint.isSymmetric x (GB y))\ntheorem GAB2_commute : GA2 * GB2 = GB2 * GA2 := by\n  have h : Commute GA GB := GAB_commute\n  simpa only [GA2,GB2,pow_two] using (h.pow_pow 2 2).eq\ntheorem GA2_injective : Function.Injective GA2 := by\n  intro x y h\n  exact GA_injective (GA_injective h)\n\ntheorem delta_graph_parameters (x : F) : (GA2 x,GB2 x) ∈ Delta.graph := by\n  apply (PartialSquare.square_graph_iff_two canonicalLift _ _).mpr\n  have hc : GB (GA x) = GA (GB x) :=\n    congrArg (fun L : F →L[ℂ] F => L x) GAB_commute.symm\n  refine ⟨GA (GB x),?_,?_⟩\n  · have h := graph_parameters (GA x)\n    rw [hc] at h\n    exact h\n  · exact graph_parameters (GB x)\n\ntheorem delta_dense : Dense (Delta.domain : Set F) := by\n  have hd := bounded_graph_domain_dense GA2 GB2 GA2_injective GA2_selfadjoint\n  apply hd.mono\n  rintro x ⟨y,rfl⟩\n  obtain ⟨z,hz,_⟩ := (LinearPMap.mem_graph_iff Delta).mp (delta_graph_parameters y)\n  have hz' : (z:F) = GA2 y := hz\n  change GA2 y ∈ Delta.domain\n  exact hz' ▸ z.property\n\ntheorem delta_closed : Delta.IsClosed :=\n  PartialSquare.square_closed canonicalLift canonicalLift_closed\n    (closedLift_isFormalAdjoint TW TW_selfadjoint)\n\ntheorem delta_selfadjoint : IsSelfAdjoint Delta :=\n  BoundedGraphSelfAdjoint.selfAdjoint_of_bounded_pair Delta delta_closed\n    (PartialSquare.square_formalAdjoint canonicalLift\n      (closedLift_isFormalAdjoint TW TW_selfadjoint)) delta_dense\n    GA2 GB2 GA2_selfadjoint GB2_selfadjoint GAB2_commute GA2_injective delta_graph_parameters\n\n/-- Positive selfadjoint square root, with exact composition domain from the prior module. -/\ntheorem modular_positive_square_root :\n    IsSelfAdjoint canonicalLift ∧\n    (∀ x : canonicalLift.domain, 0 ≤ (inner ℂ (x:F) (canonicalLift x)).re) ∧\n    PartialSquare.square canonicalLift = Delta ∧ IsSelfAdjoint Delta :=\n  ⟨canonicalLift_selfadjoint,ExponentialLiftPositive.canonicalLift_positive,rfl,delta_selfadjoint⟩\n\nend F1Fecho.CanonicalFockPolar\n#print axioms F1Fecho.CanonicalFockPolar.delta_graph_parameters\n#print axioms F1Fecho.CanonicalFockPolar.delta_dense\n#print axioms F1Fecho.CanonicalFockPolar.delta_closed\n#print axioms F1Fecho.CanonicalFockPolar.delta_selfadjoint\n#print axioms F1Fecho.CanonicalFockPolar.modular_positive_square_root\n",
