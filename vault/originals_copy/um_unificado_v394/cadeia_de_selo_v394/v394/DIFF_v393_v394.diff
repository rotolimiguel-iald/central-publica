∀ (u : H1 ≃ₗᵢ[ℂ] H1) (K K\' : Submodule ℝ H1), (∀ f, f ∈ K ↔ u f ∈ K\') →\n    ∀ x : F →L[ℂ] F, x ∈ R K ↔ (F1Rede.BosonicFock.gamma u).conjStarAlgEquiv x ∈ R K\'\n  /-- Reeh–Schlieder na cunha (K(W) padrão) [Araki 1963; BGL 2002]. -/\n  wedge_cyclic : Dense ((Submodule.span ℂ\n      ((fun T : F →L[ℂ] F => T F1Rede.BosonicFock.vacuum) \'\' (R (L.K rightWedge) : Set (F →L[ℂ] F))) : Submodule ℂ F) : Set F)\n  wedge_separating : ∀ a ∈ R (L.K rightWedge), (a : F →L[ℂ] F) F1Rede.BosonicFock.vacuum = 0 → a = 0\n  wedge_nonabelian : ∃ a ∈ R (L.K rightWedge), ∃ b ∈ R (L.K rightWedge), a * b ≠ b * a\n  /-- ★ BISOGNANO–WICHMANN da luz: o boost segundo-quantizado em 2πt satisfaz KMS a β = 1 na cunha\n      [Bisognano–Wichmann 1975/76; BGL 2002 + Araki 1963]. -/\n  bw_kms : KMSBody (R (L.K rightWedge)) F1Rede.BosonicFock.vacuum (fun t => F1Rede.BosonicFock.gamma (B0 (2 * Real.pi * t))) 1\n  /-- a realização analítica de Tomita do par [Tomita–Takesaki]. -/\n  tomita : ORDEM016.D6.PairTomitaAnalyticRealizationMeasured\n    (R (L.K rightWedge)).toStarSubalgebra F1Rede.BosonicFock.vacuum canonicalFockJ (fun t => F1Rede.BosonicFock.gamma (B0 (-(2 * Real.pi * t))))\n  /-- o fluxo modular como automorfismo da cunha (Ad Δ^{it} preserva M) [Tomita–Takesaki]. -/\n  flow : ℝ → ((R (L.K rightWedge)).toStarSubalgebra ≃⋆ₐ[ℂ] (R (L.K rightWedge)).toStarSubalgebra)\n  flow_zero : flow 0 = StarAlgEquiv.refl\n  flow_add : ∀ s t : ℝ, flow (s + t) = (flow s).trans (flow t)\n  flow_is_Ad : ∀ (t : ℝ) (a : (R (L.K rightWedge)).toStarSubalgebra),\n    ((flow t) a).val = (F1Rede.BosonicFock.gamma (B0 (-(2 * Real.pi * t)))).conjStarAlgEquiv a.val\n  /-- o núcleo de Takesaki [Takesaki 1973]. -/\n  Core : Type\n  [instCR : Ring Core]\n  [instCS : StarRing Core]\n  [instCA : Algebra ℂ Core]\n  embedding : (R (L.K rightWedge)).toStarSubalgebra →⋆ₐ[ℂ] Core\n  embedding_injective : Function.Injective embedding\n  dualAction : ℝ → (Core ≃⋆ₐ[ℂ] Core)\n  dualAction_zero : dualAction 0 = StarAlgEquiv.refl\n  dualAction_add : ∀ s t : ℝ, dualAction (s + t) = (dualAction s).trans (dualAction t)\n  trace : Core → ENNReal\n  trace_zero : trace 0 = 0\n  trace_tracial : ∀ x y : Core, trace (x * y) = trace (y * x)\n  trace_star : ∀ x : Core, trace (star x) = trace x\n  trace_dual_scaling : ∀ (s : ℝ) (x : Core),\n    trace ((dualAction s) x) = ENNReal.ofReal (Real.exp (-s)) * trace x\n  /-- uma projeção finita não nula do núcleo II_∞, partida em duas metades de traço igual [Connes 1973]. -/\n  PF : Core\n  PF_sa : star PF = PF\n  PF_idem : PF * PF = PF\n  PF_ne : PF ≠ 0\n  PF_pos : 0 < trace PF\n  PF_fin : trace PF < ⊤\n  Pp : Core\n  Pm : Core\n  Pp_sa : star Pp = Pp\n  Pp_idem : Pp * Pp = Pp\n  Pm_sa : star Pm = Pm\n  Pm_idem : Pm * Pm = Pm\n  split : Pp + Pm = PF\n  orth : Pp * Pm = 0\n  trace_additive : trace PF = trace Pp + trace Pm\n  equal_halves : trace Pp = trace Pm\n\nattribute [instance] RemainingAnalyticInput.instCR RemainingAnalyticInput.instCS RemainingAnalyticInput.instCA\n\ndef RemainingAnalyticInput.toRemainingFock {L : LightOneParticle}\n    (A : RemainingAnalyticInput L) : RemainingFockInput L where\n  J := canonicalFockJ\n  J_invol := canonicalFockJ_involutive\n  J_vac := canonicalFockJ_vacuum\n  Γ_positive := A.Γ_positive\n  Γ_no_fixed := A.Γ_no_fixed\n  R := A.R\n  R_mono := A.R_mono\n  R_local := A.R_local\n  R_cov := A.R_cov\n  wedge_cyclic := A.wedge_cyclic\n  wedge_separating := A.wedge_separating\n  wedge_nonabelian := A.wedge_nonabelian\n  bw_kms := A.bw_kms\n  tomita := A.tomita\n  flow := A.flow\n  flow_zero := A.flow_zero\n  flow_add := A.flow_add\n  flow_is_Ad := A.flow_is_Ad\n  Core := A.Core\n  embedding := A.embedding\n  embedding_injective := A.embedding_injective\n  dualAction := A.dualAction\n  dualAction_zero := A.dualAction_zero\n  dualAction_add := A.dualAction_add\n  trace := A.trace\n  trace_zero := A.trace_zero\n  trace_tracial := A.trace_tracial\n  trace_star := A.trace_star\n  trace_dual_scaling := A.trace_dual_scaling\n  PF := A.PF\n  PF_sa := A.PF_sa\n  PF_idem := A.PF_idem\n  PF_ne := A.PF_ne\n  PF_pos := A.PF_pos\n  PF_fin := A.PF_fin\n  Pp := A.Pp\n  Pm := A.Pm\n  Pp_sa := A.Pp_sa\n  Pp_idem := A.Pp_idem\n  Pm_sa := A.Pm_sa\n  Pm_idem := A.Pm_idem\n  split := A.split\n  orth := A.orth\n  trace_additive := A.trace_additive\n  equal_halves := A.equal_halves\n  instCR := A.instCR\n  instCS := A.instCS\n  instCA := A.instCA\n\ndef RemainingAnalyticInput.toCertificate {L : LightOneParticle}\n    (A : RemainingAnalyticInput L) : FockCertificate L := A.toRemainingFock.toCertificate\n\ntheorem assembled_J_is_concrete {L : LightOneParticle} (A : RemainingAnalyticInput L) :\n    A.toCertificate.J = canonicalFockJ := rfl\ntheorem assembled_J_on_oneParticle {L : LightOneParticle} (A : RemainingAnalyticInput L)\n    (x : H1) : A.toCertificate.J (A.toCertificate.ι x) =\n      A.toCertificate.ι (F1Rede.CanonicalWedge.Jcandidate x) :=\n  canonicalFockJ_oneParticle x\ntheorem assembled_J_involutive {L : LightOneParticle} (A : RemainingAnalyticInput L) :\n    Function.Involutive A.toCertificate.J := canonicalFockJ_involutive\ntheorem assembled_J_preserves_existing_vacuum {L : LightOneParticle}\n    (A : RemainingAnalyticInput L) : A.toCertificate.J vacuum = vacuum := canonicalFockJ_vacuum\n\n/-- Actual inhabitant of the antiunitary fragment, independent of the remaining\nanalytic input record. It acts on exactly F1Rede.BosonicFock.F. -/\ntheorem antiunitary_fragment_inhabited :\n    ∃ j : F ≃ₛₗᵢ[starRingEnd ℂ] F,\n      Function.Involutive j ∧ j vacuum = vacuum ∧\n      (∀ x : H1, j (oneParticle x) = oneParticle (F1Rede.CanonicalWedge.Jcandidate x)) :=\n  ⟨canonicalFockJ,canonicalFockJ_involutive,canonicalFockJ_vacuum,canonicalFockJ_oneParticle⟩\n\nend F1Fecho.Antilinear\n\n#print axioms F1Fecho.Antilinear.RemainingAnalyticInput.toCertificate\n#print axioms F1Fecho.Antilinear.assembled_J_is_concrete\n#print axioms F1Fecho.Antilinear.assembled_J_on_oneParticle\n#print axioms F1Fecho.Antilinear.assembled_J_involutive\n#print axioms F1Fecho.Antilinear.assembled_J_preserves_existing_vacuum\n#print axioms F1Fecho.Antilinear.antiunitary_fragment_inhabited\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    if (`F1Fecho.Antilinear).isPrefixOf n then\n      let axs ← collectAxioms n\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\n      match ci with\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n      | _ => pure ()\n',
+    'TGLExt/F1Fecho394/ExponentialVectorsR3.lean': "import TGLExt.F1Fecho394.BosonicGammaJR5\nimport TGLExt.F1Fecho394.BosonicFockContinuity\nimport Mathlib.Analysis.Normed.Algebra.Exponential\nimport Mathlib.Analysis.SpecialFunctions.Exponential\nimport Mathlib.Analysis.Analytic.Uniqueness\nimport Mathlib.Analysis.Analytic.OfScalars\n/-! Exponential vectors in the previously constructed canonical bosonic Fock space.\nThe sectors and Hilbert direct sum are imported unchanged. This module constructs\nthe vectors by a proved l2 estimate; neither membership nor their inner kernel is\nassumed as a field. No Weyl, Tomita, KMS, or global net theorem is asserted here. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option synthInstance.maxHeartbeats 100000\nnoncomputable section\nopen UniformSpace\nopen scoped TensorProduct ENNReal\nnamespace F1Fecho.Exponential\nopen TGLExt.ImportedSQ F1Rede.BosonicSectors F1Rede.BosonicFock\n\ntheorem pureAlgebraic_inner (x y : H1) (n : ℕ) :\n    inner ℂ (pureAlgebraic x n) (pureAlgebraic y n) = (inner ℂ x y)^n := by\n  induction n with\n  | zero => change inner ℂ (1 : ℂ) 1 = _; simp\n  | succ n ih =>\n    change inner ℂ (x ⊗ₜ[ℂ] pureAlgebraic x n) (y ⊗ₜ[ℂ] pureAlgebraic y n) = _\n    rw [TensorProduct.inner_tmul, ih, pow_succ, mul_comm]\n\ntheorem pureTensor_inner (x y : H1) (n : ℕ) :\n    inner ℂ (pureTensor n x) (pureTensor n y) = (inner ℂ x y)^n := by\n  change inner ℂ (pureAlgebraic x n : Completion (Algebraic n))\n    (pureAlgebraic y n : Completion (Algebraic n)) = _\n  rw [Completion.inner_coe, pureAlgebraic_inner]\n\ntheorem pureAlgebraic_smul (z : ℂ) (x : H1) (n : ℕ) :\n    pureAlgebraic (z • x) n = z^n • pureAlgebraic x n := by\n  induction n with\n  | zero => change (1 : ℂ) = z^0 • (1 : ℂ); simp\n  | succ n ih =>\n    change (z • x) ⊗ₜ[ℂ] pureAlgebraic (z • x) n = z^(n+1) • (x ⊗ₜ[ℂ] pureAlgebraic x n)\n    rw [ih, TensorProduct.smul_tmul_smul, pow_succ']\n\ntheorem pureTensor_smul (z : ℂ) (x : H1) (n : ℕ) :\n    pureTensor n (z • x) = z^n • pureTensor n x := by\n  apply Subtype.ext\n  change (pureAlgebraic (z • x) n : Completion (Algebraic n)) =\n    z^n • (pureAlgebraic x n : Completion (Algebraic n))\n  rw [pureAlgebraic_smul, Completion.coe_smul]\n\ndef weight (n : ℕ) : ℝ := (Real.sqrt (n.factorial : ℝ))⁻¹\n\ntheorem weight_pos (n : ℕ) : 0 < weight n := by\n  unfold weight\n  positivity\n\ntheorem weight_sq (n : ℕ) : weight n ^ 2 = (n.factorial : ℝ)⁻¹ := by\n  unfold weight\n  rw [inv_pow, Real.sq_sqrt (by positivity)]\n\ntheorem complex_weight_sq (n : ℕ) : (weight n : ℂ)^2 = (n.factorial : ℂ)⁻¹ := by\n  simpa only [Complex.ofReal_pow, Complex.ofReal_inv, Complex.ofReal_natCast] using\n    congrArg (fun a : ℝ => (a : ℂ)) (weight_sq n)\n\ndef component (x : H1) (n : ℕ) : Sector n := (weight n : ℂ) • pureTensor n x\n\ntheorem component_norm_sq (x : H1) (n : ℕ) :\n    ‖component x n‖^2 = (‖x‖^2)^n / (n.factorial : ℝ) := by\n  rw [component, norm_smul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (weight_pos n), pureTensor_norm,\n    mul_pow, weight_sq]\n  rw [div_eq_mul_inv, ← pow_mul, ← pow_mul]\n  ring\n\ntheorem component_inner (x y : H1) (n : ℕ) :\n    inner ℂ (component x n) (component y n) = (inner ℂ x y)^n / (n.factorial : ℂ) := by\n  change inner ℂ ((weight n : ℂ) • pureTensor n x) ((weight n : ℂ) • pureTensor n y) = _\n  rw [_root_.inner_smul_left (pureTensor n x) ((weight n : ℂ) • pureTensor n y) (weight n : ℂ),\n    _root_.inner_smul_right (pureTensor n x) (pureTensor n y) (weight n : ℂ), pureTensor_inner]\n  simp only [Complex.conj_ofReal, ← mul_assoc]\n  rw [← pow_two, complex_weight_sq, div_eq_mul_inv, mul_comm]\n\ntheorem component_mem_lp (x : H1) : Memℓp (component x) 2 := by\n  apply (memℓp_gen_iff (by norm_num : 0 < (2 : ℝ≥0∞).toReal)).mpr\n  have hs := NormedSpace.expSeries_div_summable (‖x‖^2)\n  simpa only [ENNReal.toReal_ofNat, Real.rpow_two, component_norm_sq] using hs\n\ndef exponential (x : H1) : F := ⟨component x, component_mem_lp x⟩\n\n@[simp] theorem exponential_apply (x : H1) (n : ℕ) : exponential x n = component x n := rfl\n\ntheorem exponential_inner (x y : H1) :\n    inner ℂ (exponential x) (exponential y) = Complex.exp (inner ℂ x y) := by\n  have hs := lp.hasSum_inner (𝕜 := ℂ) (exponential x) (exponential y)\n  simp only [exponential_apply, component_inner] at hs\n  have he := NormedSpace.expSeries_div_hasSum_exp (inner ℂ x y)\n  rw [← Complex.exp_eq_exp_ℂ] at he\n  exact hs.unique he\n\ntheorem exponential_norm_sq (x : H1) : ‖exponential x‖^2 = Real.exp (‖x‖^2) := by\n  rw [F1Rede.SectorStrongContinuity.norm_sq_eq_tsum]\n  simp only [exponential_apply, component_norm_sq]\n  have he := NormedSpace.expSeries_div_hasSum_exp (‖x‖^2)\n  rw [← Real.exp_eq_exp_ℝ] at he\n  exact he.tsum_eq\n\nend F1Fecho.Exponential\n\n#print axioms F1Fecho.Exponential.pureTensor_inner\n#print axioms F1Fecho.Exponential.pureTensor_smul\n#print axioms F1Fecho.Exponential.component_mem_lp\n#print axioms F1Fecho.Exponential.exponential_inner\n#print axioms F1Fecho.Exponential.exponential_norm_sq\n",
+    'TGLExt/F1Fecho394/ExponentialTotalityR4.lean': "import TGLExt.F1Fecho394.ExponentialVectorsR3\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\n/-! Totality is derived by uniqueness of a scalar analytic power series and by\nthe actual closed-span definition of each existing symmetric sector. No density\nassumption, alternative Fock space, or nonzero placeholder is introduced. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option synthInstance.maxHeartbeats 100000\nnoncomputable section\nopen Filter Topology UniformSpace\nnamespace F1Fecho.Exponential\nopen TGLExt.ImportedSQ F1Rede.BosonicSectors F1Rede.BosonicFock\n\ntheorem component_smul (z : ℂ) (x : H1) (n : ℕ) :\n    component (z • x) n = z^n • component x n := by\n  simp only [component, pureTensor_smul, smul_smul]\n  rw [mul_comm]\n\ndef coefficient (v : F) (x : H1) (n : ℕ) : ℂ :=\n  inner ℂ (v n) (component x n)\n\ntheorem scalar_series (v : F) (x : H1) (z : ℂ) :\n    HasSum (fun n => z^n * coefficient v x n) (inner ℂ v (exponential (z • x))) := by\n  have hs := lp.hasSum_inner (𝕜 := ℂ) v (exponential (z • x))\n  have he : (fun n => inner ℂ (v n) (exponential (z • x) n)) =\n      (fun n => z^n * coefficient v x n) := by\n    funext n\n    change inner ℂ (v n) (component (z • x) n) = _\n    rw [component_smul]\n    exact _root_.inner_smul_right (v n) (component x n) (z^n)\n  rw [he] at hs\n  exact hs\n\ntheorem coefficients_zero_of_orthogonal (v : F)\n    (hv : ∀ x : H1, inner ℂ v (exponential x) = 0) (x : H1) (n : ℕ) :\n    coefficient v x n = 0 := by\n  let p := FormalMultilinearSeries.ofScalars ℂ (coefficient v x)\n  have hp : HasFPowerSeriesAt (0 : ℂ → ℂ) p 0 := by\n    apply hasFPowerSeriesAt_iff.mpr\n    apply Filter.Eventually.of_forall\n    intro z\n    simpa only [p, FormalMultilinearSeries.coeff_ofScalars, smul_eq_mul, Pi.zero_apply,\n      hv] using scalar_series v x z\n  have he := hp.apply_eq_zero n (1 : ℂ)\n  simpa only [p, FormalMultilinearSeries.ofScalars_apply_eq, one_pow, smul_eq_mul,\n    mul_one] using he\n\ntheorem pure_inner_zero_of_orthogonal (v : F)\n    (hv : ∀ x : H1, inner ℂ v (exponential x) = 0) (x : H1) (n : ℕ) :\n    inner ℂ (v n) (pureTensor n x) = 0 := by\n  have h := coefficients_zero_of_orthogonal v hv x n\n  unfold coefficient component at h\n  rw [_root_.inner_smul_right (v n) (pureTensor n x) (weight n : ℂ)] at h\n  exact (mul_eq_zero.mp h).resolve_left (by exact_mod_cast (ne_of_gt (weight_pos n)))\n\ntheorem sector_eq_zero_of_pure_inner_zero (n : ℕ) (v : Sector n)\n    (hv : ∀ x : H1, inner ℂ v (pureTensor n x) = 0) : v = 0 := by\n  let f : TensorHilbert n →L[ℂ] ℂ := innerSL ℂ (v : TensorHilbert n)\n  have hspan : algebraicSymmetricSpan n ≤ LinearMap.ker f.toLinearMap := by\n    apply Submodule.span_le.mpr\n    rintro _ ⟨x, rfl⟩\n    change inner ℂ (v : TensorHilbert n) (pureCompleted n x) = 0\n    exact hv x\n  have hclosure : symmetricSpace n ≤ LinearMap.ker f.toLinearMap :=\n    (algebraicSymmetricSpan n).topologicalClosure_minimal hspan f.isClosed_ker\n  have he : inner ℂ (v : TensorHilbert n) (v : TensorHilbert n) = 0 :=\n    hclosure v.property\n  apply Subtype.ext\n  exact inner_self_eq_zero.mp he\n\ntheorem exponential_orthogonal_zero (v : F)\n    (hv : ∀ x : H1, inner ℂ v (exponential x) = 0) : v = 0 := by\n  apply lp.ext\n  funext n\n  exact sector_eq_zero_of_pure_inner_zero n (v n)\n    (fun x => pure_inner_zero_of_orthogonal v hv x n)\n\ntheorem exponential_total :\n    (Submodule.span ℂ (Set.range exponential)).topologicalClosure = ⊤ := by\n  apply Submodule.topologicalClosure_eq_top_iff.mpr\n  apply le_antisymm _ bot_le\n  intro v hv\n  change v = 0\n  apply exponential_orthogonal_zero v\n  intro x\n  exact (Submodule.mem_orthogonal' _ v).mp hv (exponential x)\n    (Submodule.subset_span ⟨x, rfl⟩)\n\ntheorem gamma_exponential (u : H1 ≃ₗᵢ[ℂ] H1) (x : H1) :\n    gamma u (exponential x) = exponential (u x) := by\n  apply lp.ext\n  funext n\n  change gammaSector u n (component