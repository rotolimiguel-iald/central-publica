lim : Tendsto (fun h : ℝ => (B.val * F1Fecho.RegularCoreAverage.regularAverage fockFlow h) v)\n        (𝓝[>] 0) (𝓝 0) := tendsto_const_nhds.congr' he.symm\n    exact _root_.tendsto_nhds_unique hlim hzlim\n  · rintro rfl\n    exact map_zero scalarGNSRepresentation\n\ntheorem scalarGNSRepresentation_injective : Function.Injective scalarGNSRepresentation :=\n  (injective_iff_map_eq_zero' scalarGNSRepresentation).2 scalarGNSRepresentation_zero_iff\n\nend F1Fecho.CanonicalFockGNSRepresentation\n#print axioms F1Fecho.CanonicalFockGNSRepresentation.scalarGNSRepresentation\n#print axioms F1Fecho.CanonicalFockGNSRepresentation.scalarGNSEmbedding_denseRange\n#print axioms F1Fecho.CanonicalFockGNSRepresentation.scalarGNSRepresentation_zero_iff\n#print axioms F1Fecho.CanonicalFockGNSRepresentation.scalarGNSRepresentation_injective\n",
+    'TGLExt/F1Fecho394/CanonicalFockGNSNormalityR4.lean': "import TGLExt.F1Fecho394.RegularScalarGNSNormalityR2\nimport TGLExt.F1Fecho394.CanonicalFockGNSRepresentationR6\n/-! The faithful actual regular-Fock GNS representation preserves directed\npositive suprema. This is normality on this algebra, not a new modular or\nscaled trace assumption. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option synthInstance.maxSize 1024\nset_option synthInstance.maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.CanonicalFockGNSNormality\nopen TGLExt TGLV350.Regular\nopen scoped ComplexOrder\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockGNS\nopen F1Fecho.CanonicalFockGNSRepresentation\n\nlocal instance : PartialOrder (GNSHilbert →L[ℂ] GNSHilbert) :=\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := GNSHilbert)\n\ntheorem preserves_positive_isLUB\n    {ι : Type*} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]\n    (T : ι → core.toStarSubalgebra) (B : core.toStarSubalgebra)\n    (hpos : ∀ i, 0 ≤ T i) (hmono : Monotone T) (hB : IsLUB (Set.range T) B) :\n    IsLUB (Set.range (fun i => scalarGNSRepresentation (T i))) (scalarGNSRepresentation B) :=\n  F1Fecho.RegularScalarGNSNormality.scalarGNSRepresentation_preserves_positive_isLUB\n    (H := F1Rede.BosonicFock.F) weightContext T B hpos hmono hB\n\ntheorem preserves_positive_directed_isLUB\n    (S : Set core.toStarSubalgebra) (B : core.toStarSubalgebra)\n    (hne : S.Nonempty) (hdir : DirectedOn (· ≤ ·) S)\n    (hpos : ∀ A ∈ S, 0 ≤ A) (hB : IsLUB S B) :\n    IsLUB (scalarGNSRepresentation '' S) (scalarGNSRepresentation B) :=\n  F1Fecho.RegularScalarGNSNormality.scalarGNSRepresentation_preserves_positive_directed_isLUB\n    (H := F1Rede.BosonicFock.F) weightContext S B hne hdir hpos hB\n\nend F1Fecho.CanonicalFockGNSNormality\n#print axioms F1Fecho.CanonicalFockGNSNormality.preserves_positive_isLUB\n#print axioms F1Fecho.CanonicalFockGNSNormality.preserves_positive_directed_isLUB\n",
+    'TGLExt/F1Fecho394/RootRateFrequencyR2.lean': "import Mathlib.Analysis.SpecialFunctions.Pow.Real\nimport Mathlib.Tactic\n/-! Exact two-level consequence of the already stated root law, on the SAME\npositive energy spectrum and clock. beta is a parameter; no numerical value\nis inserted. A device identification, its measured rates and its energy zero\nare not consequences of this scalar algebra. -/\nset_option autoImplicit false\nset_option maxHeartbeats 500000\nnamespace F1Fecho.RootRateFrequency\nnoncomputable def rootRate (beta hbar high low : ℝ) : ℝ :=\n  beta * (Real.sqrt high-Real.sqrt low)^2 / (2*hbar)\nnoncomputable def phaseFrequency (hbar high low : ℝ) : ℝ := (high-low)/hbar\n\ntheorem phase_pos (hbar high low : ℝ) (hh : 0<hbar) (he : low<high) :\n    0 < phaseFrequency hbar high low := div_pos (sub_pos.mpr he) hh\n\ntheorem ratio_factor (beta hbar high low : ℝ) (hh : 0<hbar)\n    (hl : 0≤low) (he : low<high) :\n    rootRate beta hbar high low / phaseFrequency hbar high low =\n      (beta/2) * ((Real.sqrt high-Real.sqrt low)/(Real.sqrt high+Real.sqrt low)) := by\n  have hhigh : 0<high := lt_of_le_of_lt hl he\n  have hs : Real.sqrt low<Real.sqrt high := Real.sqrt_lt_sqrt hl he\n  have hp : 0<Real.sqrt high+Real.sqrt low :=\n    add_pos_of_pos_of_nonneg (Real.sqrt_pos.mpr hhigh) (Real.sqrt_nonneg _)\n  have hd : high-low=(Real.sqrt high-Real.sqrt low)*(Real.sqrt high+Real.sqrt low) := by\n    nlinarith [Real.sq_sqrt hl, Real.sq_sqrt hhigh.le]\n  unfold rootRate phaseFrequency\n  rw [hd]\n  field_simp [ne_of_gt hh,ne_of_gt hp,sub_ne_zero.mpr hs.ne']\n  <;> ring\n\ntheorem ratio_bounds (beta hbar high low : ℝ) (hb : 0<beta) (hh : 0<hbar)\n    (hl : 0≤low) (he : low<high) :\n    0 < rootRate beta hbar high low / phaseFrequency hbar high low ∧\n    rootRate beta hbar high low / phaseFrequency hbar high low ≤ beta/2 := by\n  rw [ratio_factor beta hbar high low hh hl he]\n  have hs := Real.sqrt_lt_sqrt hl he\n  have hp : 0<Real.sqrt high+Real.sqrt low :=\n    add_pos_of_pos_of_nonneg (Real.sqrt_pos.mpr (lt_of_le_of_lt hl he)) (Real.sqrt_nonneg _)\n  have hratio : (Real.sqrt high-Real.sqrt low)/(Real.sqrt high+Real.sqrt low) ≤ 1 := by\n    apply (div_le_one hp).mpr\n    linarith [Real.sqrt_nonneg low]\n  constructor\n  · exact mul_pos (div_pos hb (by norm_num)) (div_pos (sub_pos.mpr hs) hp)\n  · nlinarith [div_pos hb (show (0:ℝ)<2 by norm_num)]\n\ntheorem upper_bound_iff_ground_zero (beta hbar high low : ℝ)\n    (hb : 0<beta) (hh : 0<hbar) (hl : 0≤low) (he : low<high) :\n    rootRate beta hbar high low / phaseFrequency hbar high low = beta/2 ↔ low=0 := by\n  rw [ratio_factor beta hbar high low hh hl he]\n  have hp : 0<Real.sqrt high+Real.sqrt low :=\n    add_pos_of_pos_of_nonneg (Real.sqrt_pos.mpr (lt_of_le_of_lt hl he)) (Real.sqrt_nonneg _)\n  constructor\n  · intro h\n    have hr : (Real.sqrt high-Real.sqrt low)/(Real.sqrt high+Real.sqrt low)=1 := by\n      nlinarith [div_pos hb (show (0:ℝ)<2 by norm_num)]\n    have hs : Real.sqrt high-Real.sqrt low=Real.sqrt high+Real.sqrt low :=\n      (div_eq_one_iff_eq (ne_of_gt hp)).mp hr\n    have hz : Real.sqrt low=0 := by linarith\n    nlinarith [Real.sq_sqrt hl]\n  · intro h\n    subst low\n    simp [ne_of_gt (Real.sqrt_pos.mpr he)]\n\ntheorem ratio_less_than_one (beta hbar high low : ℝ)\n    (hb : 0<beta) (hb2 : beta<2) (hh : 0<hbar) (hl : 0≤low) (he : low<high) :\n    rootRate beta hbar high low / phaseFrequency hbar high low < 1 := by\n  have h := (ratio_bounds beta hbar high low hb hh hl he).2\n  linarith\n\nend F1Fecho.RootRateFrequency\n#print axioms F1Fecho.RootRateFrequency.ratio_factor\n#print axioms F1Fecho.RootRateFrequency.ratio_bounds\n#print axioms F1Fecho.RootRateFrequency.upper_bound_iff_ground_zero\n#print axioms F1Fecho.RootRateFrequency.ratio_less_than_one\n",
+    'TGLExt/F1Fecho394/DeviceRootObstructionR4.lean': 'import Mathlib.LinearAlgebra.Matrix.ConjTranspose\nimport Mathlib.Tactic\n/-!\nThe one-excitation jump already written in the device/clock contract is\nJ=|b><a|+|c><b| on the basis (a,b,c). This file formalizes the existing\nSchrodinger-picture obstruction: its isolated dissipator is not unital,\nwhereas every Hermitian-jump dissipator annihilates the identity.\nThus no change by a unital algebra equivalence, even with nonzero time scaling,\nidentifies these isolated generators. This does not exclude a dilation,\neffective reduction, additional balancing channels, or the full device model.\nIt does not concern the always-unital Heisenberg dual of a trace-preserving map.\n-/\nset_option autoImplicit false\nset_option maxHeartbeats 500000\nnoncomputable section\nnamespace F1Fecho.DeviceRootObstruction\nopen Matrix\nabbrev M := Matrix (Fin 3) (Fin 3) ℂ\n\ndef dissipator (L ρ : M) : M :=\n  L * ρ * Lᴴ - (1/2 : ℂ) • (Lᴴ * L * ρ + ρ * Lᴴ * L)\n\ntheorem dissipator_one (L : M) : dissipator L 1 = L*Lᴴ-Lᴴ*L := by\n  simp only [dissipator,mul_one,one_mul,smul_add,← add_smul]\n  norm_num\n\ntheorem hermitian_jump_annihilates_one (L : M) (hL : Lᴴ=L) : dissipator L 1 = 0 := by\n  rw [dissipator_one,hL,sub_self]\n\ndef deviceJump : M := fun i j => if (i.val=1 ∧ j.val=0) ∨ (i.val=2 ∧ j.val=1) then 1 else 0\n\ntheorem device_jump_on_one : dissipator deviceJump 1 = (fun i j => if i.val=j.val then (if i.val=0 then -1 else if i.val=2 then 1 else 0) else 0) := by\n  rw [dissipator_one]\n  ext i j\n  fin_cases i <;> fin_cases j <;>\n    norm_num [deviceJump,Matrix.mul_apply,Fin.sum_univ_three,Matrix.conjTranspose_apply]\n\ntheorem device_jump_not_unital : dissipator deviceJump 1 ≠ 0 := by\n  intro h\n  have he := congrArg (fun A : M => A 2 2) h\n  rw [device_jump_on_one] at he\n  norm_num at he\n\ndef generator (H L : M) (rate : ℂ) (ρ : M) : M :=\n  -Complex.I • (H*ρ-ρ*H) + rate • dissipator L ρ\n\ntheorem generator_one (H L : M) (rate : ℂ) :\n    generator H L rate 1 = rate • dissipator L 1 := by\n  simp [generator]\n\ntheorem no_unital_conjugacy (H K L : M) (hL : Lᴴ=L)\n    (rate otherRate : ℂ) (hrate : rate ≠ 0) (e : M ≃ₐ[ℂ] M) :\n    ¬ ∀ ρ : M, generator H deviceJump rate ρ = e (generator K L otherRate (e.symm ρ)) := by\n  intro h\n  have he := h 1\n  simp only [map_one,generator_one,hermitian_jump_annihilates_one L hL,\n    smul_zero,map_zero] at he\n  have hv := congrArg (fun A : M => A 2 2) he\n  rw [device_jump_on_one] at hv\n  simp at hv\n  exact hrate hv\n\nend F1Fecho.DeviceRootObstruction\n#print axioms F1Fecho.DeviceRootObstruction.dissipator_one\n#print axioms F1Fecho.DeviceRootObstruction.hermitian_jump_annihilates_one\n#print axioms F1Fecho.DeviceRootObstruction.device_jump_on_one\n#print axioms F1Fecho.DeviceRootObstruction.device_jump_not_unital\n#print axioms F1Fecho.DeviceRootObstruction.generator_one\n#print axioms F1Fecho.DeviceRootObstruction.no_unital_conjugacy\n',
+    'TGLExt/F1Fecho394/NetworkProofAuditR7.lean': 'import TGLExt.F1Fecho394.CanonicalModularCoreAssemblyR1\nimport TGLExt.F1Fecho394.CanonicalFockWeightClosedTomitaR2\nimport TGLExt.F1Fecho394.OrbitalSpatialCovarianceR2\nimport TGLExt.F1Fecho394.OrbitalSpatialContinuityR1\nimport TGLExt.F1Fecho394.AnnihilationDomainR1\nimport TGLExt.F1Fecho394.CanonicalFockGNSNormalityR4\nimport TGLExt.F1Fecho394.RootRateFrequencyR2\nimport TGLExt.F1Fecho394.DeviceRootObstructionR4\nimport Lean\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  let mut count := 0\n  for (n, ci) in env.constants.toList do\n    if let some idx := env.getModuleIdxFor? n then\n      let mod := env.header.moduleNames[idx]!\n      if (`TGLExt.F1Fecho394).isPrefixOf mod then\n        count := count + 1\n        let axs ← collectAxioms n\n        IO.println ("BUNDLE_DECL\\t" ++ n.toString ++ "\\t" ++ mod.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n        unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n          throwError "AXIOM_AUDIT_REFUSED: {n}"\n        match ci with\n        | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n        | _ => pure ()\n  if count == 0 then throwError "EMPTY_AUDIT_REFUSED"\n  IO.println ("BUNDLE_COUNT\\t" ++ toString count)\n',
+    'TGLExt/F1Fecho394/ExponentialCreationVectorR2.lean': 'import TGLExt.F1Fecho394.AnnihilationDomainR1\nimport TGLExt.F1Fecho394.ConcreteWeylContinuityR2\nimport Mathlib.Analysis.Complex.CauchyIntegral\n/-! Creation vectors by a Bochner Cauchy integral of the existing Fock\nexponentials. Only their previously proved continuity and Gram kernel are used.\nNo creation operator or vector differentiability is a premise. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1800000\nnoncomputable section\nopen Complex Metric\nnamespace F1Fecho.Creation\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.Exponential\n\ntheorem map_circleIntegral {E G : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]\n    [CompleteSpace E] [NormedAddCommGroup G] [NormedSpace ℂ G] [CompleteSpace G]\n    (L : E →L[ℂ] G) (v : ℂ → E) (hv : CircleIntegrable v 0 1) :\n    L (∮ z in C(0,1), v z) = ∮ z in C(0,1), L (v z) := by\n  unfold circleIntegral\n  rw [← L.intervalIntegral_comp_comm hv.out]\n  congr 1\n  funext t\n  exact L.map_smul _ _\n\ndef integrand (f g : H1) (z : ℂ) : F := (1 / z^2) • exponential (g + z • f)\n\ntheorem integrand_integrable (f g : H1) : CircleIntegrable (integrand f g) 0 1 := by\n  apply ContinuousOn.circleIntegrable (by norm_num)\n  have hn : ∀ z ∈ sphere (0 : ℂ) 1, z^2 ≠ 0 := by\n    intro z hz\n    apply pow_ne_zero\n    intro he\n    simpa [he] using hz\n  exact (continuousOn_const.div (continuousOn_id.pow 2) hn).smul\n    ((ConcreteWeyl.exponential_continuous.comp\n      (continuous_const.add (continuous_id.smul continuous_const))).continuousOn)\n\ndef creationVector (f g : H1) : F :=\n  (2 * Real.pi * I : ℂ)⁻¹ • ∮ z in C(0,1), integrand f g z\n\ntheorem exponential_inner_creationVector (h f g : H1) :\n    inner ℂ (exponential h) (creationVector f g) =\n      inner ℂ h f * Complex.exp (inner ℂ h g) := by\n  let L : F →L[ℂ] ℂ := innerSL ℂ (exponential h)\n  let v : ℂ → ℂ := fun z => Complex.exp (inner ℂ h g + z * inner ℂ h f)\n  have hd (z : ℂ) : HasDerivAt v