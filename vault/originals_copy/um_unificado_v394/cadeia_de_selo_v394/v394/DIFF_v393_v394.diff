oosts_strong\n',
+    'TGLExt/F1Fecho394/BosonicFockGroupActions.lean': 'import TGLExt.F1Fecho394.BosonicFock\n/-! Concrete translations and the canonical one-parameter wedge boosts on the\nbosonic Hilbert space. Functoriality transports the existing H1 group laws and\nboost/translation covariance. Strong continuity, positive energy, CCR and local\nalgebras are separate obligations and are not claimed in this file. -/\nset_option autoImplicit false\nset_option maxHeartbeats 800000\nnoncomputable section\n\nnamespace F1Rede.BosonicFockGroupActions\nopen TGLExt.ImportedSQ F1Rede.BosonicFock\nopen TGLExt.ContratoQGv31\nopen ChatgptAudit.WignerGeometry016\n\ndef UF (a : Fin 4 → ℝ) : F ≃ₗᵢ[ℂ] F := gamma (U1 a)\ndef VF (s : ℝ) : F ≃ₗᵢ[ℂ] F := gamma (B0 s)\n\ntheorem gamma_symm (u : H1 ≃ₗᵢ[ℂ] H1) : gamma u.symm = (gamma u).symm := by\n  have h := gamma_trans u u.symm\n  rw [LinearIsometryEquiv.self_trans_symm, gamma_refl] at h\n  apply LinearIsometryEquiv.ext\n  intro f\n  have hf := congrArg (fun e : F ≃ₗᵢ[ℂ] F => e ((gamma u).symm f)) h\n  simp only [LinearIsometryEquiv.coe_trans, Function.comp_apply,\n    LinearIsometryEquiv.apply_symm_apply] at hf\n  exact hf.symm\n\ntheorem UF_zero : UF 0 = LinearIsometryEquiv.refl ℂ F := by\n  rw [UF, U1_zero, gamma_refl]\n\ntheorem UF_add (a b : Fin 4 → ℝ) : UF (a + b) = (UF b).trans (UF a) := by\n  unfold UF\n  rw [U1_add, gamma_trans]\n\ntheorem UF_neg (a : Fin 4 → ℝ) : UF (-a) = (UF a).symm := by\n  unfold UF\n  rw [U1_neg, gamma_symm]\n\ntheorem VF_zero : VF 0 = LinearIsometryEquiv.refl ℂ F := by\n  rw [VF, B0_zero, gamma_refl]\n\ntheorem VF_add (s t : ℝ) : VF (s + t) = (VF t).trans (VF s) := by\n  unfold VF\n  rw [B0_add, gamma_trans]\n\ntheorem UF_vacuum (a : Fin 4 → ℝ) : UF a vacuum = vacuum := gamma_vacuum (U1 a)\ntheorem VF_vacuum (s : ℝ) : VF s vacuum = vacuum := gamma_vacuum (B0 s)\n\ntheorem UF_oneParticle (a : Fin 4 → ℝ) (x : H1) :\n    UF a (oneParticle x) = oneParticle (U1 a x) := gamma_oneParticle (U1 a) x\n\ntheorem VF_oneParticle (s : ℝ) (x : H1) :\n    VF s (oneParticle x) = oneParticle (B0 s x) := gamma_oneParticle (B0 s) x\n\ntheorem VF_conjugates_UF (s : ℝ) (a : Fin 4 → ℝ) :\n    ((VF s).symm.trans (UF a)).trans (VF s) = UF (wedgeBoostMap s a) := by\n  have hB : U1 (wedgeBoostMap s a) = (((B0 s).symm).trans (U1 a)).trans (B0 s) := by\n    apply LinearIsometryEquiv.ext\n    intro f\n    have h := congrArg (fun T : H1 →L[ℂ] H1 => T f) (B0_conj s a)\n    simp only [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply] at h\n    exact h.symm\n  unfold UF VF\n  rw [hB, gamma_trans, gamma_trans, gamma_symm]\n\ntheorem VF_UF_VF_symm (s : ℝ) (a : Fin 4 → ℝ) (f : F) :\n    VF s (UF a ((VF s).symm f)) = UF (wedgeBoostMap s a) f := by\n  exact congrArg (fun e : F ≃ₗᵢ[ℂ] F => e f) (VF_conjugates_UF s a)\n\nend F1Rede.BosonicFockGroupActions\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    let axs ← collectAxioms n\n    IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n    unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n      throwError "AXIOM_AUDIT_REFUSED: {n}"\n    match ci with\n    | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n    | _ => pure ()\n',
+    'TGLExt/F1Fecho394/ConcreteLightRayNet.lean': 'import TGLExt.O16.LightRayGaussianDensity_v2\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\n\n/-!\n# A concrete standard-subspace net on the light ray\n[DERIVED — sandbox candidate]\nThe objects below are constructed from the existing O16 operators and the\nexisting Fourier-transported standard subspace. No standardness or isotony\nfield is postulated. This is a real-subspace net of one-particle half-lines;\nit is not a von Neumann algebra net in four-dimensional spacetime.\nThe final negative control preserves the existing obstruction to promoting\na single null translation coordinate to faithful four-dimensional translations.\n-/\n\nnoncomputable section\nopen MeasureTheory Filter\nopen FormaInscrita.RetaDeLuz ChatgptAudit.Continuous049\nopen ChatgptAudit.FourierBridge016 ChatgptAudit.LightRayCore016\nopen TGLV350.Regular\n\nnamespace F1Rede.LightRay\n\nlocal instance : Module ℝ L2R := NormedSpace.complexToReal.toModule\nlocal instance : NormedSpace ℝ L2R := NormedSpace.complexToReal\n\ntheorem translation_add_apply (a b : ℝ) (f : L2R) :\n    U (a+b) f = U a (U b f) := by\n  rw [U_add]\n  rfl\n\ntheorem translation_inv_apply (a : ℝ) (f : L2R) : U (-a) (U a f) = f := by\n  rw [← translation_add_apply, neg_add_cancel, U_zero]\n  rfl\n\n/-- The concrete null translations are continuous complex linear equivalences. -/\ndef translationEquiv (a : ℝ) : L2R ≃L[ℂ] L2R where\n  toLinearEquiv :=\n    { (U a).toLinearMap with\n      invFun := U (-a)\n      left_inv := translation_inv_apply a\n      right_inv := by\n        intro f\n        change U a (U (-a) f) = f\n        simpa only [neg_neg] using translation_inv_apply (-a) f }\n  continuous_toFun := (U a).continuous\n  continuous_invFun := (U (-a)).continuous\n\ntheorem transport_mulI (e : L2R ≃L[ℂ] L2R) (S : ClosedSubmodule ℝ L2R) :\n    S.mulI.mapEquiv (e.restrictScalars ℝ) =\n      (S.mapEquiv (e.restrictScalars ℝ)).mulI := by\n  ext x\n  change x ∈ S.mulI.mapEquiv (e.restrictScalars ℝ) ↔\n    x ∈ (S.mapEquiv (e.restrictScalars ℝ)).mulI\n  simp only [ClosedSubmodule.mulI, ClosedSubmodule.mem_mapEquiv_iff,\n    scalarSMulCLE_symm_apply, Units.smul_def, Units.val_inv_eq_inv_val,\n    Complex.val_UnitI, Complex.inv_I]\n  change (-Complex.I) • e.symm x ∈ S ↔ e.symm ((-Complex.I) • x) ∈ S\n  rw [map_smul]\n\n/-- Standardness is proved by transport through a complex linear equivalence. -/\ndef transportStandard (e : L2R ≃L[ℂ] L2R) (K : StandardSubspace L2R) :\n    StandardSubspace L2R where\n  toClosedSubmodule := K.toClosedSubmodule.mapEquiv (e.restrictScalars ℝ)\n  IsSeparating := by\n    rw [← transport_mulI, ← ClosedSubmodule.mapEquiv_inf_eq,\n      K.IsSeparating, ClosedSubmodule.mapEquiv_bot_eq_bot]\n  IsCyclic := by\n    rw [← transport_mulI, ← ClosedSubmodule.mapEquiv_sup_eq,\n      K.IsCyclic, ClosedSubmodule.mapEquiv_top_eq_top]\n\n/-- K(a) = U(a) K(0), with the existing O16 standard subspace at a=0. -/\ndef halfline (a : ℝ) : StandardSubspace L2R :=\n  transportStandard (translationEquiv a) (rapidityStandardSubspace (2 * Real.pi^2))\n\ntheorem mem_halfline (a : ℝ) (f : L2R) :\n    f ∈ (halfline a).toClosedSubmodule ↔\n      U (-a) f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule :=\n  ClosedSubmodule.mem_mapEquiv_iff _ _ _\n\ntheorem mem_halfline_image (a : ℝ) (f : L2R) :\n    f ∈ (halfline a).toClosedSubmodule ↔\n      ∃ g ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule, U a g = f := by\n  rw [mem_halfline]\n  constructor\n  · intro hf\n    refine ⟨U (-a) f, hf, ?_⟩\n    simpa only [neg_neg] using translation_inv_apply (-a) f\n  · rintro ⟨g, hg, rfl⟩\n    simpa only [translation_inv_apply] using hg\n\ntheorem halfline_zero :\n    (halfline 0).toClosedSubmodule =\n      (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule := by\n  ext f\n  change f ∈ (halfline 0).toClosedSubmodule ↔\n    f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule\n  rw [mem_halfline]\n  simp only [neg_zero, U_zero, one_apply_eq_self]\n\n/-- Inclusion follows from the proved O16 half-sided isotony. -/\ntheorem halfline_antitone {a b : ℝ} (hab : a ≤ b) :\n    (halfline b).toClosedSubmodule ≤ (halfline a).toClosedSubmodule := by\n  intro f hf\n  obtain ⟨g, hg, rfl⟩ := (mem_halfline_image b f).mp hf\n  rw [mem_halfline, ← translation_add_apply]\n  exact halfline_isotony (-a+b) (by linarith) g hg\n\n/-- Every real translation transports the actual half-line, in both directions. -/\ntheorem translation_covariance (t a : ℝ) (f : L2R) :\n    U t f ∈ (halfline (t+a)).toClosedSubmodule ↔\n      f ∈ (halfline a).toClosedSubmodule := by\n  rw [mem_halfline, mem_halfline, ← translation_add_apply]\n  have heq : -(t+a)+t = -a := by ring\n  rw [heq]\n\ntheorem translation_image (t a : ℝ) :\n    (halfline a).toClosedSubmodule.mapEquiv ((translationEquiv t).restrictScalars ℝ) =\n      (halfline (t+a)).toClosedSubmodule := by\n  ext f\n  change f ∈ (halfline a).toClosedSubmodule.mapEquiv\n    ((translationEquiv t).restrictScalars ℝ) ↔ f ∈ (halfline (t+a)).toClosedSubmodule\n  rw [ClosedSubmodule.mem_mapEquiv_iff]\n  change U (-t) f ∈ (halfline a).toClosedSubmodule ↔\n    f ∈ (halfline (t+a)).toClosedSubmodule\n  have h := translation_covariance t a (U (-t) f)\n  simpa only [show U t (U (-t) f) = f from by\n    simpa only [neg_neg] using translation_inv_apply (-t) f] using h.symm\n\n/-- The ray cannot supply faithful four-dimensional translations through one\nlinear coordinate. This is a proved negative control, not a missing import. -/\ntheorem no_four_dimensional_promotion (ell : (Fin 4 → ℝ) →ₗ[ℝ] ℝ) :\n    ∃ a : Fin 4 → ℝ, a ≠ 0 ∧ U (ell a) = 1 :=\n  lightray_not_faithful_in_four U 1 U_zero ell\n\ntheorem phase_reflection (s x : ℝ) :\n    star (characterPhase s (-x)) = characterPhase s x := by\n  simp only [characterPhase, Complex.star_def, ← Complex.exp_conj]\n  congr 1\n  simp\n\n/-- The multiplier preserves the actual domain and fixed-point equation of\nTomita. Domain membership is obtained from the proved multiplier graph. -/\ntheorem character_preserves_standard (c s : ℝ) (f : L2R)\n    (hf : f ∈ (continuousStandardSubspace c).toClosedSubmodule) :\n    characterMultiplier s f ∈ (continuousStandardSubspace c).toClosedSubmodule := by\n  obtain ⟨hdom, hfixed⟩ := (continuous_standard_fixed_iff c f).mp hf\n  have hgraph : (characterMultiplier s f,\n      characterMultiplier s (continuousModularOperator c ⟨f, hdom⟩)) ∈\n      (continuousModularOperator c).graph := by\n    apply (continuous_modular_graph_iff c _ _).mpr\n    filter_upwards [characterMultiplier_ae s (continuousModularOperator c ⟨f, hdom⟩),\n      continuous_modular_apply_ae c ⟨f, hdom⟩, characterMultiplier_ae s f]\n      with x h1 h2 h3\n    simp only [smul_eq_mul] at h1 h3\n    rw [h1, h2, h3]\n    ring\n  have hdom\' := LinearPMap.mem_domain_of_mem_graph hgraph\n  apply (continuous_standard_fixed_iff c _).mpr\n  refine ⟨hdom\', ?_⟩\n  apply Lp.ext\n  have hfix := continuous_tomita_apply_ae c ⟨f, hdom⟩\n  rw [hfixed] at hfix\n  have hcharNeg := (Measure.measurePreserving_neg (volume : Measure ℝ)).quasiMeasurePreserving.ae\n    (characterMultiplier_ae s f)\n  filter_upwards [continuous_tomita_apply_ae c ⟨characterMultiplier s f, hdom\'⟩,\n    characterMultiplier_ae s f, hcharNeg, hfix] with x h1 h2 h3 h4\n  simp only [smul_eq_mul] at h2 h3\n  change characterMultiplier s f (-x) = characterPhase s (-x) * f (-x) at h3\n  change characterMultiplier s f x = characterPhase s x * f x at h2\n  rw [h1, h3, star_mul, phase_reflection, h2, h4]\n  ring\n\ntheorem dilation_preserves_origin (s : ℝ) (f : L2R)\n    (hf : f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule) :\n    D s f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule := by\n  rw [rapidity_standard_mem, fourier_dilation]\n  exact character_preserves_standard _ _ _ ((rapidity_standard_mem _ _).mp hf)\n\ntheorem dilation_origin_iff (s : ℝ) (f : L2R) :\n    D s f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule ↔\n      f ∈ (rapidityStandardSubspace (2 * Real.pi^2)).toClosedSubmodule := by\n  constructor\n  · intro hf\n    have h := dilation_preserves_origin (-s) (D s f) hf\n    have hinv : D (-s) (D s f) = f := by simpa only [neg_neg] using D_inv (-s) f\n    rwa [hinv] at h\n  · exact dilation_preserves_origin s f\n\ntheorem dilation_intertwines (s a : ℝ) (f : L2R) :\n    D s (U a f) = U (Real.exp (-s) * a) (D s f) := by\n  have hinv : D (-s) (D s f) = f := by simpa only [neg_neg] using D_inv (-s) f\n  simpa only [hinv] using borchers_dilation s a (D s f)\n\n/-- Exact dilation covariance of the constructed half-lines. -/\ntheorem dilation_covariance (s a : ℝ) (f : L2R) :\n    D s f ∈ (halfline (Real.exp (-s) * a)).toClosedSubmodule ↔\n      f ∈ (halfline a).toClosedSubmodule := by\n  rw [mem_halfline, mem_halfline]\n  have heq : -(Real.exp (-s) * a) = Real.exp (-s) * (-a) := by ring\n  rw [heq, ← dilation_intertwines]\n  exact dilation_origin_iff s (U (-a) f)\n\n/-- Non-vacuity follows from cyclicity and the already proved faithfulness\nof the concrete null translations, without a new inhabitedness hypothesis. -/\ntheorem halfline_ne_bot (a : ℝ) : (halfline a).toClosedSubmodule ≠ ⊥ := by\n  intro hbot\n  have hc := (halfline a).IsCyclic\n  have hzero : (⊥ : ClosedSubmodule ℝ L2R) = ⊤ := by\n    simpa only [hbot, ClosedSubmodule.mulI, ClosedSubmodule.mapEquiv_bot_eq_bot,\n      sup_bot_eq] using hc\n  have all_zero (f : L2R) : f = 0 := by\n    have hm : f ∈ (⊥ : ClosedSubmodule ℝ L2R) := by rw [hzero]; trivial\n    exact hm\n  have hu : U 1 = 1 := by\n    ext1 f\n    change U 1 f = f\n    rw [all_zero (U 1 f), all_zero f]\n  have impossible := U_faithful 1 hu\n  norm_num at impossible\n\ntheorem halfline_exists_nonzero (a : ℝ) :\n    ∃ f ∈ (halfline a).toClosedSubmodule, f ≠ 0 := by\n  by_contra h\n  push Not at h\n  apply halfline_ne_bot a\n  apply le_antisymm _ bot_le\n  intro f hf\n  change f = 0\n  exact h f hf\n\n#print axioms translationEquiv\n#print axioms transportStandard\n#print axioms halfline\n#print axioms mem_halfline_image\n#print axioms halfline_antitone\n#print axioms translation_covariance\n#print axioms translation_image\n#print axioms no_four_dimensional_promotion\n#print axioms character_preserves_standard\n#print axioms dilation_preserves_origin\n#print axioms dilation_origin_iff\n#print axioms dilation_intertwines\n#print axioms dilation_covariance\n#print axioms halfline_ne_bot\n#print axioms halfline_exists_nonzero\n\nend F1Rede.LightRay\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    let axs ← collectAxioms n\n    IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++\n      String.intercalate "," (axs.toList.map Name.toString))\n    unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n      throwError "AXIOM_AUDIT_REFUSED: {n}"\n    match ci with\n    | .axiomInfo _ => throwError "NEW_AXIOM_REFUSED: {n}"\n    | _ => pure ()\n',
+    'TGLExt/F1Fecho394/CanonicalFockAssemblyR1.lean': 'import TGLExt.F1Fecho394.BosonicFockContinuity\nimport TGLExt.F1Fecho394.BosonicFockGroupActions\nimport TGLExt.F1Fecho394.CanonicalOutput\nimport TGLExt.F1Fecho394.ConcreteLightRayNet\nimport TGLExt.QGSolutionComplete\nimport TGLExt.MaxwellLiteratureBridge\n/-!\nConcrete wiring, not a claim that the remaining imported fields are inhabited.\nThe canonical H1, standard wedge and bosonic Fock are reused without rebuilding.\nOnly genuinely remaining Fock fields are inputs. The scalar light-ray net is\nretained as a separately typed construction; no scalar-to-4D identification is\nclaimed. Gamma(J) and exponential-vector totality belong to preexisting jobs.\nNo new axiom, no physical H3 derivation, no global solution or device equivalence.\n-/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen scoped InnerProductSpace\nnamespace F1Fecho.NetworkReuse\nopen TGL.SpecificAQFT TGL.ModularRealization TGLExt.ContratoQGv31\nopen TGLExt.ContratoQGv32 TGLExt.ImportedSQ TGLExt.QGSolution\nopen F1Rede.BosonicFock\n\nstructure CanonicalNetInput extends LightNetData where\n  wedge_glue : toLightNetData.K rightWedge =\n    F1Rede.CanonicalWedge.spectralOutput.KWR.toClosedSubmodule.toSubmodule\n\ndef CanonicalNetInput.toStandardWedge (D : CanonicalNetInput) :\n    AuditF13v31.LightNetStandardWedgeDataBGL where\n  toLightNetData := D.toLightNetData\n  out := F1Rede.CanonicalWedge.spectralOutput\n  wedge_glue := D.wedge_glue\n\ntheorem canonical_wedge_nonzero (D : CanonicalNetInput) :\n    ∃ f : H1, f ∈ D.K rightWedge ∧ f ≠ 0 := by\n  obtain ⟨f,hf,hn⟩ := F1Rede.CanonicalWedge.spectralOutput_nonzero\n  refine ⟨f,?_,hn⟩\n  rw [D.wedge_glue]\n  exact hf\n\ntheorem zero_wedge_refused (D : CanonicalNetInput) : D.K rightWedge ≠ ⊥ := by\n  intro h\n  obtain ⟨f,hf,hn⟩ := canonical_wedge_nonzero D\n  rw [h] at hf\n  exact hn hf\n\ndef canonicalWedgeInFock : Submodule ℝ F :=\n  F1Rede.CanonicalWedge.spectralOutput.KWR.toClosedSubmodule.toSubmodule.map\n    (oneParticle.toLinearMap.restrictScalars ℝ)\n\ntheorem canonicalWedgeInFock_nonzero :\n    ∃ f : F, f ∈ canonicalWedgeInFock ∧ f ≠ 0 := by\n  obtain ⟨x,hx,hn⟩ := F1Rede.CanonicalWedge.spectralOutput_nonzero\n  refine ⟨oneParticle x,⟨x,hx,rfl⟩,?_⟩\n  intro hz\n  apply hn\n  apply oneParticle.injective\n  simpa using hz\n\ntheorem concrete_kinematics_inhabited :\n    ‖vacuum‖ = 1 ∧ ¬ FiniteDimensional ℂ F :=\n  ⟨vacuum_norm,infinite_dimensional⟩\n\ntheorem scalar_halfline_still_nonzero (a : ℝ) :\n    (F1Rede.LightRay.halfline a).toClosedSubmodule ≠ ⊥ :=\n  F1Rede.LightRay.halfline_ne_bot a\n\n/-- All fields below remain named inputs on the already constructed Fock.\nThis record has no asserted inhabitant. Kinematic fields are deliberately absent. -/\nstructure RemainingFockInput (L : LightOneParticle) where\n  /-- a condição espectral é preservada pela segunda quantização [KNOWN]. -/\n  Γ_positive : OneParticlePositiveEnergy →\n    ∀ a ∈ forwardCone, ∀ ψ : F, ∃ G : ℂ → ℂ, DiffContOnCl ℂ G upperHalf ∧\n      (∃ M : ℝ, ∀ z : ℂ, 0 ≤ z.im → ‖G z‖ ≤ M) ∧ (∀ t : ℝ, G t = ⟪ψ, F1Rede.BosonicFock.gamma (U1 (t • a)) ψ⟫_ℂ)\n  /-- sem espectro pontual em uma partícula ⟹ só o vácuo é fixo no Fock [KNOWN; demonstração escrita da\n      bancada, DIAMANTE_MODULAR 16/09, por Fubini]. -/\n  Γ_no_fixed : ∀ u : ℝ → (H1 ≃ₗᵢ[ℂ] H1),\n    u 0 = LinearIsometryEquiv.refl ℂ H1 → (∀ s t, u (s + t) = (u t).trans (u s)) →\n    (∀ ξ, Continuous (fun s => u s ξ)) →\n    (∀ f : H1, (∀ l : ℝ, ∃ c : ℂ, ‖c‖ = 1 ∧ u l f = c • f) → f = 0) →\n    ∀ ψ : F, (∀ l : ℝ, F1Rede.BosonicFock.gamma (u l) ψ = ψ) → ψ ∈ (ℂ ∙ F1Rede.BosonicFock.vacuum)\n  /-- a álgebra de Weyl de um subespaço real [Araki 1963]. -/\n  R : Submodule ℝ H1 → VonNeumannAlgebra F\n  R_mono : ∀ K K\' : Submodule ℝ H1, K ≤ K\' → (R K : Set (F →L[ℂ] F)) ⊆ R K\'\n  R_local : ∀ K K\' : Submodule ℝ H1, (∀ f ∈ K, ∀ g ∈ K\', (⟪f, g⟫_ℂ).im = 0) →\n    ∀ x ∈ R K, ∀ y ∈ R K\', Commute x y\n  /-- covariância funtorial: se u leva K em K\', Ad F1Rede.BosonicFock.gamma(u) leva R K em R K\'. -/\n  R_cov : ∀ (u : H1 ≃ₗᵢ[ℂ] H1) (K K\' : Submodule ℝ H1), (∀ f, f ∈ K ↔ u f ∈ K\') →\n    ∀ x : F →L[ℂ] F, x ∈ R K ↔ (F1Rede.BosonicFock.gamma u).conjStarAlgEquiv x ∈ R K\'\n  /-- Reeh–Schlieder na cunha (K(W) padrão) [Araki 1963; BGL 2002]. -/\n  wedge_cyclic : Dense ((Submodule.span ℂ\n      ((fun T : F →L[ℂ] F => T F1Rede.BosonicFock.vacuum) \'\' (R (L.K rightWedge) : Set (F →L[ℂ] F))) : Submodule ℂ F) : Set F)\n  wedge_separating : ∀ a ∈ R (L.K rightWedge), (a : F →L[ℂ] F) F1Rede.BosonicFock.vacuum = 0 → a = 0\n  wedge_nonabelian : ∃ a ∈ R (L.K rightWedge), ∃ b ∈ R (L.K rightWedge), a * b ≠ b * a\n  /-- ★ BISOGNANO–WICHMANN da luz: o boost segundo-quantizado em 2πt satisfaz KMS a β = 1 na cunha\n      [Bisognano–Wichmann 1975/76; BGL 2002 + Araki 1963]. -/\n  bw_kms : KMSBody (R (L.K rightWedge)) F1Rede.BosonicFock.vacuum (fun t => F1Rede.BosonicFock.gamma (B0 (2 * Real.pi * t))) 1\n  /-- a conjugação modular [Tomita–Takesaki; BGL 2002 — o PCT]. -/\n  J : F ≃ₛₗᵢ[starRingEnd ℂ] F\n  J_invol : ∀ ξ : F, J (J ξ) = ξ\n  J_vac : J F1Rede.BosonicFock.vacuum = F1Rede.BosonicFock.vacuum\n  /-- a realização analítica de Tomita do par [Tomita–Takesaki]. -/\n  tomita : ORDEM016.D6.PairTomitaAnalyticRealizationMeasured\n    (R (L.K rightWedge)).toStarSubalgebra F1Rede.BosonicFock.vacuum J (fun t => F1Rede.BosonicFock.gamma (B0 (-(2 * Real.pi * t))))\n  /-- o fluxo modular como automorfismo da cunha (Ad Δ^{it} preserva M) [Tomita–Takesaki]. -/\n  flow : ℝ → ((R (L.K rightWedge)).toStarSubalgebra ≃⋆ₐ[ℂ] (R (L.K rightWedge)).toStarSubalgebra)\n  flow_zero : flow 0 = StarAlgEquiv.refl\n  flow_add : ∀ s t : ℝ, flow (s + t) = (flow s).trans (flow t)\n  flow_is_Ad : ∀ (t : ℝ) (a : (R (L.K rightWedge)).toStarSubalgebra),\n    ((flow t) a).val = (F1Rede.BosonicFock.gamma (B0 (-(2 * Real.pi * t)))).conjStarAlgEquiv a.val\n  /-- o núcleo de Takesaki [Takesaki 1973]. -/\n  Core : Type\n  [instCR : Ring Core]\n  [instCS : StarRing Core]\n  [instCA : Algebra ℂ Core]\n  embedding : (R (L.K rightWedge)).toStarSubalgebra →⋆ₐ[ℂ] Core\n  embedding_injective : Function.Injective embedding\n  dualAction : ℝ → (Core ≃⋆ₐ[ℂ] Core)\n  dualAction_zero : dualAction 0 = StarAlgEquiv.refl\n  dualAction_add : ∀ s t : ℝ, dualAction (s + t) = (dualAction s).trans (dualAction t)\n  trace : Core → ENNReal\n  trace_zero : trace 0 = 0\n  trace_tracial : ∀ x y : Core, trace (x * y) = trace (y * x)\n  trace_star : ∀ x : Core, trace (star x) = trace x\n  trace_dual_scaling : ∀ (s : ℝ) (x : Core),\n    trace ((dualAction s) x) = ENNReal.ofReal (Real.exp (-s)) * trace x\n  /-- uma projeção finita não nula do núcleo II_∞, partida em duas metades de traço igual [Connes 1973]. -/\n  PF : Core\n  PF_sa : star PF = PF\n  PF_idem : PF * PF = PF\n  PF_ne : PF ≠ 0\n  PF_pos : 0 < trace PF\n  PF_fin : trace PF < ⊤\n  Pp : Core\n  Pm : Core\n  Pp_sa : star Pp = Pp\n  Pp_idem : Pp * Pp = Pp\n  Pm_sa : star Pm = Pm\n  Pm_idem : Pm * Pm = Pm\n  split : Pp + Pm = PF\n  orth : Pp * Pm = 0\n  trace_additive : trace PF = trace Pp + trace Pm\n  equal_halves : trace Pp = trace Pm\n\nattribute [instance] RemainingFockInput.instCR RemainingFockInput.instCS RemainingFockInput.instCA\n\ndef RemainingFockInput.toCertificate {L : LightOneParticle}\n    (A : RemainingFockInput L) : FockCertificate L where\n  F := F\n  instN := inferInstance\n  instI := inferInstance\n  instC := inferInstance\n  Ω := vacuum\n  Ω_norm := vacuum_norm\n  F_infinite := infinite_dimensional\n  Γ := gamma\n  Γ_refl := gamma_refl\n  Γ_trans := gamma_trans\n  Γ_vac := gamma_vacuum\n  ι := oneParticle\n  Γ_one_particle := gamma_oneParticle\n  Γ_strong := gamma_strong_real\n  Γ_strong4 := gamma_strong_spacetime\n  Γ_positive := A.Γ_positive\n  Γ_no_fixed := A.Γ_no_fixed\n  R := A.R\n  R_mono := A.R_mono\n  R_local := A.R_local\n  R_cov := A.R_cov\n  wedge_cyclic := A.wedge_cyclic\n  wedge_separating := A.wedge_separating\n  wedge_nonabelian := A.wedge_nonabelian\n  bw_kms := A.bw_kms\n  J := A.J\n  J_invol := A.J_invol\n  J_vac := A.J_vac\n  tomita := A.tomita\n  flow := A.flow\n  flow_zero := A.flow_zero\n  flow_add := A.flow_add\n  flow_is_Ad := A.flow_is_Ad\n  Core := A.Core\n  embedding := A.embedding\n  embedding_injective := A.embedding_injective\n  dualAction := A.dualAction\n  dualAction_zero := A.dualAction_zero\n  dualAction_add := A.dualAction_add\n  trace := A.trace\n  trace_zero := A.trace_zero\n  trace_tracial := A.trace_tracial\n  trace_star := A.trace_star\n  trace_dual_scaling := A.trace_dual_scaling\n  PF := A.PF\n  PF_sa := A.PF_sa\n  PF_idem := A.PF_idem\n  PF_ne := A.PF_ne\n  PF_pos := A.PF_pos\n  PF_fin := A.PF_fin\n  Pp := A.Pp\n  Pm := A.Pm\n  Pp_sa := A.Pp_sa\n  Pp_idem := A.Pp_idem\n  Pm_sa := A.Pm_sa\n  Pm_idem := A.Pm_idem\n  split := A.split\n  orth := A.orth\n  trace_additive := A.trace_additive\n  equal_halves := A.equal_halves\n  instCR := A.instCR\n  instCS := A.instCS\n  instCA := A.instCA\n\ntheorem assembled_F_is_concrete {L : LightOneParticle} (A : RemainingFockInput L) :\n    A.toCertificate.F = F := rfl\ntheorem assembled_gamma_is_concrete {L : LightOneParticle} (A : RemainingFockInput L) :\n    A.toCertificate.Γ = gamma := rfl\ntheorem assembled_inclusion_is_concrete {L : LightOneParticle} (A : RemainingFockInput L) :\n    A.toCertificate.ι = oneParticle := rfl\ntheorem assembled_boost_is_concrete {L : LightOneParticle} (A : RemainingFockInput L)\n    (s : ℝ) (f : F) : (lightBoost A.toCertificate).V s f = gamma (B0 s) f := rfl\ntheorem assembled_modular_parameter {L : LightOneParticle} (A : RemainingFockInput L)\n    (t : ℝ) : lightDelta A.toCertificate t = gamma (B0 (-(2*Real.pi*t))) := rfl\n\n/-- Existing H2/H3 consumer instantiated on this concrete kinematic Fock.\nMaxwell and the remaining analytic fields stay explicit hypotheses. -/\ntheorem canonical_contract_from_named_imports (D : CanonicalNetInput)\n    (A : RemainingFockInput D.toLightNetData.toLightOneParticle)\n    (M : MaxwellCertificate A.toCertificate) (N : KillingNormalization)\n    (G : ℝ) (hG : 0 < G) :\n    ∃ h2 : ContratoH2v32 (lightNet A.toCertificate) (lightRealization A.toCertificate) N,\n      Nonempty (ContratoImportH3v32 (lightNet A.toCertificate) (lightRealization A.toCertificate)\n        N (lightBoost A.toCertificate) M.T h2) :=\n  qg_contract_from_the_cited_net D.toLightNetData A.toCertificate M N G hG\n\nend F1Fecho.NetworkReuse\n\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    if (`F1Fecho.NetworkReuse).isPrefixOf n then\n      let axs ← collectAxioms n\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\n      match ci with\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n      | _ => pure ()\n',
