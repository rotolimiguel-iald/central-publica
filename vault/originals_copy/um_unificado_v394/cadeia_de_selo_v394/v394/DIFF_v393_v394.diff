+    'TGLExt/F1Fecho394/PairTomitaClosabilityR2.lean': "import TGLExt.O16.RecognitionGraph_v2\n/-! Generic reuse of the pairing/closure argument in TomitaClosability.lean.\nThe old proof is for TowerHilbert; this adapter accepts a commuting cyclic pair\nand uses exactly the existing pairTomitaGraph. It does not assert its polar data. -/\nset_option autoImplicit false\nset_option maxHeartbeats 800000\nnoncomputable section\nopen Set Topology\nnamespace F1Fecho.PairTomita\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nvariable (M N : StarSubalgebra ℂ (H →L[ℂ] H)) (Ω : H)\n\ndef orbit : Submodule ℂ H where\n  carrier := (fun a : H →L[ℂ] H => a Ω) '' (M : Set (H →L[ℂ] H))\n  zero_mem' := ⟨0,M.zero_mem,rfl⟩\n  add_mem' := by\n    rintro x y ⟨a,ha,rfl⟩ ⟨b,hb,rfl⟩\n    exact ⟨a+b,M.add_mem ha hb,rfl⟩\n  smul_mem' := by\n    rintro c x ⟨a,ha,rfl⟩\n    exact ⟨c • a,M.smul_mem ha c,rfl⟩\n\ntheorem span_orbit :\n    Submodule.span ℂ ((fun a : H →L[ℂ] H => a Ω) '' (M : Set (H →L[ℂ] H))) = orbit M Ω :=\n  Submodule.span_eq (orbit M Ω)\n\ntheorem dense_orbit_of_dense_span\n    (h : Dense ((Submodule.span ℂ ((fun a : H →L[ℂ] H => a Ω) ''\n      (M : Set (H →L[ℂ] H)))) : Set H)) :\n    Dense ((fun a : H →L[ℂ] H => a Ω) '' (M : Set (H →L[ℂ] H))) := by\n  rw [span_orbit] at h\n  exact h\n\nabbrev graph := ORDEM016.D6.pairTomitaGraph M Ω\n\nvariable (hc : ∀ a ∈ M, ∀ b ∈ N, Commute a b)\n\ninclude hc in\ntheorem pairing {a b : H →L[ℂ] H} (ha : a ∈ M) (hb : b ∈ N) :\n    inner ℂ ((star a) Ω) (b Ω) = inner ℂ ((star b) Ω) (a Ω) := by\n  simp only [ContinuousLinearMap.star_eq_adjoint,ContinuousLinearMap.adjoint_inner_left]\n  have h := congrArg (fun T : H →L[ℂ] H => T Ω) (hc a ha b hb).eq\n  simpa only [ContinuousLinearMap.mul_apply] using congrArg (fun x : H => inner ℂ Ω x) h\n\ninclude hc in\ntheorem closure_pairing {p : H × H} (hp : p ∈ closure (graph M Ω))\n    {b : H →L[ℂ] H} (hb : b ∈ N) :\n    inner ℂ p.2 (b Ω) = inner ℂ ((star b) Ω) p.1 := by\n  have hclosed : IsClosed {p : H × H | inner ℂ p.2 (b Ω) = inner ℂ ((star b) Ω) p.1} := by\n    apply isClosed_eq <;> fun_prop\n  apply closure_minimal (t := {p : H × H | inner ℂ p.2 (b Ω) = inner ℂ ((star b) Ω) p.1}) ?_ hclosed hp\n  rintro p ⟨a,ha,rfl⟩\n  exact pairing M N Ω hc ha hb\n\nvariable (hN : Dense ((fun b : H →L[ℂ] H => b Ω) '' (N : Set (H →L[ℂ] H))))\n\ninclude hc hN in\ntheorem closure_functional (x y z : H) (hy : (x,y) ∈ closure (graph M Ω))\n    (hz : (x,z) ∈ closure (graph M Ω)) : y = z := by\n  apply hN.eq_of_inner_left ℂ\n  rintro v ⟨b,hb,rfl⟩\n  exact (closure_pairing M N Ω hc hy hb).trans (closure_pairing M N Ω hc hz hb).symm\n\ninclude hc hN in\ntheorem closure_vertical (y : H) (hy : (0,y) ∈ closure (graph M Ω)) : y = 0 := by\n  apply hN.eq_zero_of_inner_left ℂ\n  rintro v ⟨b,hb,rfl⟩\n  simpa only [inner_zero_right] using closure_pairing M N Ω hc hy hb\n\ntheorem domain_dense (hM : Dense ((fun a : H →L[ℂ] H => a Ω) '' (M : Set (H →L[ℂ] H)))) :\n    Dense (Prod.fst '' graph M Ω) := by\n  apply Dense.mono ?_ hM\n  rintro x ⟨a,ha,rfl⟩\n  exact ⟨(a Ω,(star a) Ω),⟨a,ha,rfl⟩,rfl⟩\n\nend F1Fecho.PairTomita\n#print axioms F1Fecho.PairTomita.dense_orbit_of_dense_span\n#print axioms F1Fecho.PairTomita.pairing\n#print axioms F1Fecho.PairTomita.closure_functional\n#print axioms F1Fecho.PairTomita.closure_vertical\n#print axioms F1Fecho.PairTomita.domain_dense\n",
+    'TGLExt/F1Fecho394/PairClosedTomitaR2.lean': "import TGLExt.F1Fecho394.PairTomitaClosabilityR2\n/-! Generic reuse of ClosedTomitaOperator.lean on the actual pair graph.\nThe graph is closed here and its domain is constructed. Functionality is an\nexplicit argument, supplied by the commuting cyclic algebra theorem. This\ndoes not assert that its polar conjugation or modular group is a given one. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Set Topology\nnamespace F1Fecho.PairTomita\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nvariable {M : StarSubalgebra ℂ (H →L[ℂ] H)} {Ω : H}\n\ntheorem graph_zero : (0,0) ∈ graph M Ω := by\n  refine ⟨0,M.zero_mem,?_⟩\n  simp\n\ntheorem graph_add {p q : H × H} (hp : p ∈ graph M Ω) (hq : q ∈ graph M Ω) :\n    p+q ∈ graph M Ω := by\n  obtain ⟨a,ha,rfl⟩ := hp\n  obtain ⟨b,hb,rfl⟩ := hq\n  refine ⟨a+b,M.add_mem ha hb,?_⟩\n  simp [star_add]\n\ntheorem graph_conj_smul (c : ℂ) {p : H × H} (hp : p ∈ graph M Ω) :\n    (c • p.1, (starRingEnd ℂ c) • p.2) ∈ graph M Ω := by\n  obtain ⟨a,ha,rfl⟩ := hp\n  refine ⟨c • a,M.smul_mem ha c,?_⟩\n  simp only [star_smul,ContinuousLinearMap.smul_apply,starRingEnd_apply]\n\ntheorem graph_swap {p : H × H} (hp : p ∈ graph M Ω) : p.swap ∈ graph M Ω := by\n  obtain ⟨a,ha,rfl⟩ := hp\n  refine ⟨star a,star_mem ha,?_⟩\n  simp\n\ntheorem closed_graph_add {p q : H × H}\n    (hp : p ∈ closure (graph M Ω)) (hq : q ∈ closure (graph M Ω)) :\n    p+q ∈ closure (graph M Ω) := by\n  have hl : ∀ a ∈ graph M Ω, ∀ b ∈ closure (graph M Ω), a+b ∈ closure (graph M Ω) := by\n    intro a ha\n    exact closure_minimal (fun b hb => subset_closure (graph_add ha hb))\n      (isClosed_closure.preimage (continuous_const.add continuous_id))\n  exact closure_minimal (fun a ha => hl a ha q hq)\n    (isClosed_closure.preimage (continuous_id.add continuous_const)) hp\n\ntheorem closed_graph_conj_smul (c : ℂ) {p : H × H}\n    (hp : p ∈ closure (graph M Ω)) :\n    (c • p.1, (starRingEnd ℂ c) • p.2) ∈ closure (graph M Ω) := by\n  apply closure_minimal (t := {p : H × H |\n    (c • p.1, (starRingEnd ℂ c) • p.2) ∈ closure (graph M Ω)}) ?_ ?_ hp\n  · intro p hp\n    exact subset_closure (graph_conj_smul c hp)\n  · apply isClosed_closure.preimage\n    fun_prop\n\ntheorem closed_graph_swap {p : H × H} (hp : p ∈ closure (graph M Ω)) :\n    p.swap ∈ closure (graph M Ω) := by\n  apply closure_minimal (t := {p : H × H | p.swap ∈ closure (graph M Ω)}) ?_ ?_ hp\n  · intro p hp\n    exact subset_closure (graph_swap hp)\n  · exact isClosed_closure.preimage continuous_swap\n\ndef closedDomain (M : StarSubalgebra ℂ (H →L[ℂ] H)) (Ω : H) : Submodule ℂ H where\n  carrier := {x | ∃ y, (x,y) ∈ closure (graph M Ω)}\n  zero_mem' := ⟨0,subset_closure graph_zero⟩\n  add_mem' := by\n    rintro x z ⟨y,hy⟩ ⟨w,hw⟩\n    exact ⟨y+w,closed_graph_add hy hw⟩\n  smul_mem' := by\n    rintro c x ⟨y,hy⟩\n    exact ⟨(starRingEnd ℂ c) • y,closed_graph_conj_smul c hy⟩\n\ndef closedValue (x : closedDomain M Ω) : H := Classical.choose x.property\n\ntheorem closedValue_graph (x : closedDomain M Ω) :\n    ((x : H), closedValue x) ∈ closure (graph M Ω) := Classical.choose_spec x.property\n\ndef closedTomita\n    (hf : ∀ x y z : H, (x,y) ∈ closure (graph M Ω) → (x,z) ∈ closure (graph M Ω) → y=z) :\n    closedDomain M Ω →ₛₗ[starRingEnd ℂ] H where\n  toFun := closedValue\n  map_add' x z := by\n    apply hf ((x+z : closedDomain M Ω) : H)\n    · exact closedValue_graph (x+z)\n    · exact closed_graph_add (closedValue_graph x) (closedValue_graph z)\n  map_smul' c x := by\n    apply hf ((c • x : closedDomain M Ω) : H)\n    · exact closedValue_graph (c • x)\n    · exact closed_graph_conj_smul c (closedValue_graph x)\n\nvariable (hf : ∀ x y z : H, (x,y) ∈ closure (graph M Ω) → (x,z) ∈ closure (graph M Ω) → y=z)\n\ntheorem closedTomita_graph (x : closedDomain M Ω) :\n    ((x : H),closedTomita hf x) ∈ closure (graph M Ω) := closedValue_graph x\n\ntheorem closedTomita_graph_eq :\n    Set.range (fun x : closedDomain M Ω => ((x : H),closedTomita hf x)) = closure (graph M Ω) := by\n  ext p\n  constructor\n  · rintro ⟨x,rfl⟩\n    exact closedTomita_graph hf x\n  · intro hp\n    let x : closedDomain M Ω := ⟨p.1,p.2,hp⟩\n    refine ⟨x,?_⟩\n    apply Prod.ext\n    · rfl\n    · exact hf p.1 _ p.2 (closedTomita_graph hf x) hp\n\ntheorem closedTomita_isClosed :\n    IsClosed (Set.range (fun x : closedDomain M Ω => ((x : H),closedTomita hf x))) := by\n  rw [closedTomita_graph_eq]\n  exact isClosed_closure\n\ntheorem closedDomain_dense\n    (hM : Dense ((fun a : H →L[ℂ] H => a Ω) '' (M : Set (H →L[ℂ] H)))) :\n    Dense (closedDomain M Ω : Set H) := by\n  apply Dense.mono ?_ (domain_dense M Ω hM)\n  rintro x ⟨p,hp,rfl⟩\n  exact ⟨p.2,subset_closure hp⟩\n\ntheorem closedTomita_maps_domain (x : closedDomain M Ω) :\n    closedTomita hf x ∈ closedDomain M Ω :=\n  ⟨(x : H),closed_graph_swap (closedTomita_graph hf x)⟩\n\ntheorem closedTomita_involutive (x : closedDomain M Ω) :\n    closedTomita hf ⟨closedTomita hf x,closedTomita_maps_domain hf x⟩ = x := by\n  exact hf (closedTomita hf x) _ _\n    (closedTomita_graph hf ⟨closedTomita hf x,closedTomita_maps_domain hf x⟩)\n    (closed_graph_swap (closedTomita_graph hf x))\n\ntheorem algebra_vector_mem_domain {a : H →L[ℂ] H} (ha : a ∈ M) :\n    a Ω ∈ closedDomain M Ω := ⟨(star a) Ω,subset_closure ⟨a,ha,rfl⟩⟩\n\ntheorem closedTomita_extends_adjoint {a : H →L[ℂ] H} (ha : a ∈ M) :\n    closedTomita hf ⟨a Ω,algebra_vector_mem_domain ha⟩ = (star a) Ω := by\n  exact hf (a Ω) _ _ (closedTomita_graph hf ⟨a Ω,algebra_vector_mem_domain ha⟩)\n    (subset_closure ⟨a,ha,rfl⟩)\n\nend F1Fecho.PairTomita\n#print axioms F1Fecho.PairTomita.closedTomita\n#print axioms F1Fecho.PairTomita.closedTomita_graph_eq\n#print axioms F1Fecho.PairTomita.closedTomita_isClosed\n#print axioms F1Fecho.PairTomita.closedDomain_dense\n#print axioms F1Fecho.PairTomita.closedTomita_involutive\n#print axioms F1Fecho.PairTomita.closedTomita_extends_adjoint\n",
+    'TGLExt/F1Fecho394/WedgePairTomitaR2.lean': "import TGLExt.F1Fecho394.WedgeCyclicR3\nimport TGLExt.F1Fecho394.PairClosedTomitaR2\n/-! The closed Tomita operator of the actual Weyl algebra/vacuum pair.\nNo cyclicity, separation or closability is an input: these are derived for\nevery standard K on the same canonical one-particle/Fock realization.\nIdentification of its polar factors with Gamma(J),Gamma(Delta) is separate. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Set Topology\nnamespace F1Fecho.WedgePairTomita\nopen TGLExt.ImportedSQ F1Rede.BosonicFock\nopen F1Fecho\n\ndef algebra (K : StandardSubspace H1) : StarSubalgebra ℂ (F →L[ℂ] F) :=\n  (FieldWeyl.R K.toClosedSubmodule.toSubmodule).toStarSubalgebra\n\ntheorem orbit_dense (K : StandardSubspace H1) :\n    Dense ((fun a : F →L[ℂ] F => a vacuum) '' (algebra K : Set (F →L[ℂ] F))) :=\n  PairTomita.dense_orbit_of_dense_span (algebra K) vacuum (WedgeCyclic.vacuum_cyclic K)\n\ntheorem algebras_commute (K : StandardSubspace H1) :\n    ∀ a ∈ algebra K, ∀ b ∈ algebra K.symplComp, Commute a b := by\n  apply FieldWeyl.R_local\n  intro f hf g hg\n  exact ClosedSubmodule.mem_symplComp_iff.mp hg f hf\n\ntheorem graph_functional (K : StandardSubspace H1) (x y z : F)\n    (hy : (x,y) ∈ closure (PairTomita.graph (algebra K) vacuum))\n    (hz : (x,z) ∈ closure (PairTomita.graph (algebra K) vacuum)) : y=z :=\n  PairTomita.closure_functional (algebra K) (algebra K.symplComp) vacuum\n    (algebras_commute K) (orbit_dense K.symplComp) x y z hy hz\n\ndef domain (K : StandardSubspace H1) : Submodule ℂ F :=\n  PairTomita.closedDomain (algebra K) vacuum\n\ndef S (K : StandardSubspace H1) : domain K →ₛₗ[starRingEnd ℂ] F :=\n  PairTomita.closedTomita (graph_functional K)\n\ntheorem graph_eq (K : StandardSubspace H1) :\n    Set.range (fun x : domain K => ((x : F),S K x)) =\n      closure (ORDEM016.D6.pairTomitaGraph (algebra K) vacuum) :=\n  PairTomita.closedTomita_graph_eq (graph_fu