+    'TGLExt/F1Fecho394/OneParticleDualityR2.lean': "import TGLExt.F1Fecho394.OneParticleSymplecticR2\n/-! Exact one-particle symplectic duality for the already constructed standard\nwedge. The reverse inclusion uses the actual self-adjoint TW and its domain;\nno Haag-duality or Fock polar-identification hypothesis is introduced. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.OneParticleDuality\nopen TGLExt.ImportedSQ F1Rede.CanonicalWedge AuditF13v31\nopen ChatgptAudit.Continuous049 ChatgptAudit.Continuous050\nopen F1Fecho.OneParticleSymplectic\n\ntheorem symplectic_tomita_pairing (g : H1)\n    (hg : g ∈ KWR.symplComp.toClosedSubmodule) (x : TW.domain) :\n    inner ℂ (SW TW Jcandidate x) g = inner ℂ g (x : H1) := by\n  obtain ⟨h,k,hh,hk,hx,hs⟩ :=\n    domain_fixed_decomposition TW.domain (SW TW Jcandidate) SW_maps SW_involutive x\n  have hhK : h ∈ KWR.toClosedSubmodule := hh\n  have hkK : k ∈ KWR.toClosedSubmodule := hk\n  have hg' := ClosedSubmodule.mem_symplComp_iff.mp hg\n  have hreal : star (inner ℂ h g) = inner ℂ h g := by\n    apply Complex.ext\n    · simp only [Complex.star_def,Complex.conj_re]\n    · simp only [Complex.star_def,Complex.conj_im,hg' h hhK,neg_zero]\n  have kreal : star (inner ℂ k g) = inner ℂ k g := by\n    apply Complex.ext\n    · simp only [Complex.star_def,Complex.conj_re]\n    · simp only [Complex.star_def,Complex.conj_im,hg' k hkK,neg_zero]\n  have hswap : inner ℂ g h = inner ℂ h g := (inner_conj_symm g h).symm.trans hreal\n  have kswap : inner ℂ g k = inner ℂ k g := (inner_conj_symm g k).symm.trans kreal\n  rw [hs,hx,inner_sub_left,inner_smul_left,inner_add_right,inner_smul_right,hswap,kswap]\n  simp only [map_neg,Complex.conj_I,neg_neg]\n  ring\n\ntheorem Jcandidate_of_symplectic (g : H1)\n    (hg : g ∈ KWR.symplComp.toClosedSubmodule) :\n    Jcandidate g ∈ KWR.toClosedSubmodule := by\n  obtain ⟨hd,heq⟩ := generic_adjoint_maximal TW TW_selfadjoint Jcandidate\n    Jcandidate_involutive (fun x => symplectic_tomita_pairing g hg x)\n  change Jcandidate g ∈ TW.domain at hd\n  have hT : TW ⟨Jcandidate g,hd⟩ = g := heq\n  apply (KWR_mem _).mpr\n  refine ⟨hd,?_⟩\n  change Jcandidate (TW ⟨Jcandidate g,hd⟩) = Jcandidate g\n  rw [hT]\n\ntheorem Jcandidate_mem_symplectic_iff (g : H1) :\n    Jcandidate g ∈ KWR.symplComp.toClosedSubmodule ↔ g ∈ KWR.toClosedSubmodule := by\n  constructor\n  · intro h\n    simpa only [Jcandidate_involutive g] using Jcandidate_of_symplectic (Jcandidate g) h\n  · exact Jcandidate_into_symplectic g\n\ntheorem Jcandidate_image_equals_symplectic :\n    Jcandidate '' (KWR.toClosedSubmodule : Set H1) =\n      (KWR.symplComp.toClosedSubmodule : Set H1) := by\n  ext g\n  constructor\n  · rintro ⟨f,hf,rfl⟩\n    exact Jcandidate_into_symplectic f hf\n  · intro hg\n    exact ⟨Jcandidate g,Jcandidate_of_symplectic g hg,Jcandidate_involutive g⟩\n\nend F1Fecho.OneParticleDuality\n#print axioms F1Fecho.OneParticleDuality.symplectic_tomita_pairing\n#print axioms F1Fecho.OneParticleDuality.Jcandidate_of_symplectic\n#print axioms F1Fecho.OneParticleDuality.Jcandidate_mem_symplectic_iff\n#print axioms F1Fecho.OneParticleDuality.Jcandidate_image_equals_symplectic\n",
+    'TGLExt/F1Fecho394/WedgeNonisotropicR5.lean': "import TGLExt.F1Fecho394.OneParticleDualityR2\nimport Mathlib.MeasureTheory.Measure.Typeclasses.NoAtoms\n/-! The canonical half-modular multiplier has no fixed vector, since its\nmultiplier equals one only at a Lebesgue-null singleton. Consequently its\nstandard wedge is not symplectically isotropic. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1500000\nnoncomputable section\nopen MeasureTheory Filter\nnamespace F1Fecho.WedgeNonisotropic\nopen TGLExt.ImportedSQ F1Rede.CanonicalWedge F1Rede.Canonical AuditF13v31\nopen F1Fecho.OneParticleSymplectic F1Fecho.OneParticleDuality\n\ntheorem TW_fixed_zero (f : TW.domain) (hf : TW f = (f : H1)) : (f : H1) = 0 := by\n  have hgraph : ((f : H1),(f : H1)) ∈ TW.graph := by\n    simpa only [hf] using TW.mem_graph f\n  have hmult := (TW_multiplier (f : H1) (f : H1)).mp hgraph\n  have hzero : Phi (f : H1) = 0 := by\n    apply Lp.ext\n    filter_upwards [hmult,Measure.ae_ne (volume : Measure ℝ) 0,\n      Lp.coeFn_zero (TransverseFiber) 2 (volume : Measure ℝ)] with x hx hxn hz\n    rw [hz]\n    have he : (Real.exp (2 * Real.pi ^ 2 * x) : ℂ) ≠ 1 := by\n      intro he\n      have hr : Real.exp (2 * Real.pi ^ 2 * x) = 1 := by exact_mod_cast he\n      have harg := Real.exp_injective (hr.trans Real.exp_zero.symm)\n      have hp : 2 * Real.pi ^ 2 ≠ 0 := mul_ne_zero (by norm_num) (pow_ne_zero _ Real.pi_ne_zero)\n      exact hxn ((mul_eq_zero.mp harg).resolve_left hp)\n    have hsm : ((Real.exp (2 * Real.pi ^ 2 * x) : ℂ) - 1) • Phi (f : H1) x = 0 := by\n      rw [sub_smul,one_smul,← hx,sub_self]\n    exact (smul_eq_zero.mp hsm).resolve_left (sub_ne_zero.mpr he)\n  apply Phi.injective\n  simpa using hzero\n\ntheorem KWR_inter_JKWR_zero (f : H1) (hf : f ∈ KWR.toClosedSubmodule)\n    (hj : Jcandidate f ∈ KWR.toClosedSubmodule) : f = 0 := by\n  obtain ⟨df,tf⟩ := TW_on_KWR f hf\n  obtain ⟨dj,tj⟩ := TW_on_KWR (Jcandidate f) hj\n  have tj' : TW ⟨Jcandidate f,dj⟩ = f := by simpa only [Jcandidate_involutive f] using tj\n  have hsum : f + Jcandidate f = 0 := by\n    apply TW_fixed_zero ⟨f + Jcandidate f,TW.domain.add_mem df dj⟩\n    have h := TW.map_add ⟨f,df⟩ ⟨Jcandidate f,dj⟩\n    change TW ⟨f + Jcandidate f,TW.domain.add_mem df dj⟩ = TW ⟨f,df⟩ + TW ⟨Jcandidate f,dj⟩ at h\n    rw [tf,tj'] at h\n    exact h.trans (add_comm _ _)\n  have hjneg : Jcandidate f = -f := eq_neg_of_add_eq_zero_left (by simpa only [add_comm] using hsum)\n  have hp := TW_positive ⟨f,df⟩\n  rw [tf,hjneg,inner_neg_right,Complex.neg_re] at hp\n  change 0 ≤ -(inner ℂ f f).re at hp\n  have he : (inner ℂ f f).re = ‖f‖^2 := (norm_sq_eq_re_inner (𝕜 := ℂ) f).symm\n  rw [he] at hp\n  have hn : ‖f‖ = 0 := by\n    nlinarith [norm_nonneg f]\n  exact norm_eq_zero.mp hn\n\ntheorem KWR_not_isotropic : ∃ f ∈ KWR.toClosedSubmodule,\n    ∃ g ∈ KWR.toClosedSubmodule, (inner ℂ f g).im ≠ 0 := by\n  by_contra h\n  push_neg at h\n  obtain ⟨f,hf,hfn⟩ := spectralOutput_nonzero\n  have hf' : f ∈ KWR.toClosedSubmodule := hf\n  have hs : f ∈ KWR.symplComp.toClosedSubmodule := by\n    apply ClosedSubmodule.mem_symplComp_iff.mpr\n    intro g hg\n    exact h g hg f hf'\n  exact hfn (KWR_inter_JKWR_zero f hf' (Jcandidate_of_symplectic f hs))\n\nend F1Fecho.WedgeNonisotropic\n#print axioms F1Fecho.WedgeNonisotropic.TW_fixed_zero\n#print axioms F1Fecho.WedgeNonisotropic.KWR_inter_JKWR_zero\n#print axioms F1Fecho.WedgeNonisotropic.KWR_not_isotropic\n",
+    'TGLExt/F1Fecho394/WedgeNonabelianR4.lean': 'import TGLExt.F1Fecho394.WedgeNonisotropicR5\nimport TGLExt.F1Fecho394.FieldWeylR3\nimport Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic\n/-! Noncommuting concrete Weyl operators in the canonical standard wedge.\nThe symplectic pairing is normalized by a real rescaling inside KWR; no\nnonabelian-algebra premise is imported. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1500000\nnoncomputable section\nnamespace F1Fecho.WedgeNonabelian\nopen TGLExt.ImportedSQ F1Rede.CanonicalWedge F1Rede.BosonicFock\nopen F1Fecho.WeylCoefficients F1Fecho.WedgeNonisotropic\n\ntheorem W_ne_zero (f : H1) : FieldWeyl.W f ≠ 0 := by\n  intro h\n  have hw := FieldWeyl.W_ccr f (-f)\n  rw [h,zero_mul,phase_self_neg,add_neg_cancel,FieldWeyl.W_zero,one_smul] at hw\n  have hv := congrArg (fun a : F →L[ℂ] F => a vacuum) hw\n  have hn := congrArg norm hv\n  simp only [ContinuousLinearMap.zero_apply,ContinuousLinearMap.one_apply,norm_zero,vacuum_norm] at hn\n  norm_num at hn\n\ntheorem phase_half_pi (f g : H1) (h : (inner ℂ f g).im = Real.pi / 2) :\n    phase f g = -Complex.I ∧ phase g f = Complex.I := by\n  have hs : (inner ℂ g f).im = -(Real.pi/2) := by\n    rw [← inner_conj_symm g f]\n    simpa only [Complex.star_def,Complex.conj_im,h]\n  constructor\n  · rw [phase,h]\n    convert Complex.exp_neg_pi_div_two_mul_I using 1 <;> push_cast <;> ring\n  · rw [phase,hs]\n    convert Complex.exp_pi_div_two_mul_I using 1 <;> push_cast <;> ring\n\ntheorem normalized_pair : ∃ f ∈ KWR.toClosedSubmodule,\n    ∃ g ∈ KWR.toClosedSubmodule, (inner ℂ f g).im = Real.pi/2 := by\n  obtain ⟨f,hf,g,hg,hd⟩ := KWR_not_isotropic\n  let t : ℝ := Real.pi / (2 * (inner ℂ f g).im)\n  refine ⟨f,hf,t • g,KWR.toClosedSubmodule.toSubmodule.smul_mem t hg,?_⟩\n  rw [inner_smul_right_eq_smul,Complex.smul_im]\n  change t * (inner ℂ f g).im = Real.pi/2\n  dsimp [t]\n  field_simp [hd]\n\ntheorem wedge_nonabelian : ∃ a ∈ FieldWeyl.R KWR.toClosedSubmodule.toSubmodule,\n    ∃ b ∈ FieldWeyl.R KWR.toClosedSubmodule.toSubmodule, a*b ≠ b*a := by\n  obtain ⟨f,hf,g,hg,hfg⟩ := normalized_pair\n  refine ⟨FieldWeyl.W f,FieldWeyl.W_mem_R _ f hf,\n    FieldWeyl.W g,FieldWeyl.W_mem_R _ g hg,?_⟩\n  intro hc\n  rw [FieldWeyl.W_ccr,FieldWeyl.W_ccr,add_comm g f] at hc\n  have he := (smul_left_injective ℂ (W_ne_zero (f+g))) hc\n  obtain ⟨hp,hq⟩ := phase_half_pi f g hfg\n  rw [hp,hq] at he\n  have hi := congrArg Complex.im he\n  norm_num at hi\n\nend F1Fecho.WedgeNonabelian\n#print axioms F1Fecho.WedgeNonabelian.W_ne_zero\n#print axioms F1Fecho.WedgeNonabelian.phase_half_pi\n#print axioms F1Fecho.WedgeNonabelian.normalized_pair\n#print axioms F1Fecho.WedgeNonabelian.wedge_nonabelian\n',
+    'TGLExt/F1Fecho394/BoundedWeakAnalyticR6.lean': 'import Mathlib.Analysis.Complex.LocallyUniformLimit\nimport Mathlib.Analysis.Calculus.DiffContOnCl\nimport Mathlib.Analysis.InnerProductSpace.Projection.Basic\nimport Mathlib.Tactic\n/-! A uniformly bounded operator family is weakly analytic if all coefficients\non a total family are analytic. Closure follows from a uniform coefficient\nestimate, not from a new analyticity premise for arbitrary vectors. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nopen Filter Set\nopen scoped Topology\nnamespace F1Fecho.BoundedWeakAnalytic\nvariable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n\ntheorem coefficient_uniform_left (B : ℂ → H →L[ℂ] H) (U : Set ℂ)\n    (hB : ∀ z ∈ U, ‖B z‖ ≤ 1) (v : H) (u : ℕ → H) (x : H)\n    (hu : Tendsto u atTop (𝓝 x)) :\n    TendstoUniformlyOn (fun n z => inner ℂ (u n) (B z v))\n      (fun z => inner ℂ x (B z v)) atTop U := by\n  apply Metric.tendstoUniformlyOn_iff.mpr\n  intro ε hε\n  have ht : Tendsto (fun n => ‖u n-x‖*‖v‖) atTop (𝓝 0) := by\n    simpa using (hu.sub (tendsto_const_nhds (x := x))).norm.mul_const ‖v‖\n  filter_upwards [ht.eventually (gt_mem_nhds hε)] with n hn\n  intro z hz\n  rw [dist_comm,dist_eq_norm,← inner_sub_left]\n  calc\n    _ ≤ ‖u n-x‖*‖B z v‖ := norm_inner_le_norm _ _\n    _ ≤ ‖u n-x‖*‖v‖ := mul_le_mul_of_nonneg_left\n      ((B z).le_opNorm v |>.trans (by nlinarith [hB z hz,norm_nonneg v])) (norm_nonneg _)\n    _ < ε := hn\n\ntheorem coefficient_uniform_right (B : ℂ → H →L[ℂ] H) (U : Set ℂ)\n    (hB : ∀ z ∈ U, ‖B z‖ ≤ 1) (v : H) (u : ℕ → H) (x : H)\n    (hu : Tendsto u atTop (𝓝 x)) :\n    TendstoUniformlyOn (fun n z => inner ℂ v (B z (u n)))\n      (fun z => inner ℂ v (B z x)) atTop U := by\n  apply Metric.tendstoUniformlyOn_iff.mpr\n  intro ε hε\n  have ht : Tendsto (fun n => ‖v‖*‖u n-x‖) atTop (𝓝 0) := by\n    simpa using (hu.sub (tendsto_const_nhds (x := x))).norm.const_mul ‖v‖\n  filter_upwards [ht.eventually (gt_mem_nhds hε)] with n hn\n  intro z hz\n  rw [dist_comm,dist_eq_norm,← inner_sub_right,← map_sub]\n  calc\n    _ ≤ ‖v‖*‖B z (u n-x)‖ := norm_inner_le_norm _ _\n    _ ≤ ‖v‖*‖u n-x‖ := mul_le_mul_of_nonneg_left\n      ((B z).le_opNorm _ |>.trans (by nlinarith [hB z hz,norm_nonneg (u n-x)])) (norm_nonneg _)\n    _ < ε := hn\n\ntheorem closed_left (B : ℂ → H →L[ℂ] H) (U : Set ℂ) (hU : IsOpen U)\n    (hB : ∀ z ∈ closure U, ‖B z‖ ≤ 1) (y : H) :\n    IsClosed {x | DiffContOnCl ℂ (fun z => inner ℂ x (B z y)) U} := by\n  apply isSeqClosed_iff_isClosed.mp\n  intro u x hu hx\n  have ht := coefficient_uniform_left B (closure U) hB y u x hx\n  exact ⟨(ht.mono subset_closure).tendstoLocallyUniformlyOn.differentiableOn\n    (Eventually.of_forall fun n => (hu n).differentiableOn) hU,\n    ht.continuousOn (Filter.Eventually.frequently (Eventually.of_forall fun n => (hu n).continuousOn))⟩\n\ntheorem closed_right (B : ℂ → H →L[ℂ] H) (U : Set ℂ) (hU : IsOpen U)\n    (hB : ∀ z ∈ closure U, ‖B z‖ ≤ 1) (y : H) :\n    IsClosed {x | DiffContOnCl ℂ (fun z => inner ℂ y (B z x)) U} := by\n  apply isSeqClosed_iff_isClosed.mp\n  intro u x hu hx\n  have ht := coefficient_uniform_right B (closure U) hB y u x hx\n  exact ⟨(ht.mono subset_closure).tendstoLocallyUniformlyOn.differentiableOn\n    (Eventually.of_forall fun n => (hu n).differentiableOn) hU,\n    ht.continuousOn (Filter.Eventually.frequently (Eventually.of_forall fun n => (hu n).continuousOn))⟩\n\ntheorem of_total {I : Type*} (e : I → H)\n    (he : (Submodule.span ℂ (range e)).topologicalClosure = ⊤)\n    (B : ℂ → H →L[ℂ] H) (U : Set ℂ) (hU : IsOpen U)\n    (hB : ∀ z ∈ closure U, ‖B z‖ ≤ 1)\n    (ha : ∀ i j, DiffContOnCl ℂ (fun z => inner ℂ (e i) (B z (e j))) U) :\n    ∀ x y : H, DiffContOnCl ℂ (fun z => inner ℂ x (B z y)) U := by\n  have hd : Dense (Submodule.span ℂ (range e) : Set H) :=\n    Submodule.dense_iff_topologicalClosure_eq_top.mpr he\n  have hfirst (i : I) (y : H) : DiffContOnCl ℂ (fun z => inner ℂ (e i) (B z y)) U := by\n    apply (closed_right B U hU hB (e i)).closure_subset_iff.mpr ?_ (hd y)\n    intro y hy\n    induction hy using Submodule.span_induction with\n    | mem y hy => obtain ⟨j,rfl⟩ := hy; exact ha i j\n    | zero => simpa only [Set.mem_setOf_eq,map_zero,inner_zero_right] using (diffContOnCl_const (𝕜 := ℂ) (s := U) (c := (0:ℂ)))\n    | add y z hy hz ihy ihz => simpa only [Set.mem_setOf_eq,map_add,inner_add_right,Pi.add_def] using ihy.add ihz\n    | smul c y hy ih => simpa only [Set.mem_setOf_eq,map_smul,inner_smul_right,Pi.smul_def,smul_eq_mul] using ih.const_smul c\n  intro x y\n  apply (closed_left B U hU hB y).closure_subset_iff.mpr ?_ (hd x)\n  intro x hx\n  induction hx using Submodule.span_induction with\n  | mem x hx => obtain ⟨i,rfl⟩ := hx; exact hfirst i y\n  | zero => simpa only [Set.mem_setOf_eq,inner_zero_left] using (diffContOnCl_const (𝕜 := ℂ) (s := U) (c := (0:ℂ)))\n  | add x z hx hz ihx ihz => simpa only [Set.mem_setOf_eq,inner_add_left,Pi.add_def] using ihx.add ihz\n  | smul c x hx ih => simpa only [Set.mem_setOf_eq,inner_smul_left,Pi.smul_def,smul_eq_mul] using ih.const_smul ((starRingEnd ℂ) c)\n\nend F1Fecho.BoundedWeakAnalytic\n#print axioms F1Fecho.BoundedWeakAnalytic.coefficient_uniform_left\n#print axioms F1Fecho.BoundedWeakAnalytic.coefficient_uniform_right\n#print axioms F1Fecho.BoundedWeakAnalytic.of_total\n',
+    'TGLExt/F1Fecho394/OrbitalContractionAnalyticR1.lean': "import TGLExt.TheImportedSecondQuantization\nimport Mathlib.Analysis.InnerProductSpace.LinearMap\nimport Mathlib.Tactic\n/-! The actual orbital multiplier exp(i z p.a) on the massless H1.\nFor Im z>=0 it is contractive. The lower half-plane value is set to zero;\nonly holomorphy above and continuity on the closed upper half-plane are used. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nopen MeasureTheory Filter Set\nopen scoped InnerProductSpace ENNReal Topology\nnamespace F1Fecho.OrbitalContraction\nopen TGLExt.ImportedSQ TGLExt.ContratoQGv31 TGL.SpecificAQFT\nopen ChatgptAudit.WignerRapidityMeasure016 ChatgptAudit.WignerOrbit016\nopen ChatgptAudit.PositiveEnergy016 ChatgptAudit.UnitMultiplier016\n\ndef boundedWeight {X : Type*} [MeasurableSpace X] (μ : Measure X)\n    (u : X → ℂ) (hu : Measurable u) (hn : ∀ x, ‖u x‖ ≤ 1) : Lp ℂ ∞ μ :=\n  (memLp_top_of_bound hu.aestronglyMeasurable 1 (ae_of_all _ hn)).toLp u\n\ndef boundedMultiplier {X E : Type*} [MeasurableSpace X]\n    [NormedAddCommGroup E] [NormedSpace ℂ E] (μ : Measure X)\n    (u : X → ℂ) (hu : Measurable u) (hn : ∀ x, ‖u x‖ ≤ 1) :\n    Lp E 2 μ →L[ℂ] Lp E 2 μ :=\n  (ContinuousLinearMap.lsmul ℂ ℂ).holderL μ ∞ 2 2 (boundedWeight μ u hu hn)\n\ntheorem boundedMultiplier_ae {X E : Type*} [MeasurableSpace X]\n    [NormedAddCommGroup E] [NormedSpace ℂ E] (μ : Measure X)\n    (u : X → ℂ) (hu : Measurable u) (hn : ∀ x, ‖u x‖ ≤ 1) (f : Lp E 2 μ) :\n    boundedMultiplier μ u hu hn f =ᵐ[μ] fun x => u x • f x := by\n  have h := (ContinuousLinearMap.lsmul ℂ ℂ).coeFn_holder\n    (r := 2) (boundedWeight μ u hu hn) f\n  have hw : boundedWeight μ u hu hn =ᵐ[μ] u := MemLp.coeFn_toLp _\n  filter_upwards [h,hw] with x hx hwx\n  simpa only [boundedMultiplier,ContinuousLinearMap.holderL_apply_apply,\n    ContinuousLinearMap.lsmul_apply,hwx] using hx\n\ntheorem boundedMultiplier_norm {X E : Type*} [MeasurableSpace X]\n    [NormedAddCommGroup E] [NormedSpace ℂ E] (μ : Measure X)\n    (u : X → ℂ) (hu : Measurable u) (hn : ∀ x, ‖u x‖ ≤ 1) :\n    ‖boundedMultiplier (E := E) μ u hu hn‖ ≤ 1 := by\n  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)\n  intro f\n  simp only [one_mul]\n  apply Lp.norm_le_norm_of_ae_le\n  filter_upwards [boundedMultiplier_ae μ u hu hn f] with x hx\n  rw [hx,norm_smul]\n  exact (mul_le_mul_of_nonneg_right (hn x) (norm_nonneg _)).trans_eq (one_mul _)\n\ntheorem energy_nonneg (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (x : MomentumCoordinates) :\n    0 ≤ orbitPairing a (shellMomentum 0 x) := by\n  apply orbitalEnergy_nonnegative 0 a ha.1\n  have h := ha.2\n  unfold minkowskiSq at h\n  linarith\n\ndef V (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (z : ℂ) : H1 →L[ℂ] H1 :=\n  if hz : 0 ≤ z.im then\n    boundedMultiplier (orbitalMeasure 0) (fun x => spectralPhase z (orbitPairing a (shellMomentum 0 x)))\n      (spectralPhase_measurable _ (orbitalEnergy_measurable 0 a) z)\n      (fun x => spectralPhase_norm_le_one z _ hz (energy_nonneg a ha x))\n  else 0\n\ntheorem V_norm (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (z : ℂ) : ‖V a ha z‖ ≤ 1 := by\n  unfold V\n  split\n  · exact boundedMultiplier_norm _ _ _ _\n  · simp\n\ntheorem V_ae (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (z : ℂ) (hz : 0 ≤ z.im) (f : H1) :\n    V a ha z f =ᵐ[orbitalMeasure 0]\n      fun x => spectralPhase z (orbitPairing a (shellMomentum 0 x)) • f x := by\n  rw [V,dif_pos hz]\n  exact boundedMultiplier_ae _ _ _ _ f\n\ntheorem V_boundary (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (t : ℝ) (f : H1) :\n    V a ha t f = U1 (t • a) f := by\n  apply Lp.ext\n  have ht : (0:ℝ) ≤ (t:ℂ).im := by simp\n  have h1 := V_ae a ha t ht f\n  have h2 := unitMultiplier_ae (orbitalMeasure 0) (orbitalPhase 0 (t • a))\n    (orbitalPhase_continuous 0 (t • a)).measurable (orbitalPhase_norm 0 (t • a)) f\n  filter_upwards [h1,h2] with x hx hy\n  rw [hx,orbitalPhase_real_parameter]\n  exact hy.symm\n\ntheorem density_integral (a : Fin 4 → ℝ) (ha : a ∈ forwardCone)\n    (z : ℂ) (hz : 0 ≤ z.im) (f : H1) :\n    spectralIntegral (stateDensityMeasure (orbitalMeasure 0) f)\n      (fun x => orbitPairing a (shellMomentum 0 x)) z = inner ℂ f (V a ha z f) := by\n  have hw : AEMeasurable (fun x => ENNReal.ofReal (‖f x‖^2)) (orbitalMeasure 0) :=\n    ((Lp.aestronglyMeasurable f).norm.aemeasurable.pow_const 2).ennreal_ofReal\n  rw [spectralIntegral,stateDensityMeasure,\n    integral_withDensity_eq_integral_toReal_smul₀ hw (ae_of_all _ fun _ => ENNReal.ofReal_lt_top),L2.inner_def]\n  apply integral_congr_ae\n  filter_upwards [V_ae a ha z hz f] with x hx\n  rw [hx,inner_smul_right,inner_self_eq_norm_sq_to_K]\n  simp [ENNReal.toReal_ofReal,sq_nonneg,Complex.real_smul,mul_comm]\n\ntheorem diagonal_analytic (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (f : H1) :\n    DiffContOnCl ℂ (fun z => inner ℂ f (V a ha z f)) upperHalf := by\n  let ν := stateDensityMeasure (orbitalMeasure 0) f\n  letI : IsFiniteMeasure ν := stateDensityMeasure_finite _ f\n  have hp : a 1^2+a 2^2+a 3^2 ≤ a 0^2 := by\n    have h := ha.2\n    unfold minkowskiSq at h\n    linarith\n  have hd := orbitalSpectralIntegral_holomorphic 0 a ha.1 hp ν\n  have hc := spectralIntegral_continuous_closed ν _ (orbitalEnergy_measurable 0 a)\n    (energy_nonneg a ha)\n  constructor\n  · apply hd.congr\n    intro z hz\n    exact (density_integral a ha z hz.le f).symm\n  · change ContinuousOn _ (closure {z : ℂ | 0 < z.im})\n    rw [Complex.closure_setOf_lt_im]\n    apply hc.congr\n    intro z hz\n    exact (density_integral a ha z hz f).symm\n\ntheorem coefficient_polarization (T : H1 →L[ℂ] H1) (x y : H1) :\n    inner ℂ x (T y) = (inner ℂ (x+y) (T (x+y)) - inner ℂ (x-y) (T (x-y)) -\n      Complex.I*inner ℂ (x+Complex.I • y) (T (x+Complex.I • y)) +\n      Complex.I*inner ℂ (x-Complex.I • y) (T (x-Complex.I • y))) / 4 := by\n  simp only [map_add,map_sub,inner_add_left,inner_add_right,map_smul,inner_smul_left,\n    inner_smul_right,Complex.conj_I,← pow_two,Complex.I_sq,inner_sub_left,inner_sub_right,\n    mul_add,← mul_assoc,mul_neg,neg_neg,one_mul,neg_one_mul,mul_sub,sub_sub]\n  ring\n\ntheorem coefficient_analytic (a : Fin 4 → ℝ) (ha : a ∈ forwardCone) (f g : H1) :\n    DiffContOnCl ℂ (fun z => inner ℂ f (V a ha z g)) upperHalf := by\n  have h := (((diagonal_analytic a ha (f+g)).sub (diagonal_analytic a ha (f-g))).sub\n    ((diagonal_analytic a ha (f+Complex.I • g)).const_smul Complex.I)).add\n    ((diagonal_analytic a ha (f-Complex.I • g)).const_smul Complex.I)\n  have h' := h.const_smul (1/4:ℂ)\n  convert h' using 1\n  funext z\n  simp only [Pi.smul_apply,Pi.add_apply,Pi.sub_apply,smul_eq_mul]\n  rw [coefficient_polarization]\n  ring\n\nend F1Fecho.OrbitalContraction\n#print axioms F1Fecho.OrbitalContraction.V_norm\n#print axioms F1Fecho.OrbitalContraction.V_boundary\n#print axioms F1Fecho.OrbitalContraction.coefficient_analytic\n",
+    'TGLExt/F1Fecho394/BoundedTensorMapR2.lean': 'import Mathlib.Analysis.InnerProductSpace.TensorProduct\nimport Mathlib.LinearAlgebra.TensorProduct.Basis\nimport Mathlib.Analysis.Normed.Operator.ContinuousLinearMap\n/-! A bounded tensor map on the existing algebraic Hilbert tensor product.\nThe operator norm estimate is proved from a finite-dimensional second factor\nand an orthonormal expansion. No tensor continuity premise is assumed. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1800000\nnoncomputable section\nopen scoped TensorProduct\nopen Module\nnamespace F1Fecho.BoundedTensor\n\nvariable {E F G H : Type*}\n  [NormedAddCommGroup E] [InnerProductSpace ℂ E]\n  [NormedAddCommGroup F] [InnerProductSpace ℂ F]\n  [NormedAddCommGroup G] [InnerProductSpace ℂ G]\n  [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n\ntheorem norm_sum_tmul_sq {I : Type*} [Fintype I]\n    (v : I → E) (e : I → F) (he : Orthonormal ℂ e) :\n    ‖∑ i, v i ⊗ₜ[ℂ] e i‖^2 = ∑ i, ‖v i‖^2 := by\n  classical\n  rw [@InnerProductSpace.norm_sq_eq_re_inner ℂ]\n  simp only [sum_inner,inner_sum,TensorProduct.inner_tmul,orthonormal_iff_ite.mp he]\n  simp [inner_self_eq_norm_sq_to_K,← Complex.ofReal_pow]\n\ntheorem norm_map_first_le (A : E →L[ℂ] G) (x : E ⊗[ℂ] F) :\n    ‖TensorProduct.map A.toLinearMap (LinearMap.id : F →ₗ[ℂ] F) x‖ ≤ ‖A‖ * ‖x‖ := by\n  classical\n  obtain ⟨V,hV,hx⟩ := TensorProduct.exists_finite_submodule_right_of_setFinite\n    ({x} : Set (E ⊗[ℂ] F)) (Set.finite_singleton x)\n  letI : Module.Finite ℂ V := hV\n  obtain ⟨y,hy⟩ := Set.singleton_subset_iff.mp hx\n  let e := stdOrthonormalBasis ℂ V\n  obtain ⟨v,hv⟩ := TensorProduct.eq_repr_basis_right e.toBasis y\n  have hr : x = ∑ i, v i ⊗ₜ[ℂ] ((e i : V) : F) := by\n    rw [← hy,← hv]\n    simp [Finsupp.sum_fintype]\n  have he : Orthonormal ℂ (fun i => ((e i : V) : F)) :=\n    e.orthonormal.comp_linearIsometry V.subtypeₗᵢ\n  have hm : TensorProduct.map A.toLinearMap (LinearMap.id : F →ₗ[ℂ] F) x =\n      ∑ i, A (v i) ⊗ₜ[ℂ] ((e i : V) : F) := by\n    rw [hr]\n    simp\n  apply (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mp\n  rw [hm,norm_sum_tmul_sq _ _ he,hr,mul_pow,norm_sum_tmul_sq _ _ he,Finset.mul_sum]\n  apply Finset.sum_le_sum\n  intro i hi\n  have h := A.le_opNorm (v i)\n  simpa only [mul_pow] using\n    (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr h\n\ntheorem norm_map_second_le (B : F →L[ℂ] H) (x : E ⊗[ℂ] F) :\n    ‖TensorProduct.map (LinearMap.id : E →ₗ[ℂ] E) B.toLinearMap x‖ ≤ ‖B‖ * ‖x‖ := by\n  have he : TensorProduct.comm ℂ E H\n      (TensorProduct.map (LinearMap.id : E →ₗ[ℂ] E) B.toLinearMap x) =\n      TensorProduct.map B.toLinearMap (LinearMap.id : E →ₗ[ℂ] E) (TensorProduct.comm ℂ E F x) := by\n    induction x using TensorProduct.induction_on with\n    | zero => simp\n    | tmul x y => simp\n    | add x y hx hy => simp only [map_add,hx,hy]\n  have h := norm_map_first_le B (TensorProduct.comm ℂ E F x)\n  rw [← he,TensorProduct.norm_comm,TensorProduct.norm_comm] at h\n  exact h\n\ntheorem norm_map_le (A : E →L[ℂ] G) (B : F →L[ℂ] H) (x : E ⊗[ℂ] F) :\n    ‖TensorProduct.map A.toLinearMap B.toLinearMap x‖ ≤ (‖A‖ * ‖B‖) * ‖x‖ := by\n  have he : TensorProduct.map A.toLinearMap B.toLinearMap x =\n      TensorProduct.map A.toLinearMap (LinearMap.id : H →ₗ[ℂ] H)\n        (TensorProduct.map (LinearMap.id : E →ₗ[ℂ] E) B.toLinearMap x) := by\n    induction x using TensorProduct.induction_on with\n    | zero => simp\n    | tmul x y => simp\n    | add x y hx hy => simp only [map_add,hx,hy]\n  rw [he]\n  calc\n    _ ≤ ‖A‖ * ‖TensorProduct.map (LinearMap.id : E →ₗ[ℂ] E) B.toLinearMap x‖ :=\n      norm_map_first_le A _\n    _ ≤ ‖A‖ * (‖B‖ * ‖x‖) := mul_le_mul_of_nonneg_left (norm_map_second_le B x) (norm_nonneg _)\n    _ = _ := by ring\n\ndef mapCLM (A : E →L[ℂ] G) (B : F →L[ℂ] H) : E ⊗[ℂ] F →L[ℂ] G ⊗[ℂ] H :=\n  (TensorProduct.map A.toLinearMap B.toLinearMap).mkContinuous (‖A‖*‖B‖) (norm_map_le A B)\n\ntheorem mapCLM_tmul (A : E →