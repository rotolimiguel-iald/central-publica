calarTomitaSquareInput A x))\n        (scalarClosedTomita A (scalarTomitaSquareInput A y))) :=\n      (inner_conj_symm (𝕜 := ℂ)\n        (scalarClosedTomita A (scalarTomitaSquareInput A y))\n        (scalarClosedTomita A (scalarTomitaSquareInput A x))).symm\n    _ = (starRingEnd ℂ) (inner ℂ (scalarTomitaSquare A y) (x : H)) :=\n      congrArg (starRingEnd ℂ)\n        (scalarTomitaSquare_pairing A y (scalarTomitaSquareInput A x)).symm\n    _ = _ := inner_conj_symm (𝕜 := ℂ) (x : H) (scalarTomitaSquare A y)\n\ntheorem scalarTomitaSquare_quadratic (x : scalarTomitaSquareDomain A) :\n    (inner ℂ (x : H) (scalarTomitaSquare A x)).re =\n      ‖scalarClosedTomita A (scalarTomitaSquareInput A x)‖^2 := by\n  calc\n    _ = (inner ℂ (scalarTomitaSquare A x) (x : H)).re :=\n      inner_re_symm (𝕜 := ℂ) (x : H) (scalarTomitaSquare A x)\n    _ = (inner ℂ (scalarClosedTomita A (scalarTomitaSquareInput A x))\n        (scalarClosedTomita A (scalarTomitaSquareInput A x))).re :=\n      congrArg Complex.re (scalarTomitaSquare_pairing A x (scalarTomitaSquareInput A x))\n    _ = _ := (norm_sq_eq_re_inner (𝕜 := ℂ)\n      (scalarClosedTomita A (scalarTomitaSquareInput A x))).symm\n\ntheorem scalarTomitaSquare_positive (x : scalarTomitaSquareDomain A) :\n    0 ≤ (inner ℂ (x : H) (scalarTomitaSquare A x)).re := by\n  rw [scalarTomitaSquare_quadratic A]\n  exact sq_nonneg _\n\n#print axioms scalarTomitaSquareDomain\n#print axioms scalarTomitaSquareInput\n#print axioms scalarTomitaSquareInput_coe\n#print axioms scalarTomitaSquareInput_image_mem\n#print axioms scalarTomitaSquareAdjointInput\n#print axioms scalarTomitaSquare\n#print axioms scalarTomitaSquare_domain_iff\n#print axioms scalarTomitaSquare_apply\n#print axioms scalarTomitaSquare_pairing\n#print axioms scalarTomitaSquare_symmetric\n#print axioms scalarTomitaSquare_quadratic\n#print axioms scalarTomitaSquare_positive\n\n/-- The full range of I+S†S is obtained from the same closed graph of S. -/\ntheorem scalarTomitaSquare_resolvent_surjective (z : H) :\n    ∃ x : (scalarTomitaSquare A).domain,\n      (x : H)+scalarTomitaSquare A x=z := by\n  obtain ⟨x,hx⟩ := closedAntilinear_complex_resolvent (H := H)\n    (scalarClosedTomitaDomain A) (scalarClosedTomita A)\n    (scalarClosedTomita_is_closed A ) z\n  obtain ⟨hy,hval⟩ := scalarTomitaAdjoint_maximal A hx\n  let w : scalarTomitaSquareDomain A := ⟨(x : H),x.property,hy⟩\n  refine ⟨w,?_⟩\n  change (x : H)+scalarTomitaAdjoint A ⟨scalarClosedTomita A x,hy⟩=z\n  rw [hval]\n  abel\n\ntheorem scalarTomitaSquare_domain_dense :\n    Dense ((scalarTomitaSquare A).domain : Set (H)) :=\n  positive_surjective_resolvent_domain_dense (H := H) (scalarTomitaSquare A)\n    (scalarTomitaSquare_positive A) (scalarTomitaSquare_resolvent_surjective A)\n\n/-- Actual self-adjointness on the composition domain, not a separate model. -/\ntheorem scalarTomitaSquare_selfadjoint : IsSelfAdjoint (scalarTomitaSquare A) :=\n  positive_surjective_resolvent_selfadjoint (H := H) (scalarTomitaSquare A)\n    (scalarTomitaSquare_positive A) (scalarTomitaSquare_resolvent_surjective A)\n    (scalarTomitaSquare_symmetric A)\n\ntheorem scalarTomitaSquare_isClosed : (scalarTomitaSquare A).IsClosed :=\n  (scalarTomitaSquare_selfadjoint A).isClosed\n\ntheorem scalarClosedTomita_zero_only (x : scalarClosedTomitaDomain A)\n    (hz : scalarClosedTomita A x=0) : (x : H)=0 := by\n  have hh : (⟨scalarClosedTomita A x,scalarClosedTomita_maps_domain A x⟩ :\n      scalarClosedTomitaDomain A)=0 := Subtype.ext hz\n  have hi := scalarClosedTomita_involutive A x\n  rw [hh,map_zero] at hi\n  exact hi.symm\n\n/-- The positive self-adjoint composition has no zero vector in its kernel\napart from zero; no spectral gap is asserted. -/\ntheorem scalarTomitaSquare_zero_only (x : (scalarTomitaSquare A).domain)\n    (hz : scalarTomitaSquare A x=0) : (x : H)=0 := by\n  have hq := scalarTomitaSquare_quadratic A x\n  rw [hz,inner_zero_right] at hq\n  have hn : ‖scalarClosedTomita A (scalarTomitaSquareInput A x)‖=0 :=\n    (sq_eq_zero_iff).mp hq.symm\n  exact scalarClosedTomita_zero_only A (scalarTomitaSquareInput A x) (norm_eq_zero.mp hn)\n\n#print axioms scalarTomitaSquare_resolvent_surjective\n#print axioms scalarTomitaSquare_domain_dense\n#print axioms scalarTomitaSquare_selfadjoint\n#print axioms scalarTomitaSquare_isClosed\n#print axioms scalarClosedTomita_zero_only\n#print axioms scalarTomitaSquare_zero_only\n\n/-- A bounded resolvent of the actual S†S, on the same scalar GNS Hilbert space. -/\ndef scalarTomitaResolvent : H →L[ℂ] H :=\n  partialPositiveResolvent (H := H) (scalarTomitaSquare A) (scalarTomitaSquare_positive A)\n    (scalarTomitaSquare_resolvent_surjective A)\n\ntheorem scalarTomitaResolvent_equation (z : H) :\n    ∃ x : (scalarTomitaSquare A).domain,\n      (x : H)=scalarTomitaResolvent A z ∧\n        (x : H)+scalarTomitaSquare A x=z :=\n  partialPositiveResolvent_equation (H := H) _ _ _ z\n\ntheorem scalarTomitaResolvent_inverse (x : (scalarTomitaSquare A).domain) :\n    scalarTomitaResolvent A ((x : H)+scalarTomitaSquare A x)=\n      (x : H) :=\n  partialPositiveResolvent_inverse (H := H) _ _ _ x\n\ntheorem scalarTomitaResolvent_norm_le (z : H) :\n    ‖scalarTomitaResolvent A z‖ ≤ ‖z‖ := partialPositiveResolvent_norm_le (H := H) _ _ _ z\n\ntheorem scalarTomitaResolvent_injective : Function.Injective (scalarTomitaResolvent A) :=\n  partialPositiveResolvent_injective (H := H) _ _ _\n\ntheorem scalarTomitaResolvent_nonneg : 0 ≤ scalarTomitaResolvent A :=\n  partialPositiveResolvent_nonneg (H := H) _ _ _ (scalarTomitaSquare_symmetric A)\n\ntheorem scalarTomitaResolvent_le_one : scalarTomitaResolvent A ≤ 1 :=\n  partialPositiveResolvent_le_one (H := H) _ _ _ (scalarTomitaSquare_symmetric A)\n\ntheorem scalarTomitaResolvent_selfadjoint : IsSelfAdjoint (scalarTomitaResolvent A) :=\n  IsSelfAdjoint.of_nonneg (scalarTomitaResolvent_nonneg A)\n\n/-- Equality as partial maps includes the exact composition domain. -/\ntheorem scalarTomitaResolvent_graph :\n    resolventGraphOperator (H := H) (scalarTomitaResolvent A) (scalarTomitaResolvent_injective A) =\n      scalarTomitaSquare A :=\n  partialPositiveResolvent_graph (H := H) _ _ _\n\n#print axioms scalarTomitaResolvent\n#print axioms scalarTomitaResolvent_equation\n#print axioms scalarTomitaResolvent_inverse\n#print axioms scalarTomitaResolvent_norm_le\n#print axioms scalarTomitaResolvent_injective\n#print axioms scalarTomitaResolvent_nonneg\n#print axioms scalarTomitaResolvent_le_one\n#print axioms scalarTomitaResolvent_selfadjoint\n#print axioms scalarTomitaResolvent_graph\n\n#print axioms scalarTomitaAdjoint\n#print axioms scalarTomitaAdjoint_pairing\n#print axioms scalarTomitaAdjoint_maximal\n#print axioms scalarTomitaAdjoint_isClosed\nend F1Fecho.ClosedTomitaOperator\n',
+    'TGLExt/F1Fecho394/ClosedTomitaFlowR1.lean': 'import TGLExt.F1Fecho394.ClosedTomitaOperatorR1\n/-! Strongly continuous imaginary powers of the actual positive operator\nS_nu^* S_nu, on the Hilbert space of a closed dense antilinear involution. The complement of\nits bounded resolvent is injective because the square has trivial kernel.\nThis is not an identification with the regular conjugation group, KMS, or\nan exp(-s)-scaled trace. -/\nset_option autoImplicit false\nset_option maxErrors 2\nset_option maxHeartbeats 1800000\nset_option synthInstance.maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.ClosedTomitaFlow\nopen TGLExt TGLV350.Regular\nopen F1Fecho.ClosedTomitaOperator\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nvariable (A : Input H)\nlocal instance : PartialOrder (H →L[ℂ] H) :=\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := H)\n\ntheorem scalarTomitaResolvent_complement_injective :\n    Function.Injective (1-scalarTomitaResolvent A : H →L[ℂ] H) := by\n  intro x y h\n  apply sub_eq_zero.mp\n  have hz : (1-scalarTomitaResolvent A : H →L[ℂ] H) (x-y)=0 := by\n    rw [map_sub,h,sub_self]\n  have hfix : scalarTomitaResolvent A (x-y)=x-y := by\n    change (x-y)-scalarTomitaResolvent A (x-y)=0 at hz\n    exact (sub_eq_zero.mp hz).symm\n  obtain ⟨z,hzv,heq⟩ := scalarTomitaResolvent_equation A (x-y)\n  have he : (z:H)=x-y := hzv.trans hfix\n  have hd : scalarTomitaSquare A z=0 := by\n    rw [he] at heq\n    exact add_left_cancel (heq.trans (add_zero (x-y)).symm)\n  exact he.symm.trans (scalarTomitaSquare_zero_only A z hd)\n/-- Imaginary powers of the same S†S, defined by its already identified resolvent.\nNo identification with the regular modular automorphism is claimed here. -/\ndef scalarTomitaImaginaryPower (t : ℝ) : H ≃ₗᵢ[ℂ] H :=\n  resolventImaginaryPower (H := H) (scalarTomitaResolvent A) (scalarTomitaResolvent_nonneg A)\n    (scalarTomitaResolvent_le_one A) (scalarTomitaResolvent_injective A)\n    (scalarTomitaResolvent_complement_injective A) t\n\ntheorem scalarTomitaImaginaryPower_damping (t : ℝ) (x : H) :\n    scalarTomitaImaginaryPower A t (resolventDampingOperator (H := H) (scalarTomitaResolvent A) x)=\n      resolventPhaseOperator (H := H) (scalarTomitaResolvent A) t x :=\n  resolventImaginaryPower_damping (H := H) _ _ _ _ _ t x\n\n/-- The dense-range identity uniquely specifies this operator among bounded maps. -/\ntheorem scalarTomitaImaginaryPower_unique (t : ℝ)\n    (U : H →L[ℂ] H)\n    (hU : ∀ x, U (resolventDampingOperator (H := H) (scalarTomitaResolvent A) x)=\n      resolventPhaseOperator (H := H) (scalarTomitaResolvent A) t x) (x : H) :\n    U x=scalarTomitaImaginaryPower A t x := by\n  refine (resolventDampingOperator_denseRange (H := H) (scalarTomitaResolvent A)\n    (scalarTomitaResolvent_nonneg A) (scalarTomitaResolvent_le_one A)\n    (scalarTomitaResolvent_injective A) (scalarTomitaResolvent_complement_injective A)).induction ?_\n    (isClosed_eq (by fun_prop) (by fun_prop)) x\n  rintro _ ⟨y,rfl⟩\n  rw [hU,scalarTomitaImaginaryPower_damping A]\n\ntheorem scalarTomitaImaginaryPower_zero (x : H) :\n    scalarTomitaImaginaryPower A 0 x=x :=\n  resolventImaginaryPower_zero (H := H) _ _ _ _ _ x\n\ntheorem scalarTomitaImaginaryPower_add (s t : ℝ) (x : H) :\n    scalarTomitaImaginaryPower A s (scalarTomitaImaginaryPower A t x)=\n      scalarTomitaImaginaryPower A (s+t) x :=\n  resolventImaginaryPower_add (H := H) _ _ _ _ _ s t x\n\ntheorem scalarTomitaImaginaryPower_strongly_continuous (x : H) :\n    Continuous (fun t : ℝ => scalarTomitaImaginaryPower A t x) :=\n  resolventImaginaryPower_strongly_continuous (H := H) _ _ _ _ _ x\n\ntheorem scalarTomitaImaginaryPower_inverse (t : ℝ) (x : H) :\n    scalarTomitaImaginaryPower A (-t) (scalarTomitaImaginaryPower A t x)=x := by\n  rw [scalarTomitaImaginaryPower_add A,neg_add_cancel,scalarTomitaImaginaryPower_zero A]\n\n#print axioms scalarTomitaResolvent_complement_injective\n#print axioms scalarTomitaImaginaryPower\n#print axioms scalarTomitaImaginaryPower_damping\n#print axioms scalarTomitaImaginaryPower_unique\n#print axioms scalarTomitaImaginaryPower_zero\n#print axioms scalarTomitaImaginaryPower_add\n#print axioms scalarTomitaImaginaryPower_strongly_continuous\n#print axioms scalarTomitaImaginaryPower_inverse\nend F1Fecho.ClosedTomitaFlow\n',
+    'TGLExt/F1Fecho394/CanonicalFockWeightModularOperatorR3.lean': 'import TGLExt.F1Fecho394.ClosedTomitaOperatorR1\nimport TGLExt.F1Fecho394.CanonicalFockWeightClosedTomitaR2\n/-! Instantiation of the generic closed-involution construction with the already\nconstructed Tomita operator of the actual scalar dual-weight GNS space.\nEvery input field is paid by the preceding concrete construction. -/\nset_option autoImplicit false\nset_option maxErrors 2\nset_option maxHeartbeats 1500000\nset_option synthInstance.maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.CanonicalFockWeightModularOperator\nopen TGLExt TGLV350.Regular F1Fecho.CanonicalFockGNS\nopen F1Fecho.CanonicalFockWeightClosedTomita\nlocal instance : PartialOrder (GNSHilbert →L[ℂ] GNSHilbert) :=\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := GNSHilbert)\ndef actualClosedInput : F1Fecho.ClosedTomitaOperator.Input GNSHilbert where\n  domain := closedTomitaDomain\n  operator := closedTomita\n  dense := domain_dense\n  closed := graph_closed\n  maps_domain := maps_domain\n  involutive := involutive\nabbrev scalarTomitaAdjoint := F1Fecho.ClosedTomitaOperator.scalarTomitaAdjoint actualClosedInput\nabbrev scalarTomitaSquare := F1Fecho.ClosedTomitaOperator.scalarTomitaSquare actualClosedInput\nabbrev scalarTomitaResolvent := F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent actualClosedInput\n\ntheorem scalarTomitaSquare_domain_iff (x : GNSHilbert) :\n    x ∈ scalarTomitaSquare.domain ↔ ∃ hx : x ∈ closedTomitaDomain,\n      closedTomita ⟨x,hx⟩ ∈ scalarTomitaAdjoint.domain := Iff.rfl\n\ntheorem scalarTomitaSquare_pairing (x : scalarTomitaSquare.domain) (y : closedTomitaDomain) :\n    inner ℂ (scalarTomitaSquare x) (y : GNSHilbert) =\n      inner ℂ (closedTomita y)\n        (closedTomita (F1Fecho.ClosedTomitaOperator.scalarTomitaSquareInput actualClosedInput x)) :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_pairing actualClosedInput x y\n\ntheorem scalarTomitaSquare_positive (x : scalarTomitaSquare.domain) :\n    0 ≤ (inner ℂ (x : GNSHilbert) (scalarTomitaSquare x)).re :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_positive actualClosedInput x\n\ntheorem scalarTomitaSquare_domain_dense : Dense (scalarTomitaSquare.domain : Set GNSHilbert) :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_domain_dense actualClosedInput\n\ntheorem scalarTomitaSquare_selfadjoint : IsSelfAdjoint scalarTomitaSquare :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_selfadjoint actualClosedInput\n\ntheorem scalarTomitaSquare_isClosed : scalarTomitaSquare.IsClosed :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_isClosed actualClosedInput\n\ntheorem scalarTomitaSquare_zero_only (x : scalarTomitaSquare.domain)\n    (h : scalarTomitaSquare x = 0) : (x : GNSHilbert) = 0 :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaSquare_zero_only actualClosedInput x h\n\ntheorem scalarTomitaResolvent_equation (z : GNSHilbert) :\n    ∃ x : scalarTomitaSquare.domain, (x : GNSHilbert) = scalarTomitaResolvent z ∧\n      (x : GNSHilbert)+scalarTomitaSquare x = z :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_equation actualClosedInput z\n\ntheorem scalarTomitaResolvent_inverse (x : scalarTomitaSquare.domain) :\n    scalarTomitaResolvent ((x : GNSHilbert)+scalarTomitaSquare x) = (x : GNSHilbert) :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_inverse actualClosedInput x\n\ntheorem scalarTomitaResolvent_injective : Function.Injective scalarTomitaResolvent :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_injective actualClosedInput\n\ntheorem scalarTomitaResolvent_nonneg : 0 ≤ scalarTomitaResolvent :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_nonneg actualClosedInput\n\ntheorem scalarTomitaResolvent_le_one : scalarTomitaResolvent ≤ 1 :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_le_one actualClosedInput\n\ntheorem scalarTomitaResolvent_graph :\n    resolventGraphOperator (H := GNSHilbert) scalarTomitaResolvent scalarTomitaResolvent_injective =\n      scalarTomitaSquare :=\n  F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_graph actualClosedInput\n\nend F1Fecho.CanonicalFockWeightModularOperator\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.actualClosedInput\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaAdjoint\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_domain_iff\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_pairing\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_positive\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_domain_dense\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_selfadjoint\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_isClosed\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaSquare_zero_only\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_equation\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_inverse\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_injective\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_nonneg\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_le_one\n#print axioms F1Fecho.CanonicalFockWeightModularOperator.scalarTomitaResolvent_graph\n',
+    'TGLExt/F1Fecho394/CanonicalFockWeightModularFlowR3.lean': 'import TGLExt.F1Fecho394.ClosedTomitaFlowR1\nimport TGLExt.F1Fecho394.CanonicalFockWeightModularOperatorR3\n/-! Actual CFC imaginary powers of the scalar-weight Tomita square. The input\nclosed involution is constructed, not supplied by a modular-flow field.\nThe equality with regular conjugation and the trace law remain separate. -/\nset_option autoImplicit false\nset_option maxErrors 2\nset_option maxHeartbeats 1500000\nnoncomputable section\nnamespace F1Fecho.CanonicalFockWeightModularFlow\nopen TGLExt TGLV350.Regular F1Fecho.CanonicalFockGNS\nopen F1Fecho.CanonicalFockWeightModularOperator\nabbrev scalarTomitaImaginaryPower :=\n  F1Fecho.ClosedTomitaFlow.scalarTomitaImaginaryPower actualClosedInput\n\ntheorem scalarTomitaImaginaryPower_damping (t : ℝ) (x : GNSHilbert) :\n    scalarTomitaImaginaryPower t (resolventDampingOperator (H := GNSHilbert) scalarTomitaResolvent x)=\n      resolventPhaseOperator (H := GNSHilbert) scalarTomitaResolvent t x :=\n  F1Fecho.ClosedTomitaFlow.scalarTomitaImaginaryPower_damping actualClosedInput t x\n\ntheorem scalarTomitaImaginaryPower_unique (t : ℝ) (U : GNSHilbert →L[ℂ] GNSHilbert)\n    (hU : ∀ x, U (resolventDampingOperator (H := GNSHilbert) scalarTomitaResolvent x)=\n      resolventPhaseOperator (H := GNSHilbert) scalarTomitaResolvent t x) (x : GNSHilbert) :\n    U x=scalarTomitaImaginaryPower t x :=\n  F1Fecho.ClosedTomitaFlow.scalarTomitaImaginaryPower_unique actualClosedInput t U hU x\n\ntheorem scalarTomitaImaginaryPower_zero (x : GNSHilbert) :\n    scalarTomitaImaginaryPower 0 x=x :=\n  F1Fecho.ClosedTomitaFlow.scalarTomitaImaginaryPower_zero actualClosedInput x\n\ntheorem scalarTomitaImaginaryPower_add (s t : ℝ) (x : GNSHilbert) :\n    scalarTomitaImaginaryPower s (scalarTomitaImaginaryPower t x)=\n      scalarTomitaImaginaryPower (s+t) x :=\n  F1Fecho.ClosedTomitaFlow.scalarTomitaImaginaryPower_add actualClosedInput s t x\n\ntheorem scalarTomitaImaginaryP