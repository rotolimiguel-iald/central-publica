nner ℂ (exponential f) (exponential (TW g)) =\n      inner ℂ (exponential (halfValue f)) (exponential (halfValue g)) := by\n  rw [exponential_inner,exponential_inner,halfValue_pairing]\n\nprivate theorem gram_finite {I : Type*} (a b q : I → F)\n    (h : ∀ i j, inner ℂ (a i) (b j) = inner ℂ (q i) (q j)) (c : I →₀ ℂ) :\n    inner ℂ (c.sum (fun i z => z • a i)) (c.sum (fun i z => z • b i)) =\n      inner ℂ (c.sum (fun i z => z • q i)) (c.sum (fun i z => z • q i)) := by\n  simp only [Finsupp.sum_inner,Finsupp.inner_sum,inner_smul_left,inner_smul_right,h]\n\ntheorem coreGraph_positive (p : F × F) (hp : p ∈ coreGraph TW) :\n    0 ≤ (inner ℂ p.1 p.2).re := by\n  obtain ⟨c,rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hp\n  have hfst : (c.sum (fun i z => z • (exponential (i:H1),exponential (TW i)))).1 =\n      c.sum (fun i z => z • exponential (i:H1)) := by\n    exact map_finsuppSum (LinearMap.fst ℂ F F) _ _\n  have hsnd : (c.sum (fun i z => z • (exponential (i:H1),exponential (TW i)))).2 =\n      c.sum (fun i z => z • exponential (TW i)) := by\n    exact map_finsuppSum (LinearMap.snd ℂ F F) _ _\n  rw [hfst,hsnd,gram_finite (fun i : TW.domain => exponential i)\n    (fun i => exponential (TW i)) (fun i => exponential (halfValue i)) exponential_half_pairing]\n  exact inner_self_nonneg (𝕜 := ℂ)\n\ntheorem closedGraph_positive (p : F × F) (hp : p ∈ closedGraph TW) :\n    0 ≤ (inner ℂ p.1 p.2).re := by\n  have hc : IsClosed {q : F × F | 0 ≤ (inner ℂ q.1 q.2).re} :=\n    isClosed_le continuous_const (Complex.continuous_re.comp (continuous_fst.inner continuous_snd))\n  apply closure_minimal (fun q hq => coreGraph_positive q hq) hc\n  rw [← Submodule.topologicalClosure_coe]\n  exact hp\n\ntheorem canonicalLift_positive (x : canonicalLift.domain) :\n    0 ≤ (inner ℂ (x:F) (canonicalLift x)).re :=\n  closedGraph_positive ((x:F),canonicalLift x) (closedValue_graph TW x)\n\nend F1Fecho.ExponentialLiftPositive\n#print axioms F1Fecho.ExponentialLiftPositive.half_graph_exists\n#print axioms F1Fecho.ExponentialLiftPositive.halfValue_pairing\n#print axioms F1Fecho.ExponentialLiftPositive.exponential_half_pairing\n#print axioms F1Fecho.ExponentialLiftPositive.coreGraph_positive\n#print axioms F1Fecho.ExponentialLiftPositive.closedGraph_positive\n#print axioms F1Fecho.ExponentialLiftPositive.canonicalLift_positive\n",
+    'TGLExt/F1Fecho394/ExponentialTomitaR2.lean': "import TGLExt.F1Fecho394.ExponentialLiftR2\n\n/-! Closed, densely-defined involution obtained from the exponential lift and\nconcrete Gamma(J). This is an actual operator on the same Fock space, with a\nproved graph invariance. Equality with the Tomita operator of the Weyl algebra\nand vacuum is NOT asserted here. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\nopen Filter Topology\nnamespace F1Fecho.ExponentialTomita\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.Exponential\nopen F1Fecho.ExponentialLift F1Fecho.Antilinear F1Rede.CanonicalWedge\nopen ChatgptAudit.Continuous049 ChatgptAudit.Continuous050 AuditF13v31\n\nabbrev JF := canonicalFockJ\n\ntheorem JF_exponential (f : H1) : JF (exponential f) = exponential (Jcandidate f) :=\n  gammaJ_exponential _ _ f\n\ntheorem TW_SW (f : TW.domain) : TW ⟨SW TW Jcandidate f,SW_maps f⟩ = Jcandidate f := by\n  have h := congrArg Jcandidate (SW_involutive f)\n  change Jcandidate (Jcandidate (TW ⟨SW TW Jcandidate f,SW_maps f⟩)) = Jcandidate f at h\n  exact (Jcandidate_involutive _).symm.trans h\n\ndef flipJ (p : F × F) : F × F := (JF p.2,JF p.1)\n\ntheorem flipJ_continuous : Continuous flipJ :=\n  (JF.continuous.comp continuous_snd).prodMk (JF.continuous.comp continuous_fst)\n\ntheorem flipJ_involutive (p : F × F) : flipJ (flipJ p) = p := by\n  exact Prod.ext (canonicalFockJ_involutive p.1) (canonicalFockJ_involutive p.2)\n\ntheorem coreGraph_flipJ (p : F × F) (hp : p ∈ coreGraph TW) : flipJ p ∈ coreGraph TW := by\n  induction hp using Submodule.span_induction with\n  | mem p hp =>\n    obtain ⟨f,rfl⟩ := hp\n    have hg : (exponential (SW TW Jcandidate f),\n        exponential (TW ⟨SW TW Jcandidate f,SW_maps f⟩)) ∈ coreGraph TW :=\n      Submodule.subset_span ⟨⟨SW TW Jcandidate f,SW_maps f⟩,rfl⟩\n    rw [TW_SW] at hg\n    change (JF (exponential (TW f)),JF (exponential f)) ∈ coreGraph TW\n    rw [JF_exponential,JF_exponential]\n    exact hg\n  | zero =>\n    change (JF 0,JF 0) ∈ coreGraph TW\n    rw [map_zero]\n    exact (coreGraph TW).zero_mem\n  | add p q hp hq ihp ihq =>\n    have he : flipJ (p+q) = flipJ p + flipJ q := by\n      apply Prod.ext <;> simp only [flipJ,Prod.fst_add,Prod.snd_add,map_add]\n    rw [he]\n    exact (coreGraph TW).add_mem ihp ihq\n  | smul c p hp ih =>\n    have he : flipJ (c • p) = star c • flipJ p := by\n      apply Prod.ext <;> exact JF.map_smulₛₗ c _\n    rw [he]\n    exact (coreGraph TW).smul_mem (star c) ih\n\ntheorem closedGraph_flipJ (p : F × F) (hp : p ∈ closedGraph TW) :\n    flipJ p ∈ closedGraph TW := by\n  have hc : IsClosed {q : F × F | flipJ q ∈ closedGraph TW} :=\n    (coreGraph TW).isClosed_topologicalClosure.preimage flipJ_continuous\n  have hi : closure (coreGraph TW : Set (F × F)) ⊆ {q : F × F | flipJ q ∈ closedGraph TW} :=\n    closure_minimal (fun q hq => (coreGraph TW).le_topologicalClosure (coreGraph_flipJ q hq)) hc\n  apply hi\n  rw [← Submodule.topologicalClosure_coe]\n  exact hp\n\n/-- Constructed exponential Tomita candidate, without algebra identification. -/\ndef Sexp : canonicalLift.domain →ₛₗ[starRingEnd ℂ] F :=\n  (genericTomita canonicalLift JF).toFun\n\ntheorem Sexp_maps_domain (x : canonicalLift.domain) : Sexp x ∈ canonicalLift.domain :=\n  ⟨JF x,closedGraph_flipJ ((x:F),canonicalLift x) (closedValue_graph TW x)⟩\n\ntheorem Sexp_involutive (x : canonicalLift.domain) :\n    Sexp ⟨Sexp x,Sexp_maps_domain x⟩ = x := by\n  have h : canonicalLift ⟨Sexp x,Sexp_maps_domain x⟩ = JF x :=\n    closedGraph_functional TW TW_selfadjoint (Sexp x) _ _\n      (closedValue_graph TW ⟨Sexp x,Sexp_maps_domain x⟩)\n      (closedGraph_flipJ ((x:F),canonicalLift x) (closedValue_graph TW x))\n  change JF (canonicalLift ⟨Sexp x,Sexp_maps_domain x⟩) = (x:F)\n  rw [h]\n  exact canonicalFockJ_involutive x\n\ntheorem Sexp_graph_iff (p : F × F) :\n    p ∈ Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) ↔\n      (p.1,JF p.2) ∈ closedGraph TW := by\n  constructor\n  · rintro ⟨x,rfl⟩\n    change ((x:F),JF (JF (canonicalLift x))) ∈ closedGraph TW\n    rw [canonicalFockJ_involutive]\n    exact closedValue_graph TW x\n  · intro hp\n    let x : canonicalLift.domain := ⟨p.1,JF p.2,hp⟩\n    have h : canonicalLift x = JF p.2 :=\n      closedGraph_functional TW TW_selfadjoint p.1 _ _ (closedValue_graph TW x) hp\n    refine ⟨x,?_⟩\n    apply Prod.ext\n    · rfl\n    · change JF (canonicalLift x) = p.2\n      rw [h]\n      exact canonicalFockJ_involutive p.2\n\ntheorem Sexp_closed :\n    IsClosed (Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x))) := by\n  have he : Set.range (fun x : canonicalLift.domain => ((x:F),Sexp x)) =\n      (fun p : F × F => (p.1,JF p.2)) ⁻¹' (closedGraph TW : Set (F × F)) := by\n    ext p\n    exact Sexp_graph_iff p\n  rw [he]\n  exact (coreGraph TW).isClosed_topologicalClosure.preimage\n    (continuous_fst.prodMk (JF.continuous.comp continuous_snd))\n\ntheorem Sexp_dense : Dense (canonicalLift.domain : Set F) := canonicalLift_dense\n\ntheorem Sexp_exponential (f : TW.domain) :\n    Sexp ⟨exponential f,exponential_mem_domain TW f⟩ = exponential (SW TW Jcandidate f) := by\n  change JF (canonicalLift ⟨exponential f,exponential_mem_domain TW f⟩) = _\n  rw [canonicalLift_exponential,JF_exponential]\n  rfl\n\nend F1Fecho.ExponentialTomita\n#print axioms F1Fecho.ExponentialTomita.TW_SW\n#print axioms F1Fecho.ExponentialTomita.coreGraph_flipJ\n#print axioms F1Fecho.ExponentialTomita.closedGraph_flipJ\n#print axioms F1Fecho.ExponentialTomita.Sexp_maps_domain\n#print axioms F1Fecho.ExponentialTomita.Sexp_involutive\n#print axioms F1Fecho.ExponentialTomita.Sexp_graph_iff\n#print axioms F1Fecho.ExponentialTomita.Sexp_closed\n#print axioms F1Fecho.ExponentialTomita.Sexp_dense\n#print axioms F1Fecho.ExponentialTomita.Sexp_exponential\n",
+    'TGLExt/F1Fecho394/RegularCovariantCoreR3.lean': 'import TGLExt.V350RegularDualAction\n/-! Generic regular covariant representation, faithful generated-algebra embedding\nand dual action for an actual strongly continuous unitary flow. No trace or\nmodular-state identification is assumed or asserted. The concrete Fock flow is\nan instance supplied in the separate consumer, not a claimed hypothetical one. -/\nset_option autoImplicit false\nset_option maxHeartbeats 400000\nnoncomputable section\nnamespace F1Fecho.RegularCovariantCore\nopen TGLV350.Regular\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nstructure UnitaryFlow (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] where\n  U : ℝ → H ≃ₗᵢ[ℂ] H\n  zero : U 0 = .refl ℂ H\n  add : ∀ s t, U (s+t) = (U t).trans (U s)\n  strong : ∀ v, Continuous (fun t => U t v)\nvariable (B : UnitaryFlow H)\n\ndef boostIso (t : ℝ) : H ≃ₗᵢ[ℂ] H := B.U t\ndef boostCLM (t : ℝ) : H →L[ℂ] H := (boostIso B t).toLinearIsometry.toContinuousLinearMap\n\ntheorem boostIso_zero : boostIso B 0 = .refl ℂ H := B.zero\n\ntheorem boostIso_add (s t : ℝ) : boostIso B (s+t) = (boostIso B t).trans (boostIso B s) := B.add s t\n\ntheorem boostIso_neg (t : ℝ) : boostIso B (-t) = (boostIso B t).symm := by\n  apply LinearIsometryEquiv.ext\n  intro v\n  apply (boostIso B t).injective\n  rw [LinearIsometryEquiv.apply_symm_apply]\n  have h := congrArg (fun u : H ≃ₗᵢ[ℂ] H => u v) (boostIso_add B t (-t))\n  have hz := h.symm\n  simp only [add_neg_cancel,boostIso_zero B,LinearIsometryEquiv.trans_apply] at hz\n  exact hz\n\ntheorem boostCLM_zero : boostCLM B 0 = 1 := by rw [boostCLM,boostIso_zero B]; rfl\n\ntheorem boostCLM_mul (s t : ℝ) : boostCLM B s * boostCLM B t = boostCLM B (s+t) := by\n  apply ContinuousLinearMap.ext\n  intro v\n  change boostIso B s (boostIso B t v) = boostIso B (s+t) v\n  rw [boostIso_add B]\n  rfl\n\ntheorem boostCLM_eq_coe (t : ℝ) :\n    boostCLM B t = (boostIso B t : H →L[ℂ] H) := by\n  apply ContinuousLinearMap.ext\n  intro v\n  rfl\n\ntheorem boostCLM_star (t : ℝ) : star (boostCLM B t) = boostCLM B (-t) := by\n  rw [boostCLM_eq_coe B,LinearIsometryEquiv.star_eq_symm,boostCLM_eq_coe B,boostIso_neg B]\n\ntheorem boostIso_strong (v : H) : Continuous (fun t : ℝ => boostIso B t v) := by\n  exact B.strong v\n\ndef automorphism (t : ℝ) : (H →L[ℂ] H) ≃⋆ₐ[ℂ] (H →L[ℂ] H) := (boostIso B t).conjStarAlgEquiv\n\ntheorem boostAd_sandwich (t : ℝ) (A : H →L[ℂ] H) :\n    automorphism B t A = boostCLM B t * A * star (boostCLM B t) := by\n  rw [boostCLM_eq_coe B,LinearIsometryEquiv.star_eq_symm]\n  rfl\n\ndef regularUnitary (t : ℝ) : RegularHilbert H →L[ℂ] RegularHilbert H :=\n  fibre (boostCLM B t) * shift t\n\ntheorem regular_zero : regularUnitary B 0 = 1 := by\n  simp only [regularUnitary,boostCLM_zero B,fibre_one,shift_zero,mul_one]\n\ntheorem regular_mul (s t : ℝ) : regularUnitary B s * regularUnitary B t = regularUnitary B (s+t) := by\n  unfold regularUnitary\n  calc\n    (fibre (boostCLM B s) * shift s) * (fibre (boostCLM B t) * shift t)\n      = fibre (boostCLM B s) * (shift s * fibre (boostCLM B t)) * shift t := by simp only [mul_assoc]\n    _ = fibre (boostCLM B s) * (fibre (boostCLM B t) * shift s) * shift t := by rw [shift_commutes_fibre]\n    _ = (fibre (boostCLM B s) * fibre (boostCLM B t)) * (shift s * shift t) := by simp only [mul_assoc]\n    _ = fibre (boostCLM B (s+t)) * shift (s+t) := by rw [← fibre_mul,boostCLM_mul B,shift_mul]\n\ntheorem regular_star (t : ℝ) : star (regularUnitary B t) = regularUnitary B (-t) := by\n  unfold regularUnitary\n  rw [star_mul,shift_star,← fibre_star,boostCLM_star B,shift_commutes_fibre]\n\ntheorem regular_unitary (t : ℝ) : star (regularUnitary B t) * regularUnitary B t = 1 ∧\n    regularUnitary B t * star (regularUnitary B t) = 1 := by\n  constructor\n  · rw [regular_star B,regular_mul B,neg_add_cancel,regular_zero B]\n  · rw [regular_star B,regular_mul B,add_neg_cancel,regular_zero B]\n\ntheorem regular_covariance (t : ℝ) (A : H →L[ℂ] H) :\n    regularUnitary B t * fibre A * star (regularUnitary B t) =\n      fibre (automorphism B t A) := by\n  rw [boostAd_sandwich B,fibre_mul,fibre_mul,fibre_star]\n  unfold regularUnitary\n  calc\n    _ = fibre (boostCLM B t) * (shift t * fibre A * star (shift (H := H) t)) *\n      star (fibre (boostCLM B t)) := by simp only [star_mul,mul_assoc]\n    _ = _ := by rw [shift_star,shift_fibre_sandwich]\n\ntheorem regular_strongly_continuous (f : RegularHilbert H) :\n    Continuous (fun t : ℝ => regularUnitary B t f) := by\n  have h := fibre_jointly_continuous (H := H) (Z := ℝ)\n    (fun t => (boostIso B t).toLinearIsometry) (boostIso_strong B)\n  have hp : Continuous (fun t : ℝ => (shift (H := H) t f,t)) :=\n    (shift_strongly_continuous f).prodMk continuous_id\n  refine (h.comp hp).congr ?_\n  intro t\n  change fibre (boostIso B t).toLinearIsometry.toContinuousLinearMap (shift t f) = regularUnitary B t f\n  rfl\n\ndef generators (M : VonNeumannAlgebra H) : Set (RegularHilbert H →L[ℂ] RegularHilbert H) :=\n  (fibre \'\' (M : Set (H →L[ℂ] H))) ∪ Set.range (regularUnitary B)\n\ndef core (M : VonNeumannAlgebra H) : VonNeumannAlgebra (RegularHilbert H) :=\n  generatedAlgebra (generators B M)\n\ntheorem fibre_mem (M : VonNeumannAlgebra H) (A : H →L[ℂ] H) (hA : A ∈ M) : fibre A ∈ core B M :=\n  generator_mem (Or.inl ⟨A,hA,rfl⟩)\n\ntheorem regular_mem (M : VonNeumannAlgebra H) (t : ℝ) : regularUnitary B t ∈ core B M :=\n  generator_mem (Or.inr ⟨t,rfl⟩)\n\ndef amplification (M : VonNeumannAlgebra H) : M.toStarSubalgebra →⋆ₐ[ℂ]\n    (RegularHilbert H →L[ℂ] RegularHilbert H) :=\n  fibreRepresentation.comp M.toStarSubalgebra.subtype\n\ndef embedding (M : VonNeumannAlgebra H) : M.toStarSubalgebra →⋆ₐ[ℂ] (core B M).toStarSubalgebra :=\n  (amplification M).codRestrict (core B M).toStarSubalgebra (fun A => fibre_mem B M A A.property)\n\ntheorem embedding_injective (M : VonNeumannAlgebra H) : Function.Injective (embedding B M) := by\n  intro A B h\n  apply Subtype.ext\n  apply fibre_injective\n  exact congrArg Subtype.val h\n\ntheorem core_minimal (M : VonNeumannAlgebra H) (N : VonNeumannAlgebra (RegularHilbert H))\n    (hM : ∀ A ∈ M, fibre A ∈ N) (hU : ∀ t : ℝ, regularUnitary B t ∈ N) : core B M ≤ N := by\n  apply generated_minimal (generators B M) N\n  intro A hA\n  rcases hA with ⟨A0,hA0,rfl⟩ | ⟨t,rfl⟩\n  · exact hM A0 hA0\n  · exact hU t\n\ntheorem dual_on_regular (s t : ℝ) :\n    dualAmbient s (regularUnitary B t) = characterPhase s t • regularUnitary B t := by\n  rw [dualAmbient_apply]\n  unfold regularUnitary\n  calc\n    _ = fibre (boostCLM B t) * (characterMultiplier s * shift t *\n      star (characterMultiplier (H := H) s)) := by\n      rw [← mul_assoc (characterMultiplier s),characterMultiplier_commutes_fibre]\n      simp only [mul_assoc]\n    _ = _ := by rw [characterMultiplier_weyl,mul_smul_comm]; rfl\n\ntheorem dual_preserves_generators (M : VonNeumannAlgebra H) (s : ℝ) :\n    ∀ A ∈ generators B M, dualAmbient s A ∈ core B M := by\n  intro A hA\n  rcases hA with ⟨A0,hA0,rfl⟩ | ⟨t,rfl⟩\n  · rw [dualAmbient_fibre]\n    exact fibre_mem B M A0 hA0\n  · rw [dual_on_regular B]\n    exact (core B M).toStarSubalgebra.smul_mem (regular_mem B M t) _\n\ndef dualAction (M : VonNeumannAlgebra H) (s : ℝ) :\n    (core B M).toStarSubalgebra ≃⋆ₐ[ℂ] (core B M).toStarSubalgebra :=\n  generatedAutomorphism (dualAmbient s) (generators B M) (dual_preserves_generators B M s) (by\n    rw [dualAmbient_symm (H := H)]\n    exact dual_preserves_generators B M (-s))\n\ntheorem dualAction_zero (M : VonNeumannAlgebra H) : dualAction B M 0 = StarAlgEquiv.refl := by\n  apply StarAlgEquiv.ext\n  intro A\n  apply Subtype.ext\n  change dualAmbient (H := H) 0 (A : RegularHilbert H →L[ℂ] RegularHilbert H) = A\n  rw [dualAmbient_zero (H := H)]\n  rfl\n\ntheorem dualAction_add (M : VonNeumannAlgebra H) (s t : ℝ) :\n    dualAction B M (s+t) = (dualAction B M s).trans (dualAction B M t) := by\n  apply StarAlgEquiv.ext\n  intro A\n  apply Subtype.