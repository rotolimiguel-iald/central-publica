 axioms TGLExt.RuleContinuousMotor.rule_on_inscriptions_is_equality\n#print axioms TGLExt.RuleContinuousMotor.target\n#print axioms TGLExt.RuleContinuousMotor.target4\n#print axioms TGLExt.RuleContinuousMotor.target4_fixed\n#print axioms TGLExt.RuleContinuousMotor.target4_nonzero\n#print axioms TGLExt.RuleContinuousMotor.target_is_fixed\n#print axioms TGLExt.RuleContinuousMotor.target_nonzero\n#print axioms TGLExt.RuleContinuousMotor.unique_sound_complete_rule\n#print axioms TGLExt.RuleContinuousMotor.vector_motor_rule_ignores_rate_and_time\n#print axioms TGLExt.RuleContinuousMotor.vector_motor_satisfies_iff\n#print axioms TGLExt.RuleContinuousMotor.wrongInitial\n#print axioms TGLExt.RuleContinuousMotor.wrong_initial_rejected\n#print axioms TGLExt.RuleContinuousMotor.wrong_target_stays_rejected\n-- KH-N1 (v392; desenho (a), decisao da gerencia c1 de 13/10/2026): o axioma de TODA constante dos modulos TGL e TGLExt, no formato do #print axioms, mais a linha TGL_AXIOM_COVERAGE_TOTAL; fonte = F_KERNEL/kh/KH_formato_umpy_total.lean (sha256 cb0523546bad415d4b696ee7c7ed41c6ff36c8bc9d16357a155d63a15325065b)\nopen Lean Elab Command in\nrun_cmd do\n  let env ← getEnv\n  let mut n_decl := 0\n  let mut n_thm := 0\n  let mut n_fora := 0\n  for (n, ci) in env.constants.map₁.toList do\n    match env.getModuleIdxFor? n with\n    | none => pure ()\n    | some idx =>\n      let m := env.header.moduleNames[idx.toNat]!\n      if m.getRoot == `TGL || m.getRoot == `TGLExt then\n        IO.println ("TGL_DECL_SOURCE\\t" ++ n.toString ++ "\\t" ++ m.toString)\n        let axs ← liftCoreM (collectAxioms n)\n        n_decl := n_decl + 1\n        if ci matches .thmInfo _ then n_thm := n_thm + 1\n        unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do n_fora := n_fora + 1\n        if axs.isEmpty then\n          IO.println ("\'" ++ n.toString ++ "\' does not depend on any axioms")\n        else\n          IO.println ("\'" ++ n.toString ++ "\' depends on axioms: [" ++ String.intercalate ", " (axs.toList.map Name.toString) ++ "]")\n  IO.println ("TGL_AXIOM_COVERAGE_TOTAL decl=" ++ toString n_decl ++ " thm=" ++ toString n_thm ++ " fora_do_trio=" ++ toString n_fora)\n',
