=>(resolventDamping z.re:ℂ)) (by unfold resolventDamping; fun_prop) y\n  change cfc (fun z:ℂ=>(resolventDamping z.re:ℂ)) (R (E:=E) μ h hh) y=ᵐ[μ] _ at hd\n  rw [resolventDampingOperator_cfc _ (R_nonneg (E:=E) μ h hh).isSelfAdjoint] at hd\n  have hp:=cfc_ae μ (weight h) (weight_measurable h hh).aestronglyMeasurable\n    (fun z:ℂ=>resolventPhaseFunction t z.re)\n    ((resolventPhaseFunction_continuous t).comp Complex.continuous_re) y\n  change cfc (fun z:ℂ=>resolventPhaseFunction t z.re) (R (E:=E) μ h hh) y=ᵐ[μ] _ at hp\n  apply Lp.ext\n  filter_upwards [hp,hd,op_ae μ (phaseData μ h hh t)\n    (resolventDampingOperator (R (E:=E) μ h hh) y)] with x hp hd hx\n  change resolventPhaseOperator (R (E:=E) μ h hh) t y x=\n    op μ (phaseData μ h hh t) (resolventDampingOperator (R (E:=E) μ h hh) y) x\n  dsimp only [resolventPhaseOperator]\n  rw [hp,hx,hd]\n  simp only [weight,Complex.ofReal_re,phaseData,smul_smul,\n    resolventPhaseFunction_sigmoid,neg_neg,mul_comm]\n\nend F1Fecho.ScalarL2Spectral\n#print axioms F1Fecho.ScalarL2Spectral.R_nonneg\n#print axioms F1Fecho.ScalarL2Spectral.complement_injective\n#print axioms F1Fecho.ScalarL2Spectral.imaginaryPower_eq_phase\n',
+    'TGLExt/F1Fecho394/TensorResolventScalarsR4.lean': 'import TGLExt.F1Fecho394.CanonicalTensorMultiplierR3\nimport TGLExt.F1Fecho394.ScalarL2ImaginaryR5\n/-! Scalar identity for the actual second-quantized resolvent; no false\nsecond-quantized square-sum normalization is used. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1500000\nnoncomputable section\nopen MeasureTheory\nnamespace F1Fecho.TensorCoordinates\nopen ChatgptAudit.Continuous049\n\ndef realProduct (w:ℝ→ℝ) : (n:ℕ)→(data n).Index→ℝ\n  | 0 => w\n  | n+1 => fun p=>w p.2*realProduct w n p.1\n\nlemma realProduct_pos (w:ℝ→ℝ) (hw:∀x,0<w x) (n:ℕ) (p:(data n).Index) :\n    0<realProduct w n p := by\n  induction n with\n  | zero => exact hw p\n  | succ n ih => exact mul_pos (hw p.2) (ih p.1)\n\nlemma productWeight_ofReal (w:ℝ→ℝ) (n:ℕ) (p:(data n).Index) :\n    productWeight (fun x=>(w x:ℂ)) n p=(realProduct w n p:ℂ) := by\n  induction n with\n  | zero => rfl\n  | succ n ih => simp only [productWeight,realProduct,ih,Complex.ofReal_mul]\n\nlemma product_ratio (c:ℝ) (n:ℕ) (p:(data n).Index) :\n    realProduct (spectralWeightB c) n p=Real.exp (-c*rapiditySum n p)*\n      realProduct (spectralWeightA c) n p := by\n  induction n with\n  | zero => exact spectral_weight_ratio c p\n  | succ n ih =>\n    change spectralWeightB c p.2*realProduct (spectralWeightB c) n p.1=_\n    rw [spectral_weight_ratio,ih]\n    change _=Real.exp (-c*(p.2+rapiditySum n p.1))*\n      (spectralWeightA c p.2*realProduct (spectralWeightA c) n p.1)\n    rw [mul_add,Real.exp_add]\n    ring\n\ndef sumEnergy (c:ℝ) (n:ℕ) (p:(data n).Index) : ℝ := -2*c*rapiditySum n p\nlemma sumEnergy_measurable (c:ℝ) (n:ℕ) : Measurable (sumEnergy c n) :=\n  (rapiditySum_measurable n).const_mul _\n\ndef tensorR (c:ℝ) (n:ℕ) : Space n→L[ℂ]Space n :=\n  ScalarL2Spectral.R (data n).measure (sumEnergy c n) (sumEnergy_measurable c n)\n\nlemma tensorR_ae (c:ℝ) (n:ℕ) (x:Space n) :\n    tensorR c n x=ᵐ[(data n).measure] fun p=>(Real.sigmoid (-sumEnergy c n p):ℂ)•x p :=\n  ScalarL2.op_ae _ _ _\n\nlemma scalar_resolvent_identity (c:ℝ) (n:ℕ) (p:(data n).Index) :\n    (productWeight (weightA c) n p*productWeight (weightA c) n p+\n      productWeight (weightB c) n p*productWeight (weightB c) n p)*\n      (Real.sigmoid (-sumEnergy c n p):ℂ)=\n      productWeight (weightA c) n p*productWeight (weightA c) n p := by\n  have hA : productWeight (weightA c) n p=(realProduct (spectralWeightA c) n p:ℂ) :=\n    productWeight_ofReal (spectralWeightA c) n p\n  have hB : productWeight (weightB c) n p=(realProduct (spectralWeightB c) n p:ℂ) :=\n    productWeight_ofReal (spectralWeightB c) n p\n  rw [hA,hB]\n  norm_cast\n  rw [product_ratio]\n  unfold sumEnergy Real.sigmoid\n  have he : Real.exp (-(c*rapiditySum n p))^2=Real.exp (-(c*rapiditySum n p*2)) := by\n    rw [pow_two,←Real.exp_add]\n    congr 1\n    ring\n  field_simp\n  rw [he]\n\nlemma scalar_coefficient_nonzero (c:ℝ) (n:ℕ) (p:(data n).Index) :\n    productWeight (weightA c) n p*productWeight (weightA c) n p+\n      productWeight (weightB c) n p*productWeight (weightB c) n p≠0 := by\n  have hA : productWeight (weightA c) n p=(realProduct (spectralWeightA c) n p:ℂ) :=\n    productWeight_ofReal (spectralWeightA c) n p\n  have hB : productWeight (weightB c) n p=(realProduct (spectralWeightB c) n p:ℂ) :=\n    productWeight_ofReal (spectralWeightB c) n p\n  rw [hA,hB]\n  norm_cast\n  have ha:=realProduct_pos (spectralWeightA c) (spectral_weightA_pos c) n p\n  have hb:=realProduct_pos (spectralWeightB c) (spectral_weightB_pos c) n p\n  positivity\n\nend F1Fecho.TensorCoordinates\n#print axioms F1Fecho.TensorCoordinates.product_ratio\n#print axioms F1Fecho.TensorCoordinates.scalar_resolvent_identity\n#print axioms F1Fecho.TensorCoordinates.scalar_coefficient_nonzero\n',
+    'TGLExt/F1Fecho394/CanonicalTensorResolventR3.lean': 'import TGLExt.F1Fecho394.CanonicalTensorResolventEquationR2\nimport TGLExt.F1Fecho394.TensorResolventScalarsR4\nimport TGLExt.F1Fecho394.ImaginaryPowerIntertwiningR2\nimport TGLExt.F1Fecho394.CanonicalFockModularFlowR2\n/-! The actual Fock resolvent and modular flow in each non-vacuum sector.\nAll coordinates refer to the previously constructed Fock space. -/\nset_option autoImplicit false\nset_option maxHeartbeats 2000000\nset_option synthInstance.maxHeartbeats 200000\nnoncomputable section\nopen MeasureTheory Filter\nnamespace F1Fecho.TensorCoordinates\nopen ChatgptAudit F1Rede.BosonicFock F1Rede.CanonicalWedge F1Fecho.CanonicalFockPolar TGLV350.Regular\n\ntheorem Q_resolvent (n:ℕ) (x:F) : Q n (modularR x)=tensorR rootParameter n (Q n x) := by\n  apply Lp.ext\n  filter_upwards [Q_resolvent_equation_ae n x,tensorR_ae rootParameter n (Q n x)] with p hp hr\n  rw [hr]\n  apply smul_right_injective (data n).Fiber (scalar_coefficient_nonzero rootParameter n p)\n  dsimp only\n  rw [smul_smul,scalar_resolvent_identity]\n  exact hp\n\ntheorem Q_resolvent_intertwine (n:ℕ) :\n    (Q n).comp modularR=(tensorR rootParameter n).comp (Q n) := by\n  ext1 x\n  exact Q_resolvent n x\n\nlemma phase_eq_boost (n:ℕ) (t:ℝ) :\n    ScalarL2Spectral.phase (data n).measure (sumEnergy rootParameter n)\n      (sumEnergy_measurable rootParameter n) t=spectralBoost n (-(2*Real.pi*t)) := by\n  apply ScalarL2.op_eq\n  intro p\n  change modularPhase t (sumEnergy rootParameter n p)=\n    characterPhase (2*Real.pi*(-(2*Real.pi*t))) (rapiditySum n p)\n  unfold modularPhase characterPhase sumEnergy rootParameter\n  congr 1\n  push_cast\n  ring\n\ntheorem Q_modularFlow (n:ℕ) (t:ℝ) (x:F) :\n    Q n (actualModularFlow t x)=spectralBoost n (-(2*Real.pi*t)) (Q n x) := by\n  have h:=ContinuousIntertwining.imaginaryPower_intertwine modularR (tensorR rootParameter n)\n    (Q n) (Q_resolvent_intertwine n) modularR_nonneg modularR_le_one\n    modularR_injective modularR_complement_injective\n    (ScalarL2Spectral.R_nonneg _ _ _) (ScalarL2Spectral.R_le_one _ _ _)\n    (ScalarL2Spectral.R_injective _ _ _) (ScalarL2Spectral.complement_injective _ _ _) t x\n  change Q n (actualModularFlow t x)=_ at h\n  calc\n    Q n (actualModularFlow t x) = _ := h\n    _ = ScalarL2Spectral.phase (data n).measure (sumEnergy rootParameter n)\n        (sumEnergy_measurable rootParameter n) t (Q n x) :=\n      ScalarL2Spectral.imaginaryPower_eq_phase _ _ _ t (Q n x)\n    _ = _ := congrArg (fun L:Space n→L[ℂ]Space n=>L (Q n x)) (phase_eq_boost n t)\n\ntheorem positive_component_modularFlow (n:ℕ) (t:ℝ) (x:F) :\n    (actualModularFlow t x) (n+1)=\n      (F1Rede.BosonicFock.gamma (TGLExt.ImportedSQ.B0 (-(2*Real.pi*t))) x) (n+1) := by\n  apply Subtype.ext\n  apply (coordinates n).injective\n  change Q n (actualModularFlow t x)=\n    coordinates n (F1Rede.BosonicSectors.gammaSector (TGLExt.ImportedSQ.B0 (-(2*Real.pi*t)))\n      (n+1) (x (n+1)) : F1Rede.BosonicSectors.TensorHilbert (n+1))\n  rw [Q_modularFlow,sector_boost]\n  rfl\n\nend F1Fecho.TensorCoordinates\n#print axioms F1Fecho.TensorCoordinates.Q_resolvent\n#print axioms F1Fecho.TensorCoordinates.Q_modularFlow\n\n#print axioms F1Fecho.TensorCoordinates.positive_component_modularFlow\n',
+    'TGLExt/F1Fecho394/CanonicalFockBWR2.lean': 'import TGLExt.F1Fecho394.CanonicalZeroSectorFlowR3\nimport TGLExt.F1Fecho394.CanonicalTensorResolventR3\n/-! Bisognano-Wichmann equality for the actual Weyl/vacuum Tomita graph on\nexactly the already constructed canonical Fock space. The negative modular\nparameter is explicit; the positive KMS convention is a separate theorem.\nNo modular-flow equality is assumed as a record field. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1800000\nnoncomputable section\nopen UniformSpace\nnamespace F1Fecho.CanonicalFockBW\nopen TGLExt.ImportedSQ F1Rede.BosonicSectors F1Rede.BosonicFock F1Rede.CanonicalWedge\nopen F1Fecho.CanonicalFockPolar F1Fecho.CanonicalZeroSector\nopen F1Fecho.ExponentialTomita F1Fecho.WedgePairTomita ORDEM016.D6\n\ntheorem tensorGamma_zero (u:H1≃ₗᵢ[ℂ]H1) (x:TensorHilbert 0) : tensorGamma u 0 x=x := by\n  refine Completion.induction_on x (isClosed_eq (tensorGamma u 0).continuous continuous_id) ?_\n  intro z\n  rw [tensorGamma_coe]\n  rfl\n\ntheorem gamma_zero_component (u:H1≃ₗᵢ[ℂ]H1) (x:F) : gamma u x 0=x 0 := by\n  apply Subtype.ext\n  exact tensorGamma_zero u (x 0)\n\ntheorem actualModularFlow_eq_gamma_apply (t:ℝ) (x:F) :\n    actualModularFlow t x=gamma (B0 (-(2*Real.pi*t))) x := by\n  apply lp.ext\n  funext n\n  cases n with\n  | zero => rw [modularFlow_zero_component,gamma_zero_component]\n  | succ n => exact TensorCoordinates.positive_component_modularFlow n t x\n\ntheorem actualModularFlow_eq_gamma :\n    actualModularFlow=(fun t=>gamma (B0 (-(2*Real.pi*t)))) := by\n  funext t\n  ext1 x\n  exact actualModularFlow_eq_gamma_apply t x\n\ntheorem canonical_pair_tomita :\n    PairTomitaAnalyticRealizationMeasured (algebra KWR) vacuum JF\n      (fun t=>gamma (B0 (-(2*Real.pi*t)))) := by\n  rw [←actualModularFlow_eq_gamma]\n  exact actual_spectral_pair_measured\n\nend F1Fecho.CanonicalFockBW\n#print axioms F1Fecho.CanonicalFockBW.tensorGamma_zero\n#print axioms F1Fecho.CanonicalFockBW.gamma_zero_component\n#print axioms F1Fecho.CanonicalFockBW.actualModularFlow_eq_gamma_apply\n#print axioms F1Fecho.CanonicalFockBW.actualModularFlow_eq_gamma\n#print axioms F1Fecho.CanonicalFockBW.canonical_pair_tomita\n',
+    'TGLExt/F1Fecho394/CanonicalModularCoreAssemblyR1.lean': 'import TGLExt.F1Fecho394.CanonicalWeylAssemblyR5\nimport TGLExt.F1Fecho394.CanonicalFockRegularCoreR2\nimport TGLExt.F1Fecho394.WedgeNonabelianR4\nimport TGLExt.F1Fecho394.CanonicalGammaPositiveR3\nimport TGLExt.F1Fecho394.CanonicalGammaNoFixedR4\nimport TGLExt.F1Fecho394.CanonicalWedgeKMSR4\nimport TGLExt.F1Fecho394.CanonicalFockBWR2\n/-! Concrete core wiring after construction of canonical KMS and the\nactual Weyl/vacuum Tomita modular-flow equality on the same Fock space.\nThe remaining record has 21 explicit trace/PF obligations; global net glue\nremains in CanonicalNetInput. No inhabitant of that joint input is asserted. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1500000\nset_option synthInstance.maxHeartbeats 1000000\nnoncomputable section\nopen scoped InnerProductSpace\nnamespace F1Fecho.NetworkModularCore\nopen TGL.SpecificAQFT TGL.ModularRealization TGLExt.ImportedSQ\nopen F1Rede.BosonicFock F1Fecho.NetworkReuse F1Fecho.Antilinear\nopen TGLExt.ContratoQGv31 TGLExt.ContratoQGv32\nopen F1Fecho.NetworkWeyl\n\nabbrev RepresentedCore := F1Fecho.CanonicalFockRegular.core.toStarSubalgebra\n\ntheorem wedge_le_canonical (D : CanonicalNetInput) :\n    (FieldWeyl.R (D.K rightWedge)).toStarSubalgebra ≤\n    F1Fecho.CanonicalFockRegular.M.toStarSubalgebra := by\n  rw [D.wedge_glue]\n  exact le_rfl\n\ndef coreEmbedding (D : CanonicalNetInput) :\n    (FieldWeyl.R (D.K rightWedge)).toStarSubalgebra →⋆ₐ[ℂ] RepresentedCore :=\n  F1Fecho.CanonicalFockRegular.embedding.comp\n    (StarSubalgebra.inclusion (wedge_le_canonical D))\n\ntheorem coreEmbedding_injective (D : CanonicalNetInput) :\n    Function.Injective (coreEmbedding D) :=\n  F1Fecho.CanonicalFockRegular.embedding_injective.comp\n    (StarSubalgebra.inclusion_injective (wedge_le_canonical D))\n\ntheorem dual_fixes_coreEmbedding (D : CanonicalNetInput) (s : ℝ)\n    (A : (FieldWeyl.R (D.K rightWedge)).toStarSubalgebra) :\n    F1Fecho.CanonicalFockRegular.dualAction s (coreEmbedding D A) = coreEmbedding D A :=\n  F1Fecho.CanonicalFockRegular.dual_fixes_embedding s\n    (StarSubalgebra.inclusion (wedge_le_canonical D) A)\n\nstructure RemainingModularCoreInput (D : CanonicalNetInput) where\n  trace : RepresentedCore → ENNReal\n  trace_zero : trace 0 = 0\n  trace_tracial : ∀ x y : RepresentedCore, trace (x * y) = trace (y * x)\n  trace_star : ∀ x : RepresentedCore, trace (star x) = trace x\n  trace_dual_scaling : ∀ (s : ℝ) (x : RepresentedCore),\n    trace ((F1Fecho.CanonicalFockRegular.dualAction s) x) = ENNReal.ofReal (Real.exp (-s)) * trace x\n  /-- uma projeção finita não nula do núcleo II_∞, partida em duas metades de traço igual [Connes 1973]. -/\n  PF : RepresentedCore\n  PF_sa : star PF = PF\n  PF_idem : PF * PF = PF\n  PF_ne : PF ≠ 0\n  PF_pos : 0 < trace PF\n  PF_fin : trace PF < ⊤\n  Pp : RepresentedCore\n  Pm : RepresentedCore\n  Pp_sa : star Pp = Pp\n  Pp_idem : Pp * Pp = Pp\n  Pm_sa : star Pm = Pm\n  Pm_idem : Pm * Pm = Pm\n  split : Pp + Pm = PF\n  orth : Pp * Pm = 0\n  trace_additive : trace PF = trace Pp + trace Pm\n  equal_halves : trace Pp = trace Pm\n\n\ndef RemainingModularCoreInput.toRemainingWeyl {D : CanonicalNetInput}\n    (A : RemainingModularCoreInput D) : RemainingWeylInput D where\n  Core := RepresentedCore\n  instCR := inferInstance\n  instCS := inferInstance\n  instCA := inferInstance\n  embedding := coreEmbedding D\n  embedding_injective := coreEmbedding_injective D\n  dualAction := F1Fecho.CanonicalFockRegular.dualAction\n  dualAction_zero := F1Fecho.CanonicalFockRegular.dualAction_zero\n  dualAction_add := F1Fecho.CanonicalFockRegular.dualAction_add\n  Γ_positive := F1Fecho.CanonicalGammaPositive.gamma_positive\n  Γ_no_fixed := F1Fecho.CanonicalGammaNoFixed.gamma_no_fixed\n  wedge_nonabelian := by\n    rw [D.wedge_glue]\n    exact F1Fecho.WedgeNonabelian.wedge_nonabelian\n  bw_kms := by\n    rw [D.wedge_glue]\n    exact F1Fecho.CanonicalWedgeKMS.canonical_bw_kms\n  tomita := by\n    rw [D.wedge_glue]\n    exact F1Fecho.CanonicalFockBW.canonical_pair_tomita\n  trace := A.trace\n  trace_zero := A.trace_zero\n  trace_tracial := A.trace_tracial\n  trace_star := A.trace_star\n  trace_dual_scaling := A.trace_dual_scaling\n  PF := A.PF\n  PF_sa := A.PF_sa\n  PF_idem := A.PF_idem\n  PF_ne := A.PF_ne\n  PF_pos := A.PF_pos\n  PF_fin := A.PF_fin\n  Pp := A.Pp\n  Pm := A.Pm\n  Pp_sa := A.Pp_sa\n  Pp_idem := A.Pp_idem\n  Pm_sa := A.Pm_sa\n  Pm_idem := A.Pm_idem\n  split := A.split\n  orth := A.orth\n  trace_additive := A.trace_additive\n  equal_halves := A.equal_halves\n\ndef RemainingModularCoreInput.toCertificate {D : CanonicalNetInput}\n    (A : RemainingModularCoreInput D) : FockCertificate D.toLightNetData.toLightOneParticle :=\n  A.toRemainingWeyl.toCertificate\n\ntheorem assembled_core_is_concrete {D : CanonicalNetInput} (A : RemainingModularCoreInput D) :\n    A.toCertificate.Core = RepresentedCore := rfl\n\ntheorem assembled_embedding_is_concrete {D : CanonicalNetInput} (A : RemainingModularCoreInput D) :\n    A.toCertificate.embedding = coreEmbedding D := rfl\n\ntheorem assembled_dual_is_concrete {D : CanonicalNetInput} (A : RemainingModularCoreInput D) :\n    A.toCertificate.dualAction = F1Fecho.CanonicalFockRegular.dualAction := rfl\n\nend F1Fecho.NetworkModularCore\nopen Lean in\nrun_cmd do\n  let env ← Elab.Command.liftCoreM getEnv\n  for (n, ci) in env.constants.map₂.toList do\n    if (`F1Fecho.NetworkModularCore).isPrefixOf n then\n      let axs ← collectAxioms n\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\n      match ci with\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\n      | _ => pure ()\n',
+    'TGLExt/F1Fecho394/RegularScalarGNSR3.lean': "import TGLExt.V350ScalarGNSLinear\n/-! Generic construction of the scalar dual-weight GNS orbit and completion.\nIts algebra/vector context requires faithfulness of the original weight.\nThe concrete Fock instance supplies that property by its already proved lemma;\nno GNS equality, injectivity, or completion result is assumed. -/\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1800000\nset_option synthInstance.maxHeartbeats 1000000\nnoncomputable section\nnamespace F1Fecho.RegularScalarGNS\nopen TGLV350.Regular MeasureTheory\nopen scoped ENNReal NNReal Topology\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\n/-- Algebra/vector inputs. Faithfulness is an already proved property in the\nconcrete Fock instance, not a conclusion about GNS inserted as a field. -/\nstructure Context (H : Type) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where\n  algebra : VonNeumannAlgebra (RegularHilbert H)\n  vacuum : RegularHilbert H\n  faithful : ∀ (A : RegularHilbert H →L[ℂ] RegularHilbert H), A ∈ algebra → 0 ≤ A →\n    (dualQuadraticIntegral A vacuum = 0 ↔ A = 0)\nvariable (D : Context H)\ndef finiteIdeal : Submodule ℂ D.algebra.toStarSubalgebra where\n  carrier := {A | HasFiniteDualSquare A.val}\n  zero_mem' := HasFiniteDualSquare.zero\n  add_mem' := fun hA hB => HasFiniteDualSquare.add _ _ hA hB\n  smul_mem' := fun c _ hA => HasFiniteDualSquare.smul c _ hA\n\ntheorem scalar_finite (A : RegularHilbert H →L[ℂ] RegularHilbert H)\n    (hA : HasFiniteDualSquare A) : dualQuadraticIntegral (star A*A) D.vacuum < ⊤ := by\n  obtain ⟨C,hC⟩ := hA\n  exact (hC D.vacuum).trans_lt\n    (ENNReal.mul_lt_top ENNReal.coe_lt_top ENNReal.ofReal_lt_top)\n\n/-- Square integrability of the actual dual orbit follows from the finite\nweight, with the fixed positive Haar factor removed explicitly. -/\ntheorem scalarOrbit_memLp \n    (A : RegularHilbert H →L[ℂ] RegularHilbert H)\n    (hA : HasFiniteDualSquare A) :\n    MemLp (fun s : ℝ => dualAmbient s A D.vacuum) 2 := by\n  have hq := scalar_finite D A hA\n  simp only [dualQuadraticIntegral, dualQuadraticIntegrand_star_mul] at hq\n  have hn : ENNReal.ofReal dualHaarFactor ≠ 0 :=\n    ne_of_gt (ENNReal.ofReal_pos.mpr dualHaarFactor_pos)\n  have hi : (∫⁻ s : ℝ, ENNReal.ofReal (‖dualAmbient s A D.vacuum‖ ^ 2)) < ⊤ := by\n    by_contra h\n    have ht := top_unique (not_lt.mp h)\n    rw [ht] at hq\n    rw [ENNReal.mul_top hn] at hq\n    exact (lt_irrefl _) hq\n  refine ⟨(dualAmbient_strongly_continuous A D.vacuum).aestronglyMeasurable,?_⟩\n  rw [eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top (by norm_num) (by norm_num)]\n  have he (s : ℝ) : ENNReal.ofReal (‖dualAmbient s A D.vacuum‖ ^ 2) =\n      (‖dualAmbient s A D.vacuum‖₊ : ℝ≥0∞) ^ 2 := by\n    rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm, enorm_eq_nnnorm]\n  simp_rw [he] at hi\n  simpa only [ENNReal.toReal_ofNat, ENNReal.rpow_two, enorm_eq_nnnorm, pow_two] using hi\n\n/-- An orbit vector in a concrete Hilbert space. Completion of its range,\nthe left representation and the Tomita operator are separate constructions. -/\ndef scalarGNSOrbit  (A : finiteIdeal D) :\n    RegularHilbert (RegularHilbert H) :=\n  (Real.sqrt dualHaarFactor : ℝ) •\n    (scalarOrbit_memLp D A.val.val A.property).toLp\n      (fun s : ℝ => dualAmbient s A.val.val D.vacuum)\n\ntheorem scalarGNSOrbit_norm_sq  (A : finiteIdeal D) :\n    ENNReal.ofReal (‖scalarGNSOrbit D A‖ ^ 2) =\n      dualQuadraticIntegral (star A.val.val * A.val.val) D.vacuum := by\n  have hm := scalarOrbit_memLp D A.val.val A.property\n  have hi := (memLp_two_iff_integrable_sq_norm hm.1).mp hm\n  have hs : ‖scalarGNSOrbit D A‖ ^ 2 = dualHaarFactor *\n      ∫ s : ℝ, ‖dualAmbient s A.val.val D.vacuum‖ ^ 2 := by\n    unfold scalarGNSOrbit\n    rw [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs, Real.sq_sqrt dualHaarFactor_pos.le,\n      ← TGLV350.Fourier.integral_norm_sq_eq_L2 _ hm]\n  rw [hs, ENNReal.ofReal_mul dualHaarFactor_pos.le]\n  simp only [dualQuadraticIntegral, dualQuadraticIntegrand_star_mul]\n  rw [ofReal_integral_eq_lintegral_ofReal hi (Filter.Eventually.of_forall (fun s => sq_nonneg _))]\n\ntheorem scalarGNSOrbit_ae  (A : finiteIdeal D) :\n    (scalarGNSOrbit D A : ℝ → RegularHilbert H) =ᵐ[volume]\n      fun s => (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s A.val.val D.vacuum := by\n  let hm := scalarOrbit_memLp D A.val.val A.property\n  filter_upwards [Lp.coeFn_smul (Real.sqrt dualHaarFactor : ℝ)\n    (hm.toLp (fun s : ℝ => dualAmbient s A.val.val D.vacuum)),hm.coeFn_toLp]\n    with s h1 h2\n  change ((Real.sqrt dualHaarFactor : ℝ) • hm.toLp _) s = _\n  simp only [Pi.smul_apply] at h1\n  rw [h1,h2]\n\ntheorem scalarGNSOrbit_add  (A B : finiteIdeal D) :\n    scalarGNSOrbit D (A+B) = scalarGNSOrbit D A + scalarGNSOrbit D B := by\n  apply Lp.ext\n  filter_upwards [scalarGNSOrbit_ae D (A+B),scalarGNSOrbit_ae D A,\n    scalarGNSOrbit_ae D B,Lp.coeFn_add (scalarGNSOrbit D A) (scalarGNSOrbit D B)]\n    with s h1 h2 h3 h4\n  simp only [Pi.add_apply] at h4\n  rw [h1,h4,h2,h3]\n  change (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s (A.val.val+B.val.val) D.vacuum = _\n  rw [dualAmbient_add_apply]\n  exact _root_.smul_add (Real.sqrt dualHaarFactor : ℝ)\n    (dualAmbient s A.val.val D.vacuum) (dualAmbient s B.val.val D.vacuum)\n\ntheorem scalarGNSOrbit_smul  (c : ℂ) (A : finiteIdeal D) :\n    scalarGNSOrbit D (c • A) = c • scalarGNSOrbit D A := by\n  apply Lp.ext\n  filter_upwards [scalarGNSOrbit_ae D (c • A),scalarGNSOrbit_ae D A,\n    Lp.coeFn_smul c (scalarGNSOrbit D A)] with s h1 h2 h3\n  simp only [Pi.smul_apply] at h3\n  rw [h1,h3,h2]\n  change (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s (c • A.val.val) D.vacuum = _\n  rw [map_smul]\n  change (Real.sqrt dualHaarFactor : ℝ) • (c • dualAmbient s A.val.val D.vacuum) = _\n  exact smul_comm _ _ _\n\ndef scalarGNSLinear  :\n    (finiteIdeal D) →ₗ[ℂ] RegularHilbert (RegularHilbert H) where\n  toFun := scalarGNSOrbit D\n  map_add' := scalarGNSOrbit_add D\n  map_smul' := scalarGNSOrbit_smul D\n\ntheorem scalarGNSOrbit_zero_iff  (A : finiteIdeal D) :\n    scalarGNSOrbit D A = 0 ↔ A = 0 := by\n  constructor\n  · intro h\n    have hq : dualQuadraticIntegral (star A.val.val * A.val.val) D.vacuum = 0 := by\n      rw [← scalarGNSOrbit_norm_sq D,h]\n      simp only [norm_zero,zero_pow (by norm_num : (2 : ℕ) ≠ 0),ENNReal.ofReal_zero]\n    have hm := D.algebra.mul_mem\n      (D.algebra.toStarSubalgebra.star_mem' A.val.property) A.val.property\n    have hz := (D.faithful _ hm (star_mul_self_nonneg A.val.val)).mp hq\n    apply Subtype.ext\n    apply Subtype.ext\n    exact (CStarRing.star_mul_self_eq_zero_iff A.val.val).mp hz\n  · rintro rfl\n    exact (scalarGNSLinear D).map_zero\n\ntheorem scalarGNSLinear_injective  :\n    Function.Injective (scalarGNSLinear D) := by\n  intro A B h\n  have hz : scalarGNSLinear D (A-B) = 0 := by rw [map_sub,h,sub_self]\n  exact sub_eq_zero.mp ((scalarGNSOrbit_zero_iff D (A-B)).mp hz)\n\n\ndef GNSSubspace : Submodule ℂ (RegularHilbert (RegularHilbert H)) :=\n  (scalarGNSLinear D).range.topologicalClosure\nabbrev GNSHilbert := GNSSubspace D\ninstance gnsCompleteSpace : CompleteSpace (GNSHilbert D) :=\n  Submodule.topologicalClosure.completeSpace (scalarGNSLinear D).range\n\ndef GNSEmbedding : (finiteIdeal D) →ₗ[ℂ] GNSHilbert D :=\n  (scalarGNSLinear D).codRestrict (GNSSubspace D)\n    (fun A => (scalarGNSLinear D).range.le_topologicalClosure ⟨A,rfl⟩)\n\ntheorem GNSEmbedding_injective : Function.Injective (GNSEmbedding D) := by\n  intro A B h\n  exact scalarGNSLinear_injective D (congrArg Subtype.val h)\n\n\nend F1Fecho.RegularScalarGNS\n#print axioms F1Fecho.RegularScalarGNS.finiteIdeal\n#print axioms F1Fecho.RegularScalarGNS.scalar_finite\n#print axioms F1Fecho.RegularScalarGNS.scalarOrbit_memLp\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit_norm_sq\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit_ae\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit_add\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit_smul\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit_zero_iff\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSLinear_injective\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSOrbit\n#print axioms F1Fecho.RegularScalarGNS.scalarGNSLinear\n#print axioms F1Fecho.RegularScalarGNS.GNSSubspace\n#print axioms F1Fecho.RegularScalarGNS.GNSHilbert\n#print axioms F1Fecho.RegularScalarGNS.GNSEmbedding_injective\n#print axioms F1Fecho.RegularScalarGNS.GNSEmbedding\n",
+    'TGLExt/F1Fecho394/RegularScalarGaussianR1.lean': "import TGLExt.V350L2GaussianProfile\nimport TGLExt.F1Fecho394.RegularScalarGNSR3\nimport TGLExt.V350DualOrbitVonNeumann\nimport TGLExt.V350RegularFiniteWeight\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1000000\n\nnamespace F1Fecho.RegularScalarGaussian\nopen TGLV350.Regular MeasureTheory F1Fecho.RegularScalarGNS\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nvariable (D : Context H)\nnoncomputable section\n\n/-- An auxiliary vector of the existing orbit representation. It is not used\nto replace the scalar dual weight or to change the physical input. -/\ndef scalarGaussianVacuum  :\n    RegularHilbert (RegularHilbert H) :=\n  (gaussianProfile_memLp_vector ((Real.sqrt dualHaarFactor : ℂ) • D.vacuum)).toLp\n    (fun s : ℝ => (gaussianProfile s : ℂ) •\n      ((Real.sqrt dualHaarFactor : ℂ) • D.vacuum))\n\ntheorem scalarGaussianVacuum_ae  :\n    (scalarGaussianVacuum D : ℝ → RegularHilbert H) =ᵐ[volume]\n      fun s => (gaussianProfile s : ℂ) •\n        ((Real.sqrt dualHaarFactor : ℂ) • D.vacuum) :=\n  (gaussianProfile_memLp_vector ((Real.sqrt dualHaarFactor : ℂ) • D.vacuum)).coeFn_toLp\n\n/-- A zero Gaussian-weighted orbit has zero unweighted orbit almost everywhere.\nStrict positivity is used before any extended integral is evaluated. -/\ntheorem gaussian_zero_action_orbit_ae \n    (A : RegularHilbert H →L[ℂ] RegularHilbert H)\n    (hz : dualOrbitRepresentation A (scalarGaussianVacuum D) = 0) :\n    (fun s : ℝ => dualAmbient s A (D.vacuum)) =ᵐ[volume] 0 := by\n  filter_upwards [scalarGaussianVacuum_ae D,\n    operatorFieldLift_ae (dualIntegralFamily A) (scalarGaussianVacuum D),\n    Lp.coeFn_zero (RegularHilbert H) 2 volume] with s h1 h2 h3\n  have he : (gaussianProfile s : ℂ) •\n      ((Real.sqrt dualHaarFactor : ℂ) • dualAmbient s A (D.vacuum)) = 0 := by\n    have h := h2\n    change dualOrbitRepresentation A (scalarGaussianVacuum D) s =\n      dualAmbient s A (scalarGaussianVacuum D s) at h\n    rw [hz,h3,h1,map_smul,map_smul] at h\n    exact h.symm\n  have hg : (gaussianProfile s : ℂ) ≠ 0 :=\n    Complex.ofReal_ne_zero.mpr (ne_of_gt (gaussianProfile_pos s))\n  have hc : (Real.sqrt dualHaarFactor : ℂ) ≠ 0 :=\n    Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr dualHaarFactor_pos))\n  exact (smul_eq_zero.mp ((smul_eq_zero.mp he).resolve_left hg)).resolve_left hc\n\n/-- The Gaussian vector is separating for the concrete image of N, by the\nalready established faithfulness of the original scalar dual weight. -/\ntheorem scalarGaussianVacuum_separating \n    (A : RegularHilbert H →L[ℂ] RegularHilbert H)\n    (hA : A ∈ D.algebra)\n    (hz : dualOrbitRepresentation A (scalarGaussianVacuum D) = 0) : A = 0 := by\n  have ho := gaussian_zero_action_orbit_ae D A hz\n  have hq : dualQuadraticIntegral (star A * A) (D.vacuum) = 0 := by\n    simp only [dualQuadraticIntegral,dualQuadraticIntegrand_star_mul]\n    have he : (fun s : ℝ => ENNReal.ofReal (‖dualAmbient s A (D.vacuum)‖ ^ 2))\n        =ᵐ[volume] 0 := by\n      filter_upwards [ho] with s hs\n      simp only [Pi.zero_apply] at hs\n      simp [hs]\n    rw [lintegral_congr_ae he]\n    simp\n  have hm := (D.algebra).mul_mem\n    ((D.algebra).toStarSubalgebra.star_mem' hA) hA\n  have hs := (D.faithful (star A * A) hm (star_mul_self_nonneg A)).mp hq\n  exact (CStarRing.star_mul_self_eq_zero_iff A).mp hs\n\n#print axioms scalarGaussianVacuum\n#print axioms scalarGaussianVacuum_ae\n#print axioms gaussian_zero_action_orbit_ae\n#print axioms scalarGaussianVacuum_separating\nend\nend F1Fecho.RegularScalarGaussian\n",
+    'TGLExt/F1Fecho394/RegularScalarGNSActionR2.lean': 'import TGLExt.F1Fecho394.RegularScalarGNSR3\nimport TGLExt.V350StrongOperatorField\n/-! Concrete left GNS action of the SAME Fock core. The ambient multiplier\nis the actual dual orbit. Its restriction is proved to preserve the completion\nof the orbit range, and intertwines actual left multiplication. -/\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1800000\nnoncomputable section\nnamespace F1Fecho.RegularScalarGNSAction\nopen TGLV350.Regular MeasureTheory F1Fecho.RegularScalarGNS\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\nvariable (D : Context H)\n\ndef scalarGNSLeftProduct \n    (B : D.algebra.toStarSubalgebra) (A : finiteIdeal D) :\n    finiteIdeal D :=\n  ⟨B * A.val,HasFiniteDualSquare.left_mul B.val A.val.val A.property⟩\n\n/-- The ambient left action uses the same dual orbit at every coordinate.\nRestriction to the completed GNS range is a separate step. -/\ndef scalarGNSAmbientAction \n    (B : D.algebra.toStarSubalgebra) :\n    RegularHilbert (RegularHilbert H) →L[ℂ]\n      RegularHilbert (RegularHilbert H) :=\n  operatorFieldLift (dualIntegralFamily B.val)\n\ntheorem scalarGNSAmbientAction_norm_le \n    (B : D.algebra.toStarSubalgebra) :\n    ‖scalarGNSAmbientAction D B‖ ≤ ‖B.val‖ :=\n  operatorFieldLift_norm_le (dualIntegralFamily B.val)\n\ntheorem scalarGNSAmbientAction_intertwines \n    (B : D.algebra.toStarSubalgebra) (A : finiteIdeal D) :\n    scalarGNSAmbientAction D B (scalarGNSOrbit D A) =\n      scalarGNSOrbit D (scalarGNSLeftProduct D B A) := by\n  apply Lp.ext\n  filter_upwards [operatorFieldLift_ae (dualIntegralFamily B.val) (scalarGNSOrbit D A),\n    scalarGNSOrbit_ae D A,scalarGNSOrbit_ae D (scalarGNSLeftProduct D B A)]\n    with s h1 h2 h3\n  change operatorFieldLift (dualIntegralFamily B.val) (scalarGNSOrbit D A) s = _\n  rw [h1,h3]\n  change dualAmbient s B.val (scalarGNSOrbit D A s) = _