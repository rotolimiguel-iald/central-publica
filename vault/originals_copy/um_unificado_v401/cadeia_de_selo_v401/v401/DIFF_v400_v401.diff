+        "state_counts": c, "f_exp_numerador": c[1] + c[2] - c[0] - c[3],      # F_exp = numerador / n (paridade -1 nos estados 0 e 3)
+        "psi_hash": psi_hash, "theta_hash": theta_hash, "lut_sha256": p["lut_sha256"],
