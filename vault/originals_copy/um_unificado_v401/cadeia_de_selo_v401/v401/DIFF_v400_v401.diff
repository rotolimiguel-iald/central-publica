+def verificar(b: bytes, selo: Dict[str, Any]) -> Dict[str, Any]:
+    """Verificacao fail-closed de um selo contra o objeto (o que o conferidor roda): refaz a Dobra do objeto, confronta cada hash e reconstroi."""
