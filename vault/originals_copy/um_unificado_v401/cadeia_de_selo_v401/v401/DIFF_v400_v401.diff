+    acerta_psi = int(hist[:CENTRO].max()) + int(hist[CENTRO:].max()) if neg and (zero + pos) else int(hist.max())
+    # kappa sozinho: o melhor chute constante (o byte mais frequente)
+    acerta_kappa = int(hist.max())
