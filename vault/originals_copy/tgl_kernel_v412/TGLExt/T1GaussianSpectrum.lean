import TGLExt.F1Fecho394.GaussianProbabilityKernelR4
import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.LinearAlgebra.Lagrange
import Mathlib.Data.Matrix.Basis

/-! Gaussian conjugation in a diagonal basis, full support, and the
finite-dimensional criterion for the commutant to be generated by one matrix. -/

set_option autoImplicit false
noncomputable section

namespace K07.T1

open MeasureTheory ProbabilityTheory Matrix Polynomial
open scoped NNReal
open ChatgptAudit F1Fecho.GaussianLogScalar

/-- The canonical normalized kernel has variance one half. The displayed
scaling gives the decay rate for arbitrary nonnegative variance. -/
theorem scaled_weight_multiplier (v : ℝ≥0) (d : ℝ) :
    (∫ s : ℝ, (gaussianWeight s : ℂ) * modularPhase (Real.sqrt (2 * v) * s) d) =
      (Real.exp (-(v : ℝ) * d ^ 2 / 2) : ℂ) := by
  rw [gaussianWeight_fourier]
  have hs := Real.sq_sqrt (show 0 ≤ 2 * (v : ℝ) by positivity)
  congr 2
  rw [mul_pow, hs]
  ring

/-- Characteristic multiplier for the Gaussian probability measure itself,
including the zero-variance case. -/
theorem gaussian_phase_integral (v : ℝ≥0) (d : ℝ) :
    ∫ s : ℝ, modularPhase s d ∂gaussianReal 0 v =
      (Real.exp (-(v : ℝ) * d ^ 2 / 2) : ℂ) := by
  have h := charFun_gaussianReal (μ := 0) (v := v) d
  rw [charFun_apply_real] at h
  convert h using 1
  · apply integral_congr_ae
    filter_upwards with s
    unfold modularPhase
    push_cast
    rw [mul_comm (s : ℂ) (d : ℂ)]
  · rw [Complex.ofReal_exp]
    congr 1
    push_cast
    ring

theorem gaussian_positive_on_opens (m : ℝ) (v : ℝ≥0) (hv : v ≠ 0) :
    (gaussianReal m v).IsOpenPosMeasure :=
  (gaussianReal_absolutelyContinuous' m hv).isOpenPosMeasure

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The diagonal unitary in the spectral basis of a positive generator. -/
def phaseMatrix (k : n → ℝ) (s : ℝ) : Matrix n n ℂ :=
  Matrix.diagonal (fun i => modularPhase s (Real.sqrt (k i)))

theorem phaseMatrix_conjugation_entry (k : n → ℝ) (s : ℝ)
    (x : Matrix n n ℂ) (i j : n) :
    (phaseMatrix k s * x * (phaseMatrix k s).conjTranspose) i j =
      modularPhase s (Real.sqrt (k i) - Real.sqrt (k j)) * x i j := by
  unfold phaseMatrix
  rw [Matrix.diagonal_conjTranspose, Matrix.mul_diagonal, Matrix.diagonal_mul]
  change modularPhase s (Real.sqrt (k i)) * x i j *
    (starRingEnd ℂ) (modularPhase s (Real.sqrt (k j))) = _
  unfold modularPhase
  rw [show starRingEnd ℂ (Complex.exp (↑(s * √(k j)) * Complex.I)) =
      Complex.exp (-(↑(s * √(k j)) * Complex.I)) by simp [← Complex.exp_conj]]
  rw [mul_right_comm, ← Complex.exp_add]
  congr 2
  push_cast
  ring

/-- Equality with the actual entrywise integral of unitary conjugations. -/
theorem gaussian_conjugation_entry (k : n → ℝ) (v : ℝ≥0)
    (x : Matrix n n ℂ) (i j : n) :
    (∫ s : ℝ, (phaseMatrix k s * x * (phaseMatrix k s).conjTranspose) i j
      ∂gaussianReal 0 v) =
      (Real.exp (-(v : ℝ) * (Real.sqrt (k i) - Real.sqrt (k j)) ^ 2 / 2) : ℂ) *
        x i j := by
  simp only [phaseMatrix_conjugation_entry, integral_mul_const, gaussian_phase_integral]

/-- Polynomial functional calculus for a diagonal matrix, with the ordinary
matrix `aeval` on the left. -/
theorem aeval_diagonal (k : n → ℂ) (p : Polynomial ℂ) :
    aeval (Matrix.diagonal k) p = Matrix.diagonal (fun i => p.eval (k i)) := by
  change aeval ((Matrix.diagonalAlgHom (n := n) (α := ℂ) ℂ) k) p = _
  rw [aeval_algHom_apply]
  change Matrix.diagonal ((aeval k) p) = _
  congr 1
  funext i
  simp

theorem commutant_generated_iff_injective (k : n → ℂ) :
    (∀ x : Matrix n n ℂ, Commute (Matrix.diagonal k) x →
       ∃ p : Polynomial ℂ, aeval (Matrix.diagonal k) p = x) ↔
      Function.Injective k := by
  constructor
  · intro generated i j h
    by_contra hij
    let e : Matrix n n ℂ := Matrix.single i j 1
    have he : Commute (Matrix.diagonal k) e := by
      show Matrix.diagonal k * e = e * Matrix.diagonal k
      ext a b
      simp only [Matrix.diagonal_mul, Matrix.mul_diagonal, e, Matrix.single_apply]
      by_cases hab : i = a ∧ j = b
      · obtain ⟨rfl, rfl⟩ := hab
        simp [h]
      · simp [hab]
    obtain ⟨p, hp⟩ := generated e he
    rw [aeval_diagonal] at hp
    have bad := congrArg (fun a : Matrix n n ℂ => a i j) hp
    simp [e, Matrix.diagonal_apply_ne _ hij] at bad
  · intro hk x hx
    let p : Polynomial ℂ := Lagrange.interpolate Finset.univ k (fun i => x i i)
    refine ⟨p, ?_⟩
    rw [aeval_diagonal]
    ext i j
    by_cases hij : i = j
    · subst j
      rw [Matrix.diagonal_apply_eq]
      exact Lagrange.eval_interpolate_at_node (fun a => x a a) hk.injOn (Finset.mem_univ i)
    · rw [Matrix.diagonal_apply_ne _ hij]
      have he := congrArg (fun a : Matrix n n ℂ => a i j) hx.eq
      change (Matrix.diagonal k * x) i j = (x * Matrix.diagonal k) i j at he
      rw [Matrix.diagonal_mul, Matrix.mul_diagonal, mul_comm (x i j)] at he
      exact ((mul_eq_zero.mp (show (k i - k j) * x i j = 0 by
        rw [sub_mul, he, sub_self])).resolve_left (sub_ne_zero.mpr (hk.ne hij))).symm


end K07.T1
