@the_reading_has_two_fixed_points : ∀ {x : ℝ}, 0 ≤ x → (√x = x ↔ x = 0 ∨ x = 1)
the_power_has_two_fixed_points : ∀ (μ : ℂ), μ * μ = μ ↔ μ = 0 ∨ μ = 1
@axiomFlow_zero : ∀ {A : Type u_1} [inst : Ring A] [inst_1 : Algebra ℂ A] (P : A), axiomFlow P 0 = 1
@axiomFlow_add : ∀ {A : Type u_1} [inst : Ring A] [inst_1 : Algebra ℂ A] {P : A},
  IsIdempotentElem P → ∀ (s t : ℝ), axiomFlow P (s + t) = axiomFlow P s * axiomFlow P t
@axiomFlow_fixes_the_post : ∀ {A : Type u_1} [inst : Ring A] [inst_1 : Algebra ℂ A] {P : A},
  IsIdempotentElem P → ∀ (t : ℝ), axiomFlow P t * P = P ∧ P * axiomFlow P t = P
@axiomFlow_gradient : ∀ {A : Type u_1} [inst : Ring A] [inst_1 : Algebra ℂ A] {P : A},
  IsIdempotentElem P → ∀ (t : ℝ), axiomFlow P t * (1 - P) = ↑(Real.exp (-t)) • (1 - P)
@axiomFlow_tendsto_the_post : ∀ {A : Type u_1} [inst : NormedRing A] [inst_1 : NormedAlgebra ℂ A] (P : A),
  Filter.Tendsto (axiomFlow P) Filter.atTop (nhds P)
@the_fixed_set_is_the_lock_zero : ∀ {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (ψ : C.F),
  (∀ (t : ℝ), (axiomFlow (QGReaderUVLock.PFmic C) t) ψ = ψ) ↔ (QGReaderUVLock.HminMic C) ψ = 0
@the_post_is_the_modular_zero : ∀ {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (ψ : C.F),
  (∀ (t : ℝ), (axiomFlow (QGReaderUVLock.PFmic C) t) ψ = ψ) ↔ ∀ (t : ℝ), (ImportedSQ.lightDelta C t) ψ = ψ
the_one_is_the_axiom : √1 = 1 ∧ ∫ (κ : ℝ), phi0sq κ = 1 ∧ dimOrTop ℂ firstAtom = 1
@the_zero_is_the_false_witness : ∀ {β g : ℝ},
  0 < β →
    0 < g →
      √0 = 0 ∧
        (¬FullStaticWitness fun t x => Real.exp (-(t * β * g)) * x) ∧
          ∀ {n : ℕ} (d x : Fin n → ℝ) (i : Fin n), x i ≠ 0 → ∀ (t : ℝ), diagFlow β d t x i ≠ 0
@the_living_verb_moves : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (d : n → ℝ) (i₀ : n),
  0 < d i₀ → ∀ {t β : ℝ}, 0 < t → 0 < β → NormedSpace.exp (-(t * β) • Matrix.diagonal d) ≠ 1
@the_living_verb_fixes_the_name : ∀ {H : Type} [inst : NormedAddCommGroup H] [inst_1 : InnerProductSpace ℂ H]
  [CompleteSpace H] (T : H →L[ℂ] H) (q : Polynomial ℂ) {x : H},
  x ∈ (↑T).ker → ((Polynomial.aeval T) q) x = q.coeff 0 • x
@the_axiom_and_the_false_witness : ∀ {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) {β g : ℝ},
  0 < β →
    0 < g →
      (∀ (x : ℝ), 0 ≤ x → (√x = x ↔ x = 0 ∨ x = 1)) ∧
        (∀ (t : ℝ), axiomFlow (QGReaderUVLock.PFmic C) t * QGReaderUVLock.PFmic C = QGReaderUVLock.PFmic C) ∧
          (∀ (t : ℝ),
              axiomFlow (QGReaderUVLock.PFmic C) t * (1 - QGReaderUVLock.PFmic C) =
                ↑(Real.exp (-t)) • (1 - QGReaderUVLock.PFmic C)) ∧
            Filter.Tendsto (axiomFlow (QGReaderUVLock.PFmic C)) Filter.atTop (nhds (QGReaderUVLock.PFmic C)) ∧
              (∀ (ψ : C.F),
                  (∀ (t : ℝ), (axiomFlow (QGReaderUVLock.PFmic C) t) ψ = ψ) ↔
                    ∀ (t : ℝ), (ImportedSQ.lightDelta C t) ψ = ψ) ∧
                (√1 = 1 ∧ ∫ (κ : ℝ), phi0sq κ = 1 ∧ dimOrTop ℂ firstAtom = 1) ∧
                  (√0 = 0 ∧ ¬FullStaticWitness fun t x => Real.exp (-(t * β * g)) * x) ∧
                    finalStepNameAxioma =
                      "AXIOMA__THE_ONE_INSCRIBED_BY_THE_OBSERVER_RETURNS_AS_THE_FIXED_POINT_OF_THE_READING__PAYMENT_IN_THE_FACE_THE_NAME__COST_READ_IN_THE_REFLECTION__NOT_DISCRIMINATED_AT_AVAILABLE_SENSITIVITY__FALSIFIABLE_WHERE_THE_READING_LAW_ADMITS"
@absolute_zero_unreachable_in_finite_time : ∀ {n : ℕ} (β : ℝ) (d x : Fin n → ℝ) (i : Fin n),
  x i ≠ 0 → ∀ (t : ℝ), diagFlow β d t x i ≠ 0
@beta_forbids_full_static_witness : ∀ {β g : ℝ},
  0 < β → 0 < g → ¬FullStaticWitness fun t x => Real.exp (-(t * β * g)) * x
def TGLExt.FullStaticWitness : {M : Type} → (ℝ → M → M) → Prop :=
fun {M} T => ∀ (t : ℝ) (x : M), T t x = x
def TGLExt.diagFlow : {n : ℕ} → ℝ → (Fin n → ℝ) → ℝ → (Fin n → ℝ) → Fin n → ℝ :=
fun {n} β d t x i => Real.exp (-(t * β * d i)) * x i
