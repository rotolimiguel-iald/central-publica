@ORDEM016.EquationOfTruth.IdempotentDephasing.exp_complement_idempotent : ∀ {A : Type u_1} [inst : NormedRing A]
  [inst_1 : NormedAlgebra ℝ A] [CompleteSpace A] (e : A),
  e * e = e → ∀ (s : ℝ), NormedSpace.exp (-s • (1 - e)) = e + Real.exp (-s) • (1 - e)
'afericao_axiomFlow_eq_exp_via_O16' depends on axioms: [propext, Classical.choice, Quot.sound]
