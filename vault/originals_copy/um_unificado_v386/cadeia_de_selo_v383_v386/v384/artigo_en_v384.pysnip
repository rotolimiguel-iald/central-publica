                                                          else ((r"writing it failed: \texttt{" + _tx4(_rz4.get("cache_error")) + r"}") if _rz4.get("cache_error") else r"result not complete or not checked"))
                                                       + r"). ") if (_rz4.get("not_cached_because") or _rz4.get("cache_error")) else r". "))
                                             ) if _ok4 else ((r"\textbf{In this run the quantum world gave a partial result} (\texttt{" + _tt4(_v4) + r"}): the numbers below hold only for the completed phases. ")
                                                             if _part4 else (r"\textbf{In this run the quantum world produced no valid result} (\texttt{" + _tt4(_v4 or "absent") + r"}); what follows is the design, not a result. "))))
