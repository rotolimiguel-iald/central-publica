             + ((((r"There is no record of the CPU comparison in this run. ") if not _cr4 else (((r"The CPU reference \textbf{was not present} in this run (the reference file \texttt{cpuref.json} was not written)") if _cr4.get("error_code") == "CPUREF_JSON_ABSENT"
                    else (r"The CPU comparison \textbf{failed} in this run (\texttt{" + _tx4(_cr4.get("error")) + r"})")) + r"; the CPU process "
                  + ((r"ended with code " + _tx4(_crc4)) if _crc4 is not None else r"did not finish or was stopped at the deadline") + r". "))
                 if (not _cr4 or _cr4.get("error")) else
                 (r"The CPU reference, in this run: read " + _i4(_cr4.get("read")) + r" points, compared " + _i4(_cr4.get("compared")) + r" (" + _i4(_cr4.get("near_threshold_not_compared")) + r" near the gap threshold), disagreed in "
                  + _i4(_cr4.get("disagreements")) + (r"; the run mark \textbf{did not match}" if _cr4.get("meta_ok") is False else "") + r"; the CPU process "
                  + ((r"ended with code " + _tx4(_crc4)) if _crc4 is not None else r"did not finish or was stopped at the deadline") + r". "))
                if (_cpuvoid4 and not _q4.get("summary_error")) else "")   # an empty summary is not absence (6th audit)
             + r"The operator reads the recovery of General Relativity as the cosmological proof of the theory \textsf{[DECLARED]} (declaration of 2026-10-02); the program's rule keeps what it always kept: not falsified is not confirmed. "
