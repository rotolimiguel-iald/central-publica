    _p0d4 = sorted(((d_, v_.get("pass_sigma0"), v_.get("n")) for d_, v_ in (_t1.get("per_d") or {}).items()), key=lambda t_: int(t_[0]) if str(t_[0]).isdigit() else 0)
    _pf4 = _q4.get("preregistration") or {}; _pff4 = _pf4.get("files") or {}
    _rz4 = _q4.get("reuse") or {}
    _ncc4 = str(_rz4.get("not_cached_code") or "")

    def _t1nz4(sg_):
        # a maior mediana FINITA entre as dimensoes e, a parte, as dimensoes com estimativas sem solucao finita (3a afericao: nada descartado em silencio)
        fin_ = []; nf_ = []
        for d_, v_ in sorted((_t1.get("per_d") or {}).items(), key=lambda kv_: int(kv_[0]) if str(kv_[0]).isdigit() else 0):
            m_ = (v_.get("median_beta_rel_err") or {}).get(sg_); k_ = (v_.get("n_nonfinite_beta") or {}).get(sg_) or 0; n_ = (v_.get("n_by_sigma") or {}).get(sg_) or 0
            if _fin4(m_):
                fin_.append(m_)
            if k_:
                nf_.append((d_, int(k_), int(n_)))
        return (max(fin_) if fin_ else None), nf_
    _tot4 = sum(v_ for v_ in _ph4.values() if _fin4(v_)) / 60.0 if _ph4 else None
    _d8sc4 = str(_d8.get("status_code") or "")
    s.append(r"\section*{Introduction: what this code does now (v384)}")
    s.append(r"This article is emitted by the program it describes --- \texttt{um.py}, a single file that contains its own formal kernel, its own tests and its own GPU work. "
             r"A run begins with the inscription of the One ($\omega(I)=1$) and, from there, the program does \textbf{three things}; the third runs \textbf{at the same time} as the first two:")
    s.append(r"\begin{enumerate}")
    s.append(r"\item \textbf{The kernel.} It materializes its Lean 4 kernel from itself and verifies it: in this run, " + str(_nclean) + r" supporting theorems with clean axioms.")
    s.append(r"\item \textbf{The cosmological tests.} It runs the pre-registered rites against public data --- the void floor, the clocks, the cosmological background, the gravitational echoes ---, whose verdicts, refusals included, are emitted by the machine.")
    s.append(r"\item \textbf{The quantum world.} On the GPU, in parallel with the first two, it computes the theory's open quantum system: the luminodynamic Hamiltonian $H_{\rm LD}$ and the five Lindblad jump operators "
             r"--- rehearsal, anti-coherence, pruning, consolidation and dissipation ---, in which anti-coherence is the theory's own dephasing, $L_{\rm anti}=\sqrt{\bTGL}\,\sqrt K$, the root law. "
             r"It submits this system to four tests frozen by hash before the computation; the note below says what is computed and how.")
    s.append(r"\end{enumerate}")
    s.append(r"At the end it writes this article (in Portuguese and in English), the data and the seal, whose hash binds every number to the run. "
             + ((r"In this run the GPU result was \textbf{reused} from the run of " + _tt4((_q4.get("reuse") or {}).get("from_run_finished")) + r" (key \texttt{" + _tt4(_q4.get("key")) + r"}), because nothing that produces it changed; the final version always runs in full. ")
                if (_reuse4 and _ok4) else ((r"In this run the quantum world was \textbf{computed} (key \texttt{" + _tt4(_q4.get("key")) + r"})"
