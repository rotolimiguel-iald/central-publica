+    'TGLExt/F1Fecho394/LpClosedSubspaceCoreR3.lean': 'import TGLExt.F1Fecho394.RealLpGraphCoreR3\r\n\r\n/-! Closed subspace valued L2 functions are approximated by interval vectors\r\nwith values in any dense subset of the closed subspace. This is a graph-core\r\nlemma when the subspace is an actual closed real Tomita graph. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.LpClosedSubspaceCore\r\nopen RealLpGraphCore\r\nvariable {E:Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\r\n\r\ntheorem lift_interval (A:E→L[ℝ]E) (a b:ℝ) (v:E) :\r\n    A.compLpL 2 (volume:Measure ℝ) (intervalVector a b v)=intervalVector a b (A v) := by\r\n  apply Lp.ext\r\n  filter_upwards [A.coeFn_compLpL (intervalVector a b v),\r\n    indicatorConstLp_coeFn (p:=2) (hs:=measurableSet_Ioc)\r\n      (hμs:=by simp [Real.volume_Ioc]) (c:=v),\r\n    indicatorConstLp_coeFn (p:=2) (hs:=measurableSet_Ioc)\r\n      (hμs:=by simp [Real.volume_Ioc]) (c:=A v)] with t ht hv hw\r\n  change intervalVector a b v t = _ at hv\r\n  change intervalVector a b (A v) t = _ at hw\r\n  rw [ht,hv,hw]\r\n  by_cases h:t∈Set.Ioc a b\r\n  · simp only [Set.indicator_of_mem h]\r\n  · simp only [Set.indicator_of_notMem h,map_zero]\r\n\r\ntheorem mem_of_intervals (G:Submodule ℝ E) [G.HasOrthogonalProjection]\r\n    (N:Submodule ℝ (Lp E 2 (volume:Measure ℝ)))\r\n    (hN:IsClosed (N:Set (Lp E 2 (volume:Measure ℝ))))\r\n    (hi:∀ a b v,v∈G→intervalVector a b v∈N)\r\n    (f:Lp E 2 (volume:Measure ℝ)) (hf:∀ᵐ t:ℝ ∂volume,f t∈G) : f∈N := by\r\n  let P:=G.starProjection.compLpL 2 (volume:Measure ℝ)\r\n  have he : N.comap P.toLinearMap=⊤ := by\r\n    apply closed_submodule_eq_top\r\n    · exact hN.preimage P.continuous\r\n    · intro a b v\r\n      change P (intervalVector a b v)∈N\r\n      change G.starProjection.compLpL 2 volume (intervalVector a b v)∈N\r\n      rw [lift_interval]\r\n      apply hi\r\n      exact (G.orthogonalProjectionOnto v).property\r\n  have hp : P f=f := by\r\n    apply Lp.ext\r\n    filter_upwards [G.starProjection.coeFn_compLpL f,hf] with t ht hg\r\n    exact ht.trans (G.starProjection_eq_self_iff.mpr hg)\r\n  have hm : f∈N.comap P.toLinearMap := by rw [he]; trivial\r\n  change P f∈N at hm\r\n  rwa [hp] at hm\r\n\r\ntheorem mem_of_dense_interval_values (G:Submodule ℝ E) [G.HasOrthogonalProjection]\r\n    (D:Set E) (hD:closure D=(G:Set E))\r\n    (N:Submodule ℝ (Lp E 2 (volume:Measure ℝ)))\r\n    (hN:IsClosed (N:Set (Lp E 2 (volume:Measure ℝ))))\r\n    (hi:∀ a b v,v∈D→intervalVector a b v∈N)\r\n    (f:Lp E 2 (volume:Measure ℝ)) (hf:∀ᵐ t:ℝ ∂volume,f t∈G) : f∈N := by\r\n  apply mem_of_intervals G N hN ?_ f hf\r\n  intro a b v hv\r\n  have hc:IsClosed {v:E|intervalVector a b v∈N}:=hN.preimage (intervalVector_continuous a b)\r\n  apply closure_minimal (fun v hv=>hi a b v hv) hc\r\n  rwa [hD]\r\n\r\nend F1Fecho.LpClosedSubspaceCore\r\n#print axioms F1Fecho.LpClosedSubspaceCore.lift_interval\r\n#print axioms F1Fecho.LpClosedSubspaceCore.mem_of_intervals\r\n#print axioms F1Fecho.LpClosedSubspaceCore.mem_of_dense_interval_values\r\n',
+    'TGLExt/F1Fecho394/LpIntervalTotalVectorsR1.lean': 'import TGLExt.F1Fecho394.LpIntervalTotalityR3\r\n/-! Interval generators from any total vector family; no separability assumption. -/\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.LpIntervalTotalVectors\r\nopen MeasureTheory\r\nopen F1Fecho.LpIntervalTotality\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem closed_submodule_eq_top_of_total\r\n    (S : Submodule ℂ (Lp H 2 (volume : Measure ℝ)))\r\n    (hS : IsClosed (S : Set (Lp H 2 (volume : Measure ℝ))))\r\n    (W : Set H) (hW : ∀ v : H, (∀ w∈W, inner ℂ v w=0) → v=0)\r\n    (hi : ∀ a b w, w∈W → intervalVector a b w ∈ S) : S=⊤ := by\r\n  letI : CompleteSpace S := hS.completeSpace_coe\r\n  apply Submodule.orthogonal_eq_bot_iff.mp\r\n  apply le_antisymm ?_ bot_le\r\n  intro f hf\r\n  change f=0\r\n  have hI (a b : ℝ) : (∫ t in Set.Ioc a b, f t)=0 := by\r\n    apply hW\r\n    intro w hw\r\n    have hh := Submodule.inner_right_of_mem_orthogonal (hi a b w hw) hf\r\n    rw [intervalVector_inner] at hh\r\n    exact inner_eq_zero_symm.mp hh\r\n  apply vector_eq_zero_of_intervals f\r\n  intro a b\r\n  simp only [intervalIntegral,hI,sub_self]\r\nend F1Fecho.LpIntervalTotalVectors\r\n#print axioms F1Fecho.LpIntervalTotalVectors.closed_submodule_eq_top_of_total\r\n',
+    'TGLExt/F1Fecho394/LpIntervalTotalityR3.lean': 'import Mathlib.MeasureTheory.Integral.IntervalIntegral.LebesgueDifferentiationThm\r\nimport Mathlib.MeasureTheory.Function.AEEqOfIntegral\r\nimport Mathlib.MeasureTheory.Function.L2Space\r\nimport Mathlib.MeasureTheory.Function.LocallyIntegrable\r\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\r\n/-! Interval vectors are total in the actual vector-valued L2 space.\r\nLebesgue differentiation supplies the missing analytic density argument;\r\nno totality or separability hypothesis is inserted for the value space. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 600000\r\nnoncomputable section\r\nnamespace F1Fecho.LpIntervalTotality\r\nopen MeasureTheory Filter\r\nopen scoped Topology ENNReal\r\n\r\ntheorem real_ae_zero {f : ℝ → ℝ} (hf : LocallyIntegrable f volume)\r\n    (hz : ∀ a b, (∫ t : ℝ in a..b, f t)=0) : f =ᵐ[volume] 0 := by\r\n  have hp : (fun x => ∫ t : ℝ in (0 : ℝ)..x, f t) = fun _ => (0 : ℝ) := funext (hz 0)\r\n  filter_upwards [_root_.LocallyIntegrable.ae_hasDerivAt_integral hf] with x hx\r\n  have hd := hx 0\r\n  rw [hp] at hd\r\n  exact hd.unique (hasDerivAt_const x (0 : ℝ))\r\n\r\nvariable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]\r\n\r\ntheorem vector_eq_zero_of_intervals (f : Lp E 2 (volume : Measure ℝ))\r\n    (hz : ∀ a b, (∫ t : ℝ in a..b, f t)=0) : f=0 := by\r\n  have hl := (Lp.memLp f).locallyIntegrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)\r\n  have hi (a b : ℝ) : IntervalIntegrable f volume a b :=\r\n    intervalIntegrable_iff.mpr ((hl.integrableOn_isCompact isCompact_uIcc).mono_set Set.uIoc_subset_uIcc)\r\n  obtain ⟨s,hs,hfs⟩ := (Lp.memLp f).1.isSeparable_ae_range\r\n  have ha : (f : ℝ → E) =ᵐ[volume] 0 := by\r\n    apply ae_eq_zero_of_forall_dual_of_isSeparable ℝ hs ?_ hfs\r\n    intro c\r\n    apply real_ae_zero ((c.comp_memLp f).locallyIntegrable (by norm_num : (1 : ℝ≥0∞) ≤ 2))\r\n    intro a b\r\n    exact (c.intervalIntegral_comp_comm (hi a b)).trans (by rw [hz,map_zero])\r\n  apply Lp.ext\r\n  exact ha.trans (Lp.coeFn_zero E 2 volume).symm\r\n\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ndef intervalVector (a b : ℝ) (v : H) : Lp H 2 (volume : Measure ℝ) :=\r\n  indicatorConstLp (s:=Set.Ioc a b) 2 measurableSet_Ioc (by simp [Real.volume_Ioc]) v\r\n\r\ntheorem intervalVector_inner (a b : ℝ) (v : H) (f : Lp H 2 (volume : Measure ℝ)) :\r\n    inner ℂ (intervalVector a b v) f = inner ℂ v (∫ t in Set.Ioc a b, f t) :=\r\n  L2.inner_indicatorConstLp_eq_inner_setIntegral (s:=Set.Ioc a b) ℂ measurableSet_Ioc\r\n    (by simp [Real.volume_Ioc]) v f\r\n\r\ntheorem eq_zero_of_interval_orthogonal (f : Lp H 2 (volume : Measure ℝ))\r\n    (hf : ∀ a b v, inner ℂ (intervalVector a b v) f=0) : f=0 := by\r\n  have hi (a b : ℝ) : (∫ t in Set.Ioc a b, f t)=0 := by\r\n    apply (inner_self_eq_zero (𝕜:=ℂ)).mp\r\n    rw [← intervalVector_inner]\r\n    exact hf a b _\r\n  apply vector_eq_zero_of_intervals f\r\n  intro a b\r\n  simp only [intervalIntegral,hi,sub_self]\r\n\r\ntheorem closed_submodule_eq_top\r\n    (S : Submodule ℂ (Lp H 2 (volume : Measure ℝ))) (hs : IsClosed (S : Set (Lp H 2 (volume : Measure ℝ))))\r\n    (hi : ∀ a b v, intervalVector a b v ∈ S) : S=⊤ := by\r\n  letI : CompleteSpace S := hs.completeSpace_coe\r\n  apply Submodule.orthogonal_eq_bot_iff.mp\r\n  apply le_antisymm ?_ bot_le\r\n  intro f hf\r\n  change f=0\r\n  apply eq_zero_of_interval_orthogonal\r\n  intro a b v\r\n  exact Submodule.inner_right_of_mem_orthogonal (hi a b v) hf\r\n\r\nend F1Fecho.LpIntervalTotality\r\n#print axioms F1Fecho.LpIntervalTotality.real_ae_zero\r\n#print axioms F1Fecho.LpIntervalTotality.vector_eq_zero_of_intervals\r\n#print axioms F1Fecho.LpIntervalTotality.intervalVector_inner\r\n#print axioms F1Fecho.LpIntervalTotality.eq_zero_of_interval_orthogonal\r\n\r\n#print axioms F1Fecho.LpIntervalTotality.closed_submodule_eq_top\r\n',
+    'TGLExt/F1Fecho394/LpPairTransportR3.lean': 'import TGLExt.F1Fecho394.CoefficientBoostR1\r\nimport TGLExt.F1Fecho394.CoefficientConjugationR2\r\nimport Mathlib.Analysis.InnerProductSpace.ProdL2\r\n\r\n/-! Exact continuous transport between coefficient pairs and Hilbert pair valued L2.\r\nNo GNS representation or graph equality is assumed here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.LpPairTransport\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nabbrev PairH (H:Type) := WithLp 2 (H×H)\r\nabbrev PairLp (H:Type) [NormedAddCommGroup H] := Lp (PairH H) 2 (volume:Measure ℝ)\r\n\r\ndef leftMap : H→L[ℂ]PairH H :=\r\n  (WithLp.prodContinuousLinearEquiv 2 ℂ H H).symm.toContinuousLinearMap.comp\r\n    (ContinuousLinearMap.inl ℂ H H)\r\ndef rightMap : H→L[ℂ]PairH H :=\r\n  (WithLp.prodContinuousLinearEquiv 2 ℂ H H).symm.toContinuousLinearMap.comp\r\n    (ContinuousLinearMap.inr ℂ H H)\r\ndef fstMap : PairLp H→L[ℂ]RegularHilbert H := (WithLp.fstL 2 ℂ H H).compLpL 2 volume\r\ndef sndMap : PairLp H→L[ℂ]RegularHilbert H := (WithLp.sndL 2 ℂ H H).compLpL 2 volume\r\n\r\ndef pair (f g:RegularHilbert H) : PairLp H :=\r\n  (leftMap (H:=H)).compLpL 2 volume f+(rightMap (H:=H)).compLpL 2 volume g\r\n\r\ntheorem pair_ae (f g:RegularHilbert H) :\r\n    pair f g =ᵐ[volume] fun a=>WithLp.toLp 2 (f a,g a) := by\r\n  filter_upwards [Lp.coeFn_add ((leftMap (H:=H)).compLpL 2 volume f)\r\n      ((rightMap (H:=H)).compLpL 2 volume g),\r\n    (leftMap (H:=H)).coeFn_compLpL f,(rightMap (H:=H)).coeFn_compLpL g] with a ha hb hc\r\n  change pair f g a=_\r\n  change (((leftMap (H:=H)).compLpL 2 volume f+(rightMap (H:=H)).compLpL 2 volume g) a)=_ at ha\r\n  rw [show pair f g a= _ from ha]\r\n  simp only [Pi.add_apply]\r\n  rw [hb,hc]\r\n  apply (WithLp.linearEquiv 2 ℂ (H×H)).injective\r\n  change (f a,0)+(0,g a)=(f a,g a)\r\n  simp\r\n\r\ntheorem fst_pair (f g:RegularHilbert H) : fstMap (pair f g)=f := by\r\n  apply Lp.ext\r\n  filter_upwards [(WithLp.fstL 2 ℂ H H).coeFn_compLpL (pair f g),pair_ae f g] with a ha hb\r\n  change fstMap (pair f g) a=_\r\n  change (WithLp.fstL 2 ℂ H H).compLpL 2 volume (pair f g) a=_ at ha\r\n  rw [show fstMap (pair f g) a=_ from ha,hb]\r\n  rfl\r\n\r\ntheorem snd_pair (f g:RegularHilbert H) : sndMap (pair f g)=g := by\r\n  apply Lp.ext\r\n  filter_upwards [(WithLp.sndL 2 ℂ H H).coeFn_compLpL (pair f g),pair_ae f g] with a ha hb\r\n  change sndMap (pair f g) a=_\r\n  change (WithLp.sndL 2 ℂ H H).compLpL 2 volume (pair f g) a=_ at ha\r\n  rw [show sndMap (pair f g) a=_ from ha,hb]\r\n  rfl\r\n\r\ndef encode (B:UnitaryFlow H) (f g:RegularHilbert H) : PairLp H :=\r\n  pair f (CoefficientBoost.multiplier B 1 (CoefficientConjugation.reflection g))\r\n\r\ndef decode (B:UnitaryFlow H) : PairLp H→L[ℂ](RegularHilbert H×RegularHilbert H) :=\r\n  fstMap.prod (CoefficientConjugation.reflection.toLinearIsometry.toContinuousLinearMap.comp\r\n    ((CoefficientBoost.multiplier B (-1)).comp sndMap))\r\n\r\ntheorem decode_encode (B:UnitaryFlow H) (f g:RegularHilbert H) :\r\n    decode B (encode B f g)=(f,g) := by\r\n  apply Prod.ext\r\n  · exact fst_pair _ _\r\n  · change CoefficientConjugation.reflection\r\n      (CoefficientBoost.multiplier B (-1) (sndMap (pair f _)))=g\r\n    rw [snd_pair,CoefficientBoost.multiplier_inverse]\r\n    exact CoefficientConjugation.reflectionMap_involutive g\r\n\r\ntheorem encode_ae (B:UnitaryFlow H) (f g:RegularHilbert H) :\r\n    encode B f g =ᵐ[volume] fun a=>WithLp.toLp 2 (f a,B.U a (g (-a))) := by\r\n  filter_upwards [pair_ae f (CoefficientBoost.multiplier B 1 (CoefficientConjugation.reflection g)),\r\n    CoefficientBoost.multiplier_ae B 1 (CoefficientConjugation.reflection g),\r\n    CoefficientConjugation.reflectionMap_ae g] with a ha hb hc\r\n  change encode B f g a=_\r\n  change pair f _ a=_ at ha\r\n  rw [show encode B f g a=_ from ha,hb]\r\n  change (CoefficientConjugation.reflection g) a=g (-a) at hc\r\n  rw [hc,one_mul]\r\n\r\nend F1Fecho.LpPairTransport\r\n#print axioms F1Fecho.LpPairTransport.pair_ae\r\n#print axioms F1Fecho.LpPairTransport.fst_pair\r\n#print axioms F1Fecho.LpPairTransport.snd_pair\r\n#print axioms F1Fecho.LpPairTransport.decode_encode\r\n#print axioms F1Fecho.LpPairTransport.encode_ae\r\n',
+    'TGLExt/F1Fecho394/MatrixCornerFromNilpotentR3.lean': "import TGLExt.V354BoundedPolar\r\n\r\n/-! R50 auxiliary candidate. Reuse the actual bounded polar factor to extract\r\nan orthogonal matrix corner from a nonzero square-zero operator in the same\r\nvon Neumann algebra. This is an auxiliary implication, not yet a concrete\r\nFock supplier: construction of the square-zero operator remains required.\r\nNo trace, finiteness, factor type or matrix embedding is hypothesized here.\r\nThe finite positive trace and its split are separate consumers. -/\r\nset_option autoImplicit false\r\nset_option Elab.async false\r\nset_option maxHeartbeats 400000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.MatrixCornerFromNilpotent\r\nopen TGLV354\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\n/-- Square-zero forces the closed range into the kernel. -/\r\ntheorem rangeClosure_le_ker (T : H →L[ℂ] H) (hTT : T*T=0) :\r\n    T.range.topologicalClosure ≤ T.ker := by\r\n  apply Submodule.topologicalClosure_minimal\r\n  · rintro x ⟨y,rfl⟩\r\n    exact congrArg (fun A : H →L[ℂ] H => A y) hTT\r\n  · exact T.isClosed_ker\r\n#print axioms rangeClosure_le_ker\r\n\r\n/-- The polar has the same closed range; this support identity uses only\r\nthe already constructed polar, not a chosen partial isometry. -/\r\ntheorem polar_range_support (T : H →L[ℂ] H) :\r\n    T.range.topologicalClosure.starProjection * boundedPolar T = boundedPolar T := by\r\n  rw [← boundedPolar_mul_star, mul_assoc, boundedPolar_star_mul,\r\n    boundedPolar_initial_support]\r\n#print axioms polar_range_support\r\n\r\ntheorem initial_support_mul_polar_zero (T : H →L[ℂ] H) (hTT : T*T=0) :\r\n    T.kerᗮ.starProjection * boundedPolar T = 0 := by\r\n  ext x\r\n  change T.kerᗮ.starProjection (boundedPolar T x) = 0\r\n  rw [Submodule.starProjection_apply_eq_zero_iff]\r\n  have hr : boundedPolar T x ∈ T.range.topologicalClosure := by\r\n    have hs := congrArg (fun A : H →L[ℂ] H => A x) (polar_range_support T)\r\n    rw [← hs]\r\n    exact Submodule.starProjection_apply_mem _ _\r\n  have hk := rangeClosure_le_ker T hTT hr\r\n  simpa only [Submodule.orthogonal_orthogonal] using hk\r\n#print axioms initial_support_mul_polar_zero\r\n\r\n/-- A nonzero square-zero element supplies exactly the corner used by the\r\nfinite-split construction. Existence of such an element in the Fock core\r\nis not asserted by this auxiliary theorem. -/\r\ntheorem matrix_corner_of_square_zero (N : VonNeumannAlgebra H)\r\n    (T : H →L[ℂ] H) (hTm : T ∈ N) (hT : T ≠ 0) (hTT : T*T=0) :\r\n    ∃ (e v : H →L[ℂ] H), e ∈ N ∧ v ∈ N ∧ IsStarProjection e ∧\r\n      e ≠ 0 ∧ star v * v = e ∧ e * v = 0 := by\r\n  let v := boundedPolar T\r\n  let e := T.kerᗮ.starProjection\r\n  have hvm : v ∈ N := boundedPolar_mem N T hTm\r\n  have hve : star v*v=e := boundedPolar_star_mul T\r\n  have hem : e ∈ N := by\r\n    rw [← hve]\r\n    exact N.mul_mem (N.toStarSubalgebra.star_mem' hvm) hvm\r\n  have hen : e ≠ 0 := by\r\n    intro he\r\n    have hu : v=0 := by\r\n      have hs : v*e=v := boundedPolar_initial_support T\r\n      rw [he,mul_zero] at hs\r\n      exact hs.symm\r\n    apply hT\r\n    have ht := boundedPolar_mul_absolute T\r\n    change v * CFC.sqrt (star T*T)=T at ht\r\n    rw [hu,zero_mul] at ht\r\n    exact ht.symm\r\n  exact ⟨e,v,hem,hvm,isStarProjection_starProjection,hen,hve,\r\n    initial_support_mul_polar_zero T hTT⟩\r\n#print axioms matrix_corner_of_square_zero\r\nend F1Fecho.MatrixCornerFromNilpotent\r\n",
+    'TGLExt/F1Fecho394/MaxwellBoostContractionR1.lean': 'import TGLExt.F1Fecho394.CovariantTensorPullbackR3\r\nimport TGLExt.F1Fecho394.CartesianMaxwellChartR3\r\nimport TGLExt.F1Fecho394.ScreenPoincareCovarianceR2\r\n\r\n/-! The global Cartesian Maxwell bivector and the real O16 screens give the\r\nsame boosted tensor contraction off the null axis. This is a coefficient\r\nidentity, including the covariant tensor indices and the inverse boost. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Matrix\r\nnamespace F1Fecho.MaxwellBoostContraction\r\nopen TGLExt F1Fecho.MaxwellGlobal F1Fecho.MaxwellOnShell\r\nopen F1Fecho.OrbitalSpatial F1Fecho.OrbitalScreen F1Fecho.CovariantTensor\r\nopen ChatgptAudit.WignerOrbit016 ChatgptAudit.WignerRapidityMeasure016\r\n\r\ntheorem realLift_mulVec (A:Matrix (Fin 4) (Fin 4) ℝ) (p:Fin 4→ℝ) :\r\n    (A.map Complex.ofReal).mulVec (realLift p)=realLift (A.mulVec p) := by\r\n  funext μ\r\n  simp [Matrix.mulVec,dotProduct,realLift,Complex.ofReal_sum,Complex.ofReal_mul]\r\n\r\ntheorem contraction_transport (A:Matrix (Fin 4) (Fin 4) ℝ)\r\n    (p q:MomentumCoordinates) (hp:p.1≠0) (hq:q.1≠0) (j:Fin 2)\r\n    (hm:A.mulVec (shellMomentum 0 p)=shellMomentum 0 q)\r\n    (hs:A.mulVec (screen (inverseRapidityChart 0 p) j)=screen (inverseRapidityChart 0 q) j)\r\n    (T:TensorValue) :\r\n    (∑μ,∑ν,(cartesianStrength p j μ ν:ℂ)*pull (A.map Complex.ofReal) T μ ν)=\r\n      ∑μ,∑ν,(cartesianStrength q j μ ν:ℂ)*T μ ν := by\r\n  simp_rw [cartesianStrength_inverse_chart p hp,cartesianStrength_inverse_chart q hq]\r\n  rw [←real_contraction_eq_sum,contraction_pull,realLift_mulVec,realLift_mulVec,hm,hs,\r\n    real_contraction_eq_sum]\r\n\r\ntheorem boost_contraction_ae (s:ℝ) :\r\n    ∀ᵐ p ∂orbitalMeasure 0,∀j:Fin 2,∀T:TensorValue,\r\n      (∑μ,∑ν,(cartesianStrength p j μ ν:ℂ)*\r\n        pull ((theBoost s)⁻¹.val.map Complex.ofReal) T μ ν)=\r\n      ∑μ,∑ν,(cartesianStrength (coordinateBoost