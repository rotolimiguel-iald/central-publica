+    'TGLExt/F1Fecho394/GeneralRegularDualScalingR2.lean': 'import TGLExt.F1Fecho394.GeneralRegularSpectralGraphR2\r\nimport TGLExt.V351RegularGeneratorDualScaling\r\n/-! Dual graph scaling for the same generic regular positive generator.\r\nThis proves the actual graph/domain covariance. It is not by itself a trace\r\nscaling theorem; the inverse-weight construction remains a separate consumer. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory FourierTransform SchwartzMap Filter\r\nopen scoped FourierTransform ENNReal\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n/-- The same spectral coordinates turn the actual dual action into translation. -/\r\ntheorem regularSpectralCoordinates_dual (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (s : ℝ)\r\n    (x : RegularHilbert (H)) :\r\n    (regularSpectralCoordinates B).symm (characterMultiplier s x) =\r\n      shift (-s/(2*Real.pi)) ((regularSpectralCoordinates B).symm x) := by\r\n  let F := Lp.fourierTransformₗᵢ ℝ (H)\r\n  let W := CoefficientBoost.unitary B 1\r\n  let V := regularSpectralCoordinates B\r\n  have hv (u : RegularHilbert (H)) :\r\n      V (shift (-s/(2*Real.pi)) u) = characterMultiplier s (V u) := by\r\n    have hf : F.symm (shift (-s/(2*Real.pi)) u) = characterMultiplier s (F.symm u) := by\r\n      apply F.injective\r\n      rw [LinearIsometryEquiv.apply_symm_apply, fourier_characterMultiplier,\r\n        LinearIsometryEquiv.apply_symm_apply]\r\n    change W (F.symm (shift (-s/(2*Real.pi)) u)) =\r\n      characterMultiplier s (W (F.symm u))\r\n    rw [hf]\r\n    exact congrArg (fun A : RegularHilbert (H) →L[ℂ]\r\n      RegularHilbert (H) => A (F.symm u))\r\n      (operatorFieldLift_commutes_character (CoefficientBoost.family B 1) s)\r\n  apply V.injective\r\n  rw [LinearIsometryEquiv.apply_symm_apply, hv, LinearIsometryEquiv.apply_symm_apply]\r\n\r\n/-- Domain and graph covariance: h C_s = exp(s) C_s h. This is the graph form\r\nof Ad(C_s) h = exp(-s) h, not a claim based only on imaginary powers. -/\r\ntheorem regularPositiveGenerator_dual_graph (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (s : ℝ)\r\n    (x y : RegularHilbert (H))\r\n    (hxy : (x,y) ∈ (regularPositiveGenerator B).graph) :\r\n    (characterMultiplier s x,(Real.exp s : ℂ) • characterMultiplier s y) ∈\r\n      (regularPositiveGenerator B).graph := by\r\n  rw [regularPositiveGenerator_graph_iff] at hxy ⊢\r\n  rw [map_smul, regularSpectralCoordinates_dual, regularSpectralCoordinates_dual]\r\n  let q : ℝ := -s/(2*Real.pi)\r\n  filter_upwards [Lp.coeFn_smul (Real.exp s : ℂ)\r\n      (shift q ((regularSpectralCoordinates B).symm y)),\r\n    shift_ae q ((regularSpectralCoordinates B).symm y),\r\n    shift_ae q ((regularSpectralCoordinates B).symm x),\r\n    (measurePreserving_sub_right volume q).quasiMeasurePreserving.ae hxy]\r\n    with ξ h1 h2 h3 h4\r\n  rw [h1,Pi.smul_apply,h2,h3,h4,smul_smul]\r\n  rw [← Complex.ofReal_mul, ← Real.exp_add]\r\n  have he : s + -(2*Real.pi*(ξ-q)) = -(2*Real.pi*ξ) := by\r\n    dsimp [q]\r\n    field_simp\r\n    ring\r\n  rw [he]\r\n\r\ntheorem regularPositiveGenerator_dual_scaling (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (s : ℝ)\r\n    (x y : RegularHilbert (H)) :\r\n    (x,y) ∈ (regularPositiveGenerator B).graph ↔\r\n      (characterMultiplier s x,(Real.exp s : ℂ) • characterMultiplier s y) ∈\r\n        (regularPositiveGenerator B).graph := by\r\n  constructor\r\n  · exact regularPositiveGenerator_dual_graph B s x y\r\n  · intro h\r\n    have hh := regularPositiveGenerator_dual_graph B (-s) _ _ h\r\n    have hi (u : RegularHilbert (H)) :\r\n        characterMultiplier (-s) (characterMultiplier s u) = u := by\r\n      simpa only [neg_neg] using characterMultiplier_inverse (-s) u\r\n    have he : (Real.exp (-s) : ℂ) * (Real.exp s : ℂ) = 1 := by\r\n      rw [← Complex.ofReal_mul, ← Real.exp_add, neg_add_cancel, Real.exp_zero,\r\n        Complex.ofReal_one]\r\n    simpa only [map_smul,hi,smul_smul,he,one_smul] using hh\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralCoordinates_dual\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_dual_graph\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_dual_scaling\r\n',
+    'TGLExt/F1Fecho394/GeneralRegularImaginaryPowersR1.lean': "import TGLExt.F1Fecho394.GeneralRegularPositiveGraphR2\r\nimport TGLExt.F1Fecho394.GeneralRegularAbsorptionR1\r\nimport TGLExt.V351RegularImaginaryPowers\r\n\r\n/-! The positive graph generalizing v351 implements the SAME generic regular\r\nunitary group. The existing sigmoid functional calculus and Fourier shift\r\nare reused; no imaginary-power identification is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2500000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem regularSpectralCoordinates_character\r\n    (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (t : ℝ)\r\n    (u : RegularHilbert H) :\r\n    regularSpectralCoordinates B (characterMultiplier (2*Real.pi*t) u)=\r\n      RegularCovariantCore.regularUnitary B t (regularSpectralCoordinates B u) := by\r\n  let F:=Lp.fourierTransformₗᵢ ℝ H\r\n  have hf:=congrArg F.symm (fourier_shift t (F.symm u))\r\n  change F.symm (F (shift t (F.symm u)))=\r\n    F.symm (characterMultiplier (2*Real.pi*t) (F (F.symm u))) at hf\r\n  have hf' : F.symm (characterMultiplier (2*Real.pi*t) u)=shift t (F.symm u) := by\r\n    simpa only [LinearIsometryEquiv.symm_apply_apply,LinearIsometryEquiv.apply_symm_apply] using hf.symm\r\n  change CoefficientBoost.unitary B 1 (F.symm (characterMultiplier (2*Real.pi*t) u))=\r\n    RegularCovariantCore.regularUnitary B t (CoefficientBoost.unitary B 1 (F.symm u))\r\n  rw [hf']\r\n  exact absorption_shift B t (F.symm u)\r\n\r\n/-- The powers of the already constructed positive graph equal the whole\r\nregular group. Affiliation and dual scaling are separate obligations. -/\r\ntheorem regularPositiveGenerator_imaginaryPower (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (t : ℝ)\r\n    (u : RegularHilbert (H)) :\r\n    resolventImaginaryPower (regularSpectralResolvent B)\r\n      (regularSpectralResolvent_nonneg B) (regularSpectralResolvent_le_one B)\r\n      (regularSpectralResolvent_injective B) (regularSpectralResolvent_complement_injective B)\r\n      t u = RegularCovariantCore.regularUnitary B t u := by\r\n  let g : ℝ → ℝ := fun ξ => Real.sigmoid (2*Real.pi*ξ)\r\n  have hg : Continuous g := by fun_prop\r\n  have hg0 : ∀ ξ, 0 ≤ g ξ := fun ξ => Real.sigmoid_nonneg _\r\n  have hg1 : ∀ ξ, g ξ ≤ 1 := fun ξ => Real.sigmoid_le_one _\r\n  let M := realScalarMultiplier (H := H) g hg hg0 hg1\r\n  have hM0 : 0 ≤ M := realScalarMultiplier_nonneg _ _ _ _\r\n  have hM1 : M ≤ 1 := realScalarMultiplier_le_one _ _ _ _\r\n  have hiM : Function.Injective M := realScalarMultiplier_injective _ _ _ _\r\n    (fun ξ => Real.sigmoid_pos _)\r\n  have hjM : Function.Injective (1-M : _ →L[ℂ] _) := by\r\n    rw [show M = realScalarMultiplier g hg hg0 hg1 from rfl, realScalarMultiplier_complement]\r\n    exact realScalarMultiplier_injective _ _ _ _ (fun ξ => sub_pos.mpr (Real.sigmoid_lt_one _))\r\n  let V := regularSpectralCoordinates B\r\n  let VL := V.toLinearIsometry.toContinuousLinearMap\r\n  have he : regularSpectralResolvent B * VL = VL * M := by\r\n    ext1 x\r\n    change regularSpectralResolvent B (V x) = V (M x)\r\n    change V (M (V.symm (V x))) = V (M x)\r\n    rw [LinearIsometryEquiv.symm_apply_apply]\r\n  have hh := resolventImaginaryPower_intertwines (regularSpectralResolvent B) M VL\r\n    (regularSpectralResolvent_nonneg B) (regularSpectralResolvent_le_one B)\r\n    (regularSpectralResolvent_injective B) (regularSpectralResolvent_complement_injective B)\r\n    hM0 hM1 hiM hjM he t (V.symm u)\r\n  change resolventImaginaryPower (regularSpectralResolvent B)\r\n    (regularSpectralResolvent_nonneg B) (regularSpectralResolvent_le_one B)\r\n    (regularSpectralResolvent_injective B) (regularSpectralResolvent_complement_injective B)\r\n    t (V (V.symm u)) = V (resolventImaginaryPower M hM0 hM1 hiM hjM t (V.symm u)) at hh\r\n  rw [sigmoidMultiplier_imaginaryPower M rfl hM0 hM1 hiM hjM] at hh\r\n  rw [LinearIsometryEquiv.apply_symm_apply] at hh\r\n  exact hh.trans ((regularSpectralCoordinates_character B t (V.symm u)).trans\r\n    (congrArg (RegularCovariantCore.regularUnitary B t) (V.apply_symm_apply u)))\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralCoordinates_character\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_imaginaryPower\r\n",
+    'TGLExt/F1Fecho394/GeneralRegularInverseCutoffR1.lean': "import TGLExt.F1Fecho394.GeneralRegularDualScalingR2\r\nimport TGLExt.F1Fecho394.GeneralRegularAffiliationR1\r\n/-! The original v351 inverse-generator cutoff reused on any concrete\r\nregular flow. The cutoff is the inverse of h+epsilon on the SAME graph,\r\nand belongs to the SAME generic regular core. No trace is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nset_option synthInstance.maxHeartbeats 200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n/-- B_epsilon=(h+epsilon)^{-1}, obtained from the existing resolvent by the\r\ndual action. The inverse equation is proved below for epsilon>0. -/\r\ndef regularInverseGeneratorCutoff (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) :\r\n    RegularHilbert (H) →L[ℂ] RegularHilbert (H) :=\r\n  (ε⁻¹ : ℂ) • dualAmbient (Real.log ε) (regularSpectralResolvent B)\r\n\r\ntheorem regularInverseGeneratorCutoff_mem (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (ε : ℝ) :\r\n    regularInverseGeneratorCutoff B ε ∈ RegularCovariantCore.core B M := by\r\n  have hm : dualAmbient (Real.log ε) (regularSpectralResolvent B) ∈ RegularCovariantCore.core B M :=\r\n    (RegularCovariantCore.dualAction B M (Real.log ε)\r\n      ⟨regularSpectralResolvent B,regularSpectralResolvent_mem B M⟩).property\r\n  exact (RegularCovariantCore.core B M).toStarSubalgebra.smul_mem hm _\r\n\r\ntheorem regularInverseGeneratorCutoff_nonneg (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε) :\r\n    0 ≤ regularInverseGeneratorCutoff B ε := by\r\n  apply (ContinuousLinearMap.nonneg_iff_isPositive _).mpr\r\n  apply ((ContinuousLinearMap.nonneg_iff_isPositive _).mp\r\n    (dualAmbient_nonneg (Real.log ε) _ (regularSpectralResolvent_nonneg B))).smul_of_nonneg\r\n  exact_mod_cast inv_nonneg.mpr hε.le\r\n\r\ntheorem regularInverseGeneratorCutoff_le (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε) :\r\n    regularInverseGeneratorCutoff B ε ≤\r\n      (ε⁻¹ : ℂ) • (1 : RegularHilbert (H) →L[ℂ] RegularHilbert (H)) := by\r\n  have h := OrderHomClass.monotone (dualAmbient (H := H) (Real.log ε))\r\n    (regularSpectralResolvent_le_one B)\r\n  rw [map_one] at h\r\n  apply sub_nonneg.mp\r\n  rw [regularInverseGeneratorCutoff, ← smul_sub]\r\n  apply (ContinuousLinearMap.nonneg_iff_isPositive _).mpr\r\n  apply ((ContinuousLinearMap.nonneg_iff_isPositive _).mp (sub_nonneg.mpr h)).smul_of_nonneg\r\n  exact_mod_cast inv_nonneg.mpr hε.le\r\n\r\ntheorem regularInverseGeneratorCutoff_one (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    regularInverseGeneratorCutoff B 1 = regularSpectralResolvent B := by\r\n  simp only [regularInverseGeneratorCutoff, Complex.ofReal_one, inv_one, Real.log_one,\r\n    dualAmbient_zero, one_smul]\r\n  rfl\r\n\r\n/-- The image belongs to the domain of the same h and solves (h+epsilon)y=x. -/\r\ntheorem regularInverseGeneratorCutoff_graph (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε)\r\n    (x : RegularHilbert (H)) :\r\n    (regularInverseGeneratorCutoff B ε x,\r\n      x-(ε : ℂ) • regularInverseGeneratorCutoff B ε x) ∈\r\n        (regularPositiveGenerator B).graph := by\r\n  let R := regularSpectralResolvent B\r\n  let s := Real.log ε\r\n  let z := characterMultiplier (-s) x\r\n  have hg : (R z,z-R z) ∈ (regularPositiveGenerator B).graph := by\r\n    change (R z,z-R z) ∈ (resolventGraphOperator R (regularSpectralResolvent_injective B)).graph\r\n    rw [resolvent_graph_equation]\r\n    change R z-R (R z) = R (z-R z)\r\n    rw [map_sub]\r\n  have ht := regularPositiveGenerator_dual_graph B s (R z) (z-R z) hg\r\n  have hs : Real.exp s = ε := Real.exp_log hε\r\n  have hi : characterMultiplier s z = x := characterMultiplier_inverse s x\r\n  have he : (ε : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hε.ne'\r\n  have hc : regularInverseGeneratorCutoff B ε x =\r\n      (ε⁻¹ : ℂ) • characterMultiplier s (R z) := by\r\n    rw [regularInverseGeneratorCutoff,dualAmbient_apply,characterMultiplier_star]\r\n    rfl\r\n  have hx : (ε : ℂ) • regularInverseGeneratorCutoff B ε x = characterMultiplier s (R z) := by\r\n    rw [hc,smul_smul,mul_inv_cancel₀ he,one_smul]\r\n  have hh := (regularPositiveGenerator B).graph.smul_mem (ε⁻¹ : ℂ) ht\r\n  change ((ε⁻¹ : ℂ) • characterMultiplier s (R z),\r\n    (ε⁻¹ : ℂ) • ((Real.exp s : ℂ) • characterMultiplier s (z-R z))) ∈ _ at hh\r\n  rw [hs,smul_smul,inv_mul_cancel₀ he,one_smul,map_sub,hi,← hc,← hx] at hh\r\n  exact hh\r\n\r\n/-- The regulator transforms together with the cutoff. Its sign follows\r\nfrom the already proved dual action on the generator. -/\r\ntheorem regularInverseGeneratorCutoff_dual (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε)\r\n    (s : ℝ) :\r\n    dualAmbient s (regularInverseGeneratorCutoff B ε) =\r\n      (Real.exp s : ℂ) • regularInverseGeneratorCutoff B (ε*Real.exp s) := by\r\n  unfold regularInverseGeneratorCutoff\r\n  rw [map_smul]\r\n  have ht : dualAmbient s (dualAmbient (Real.log ε) (regularSpectralResolvent B)) =\r\n      dualAmbient (Real.log ε+s) (regularSpectralResolvent B) := by\r\n    rw [dualAmbient_add]\r\n    rfl\r\n  rw [ht,Real.log_mul hε.ne' (Real.exp_ne_zero s),Real.log_exp,smul_smul]\r\n  have he : (Real.exp s : ℂ) * ((ε*Real.exp s)⁻¹ : ℂ) = (ε⁻¹ : ℂ) := by\r\n    push_cast\r\n    field_simp\r\n  rw [Complex.ofReal_mul,he]\r\n\r\n/-- Both inverse directions on the actual graph; uniqueness uses positivity,\r\nwithout a spectral gap for h itself. -/\r\ntheorem regularInverseGeneratorCutoff_graph_iff (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε)\r\n    (x y : RegularHilbert (H)) :\r\n    (x,y) ∈ (regularPositiveGenerator B).graph ↔\r\n      regularInverseGeneratorCutoff B ε (y+(ε : ℂ) • x) = x := by\r\n  constructor\r\n  · intro hxy\r\n    let u := regularInverseGeneratorCutoff B ε (y+(ε : ℂ) • x)\r\n    have hu := regularInverseGeneratorCutoff_graph B ε hε (y+(ε : ℂ) • x)\r\n    have hd : (u-x,-(ε : ℂ) • (u-x)) ∈ (regularPositiveGenerator B).graph := by\r\n      have hh := (regularPositiveGenerator B).graph.sub_mem hu hxy\r\n      change (u-x,(y+(ε : ℂ) • x-(ε : ℂ) • u)-y) ∈ _ at hh\r\n      have he : (y+(ε : ℂ) • x-(ε : ℂ) • u)-y = -(ε : ℂ) • (u-x) := by\r\n        rw [neg_smul,smul_sub]\r\n        abel\r\n      rwa [he] at hh\r\n    obtain ⟨v,hv,hh⟩ := (LinearPMap.mem_graph_iff (regularPositiveGenerator B)).mp hd\r\n    have hp := regularPositiveGenerator_positive B v\r\n    rw [hh,hv,inner_smul_right,Complex.mul_re,Complex.neg_re,Complex.ofReal_re,\r\n      Complex.neg_im,Complex.ofReal_im,neg_zero,zero_mul,sub_zero] at hp\r\n    change 0 ≤ -ε * RCLike.re (inner ℂ (u-x) (u-x)) at hp\r\n    rw [inner_self_eq_norm_sq] at hp\r\n    have hn : ‖u-x‖ = 0 := by\r\n      have hm : ε * ‖u-x‖^2 ≤ 0 := by linarith\r\n      have hsq : ‖u-x‖^2 ≤ 0 := by\r\n        by_contra h\r\n        have hpos := mul_pos hε (lt_of_not_ge h)\r\n        linarith\r\n      nlinarith [norm_nonneg (u-x)]\r\n    exact sub_eq_zero.mp (norm_eq_zero.mp hn)\r\n  · intro h\r\n    have hh := regularInverseGeneratorCutoff_graph B ε hε (y+(ε : ℂ) • x)\r\n    rw [h] at hh\r\n    simpa only [add_sub_cancel_right] using hh\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_mem\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_nonneg\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_le\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_one\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_graph\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_dual\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_graph_iff\r\n",
+    'TGLExt/F1Fecho394/GeneralRegularPositiveGraphR2.lean': 'import TGLExt.V351RegularPositiveGraph\r\nimport TGLExt.F1Fecho394.CoefficientBoostR1\r\n\r\n/-! Generalization of the existing v351 regular positive generator to the\r\nactual strongly continuous UnitaryFlow on H. The scalar multiplier, resolvent\r\ngraph and all their positivity results are reused. The positive generator is\r\nnot yet identified with the crossed-product implementer by this module. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\n/-- From the spectral L² coordinate to the original regular representation. -/\r\ndef regularSpectralCoordinates (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    RegularHilbert H ≃ₗᵢ[ℂ] RegularHilbert H :=\r\n  (Lp.fourierTransformₗᵢ ℝ H).symm.trans\r\n    (F1Fecho.CoefficientBoost.unitary B 1)\r\n\r\n/-- The candidate (1+h)^{-1}, with the spectral function already in mathlib. -/\r\ndef regularSpectralResolvent (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    RegularHilbert H →L[ℂ] RegularHilbert H :=\r\n  (regularSpectralCoordinates B).conjStarAlgEquiv\r\n    (realScalarMultiplier (fun x => Real.sigmoid (2*Real.pi*x)) (by fun_prop)\r\n      (fun x => Real.sigmoid_nonneg _) (fun x => Real.sigmoid_le_one _))\r\n\r\ntheorem regularSpectralResolvent_nonneg (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    0 ≤ regularSpectralResolvent B := by\r\n  exact map_nonneg (regularSpectralCoordinates B).conjStarAlgEquiv\r\n    (realScalarMultiplier_nonneg _ _ _ _)\r\n\r\ntheorem regularSpectralResolvent_le_one (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    regularSpectralResolvent B ≤ 1 := by\r\n  apply sub_nonneg.mp\r\n  have h := map_nonneg (regularSpectralCoordinates B).conjStarAlgEquiv\r\n    (sub_nonneg.mpr (realScalarMultiplier_le_one\r\n      (H := H) (fun x => Real.sigmoid (2*Real.pi*x)) (by fun_prop)\r\n      (fun x => Real.sigmoid_nonneg _) (fun x => Real.sigmoid_le_one _)))\r\n  simpa only [map_sub, map_one, regularSpectralResolvent] using h\r\n\r\ntheorem regularSpectralResolvent_injective (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    Function.Injective (regularSpectralResolvent B) :=\r\n  (regularSpectralCoordinates B).injective.comp\r\n    ((realScalarMultiplier_injective _ _ _ _ (fun _ => Real.sigmoid_pos _)).comp\r\n      (regularSpectralCoordinates B).symm.injective)\r\n\r\ntheorem regularSpectralResolvent_complement_injective (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    Function.Injective (1-regularSpectralResolvent B :\r\n      RegularHilbert H →L[ℂ] RegularHilbert H) := by\r\n  let g : ℝ → ℝ := fun x => Real.sigmoid (2*Real.pi*x)\r\n  have hg : Continuous g := by fun_prop\r\n  have h0 : ∀ x, 0 ≤ g x := fun x => Real.sigmoid_nonneg _\r\n  have h1 : ∀ x, g x ≤ 1 := fun x => Real.sigmoid_le_one _\r\n  change Function.Injective (1 - (regularSpectralCoordinates B).conjStarAlgEquiv\r\n    (realScalarMultiplier g hg h0 h1) : _ →L[ℂ] _)\r\n  rw [← map_one (regularSpectralCoordinates B).conjStarAlgEquiv,\r\n    ← map_sub, realScalarMultiplier_complement]\r\n  exact (regularSpectralCoordinates B).injective.comp\r\n    ((realScalarMultiplier_injective _ _ _ _\r\n      (fun x => sub_pos.mpr (Real.sigmoid_lt_one _))).comp\r\n      (regularSpectralCoordinates B).symm.injective)\r\n\r\n/-- A positive graph on the same regular Hilbert space. Its imaginary powers,\r\naffiliation and dual scaling are subsequent obligations, not fields assumed here. -/\r\ndef regularPositiveGenerator (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    RegularHilbert H →ₗ.[ℂ] RegularHilbert H :=\r\n  resolventGraphOperator (regularSpectralResolvent B) (regularSpectralResolvent_injective B)\r\n\r\ntheorem regularPositiveGenerator_closed (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    (regularPositiveGenerator B).IsClosed :=\r\n  resolvent_graph_closed _ _\r\n\r\ntheorem regularPositiveGenerator_domain_dense (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    Dense ((regularPositiveGenerator B).domain : Set (RegularHilbert H)) :=\r\n  resolvent_graph_domain_dense _ _ (IsSelfAdjoint.of_nonneg (regularSpectralResolvent_nonneg B))\r\n\r\ntheorem regularPositiveGenerator_selfadjoint (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) :\r\n    IsSelfAdjoint (regularPositiveGenerator B) :=\r\n  resolvent_graph_selfadjoint _ _ (IsSelfAdjoint.of_nonneg (regularSpectralResolvent_nonneg B))\r\n\r\ntheorem regularPositiveGenerator_positive (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (x : (regularPositiveGenerator B).domain) :\r\n    0 ≤ (inner ℂ (x : RegularHilbert H) (regularPositiveGenerator B x)).re :=\r\n  resolvent_graph_positive _ _ (regularSpectralResolvent_nonneg B)\r\n    (regularSpectralResolvent_le_one B) x\r\n\r\ntheorem regularPositiveGenerator_zero_kernel (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (x : (regularPositiveGenerator B).domain) (hx : regularPositiveGenerator B x = 0) :\r\n    (x : RegularHilbert H) = 0 := by\r\n  let R := regularSpectralResolvent B\r\n  let hi := regularSpectralResolvent_injective B\r\n  have h : (1-R) (Continuous049.boundedGraphParameter R hi x) = (1-R) 0 := by\r\n    change regularPositiveGenerator B x = (1-R) 0\r\n    rw [hx, map_zero]\r\n  have hz := regularSpectralResolvent_complement_injective B h\r\n  have he := Continuous049.bounded_graph_parameter_apply R hi x\r\n  rw [hz, map_zero] at he\r\n  exact he.symm\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralCoordinates\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_nonneg\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_le_one\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_injective\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_complement_injective\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_closed\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_domain_dense\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_selfadjoint\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_positive\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_zero_kernel\r\n',
+    'TGLExt/F1Fecho394/GeneralRegularSpectralGraphR2.lean': 'import TGLExt.F1Fecho394.GeneralRegularPositiveGraphR2\r\nimport TGLExt.V351RegularSpectralGraph\r\n/-! The exact graph of the generic regular positive generator is the same\r\nexponential multiplication graph in its actual Fourier/boost coordinate. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem regularSpectralResolvent_coordinate (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (x : RegularHilbert (H)) :\r\n    (regularSpectralCoordinates B).symm (regularSpectralResolvent B x) =\r\n      realScalarMultiplier (fun ξ => Real.sigmoid (2*Real.pi*ξ)) (by fun_prop)\r\n        (fun ξ => Real.sigmoid_nonneg _) (fun ξ => Real.sigmoid_le_one _)\r\n        ((regularSpectralCoordinates B).symm x) := by\r\n  simp only [regularSpectralResolvent,\r\n    LinearIsometryEquiv.conjStarAlgEquiv_apply_apply,\r\n    LinearIsometryEquiv.symm_apply_apply]\r\n\r\n/-- Exact graph identification on the existing regular Hilbert space. The\r\nexponential is unbounded; the condition uses L² representatives almost everywhere. -/\r\ntheorem regularPositiveGenerator_graph_iff (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (x y : RegularHilbert (H)) :\r\n    (x,y) ∈ (regularPositiveGenerator B).graph ↔\r\n      ∀ᵐ ξ ∂volume, ((regularSpectralCoordinates B).symm y) ξ =\r\n        (Real.exp (-(2*Real.pi*ξ)) : ℂ) •\r\n          ((regularSpectralCoordinates B).symm x) ξ := by\r\n  let V := regularSpectralCoordinates B\r\n  let R := regularSpectralResolvent B\r\n  let g : ℝ → ℝ := fun ξ => Real.sigmoid (2*Real.pi*ξ)\r\n  have hg : Continuous g := by fun_prop\r\n  have h0 : ∀ ξ, 0 ≤ g ξ := fun ξ => Real.sigmoid_nonneg _\r\n  have h1 : ∀ ξ, g ξ ≤ 1 := fun ξ => Real.sigmoid_le_one _\r\n  let M := realScalarMultiplier (H := H) g hg h0 h1\r\n  have hx : V.symm (R x) = M (V.symm x) := regularSpectralResolvent_coordinate B x\r\n  have hy : V.symm (R y) = M (V.symm y) := regularSpectralResolvent_coordinate B y\r\n  change (x,y) ∈ (resolventGraphOperator R (regularSpectralResolvent_injective B)).graph ↔ _\r\n  rw [resolvent_graph_equation]\r\n  constructor\r\n  · intro h\r\n    have hc := congrArg V.symm h\r\n    change V.symm (x-R x) = V.symm (R y) at hc\r\n    rw [map_sub, hx, hy] at hc\r\n    have he := Lp.ext_iff.mp hc\r\n    filter_upwards [he,\r\n      Lp.coeFn_sub (V.symm x) (M (V.symm x)),\r\n      realScalarMultiplier_ae g hg h0 h1 (V.symm x),\r\n      realScalarMultiplier_ae g hg h0 h1 (V.symm y)] with ξ he hs hmx hmy\r\n    have hp : ((1-g ξ : ℝ) : ℂ) • (V.symm x) ξ = (g ξ : ℂ) • (V.symm y) ξ := by\r\n      rw [hs, Pi.sub_apply, hmx, hmy] at he\r\n      simpa only [Pi.sub_apply, Complex.ofReal_sub, Complex.ofReal_one,\r\n        sub_smul, one_smul] using he\r\n    exact (sigmoid_resolvent_equation_iff (2*Real.pi*ξ) _ _).mp hp\r\n  · intro h\r\n    apply V.symm.injective\r\n    change V.symm (x-R x) = V.symm (R y)\r\n    rw [map_sub, hx, hy]\r\n    apply Lp.ext\r\n    filter_upwards [h,\r\n      Lp.coeFn_sub (V.symm x) (M (V.symm x)),\r\n      realScalarMultiplier_ae g hg h0 h1 (V.symm x),\r\n      realScalarMultiplier_ae g hg h0 h1 (V.symm y)] with ξ he hs hmx hmy\r\n    rw [hs, Pi.sub_apply, hmx, hmy]\r\n    have hp := (sigmoid_resolvent_equation_iff (2*Real.pi*ξ)\r\n      ((V.symm x) ξ) ((V.symm y) ξ)).mpr he\r\n    simpa only [Pi.sub_apply, Complex.ofReal_sub, Complex.ofReal_one,\r\n      sub_smul, one_smul] using hp\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_coordinate\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_graph_iff\r\n',
+    'TGLExt/F1Fecho394/GeneralRegulatorOrderR1.lean': 'import TGLExt.F1Fecho394.GeneralRegularCutoffCFCR1\r\n/-! Resolvent identities and order for the same regular generator. Reuse of proofs incorporated in v393, with no trace monotonicity inferred from sandwich order. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2400000\r\nset_option synthInstance.maxHeartbeats 200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nopen scoped Topology\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nprivate theorem hilbert_commuting_positive_product {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A B : H →L[ℂ] H) (hA : 0 ≤ A) (hB : 0 ≤ B) (hc : Commute A B) :\r\n    0 ≤ A*B := Commute.mul_nonneg hA hB hc\r\n\r\nprivate theorem hilbertPositiveSqrt_mul_star {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A : H →L[ℂ] H) (hA : 0 ≤ A) :\r\n    hilbertPositiveSqrt A * star (hilbertPositiveSqrt A) = A := by\r\n  change CFC.sqrt A * star (CFC.sqrt A) = A\r\n  rw [(CFC.sqrt_nonneg A).isSelfAdjoint.star_eq,CFC.sqrt_mul_sqrt_self A hA]\r\n\r\ntheorem regularInverseGeneratorCutoff_commutes (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (ε η : ℝ) (hε : 0 < ε) (hη : 0 < η) :\r\n    Commute (regularInverseGeneratorCutoff B ε) (regularInverseGeneratorCutoff B η) := by\r\n  rw [regularInverseGeneratorCutoff_cfc B ε hε,regularInverseGeneratorCutoff_cfc B η hη]\r\n  exact cfc_commute_cfc _ _ _\r\n\r\n/-- The inverse identity is obtained on the graph of the same unbounded h. -/\r\ntheorem regularInverseGeneratorCutoff_resolvent_identity (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (ε η : ℝ) (hε : 0 < ε) (hη : 0 < η) :\r\n    regularInverseGeneratorCutoff B ε - regularInverseGeneratorCutoff B η =\r\n      ((η-ε : ℝ) : ℂ) • (regularInverseGeneratorCutoff B η * regularInverseGeneratorCutoff B ε) := by\r\n  ext1 x\r\n  have hh := (regularInverseGeneratorCutoff_graph_iff B η hη\r\n    (regularInverseGeneratorCutoff B ε x)\r\n    (x-(ε : ℂ) • regularInverseGeneratorCutoff B ε x)).mp\r\n      (regularInverseGeneratorCutoff_graph B ε hε x)\r\n  rw [map_add,map_sub,map_smul,map_smul] at hh\r\n  change regularInverseGeneratorCutoff B ε x - regularInverseGeneratorCutoff B η x =\r\n    ((η-ε : ℝ) : ℂ) • (regularInverseGeneratorCutoff B η (regularInverseGeneratorCutoff B ε x))\r\n  rw [Complex.ofReal_sub,sub_smul]\r\n  have he := congrArg (fun v => v-regularInverseGeneratorCutoff B η x) hh\r\n  calc\r\n    _ = (regularInverseGeneratorCutoff B η x -\r\n        (ε : ℂ) • regularInverseGeneratorCutoff B η (regularInverseGeneratorCutoff B ε x) +\r\n        (η : ℂ) • regularInverseGeneratorCutoff B η (regularInverseGeneratorCutoff B ε x)) -\r\n          regularInverseGeneratorCutoff B η x := he.symm\r\n    _ = _ := by abel\r\n\r\n/-- Decreasing a positive regulator increases the actual inverse cutoff. -/\r\ntheorem regularInverseGeneratorCutoff_antitone (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (ε η : ℝ) (hε : 0 < ε) (hη : 0 < η) (hεη : ε ≤ η) :\r\n    regularInverseGeneratorCutoff B η ≤ regularInverseGeneratorCutoff B ε := by\r\n  apply sub_nonneg.mp\r\n  rw [regularInverseGeneratorCutoff_resolvent_identity B ε η hε hη]\r\n  have hp := hilbert_commuting_positive_product\r\n    (regularInverseGeneratorCutoff B η) (regularInverseGeneratorCutoff B ε)\r\n    (regularInverseGeneratorCutoff_nonneg B η hη) (regularInverseGeneratorCutoff_nonneg B ε hε)\r\n    (regularInverseGeneratorCutoff_commutes B η ε hη hε)\r\n  apply (ContinuousLinearMap.nonneg_iff_isPositive _).mpr\r\n  apply ((ContinuousLinearMap.nonneg_iff_isPositive _).mp hp).smul_of_nonneg\r\n  exact_mod_cast sub_nonneg.mpr hεη\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_commutes\r\n#print