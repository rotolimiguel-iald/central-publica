+    'TGLExt/F1Fecho394/GenericModularCutToolsR1.lean': "import TGLExt.F1Fecho394.GeneralDampedPhaseBalanceR1\r\nimport TGLExt.V351ModularCutBalance\r\n/-! Generic auxiliary steps from v393: CFC transport through a closed representation and cancellation of the two existing regular cuts. The phase balance and domain equations remain explicit inputs. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2400000\r\nnoncomputable section\r\nnamespace F1Fecho.ModularCutBalance\r\nopen TGLV350.Regular TGLExt\r\nopen scoped CStarAlgebra in\r\ntheorem closed_representation_cfc {H K : Type} [NormedAddCommGroup H]\r\n    [InnerProductSpace ℂ H] [CompleteSpace H] [NormedAddCommGroup K]\r\n    [InnerProductSpace ℂ K] [CompleteSpace K]\r\n    (N : StarSubalgebra ℂ (H →L[ℂ] H)) [IsClosed (N : Set (H →L[ℂ] H))]\r\n    (π : N →⋆ₐ[ℂ] (K →L[ℂ] K)) (a : N) (ha : IsSelfAdjoint a.val)\r\n    (f : ℂ → ℂ) (hf : Continuous f) :\r\n    ∃ hm : cfc f a.val ∈ N, π ⟨cfc f a.val,hm⟩ = cfc f (π a) ∧\r\n      ∀ T : K →L[ℂ] K, Commute T (π a) → Commute T (π ⟨cfc f a.val,hm⟩) := by\r\n  letI : CStarAlgebra N := StarSubalgebra.cstarAlgebra N\r\n  letI : IsometricContinuousFunctionalCalculus ℂ N IsStarNormal :=\r\n    IsStarNormal.instIsometricContinuousFunctionalCalculus\r\n  have haN : IsSelfAdjoint (a : N) := Subtype.ext ha.star_eq\r\n  have hc : cfc f a.val ∈ N := cfc_mem (𝕜' := ℂ) f a.property\r\n  have hsub := N.subtype.map_cfc f (a : N) hf.continuousOn\r\n    continuous_subtype_val haN.isStarNormal ha.isStarNormal\r\n  have hcont : Continuous π := map_continuous π\r\n  have he : cfc f (a : N) = (⟨cfc f a.val,hc⟩ : N) := Subtype.ext hsub\r\n  have hh := π.map_cfc f (a : N) hf.continuousOn hcont\r\n    haN.isStarNormal (haN.map π).isStarNormal\r\n  rw [he] at hh\r\n  refine ⟨hc,hh,?_⟩\r\n  intro T hT\r\n  have hi := complex_cfc_selfadjoint_intertwines (π a) (π a) T\r\n    (haN.map π) (haN.map π) hT.symm.eq f hf\r\n  rw [← hh] at hi\r\n  exact hi.symm\r\n\r\ntheorem cut_balance_after_multiplication {R : Type*} [Ring R]\r\n    (T A B C D p q : R)\r\n    (hbase : (1-T)*A*(1-B) = T*(1-A)*B)\r\n    (hTA : Commute T A) (hTB : Commute T B)\r\n    (hBC : Commute B C) (hBp : Commute B p)\r\n    (hAp : A*p = (1-A)*C) (hBq : B*q = (1-B)*D) :\r\n    (A*B)*((1-T)*C*q) = (A*B)*(T*p*D) := by\r\n  have hT : Commute T (A*B) := hTA.mul_right hTB\r\n  have h1 : Commute (1-T) (A*B) := (Commute.one_left (A*B)).sub_left hT\r\n  have hC : Commute C (1-B) := (Commute.one_right C).sub_right hBC.symm\r\n  calc\r\n    (A*B)*((1-T)*C*q) = (1-T)*((A*B)*(C*q)) := by\r\n      rw [mul_assoc (1-T) C q]\r\n      exact h1.symm.left_comm (C*q)\r\n    _ = (1-T)*(A*(C*(B*q))) := by\r\n      rw [mul_assoc A B (C*q), hBC.left_comm q]\r\n    _ = (1-T)*(A*(C*((1-B)*D))) := by rw [hBq]\r\n    _ = ((1-T)*A*(1-B))*(C*D) := by\r\n      rw [hC.left_comm D]\r\n      simp only [mul_assoc]\r\n    _ = (T*(1-A)*B)*(C*D) := by rw [hbase]\r\n    _ = T*((1-A)*(C*(B*D))) := by\r\n      simp only [mul_assoc]\r\n      rw [hBC.left_comm D]\r\n    _ = T*((A*p)*(B*D)) := by\r\n      rw [← mul_assoc (1-A) C (B*D), ← hAp]\r\n    _ = T*(A*(B*(p*D))) := by\r\n      rw [mul_assoc A p (B*D), hBp.symm.left_comm D]\r\n    _ = (A*B)*(T*p*D) := by\r\n      rw [← mul_assoc A B (p*D), mul_assoc T p D]\r\n      exact hT.left_comm (p*D)\r\n\r\n\r\nend F1Fecho.ModularCutBalance\r\n#print axioms F1Fecho.ModularCutBalance.closed_representation_cfc\r\n#print axioms F1Fecho.ModularCutBalance.cut_balance_after_multiplication\r\n",
+    'TGLExt/F1Fecho394/GenericPolarGraphTransportR1.lean': 'import TGLExt.F1Fecho394.CoefficientTomitaSquareR2\r\n\r\n/-! Generic graph elimination before substitution of the concrete Fock GNS.\r\nThe root graph equality is a premise here; the concrete caller proves it. -/\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.GenericPolarGraphTransport\r\nvariable {H E : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n  [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]\r\n\r\ntheorem root_to_polar_graph (T : H →ₗ.[ℂ] H)\r\n    (J : H ≃ₛₗᵢ[starRingEnd ℂ] H) (x y : H) (h : (x,y) ∈ T.graph) :\r\n    (x,J y) ∈ CoefficientTomitaSquare.graph T J := by\r\n  obtain ⟨w,hw,hy⟩ := (LinearPMap.mem_graph_iff T).mp h\r\n  exact ⟨w,Prod.ext hw (congrArg J hy)⟩\r\n\r\ntheorem mapped_domain_of_polar_graph (V : H ≃ₗᵢ[ℂ] E)\r\n    (T : H →ₗ.[ℂ] H) (U : E →ₗ.[ℂ] E)\r\n    (J : H ≃ₛₗᵢ[starRingEnd ℂ] H)\r\n    (hroot : ∀ x y, (V x,V y) ∈ U.graph ↔ (x,y) ∈ T.graph)\r\n    (x y : H) (h : (x,y) ∈ CoefficientTomitaSquare.graph T J) :\r\n    V x ∈ U.domain := by\r\n  obtain ⟨w,hw⟩ := h\r\n  have hx : (w:H)=x := congrArg Prod.fst hw\r\n  have hg := (hroot (w:H) (T w)).mpr\r\n    ((LinearPMap.mem_graph_iff T).mpr ⟨w,rfl,rfl⟩)\r\n  obtain ⟨z,hz,_⟩ := (LinearPMap.mem_graph_iff U).mp hg\r\n  exact Eq.mp (congrArg (fun a : E => a ∈ U.domain)\r\n    (hz.trans (congrArg V hx))) z.property\r\n\r\nend F1Fecho.GenericPolarGraphTransport\r\n#print axioms F1Fecho.GenericPolarGraphTransport.root_to_polar_graph\r\n#print axioms F1Fecho.GenericPolarGraphTransport.mapped_domain_of_polar_graph\r\n',
+    'TGLExt/F1Fecho394/GenericPolarModularBalanceR1.lean': 'import TGLExt.F1Fecho394.GeneralDampedPhaseBalanceR1\r\nimport TGLExt.V351ModularCutBalance\r\n/-! The analytic balance needed by the cut trace, with every modular premise\r\nexplicit. Its concrete consumer must supply the actual J, resolvent, left and\r\nright groups, and the full modular implementation; no trace is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.PolarModularBalance\r\nopen TGLV350.Regular\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem balance (T A : H →L[ℂ] H) (J : H ≃ₛₗᵢ[starRingEnd ℂ] H)\r\n    (hT0 : 0≤T) (hT1 : T≤1) (hiT : Function.Injective T)\r\n    (hjT : Function.Injective (1-T : H →L[ℂ] H))\r\n    (hA0 : 0≤A) (hA1 : A≤1) (hiA : Function.Injective A)\r\n    (hjA : Function.Injective (1-A : H →L[ℂ] H))\r\n    (L R : ℝ → H →L[ℂ] H)\r\n    (hTA : Commute T A)\r\n    (hflip : antiunitaryConjugate J T=1-T)\r\n    (hAB : Commute A (antiunitaryConjugate J A))\r\n    (hleft : ∀ t, L t * resolventDampingOperator A = resolventPhaseOperator A t)\r\n    (hJleft : ∀ t, antiunitaryConjugate J (L t)=R (-t))\r\n    (hRcomm : ∀ t, Commute (R t) A)\r\n    (hmod : ∀ t x, resolventImaginaryPower T hT0 hT1 hiT hjT t x=L t (R (-t) x)) :\r\n    let B := antiunitaryConjugate J A\r\n    Commute T B ∧ Function.Injective B ∧\r\n      (1-T)*A*(1-B)=T*(1-A)*B := by\r\n  let B := antiunitaryConjugate J A\r\n  change Commute T B ∧ Function.Injective B ∧ (1-T)*A*(1-B)=T*(1-A)*B\r\n  have hcomp : antiunitaryConjugate J (1-A)=1-B := by\r\n    change (antiunitaryConjugateRealHom J) (1-A)=1-B\r\n    simp only [map_sub,map_one]\r\n    rfl\r\n  have hB0 : 0≤B := antiunitaryConjugate_nonneg J A hA0\r\n  have hB1 : B≤1 := by\r\n    apply operator_le_of_sub_nonneg B 1\r\n    rw [← hcomp]\r\n    exact antiunitaryConjugate_nonneg J (1-A) (hilbertComplement_nonneg A hA1)\r\n  have hiB : Function.Injective B := J.injective.comp (hiA.comp J.symm.injective)\r\n  have hjB : Function.Injective (1-B : H →L[ℂ] H) := by\r\n    rw [← hcomp]\r\n    exact J.injective.comp (hjA.comp J.symm.injective)\r\n  have hTB : Commute T B := by\r\n    have hh := hTA.map (antiunitaryConjugateRealHom J)\r\n    change Commute (antiunitaryConjugate J T) B at hh\r\n    rw [hflip] at hh\r\n    simpa only [sub_sub_cancel] using (Commute.one_left B).sub_left hh\r\n  have hphase (t : ℝ) :\r\n      resolventPhaseOperator T t * resolventDampingOperator A * resolventDampingOperator B =\r\n      resolventDampingOperator T * resolventPhaseOperator A t * resolventPhaseOperator B (-t) := by\r\n    have hD : antiunitaryConjugate J (resolventDampingOperator A)=resolventDampingOperator B := by\r\n      change (antiunitaryConjugateRealHom J) (A*(1-A))=B*(1-B)\r\n      simp only [map_mul,map_sub,map_one]\r\n      rfl\r\n    have hF : antiunitaryConjugate J (resolventPhaseOperator A t)=resolventPhaseOperator B (-t) := by\r\n      unfold resolventPhaseOperator\r\n      rw [antiunitaryConjugate_complex_cfc J A (IsSelfAdjoint.of_nonneg hA0)\r\n        _ (resolventPhaseFunction_continuous t)]\r\n      simp only [resolventPhaseFunction_star]\r\n      rfl\r\n    have hR : R (-t)*resolventDampingOperator B=resolventPhaseOperator B (-t) := by\r\n      have he := congrArg (antiunitaryConjugate J) (hleft t)\r\n      rw [antiunitaryConjugate_mul,hJleft,hD,hF] at he\r\n      exact he\r\n    have hRd : Commute (R (-t)) (resolventDampingOperator A) :=\r\n      (hRcomm (-t)).mul_right ((Commute.one_right (R (-t))).sub_right (hRcomm (-t)))\r\n    ext1 x\r\n    change resolventPhaseOperator T t (resolventDampingOperator A (resolventDampingOperator B x)) =\r\n      resolventDampingOperator T (resolventPhaseOperator A t (resolventPhaseOperator B (-t) x))\r\n    rw [← resolventImaginaryPower_damping T hT0 hT1 hiT hjT t]\r\n    rw [resolventImaginaryPower_commutes_damping T hT0 hT1 hiT hjT t,hmod]\r\n    have hrd := congrArg (fun W : H →L[ℂ] H => W (resolventDampingOperator B x)) hRd.eq\r\n    change R (-t) (resolventDampingOperator A (resolventDampingOperator B x)) =\r\n      resolventDampingOperator A (R (-t) (resolventDampingOperator B x)) at hrd\r\n    rw [hrd]\r\n    have hrx := congrArg (fun W : H →L[ℂ] H => W x) hR\r\n    change R (-t) (resolventDampingOperator B x)=resolventPhaseOperator B (-t) x at hrx\r\n    rw [hrx]\r\n    have hlx := congrArg (fun W : H →L[ℂ] H => W (resolventPhaseOperator B (-t) x)) (hleft t)\r\n    change L t (resolventDampingOperator A (resolventPhaseOperator B (-t) x)) =\r\n      resolventPhaseOperator A t (resolventPhaseOperator B (-t) x) at hlx\r\n    rw [hlx]\r\n  refine ⟨hTB,hiB,?_⟩\r\n  exact F1Fecho.ModularCutBalance.damped_phase_operator_balance T A B\r\n    ⟨hT0,hT1⟩ ⟨hA0,hA1⟩ ⟨hB0,hB1⟩ hTA hTB hAB hiT hjT hiA hjA hiB hjB hphase\r\nend F1Fecho.PolarModularBalance\r\n#print axioms F1Fecho.PolarModularBalance.balance\r\n',
+    'TGLExt/F1Fecho394/GenericPolarRightAlgebraR2.lean': "import TGLExt.V350AntiunitaryPositiveConjugation\r\nimport Mathlib.Algebra.Star.Subalgebra\r\n/-! Algebraic closure of the polar-right identity, proved before specialization\r\nat the large Fock representation. No actual modular identity is an input here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.GenericPolarRightAlgebra\r\nopen TGLV350.Regular\r\nvariable {𝒜 : Type*} {H : Type} [Ring 𝒜] [Algebra ℂ 𝒜] [StarRing 𝒜] [StarModule ℂ 𝒜]\r\nvariable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (N : Submodule ℂ 𝒜) (Λ : N →ₗ[ℂ] H) (π : 𝒜 →⋆ₐ[ℂ] (H →L[ℂ] H))\r\nvariable (J : H ≃ₛₗᵢ[starRingEnd ℂ] H)\r\n/-- The actual polar right identity on the existing full weight domain. -/\r\ndef ScalarPolarRight  (b : 𝒜) : Prop :=\r\n  ∀ A : N, ∃ h : A.val*b ∈ N,\r\n    Λ ⟨A.val*b,h⟩ =\r\n      antiunitaryConjugate J\r\n        (π (star b)) (Λ A)\r\n\r\ntheorem scalarPolarRight_zero  : ScalarPolarRight N Λ π J 0 := by\r\n  intro A\r\n  have h : A.val*0 ∈ N := by simp\r\n  refine ⟨h,?_⟩\r\n  have he : (⟨A.val*0,h⟩ : N) = 0 := Subtype.ext (mul_zero _)\r\n  rw [he,map_zero,antiunitaryConjugate_apply,star_zero,map_zero]\r\n  simp only [zero_apply,map_zero]\r\n\r\ntheorem scalarPolarRight_one  : ScalarPolarRight N Λ π J 1 := by\r\n  intro A\r\n  have h : A.val*1 ∈ N := by simpa only [mul_one] using A.property\r\n  refine ⟨h,?_⟩\r\n  have he : (⟨A.val*1,h⟩ : N) = A := Subtype.ext (mul_one _)\r\n  rw [he,antiunitaryConjugate_apply,star_one,map_one]\r\n  simp only [one_apply_eq_self,LinearIsometryEquiv.apply_symm_apply]\r\n\r\ntheorem scalarPolarRight_add \r\n    (b c : 𝒜)\r\n    (hb : ScalarPolarRight N Λ π J b) (hc : ScalarPolarRight N Λ π J c) : ScalarPolarRight N Λ π J (b+c) := by\r\n  intro A\r\n  obtain ⟨hAb,heb⟩ := hb A\r\n  obtain ⟨hAc,hec⟩ := hc A\r\n  have h : A.val*(b+c) ∈ N := by\r\n    simpa only [mul_add] using (N).add_mem hAb hAc\r\n  refine ⟨h,?_⟩\r\n  have he : (⟨A.val*(b+c),h⟩ : N) =\r\n      (⟨A.val*b,hAb⟩ : N) + ⟨A.val*c,hAc⟩ :=\r\n    Subtype.ext (mul_add _ _ _)\r\n  rw [he,map_add,heb,hec]\r\n  simp only [antiunitaryConjugate_apply,star_add,map_add,add_apply]\r\n\r\ntheorem scalarPolarRight_smul \r\n    (b : 𝒜) (hb : ScalarPolarRight N Λ π J b) (c : ℂ) :\r\n    ScalarPolarRight N Λ π J (c • b) := by\r\n  intro A\r\n  obtain ⟨hAb,heb⟩ := hb A\r\n  have h : A.val*(c • b) ∈ N := by\r\n    simpa only [mul_smul_comm] using (N).smul_mem c hAb\r\n  refine ⟨h,?_⟩\r\n  have he : (⟨A.val*(c • b),h⟩ : N) =\r\n      c • (⟨A.val*b,hAb⟩ : N) := Subtype.ext (mul_smul_comm _ _ _)\r\n  rw [he,map_smul,heb]\r\n  simp only [antiunitaryConjugate_apply,star_smul,map_smul,\r\n    smul_apply,LinearIsometryEquiv.map_smulₛₗ,starRingEnd_apply,star_star]\r\n\r\ntheorem scalarPolarRight_mul \r\n    (b c : 𝒜)\r\n    (hb : ScalarPolarRight N Λ π J b) (hc : ScalarPolarRight N Λ π J c) : ScalarPolarRight N Λ π J (b*c) := by\r\n  intro A\r\n  obtain ⟨hAb,heb⟩ := hb A\r\n  obtain ⟨hAbc,hec⟩ := hc ⟨A.val*b,hAb⟩\r\n  have h : A.val*(b*c) ∈ N := by\r\n    simpa only [mul_assoc] using hAbc\r\n  refine ⟨h,?_⟩\r\n  have he : (⟨A.val*(b*c),h⟩ : N) =\r\n      ⟨(A.val*b)*c,hAbc⟩ := Subtype.ext (mul_assoc _ _ _).symm\r\n  rw [he,hec,heb]\r\n  simp only [antiunitaryConjugate_apply,star_mul,map_mul,mul_apply_eq_comp,\r\n    LinearIsometryEquiv.symm_apply_apply]\r\n\r\n/-- The two-sided star condition is explicit; it is not silently inferred\r\nfrom a right-boundedness condition on b alone. -/\r\ndef scalarPolarRightAlgebra  :\r\n    StarSubalgebra ℂ 𝒜 where\r\n  carrier := {b | ScalarPolarRight N Λ π J b ∧ ScalarPolarRight N Λ π J (star b)}\r\n  zero_mem' := by simpa only [Set.mem_setOf_eq,star_zero] using And.intro (scalarPolarRight_zero N Λ π J) (scalarPolarRight_zero N Λ π J)\r\n  one_mem' := by simpa only [Set.mem_setOf_eq,star_one] using And.intro (scalarPolarRight_one N Λ π J) (scalarPolarRight_one N Λ π J)\r\n  add_mem' := by\r\n    intro b c hb hc\r\n    exact ⟨scalarPolarRight_add N Λ π J b c hb.1 hc.1,\r\n      by simpa only [star_add] using scalarPolarRight_add N Λ π J (star b) (star c) hb.2 hc.2⟩\r\n  mul_mem' := by\r\n    intro b c hb hc\r\n    exact ⟨scalarPolarRight_mul N Λ π J b c hb.1 hc.1,\r\n      by simpa only [star_mul] using scalarPolarRight_mul N Λ π J (star c) (star b) hc.2 hb.2⟩\r\n  algebraMap_mem' c := by\r\n    have h := scalarPolarRight_smul N Λ π J 1 (scalarPolarRight_one N Λ π J) c\r\n    have hs := scalarPolarRight_smul N Λ π J 1 (scalarPolarRight_one N Λ π J) (star c)\r\n    simpa only [Set.mem_setOf_eq,Algebra.algebraMap_eq_smul_one,star_smul,star_one] using And.intro h hs\r\n  star_mem' := by\r\n    intro b hb\r\n    exact ⟨hb.2,by simpa only [star_star] using hb.1⟩\r\n\r\n\r\nend F1Fecho.GenericPolarRightAlgebra\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.ScalarPolarRight\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRight_zero\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRight_one\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRight_add\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRight_smul\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRight_mul\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.scalarPolarRightAlgebra\r\n",
+    'TGLExt/F1Fecho394/GenericPolarRightCommutationR2.lean': 'import TGLExt.F1Fecho394.GenericPolarRightNormR1\r\n/-! A proved right action commutes with the left representation on the same\r\nGNS completion. Dense range and left multiplication are explicit obligations. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 700000\r\nnoncomputable section\r\nnamespace F1Fecho.GenericPolarRightAlgebra\r\nopen TGLV350.Regular\r\nvariable {𝒜 : Type*} {H : Type} [Ring 𝒜] [Algebra ℂ 𝒜] [StarRing 𝒜] [StarModule ℂ 𝒜]\r\nvariable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (N : Submodule ℂ 𝒜) (Λ : N →ₗ[ℂ] H) (π : 𝒜 →⋆ₐ[ℂ] (H →L[ℂ] H))\r\nvariable (J : H ≃ₛₗᵢ[starRingEnd ℂ] H)\r\n theorem commutes_left_of_right_identity\r\n    (hdense : DenseRange Λ)\r\n    (hleft : ∀ c : 𝒜, ∀ a : N, ∃ hc : c*a.val∈N,\r\n      Λ ⟨c*a.val,hc⟩=π c (Λ a))\r\n    (b : 𝒜) (hb : ScalarPolarRight N Λ π J b) (c : 𝒜) :\r\n    Commute (antiunitaryConjugate J (π (star b))) (π c) := by\r\n  let R := antiunitaryConjugate J (π (star b))\r\n  have hR (a : N) : Λ (rightProduct N Λ π J b hb a)=R (Λ a) :=\r\n    rightProduct_embedding N Λ π J b hb a\r\n  have hcore (a : N) : R (π c (Λ a))=π c (R (Λ a)) := by\r\n    obtain ⟨hca,hcae⟩:=hleft c a\r\n    let ca : N:=⟨c*a.val,hca⟩\r\n    let ab:=rightProduct N Λ π J b hb a\r\n    obtain ⟨hcab,hcabe⟩:=hleft c ab\r\n    have he : rightProduct N Λ π J b hb ca=⟨c*ab.val,hcab⟩ :=\r\n      Subtype.ext (mul_assoc c a.val b)\r\n    calc\r\n      R (π c (Λ a))=R (Λ ca) :=congrArg R hcae.symm\r\n      _=Λ (rightProduct N Λ π J b hb ca) :=(hR ca).symm\r\n      _=Λ ⟨c*ab.val,hcab⟩ :=congrArg Λ he\r\n      _=π c (Λ ab) :=hcabe\r\n      _=π c (R (Λ a)) :=congrArg (π c) (hR a)\r\n  ext1 x\r\n  exact hdense.induction_on x\r\n    (isClosed_eq (R.continuous.comp (π c).continuous)\r\n      ((π c).continuous.comp R.continuous)) hcore\r\nend F1Fecho.GenericPolarRightAlgebra\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.commutes_left_of_right_identity\r\n',
+    'TGLExt/F1Fecho394/GenericPolarRightNormR1.lean': 'import TGLExt.F1Fecho394.GenericPolarRightAlgebraR2\r\n/-! Norm and order consequences of a proved polar-right identity.\r\nThe order compares pi(b)pi(b)* and pi(c)pi(c)*, never the opposite product. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 600000\r\nnoncomputable section\r\nnamespace F1Fecho.GenericPolarRightAlgebra\r\nopen TGLV350.Regular\r\nvariable {𝒜 : Type*} {H : Type} [Ring 𝒜] [Algebra ℂ 𝒜] [StarRing 𝒜] [StarModule ℂ 𝒜]\r\nvariable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (N : Submodule ℂ 𝒜) (Λ : N →ₗ[ℂ] H) (π : 𝒜 →⋆ₐ[ℂ] (H →L[ℂ] H))\r\nvariable (J : H ≃ₛₗᵢ[starRingEnd ℂ] H)\r\ndef rightProduct (b : 𝒜) (hb : ScalarPolarRight N Λ π J b) (a : N) : N :=\r\n  ⟨a.val*b,(hb a).choose⟩\r\ntheorem rightProduct_embedding (b : 𝒜) (hb : ScalarPolarRight N Λ π J b) (a : N) :\r\n    Λ (rightProduct N Λ π J b hb a) = J (π (star b) (J.symm (Λ a))) :=\r\n  (hb a).choose_spec\r\ntheorem rightProduct_norm (b : 𝒜) (hb : ScalarPolarRight N Λ π J b) (a : N) :\r\n    ‖Λ (rightProduct N Λ π J b hb a)‖ = ‖π (star b) (J.symm (Λ a))‖ := by\r\n  rw [rightProduct_embedding,J.norm_map]\r\nprivate theorem star_apply_norm_sq_mono (B C : H →L[ℂ] H)\r\n    (hbc : B*star B ≤ C*star C) (v : H) : ‖star B v‖^2 ≤ ‖star C v‖^2 := by\r\n  have hp := (ContinuousLinearMap.nonneg_iff_isPositive _).mp (sub_nonneg.mpr hbc)\r\n  have hv := hp.re_inner_nonneg_left v\r\n  have hn (D : H →L[ℂ] H) : ‖star D v‖^2 = (inner ℂ ((D*star D) v) v).re := by\r\n    have he := ContinuousLinearMap.apply_norm_sq_eq_inner_adjoint_left (𝕜 := ℂ) (star D) v\r\n    simpa only [RCLike.re_eq_complex_re,ContinuousLinearMap.star_eq_adjoint,\r\n      ContinuousLinearMap.adjoint_adjoint,ContinuousLinearMap.mul_def] using he\r\n  rw [hn B,hn C]\r\n  simpa only [RCLike.re_eq_complex_re,ContinuousLinearMap.sub_apply,inner_sub_left,\r\n    Complex.sub_re,sub_nonneg] using hv\r\ntheorem rightProduct_squared_norm_mono (b c : 𝒜)\r\n    (hb : ScalarPolarRight N Λ π J b) (hc : ScalarPolarRight N Λ π J c)\r\n    (hbc : π b*star (π b) ≤ π c*star (π c)) (a : N) :\r\n    ‖Λ (rightProduct N Λ π J b hb a)‖^2 ≤ ‖Λ (rightProduct N Λ π J c hc a)‖^2 := by\r\n  rw [rightProduct_norm,rightProduct_norm]\r\n  simpa only [map_star] using star_apply_norm_sq_mono (π b) (π c) hbc (J.symm (Λ a))\r\nend F1Fecho.GenericPolarRightAlgebra\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.rightProduct\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.rightProduct_embedding\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.rightProduct_norm\r\n#print axioms F1Fecho.GenericPolarRightAlgebra.rightProduct_squared_norm_mono\r\n',
+    'TGLExt/F1Fecho394/GenericQuadraticTraceFormsR1.lean': 'import TGLExt.V351QuadraticTrace\r\n/-! Generic form lemmas reused verbatim from proofs incorporated in v393, with a sandbox namespace. They are not a new trace and assume the displayed balance and commutations. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2400000\r\nnoncomputable section\r\nnamespace F1Fecho.QuadraticTraceForms\r\nopen TGLV350.Regular TGLExt Filter\r\nopen scoped Topology ComplexOrder\r\ntheorem root_quadratic_commutation {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (R A : H →L[ℂ] H) (hR : 0 ≤ R) (hc : Commute R A) (u : H) :\r\n    inner ℂ (CFC.sqrt R u) (A (CFC.sqrt R u)) = inner ℂ u ((R*A) u) := by\r\n  have hs := (ContinuousLinearMap.nonneg_iff_isPositive _).mp (CFC.sqrt_nonneg R)\r\n  rw [hs.inner_left_eq_inner_right]\r\n  have he : CFC.sqrt R * A * CFC.sqrt R = R*A := by\r\n    rw [positive_sqrt_intertwines R R A hR hR hc.eq, mul_assoc,\r\n      CFC.sqrt_mul_sqrt_self R hR, hc.eq]\r\n  exact congrArg (fun B : H →L[ℂ] H => inner ℂ u (B u)) he\r\n\r\ntheorem bounded_root_form_balance {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (T U V : H →L[ℂ] H) (hT : 0 ≤ T) (h1 : T ≤ 1)\r\n    (hi : Function.Injective T)\r\n    (hU : Commute T U) (hV : Commute T V)\r\n    (hb : (1-T)*U = T*V) (x : (resolventSquareRoot T hT hi).domain) :\r\n    inner ℂ (resolventSquareRoot T hT hi x) (U (resolventSquareRoot T hT hi x)) =\r\n      inner ℂ (x : H) (V x) := by\r\n  let u := ChatgptAudit.Continuous049.boundedGraphParameter (CFC.sqrt T)\r\n    (positive_sqrt_injective T hT hi) x\r\n  have hx : CFC.sqrt T u = (x : H) :=\r\n    ChatgptAudit.Continuous049.bounded_graph_parameter_apply (CFC.sqrt T)\r\n      (positive_sqrt_injective T hT hi) x\r\n  have hy : CFC.sqrt (1-T) u = resolventSquareRoot T hT hi x :=\r\n    (ChatgptAudit.Continuous049.bounded_graph_apply (CFC.sqrt T) (CFC.sqrt (1-T))\r\n      (positive_sqrt_injective T hT hi) x).symm\r\n  have he : inner ℂ (CFC.sqrt (1-T) u) (U (CFC.sqrt (1-T) u)) =\r\n      inner ℂ (CFC.sqrt T u) (V (CFC.sqrt T u)) := by\r\n    rw [root_quadratic_commutation (1-T) U (sub_nonneg.mpr h1)\r\n      ((Commute.one_left U).sub_left hU),\r\n      root_quadratic_commutation T V hT hV,hb]\r\n  rw [hx,hy] at he\r\n  exact he\r\n\r\n/-- Remove one bounded contraction at a time. The suprema remain in ENNReal;\r\nneither side is assumed finite and no unbounded product is formed. -/\r\ntheorem double_cut_form_supremum {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (C D p q : ℕ → H →L[ℂ] H) (x y : H)\r\n    (hC : ∀ n, 0 ≤ C n) (hD : ∀ n, 0 ≤ D n)\r\n    (hp : ∀ n, 0 ≤ p n ∧ p n ≤ 1) (hq : ∀ n, 0 ≤ q n ∧ q n ≤ 1)\r\n    (hCq : ∀ n m, Commute (C n) (q m))\r\n    (hpD : ∀ n m, Commute (p n) (D m))\r\n    (htp : ∀ v, Tendsto (fun n => p n v) atTop (𝓝 v))\r\n    (htq : ∀ v, Tendsto (fun n => q n v) atTop (𝓝 v))\r\n    (hbalance : ∀ n m, (inner ℂ y ((C n * q m) y)).re =\r\n      (inner ℂ x ((p n * D m) x)).re) :\r\n    (⨆ n, ENNReal.ofReal (inner ℂ y (C n y)).re) =\r\n      ⨆ m, ENNReal.ofReal (inner ℂ x (D m x)).re := by\r\n  have hCQ (n m : ℕ) : C n * q m ≤ C n := by\r\n    apply sub_nonneg.mp\r\n    simpa only [mul_sub,mul_one] using\r\n      Commute.mul_nonneg (hC n) (sub_nonneg.mpr (hq m).2)\r\n        ((Commute.one_right (C n)).sub_right (hCq n m))\r\n  have hpDle (n m : ℕ) : p n * D m ≤ D m := by\r\n    apply sub_nonneg.mp\r\n    simpa only [sub_mul,one_mul] using\r\n      Commute.mul_nonneg (sub_nonneg.mpr (hp n).2) (hD m)\r\n        ((Commute.one_left (D m)).sub_left (hpD n m))\r\n  apply le_antisymm\r\n  · apply iSup_le\r\n    intro n\r\n    have ht : Tendsto (fun m => ENNReal.ofReal (inner ℂ y ((C n*q m) y)).re)\r\n        atTop (𝓝 (ENNReal.ofReal (inner ℂ y (C n y)).re)) :=\r\n      ENNReal.continuous_ofReal.continuousAt.tendsto.comp\r\n        (Complex.continuous_re.continuousAt.tendsto.comp\r\n          (tendsto_const_nhds.inner ((C n).continuous.continuousAt.tendsto.comp (htq y))))\r\n    apply le_of_tendsto ht\r\n    apply Eventually.of_forall\r\n    intro m\r\n    rw [hbalance n m]\r\n    exact (ENNReal.ofReal_le_ofReal (quadratic_le_of_operator_le _ _ (hpDle n m) x)).trans\r\n      (le_iSup (fun j => ENNReal.ofReal (inner ℂ x (D j x)).re) m)\r\n  · apply iSup_le\r\n    intro m\r\n    have ht : Tendsto (fun n => ENNReal.ofReal (inner ℂ x ((p n*D m) x)).re)\r\n        atTop (𝓝 (ENNReal.ofReal (inner ℂ x (D m x)).re)) :=\r\n      ENNReal.continuous_ofReal.continuousAt.tendsto.comp\r\n        (Complex.continuous_re.continuousAt.tendsto.comp\r\n          (tendsto_const_nhds.inner (htp (D m x))))\r\n    apply le_of_tendsto ht\r\n    apply Eventually.of_forall\r\n    intro n\r\n    rw [← hbalance n m]\r\n    exact (ENNReal.ofReal_le_ofReal (quadratic_le_of_operator_le _ _ (hCQ n m) y)).trans\r\n      (le_iSup (fun j => ENNReal.ofReal (inner ℂ y (C j y)).re) n)\r\n\r\ntheorem represented_positive_root_norm {H K : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]\r\n    (N : StarSubalgebra ℂ (H →L[ℂ] H))\r\n    (π : N →⋆ₐ[ℂ] (K →L[ℂ] K)) (a : N) (ha : 0 ≤ a.val)\r\n    (hm : hilbertPositiveSqrt a.val ∈ N) (v : K) :\r\n    ‖π (star (⟨hilbertPositiveSqrt a.val,hm⟩ : N)) v‖^2 =\r\n      (inner ℂ v (π a v)).re := by\r\n  let b : N := ⟨hilbertPositiveSqrt a.val,hm⟩\r\n  have hs : star b = b := Subtype.ext (CFC.sqrt_nonneg a.val).isSelfAdjoint.star_eq\r\n  have hbb : b * star b = a := by\r\n    rw [hs]\r\n    exact Subtype.ext (CFC.sqrt_mul_sqrt_self a.val ha)\r\n  have he := ContinuousLinearMap.apply_norm_sq_eq_inner_adjoint_left\r\n    (𝕜 := ℂ) (star (π b)) v\r\n  have hn : ‖star (π b) v‖^2 = (inner ℂ ((π b*star (π b)) v) v).re := by\r\n    simpa only [RCLike.re_eq_complex_re,ContinuousLinearMap.star_eq_adjoint,\r\n      ContinuousLinearMap.adjoint_adjoint,C