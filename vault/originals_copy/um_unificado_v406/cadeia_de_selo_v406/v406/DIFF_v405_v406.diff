x.cons_val_succ'] at h1 h2 hz\r\n  change (x 0-(y 0+ε/2))^2≤(x 3-y 3)^2+(x 2-y 2)^2+(x 1-y 1)^2 at h1\r\n  change (x 0-(y 0+(-(ε/2))))^2≤(x 3-y 3)^2+(x 2-y 2)^2+(x 1-y 1)^2 at h2\r\n  nlinarith [sq_pos_of_pos (show 0<ε/2 by positivity)]\r\n\r\nend F1Fecho.SpacelikeGeometry\r\n#print axioms F1Fecho.SpacelikeGeometry.weak_spacelike_closure_left\r\n#print axioms F1Fecho.SpacelikeGeometry.spacelike_closure_left_of_open\r\n",
+    'TGLExt/F1Fecho394/SpacelikePairNeighborhoodR2.lean': "import TGLExt.F1Fecho394.SpacelikePairWedgesR2\r\n\r\n/-! Open neighborhoods, not only points, fit into the opposite wedges supplied\r\nby the spacelike-pair construction. This is the local geometric input for\r\npartitioning compact physical test supports. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.SpacelikeGeometry\r\nopen TGL.SpecificAQFT F1Fecho.OrbitalSpatial F1Fecho.OrbitalScreen ChatgptAudit.WignerOrbit016\r\n\r\ndef frameMap (L : generatedLorentz) (m : V) (z : V) : V := lorentzLinear L.val (z-m)\r\n\r\ndef frameRightRegion (L : generatedLorentz) (m : V) : Set V :=\r\n  frameMap L m ⁻¹' rightWedge\r\n\r\ndef frameLeftRegion (L : generatedLorentz) (m : V) : Set V :=\r\n  frameMap L m ⁻¹' leftWedge\r\n\r\ntheorem frameMap_continuous (L : generatedLorentz) (m : V) : Continuous (frameMap L m) :=\r\n  (lorentzLinear L.val).continuous_of_finiteDimensional.comp (continuous_id.sub continuous_const)\r\n\r\ntheorem frameRightRegion_open (L : generatedLorentz) (m : V) : IsOpen (frameRightRegion L m) :=\r\n  (isOpen_lt (continuous_apply 0).abs (continuous_apply 1)).preimage (frameMap_continuous L m)\r\n\r\ntheorem frameLeftRegion_open (L : generatedLorentz) (m : V) : IsOpen (frameLeftRegion L m) :=\r\n  (isOpen_lt (continuous_apply 0).abs (continuous_apply 1).neg).preimage (frameMap_continuous L m)\r\n\r\ntheorem spacelike_pair_opposite_neighborhoods (x y : V) (hxy : minkowskiSq (x-y)<0) :\r\n    ∃ L : generatedLorentz, ∃ m : V, ∃ r s : ℝ,\r\n      0<r ∧ 0<s ∧ Metric.ball x r ⊆ frameRightRegion L m ∧\r\n        Metric.ball y s ⊆ frameLeftRegion L m := by\r\n  obtain ⟨L,m,hx,hy⟩ := spacelike_pair_opposite_wedges x y hxy\r\n  obtain ⟨r,hr,hxr⟩ := Metric.isOpen_iff.mp (frameRightRegion_open L m) x hx\r\n  obtain ⟨s,hs,hys⟩ := Metric.isOpen_iff.mp (frameLeftRegion_open L m) y hy\r\n  exact ⟨L,m,r,s,hr,hs,hxr,hys⟩\r\n\r\nend F1Fecho.SpacelikeGeometry\r\n#print axioms F1Fecho.SpacelikeGeometry.frameRightRegion_open\r\n#print axioms F1Fecho.SpacelikeGeometry.frameLeftRegion_open\r\n#print axioms F1Fecho.SpacelikeGeometry.spacelike_pair_opposite_neighborhoods\r\n",
+    'TGLExt/F1Fecho394/SpacelikePairWedgesR2.lean': 'import TGLExt.F1Fecho394.SpacelikeAxisRotationR2\r\nimport TGLExt.F1Fecho394.ScreenLorentzTransportR7\r\nimport TGLExt.F1Fecho394.SpacetimeLorentzFourierR3\r\n\r\n/-! Pointwise spacelike separation admits a common spatial change of frame\r\nand a midpoint translation into opposite wedges. Arbitrary sets are not\r\nclaimed to fit in a single pair of wedges. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.SpacelikeGeometry\r\nopen TGL.SpecificAQFT F1Fecho.OrbitalSpatial F1Fecho.OrbitalScreen\r\nopen ChatgptAudit.WignerOrbit016\r\n\r\ndef leftWedge : Set V := {z | |z 0| < -z 1}\r\n\r\ntheorem half_rightWedge (z:V) (hz:z∈rightWedge) : (1/2:ℝ) • z∈rightWedge := by\r\n  change |(1/2:ℝ)*z 0|<(1/2:ℝ)*z 1\r\n  rw [abs_mul]\r\n  norm_num only [abs_of_nonneg (by norm_num : (0:ℝ) ≤ 1/2)]\r\n  change |z 0| < z 1 at hz\r\n  exact mul_lt_mul_of_pos_left hz (by norm_num)\r\n\r\ntheorem neg_rightWedge (z:V) (hz:z∈rightWedge) : -z∈leftWedge := by\r\n  simpa [leftWedge,rightWedge,Pi.neg_apply] using hz\r\n\r\ntheorem spacelike_pair_opposite_wedges (x y:V) (hxy:minkowskiSq (x-y)<0) :\r\n    ∃L:generatedLorentz,∃m:V,\r\n      lorentzLinear L.val (x-m)∈rightWedge ∧\r\n      lorentzLinear L.val (y-m)∈leftWedge := by\r\n  obtain ⟨Q,hQ⟩:=spacelike_rotates_into_rightWedge (x-y) hxy\r\n  let L:=generatedSpatial (Unitary.linearIsometryEquiv.symm Q)\r\n  have hL (z:V):lorentzLinear L.val z=spatialSpacetime Q z := by\r\n    change (spatialMatrix (Unitary.linearIsometryEquiv\r\n      (Unitary.linearIsometryEquiv.symm Q))).mulVec z=_\r\n    rw [Unitary.linearIsometryEquiv.apply_symm_apply,spatialMatrix_mulVec]\r\n  let m:V:=(1/2:ℝ) • (x+y)\r\n  have hx:x-m=(1/2:ℝ) • (x-y) := by ext i; simp [m]; ring\r\n  have hy:y-m=-((1/2:ℝ) • (x-y)) := by ext i; simp [m]; ring\r\n  refine ⟨L,m,?_,?_⟩\r\n  · rw [hx,map_smul,hL]\r\n    exact half_rightWedge _ hQ\r\n  · rw [hy,map_neg,map_smul