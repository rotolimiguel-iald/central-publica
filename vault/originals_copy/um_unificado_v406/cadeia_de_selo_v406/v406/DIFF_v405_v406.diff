rem inverseSupremum_preserves_internal_isLUB\r\n    (N:VonNeumannAlgebra (RegularHilbert H))\r\n    (A:ι→N.toStarSubalgebra) (S:N.toStarSubalgebra)\r\n    (hpos:∀i,0≤A i) (hmono:Monotone A) (hS:IsLUB (Set.range A) S) :\r\n    inverseSupremum B zeta S.val=⨆i,inverseSupremum B zeta (A i).val :=\r\n  inverseSupremum_preserves_positive_isLUB B zeta\r\n    (fun i=>(A i).val) S.val hpos hmono (vonNeumann_isLUB_coe N A S hpos hmono hS)\r\n\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_preserves_positive_isLUB\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_preserves_internal_isLUB\r\n",
+    'TGLExt/F1Fecho394/GeneralInverseCutoffWeightR3.lean': 'import TGLExt.F1Fecho394.GeneralRegularInverseCutoffR1\r\nimport TGLExt.V350AntiunitaryPositiveConjugation\r\nimport TGLExt.V350DualQuadraticLaws\r\nimport TGLExt.V350DualFormNormality\r\n/-! Actual inverse-generator perturbations of the dual integral, on any\r\nregular representation. Laws are asserted on the positive cone; this module\r\nconstructs no trace, no total cyclic extension, and no monotone supremum. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1500000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular MeasureTheory Filter\r\nopen scoped Topology ENNReal NNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:RegularCovariantCore.UnitaryFlow H)\r\nabbrev cutoff (epsilon:ℝ) := RegularPositiveFlow.regularInverseGeneratorCutoff B epsilon\r\n\r\ndef cutoffWeight (zeta:RegularHilbert H) (epsilon:ℝ)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) : ℝ≥0∞ :=\r\n  dualQuadraticIntegral (star (hilbertPositiveSqrt (cutoff B epsilon))*X*\r\n    hilbertPositiveSqrt (cutoff B epsilon)) zeta\r\n\r\ntheorem cutoffWeight_zero (zeta:RegularHilbert H) (epsilon:ℝ) :\r\n    cutoffWeight B zeta epsilon 0=0 := by\r\n  simp only [cutoffWeight,mul_zero,zero_mul,dualQuadraticIntegral_zero]\r\n\r\ntheorem cutoffWeight_add (zeta:RegularHilbert H) (epsilon:ℝ)\r\n    (X Y:RegularHilbert H→L[ℂ]RegularHilbert H) (hX:0≤X) (hY:0≤Y) :\r\n    cutoffWeight B zeta epsilon (X+Y)=cutoffWeight B zeta epsilon X+cutoffWeight B zeta epsilon Y := by\r\n  simp only [cutoffWeight,mul_add,add_mul]\r\n  exact dualQuadraticIntegral_add _ _ (star_left_conjugate_nonneg hX _)\r\n    (star_left_conjugate_nonneg hY _) zeta\r\n\r\ntheorem cutoffWeight_scale (zeta:RegularHilbert H) (epsilon:ℝ) (r:ℝ≥0)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    cutoffWeight B zeta epsilon ((r:ℝ) • X)=(r:ℝ≥0∞)*cutoffWeight B zeta epsilon X := by\r\n  simp only [cutoffWeight,mul_smul_comm,smul_mul_assoc]\r\n  simpa only [ENNReal.ofReal_coe_nnreal] using\r\n    dualQuadraticIntegral_smul_operator (r:ℝ) r.property _ zeta\r\n\r\ntheorem cutoffWeight_mono (zeta:RegularHilbert H) (epsilon:ℝ)\r\n    (X Y:RegularHilbert H→L[ℂ]RegularHilbert H) (hXY:X≤Y) :\r\n    cutoffWeight B zeta epsilon X≤cutoffWeight B zeta epsilon Y :=\r\n  dualQuadraticIntegral_mono _ _ (star_left_conjugate_le_conjugate hXY _) zeta\r\n\r\ntheorem cutoffWeight_normal (zeta:RegularHilbert H) (epsilon:ℝ)\r\n    {i:Type*} [Preorder i] [IsDirectedOrder i] [Nonempty i]\r\n    (A:i→RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (S:RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (hpos:∀j,0≤A j) (hmono:Monotone A)\r\n    (hlim:∀v,Tendsto (fun j=>A j v) atTop (𝓝 (S v))) :\r\n    cutoffWeight B zeta epsilon S=⨆j,cutoffWeight B zeta epsilon (A j) := by\r\n  let b:=hilbertPositiveSqrt (cutoff B epsilon)\r\n  apply dualQuadraticIntegral_of_monotone_strong_limit\r\n    (fun j=>star b*A j*b) (star b*S*b)\r\n  · exact fun j=>star_left_conjugate_nonneg (hpos j) b\r\n  · exact fun j k hjk=>star_left_conjugate_le_conjugate (hmono hjk) b\r\n  · intro v\r\n    exact ((star b).continuous.tendsto (S (b v))).comp (hlim (b v))\r\n\r\ntheorem hilbertPositiveSqrt_transport {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (f : (H →L[ℂ] H) ≃⋆ₐ[ℂ] (H →L[ℂ] H))\r\n    (A B : H →L[ℂ] H) (r : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B)\r\n    (hr : 0 ≤ r) (hf : f A = (r : ℂ) • B) :\r\n    f (hilbertPositiveSqrt A) = (Real.sqrt r : ℂ) • hilbertPositiveSqrt B := by\r\n  have hsa (T : H →L[ℂ] H) (hT : 0 ≤ T) :\r\n      hilbertPositiveSqrt T * hilbertPositiveSqrt T = T := CFC.sqrt_mul_sqrt_self T hT\r\n  have hp : 0 ≤ f (hilbertPositiveSqrt A) := by\r\n    have ha : 0 ≤ hilbertPositiveSqrt A := CFC.sqrt_nonneg A\r\n    have h := OrderHomClass.monotone f ha\r\n    simpa only [map_zero] using h\r\n  have hq : 0 ≤ (Real.sqrt r : ℂ) • hilbertPositiveSqrt B := by\r\n    apply (ContinuousLinearMap.nonneg_iff_isPositive _).mpr\r\n    apply ((ContinuousLinearMap.nonneg_iff_isPositive _).mp (CFC.sqrt_nonneg B)).smul_of_nonneg\r\n    exact_mod_cast Real.sqrt_nonneg r\r\n  apply (CFC.mul_self_eq_mul_self_iff _ _ hp hq).mp\r\n  have hc : (Real.sqrt r : ℂ) * (Real.sqrt r : ℂ) = (r : ℂ) := by\r\n    exact_mod_cast Real.mul_self_sqrt hr\r\n  rw [← map_mul,hsa A hA,hf,smul_mul_assoc,mul_smul_comm,smul_smul,hc,hsa B hB]\r\n\r\ntheorem cutoffSqrt_dual (epsilon:ℝ) (he:0<epsilon) (s:ℝ) :\r\n    dualAmbient s (hilbertPositiveSqrt (cutoff B epsilon))=\r\n      (Real.sqrt (Real.exp s):ℂ) • hilbertPositiveSqrt (cutoff B (epsilon*Real.exp s)) :=\r\n  hilbertPositiveSqrt_transport (dualAmbient s) _ _ _\r\n    (RegularPositiveFlow.regularInverseGeneratorCutoff_nonneg B epsilon he)\r\n    (RegularPositiveFlow.regularInverseGeneratorCutoff_nonneg B _ (mul_pos he (Real.exp_pos s)))\r\n    (Real.exp_pos s).le (RegularPositiveFlow.regularInverseGeneratorCutoff_dual B epsilon he s)\r\n\r\ntheorem cutoffWeight_dual (zeta:RegularHilbert H) (epsilon:ℝ) (he:0<epsilon)\r\n    (s:ℝ) (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    cutoffWeight B zeta epsilon (dualAmbient s X)=\r\n      ENNReal.ofReal (Real.exp (-s))*cutoffWeight B zeta (epsilon*Real.exp (-s)) X := by\r\n  unfold cutoffWeight\r\n  rw [←dualQuadraticIntegral_dual_invariant (-s)]\r\n  rw [map_mul,map_mul,map_star,cutoffSqrt_dual B epsilon he (-s)]\r\n  have hx:dualAmbient (-s) (dualAmbient s X)=X := by\r\n    rw [←dualAmbient_symm s,StarAlgEquiv.symm_apply_apply]\r\n  rw [hx]\r\n  have hc:(Real.sqrt (Real.exp (-s)):ℂ)*(Real.sqrt (Real.exp (-s)):ℂ)=(Real.exp (-s):ℂ) := by\r\n    exact_mod_cast Real.mul_self_sqrt (Real.exp_pos (-s)).le\r\n  simp only [star_smul,Complex.star_def,Complex.conj_ofReal,smul_mul_assoc,\r\n    mul_smul_comm,smul_smul,hc]\r\n  exact dualQuadraticIntegral_smul_operator (Real.exp (-s)) (Real.exp_pos (-s)).le _ zeta\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_zero\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_add\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_scale\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_mono\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_normal\r\n#print axioms F1Fecho.RegularInverseWeight.hilbertPositiveSqrt_transport\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffSqrt_dual\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_dual\r\n',
+    'TGLExt/F1Fecho394/GeneralInverseFiniteApproximationR1.lean': 'import TGLExt.F1Fecho394.GeneralCutoffAverageCommutationR1\r\nimport TGLExt.F1Fecho394.GeneralInverseStrongFatouR1\r\nimport TGLExt.F1Fecho394.GeneralPositiveSandwichFaithfulR1\r\nimport TGLExt.F1Fecho394.RegularRightAverageR3\r\nimport TGLExt.F1Fecho394.RegularFiniteStarCoreR2\r\nimport TGLExt.F1Fecho394.GeneralRegularDomainCutR1\r\nimport TGLExt.F1Fecho394.RegularCoreFiniteWeightR3\r\nset_option synthInstance.maxHeartbeats 500000\r\n-- BEGIN EXACT BODY GeneralInverseRegularizationR5.lean\r\n/-! Traciality reduces to the existing finite star core for the SAME inverse\r\nsupremum. Regular averages decrease both square values; Fatou gives extension.\r\nThe remaining finite-core tracial equality is an explicit obligation, not proved\r\nby this reduction. The vacuum-fixed hypothesis is consumed in the weight bound. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular Filter\r\nopen F1Fecho.RegularCovariantCore F1Fecho.RegularCoreAverage\r\nopen F1Fecho.RegularFiniteStarCore F1Fecho.RegularPositiveFlow\r\nopen scoped Topology ENNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:UnitaryFlow H) (M:VonNeumannAlgebra H) (zeta:RegularHilbert H)\r\nvariable (hzeta:∀t:ℝ,fibre (boostCLM B t) zeta=zeta)\r\n\r\ninclude hzeta in\r\n/-- The full dual square value is recovered from the same one-sided regular\r\naverages. They need not be a monotone sequence: strong Fatou and the actual\r\nright-contraction bound provide the two inequalities. -/\r\ntheorem dualSquare_eq_iSup_averages\r\n    (A:(RegularCovariantCore.core B M).toStarSubalgebra) :\r\n    dualQuadraticIntegral (star A.val*A.val) zeta =\r\n      ⨆n:ℕ,dualQuadraticIntegral\r\n        (star (A.val*RegularCoreAverage.regularAverage B (1/((n:ℝ)+1)))*\r\n          (A.val*RegularCoreAverage.regularAverage B (1/((n:ℝ)+1)))) zeta := by\r\n  let d:ℕ→ℝ:=fun n=>1/((n:ℝ)+1)\r\n  have hd:Tendsto d atTop (𝓝[≠] (0:ℝ)) := by\r\n    refine tendsto_nhdsWithin_iff.mpr ⟨tendsto_one_div_add_atTop_nhds_zero_nat,?_⟩\r\n    exact Eventually.of_forall (fun n=>by change (1/((n:ℝ)+1):ℝ)≠0; positivity)\r\n  apply le_antisymm\r\n  · apply QuadraticTraceForms.dualSquare_le_of_strong\r\n      (fun n=>A.val*RegularCoreAverage.regularAverage B (d n)) A.val zeta\r\n      (fun v=>(A.val.continuous.tendsto v).comp\r\n        ((RegularCoreAverage.regularAverage_tendsto_identity B v).comp hd))\r\n    intro n\r\n    exact le_iSup (fun n:ℕ=>dualQuadraticIntegral\r\n      (star (A.val*RegularCoreAverage.regularAverage B (d n))*\r\n        (A.val*RegularCoreAverage.regularAverage B (d n))) zeta) n\r\n  · apply iSup_le\r\n    intro n\r\n    exact RegularRightAverage.scalarWeight_right_average_le B M zeta hzeta A _\r\n\r\ninclude hzeta in\r\ntheorem cutoffWeight_right_average_le\r\n    (A:(RegularCovariantCore.core B M).toStarSubalgebra) (e:ℝ) (he:0<e) (d:ℝ) :\r\n    cutoffWeight B zeta e (star (A.val*RegularCoreAverage.regularAverage B d)*\r\n      (A.val*RegularCoreAverage.regularAverage B d)) ≤ cutoffWeight B zeta e (star A.val*A.val) := by\r\n  let b:=hilbertPositiveSqrt (cutoff B e)\r\n  have hb:b∈RegularCovariantCore.core B M := sqrt_mem_core _ _\r\n    (regularInverseGeneratorCutoff_mem B M e) (regularInverseGeneratorCutoff_nonneg B e he)\r\n  have hc:=regularInverseCutoffSqrt_commutes_average B e he d\r\n  have hprod:(A.val*RegularCoreAverage.regularAverage B d)*b=\r\n      (A.val*b)*RegularCoreAverage.regularAverage B d := by\r\n    rw [mul_assoc,←hc.eq,←mul_assoc]\r\n  have h:=RegularRightAverage.scalarWeight_right_average_le B M zeta hzeta\r\n    (A*⟨b,hb⟩) d\r\n  change dualQuadraticIntegral\r\n    (star b*(star (A.val*RegularCoreAverage.regularAverage B d)*\r\n      (A.val*RegularCoreAverage.regularAverage B d))*b) zeta ≤\r\n    dualQuadraticIntegral (star b*(star A.val*A.val)*b) zeta\r\n  have hs:star b*(star (A.val*RegularCoreAverage.regularAverage B d)*\r\n      (A.val*RegularCoreAverage.regularAverage B d))*b=\r\n    star ((A.val*b)*RegularCoreAverage.regularAverage B d)*\r\n      ((A.val*b)*RegularCoreAverage.regularAverage B d) := by\r\n    rw [←hprod]\r\n    simp only [star_mul,mul_assoc]\r\n  rw [hs]\r\n  simpa only [MulMemClass.coe_mul,star_mul,mul_assoc] using h\r\n\r\ninclude hzeta in\r\ntheorem inverseSupremum_right_average_le\r\n    (A:(RegularCovariantCore.core B M).toStarSubalgebra) (d:ℝ) :\r\n    inverseSupremum B zeta (star (A.val*RegularCoreAverage.regularAverage B d)*\r\n      (A.val*RegularCoreAverage.regularAverage B d)) ≤ inverseSupremum B zeta (star A.val*A.val) := by\r\n  apply iSup_le\r\n  intro e\r\n  exact (cutoffWeight_right_average_le B M zeta hzeta A e.val e.property d).trans\r\n    (cutoffWeight_le_supremum B zeta e (star A.val*A.val))\r\n\r\nprivate theorem star_norm_le_one {E:Type}\r\n    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]\r\n    (c:E→L[ℂ]E) (hc:‖c‖≤1) : ‖star c‖≤1 := by\r\n  rw [_root_.norm_star]\r\n  exact hc\r\n\r\ntheorem contraction_left_square {E:Type}\r\n    [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]\r\n    (c a:E→L[ℂ]E) (hc:‖c‖≤1) : star (c*a)*(c*a)≤ star a*a := by\r\n  have hn:‖star c*c‖≤1 := by\r\n    calc\r\n      _ ≤ ‖star c‖*‖c‖ := norm_mul_le _ _\r\n      _ = ‖c‖*‖c‖ := by rw [_root_.norm_star]\r\n      _ ≤ 1*1 := mul_le_mul hc hc (norm_nonneg _) zero_le_one\r\n      _ = 1 := one_mul 1\r\n  have hs:star c*c≤1 :=\r\n    (CStarAlgebra.norm_le_one_iff_of_nonneg (star c*c) (star_mul_self_nonneg c)).mp hn\r\n  simpa only [star_mul,mul_assoc,one_mul] using star_left_conjugate_le_conjugate hs a\r\n\r\ninclude hzeta in\r\ntheorem inverseSupremum_sandwich_le\r\n    (A:(RegularCovariantCore.core B M).toStarSubalgebra) (d:ℝ) :\r\n    inverseSupremum B zeta (star (RegularFiniteStarCore.regularSandwich B M A d).val*\r\n      (RegularFiniteStarCore.regularSandwich B M A d).val) ≤\r\n        inverseSupremum B zeta (star A.val*A.val) := by\r\n  let e:=RegularCoreAverage.regularAverage B d\r\n  have he:‖star e‖≤1 := star_norm_le_one e (RegularCoreAverage.regularAverage_norm_le_one B d)\r\n  have ho:=contraction_left_square (star e) (A.val*e) he\r\n  have hp:star (RegularFiniteStarCore.regularSandwich B M A d).val*\r\n      (RegularFiniteStarCore.regularSandwich B M A d).val ≤ star (A.val*e)*(A.val*e) := by\r\n    change star (star e*A.val*e)*(star e*A.val*e)≤ star (A.val*e)*(A.val*e)\r\n    simpa only [mul_assoc] using ho\r\n  exact (inverseSupremum_mono B zeta _ _ hp).trans\r\n    (inverseSupremum_right_average_le B M zeta hzeta A d)\r\n\r\ninclude hzeta in\r\ntheorem inverseSupremum_tracial_iff_core :\r\n    (∀A:(RegularCovariantCore.core B M).toStarSubalgebra,\r\n      inverseSupremum B zeta (star A.val*A.val)=inverseSupremum B zeta (A.val*star A.val)) ↔\r\n    (∀A:(RegularCovariantCore.core B M).toStarSubalgebra,\r\n      A∈RegularFiniteStarCore.finiteDualStarCore B M →\r\n      inverseSupremum B zeta (star A.val*A.val)=inverseSupremum B zeta (A.val*star A.val)) := by\r\n  constructor\r\n  · exact fun h A _=>h A\r\n  · intro hcore\r\n    have hle (A:(RegularCovariantCore.core B M).toStarSubalgebra) :\r\n        inverseSupremum B zeta (star A.val*A.val) ≤ inverseSupremum B zeta (A.val*star A.val) := by\r\n      let d:ℕ→ℝ:=fun n=>1/((n:ℝ)+1)\r\n      have hd:Tendsto d atTop (𝓝[>] (0:ℝ)) := by\r\n        refine tendsto_nhdsWithin_iff.mpr ⟨tendsto_one_div_add_atTop_nhds_zero_nat,?_⟩\r\n        exact Eventually.of_forall (fun n=>by change (0:ℝ)<1/((n:ℝ)+1); positivity)\r\n      apply inverseSupremum_square_le_of_strong B zeta\r\n        (fun n=>(RegularFiniteStarCore.regularSandwich B M A (d n)).val) A.val\r\n        (fun v=>(RegularFiniteStarCore.regularSandwich_tendsto B M A v).comp hd)\r\n      intro n\r\n      rw [hcore _ (RegularFiniteStarCore.regularSandwich_mem_finiteDualStarCore B M A (d n)\r\n        (by dsimp [d]; positivity))]\r\n      have h:=inverseSupremum_sandwich_le B M zeta hzeta (star A) (d n)\r\n      rw [←RegularFiniteStarCore.regularSandwich_star] at h\r\n      simpa only [StarMemClass.coe_star,star_star] using h\r\n    intro A\r\n    exact le_antisymm (hle A) (by simpa only [StarMemClass.coe_star,star_star] using hle (star A))\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_right_average_le\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_right_average_le\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_sandwich_le\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_tracial_iff_core\r\n\r\n#print axioms F1Fecho.RegularInverseWeight.dualSquare_eq_iSup_averages\r\n-- END EXACT BODY GeneralInverseRegularizationR5.lean\r\n-- BEGIN EXACT BODY GeneralInverseFiniteMinorantsR3.lean\r\n/-! Positive minorants in the same represented core. The tracial square law and\r\nan actual finite-square approximate identity are explicit auxiliary hypotheses.\r\nThis lemma does not assert either hypothesis for the inverse weight. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular Filter\r\nopen scoped Topology ENNReal NNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:RegularCovariantCore.UnitaryFlow H) (M:VonNeumannAlgebra H)\r\nvariable (zeta:RegularHilbert H)\r\n\r\nprivate theorem square_norm_bound {E:Type} [NormedAddCommGroup E]\r\n    [InnerProductSpace ℂ E] [CompleteSpace E] (a:E→L[ℂ]E) :\r\n    star a*a ≤ (‖a‖^2:ℝ) • (1:E→L[ℂ]E) := by\r\n  simpa only [Algebra.algebraMap_eq_smul_one] using\r\n    (CStarAlgebra.star_mul_le_algebraMap_norm_sq (a:=a))\r\n\r\nprivate theorem compressed_square_bound {E:Type} [NormedAddCommGroup E]\r\n    [InnerProductSpace ℂ E] [CompleteSpace E] (a e:E→L[ℂ]E) :\r\n    (e*a)*star (e*a) ≤ (‖a‖^2:ℝ) • (e*star e) := by\r\n  have h:=star_left_conjugate_le_conjugate (square_norm_bound (star a)) (star e)\r\n  simpa only [star_star,_root_.norm_star,star_mul,mul_assoc,\r\n    mul_smul_comm,smul_mul_assoc,one_mul] using h\r\n\r\n/-- A positive square in the existing core, using its actual CFC square root. -/\r\nprivate theorem core_square_source {E:Type} [NormedAddCommGroup E]\r\n    [InnerProductSpace ℂ E] [CompleteSpace E]\r\n    (N:VonNeumannAlgebra E) (X:N.toStarSubalgebra)\r\n    (hX:0≤X.val) : ∃a:N.toStarSubalgebra,\r\n      star a.val*a.val=X.val := by\r\n  let r:=hilbertPositiveSqrt X.val\r\n  have hr:r∈N:=sqrt_mem_core _ _ X.property hX\r\n  refine ⟨⟨r,hr⟩,?_⟩\r\n  change star (CFC.sqrt X.val)*CFC.sqrt X.val=X.val\r\n  rw [(CFC.sqrt_nonneg X.val).isSelfAdjoint.star_eq,CFC.sqrt_mul_sqrt_self X.val hX]\r\n\r\ntheorem inverseSupremum_finite_minorants_of_contractions\r\n    (htr:∀a:(RegularCovariantCore.core B M).toStarSubalgebra,\r\n      inverseSupremum B zeta (star a.val*a.val)=\r\n        inverseSupremum B zeta (a.val*star a.val))\r\n    (E:ℕ→(RegularCovariantCore.core B M).toStarSubalgebra)\r\n    (hn:∀n,‖(E n).val‖≤1)\r\n    (hf:∀n,inverseSupremum B zeta (star (E n).val*(E n).val)<⊤)\r\n    (ht:∀v,Tendsto (fun n=>(E n).val v) atTop (𝓝 v))\r\n    (X:(RegularCovariantCore.core B M).toStarSubalgebra) (hX:0≤X.val) :\r\n    inverseSupremum B zeta X.val =\r\n      ⨆ (Y:(RegularCovariantCore.core B M).toStarSubalgebra) (_:0≤Y.val)\r\n        (_:Y.val≤X.val) (_:inverseSupremum B zeta Y.val<⊤),\r\n        inverseSupremum B zeta Y.val := by\r\n  obtain ⟨a,ha⟩:=core_square_source (RegularCovariantCore.core B M) X hX\r\n  let Y (n:ℕ):(RegularCovariantCore.core B M).toStarSubalgebra :=\r\n    star (E n*a)*(E n*a)\r\n  have hy (n:ℕ): (Y n).val≤X.val := by\r\n    have hp:=contraction_left_square (E n).val a.val (hn n)\r\n    rw [←ha]\r\n    exact hp\r\n  have hfin (n:ℕ):inverseSupremum B zeta (Y n).val<⊤ := by\r\n    let r:ℝ≥0:=⟨‖a.val‖^2,sq_nonneg _⟩\r\n    have ho:=compressed_square_bound a.val (E n).val\r\n    have hle:=inverseSupremum_mono B zeta _ _ ho\r\n    change inverseSupremum B zeta ((E n).val*a.val*star ((E n).val*a.val)) ≤\r\n      inverseSupremum B zeta ((r:ℝ) • ((E n).val*star (E n).val)) at hle\r\n    rw [inverseSupremum_scale B zeta r,←htr (E n)] at hle\r\n    have hfinite:=hle.trans_lt (ENNReal.mul_lt_top ENNReal.coe_lt_top (hf n))\r\n    exact (htr (E n*a)).trans_lt hfinite\r\n  apply le_antisymm\r\n  · conv_lhs => rw [←ha]\r\n    apply inverseSupremum_square_le_of_strong B zeta\r\n      (fun n=>(E n).val*a.val) a.val (fun v=>ht (a.val v))\r\n    intro n\r\n    exact le_iSup_of_le (Y n) (le_iSup_of_le (star_mul_self_nonneg _)\r\n      (le_iSup_of_le (hy n) (le_iSup_of_le (hfin n) le_rfl)))\r\n  · apply iSup_le\r\n    intro Y\r\n    apply iSup_le\r\n    intro _\r\n    apply iSup_le\r\n    intro hYX\r\n    apply iSup_le\r\n    intro _\r\n    exact inverseSupremum_mono B zeta Y.val X.val hYX\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_finite_minorants_of_contractions\r\n-- END EXACT BODY GeneralInverseFiniteMinorantsR3.lean\r\n-- BEGIN EXACT BODY GeneralInverseFiniteContractionsR3.lean\r\n/-! Construct the SAME regular-average/domain-cut approximate identity.\r\nThe domain-cut bound remains explicit here; its concrete polar-right proof is\r\na separate consumer. No trace or alternative representation is postulated. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular Filter\r\nopen F1Fecho.RegularPositiveFlow F1Fecho.RegularCovariantCore\r\nopen scoped Topology ENNReal NNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:UnitaryFlow H) (M:VonNeumannAlgebra H) (zeta:RegularHilbert H)\r\n\r\ntheorem inverseSupremum_finite_contractions_of_domain_bound\r\n    (hbound:∀(a:(core B M).toStarSubalgebra) (d:ℝ), 0<d →\r\n      inverseSupremum B zeta\r\n        (star (a.val*(regularDomainCut B M d).val)*(a.val*(regularDomainCut B M d).val)) ≤\r\n          ENNReal.ofReal d⁻¹*dualQuadraticIntegral (star a.val*a.val) zeta) :\r\n    ∃E:ℕ→(core B M).toStarSubalgebra,\r\n      (∀n,‖(E n).val‖≤1) ∧\r\n      (∀n,inverseSupremum B zeta (star (E n).val*(E n).val)<⊤) ∧\r\n      (∀v,Tendsto (fun n=>(E n).val v) atTop (𝓝 v)) := by\r\n  let d:ℕ→ℝ:=fun n=>1/((n:ℝ)+1)\r\n  have hd(n:ℕ):0<d n:=by dsimp[d];positivity\r\n  let e(n:ℕ):(core B M).toStarSubalgebra:=\r\n    ⟨RegularCoreAverage.regularAverage B (d n),RegularCoreAverage.regularAverage_mem B M (d n)⟩\r\n  let E(n:ℕ):=e n*regularDomainCut B M (d n)\r\n  have hqn(n:ℕ):‖(regularDomainCut B M (d n)).val‖≤1:=by\r\n    obtain ⟨h0,h1⟩:=regularDomainCut_bounds B M (d n) (hd n)\r\n    exact (CStarAlgebra.norm_le_norm_of_nonneg_of_le h0 h1).trans ContinuousLinearMap.norm_id_le\r\n  refine ⟨E,?_,?_,?_⟩\r\n  · intro n\r\n    exact (norm_mul_le _ _).trans (by\r\n      simpa only [one_mul] using mul_le_mul (RegularCoreAverage.regularAverage_norm_le_one B (d n))\r\n        (hqn n) (norm_nonneg _) zero_le_one)\r\n  · intro n\r\n    exact (hbound (e n) (d n) (hd n)).trans_lt\r\n      (ENNReal.mul_lt_top ENNReal.ofReal_lt_top\r\n        (RegularCoreFiniteWeight.regularAverage_dualQuadraticIntegral_lt_top B (d n) (hd n) zeta))\r\n  · intro v\r\n    have ht:Tendsto d atTop (𝓝[≠] (0:ℝ)):=by\r\n      refine tendsto_nhdsWithin_iff.mpr ⟨tendsto_one_div_add_atTop_nhds_zero_nat,?_⟩\r\n      exact Eventually.of_forall (fun n=>ne_of_gt (hd n))\r\n    exact bounded_application_tendsto atTop (fun n=>(e n).val) 1\r\n      (fun n=>RegularCoreAverage.regularAverage_norm_le_one B (d n))\r\n      (fun n=>(regularDomainCut B M (d n)).val v) v v\r\n      (regularDomainCut_tendsto_identity B M v)\r\n      ((RegularCoreAverage.regularAverage_tendsto_identity B v).comp ht)\r\n\r\ntheorem inverseSupremum_finite_minorants_of_domain_bound\r\n    (hbound:∀(a:(core B M).toStarSubalgebra) (d:ℝ), 0<d →\r\n      inverseSupremum B zeta\r\n        (star (a.val*(regularDomainCut B M d).val)*(a.val*(regularDomainCut B M d).val)) ≤\r\n          ENNReal.ofReal d⁻¹*dualQuadraticIntegral (star a.val*a.val) zeta)\r\n    (htr:∀a:(core B M).toStarSubalgebra,\r\n      inverseSupremum B zeta (star a.val*a.val)=inverseSupremum B zeta (a.val*star a.val))\r\n    (X:(core B M).toStarSubalgebra) (hX:0≤X.val) :\r\n    inverseSupremum B zeta X.val =\r\n      ⨆ (Y:(core B M).toStarSubalgebra) (_:0≤Y.val) (_:Y.val≤X.val)\r\n        (_:inverseSupremum B zeta Y.val<⊤),inverseSupremum B zeta Y.val := by\r\n  obtain ⟨E,hn,hf,ht⟩:=inverseSupremum_finite_contractions_of_domain_bound B M zeta hbound\r\n  exact inverseSupremum_finite_minorants_of_contractions B M zeta htr E hn hf ht X hX\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_finite_contractions_of_domain_bound\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_finite_minorants_of_domain_bound\r\n-- END EXACT BODY GeneralInverseFiniteContractionsR3.lean\r\n',
+    'TGLExt/F1Fecho394/GeneralInverseStrongFatouR1.lean': 'import TGLExt.F1Fecho394.GeneralInverseSupremumR3\r\nimport TGLExt.F1Fecho394.GenericDualSquareFatouR1\r\n/-! Strong lower semicontinuity on squares for the same inverse supremum.\r\nNo adjoint convergence, finite upper bound, or traciality is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLV350.Regular Filter\r\nopen scoped Topology ENNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:RegularCovariantCore.UnitaryFlow H)\r\n\r\ntheorem inverseSupremum_square_le_of_strong\r\n    (zeta:RegularHilbert H)\r\n    (A:ℕ→RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (S:RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (hlim:∀v,Tendsto (fun n=>A n v) atTop (𝓝 (S v)))\r\n    (C:ℝ≥0∞) (hb:∀n,inverseSupremum B zeta (star (A n)*A n) ≤ C) :\r\n    inverseSupremum B zeta (star S*S) ≤ C := by\r\n  apply iSup_le\r\n  intro e\r\n  let b:=hilbertPositiveSqrt (cutoff B e.val)\r\n  have h := QuadraticTraceForms.dualSquare_le_of_strong\r\n    (fun n=>A n*b) (S*b) zeta (fun v=>hlim (b v)) C (fun n=>?_)\r\n  · simpa only [cutoffWeight,star_mul,mul_assoc,b] using h\r\n  · have hh := (cutoffWeight_le_supremum B zeta e (star (A n)*A n)).trans (hb n)\r\n    simpa only [cutoffWeight,star_mul,mul_assoc,b] using hh\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_square_le_of_strong\r\n',
+    'TGLExt/F1Fecho394/GeneralInverseSupremumR3.lean': 'import TGLExt.F1Fecho394.GeneralInverseCutoffWeightR3\r\n/-! Supremum over every positive regulator in the same regular representation.\r\nThe dual scaling is exact by reindexing; no regulator-order premise is hidden.\r\nAdditivity and traciality are deliberately not asserted here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1500000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular MeasureTheory Filter\r\nopen scoped Topology ENNReal NNReal\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B:RegularCovariantCore.UnitaryFlow H)\r\nabbrev PositiveRegulator := {e:ℝ // 0<e}\r\ndef inverseSupremum (zeta:RegularHilbert H)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) : ℝ≥0∞ :=\r\n  ⨆ e:PositiveRegulator, cutoffWeight B zeta e.val X\r\n\r\ntheorem inverseSupremum_zero (zeta:RegularHilbert H) :\r\n    inverseSupremum B zeta 0=0 := by\r\n  simp only [inverseSupremum,cutoffWeight_zero,iSup_const]\r\n\r\ntheorem cutoffWeight_le_supremum (zeta:RegularHilbert H) (e:PositiveRegulator)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    cutoffWeight B zeta e.val X ≤ inverseSupremum B zeta X :=\r\n  le_iSup (fun e:PositiveRegulator=>cutoffWeight B zeta e.val X) e\r\n\r\ntheorem inverseSupremum_scale (zeta:RegularHilbert H) (r:ℝ≥0)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    inverseSupremum B zeta ((r:ℝ) • X)=(r:ℝ≥0∞)*inverseSupremum B zeta X := by\r\n  simp only [inverseSupremum,cutoffWeight_scale]\r\n  exact (ENNReal.mul_iSup _ _).symm\r\n\r\ntheorem inverseSupremum_mono (zeta:RegularHilbert H)\r\n    (X Y:RegularHilbert H→L[ℂ]RegularHilbert H) (hXY:X ≤ Y) :\r\n    inverseSupremum B zeta X ≤ inverseSupremum B zeta Y := by\r\n  apply iSup_le\r\n  intro e\r\n  exact le_iSup_of_le e (cutoffWeight_mono B zeta e.val X Y hXY)\r\n\r\ntheorem inverseSupremum_subadditive (zeta:RegularHilbert H)\r\n    (X Y:RegularHilbert H→L[ℂ]RegularHilbert H) (hX:0 ≤ X) (hY:0 ≤ Y) :\r\n    inverseSupremum B zeta (X+Y) ≤ inverseSupremum B zeta X+inverseSupremum B zeta Y := by\r\n  apply iSup_le\r\n  intro e\r\n  rw [cutoffWeight_add B zeta e.val X Y hX hY]\r\n  exact add_le_add (cutoffWeight_le_supremum B zeta e X) (cutoffWeight_le_supremum B zeta e Y)\r\n\r\ntheorem inverseSupremum_normal (zeta:RegularHilbert H)\r\n    {i:Type*} [Preorder i] [IsDirectedOrder i] [Nonempty i]\r\n    (A:i→RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (S:RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (hpos:∀j,0 ≤ A j) (hmono:Monotone A)\r\n    (hlim:∀v,Tendsto (fun j=>A j v) atTop (𝓝 (S v))) :\r\n    inverseSupremum B zeta S=⨆j,inverseSupremum B zeta (A j) := by\r\n  simp only [inverseSupremum,cutoffWeight_normal B zeta _ A S hpos hmono hlim]\r\n  exact iSup_comm\r\n\r\ntheorem supremum_rescale (zeta:RegularHilbert H) (r:ℝ) (hr:0<r)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    (⨆ e:PositiveRegulator,cutoffWeight B zeta (e.val*r) X)=inverseSupremum B zeta X := by\r\n  apply le_antisymm\r\n  · apply iSup_le\r\n    intro e\r\n    exact cutoffWeight_le_supremum B zeta ⟨e.val*r,mul_pos e.property hr⟩ X\r\n  · apply iSup_le\r\n    intro e\r\n    let d:PositiveRegulator:=⟨e.val/r,div_pos e.property hr⟩\r\n    have hd:d.val*r=e.val := div_mul_cancel₀ e.val (ne_of_gt hr)\r\n    exact le_iSup_of_le d (by rw [hd])\r\n\r\ntheorem inverseSupremum_dual (zeta:RegularHilbert H) (s:ℝ)\r\n    (X:RegularHilbert H→L[ℂ]RegularHilbert H) :\r\n    inverseSupremum B zeta (dualAmbient s X)=\r\n      ENNReal.ofReal (Real.exp (-s))*inverseSupremum B zeta X := by\r\n  unfold inverseSupremum\r\n  simp only [cutoffWeight_dual B zeta _ (Subtype.property _) s X]\r\n  rw [← ENNReal.mul_iSup]\r\n  exact congrArg (fun q:ℝ≥0∞=>ENNReal.ofReal (Real.exp (-s))*q)\r\n    (supremum_rescale B zeta (Real.exp (-s)) (Real.exp_pos (-s)) X)\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_zero\r\n#print axioms F1Fecho.RegularInverseWeight.cutoffWeight_le_supremum\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_scale\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_mono\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_subadditive\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_normal\r\n#print axioms F1Fecho.RegularInverseWeight.supremum_rescale\r\n#print axioms F1Fecho.RegularInverseWeight.inverseSupremum_dual\r\n',
+    'TGLExt/F1Fecho394/GeneralPositiveSandwichFaithfulR1.lean': "import TGLExt.F1Fecho394.GeneralInverseCutoffWeightR3\r\nimport TGLExt.V350ResolventSquareRoot\r\nimport TGLExt.V350LevelExpectationUniformBound\r\n/-! Faithful positive sandwich and positive-root membership reused from the\r\nproofs incorporated in canonical v393. No trace law is inferred. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularInverseWeight\r\nopen TGLExt TGLV350.Regular\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem sqrt_mem_core (N:VonNeumannAlgebra H) (X:H→L[ℂ]H)\r\n    (hm:X∈N) (hX:0≤X) : hilbertPositiveSqrt X∈N := by\r\n  letI:IsClosed (N.toStarSubalgebra:Set (H→L[ℂ]H)):=vonNeumann_norm_closed N\r\n  rw [hilbertPositiveSqrt,CFC.sqrt_eq_real_sqrt X hX]\r\n  exact cfcₙ_mem (𝕜':=ℂ) (s:=N.toStarSubalgebra) Real.sqrt hm\r\n\r\ntheorem sqrt_conjugation_faithful (R X:H→L[ℂ]H) (hR:0≤R)\r\n    (hi:Function.Injective R)\r\n    (hz:star (hilbertPositiveSqrt R)*X*hilbertPositiveSqrt R=0) : X=0 := by\r\n  have hsi:Function.Injective (hilbertPositiveSqrt R):=positive_sqrt_injective R hR hi\r\n  have hsd:DenseRange (hilbertPositiveSqrt R):=resolventSquareRoot_dense R hR hi\r\n  have hs:star (hilbertPositiveSqrt R)=hilbertPositiveSqrt R:=\r\n    (CFC.sqrt_nonneg R).isSelfAdjoint.star_eq\r\n  have hzv (v:H):X (hilbertPositiveSqrt R v)=0 := by\r\n    apply hsi\r\n    have he:=congrArg (fun T:H→L[ℂ]H=>T v) hz\r\n    simpa only [hs,mul_apply_eq_comp,zero_apply,map_zero] using he\r\n  ext1 x\r\n  change X x=0\r\n  refine hsd.induction ?_ (isClosed_eq X.continuous continuous_const) x\r\n  rintro _ ⟨v,rfl⟩\r\n  exact hzv v\r\nend F1Fecho.RegularInverseWeight\r\n#print axioms F1Fecho.RegularInverseWeight.sqrt_mem_core\r\n#print axioms F1Fecho.RegularInverseWeight.sqrt_conjugation_faithful\r\n",
+    'TGLExt/F1Fecho394/GeneralRegularAbsorptionR1.lean': 'import TGLExt.F1Fecho394.CoefficientBoostR1\r\n\r\n/-! The existing generic regular representation is conjugate to translation,\r\nusing the already constructed coefficient boost multiplier. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem absorption_shift (B : UnitaryFlow H) (t : ℝ) (f : RegularHilbert H) :\r\n    CoefficientBoost.unitary B 1 (shift t f)=\r\n      RegularCovariantCore.regularUnitary B t (CoefficientBoost.unitary B 1 f) := by\r\n  apply Lp.ext\r\n  filter_upwards [CoefficientBoost.unitary_ae B 1 (shift t f), shift_ae t f,\r\n    fibre_ae (boostCLM B t) (shift t (CoefficientBoost.unitary B 1 f)),\r\n    shift_ae t (CoefficientBoost.unitary B 1 f),\r\n    (measurePreserving_sub_right volume t).quasiMeasurePreserving.ae\r\n      (CoefficientBoost.unitary_ae B 1 f)] with a h1 h2 h3 h4 h5\r\n  change CoefficientBoost.unitary B 1 (shift t f) a=\r\n    fibre (boostCLM B t) (shift t (CoefficientBoost.unitary B 1 f)) a\r\n  rw [h1,h2,h3,h4,h5]\r\n  simp only [one_mul]\r\n  change B.U a (f (a-t))=B.U t (B.U (a-t) (f (a-t)))\r\n  have he:=congrArg (fun V : H≃ₗᵢ[ℂ]H=>V (f (a-t))) (B.add t (a-t))\r\n  simpa only [add_sub_cancel,LinearIsometryEquiv.trans_apply] using he\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.absorption_shift\r\n',
+    'TGLExt/F1Fecho394/GeneralRegularAffiliationR1.lean': "import TGLExt.F1Fecho394.GeneralRegularImaginaryPowersR1\r\nimport TGLExt.V351RegularGeneratorAffiliation\r\n\r\n/-! Affiliation of the concrete positive generator to the generic regular\r\ncrossed-product algebra, by commutation of its actual resolvent. Reuses v351\r\ncharacter locality and the constructed group identification. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2500000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\n/-- The actual bounded resolvent belongs to the actual core. -/\r\ntheorem regularSpectralResolvent_mem (Q : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) :\r\n    regularSpectralResolvent Q ∈ RegularCovariantCore.core Q M := by\r\n  rw [← VonNeumannAlgebra.commutant_commutant (RegularCovariantCore.core Q M),\r\n    VonNeumannAlgebra.mem_commutant_iff]\r\n  intro B hB\r\n  let V := regularSpectralCoordinates Q\r\n  let C := V.symm.conjStarAlgEquiv B\r\n  have hC (x : RegularHilbert (H)) : V (C x) = B (V x) := by\r\n    change V (V.symm (B (V x))) = _\r\n    exact V.apply_symm_apply _\r\n  have hchar : ∀ s : ℝ, characterMultiplier s * C = C * characterMultiplier s := by\r\n    intro s\r\n    let t := s/(2*Real.pi)\r\n    have ht : 2*Real.pi*t = s := by\r\n      dsimp only [t]\r\n      field_simp\r\n    have hv (x : RegularHilbert (H)) :\r\n        V (characterMultiplier s x) = RegularCovariantCore.regularUnitary Q t (V x) := by\r\n      simpa only [ht] using regularSpectralCoordinates_character Q t x\r\n    ext1 x\r\n    apply V.injective\r\n    change V (characterMultiplier s (C x)) = V (C (characterMultiplier s x))\r\n    rw [hv, hC, hC, hv]\r\n    exact congrArg (fun A : RegularHilbert (H) →L[ℂ] RegularHilbert (H) => A (V x))\r\n      ((VonNeumannAlgebra.mem_commutant_iff.mp hB) _ (RegularCovariantCore.regular_mem Q M t))\r\n  let g : ℝ → ℝ := fun ξ => Real.sigmoid (2*Real.pi*ξ)\r\n  have hg : Continuous g := by fun_prop\r\n  have h0 : ∀ ξ, 0 ≤ g ξ := fun ξ => Real.sigmoid_nonneg _\r\n  have h1 : ∀ ξ, g ξ ≤ 1 := fun ξ => Real.sigmoid_le_one _\r\n  let M := realScalarMultiplier (H := H) g hg h0 h1\r\n  have hr : V.symm.conjStarAlgEquiv (regularSpectralResolvent Q) = M := by\r\n    ext1 x\r\n    change V.symm (regularSpectralResolvent Q (V x)) = M x\r\n    change V.symm (V (M (V.symm (V x)))) = M x\r\n    rw [V.symm_apply_apply, V.symm_apply_apply]\r\n  apply V.symm.conjStarAlgEquiv.injective\r\n  change V.symm.conjStarAlgEquiv (B * regularSpectralResolvent Q) =\r\n    V.symm.conjStarAlgEquiv (regularSpectralResolvent Q * B)\r\n  rw [map_mul, map_mul, hr]\r\n  exact (character_commutation_realScalarMultiplier C hchar g hg h0 h1).symm\r\n\r\n/-- Affiliation expressed directly as graph commutation for every bounded\r\noperator in N'. Together with the already proved closedness this is the usual\r\ncommutant criterion; no new affiliated-form object replaces the operator. -/\r\ntheorem regularPositiveGenerator_commutant_graph (Q : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H)\r\n    (B : RegularHilbert (H) →L[ℂ] RegularHilbert (H))\r\n    (hB : B ∈ (RegularCovariantCore.core Q M).commutant)\r\n    (x y : RegularHilbert (H))\r\n    (hxy : (x,y) ∈ (regularPositiveGenerator Q).graph) :\r\n    (B x,B y) ∈ (regularPositiveGenerator Q).graph := by\r\n  let R := regularSpectralResolvent Q\r\n  have hc : R * B = B * R :=\r\n    (VonNeumannAlgebra.mem_commutant_iff.mp hB) _ (regularSpectralResolvent_mem Q M)\r\n  have he (u : RegularHilbert (H)) : R (B u) = B (R u) :=\r\n    congrArg (fun A : RegularHilbert (H) →L[ℂ] RegularHilbert (H) => A u) hc\r\n  change (x,y) ∈ (resolventGraphOperator R (regularSpectralResolvent_injective Q)).graph at hxy\r\n  rw [resolvent_graph_equation] at hxy\r\n  change (B x,B y) ∈ (resolventGraphOperator R (regularSpectralResolvent_injective Q)).graph\r\n  rw [resolvent_graph_equation]\r\n  change B x - R (B x) = R (B y)\r\n  change x-R x = R y at hxy\r\n  rw [he, he, ← map_sub, hxy]\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_mem\r\n#print axioms F1Fecho.RegularPositiveFlow.regularPositiveGenerator_commutant_graph\r\n",
+    'TGLExt/F1Fecho394/GeneralRegularCutoffCFCR1.lean': "import TGLExt.F1Fecho394.GeneralRegularInverseCutoffR1\r\nimport TGLExt.V351InverseCutoffCFC\r\n/-! Generalization of the inverse CFC proof incorporated in canonical v393. V351 is the historical source name. The actual graph, flow and cutoff are retained. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2400000\r\nset_option synthInstance.maxHeartbeats 200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nopen scoped Topology\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem regularResolvent_cfc_coordinate (B : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (f : ℂ → ℂ) (hf : Continuous f) (x : RegularHilbert H) :\r\n    (regularSpectralCoordinates B).symm (cfc f (regularSpectralResolvent B) x) =ᵐ[volume]\r\n      fun ξ => f (Real.sigmoid (2*Real.pi*ξ)) • ((regularSpectralCoordinates B).symm x) ξ := by\r\n  let V := regularSpectralCoordinates B\r\n  let M := realScalarMultiplier (H := H) (fun ξ => Real.sigmoid (2*Real.pi*ξ))\r\n    (by fun_prop) (fun ξ => Real.sigmoid_nonneg _) (fun ξ => Real.sigmoid_le_one _)\r\n  have hM : 0 ≤ M := realScalarMultiplier_nonneg _ _ _ _\r\n  have hc := StarAlgHomClass.map_cfc V.conjStarAlgEquiv f M hf.continuousOn\r\n    (StarAlgEquiv.isometry V.conjStarAlgEquiv).continuous\r\n    (IsSelfAdjoint.of_nonneg hM).isStarNormal\r\n    (IsSelfAdjoint.of_nonneg (map_nonneg V.conjStarAlgEquiv hM)).isStarNormal\r\n  change V.symm (cfc f (V.conjStarAlgEquiv M) x) =ᵐ[volume] _\r\n  rw [← hc]\r\n  simp only [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply,LinearIsometryEquiv.symm_apply_apply]\r\n  exact realScalarMultiplier_cfc_ae _ _ _ _ f hf (V.symm x)\r\n\r\n/-- Identify the existing inverse by its already proved graph equation.\r\nThere is no new inverse, generator, or change of representation. -/\r\ntheorem regularInverseGeneratorCutoff_cfc (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (ε : ℝ) (hε : 0 < ε) :\r\n    regularInverseGeneratorCutoff B ε =\r\n      cfc (inverseCutoffFunction ε) (regularSpectralResolvent B) := by\r\n  ext1 x\r\n  let Y := cfc (inverseCutoffFunction ε) (regularSpectralResolvent B)\r\n  let V := regularSpectralCoordinates B\r\n  have hh : (Y x,x-(ε : ℂ) • Y x) ∈ (regularPositiveGenerator B).graph := by\r\n    rw [regularPositiveGenerator_graph_iff,map_sub,map_smul]\r\n    filter_upwards [regularResolvent_cfc_coordinate B (inverseCutoffFunction ε)\r\n        (inverseCutoffFunction_continuous ε hε) x,\r\n      Lp.coeFn_sub (V.symm x) ((ε : ℂ) • V.symm (Y x)),\r\n      Lp.coeFn_smul (ε : ℂ) (V.symm (Y x))] with ξ hy hs hm\r\n    change (V.symm x-(ε : ℂ) • V.symm (Y x)) ξ =\r\n      (Real.exp (-(2*Real.pi*ξ)) : ℂ) • (V.symm (Y x)) ξ\r\n    rw [hs,Pi.sub_apply,hm,Pi.smul_apply]\r\n    change (V.symm x) ξ-(ε : ℂ) • (V.symm (Y x)) ξ =\r\n      (Real.exp (-(2*Real.pi*ξ)) : ℂ) • (V.symm (Y x)) ξ\r\n    have hy' : (V.symm (Y x)) ξ =\r\n        inverseCutoffFunction ε (Real.sigmoid (2*Real.pi*ξ)) • (V.symm x) ξ := hy\r\n    rw [hy',inverseCutoffFunction_sigmoid ε _ hε]\r\n    have hc : (1 : ℂ)-(ε : ℂ)*(((ε+Real.exp (-(2*Real.pi*ξ)))⁻¹ : ℝ) : ℂ) =\r\n        (Real.exp (-(2*Real.pi*ξ)) : ℂ) *\r\n          (((ε+Real.exp (-(2*Real.pi*ξ)))⁻¹ : ℝ) : ℂ) := by\r\n      have hn : (ε+Real.exp (-(2*Real.pi*ξ)) : ℂ) ≠ 0 := by\r\n        exact_mod_cast ne_of_gt (add_pos hε (Real.exp_pos (-(2*Real.pi*ξ))))\r\n      simp only [Complex.ofReal_inv,Complex.ofReal_add]\r\n      field_simp [hn]\r\n      ring\r\n    simpa only [sub_smul,one_smul,smul_smul] using congrArg (fun c : ℂ => c • (V.symm x) ξ) hc\r\n  have hi := (regularInverseGeneratorCutoff_graph_iff B ε hε (Y x) (x-(ε : ℂ) • Y x)).mp hh\r\n  simpa only [sub_add_cancel] using hi\r\n\r\n\r\nend F1Fecho.RegularPositiveFlow\r\n#print axioms F1Fecho.RegularPositiveFlow.regularResolvent_cfc_coordinate\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseGeneratorCutoff_cfc\r\n",
+    'TGLExt/F1Fecho394/GeneralRegularDomainCutR1.lean': "import TGLExt.F1Fecho394.GeneralRegulatorOrderR1\r\nimport TGLExt.V351RegularDomainCut\r\n/-! Actual bounded domain cutoffs of the generic regular generator, with positivity, product bounds and strong convergence. Reuses the v393 proof, on the same H and flow. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2400000\r\nset_option synthInstance.maxHeartbeats 200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLV350.Regular TGLExt ChatgptAudit MeasureTheory Filter\r\nopen scoped Topology\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n/-- A bounded domain cutoff made from the original inverse generator cutoff. -/\r\ndef regularDomainCut (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (δ : ℝ) : (RegularCovariantCore.core B M).toStarSubalgebra :=\r\n  1 - (δ : ℂ) • ⟨regularInverseGeneratorCutoff B δ,regularInverseGeneratorCutoff_mem B M δ⟩\r\n\r\nprivate theorem hilbert_positive_smul {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A : H →L[ℂ] H) (hA : 0 ≤ A) (r : ℝ) (hr : 0 ≤ r) : 0 ≤ (r : ℂ) • A := by\r\n  apply (ContinuousLinearMap.nonneg_iff_isPositive _).mpr\r\n  apply ((ContinuousLinearMap.nonneg_iff_isPositive _).mp hA).smul_of_nonneg\r\n  exact_mod_cast hr\r\n\r\nprivate theorem hilbert_contract_norm {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A : H →L[ℂ] H) (hA : 0 ≤ A) (h1 : A ≤ 1) : ‖A‖ ≤ 1 :=\r\n  (CStarAlgebra.norm_le_norm_of_nonneg_of_le hA h1).trans ContinuousLinearMap.norm_id_le\r\n\r\nprivate theorem hilbert_positive_product {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A B : H →L[ℂ] H) (hA : 0 ≤ A) (hB : 0 ≤ B) (hc : Commute A B) :\r\n    0 ≤ A*B := Commute.mul_nonneg hA hB hc\r\n\r\ntheorem regularDomainCut_bounds (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (δ : ℝ) (hδ : 0 < δ) :\r\n    0 ≤ (regularDomainCut B M δ).val ∧ (regularDomainCut B M δ).val ≤ 1 := by\r\n  have hb := regularInverseGeneratorCutoff_nonneg B δ hδ\r\n  have hu := sub_nonneg.mpr (regularInverseGeneratorCutoff_le B δ hδ)\r\n  have hp := hilbert_positive_smul _ hu δ hδ.le\r\n  have he : (δ : ℂ) * (δ⁻¹ : ℂ) = 1 := by exact_mod_cast mul_inv_cancel₀ hδ.ne'\r\n  rw [smul_sub,smul_smul,he,one_smul] at hp\r\n  refine ⟨hp,?_⟩\r\n  change 1 - (δ : ℂ) • regularInverseGeneratorCutoff B δ ≤ 1\r\n  exact sub_le_self _ (hilbert_positive_smul _ hb δ hδ.le)\r\n\r\ntheorem regularDomainCut_commutes (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (ε δ : ℝ)\r\n    (hε : 0 < ε) (hδ : 0 < δ) :\r\n    Commute (regularInverseGeneratorCutoff B ε) (regularDomainCut B M δ).val := by\r\n  have hc := (regularInverseGeneratorCutoff_commutes B ε δ hε hδ).eq\r\n  change regularInverseGeneratorCutoff B ε * (1-(δ : ℂ) • regularInverseGeneratorCutoff B δ) =\r\n    (1-(δ : ℂ) • regularInverseGeneratorCutoff B δ) * regularInverseGeneratorCutoff B ε\r\n  simp only [mul_sub,sub_mul,mul_one,one_mul,mul_smul_comm,smul_mul_assoc,hc]\r\n\r\n/-- Resolvent identity with no division by the difference of regulators. -/\r\ntheorem regularDomainCut_inverse_product (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (ε δ : ℝ)\r\n    (hε : 0 < ε) (hδ : 0 < δ) :\r\n    regularInverseGeneratorCutoff B ε * (regularDomainCut B M δ).val =\r\n      regularInverseGeneratorCutoff B δ - (ε : ℂ) •\r\n        (regularInverseGeneratorCutoff B δ * regularInverseGeneratorCutoff B ε) := by\r\n  have he := regularInverseGeneratorCutoff_resolvent_identity B ε δ hε hδ\r\n  have hc := (regularInverseGeneratorCutoff_commutes B ε δ hε hδ).eq\r\n  change regularInverseGeneratorCutoff B ε * (1-(δ : ℂ) • regularInverseGeneratorCutoff B δ) = _\r\n  rw [mul_sub,mul_one,mul_smul_comm,hc]\r\n  rw [Complex.ofReal_sub,sub_smul] at he\r\n  simpa only [sub_add_cancel] using (show\r\n    regularInverseGeneratorCutoff B ε - (δ : ℂ) •\r\n      (regularInverseGeneratorCutoff B δ * regularInverseGeneratorCutoff B ε) =\r\n    regularInverseGeneratorCutoff B δ - (ε : ℂ) •\r\n      (regularInverseGeneratorCutoff B δ * regularInverseGeneratorCutoff B ε) by\r\n        calc\r\n          _ = (regularInverseGeneratorCutoff B ε - regularInverseGeneratorCutoff B δ) +\r\n              regularInverseGeneratorCutoff B δ - (δ : ℂ) •\r\n                (regularInverseGeneratorCutoff B δ * regularInverseGeneratorCutoff B ε) := by abel\r\n          _ = _ := by rw [he]; abel)\r\n\r\nprivate theorem hilbert_commuting_contract_product {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (B q : H →L[ℂ] H) (hB : 0 ≤ B) (hq : 0 ≤ q) (h1 : q ≤ 1) (hc : Commute B q) :\r\n    B*q*q ≤ B*q := by\r\n  have hp : 0 ≤ B*q := Commute.mul_nonneg hB hq hc\r\n  have hcom : Commute (B*q) (1-q) := by\r\n    change (B*q)*(1-q) = (1-q)*(B*q)\r\n    simp only [mul_sub,sub_mul,mul_one,one_mul]\r\n    congr 1\r\n    rw [← mul_assoc,hc.eq,mul_assoc]\r\n  have hh := Commute.mul_nonneg hp (sub_nonneg.mpr h1) hcom\r\n  simpa only [mul_sub,mul_one,sub_nonneg] using hh\r\n\r\n/-- Uniform in epsilon, with a bound depending only on the domain cutoff. -/\r\ntheorem regularDomainCut_product_bound (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (ε δ : ℝ)\r\n    (hε : 0 < ε) (hδ : 0 < δ) :\r\n    regularInverseGeneratorCutoff B ε * (regularDomainCut B M δ).val *\r\n      (regularDomainCut B M δ).val ≤ (δ⁻¹ : ℂ) • 1 := by\r\n  obtain ⟨hq,hq1⟩ := regularDomainCut_bounds B M δ hδ\r\n  have hs := hilbert_commuting_contract_product _ _\r\n    (regularInverseGeneratorCutoff_nonneg B ε hε) hq hq1\r\n    (regularDomainCut_commutes B M ε δ hε hδ)\r\n  have hp : 0 ≤ regularInverseGeneratorCutoff B δ * regularInverseGeneratorCutoff B ε :=\r\n    hilbert_positive_product _ _ (regularInverseGeneratorCutoff_nonneg B δ hδ)\r\n      (regularInverseGeneratorCutoff_nonneg B ε hε)\r\n      (regularInverseGeneratorCutoff_commutes B δ ε hδ hε)\r\n  have ho : regularInverseGeneratorCutoff B ε * (regularDomainCut B M δ).val ≤\r\n      regularInverseGeneratorCutoff B δ := by\r\n    rw [regularDomainCut_inverse_product B M ε δ hε hδ]\r\n    exact sub_le_self _ (hilbert_positive_smul _ hp ε hε.le)\r\n  exact hs.trans (ho.trans (regularInverseGeneratorCutoff_le B δ hδ))\r\n\r\n/-- Strong convergence on the SAME Hilbert space. No operator-norm convergence\r\nor spectral gap is assumed. -/\r\ntheorem regularDomainCut_tendsto_identity (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H)\r\n    (v : RegularHilbert H) :\r\n    Tendsto (fun n : ℕ => (regularDomainCut B M (1/((n : ℝ)+1))).val v) atTop (𝓝 v) := by\r\n  let R := regularSpectralResolvent B\r\n  let S : RegularHilbert H →L[ℂ] RegularHilbert H := 1-R\r\n  let D (n : ℕ) := (1-(regularDomainCut B M (1/((n : ℝ)+1))).val)\r\n  have hnD (n : ℕ) : ‖D n‖ ≤ 1 := by\r\n    obtain ⟨hq,hq1⟩ := regularDomainCut_bounds B M (1/((n : ℝ)+1)) (by positivity)\r\n    exact hilbert_contract_norm _ (sub_nonneg.mpr hq1) (sub_le_self _ hq)\r\n  have hnq (n : ℕ) : ‖(regularDomainCut B M (1/((n : ℝ)+1))).val‖ ≤ 1 := by\r\n    obtain ⟨hq,hq1⟩ := regularDomainCut_bounds B M (1/((n : ℝ)+1)) (by positivity)\r\n    exact hilbert_contract_norm _ hq hq1\r\n  have hnR : ‖R‖ ≤ 1 := hilbert_contract_norm _\r\n    (regularSpectralResolvent_nonneg B) (regularSpectralResolvent_le_one B)\r\n  have hd : DenseRange S := ChatgptAudit.Continuous049.bounded_graph_domain_dense S 0\r\n    (regularSpectralResolvent_complement_injective B)\r\n    (IsSelfAdjoint.of_nonneg (sub_nonneg.mpr (regularSpectralResolvent_le_one B)))\r\n  have heq (n : ℕ) : D n * S =\r\n      ((1/((n : ℝ)+1) : ℝ) : ℂ) • (R * (regularDomainCut B M (1/((n : ℝ)+1))).val) := by\r\n    have hh := regularDomainCut_inverse_product B M (1/((n : ℝ)+1)) 1 (by positivity) (by norm_num)\r\n    simp only [regularDomainCut,Complex.ofReal_one,one_smul,regularInverseGeneratorCutoff_one] at hh\r\n    change regularInverseGeneratorCutoff B (1/((n : ℝ)+1)) * (1-R) =\r\n      R - ((1/((n : ℝ)+1) : ℝ) : ℂ) •\r\n        (R * regularInverseGeneratorCutoff B (1/((n : ℝ)+1))) at hh\r\n    change (1-(1-((1/((n : ℝ)+1) : ℝ) : ℂ) •\r\n      regularInverseGeneratorCutoff B (1/((n : ℝ)+1)))) * (1-R) = _\r\n    rw [sub_sub_cancel,smul_mul_assoc,hh]\r\n    change _ = ((1/((n : ℝ)+1) : ℝ) : ℂ) •\r\n      (R * (1-((1/((n : ℝ)+1) : ℝ) : ℂ) • regularInverseGeneratorCutoff B (1/((n : ℝ)+1))))\r\n    rw [mul_sub,mul_one,mul_smul_comm]\r\n  have he : Equicontinuous (fun n : ℕ => (D n : _ → _)) := by\r\n    apply UniformEquicontinuous.equicontinuous\r\n    apply LipschitzWith.uniformEquicontinuous _ 1\r\n    intro n\r\n    apply LipschitzWith.of_dist_le_mul\r\n    intro x y\r\n    simpa only [dist_eq_norm,← map_sub,NNReal.coe_one,one_mul] using\r\n      (ContinuousLinearMap.le_opNorm (D n) (x-y)).trans\r\n        (mul_le_mul_of_nonneg_right (hnD n) (norm_nonneg (x-y)))\r\n  have hz : ∀ x, Tendsto (fun n => D n x) atTop (𝓝 0) := by\r\n    intro x\r\n    refine hd.induction ?_ (he.isClosed_setOf_tendsto continuous_const) x\r\n    rintro _ ⟨y,rfl⟩\r\n    have hb (n : ℕ) : ‖D n (S y)‖ ≤ (1/((n : ℝ)+1))*‖y‖ := by\r\n      change ‖(D n*S) y‖ ≤ _\r\n      rw [heq]\r\n      simp only [smul_apply,norm_smul,Complex.norm_real,Real.norm_eq_abs,\r\n        abs_of_pos (show 0 < 1/((n : ℝ)+1) by positivity),mul_apply_eq_comp]\r\n      apply mul_le_mul_of_nonneg_left _ (by positivity)\r\n      exact (ContinuousLinearMap.le_opNorm R _).trans\r\n        ((mul_le_mul_of_nonneg_right hnR (norm_nonneg _)).trans (by\r\n          simpa only [one_mul] using (ContinuousLinearMap.le_opNorm _ y).trans\r\n            (mul_le_mul_of_nonneg_right (hnq n) (norm_nonneg y))))\r\n    apply tendsto_zero_iff_norm_tendsto_zero.mpr\r\n    exact squeeze_zero (fun n => norm_nonneg _) hb\r\n      (by simpa only [zero_mul] u