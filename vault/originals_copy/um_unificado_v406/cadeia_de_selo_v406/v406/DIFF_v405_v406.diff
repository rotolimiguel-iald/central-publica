+    'TGLExt/F1Fecho394/RegularConjugationAmbientR2.lean': 'import TGLExt.F1Fecho394.RegularRightActionR2\r\nimport TGLExt.V350DualOrbitRepresentation\r\n/-! The actual regular-conjugation candidate reduces to the base unitary\r\nflow on the physical fibre. This is an algebraic identity, not yet its\r\nidentification with the modular imaginary powers of the weight. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1300000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularConjugationAmbient\r\nopen TGLV350.Regular MeasureTheory\r\nopen F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B : UnitaryFlow H)\r\ntheorem phase_comm (s t : ℝ) : characterPhase s t=characterPhase t s := by\r\n  unfold characterPhase\r\n  congr 1\r\n  ring\r\n\r\ntheorem dualOrbit_regular (t : ℝ) :\r\n    dualOrbitRepresentation (regularUnitary B t) =\r\n      characterMultiplier t * fibre (regularUnitary B t) := by\r\n  ext1 f\r\n  apply Lp.ext\r\n  filter_upwards [operatorFieldLift_ae (dualIntegralFamily (regularUnitary B t)) f,\r\n    characterMultiplier_ae t (fibre (regularUnitary B t) f),\r\n    fibre_ae (regularUnitary B t) f] with s h1 h2 h3\r\n  change operatorFieldLift (dualIntegralFamily (regularUnitary B t)) f s =\r\n    characterMultiplier t (fibre (regularUnitary B t) f) s\r\n  rw [h1,h2,h3]\r\n  change dualAmbient s (regularUnitary B t) (f s) = _\r\n  rw [dual_on_regular B s t]\r\n  change characterPhase s t • regularUnitary B t (f s) = _\r\n  rw [phase_comm s t]\r\n  rfl\r\n\r\ntheorem regular_conjugation_is_base_fibre (t : ℝ) :\r\n    dualOrbitRepresentation (regularUnitary B t) *\r\n      F1Fecho.RegularRightAction.ambient (H:=H) (-t) =\r\n        fibre (fibre (boostCLM B t)) := by\r\n  rw [dualOrbit_regular B t]\r\n  unfold F1Fecho.RegularRightAction.ambient\r\n  calc\r\n    _ = characterMultiplier t * (fibre (regularUnitary B t) * characterMultiplier (-t)) *\r\n        fibre (shift (-t)) := by simp only [mul_assoc]\r\n    _ = (characterMultiplier t * characterMultiplier (-t)) *\r\n        (fibre (regularUnitary B t) * fibre (shift (-t))) := by\r\n      rw [← characterMultiplier_commutes_fibre]\r\n      simp only [mul_assoc]\r\n    _ = fibre (regularUnitary B t * shift (-t)) := by\r\n      rw [characterMultiplier_mul,add_neg_cancel,characterMultiplier_zero,one_mul,← fibre_mul]\r\n    _ = _ := by\r\n      congr 1\r\n      simp only [F1Fecho.RegularCovariantCore.regularUnitary,mul_assoc,shift_mul,add_neg_cancel,shift_zero,mul_one]\r\nend F1Fecho.RegularConjugationAmbient\r\n#print axioms F1Fecho.RegularConjugationAmbient.dualOrbit_regular\r\n#print axioms F1Fecho.RegularConjugationAmbient.regular_conjugation_is_base_fibre\r\n',
+    'TGLExt/F1Fecho394/RegularConjugationContinuityR1.lean': 'import TGLExt.F1Fecho394.RegularConjugationAmbientR2\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularConjugationAmbient\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem base_fibre_strongly_continuous (B : UnitaryFlow H)\r\n    (z : RegularHilbert (RegularHilbert H)) :\r\n    Continuous (fun t : ℝ => fibre (fibre (boostCLM B t)) z) := by\r\n  have hin (v : RegularHilbert H) :\r\n      Continuous (fun t : ℝ => fibreIsometry ((boostIso B t).toLinearIsometry) v) :=\r\n    fibre_strongly_continuous (fun t => (boostIso B t).toLinearIsometry)\r\n      (boostIso_strong B) v\r\n  have hout := fibre_strongly_continuous\r\n    (fun t => fibreIsometry ((boostIso B t).toLinearIsometry)) hin z\r\n  exact hout\r\nend F1Fecho.RegularConjugationAmbient\r\n#print axioms F1Fecho.RegularConjugationAmbient.base_fibre_strongly_continuous\r\n',
+    'TGLExt/F1Fecho394/RegularCoreConjugationR1.lean': 'import TGLExt.F1Fecho394.RegularCoreFixedR3\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularCoreConjugation\r\nopen TGLV350.Regular\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem regular_conjugation_eq_fibre (B : F1Fecho.RegularCovariantCore.UnitaryFlow H) (M : VonNeumannAlgebra H) (t : ℝ)\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A ∈ F1Fecho.RegularCovariantCore.core B M) :\r\n    star (F1Fecho.RegularCovariantCore.regularUnitary B t) * A * F1Fecho.RegularCovariantCore.regularUnitary B t =\r\n      star (fibre (F1Fecho.RegularCovariantCore.boostCLM B t)) * A *\r\n      fibre (F1Fecho.RegularCovariantCore.boostCLM B t) := by\r\n  have hs : shift (-t) * A = A * shift (-t) :=\r\n    ((VonNeumannAlgebra.mem_commutant_iff.mp\r\n      (F1Fecho.RegularCoreFixed.shift_mem_regularCommutant B M (-t))) A hA).symm\r\n  rw [F1Fecho.RegularCovariantCore.regular_star]\r\n  unfold F1Fecho.RegularCovariantCore.regularUnitary\r\n  rw [← fibre_star,F1Fecho.RegularCovariantCore.boostCLM_star]\r\n  calc\r\n    _ = fibre (F1Fecho.RegularCovariantCore.boostCLM B (-t)) * (shift (-t) * A) *\r\n        (fibre (F1Fecho.RegularCovariantCore.boostCLM B t) * shift t) := by simp only [mul_assoc]\r\n    _ = fibre (F1Fecho.RegularCovariantCore.boostCLM B (-t)) * A *\r\n        (shift (-t) * fibre (F1Fecho.RegularCovariantCore.boostCLM B t)) * shift t := by\r\n      rw [hs]\r\n      simp only [mul_assoc]\r\n    _ = (fibre (F1Fecho.RegularCovariantCore.boostCLM B (-t)) * A *\r\n         fibre (F1Fecho.RegularCovariantCore.boostCLM B t)) * (shift (-t) * shift t) := by\r\n      rw [shift_commutes_fibre (-t) (F1Fecho.RegularCovariantCore.boostCLM B t)]\r\n      simp only [mul_assoc]\r\n    _ = _ := by rw [shift_mul (H := H) (-t) t, neg_add_cancel, shift_zero, mul_one]\r\n\r\n\r\nend F1Fecho.RegularCoreConjugation\r\nopen Lean in\r\nrun_cmd do\r\n  let env ← Elab.Command.liftCoreM getEnv\r\n  for (n, ci) in env.constants.map₂.toList do\r\n    if (`F1Fecho.RegularCoreConjugation).isPrefixOf n then\r\n      let axs ← collectAxioms n\r\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\r\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\r\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\r\n      match ci with\r\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\r\n      | _ => pure ()\r\n',
+    'TGLExt/F1Fecho394/RegularDualGNSActionR1.lean': 'import TGLExt.F1Fecho394.RegularScalarGNSActionR2\r\nimport TGLExt.V350DualOrbitRepresentation\r\n/-! A definitional bridge between the existing two names for the same\r\nambient dual representation, before specializing the large concrete Fock. -/\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.RegularDualGNSAction\r\nopen TGLV350.Regular F1Fecho.RegularScalarGNS F1Fecho.RegularScalarGNSAction\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem ambient_eq (D : Context H) (A : D.algebra.toStarSubalgebra) :\r\n    scalarGNSAmbientAction D A=dualOrbitRepresentation A.val := rfl\r\ntheorem dual_preserves (D : Context H)\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A∈D.algebra)\r\n    (v : RegularHilbert (RegularHilbert H)) (hv : v∈GNSSubspace D) :\r\n    dualOrbitRepresentation A v∈GNSSubspace D :=\r\n  scalarGNSAmbientAction_preserves D ⟨A,hA⟩ v hv\r\nend F1Fecho.RegularDualGNSAction\r\n#print axioms F1Fecho.RegularDualGNSAction.ambient_eq\r\n#print axioms F1Fecho.RegularDualGNSAction.dual_preserves\r\n',
+    'TGLExt/F1Fecho394/RegularDualOrbitGeneratedR2.lean': "import TGLExt.V350DualOrbitVonNeumann\r\nimport TGLExt.V350FibreSlices\r\n/-! Star-bicommutant transport for the already concrete dual-orbit representation. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 2\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularDualOrbitGenerated\r\nopen TGLV350.Regular\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem dualOrbit_generated_mem (S : Set (RegularHilbert H →L[ℂ] RegularHilbert H))\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A ∈ generatedAlgebra S) :\r\n    dualOrbitRepresentation A ∈ generatedAlgebra ((dualOrbitRepresentation (H:=H)) '' S) := by\r\n  have hf := fibre_generated_mem S A hA\r\n  have ht := generated_transport (dualOrbitConjugation (H:=H)) (fibre '' S) (fibre A)\r\n  rw [dualOrbitConjugation_fibre] at ht\r\n  have he : dualOrbitConjugation (H:=H) '' (fibre '' S) = (dualOrbitRepresentation (H:=H)) '' S := by\r\n    rw [Set.image_image]\r\n    congr 1\r\n    funext x\r\n    exact dualOrbitConjugation_fibre x\r\n  rw [he] at ht\r\n  exact ht.mpr hf\r\n\r\ntheorem dualOrbit_commutes_of_generators\r\n    (S : Set (RegularHilbert H →L[ℂ] RegularHilbert H))\r\n    (Q : RegularHilbert (RegularHilbert H) →L[ℂ] RegularHilbert (RegularHilbert H))\r\n    (hQ : Q ∈ StarSubalgebra.centralizer ℂ ((dualOrbitRepresentation (H:=H)) '' S))\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A ∈ generatedAlgebra S) :\r\n    dualOrbitRepresentation A * Q = Q * dualOrbitRepresentation A := by\r\n  have h := dualOrbit_generated_mem S A hA\r\n  change dualOrbitRepresentation A ∈ StarSubalgebra.centralizer ℂ\r\n    ((StarSubalgebra.centralizer ℂ ((dualOrbitRepresentation (H:=H)) '' S)) : Set _) at h\r\n  exact ((StarSubalgebra.mem_centralizer_iff ℂ).mp h Q hQ).1.symm\r\n\r\nend F1Fecho.RegularDualOrbitGenerated\r\n#print axioms F1Fecho.RegularDualOrbitGenerated.dualOrbit_generated_mem\r\n#print axioms F1Fecho.RegularDualOrbitGenerated.dualOrbit_commutes_of_generators\r\n",
+    'TGLExt/F1Fecho394/RegularFibreAverageStarR3.lean': 'import TGLExt.F1Fecho394.RegularAverageAdjointR4\r\nimport TGLExt.F1Fecho394.RegularFiniteFibreRightR3\r\nimport TGLExt.F1Fecho394.RegularCoreFiniteWeightR3\r\n/-! Finite adjunction pairs with base coefficients in the same regular core.\r\nTheir existence will supply the interval graph core; no modular identity is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularFibreAverageStar\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem fibre_average_star (B : UnitaryFlow H) (A : H→L[ℂ]H) (h : ℝ) :\r\n    star (fibre A*RegularCoreAverage.regularAverage B h)=\r\n      regularUnitary B (-h)*(RegularCoreAverage.regularAverage B h*fibre (star A)) := by\r\n  rw [star_mul,RegularAverageAdjoint.regularAverage_star,←fibre_star,mul_assoc]\r\n\r\ntheorem fibre_average_finite (B : UnitaryFlow H) (A : H→L[ℂ]H)\r\n    (h : ℝ) (hh : 0<h) :\r\n    HasFiniteDualSquare (fibre A*RegularCoreAverage.regularAverage B h) ∧\r\n      HasFiniteDualSquare (star (fibre A*RegularCoreAverage.regularAverage B h)) := by\r\n  constructor\r\n  · exact HasFiniteDualSquare.left_mul _ _\r\n      (RegularCoreFiniteWeight.regularAverage_hasFiniteDualSquare B h hh)\r\n  · rw [fibre_average_star]\r\n    exact HasFiniteDualSquare.left_mul _ _\r\n      (RegularFiniteFibreRight.right_fibre _\r\n        (RegularCoreFiniteWeight.regularAverage_hasFiniteDualSquare B h hh) (star A))\r\n\r\ntheorem fibre_average_mem (B : UnitaryFlow H) (M : VonNeumannAlgebra H)\r\n    (A : H→L[ℂ]H) (hA : A∈M) (h : ℝ) :\r\n    fibre A*RegularCoreAverage.regularAverage B h∈core B M :=\r\n  (core B M).mul_mem (fibre_mem B M A hA) (RegularCoreAverage.regularAverage_mem B M h)\r\n\r\nend F1Fecho.RegularFibreAverageStar\r\n#print axioms F1Fecho.RegularFibreAverageStar.fibre_average_star\r\n#print axioms F1Fecho.RegularFibreAverageStar.fibre_average_finite\r\n#print axioms F1Fecho.RegularFibreAverageStar.fibre_average_mem\r\n',
+    'TGLExt/F1Fecho394/RegularFiniteFibreRightR3.lean': "import TGLExt.V350DualSemifiniteIdeal\r\nimport TGLExt.V350DualFormTransport\r\n/-! Right multiplication by a base fibre preserves the existing uniform\r\nfinite-square ideal. Arbitrary right multiplication is not asserted. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularFiniteFibreRight\r\nopen TGLV350.Regular\r\nopen scoped ENNReal NNReal\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem right_fibre (A : RegularHilbert H→L[ℂ]RegularHilbert H)\r\n    (hA : HasFiniteDualSquare A) (B : H→L[ℂ]H) :\r\n    HasFiniteDualSquare (A*fibre B) := by\r\n  obtain ⟨C,hC⟩ := hA\r\n  refine ⟨C*‖fibre B‖₊^2,fun v=>?_⟩\r\n  have he : star (A*fibre B)*(A*fibre B)=star (fibre B)*(star A*A)*fibre B := by\r\n    rw [star_mul]\r\n    noncomm_ring\r\n  rw [he,dualQuadraticIntegral_bimodule]\r\n  calc\r\n    _ ≤ (C : ℝ≥0∞)*ENNReal.ofReal (‖fibre B v‖^2) := hC _\r\n    _ ≤ (C : ℝ≥0∞)*ENNReal.ofReal (‖fibre B‖^2*‖v‖^2) := by\r\n      apply mul_le_mul' le_rfl\r\n      apply ENNReal.ofReal_le_ofReal\r\n      rw [←mul_pow]\r\n      exact pow_le_pow_left₀ (norm_nonneg _) (ContinuousLinearMap.le_opNorm _ _) 2\r\n    _ = _ := by\r\n      rw [ENNReal.ofReal_mul (sq_nonneg _)]\r\n      simp [ENNReal.ofReal_pow,ofReal_norm,enorm_eq_nnnorm,mul_assoc]\r\nend F1Fecho.RegularFiniteFibreRight\r\n#print axioms F1Fecho.RegularFiniteFibreRight.right_fibre\r\n",
+    'TGLExt/F1Fecho394/RegularFourierFibreR1.lean': 'import Mathlib.Analysis.Fourier.LpSpace\r\nimport TGLExt.V350L2OperatorLift\r\n/-! Naturality of the existing vector-valued Fourier L2 equivalence under\r\nbounded complex-linear fibre maps. No Fourier integral is assigned to arbitrary L2 vectors. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 900000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularFourierFibre\r\nopen TGLV350.Regular MeasureTheory FourierTransform SchwartzMap Filter\r\nopen scoped FourierTransform ENNReal\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem fourier_integral (C : H →L[ℂ] H) (f : ℝ → H) (hf : Integrable f) (ξ : ℝ) :\r\n    𝓕 (fun r => C (f r)) ξ = C (𝓕 f ξ) := by\r\n  rw [Real.fourier_eq,Real.fourier_eq]\r\n  have hi := (Real.fourierIntegral_convergent_iff ξ).mpr hf\r\n  rw [← C.integral_comp_comm hi]\r\n  apply integral_congr_ae\r\n  filter_upwards [] with r\r\n  simp only [Circle.smul_def,map_smul]\r\n\r\ntheorem fibre_schwartz (C : H →L[ℂ] H) (f : 𝓢(ℝ,H)) :\r\n    fibre C (f.toLp 2) = (f.postcompCLM (C.restrictScalars ℝ)).toLp 2 := by\r\n  apply Lp.ext\r\n  filter_upwards [fibre_ae C (f.toLp 2),f.coeFn_toLp 2,\r\n    (f.postcompCLM (C.restrictScalars ℝ)).coeFn_toLp 2] with r h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  rfl\r\n\r\ntheorem fourier_fibre_schwartz (C : H →L[ℂ] H) (f : 𝓢(ℝ,H)) :\r\n    𝓕 (fibre C (f.toLp 2)) = fibre C (𝓕 (f.toLp 2)) := by\r\n  rw [fibre_schwartz,SchwartzMap.toLp_fourier_eq,SchwartzMap.toLp_fourier_eq]\r\n  apply Lp.ext\r\n  filter_upwards [(𝓕 (f.postcompCLM (C.restrictScalars ℝ))).coeFn_toLp 2,\r\n    fibre_ae C ((𝓕 f).toLp 2),(𝓕 f).coeFn_toLp 2] with r h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  change 𝓕 (fun x => C (f x)) r = C (𝓕 (f : ℝ → H) r)\r\n  exact fourier_integral C f f.integrable r\r\n\r\ntheorem fourier_fibre (C : H →L[ℂ] H) (f : RegularHilbert H) :\r\n    Lp.fourierTransformₗᵢ ℝ H (fibre C f) =\r\n      fibre C (Lp.fourierTransformₗᵢ ℝ H f) := by\r\n  let p : RegularHilbert H → Prop := fun g =>\r\n    Lp.fourierTransformₗᵢ ℝ H (fibre C g) = fibre C (Lp.fourierTransformₗᵢ ℝ H g)\r\n  apply DenseRange.induction_on (p := p)\r\n    (SchwartzMap.denseRange_toLpCLM (E := ℝ) (F := H) (p := 2) ENNReal.ofNat_ne_top) f\r\n  · exact isClosed_eq\r\n      ((Lp.fourierTransformₗᵢ ℝ H).continuous.comp (fibre C).continuous)\r\n      ((fibre C).continuous.comp (Lp.fourierTransformₗᵢ ℝ H).continuous)\r\n  intro g\r\n  exact fourier_fibre_schwartz C g\r\n\r\nend F1Fecho.RegularFourierFibre\r\n#print axioms F1Fecho.RegularFourierFibre.fourier_integral\r\n#print axioms F1Fecho.RegularFourierFibre.fibre_schwartz\r\n#print axioms F1Fecho.RegularFourierFibre.fourier_fibre_schwartz\r\n#print axioms F1Fecho.RegularFourierFibre.fourier_fibre\r\n',
+    'TGLExt/F1Fecho394/RegularIntervalVectorsR2.lean': 'import TGLExt.F1Fecho394.RegularSpectralAverageR6\r\nimport TGLExt.F1Fecho394.LpIntervalTotalityR3\r\n/-! Elementary interval vectors for the already constructed regular\r\nrepresentation. These identities supply concrete coefficient generators. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 600000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularIntervalVectors\r\nopen MeasureTheory Filter TGLV350.Regular\r\nopen F1Fecho.RegularSpectralAverage F1Fecho.LpIntervalTotality\r\nopen F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem intervalVector_ae (a b : ℝ) (v : H) :\r\n    intervalVector a b v =ᵐ[volume] (Set.Ioc a b).indicator (fun _ : ℝ => v) :=\r\n  indicatorConstLp_coeFn\r\n\r\ntheorem coefficient_interval (h : ℝ) (v : H) : coefficient h v=intervalVector 0 h v := by\r\n  apply Lp.ext\r\n  exact (coefficient_ae h v).trans (intervalVector_ae 0 h v).symm\r\n\r\ntheorem fibre_interval (A : H →L[ℂ] H) (a b : ℝ) (v : H) :\r\n    fibre A (intervalVector a b v)=intervalVector a b (A v) := by\r\n  apply Lp.ext\r\n  filter_upwards [fibre_ae A (intervalVector a b v),intervalVector_ae a b v,\r\n    intervalVector_ae a b (A v)] with x h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  by_cases hx : x ∈ Set.Ioc a b\r\n  · simp only [Set.indicator_of_mem hx]\r\n  · simp only [Set.indicator_of_notMem hx,map_zero]\r\n\r\ntheorem shift_coefficient (a b : ℝ) (v : H) :\r\n    shift a (coefficient (b-a) v)=intervalVector a b v := by\r\n  apply Lp.ext\r\n  filter_upwards [shift_ae a (coefficient (b-a) v),\r\n    (measurePreserving_sub_right volume a).quasiMeasurePreserving.ae (coefficient_ae (b-a) v),\r\n    intervalVector_ae a b v] with x h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  have hx : x-a ∈ Set.Ioc 0 (b-a) ↔ x ∈ Set.Ioc a b := by\r\n    simp only [Set.mem_Ioc]\r\n    constructor <;> intro h <;> constructor <;> linarith [h.1,h.2]\r\n  by_cases hm : x ∈ Set.Ioc a b\r\n  · simp only [Set.indicator_of_mem hm,Set.indicator_of_mem (hx.mpr hm)]\r\n  · simp only [Set.indicator_of_notMem hm,Set.indicator_of_notMem (fun h => hm (hx.mp h))]\r\n\r\ntheorem regular_coefficient (B : UnitaryFlow H) (v : H) (hv : ∀ t, B.U t v=v)\r\n    (a b : ℝ) : RegularCovariantCore.regularUnitary B a (coefficient (b-a) v)=\r\n      intervalVector a b v := by\r\n  change fibre (boostCLM B a) (shift a (coefficient (b-a) v)) = _\r\n  rw [shift_coefficient,fibre_interval]\r\n  change intervalVector a b (B.U a v)=_\r\n  rw [hv]\r\n\r\ntheorem intervalVector_of_ge (a b : ℝ) (v : H) (hab : b≤a) : intervalVector a b v=0 := by\r\n  apply Lp.ext\r\n  filter_upwards [intervalVector_ae a b v, Lp.coeFn_zero H 2 (volume : Measure ℝ)] with t h1 h2\r\n  rw [h1,h2]\r\n  simp [Set.Ioc_eq_empty (not_lt_of_ge hab)]\r\n\r\nend F1Fecho.RegularIntervalVectors\r\n#print axioms F1Fecho.RegularIntervalVectors.intervalVector_ae\r\n#print axioms F1Fecho.RegularIntervalVectors.coefficient_interval\r\n#print axioms F1Fecho.RegularIntervalVectors.fibre_interval\r\n#print axioms F1Fecho.RegularIntervalVectors.shift_coefficient\r\n#print axioms F1Fecho.RegularIntervalVectors.regular_coefficient\r\n#print axioms F1Fecho.RegularIntervalVectors.intervalVector_of_ge\r\n',
+    'TGLExt/F1Fecho394/RegularL2RescaleR4.lean': "import TGLExt.V350FourierL1L2\r\nimport Mathlib.MeasureTheory.Measure.Haar.NormedSpace\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 900000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularL2Rescale\r\nopen MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nabbrev LH := Lp (α := ℝ) H 2 volume\r\n\r\ntheorem div_qmp (c : ℝ) (hc : 0 < c) :\r\n    Measure.QuasiMeasurePreserving (fun x : ℝ => x / c) volume volume := by\r\n  simpa only [smul_eq_mul,div_eq_mul_inv,mul_comm] using\r\n    (Measure.quasiMeasurePreserving_smul (volume : Measure ℝ) (inv_ne_zero hc.ne'))\r\n\r\ntheorem rescale_memLp (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) :\r\n    MemLp (fun x : ℝ => ((Real.sqrt c)⁻¹ : ℝ) • f (x/c)) 2 volume := by\r\n  have hm := (Lp.memLp f).1.comp_quasiMeasurePreserving (div_qmp c hc)\r\n  have hi := ((memLp_two_iff_integrable_sq_norm (Lp.memLp f).1).mp (Lp.memLp f)).comp_div hc.ne'\r\n  exact ((memLp_two_iff_integrable_sq_norm hm).mpr hi).const_smul ((Real.sqrt c)⁻¹ : ℝ)\r\n\r\ndef rescale (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) : LH (H:=H) :=\r\n  (rescale_memLp c hc f).toLp (fun x : ℝ => ((Real.sqrt c)⁻¹ : ℝ) • f (x/c))\r\n\r\ntheorem rescale_ae (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) :\r\n    rescale c hc f =ᵐ[volume] fun x : ℝ => ((Real.sqrt c)⁻¹ : ℝ) • f (x/c) :=\r\n  (rescale_memLp c hc f).coeFn_toLp\r\n\r\ntheorem rescale_norm_sq (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) :\r\n    ‖rescale c hc f‖^2 = ‖f‖^2 := by\r\n  rw [← TGLV350.Fourier.L2_integral_norm_sq,← TGLV350.Fourier.L2_integral_norm_sq]\r\n  calc\r\n    (∫ x : ℝ, ‖rescale c hc f x‖^2) =\r\n        (Real.sqrt c)⁻¹^2 * (∫ x : ℝ, ‖f (x/c)‖^2) := by\r\n      rw [← integral_const_mul]\r\n      apply integral_congr_ae\r\n      filter_upwards [rescale_ae c hc f] with x hx\r\n      rw [hx,norm_smul,mul_pow,Real.norm_eq_abs,sq_abs]\r\n    _ = _ := by\r\n      have hd := Measure.integral_comp_div (fun x : ℝ => ‖f x‖^2) c\r\n      rw [hd,abs_of_pos hc,smul_eq_mul]\r\n      have hs : (Real.sqrt c)^2 = c := Real.sq_sqrt hc.le\r\n      have hn : Real.sqrt c ≠ 0 := ne_of_gt (Real.sqrt_pos.2 hc)\r\n      field_simp\r\n      rw [hs]\r\n\r\ntheorem rescale_norm (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) :\r\n    ‖rescale c hc f‖ = ‖f‖ := by\r\n  nlinarith [rescale_norm_sq c hc f,norm_nonneg (rescale c hc f),norm_nonneg f]\r\n\r\ndef rescaleIsometry (c : ℝ) (hc : 0 < c) : LH (H:=H) →ₗᵢ[ℂ] LH (H:=H) where\r\n  toFun := rescale c hc\r\n  map_add' f g := by\r\n    apply Lp.ext\r\n    filter_upwards [rescale_ae c hc (f+g),rescale_ae c hc f,rescale_ae c hc g,\r\n      Lp.coeFn_add (rescale c hc f) (rescale c hc g),\r\n      (div_qmp c hc).ae (Lp.coeFn_add f g)] with x h1 h2 h3 h4 h5\r\n    simp only [Pi.add_apply] at h4 h5\r\n    rw [h1,h4,h2,h3,h5,smul_add]\r\n  map_smul' z f := by\r\n    apply Lp.ext\r\n    filter_upwards [rescale_ae c hc (z • f),rescale_ae c hc f,\r\n      Lp.coeFn_smul z (rescale c hc f),(div_qmp c hc).ae (Lp.coeFn_smul z f)] with x h1 h2 h3 h4\r\n    simp only [Pi.smul_apply] at h3 h4\r\n    simp only [RingHom.id_apply]\r\n    rw [h1,h3,h2,h4,smul_comm]\r\n  norm_map' := rescale_norm c hc\r\n\r\ntheorem rescale_inverse (c : ℝ) (hc : 0 < c) (f : LH (H:=H)) :\r\n    rescale c hc (rescale c⁻¹ (inv_pos.2 hc) f) = f := by\r\n  apply Lp.ext\r\n  filter_upwards [rescale_ae c hc (rescale c⁻¹ (inv_pos.2 hc) f),\r\n    (div_qmp c hc).ae (rescale_ae c⁻¹ (inv_pos.2 hc) f)] with x h1 h2\r\n  rw [h1,h2,smul_smul]\r\n  have hm : (Real.sqrt c)⁻¹ * (Real.sqrt c⁻¹)⁻¹ = 1 := by\r\n    rw [Real.sqrt_inv,inv_inv,inv_mul_cancel₀ (ne_of_gt (Real.sqrt_pos.2 hc))]\r\n  rw [hm,one_smul]\r\n  congr 1\r\n  field_simp\r\n\r\ndef rescaleEquiv (c : ℝ) (hc : 0 < c) : LH (H:=H) ≃ₗᵢ[ℂ] LH (H:=H) where\r\n  toFun := rescale c hc\r\n  map_add' := (rescaleIsometry c hc).map_add\r\n  map_smul' := (rescaleIsometry c hc).map_smul\r\n  norm_map' := rescale_norm c hc\r\n  invFun := rescale c⁻¹ (inv_pos.2 hc)\r\n  left_inv f := by\r\n    simpa only [inv_inv] using rescale_inverse c⁻¹ (inv_pos.2 hc) f\r\n  right_inv := rescale_inverse c hc\r\n\r\nend F1Fecho.RegularL2Rescale\r\n#print axioms F1Fecho.RegularL2Rescale.div_qmp\r\n#print axioms F1Fecho.RegularL2Rescale.rescale_memLp\r\n#print axioms F1Fecho.RegularL2Rescale.rescale_ae\r\n#print axioms F1Fecho.RegularL2Rescale.rescale_norm_sq\r\n#print axioms F1Fecho.RegularL2Rescale.rescale_norm\r\n#print axioms F1Fecho.RegularL2Rescale.rescaleIsometry\r\n\r\n#print axioms F1Fecho.RegularL2Rescale.rescale_inverse\r\n#print axioms F1Fecho.RegularL2Rescale.rescaleEquiv\r\n",
+    'TGLExt/F1Fecho394/RegularMaxwellEnergyR2.lean': "import TGLExt.F1Fecho394.RegularMaxwellProfilesR3\r\nimport TGLExt.F1Fecho394.SchwartzRestrictionSquareMomentsR1\r\n\r\n/-! A concrete common regular domain with both L1 and quadratic L2 energy\r\nmoments. These are proved for the actual Schwartz-to-photon map. This supplies\r\nfinite one-particle kinetic energy, not a Maxwell stress/charge identity. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen MeasureTheory Filter\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\nopen F1Fecho.SchwartzRestriction\r\nopen scoped ENNReal\r\n\r\ndef EnergySquareProfile (h : H1) : Prop :=\r\n  ∀ m : ℕ,Integrable (fun y=>shellEnergy y^m*‖h y‖^2) (orbitalMeasure 0)\r\n\r\ndef StrongRegularProfile (h : H1) : Prop := RegularProfile h ∧ EnergySquareProfile h\r\n\r\ntheorem shell_square_moment_integrable (f : SchwartzTensor) (m : ℕ) :\r\n    Integrable (fun y=>shellEnergy y^m*‖f (shellEmbedding y)‖^2) momentumMeasure := by\r\n  letI : momentumMeasure.IsAddHaarMeasure := by unfold momentumMeasure; infer_instance\r\n  exact energy_moment_square_restriction_integrable f shellEmbedding shellEnergy\r\n    (by norm_num : (0:ℝ)≤2) shellEmbedding_proper_bound energy_le_twice_coordinate_norm\r\n    shellEnergy_nonneg shellEmbedding_continuous.measurable shellEnergy_continuous.measurable m\r\n\r\ntheorem coefficient_square_moment_density_bound (f : SchwartzTensor) (m : ℕ)\r\n    (y : MomentumCoordinates) :\r\n    ‖(orbitalWeight 0 y).toReal • (shellEnergy y^m*‖globalCoefficient f y‖^2)‖≤\r\n      128*(shellEnergy y^(m+1)*‖f (shellEmbedding y)‖^2) := by\r\n  have hp:=shellEnergy_nonneg y\r\n  have hw : (orbitalWeight 0 y).toReal=1/shellEnergy y := by\r\n    unfold orbitalWeight shellEnergy\r\n    exact ENNReal.toReal_ofReal (by positivity)\r\n  rw [hw,smul_eq_mul,Real.norm_of_nonneg\r\n    (mul_nonneg (div_nonneg zero_le_one hp) (mul_nonneg (pow_nonneg hp _) (sq_nonneg _)))]\r\n  by_cases hz : shellEnergy y=0\r\n  · simp [hz]\r\n  · calc\r\n      _ ≤ (1/shellEnergy y)*(shellEnergy y^m*\r\n          (128*shellEnergy y^2*‖f (shellEmbedding y)‖^2)) :=\r\n        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left\r\n          (globalCoefficient_sq_bound f y) (pow_nonneg hp _)) (div_nonneg zero_le_one hp)\r\n      _ = _ := by rw [pow_succ]; field_simp [hz]; ring\r\n\r\ntheorem momentumSmear_energySquare (f : SchwartzTensor) :\r\n    EnergySquareProfile (momentumSmearCLM f) := by\r\n  intro m\r\n  have hi : Integrable (fun y=>shellEnergy y^m*‖globalCoefficient f y‖^2) (orbitalMeasure 0) := by\r\n    change Integrable _ (momentumMeasure.withDensity (orbitalWeight 0))\r\n    apply (integrable_withDensity_iff_integrable_smul' (orbitalWeight_measurable 0)\r\n      (Filter.Eventually.of_forall (fun y=>ENNReal.ofReal_lt_top))).mpr\r\n    apply ((shell_square_moment_integrable f (m+1)).const_mul 128).mono'\r\n    · exact (((orbitalWeight_measurable 0).ennreal_toReal).mul\r\n        ((shellEnergy_continuous.measurable.pow_const m).mul\r\n          ((globalCoefficient_measurable f).norm.pow_const 2))).aestronglyMeasurable\r\n    · exact Filter.Eventually.of_forall (coefficient_square_moment_density_bound f m)\r\n  apply hi.congr\r\n  filter_upwards [(globalCoefficient_memLp f).coeFn_toLp] with y hy\r\n  change shellEnergy y^m*‖globalCoefficient f y‖^2= shellEnergy y^m*‖momentumSmear f y‖^2\r\n  unfold momentumSmear\r\n  rw [hy]\r\n\r\ntheorem physicalSmear_strongRegular (f : SchwartzTensor) :\r\n    StrongRegularProfile (physicalSmearCLM f) :=\r\n  ⟨physicalSmear_regular f,momentumSmear_energySquare (physicalFourierCLM f)⟩\r\n\r\ntheorem energySquareProfile_zero : EnergySquareProfile (0:H1) := by\r\n  intro m\r\n  apply (integrable_zero _ _ _).congr\r\n  filter_upwards [Lp.coeFn_zero Fib 2 (orbitalMeasure 0)] with y hy\r\n  simp only [hy,norm_zero,zero_pow (by norm_num : (2:ℕ)≠0),mul_zero,Pi.zero_apply]\r\n\r\ntheorem strongRegularProfile_zero : StrongRegularProfile (0:H1) :=\r\n  ⟨regularProfile_zero,energySquareProfile_zero⟩\r\n\r\ntheorem exists_nonzero_strongRegularProfile : ∃ h : H1,StrongRegularProfile h ∧ h≠0 := by\r\n  obtain ⟨f,hf⟩:=exists_nonzero_real_physicalSmear\r\n  exact ⟨physicalSmearCLM f.val,physicalSmear_strongRegular f.val,hf⟩\r\n\r\ntheorem strongRegular_finite_energy (h : H1) (hh : StrongRegularProfile h) :\r\n    Integrable (fun y=>shellEnergy y*‖h y‖^2) (orbitalMeasure 0) := by\r\n  simpa only [pow_one] using hh.2 1\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.momentumSmear_energySquare\r\n#print axioms F1Fecho.MaxwellGlobal.physicalSmear_strongRegular\r\n#print axioms F1Fecho.MaxwellGlobal.strongRegularProfile_zero\r\n#print axioms F1Fecho.MaxwellGlobal.exists_nonzero_strongRegularProfile\r\n#print axioms F1Fecho.MaxwellGlobal.strongRegular_finite_energy\r\n",
+    'TGLExt/F1Fecho394/RegularMaxwellProfilesR3.lean': "import TGLExt.F1Fecho394.RegularMaxwellWaveDensityR3\r\nimport TGLExt.F1Fecho394.PhysicalSmearTranslationR2\r\n\r\n/-! A concrete regular one-particle domain, defined by all energy moments in\r\nL1 of the original mass-shell measure. Schwartz photon profiles are proved\r\nmembers. No regularity field is supplied to a Maxwell certificate. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen MeasureTheory Filter\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\nopen scoped ENNReal\r\n\r\ndef RegularProfile (h : H1) : Prop :=\r\n  ∀ m : ℕ,Integrable (fun y=>shellEnergy y^m*‖h y‖) (orbitalMeasure 0)\r\n\r\ntheorem globalCoefficient_norm_bound (f : SchwartzTensor) (y : MomentumCoordinates) :\r\n    ‖globalCoefficient f y‖≤16*shellEnergy y*‖f (shellEmbedding y)‖ := by\r\n  have hs:=globalCoefficient_sq_bound f y\r\n  have hp:=shellEnergy_nonneg y\r\n  have hf:=norm_nonneg (f (shellEmbedding y))\r\n  have hn:=norm_nonneg (globalCoefficient f y)\r\n  apply (sq_le_sq₀ hn (by positivity : 0≤16*shellEnergy y*‖f (shellEmbedding y)‖)).mp\r\n  nlinarith [sq_nonneg (shellEnergy y*‖f (shellEmbedding y)‖)]\r\n\r\ntheorem coefficient_moment_density_bound (f : SchwartzTensor) (m : ℕ) (y : MomentumCoordinates) :\r\n    ‖(orbitalWeight 0 y).toReal • (shellEnergy y^m*‖globalCoefficient f y‖)‖≤\r\n      16*(shellEnergy y^m*‖f (shellEmbedding y)‖) := by\r\n  have hp:=shellEnergy_nonneg y\r\n  have hw : (orbitalWeight 0 y).toReal=1/shellEnergy y := by\r\n    unfold orbitalWeight shellEnergy\r\n    exact ENNReal.toReal_ofReal (by positivity)\r\n  rw [hw,smul_eq_mul,Real.norm_of_nonneg\r\n    (mul_nonneg (div_nonneg zero_le_one hp) (mul_nonneg (pow_nonneg hp _) (norm_nonneg _)))]\r\n  by_cases hz : shellEnergy y=0\r\n  · simp only [hz,div_zero,zero_mul]\r\n    positivity\r\n  · calc\r\n      _ ≤ (1/shellEnergy y)*(shellEnergy y^m*(16*shellEnergy y*‖f (shellEmbedding y)‖)) :=\r\n        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left\r\n          (globalCoefficient_norm_bound f y) (pow_nonneg hp _)) (div_nonneg zero_le_one hp)\r\n      _ = _ := by field_simp [hz]\r\n\r\ntheorem momentumSmear_regular (f : SchwartzTensor) : RegularProfile (momentumSmearCLM f) := by\r\n  intro m\r\n  have hi : Integrable (fun y=>shellEnergy y^m*‖globalCoefficient f y‖) (orbitalMeasure 0) := by\r\n    change Integrable _ (momentumMeasure.withDensity (orbitalWeight 0))\r\n    apply (integrable_withDensity_iff_integrable_smul' (orbitalWeight_measurable 0)\r\n      (Filter.Eventually.of_forall (fun y=>ENNReal.ofReal_lt_top))).mpr\r\n    apply ((shell_moment_integrable f m).const_mul 16).mono'\r\n    · exact (((orbitalWeight_measurable 0).ennreal_toReal).mul\r\n        ((shellEnergy_continuous.measurable.pow_const m).mul (globalCoefficient_measurable f).norm)).aestronglyMeasurable\r\n    · exact Filter.Eventually.of_forall (coefficient_moment_density_bound f m)\r\n  apply hi.congr\r\n  filter_upwards [(globalCoefficient_memLp f).coeFn_toLp] with y hy\r\n  change shellEnergy y^m*‖globalCoefficient f y‖=shellEnergy y^m*‖momentumSmear f y‖\r\n  unfold momentumSmear\r\n  rw [hy]\r\n\r\ntheorem physicalSmear_regular (f : SchwartzTensor) : RegularProfile (physicalSmearCLM f) :=\r\n  momentumSmear_regular (physicalFourierCLM f)\r\n\r\ntheorem regularProfile_zero : RegularProfile (0:H1) := by\r\n  intro m\r\n  apply (integrable_zero _ _ _).congr\r\n  filter_upwards [Lp.coeFn_zero Fib 2 (orbitalMeasure 0)] with y hy\r\n  simp only [hy,norm_zero,mul_zero,Pi.zero_apply]\r\n\r\ntheorem exists_nonzero_regularProfile : ∃ h : H1,RegularProfile h ∧ h≠0 := by\r\n  obtain ⟨f,hf⟩:=exists_nonzero_real_physicalSmear\r\n  exact ⟨physicalSmearCLM f.val,physicalSmear_regular f.val,hf⟩\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.momentumSmear_regular\r\n#print axioms F1Fecho.MaxwellGlobal.physicalSmear_regular\r\