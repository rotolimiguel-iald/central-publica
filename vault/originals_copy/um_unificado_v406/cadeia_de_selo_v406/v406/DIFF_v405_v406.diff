+    'TGLExt/F1Fecho394/RealSchwartzTestsR1.lean': 'import TGLExt.F1Fecho394.SchwartzMaxwellContinuousR3\r\n\r\n/-! Real test tensors are a real subspace of the complex Schwartz test space.\r\nReal/imaginary projections and decomposition are explicit; no wedge-support\r\nor causal-locality conclusion follows from these algebraic identities. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen SchwartzMap\r\n\r\ndef tensorComponent (μ ν : Fin 4) : TensorValue →L[ℝ] ℂ :=\r\n  (ContinuousLinearMap.proj ν : (Fin 4→ℂ) →L[ℝ] ℂ).comp\r\n    (ContinuousLinearMap.proj μ)\r\n\r\ndef tensorRealPart : TensorValue →L[ℝ] TensorValue :=\r\n  ContinuousLinearMap.pi (fun μ => ContinuousLinearMap.pi (fun ν =>\r\n    (Complex.ofRealCLM.comp Complex.reCLM).comp (tensorComponent μ ν)))\r\n\r\ndef tensorImagPart : TensorValue →L[ℝ] TensorValue :=\r\n  ContinuousLinearMap.pi (fun μ => ContinuousLinearMap.pi (fun ν =>\r\n    (Complex.ofRealCLM.comp Complex.imCLM).comp (tensorComponent μ ν)))\r\n\r\ndef realPart (f : SchwartzTensor) : SchwartzTensor := SchwartzMap.postcompCLM tensorRealPart f\r\n\r\ndef imagPart (f : SchwartzTensor) : SchwartzTensor := SchwartzMap.postcompCLM tensorImagPart f\r\n\r\ndef IsRealTest (f : SchwartzTensor) : Prop := ∀ p μ ν,(f p μ ν).im=0\r\n\r\ntheorem realPart_apply (f : SchwartzTensor) (p : Spacetime) (μ ν : Fin 4) :\r\n    realPart f p μ ν=((f p μ ν).re:ℂ) := rfl\r\n\r\ntheorem imagPart_apply (f : SchwartzTensor) (p : Spacetime) (μ ν : Fin 4) :\r\n    imagPart f p μ ν=((f p μ ν).im:ℂ) := rfl\r\n\r\ntheorem realPart_real (f : SchwartzTensor) : IsRealTest (realPart f) := by\r\n  intro p μ ν\r\n  rw [realPart_apply]\r\n  exact Complex.ofReal_im _\r\n\r\ntheorem imagPart_real (f : SchwartzTensor) : IsRealTest (imagPart f) := by\r\n  intro p μ ν\r\n  rw [imagPart_apply]\r\n  exact Complex.ofReal_im _\r\n\r\ntheorem real_imag_decomposition (f : SchwartzTensor) : f=realPart f+Complex.I•imagPart f := by\r\n  ext p μ ν\r\n  change f p μ ν=realPart f p μ ν+Complex.I*imagPart f p μ ν\r\n  rw [realPart_apply,imagPart_apply,mul_comm Complex.I]\r\n  exact (Complex.re_add_im (f p μ ν)).symm\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.realPart_real\r\n#print axioms F1Fecho.MaxwellGlobal.imagPart_real\r\n#print axioms F1Fecho.MaxwellGlobal.real_imag_decomposition\r\n',
+    'TGLExt/F1Fecho394/RealSubspaceRegularizerUniquenessR2.lean': 'import Mathlib.Analysis.InnerProductSpace.Projection.Submodule\r\nimport Mathlib.Topology.Algebra.Module.Basic\r\nimport Mathlib.Tactic\r\n\r\n/-! A closed real subspace is determined by a dense complex span and genuine\r\nbounded regularizers of its antilinear fixed-point equation. Ordinary complex\r\ndensity alone is not used to infer equality. All regularizer obligations are\r\nexplicit; physical localization must supply them by separate terms. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.RealSubspaceRegularizerUniqueness\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem symmetrized_range_mem\r\n    (M : Submodule ℝ H) (hM : IsClosed (M : Set H))\r\n    (hd : (Submodule.span ℂ (M : Set H)).topologicalClosure=⊤)\r\n    (R : H →L[ℂ] H) (B : H →SL[starRingEnd ℂ] H)\r\n    (hR : ∀x∈M,R x∈M) (hB : ∀x∈M,B x=R x) (x : H) :\r\n    R x+B x∈M := by\r\n  have hs : ∀v∈Submodule.span ℂ (M : Set H),∀c:ℂ,R (c • v)+B (c • v)∈M := by\r\n    intro v hv\r\n    induction hv using Submodule.span_induction with\r\n    | mem v hv =>\r\n      intro c\r\n      rw [map_smul,map_smulₛₗ,hB v hv,←add_smul]\r\n      change (c+star c) • R v∈M\r\n      rw [Complex.star_def,Complex.add_conj]\r\n      exact M.smul_mem (2*c.re) (hR v hv)\r\n    | zero => intro c; simp\r\n    | add v w hv hw ihv ihw =>\r\n      intro c\r\n      simpa only [smul_add,map_add,add_add_add_comm] using M.add_mem (ihv c) (ihw c)\r\n    | smul a v hv ih =>\r\n      intro c\r\n      simpa only [smul_smul] using ih (c*a)\r\n  have hc : IsClosed {v : H | R v+B v∈M} := hM.preimage (R.continuous.add B.continuous)\r\n  have hsub : (Submodule.span ℂ (M : Set H)).topologicalClosure ≤\r\n      ({v : H | R v+B v∈M} : Set H) := by\r\n    exact closure_minimal (fun v hv => by simpa using hs v hv 1) hc\r\n  apply hsub\r\n  rw [hd]\r\n  trivial\r\n\r\ntheorem eq_of_regularizers\r\n    (M K : Submodule ℝ H) (hM : IsClosed (M : Set H)) (hMK : M≤K)\r\n    (hd : (Submodule.span ℂ (M : Set H)).topologicalClosure=⊤)\r\n    (R : ℕ → H →L[ℂ] H) (B : ℕ → H →SL[starRingEnd ℂ] H)\r\n    (hR : ∀n x,x∈M→R n x∈M)\r\n    (hB : ∀n x,x∈K→B n x=R n x)\r\n    (hlim : ∀x,Tendsto (fun n=>R n x) atTop (𝓝 x)) : M=K := by\r\n  apply le_antisymm hMK\r\n  intro x hx\r\n  apply hM.mem_of_tendsto (hlim x)\r\n  apply Filter.Eventually.of_forall\r\n  intro n\r\n  have hs := symmetrized_range_mem M hM hd (R n) (B n) (hR n)\r\n    (fun y hy=>hB n y (hMK hy)) x\r\n  rw [hB n x hx] at hs\r\n  have hh := M.smul_mem (1/2:ℝ) hs\r\n  have he : (1/2:ℝ) • (R n x+R n x)=R n x := by\r\n    rw [←two_smul ℝ (R n x),smul_smul]\r\n    norm_num\r\n  rw [he] at hh\r\n  exact hh\r\n\r\nend F1Fecho.RealSubspaceRegularizerUniqueness\r\n#print axioms F1Fecho.RealSubspaceRegularizerUniqueness.symmetrized_range_mem\r\n#print axioms F1Fecho.RealSubspaceRegularizerUniqueness.eq_of_regularizers\r\n',
+    'TGLExt/F1Fecho394/RealTomitaGraphDenseR1.lean': "import TGLExt.F1Fecho394.RealTomitaGraphR3\r\n/-! Transport of an existing pair-graph core into the actual real Hilbert graph.\r\nThe old graph closure is reused, without a new density hypothesis on vectors. -/\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.RealTomitaGraph\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem dense_pair_graph (T:H→ₗ.[ℂ]H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n    (D:Set (H×H)) (hD:closure D=CoefficientTomitaSquare.graph T J) :\r\n    closure ((WithLp.ofLp : PairH H→H×H) ⁻¹' D)=(graph T J:Set (PairH H)) := by\r\n  have hh:=(WithLp.prodContinuousLinearEquiv 2 ℝ H H).toHomeomorph.preimage_closure D\r\n  change (WithLp.ofLp : PairH H→H×H) ⁻¹' closure D=\r\n    closure ((WithLp.ofLp : PairH H→H×H) ⁻¹' D) at hh\r\n  rw [←hh,hD]\r\n  ext p\r\n  change WithLp.ofLp p∈CoefficientTomitaSquare.graph T J ↔ p∈graph T J\r\n  exact (mem_graph T J p).symm\r\n\r\nend F1Fecho.RealTomitaGraph\r\n#print axioms F1Fecho.RealTomitaGraph.dense_pair_graph\r\n",
+    'TGLExt/F1Fecho394/RealTomitaGraphR3.lean': "import TGLExt.F1Fecho394.CoefficientTomitaSquareR2\r\nimport Mathlib.Analysis.InnerProductSpace.ProdL2\r\n\r\n/-! The closed antilinear Tomita graph as an actual real Hilbert subspace.\r\nThe L2 graph core can therefore use orthogonal projection without declaring\r\nan antilinear graph to be a complex subspace. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RealTomitaGraph\r\nopen ChatgptAudit.Continuous050\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\nabbrev PairH (H:Type) := WithLp 2 (H×H)\r\n\r\ndef realJ (J:H≃ₛₗᵢ[starRingEnd ℂ]H) : H→L[ℝ]H where\r\n  toFun:=J\r\n  map_add':=J.map_add\r\n  map_smul' c x:=by\r\n    change J ((c:ℂ) • x)=(c:ℂ) • J x\r\n    rw [J.map_smulₛₗ]\r\n    simp\r\n  cont:=J.continuous\r\n\r\ndef graphMap (T:H→ₗ.[ℂ]H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) : T.domain→ₗ[ℝ]PairH H :=\r\n  (WithLp.linearEquiv 2 ℝ (H×H)).symm.toLinearMap.comp\r\n    ((T.domain.subtype.restrictScalars ℝ).prod\r\n      ((realJ J).toLinearMap.comp (T.toFun.restrictScalars ℝ)))\r\n\r\ndef graph (T:H→ₗ.[ℂ]H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) : Submodule ℝ (PairH H) :=\r\n  LinearMap.range (graphMap T J)\r\n\r\ntheorem mem_graph (T:H→ₗ.[ℂ]H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) (p:PairH H) :\r\n    p∈graph T J ↔ WithLp.ofLp p∈CoefficientTomitaSquare.graph T J := by\r\n  constructor\r\n  · rintro ⟨u,hu⟩\r\n    exact ⟨u,congrArg WithLp.ofLp hu⟩\r\n  · rintro ⟨u,hu⟩\r\n    exact ⟨u,congrArg (WithLp.toLp 2) hu⟩\r\n\r\ntheorem graph_closed (T:H→ₗ.[ℂ]H) (hT:T.IsClosed)\r\n    (J:H≃ₛₗᵢ[starRingEnd ℂ]H) (hJ:Function.Involutive J) :\r\n    IsClosed (graph T J:Set (PairH H)) := by\r\n  have he : (graph T J:Set (PairH H))=\r\n      (fun p:PairH H=>((WithLp.ofLp p).1,J (WithLp.ofLp p).2)) ⁻¹' (T.graph:Set (H×H)) := by\r\n    ext p\r\n    change p∈graph T J ↔ ((WithLp.ofLp p).1,J (WithLp.ofLp p).2)∈T.graph\r\n    rw [mem_graph]\r\n    constructor\r