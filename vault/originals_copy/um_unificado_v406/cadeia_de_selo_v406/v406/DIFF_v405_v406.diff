cal_right_wedge_complex_dense\r\n#print axioms F1Fecho.MaxwellLocalization.physical_right_wedge_eq_KWR\r\n#print axioms F1Fecho.MaxwellLocalization.physical_right_wedge_nonzero\r\n\r\n#print axioms F1Fecho.MaxwellLocalization.physicalNet_wedge_glue\r\n',
+    'TGLExt/F1Fecho394/PhysicalCircularRapidityR1.lean': 'import TGLExt.F1Fecho394.PhysicalSmearTranslationR2\r\nimport TGLExt.F1Fecho394.CircularConjugationR1\r\n\r\n/-! Actual almost-everywhere rapidity formula for the physical Maxwell map\r\nafter the fixed circular change of basis. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen F1Fecho.MaxwellGlobal F1Fecho.OrbitalScreen\r\nopen TGLExt.ImportedSQ AuditF13v31 ChatgptAudit.WignerRapidityMeasure016\r\n\r\ntheorem circularSmear_ae (f : SchwartzTensor) :\r\n    circularSmear f =ᵐ[orbitalMeasure 0] fun p =>\r\n      circularFiber.symm (globalCoefficient (physicalFourierCLM f) p) := by\r\n  have he : circularH1 (circularSmear f)=physicalSmearCLM f :=\r\n    circularH1.apply_symm_apply _\r\n  filter_upwards [fiberLiftMap_ae circularFiber (circularSmear f),physicalSmear_ae f] with p hp hf\r\n  have hv := congrArg (fun v : H1 => v p) he\r\n  change fiberLiftMap circularFiber (circularSmear f) p=physicalSmearCLM f p at hv\r\n  rw [hp,hf] at hv\r\n  exact circularFiber.injective (by rw [hv,circularFiber.apply_symm_apply])\r\n\r\ntheorem circularSmear_rapidity_ae (f : SchwartzTensor) :\r\n    toRapidity (circularSmear f) =ᵐ[momentumMeasure] fun y =>\r\n      circularFiber.symm (globalCoefficient (physicalFourierCLM f) (rapidityChart 0 y)) := by\r\n  have hc := (rapidityChart_measurePreserving 0).quasiMeasurePreserving.ae (circularSmear_ae f)\r\n  filter_upwards [orbitalL2Pullback_ae 0 (circularSmear f),hc] with y hp hc\r\n  exact hp.trans hc\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.circularSmear_ae\r\n#print axioms F1Fecho.MaxwellLocalization.circularSmear_rapidity_ae\r\n',
+    'TGLExt/F1Fecho394/PhysicalCompactNetCovarianceR1.lean': "import TGLExt.F1Fecho394.PhysicalSmearLorentzR3\r\nimport Mathlib.Topology.Algebra.Support\r\n\r\n/-! The compact-test Maxwell region net on the SAME H1 and smearing map.\r\nIt is kept distinct from the earlier all-Schwartz-support net. This module\r\nproves isotony and covariance only. Its right-wedge equality and causal\r\nlocality require their own consumers; neither is supplied as an input here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen F1Fecho.MaxwellGlobal TGLExt.ImportedSQ F1Fecho.OrbitalScreen\r\nopen F1Fecho.OrbitalSpatial F1Fecho.SpacetimeLorentz F1Fecho.PhysicalTensorLorentz\r\n\r\ndef compactSupportedGenerators (O : Set Spacetime) : Set H1 :=\r\n  {v | ∃ f : SchwartzTensor, IsRealTest f ∧\r\n    HasCompactSupport (f : Spacetime → TensorValue) ∧\r\n    tsupport (f : Spacetime → TensorValue) ⊆ O ∧ circularSmear f=v}\r\n\r\ndef compactLocalized (O : Set Spacetime) : Submodule ℝ H1 :=\r\n  (Submodule.span ℝ (compactSupportedGenerators O)).topologicalClosure\r\n\r\ntheorem compactLocalized_closed (O : Set Spacetime) :\r\n    IsClosed (compactLocalized O : Set H1) := Submodule.isClosed_topologicalClosure _\r\n\r\ntheorem compactLocalized_mono {O P : Set Spacetime} (h : O ⊆ P) :\r\n    compactLocalized O ≤ compactLocalized P := by\r\n  apply Submodule.topologicalClosure_mono\r\n  apply Submodule.span_mono\r\n  rintro v ⟨f,hr,hc,hs,hv⟩\r\n  exact ⟨f,hr,hc,hs.trans h,hv⟩\r\n\r\ntheorem compactLocalized_le_localized (O : Set Spacetime) :\r\n    compactLocalized O ≤ localized O := by\r\n  apply Submodule.topologicalClosure_mono\r\n  apply Submodule.span_mono\r\n  rintro v ⟨f,hr,hc,hs,hv⟩\r\n  exact ⟨f,hr,(subset_tsupport _).trans hs,hv⟩\r\n\r\ndef testSubtractHomeomorph (a : Spacetime) : Spacetime ≃ₜ Spacetime where\r\n  toFun x := x-a\r\n  invFun x := x+a\r\n  left_inv x := sub_add_cancel x a\r\n  right_inv x := add_sub_cancel_right x a\r\n  continuous_toFun := continuous_id.sub continuous_const\r\n  continuous_invFun := continuous_id.add continuous_const\r\n\r\ntheorem translateTest_compact (a : Spacetime) (f : SchwartzTensor)\r\n    (hc : HasCompactSupport (f : Spacetime → TensorValue)) :\r\n    HasCompactSupport (translateTest a f : Spacetime → TensorValue) :=\r\n  hc.comp_homeomorph (testSubtractHomeomorph a)\r\n\r\ntheorem translateTest_tsupport (a : Spacetime) (f : SchwartzTensor) :\r\n    tsupport (translateTest a f : Spacetime → TensorValue) =\r\n      translateRegion a (tsupport (f : Spacetime → TensorValue)) :=\r\n  tsupport_comp_eq_preimage (f : Spacetime → TensorValue) (testSubtractHomeomorph a)\r\n\r\ntheorem compact_translated_generator (a : Spacetime) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ compactSupportedGenerators O) :\r\n    U1 (fun i => a i) v ∈ compactSupportedGenerators (translateRegion a O) := by\r\n  obtain ⟨f,hr,hc,hs,rfl⟩ := hv\r\n  refine ⟨translateTest a f,translateTest_real a f hr,translateTest_compact a f hc,\r\n    ?_,circularSmear_translate a f⟩\r\n  rw [translateTest_tsupport]\r\n  intro x hx\r\n  exact hs hx\r\n\r\ntheorem compactLocalized_translate (a : Spacetime) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ compactLocalized O) :\r\n    U1 (fun i => a i) v ∈ compactLocalized (translateRegion a O) := by\r\n  let T : H1 →L[ℝ] H1 :=\r\n    (U1 (fun i => a i)).toLinearIsometry.toContinuousLinearMap.restrictScalars ℝ\r\n  have hs : (Submodule.span ℝ (compactSupportedGenerators O)).map T.toLinearMap ≤\r\n      Submodule.span ℝ (compactSupportedGenerators (translateRegion a O)) := by\r\n    rw [Submodule.map_span]\r\n    apply Submodule.span_le.mpr\r\n    rintro w ⟨x,hx,rfl⟩\r\n    exact Submodule.subset_span (compact_translated_generator a O x hx)\r\n  exact (Submodule.topologicalClosure_mono hs)\r\n    ((Submodule.topologicalClosure_map T _) (Submodule.mem_map.mpr ⟨v,hv,rfl⟩))\r\n\r\ntheorem compactLocalized_translate_iff (a : Spacetime) (O : Set Spacetime) (v : H1) :\r\n    v ∈ compactLocalized O ↔ U1 (fun i => a i) v ∈ compactLocalized (translateRegion a O) := by\r\n  constructor\r\n  · exact compactLocalized_translate a O v\r\n  · intro hv\r\n    have h := compactLocalized_translate (-a) (translateRegion a O) (U1 (fun i => a i) v) hv\r\n    rw [translateRegion_inverse] at h\r\n    have hi : U1 (fun i => (-a) i) (U1 (fun i => a i) v)=v := by\r\n      have hh := congrArg (fun u : H1 ≃ₗᵢ[ℂ] H1 => u v)\r\n        (U1_add (fun i => (-a) i) (fun i => a i))\r\n      have hz : (fun i => (-a) i)+(fun i => a i)=(0 : Fin 4 → ℝ) := by funext i; simp\r\n      rw [hz,U1_zero] at hh\r\n      exact hh.symm\r\n    rwa [hi] at h\r\n\r\ntheorem transform_tsupport (L : TGLExt.LorentzGrp) (f : SchwartzTensor) :\r\n    tsupport (transform L f : Spacetime → TensorValue) ⊆\r\n      action L '' tsupport (f : Spacetime → TensorValue) := by\r\n  apply closure_minimal\r\n  · exact (transform_support L f).trans (Set.image_mono (subset_tsupport _))\r\n  · exact (action L).toHomeomorph.isClosedMap _ isClosed_closure\r\n\r\ntheorem transform_compact (L : TGLExt.LorentzGrp) (f : SchwartzTensor)\r\n    (hc : HasCompactSupport (f : Spacetime → TensorValue)) :\r\n    HasCompactSupport (transform L f : Spacetime → TensorValue) :=\r\n  (hc.image (action L).continuous).of_isClosed_subset isClosed_closure (transform_tsupport L f)\r\n\r\ntheorem compact_lorentz_generator (L : generatedLorentz) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ compactSupportedGenerators O) :\r\n    helicityUnitary L v ∈ compactSupportedGenerators (lorentzRegion L O) := by\r\n  obtain ⟨f,hr,hc,hs,rfl⟩ := hv\r\n  exact ⟨transform L.val f,transform_real _ f hr,transform_compact _ f hc,\r\n    (transform_tsupport _ f).trans (Set.image_mono hs),circularSmear_lorentz L f⟩\r\n\r\ntheorem compactLocalized_lorentz (L : generatedLorentz) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ compactLocalized O) :\r\n    helicityUnitary L v ∈ compactLocalized (lorentzRegion L O) := by\r\n  let T : H1 →L[ℝ] H1 :=\r\n    (helicityUnitary L).toLinearIsometry.toContinuousLinearMap.restrictScalars ℝ\r\n  have hs : (Submodule.span ℝ (compactSupportedGenerators O)).map T.toLinearMap ≤\r\n      Submodule.span ℝ (compactSupportedGenerators (lorentzRegion L O)) := by\r\n    rw [Submodule.map_span]\r\n    apply Submodule.span_le.mpr\r\n    rintro w ⟨x,hx,rfl⟩\r\n    exact Submodule.subset_span (compact_lorentz_generator L O x hx)\r\n  exact (Submodule.topologicalClosure_mono hs)\r\n    ((Submodule.topologicalClosure_map T _) (Submodule.mem_map.mpr ⟨v,hv,rfl⟩))\r\n\r\ntheorem compactLocalized_lorentz_iff (L : generatedLorentz) (O : Set Spacetime) (v : H1) :\r\n    v ∈ compactLocalized O ↔ helicityUnitary L v ∈ compactLocalized (lorentzRegion L O) := by\r\n  constructor\r\n  · exact compactLocalized_lorentz L O v\r\n  · intro hv\r\n    have h := compactLocalized_lorentz L⁻¹ (lorentzRegion L O) (helicityUnitary L v) hv\r\n    rw [lorentzRegion_inverse,←helicityUnitary_mul,inv_mul_cancel,helicityUnitary_one] at h\r\n    exact h\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.compactLocalized_mono\r\n#print axioms F1Fecho.MaxwellLocalization.compactLocalized_le_localized\r\n#print axioms F1Fecho.MaxwellLocalization.compactLocalized_translate_iff\r\n#print axioms F1Fecho.MaxwellLocalization.compactLocalized_lorentz_iff\r\n",
+    'TGLExt/F1Fecho394/PhysicalCompactNetGeometryR1.lean': "import TGLExt.F1Fecho394.PhysicalCompactNetCovarianceR1\r\nimport TGLExt.F1Fecho394.PhysicalNetGeometryR1\r\n\r\n/-! Exact coordinate adapter and boost covariance for the compact-test\r\nMaxwell net. The existing all-Schwartz coordinate net remains untouched. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen TGLExt.ImportedSQ TGLExt.ContratoQGv31 F1Fecho.MaxwellGlobal\r\nopen F1Fecho.OrbitalScreen F1Fecho.OrbitalSpatial\r\n\r\ntheorem compactLocalized_boost_iff (s : ℝ) (O : Set Spacetime) (v : H1) :\r\n    v ∈ compactLocalized O ↔ B0 s v ∈ compactLocalized (boostRegion s O) := by\r\n  have h := compactLocalized_lorentz_iff (generatedBoost s) O v\r\n  rw [helicityUnitary_boost] at h\r\n  exact h\r\n\r\ndef compactPhysicalNet (O : Set (Fin 4 → ℝ)) : Submodule ℝ H1 :=\r\n  compactLocalized (coordinateRegion O)\r\n\r\ntheorem compactPhysicalNet_mono (O P : Set (Fin 4 → ℝ)) (h : O ⊆ P) :\r\n    compactPhysicalNet O ≤ compactPhysicalNet P := compactLocalized_mono (fun _ hx => h hx)\r\n\r\ntheorem compactPhysicalNet_translate (a : Fin 4 → ℝ) (O : Set (Fin 4 → ℝ)) (f : H1) :\r\n    f ∈ compactPhysicalNet O ↔ U1 a f ∈ compactPhysicalNet (TGL.SpecificAQFT.translate a O) := by\r\n  unfold compactPhysicalNet\r\n  rw [coordinateRegion_translate]\r\n  exact compactLocalized_translate_iff (spacetimeOf a) (coordinateRegion O) f\r\n\r\ntheorem compactPhysicalNet_boost (s : ℝ) (O : Set (Fin 4 → ℝ)) (f : H1) :\r\n    f ∈ compactPhysicalNet O ↔ B0 s f ∈ compactPhysicalNet (wedgeBoostMap s '' O) := by\r\n  unfold compactPhysicalNet\r\n  rw [coordinateRegion_boost]\r\n  exact compactLocalized_boost_iff s (coordinateRegion O) f\r\n\r\ntheorem compactPhysicalNet_rightWedge :\r\n    compactPhysicalNet TGL.SpecificAQFT.rightWedge=compactLocalized physicalRightWedge := rfl\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.compactPhysicalNet_mono\r\n#print axioms F1Fecho.MaxwellLocalization.compactPhysicalNet_translate\r\n#print axioms F1Fecho.MaxwellLocalization.compactPhysicalNet_boost\r\n",
+    'TGLExt/F1Fecho394/PhysicalCompactPairLocalityR1.lean': "import TGLExt.F1Fecho394.CompactPairCoverR1\r\nimport TGLExt.F1Fecho394.PhysicalCompactPartitionR1\r\n\r\n/-! Local vanishing of a real bilinear pairing extends over two compact\r\nMaxwell test supports by finite real smooth partitions. Local vanishing is\r\nan explicit premise here, to be supplied by physical opposite wedges. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 700000\r\nnoncomputable section\r\nopen Set Function\r\nnamespace F1Fecho.MaxwellGlobal\r\n\r\ndef TestPairZero (B : SchwartzTensor →ₗ[ℝ] SchwartzTensor →ₗ[ℝ] ℝ)\r\n    (U V : Set Spacetime) : Prop :=\r\n  ∀ f g, IsRealTest f → IsRealTest g →\r\n    support (f : Spacetime → TensorValue) ⊆ U →\r\n    support (g : Spacetime → TensorValue) ⊆ V → B f g = 0\r\n\r\ntheorem compact_pair_zero (B : SchwartzTensor →ₗ[ℝ] SchwartzTensor →ₗ[ℝ] ℝ)\r\n    (f g : SchwartzTensor) (hfr : IsRealTest f) (hgr : IsRealTest g)\r\n    (hfc : HasCompactSupport (f : Spacetime → TensorValue))\r\n    (hgc : HasCompactSupport (g : Spacetime → TensorValue))\r\n    (hloc : ∀ (x : tsupport (f : Spacetime → TensorValue))\r\n      (y : tsupport (g : Spacetime → TensorValue)), ∃ U V : Set Spacetime,\r\n      IsOpen U ∧ IsOpen V ∧ x.val ∈ U ∧ y.val ∈ V ∧ TestPairZero B U V) :\r\n    B f g = 0 := by\r\n  classical\r\n  have hmono : ∀ U U' V, U' ⊆ U → TestPairZero B U V → TestPairZero B U' V := by\r\n    intro U U' V hsub h f' g' hr hs hf hg\r\n    exact h f' g' hr hs (hf.trans hsub) hg\r\n  obtain ⟨s,t,U,V,hs,hh⟩ := CompactPairCover.finite_rectangular_cover\r\n    (tsupport (f : Spacetime → TensorValue)) (tsupport (g : Spacetime → TensorValue))\r\n    hfc hgc (TestPairZero B) hmono hloc\r\n  have hcoverf : tsupport (f : Spacetime → TensorValue) ⊆ ⋃ i : s, U i.val := by\r\n    intro z hz\r\n    obtain ⟨x,hx⟩ := mem_iUnion.mp (hs hz)\r\n    obtain ⟨hxs,hxz⟩ := mem_iUnion.mp hx\r\n    exact mem_iUnion.mpr ⟨⟨x,hxs⟩,hxz⟩\r\n  obtain ⟨fp,hfs,hfp⟩ := real_compact_partition (ι := s) f hfr hfc\r\n    (fun i => U i.val) (fun i => (hh i.val i.property).1) hcoverf\r\n  rw [← hfs,map_sum]\r\n  simp only [LinearMap.sum_apply]\r\n  apply Finset.sum_eq_zero\r\n  intro i _\r\n  have hcoverg : tsupport (g : Spacetime → TensorValue) ⊆ ⋃ j : t i.val, V i.val j.val := by\r\n    intro z hz\r\n    obtain ⟨y,hy⟩ := mem_iUnion.mp ((hh i.val i.property).2.1 hz)\r\n    obtain ⟨hyt,hyz⟩ := mem_iUnion.mp hy\r\n    exact mem_iUnion.mpr ⟨⟨y,hyt⟩,hyz⟩\r\n  obtain ⟨gp,hgs,hgp⟩ := real_compact_partition (ι := t i.val) g hgr hgc\r\n    (fun j => V i.val j.val) (fun j => ((hh i.val i.property).2.2 j.val j.property).1) hcoverg\r\n  rw [← hgs,map_sum]\r\n  apply Finset.sum_eq_zero\r\n  intro j _\r\n  exact ((hh i.val i.property).2.2 j.val j.property).2\r\n    (fp i) (gp j) (hfp i).1 (hgp j).1\r\n    (fun z hz => ((hfp i).2.2 hz).1) (fun z hz => ((hgp j).2.2 hz).1)\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.compact_pair_zero\r\n",
+    'TGLExt/F1Fecho394/PhysicalCompactPartitionR1.lean': 'import TGLExt.F1Fecho394.CompactSchwartzPartitionR3\r\nimport TGLExt.F1Fecho394.RealSchwartzTestsR1\r\n\r\n/-! The finite smooth decomposition preserves the actual real Maxwell test\r\ncondition. No causal commutation or domain equality is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen Function\r\nvariable {ι : Type} [Fintype ι]\r\n\r\ntheorem real_compact_partition (f : SchwartzTensor) (hr : IsRealTest f)\r\n    (hf : HasCompactSupport (f : Spacetime → TensorValue))\r\n    (U : ι → Set Spacetime) (ho : ∀ i, IsOpen (U i))\r\n    (hcover : tsupport (f : Spacetime → TensorValue) ⊆ ⋃ i, U i) :\r\n    ∃ parts : ι → SchwartzTensor, (∑ i, parts i) = f ∧\r\n      ∀ i, IsRealTest (parts i) ∧ HasCompactSupport (parts i : Spacetime → TensorValue) ∧\r\n        support (parts i : Spacetime → TensorValue) ⊆ U i ∩ support (f : Spacetime → TensorValue) := by\r\n  obtain ⟨parts,hsum,hparts⟩ := F1Fecho.CompactSchwartzPartition.finite_partition f hf U ho hcover\r\n  refine ⟨parts,hsum,?_⟩\r\n  intro i\r\n  refine ⟨?_,(hparts i).1,(hparts i).2.1⟩\r\n  intro x μ ν\r\n  obtain ⟨r,he⟩ := (hparts i).2.2 x\r\n  rw [he]\r\n  simp only [Pi.smul_apply,Complex.smul_im,hr x μ ν,smul_zero]\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.real_compact_partition\r\n',
+    'TGLExt/F1Fecho394/PhysicalFockNetRealizationR2.lean': 'import TGLExt.F1Fecho394.PhysicalCanonicalNetCompleteR1\r\nimport TGLExt.F1Fecho394.CanonicalModularCoreAssemblyR1\r\n\r\n/-! Actual Weyl field net on the compact Maxwell one-particle net, with the\r\nsame bosonic Fock, vacuum, antiunitary and modular boost. Every field below\r\nis supplied by an existing construction; no trace/PF premise is used.\r\nThis is the R6 component, not a whole FockCertificate, a device reduction,\r\na curved H3 derivation, or a physical confirmation. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen scoped InnerProductSpace\r\nnamespace F1Fecho.PhysicalFockNet\r\nopen TGLExt.ImportedSQ TGL.SpecificAQFT TGL.ModularRealization\r\nopen F1Rede.BosonicFock F1Fecho.MaxwellLocalization F1Fecho.Antilinear\r\nopen F1Rede.CanonicalWedge\r\n\r\ndef net (O : Set (Fin 4 → ℝ)) : VonNeumannAlgebra F :=\r\n  FieldWeyl.R (physicalCanonicalNet.K O)\r\n\r\ntheorem net_mono (O P : Set (Fin 4 → ℝ)) (h : O ⊆ P) :\r\n    (net O : Set (F →L[ℂ] F)) ⊆ net P :=\r\n  FieldWeyl.R_mono _ _ (physicalCanonicalNet.K_mono O P h)\r\n\r\ntheorem net_local (O P : Set (Fin 4 → ℝ)) (h : SpacelikeSep O P) :\r\n    ∀ A ∈ net O, ∀ B ∈ net P, Commute A B :=\r\n  FieldWeyl.R_local _ _ (physicalCanonicalNet.K_local O P h)\r\n\r\ntheorem net_wedge_eq :\r\n    net rightWedge = FieldWeyl.R KWR.toClosedSubmodule.toSubmodule := by\r\n  change FieldWeyl.R (compactPhysicalNet rightWedge) = _\r\n  exact congrArg FieldWeyl.R compactPhysicalNet_wedge_glue\r\n\r\ntheorem weyl_ccr (f g : H1) :\r\n    FieldWeyl.W f * FieldWeyl.W g =\r\n      F1Fecho.WeylCoefficients.phase f g • FieldWeyl.W (f+g) :=\r\n  FieldWeyl.W_ccr f g\r\n\r\ntheorem weyl_generator_mem (O : Set (Fin 4 → ℝ)) (f : H1)\r\n    (hf : f ∈ physicalCanonicalNet.K O) : FieldWeyl.W f ∈ net O :=\r\n  FieldWeyl.W_mem_R _ f hf\r\n\r\ntheorem weyl_regular (v : F) : Continuous (fun f : H1 => FieldWeyl.W f v) :=\r\n  FieldWeyl.W_strongly_continuous v\r\n\r\ntheorem net_covariant (u : H1 ≃ₗᵢ[ℂ] H1) (O P : Set (Fin 4 → ℝ))\r\n    (h : ∀ f, f ∈ physicalCanonicalNet.K O ↔ u f ∈ physicalCanonicalNet.K P)\r\n    (A : F →L[ℂ] F) :\r\n    A ∈ net O ↔ (gamma u).conjStarAlgEquiv A ∈ net P :=\r\n  FieldWeyl.R_covariance u _ _ h A\r\n\r\ntheorem vacuum_cyclic :\r\n    Dense ((Submodule.span ℂ\r\n      ((fun A : F →L[ℂ] F => A vacuum) \'\' (net rightWedge : Set (F →L[ℂ] F))) :\r\n        Submodule ℂ F) : Set F) := by\r\n  rw [net_wedge_eq]\r\n  exact F1Fecho.WedgeCyclic.vacuum_cyclic KWR\r\n\r\ntheorem vacuum_separating (A : F →L[ℂ] F) (hA : A ∈ net rightWedge)\r\n    (h0 : A vacuum = 0) : A = 0 := by\r\n  rw [net_wedge_eq] at hA\r\n  exact F1Fecho.WedgeCyclic.vacuum_separating KWR A hA h0\r\n\r\ntheorem wedge_nonabelian :\r\n    ∃ A ∈ net rightWedge, ∃ B ∈ net rightWedge, A*B ≠ B*A := by\r\n  rw [net_wedge_eq]\r\n  exact F1Fecho.WedgeNonabelian.wedge_nonabelian\r\n\r\ntheorem vacuum_bw_kms :\r\n    KMSBody (net rightWedge) vacuum (fun t => gamma (B0 (2*Real.pi*t))) 1 := by\r\n  rw [net_wedge_eq]\r\n  exact F1Fecho.CanonicalWedgeKMS.canonical_bw_kms\r\n\r\ntheorem pair_tomita :\r\n    ORDEM016.D6.PairTomitaAnalyticRealizationMeasured\r\n      (net rightWedge).toStarSubalgebra vacuum canonicalFockJ\r\n      (fun t => gamma (B0 (-(2*Real.pi*t)))) := by\r\n  rw [net_wedge_eq]\r\n  exact F1Fecho.CanonicalFockBW.canonical_pair_tomita\r\n\r\ntheorem modular_J_same_one_particle (x : H1) :\r\n    canonicalFockJ (oneParticle x) = oneParticle (Jcandidate x) :=\r\n  canonicalFockJ_oneParticle x\r\n\r\ntheorem modular_J_involutive : Function.Involutive canonicalFockJ :=\r\n  canonicalFockJ_involutive\r\n\r\ntheorem modular_J_vacuum : canonicalFockJ vacuum = vacuum :=\r\n  canonicalFockJ_vacuum\r\n\r\nend F1Fecho.PhysicalFockNet\r\n\r\nopen Lean in\r\nrun_cmd do\r\n  let env ← Elab.Command.liftCoreM getEnv\r\n  for (n, ci) in env.constants.map₂.toList do\r\n    if (`F1Fecho.PhysicalFockNet).isPrefixOf n then\r\n      let axs ← collectAxioms n\r\n      IO.println ("LOCAL_DECL\\t" ++ n.toString ++ "\\t" ++ String.intercalate "," (axs.toList.map Name.toString))\r\n      unless axs.all (fun a => a == `propext || a == `Classical.choice || a == `Quot.sound) do\r\n        throwError "AXIOM_AUDIT_REFUSED: {n}"\r\n      match ci with\r\n      | .axiomInfo _ => throwError "LOCAL_AXIOM_REFUSED: {n}"\r\n      | _ => pure ()\r\n',
+    'TGLExt/F1Fecho394/PhysicalFourierDerivativeR4.lean': 'import TGLExt.F1Fecho394.PhysicalSchwartzMaxwellR1\r\nimport TGLExt.F1Fecho394.SchwartzMaxwellDivergenceR2\r\n\r\n/-! The angular inverse Fourier derivative identity, with no change of the\r\nunderlying H1 or density. Constant tensor injection commutes with Fourier. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen SchwartzMap FourierTransform MeasureTheory\r\nopen scoped FourierTransform LineDeriv Topology\r\n\r\nvariable {E G : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]\r\n  [NormedAddCommGroup G] [NormedSpace ℂ G] [CompleteSpace G]\r\n\r\ntheorem schwartz_fourier_postcomp (L : E →L[ℂ] G) (f : 𝓢(Spacetime,E)) :\r\n    𝓕 (SchwartzMap.postcompCLM L f)=SchwartzMap.postcompCLM L (𝓕 f) := by\r\n  ext p : 1\r\n  change (𝓕 (fun x => L (f x))) p = L ((𝓕 (f : Spacetime→E)) p)\r\n  rw [Real.fourier_eq,Real.fourier_eq,← L.integral_comp_comm ((Real.fourierIntegral_convergent_iff p).2 f.integrable)]\r\n  apply integral_congr_ae\r\n  filter_upwards [] with x\r\n  simp only [Circle.smul_def,map_smul]\r\n\r\ntheorem schwartz_fourierInv_postcomp (L : E →L[ℂ] G) (f : 𝓢(Spacetime,E)) :\r\n    𝓕⁻ (SchwartzMap.postcompCLM L f)=SchwartzMap.postcompCLM L (𝓕⁻ f) := by\r\n  rw [SchwartzMap.fourierInv_apply_eq,schwartz_fourier_postcomp]\r\n  ext p : 1\r\n  rfl\r\n\r\ndef scalarPhysicalFourier (f : 𝓢(Spacetime,ℂ)) : 𝓢(Spacetime,ℂ) :=\r\n  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ physicalFourierArgument (𝓕⁻ f)\r\n\r\ntheorem physicalFourier_postcomp (L : ℂ →L[ℂ] TensorValue) (b : 𝓢(Spacetime,ℂ)) :\r\n    physicalFourierCLM (SchwartzMap.postcompCLM L b)=\r\n      SchwartzMap.postcompCLM L (scalarPhysicalFourier b) := by\r\n  ext p : 1\r\n  rw [physicalFourier_apply,schwartz_fourierInv_postcomp]\r\n  rfl\r\n\r\ndef spacetimeBasis (μ : Fin 4) : Spacetime := EuclideanSpace.single μ 1\r\n\r\ntheorem physicalFourier_derivative (f : SchwartzTensor) (μ : Fin 4) (p : Spacetime) :\r\n    physicalFourierCLM (∂_{spacetimeBasis μ} f) p =\r\n      (-Complex.I*(metricFlip p μ:ℂ)) • physicalFourierCLM f p := by\r\n  rw [physicalFourier_apply,SchwartzMap.fourierInv_lineDerivOp_eq]\r\n  have ht : (fun x : Spacetime => inner ℝ x (spacetimeBasis μ)).HasTemperateGrowth := by fun_prop\r\n  change -(2*Real.pi*Complex.I) •\r\n    (SchwartzMap.smulLeftCLM TensorValue (fun x => inner ℝ x (spacetimeBasis μ)) (𝓕⁻ f))\r\n      ((2*Real.pi)⁻¹ • metricFlip p) = _\r\n  rw [SchwartzMap.smulLeftCLM_apply ht]\r\n  have hi : inner ℝ ((2*Real.pi)⁻¹ • metricFlip p) (spacetimeBasis μ)=\r\n      (2*Real.pi)⁻¹*(metricFlip p μ) := by\r\n    simp [spacetimeBasis,EuclideanSpace.inner_single_right,PiLp.smul_apply]\r\n  dsimp only\r\n  rw [hi,← Complex.coe_smul,smul_smul]\r\n  rw [physicalFourier_apply]\r\n  congr 1\r\n  push_cast\r\n  field_simp [Real.pi_ne_zero]\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.schwartz_fourier_postcomp\r\n#print axioms F1Fecho.MaxwellGlobal.schwartz_fourierInv_postcomp\r\n#print axioms F1Fecho.MaxwellGlobal.physicalFourier_postcomp\r\n#print axioms F1Fecho.MaxwellGlobal.physicalFourier_derivative\r\n',
+    'TGLExt/F1Fecho394/PhysicalFourierRealityR4.lean': "import TGLExt.F1Fecho394.PhysicalTensorLorentzR7\r\n\r\n/-! Spacetime inversion of real test tensors is complex conjugation of the\r\nphysical positive-angular Fourier transform. No localization consequence is\r\nassumed in this Fourier identity. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen MeasureTheory Complex SchwartzMap\r\nopen scoped ComplexConjugate\r\nopen scoped FourierTransform\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen F1Fecho.MaxwellGlobal F1Fecho.SpacetimeLorentz\r\nopen ChatgptAudit.WignerOrbit016\r\n\r\ndef invertTest : SchwartzTensor→L[ℂ]SchwartzTensor :=\r\n  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ (ContinuousLinearEquiv.neg ℝ)\r\n\r\ntheorem invertTest_apply (f:SchwartzTensor) (x:Spacetime) : invertTest f x=f (-x) := rfl\r\n\r\ntheorem invertTest_real (f:SchwartzTensor) (hf:IsRealTest f) : IsRealTest (invertTest f) :=\r\n  fun x μ ν=>hf (-x) μ ν\r\n\r\ntheorem invertTest_support (f:SchwartzTensor) :\r\n    Function.support (invertTest f:Spacetime→TensorValue)=\r\n      (fun x:Spacetime=>-x) '' Function.support (f:Spacetime→TensorValue) := by\r\n  ext x\r\n  constructor\r\n  · intro hx\r\n    exact ⟨-x,hx,neg_neg x⟩\r\n  · rintro ⟨y,hy,rfl⟩\r\n    simpa only [Function.mem_support,invertTest_apply,neg_neg] using hy\r\n\r\ntheorem physicalFourier_component (f:SchwartzTensor) (p:Spacetime) (μ ν:Fin 4) :\r\n    physicalFourierCLM f p μ ν=\r\n      ∫x:Spacetime,exp ((orbitPairing (fun i=>x i) (fun i=>p i):ℂ)*I)*f x μ ν := by\r\n  let A:TensorValue→L[ℂ]ℂ :=\r\n    (ContinuousLinearMap.proj ν : (Fin 4 → ℂ) →L[ℂ] ℂ).comp\r\n      (ContinuousLinearMap.proj μ : TensorValue →L[ℂ] (Fin 4 → ℂ))\r\n  let g:𝓢(Spacetime,ℂ):=SchwartzMap.postcompCLM A f\r\n  have he:=congrArg (fun h:𝓢(Spacetime,ℂ)=>h ((2*Real.pi)⁻¹ • metricFlip p))\r\n    (schwartz_fourierInv_postcomp A f)\r\n  calc\r\n    physicalFourierCLM f p μ ν=(𝓕⁻ g) ((2*Real.pi)⁻¹ • metricFlip p) := by\r\n      rw [physicalFourier_apply]\r\n      simpa [A,g,SchwartzMap.postcompCLM_apply] using he.symm\r\n    _ = _ := by\r\n      simpa [g,A,SchwartzMap.postcompCLM_apply,SchwartzMap.fourierInv_coe] using angular_inverse_integral (g:Spacetime→ℂ) p\r\n\r\ntheorem physicalFourier_invert_real (f:SchwartzTensor) (hf:IsRealTest f)\r\n    (p:Spacetime) (μ ν:Fin 4) :\r\n    physicalFourierCLM (invertTest f) p μ ν=conj (physicalFourierCLM f p μ ν) := by\r\n  rw [physicalFourier_component,physicalFourier_component,←integral_conj]\r\n  have hi:=integral_neg_eq_self\r\n    (fun x:Spacetime=>exp ((orbitPairing (fun i=>x i) (fun i=>p i):ℂ)*I)*invertTest f x μ ν)\r\n  rw [←hi]\r\n  apply integral_congr_ae\r\n  apply ae_of_all\r\n  intro x\r\n  have hr:conj (f x μ ν)=f x μ ν := Complex.conj_eq_iff_im.mpr (hf x μ ν)\r\n  simp only [invertTest_apply,neg_neg,map_mul,←Complex.exp_conj,hr,\r\n    Complex.conj_ofReal,Complex.conj_I,mul_neg]\r\n  congr 2\r\n  simp [orbitPairing,Pi.neg_apply,Complex.ofReal_neg]\r\n  <;> ring\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.invertTest_support\r\n#print axioms F1Fecho.MaxwellLocalization.physicalFourier_component\r\n#print axioms F1Fecho.MaxwellLocalization.physicalFourier_invert_real\r\n",
+    'TGLExt/F1Fecho394/PhysicalFourierTranslationR3.lean': 'import TGLExt.F1Fecho394.MinkowskiSchwartzFourierR4\r\nimport TGLExt.O16.OrbitTranslationFaithfulness_v2\r\n\r\n/-! Translation phases for the actual Fourier conventions. The inverse transform\r\nat metricFlip(p)/(2*pi) has the positive angular phase used by U1. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory\r\nopen scoped FourierTransform RealInnerProductSpace\r\nnamespace F1Fecho.PhysicalFourier\r\nopen F1Fecho.MaxwellGlobal ChatgptAudit.WignerOrbit016\r\nvariable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]\r\n\r\ntheorem fourier_translate (f : Spacetime → E) (a k : Spacetime) :\r\n    𝓕 (fun x => f (x-a)) k =\r\n      Complex.exp (((-2*Real.pi*inner ℝ a k : ℝ) : ℂ)*Complex.I) • 𝓕 f k := by\r\n  have h := congrFun (VectorFourier.fourierIntegral_comp_add_right\r\n    Real.fourierChar (volume : Measure Spacetime) (innerₗ Spacetime) f (-a)) k\r\n  change 𝓕 (f ∘ fun x => x + -a) k =\r\n    Real.fourierChar (inner ℝ (-a) k) • 𝓕 f k at h\r\n  simpa [sub_eq_add_neg,Function.comp_def,Circle.smul_def,Real.fourierChar_apply,\r\n    inner_neg_left,mul_neg,neg_mul] using h\r\n\r\ntheorem fourierInv_translate (f : Spacetime → E) (a k : Spacetime) :\r\n    𝓕⁻ (fun x => f (x-a)) k =\r\n      Complex.exp (((2*Real.pi*inner ℝ a k : ℝ) : ℂ)*Complex.I) • 𝓕⁻ f k := by\r\n  rw [Real.fourierInv_eq_fourier_neg,fourier_translate,Real.fourierInv_eq_fourier_neg]\r\n  simp only [inner_neg_right,mul_neg,neg_mul,neg_neg]\r\n\r\ntheorem angular_pairing (a p : Spacetime) :\r\n    2*Real.pi*inner ℝ a ((2*Real.pi)⁻¹ • metricFlip p) =\r\n      orbitPairing (fun i => a i) (fun i => p i) := by\r\n  rw [real_inner_smul_right,real_inner_comm (metricFlip p) a,metricFlip_inner]\r\n  unfold orbitPairing\r\n  field_simp [Real.pi_ne_zero]\r\n  <;> ring\r\n\r\ntheorem angular_inverse_fourier_translate (f : Spacetime → E) (a p : Spacetime) :\r\n    𝓕⁻ (fun x => f (x-a)) ((2*Real.pi)⁻¹ • metricFlip p) =\r\n      phase (orbitPairing (fun i => a i) (fun i => p i)) •\r\n        𝓕⁻ f ((2*Real.pi)⁻¹ • metricFlip p) := by\r\n  rw [fourierInv_translate,angular_pairing]\r\n  rfl\r\n\r\ntheorem unscaled_forward_fourier_translate (f : Spacetime → E) (a p : Spacetime) :\r\n    𝓕 (fun x => f (x-a)) (metricFlip p) =\r\n      phase ((-2*Real.pi)*orbitPairing (fun i => a i) (fun i => p i)) •\r\n        𝓕 f (metricFlip p) := by\r\n  rw [fourier_translate,real_inner_comm (metricFlip p) a,metricFlip_inner]\r\n  simp only [phase,orbitPairing,mul_comm]\r\nend F1Fecho.PhysicalFourier\r\n#print axioms F1Fecho.PhysicalFourier.fourier_translate\r\n#print axioms F1Fecho.PhysicalFourier.fourierInv_translate\r\n#print axioms F1Fecho.PhysicalFourier.angular_pairing\r\n#print axioms F1Fecho.PhysicalFourier.angular_inverse_fourier_translate\r\n#print axioms F1Fecho.PhysicalFourier.unscaled_forward_fourier_translate\r\n',
