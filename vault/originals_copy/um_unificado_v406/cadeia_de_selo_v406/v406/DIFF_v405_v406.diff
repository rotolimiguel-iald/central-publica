+    'TGLExt/F1Fecho394/RegularAverageAdjointR4.lean': 'import TGLExt.F1Fecho394.RegularCoreAverageR2\r\n/-! The adjoint of the same regular average is a translated average.\r\nThis uses strong vector integrals, never operator-norm integrability. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularAverageAdjoint\r\nopen MeasureTheory TGLV350 TGLV350.Regular\r\nopen F1Fecho.RegularCovariantCore F1Fecho.RegularCoreAverage\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ndef reverseFamily (B : UnitaryFlow H) : StrongIntegral.Family (H:=RegularHilbert H) where\r\n  op t := regularUnitary B (-t)\r\n  continuous_apply v := (regular_strongly_continuous B v).comp continuous_neg\r\n  bound := 1\r\n  bound_nonneg := zero_le_one\r\n  norm_bound t := (regularIntegralFamily B).norm_bound (-t)\r\n\r\ntheorem integral_star (B : UnitaryFlow H) (a b : ℝ) :\r\n    star (StrongIntegral.operatorIntegral (regularIntegralFamily B) a b)=\r\n      StrongIntegral.operatorIntegral (reverseFamily B) a b := by\r\n  apply ContinuousLinearMap.ext\r\n  intro x\r\n  apply ext_inner_left ℂ\r\n  intro y\r\n  rw [ContinuousLinearMap.star_eq_adjoint,ContinuousLinearMap.adjoint_inner_right,\r\n    StrongIntegral.operatorIntegral_inner,StrongIntegral.inner_operatorIntegral]\r\n  apply intervalIntegral.integral_congr\r\n  intro t _\r\n  change inner ℂ (regularUnitary B t y) x=inner ℂ y (regularUnitary B (-t) x)\r\n  rw [←regular_star B,ContinuousLinearMap.star_eq_adjoint,\r\n    ContinuousLinearMap.adjoint_inner_right]\r\n\r\ntheorem reverse_integral (B : UnitaryFlow H) (h : ℝ) :\r\n    StrongIntegral.operatorIntegral (reverseFamily B) 0 h=\r\n      regularUnitary B (-h)*StrongIntegral.operatorIntegral (regularIntegralFamily B) 0 h := by\r\n  apply ContinuousLinearMap.ext\r\n  intro x\r\n  change (∫ t in 0..h,regularUnitary B (-t) x)=\r\n    regularUnitary B (-h) (∫ t in 0..h,regularUnitary B t x)\r\n  rw [←(regularUnitary B (-h)).intervalIntegral_comp_comm\r\n    ((regular_strongly_continuous B x).intervalIntegrable 0 h)]\r\n  have he : (fun t => regularUnitary B (-h) (regularUnitary B t x))=\r\n      (fun t => regularUnitary B (t-h) x) := by\r\n    funext t\r\n    change (regularUnitary B (-h)*regularUnitary B t) x=_\r\n    rw [F1Fecho.RegularCovariantCore.regular_mul]\r\n    congr 2\r\n    ring\r\n  rw [he,intervalIntegral.integral_comp_neg (fun t : ℝ => regularUnitary B t x),\r\n    intervalIntegral.integral_comp_sub_right (fun t : ℝ => regularUnitary B t x)]\r\n  simp only [neg_zero,zero_sub,sub_self]\r\n\r\ntheorem regularAverage_star (B : UnitaryFlow H) (h : ℝ) :\r\n    star (F1Fecho.RegularCoreAverage.regularAverage B h)=regularUnitary B (-h)*F1Fecho.RegularCoreAverage.regularAverage B h := by\r\n  unfold F1Fecho.RegularCoreAverage.regularAverage\r\n  change star (((h⁻¹ : ℝ) : ℂ) • StrongIntegral.operatorIntegral (regularIntegralFamily B) 0 h) =\r\n    regularUnitary B (-h) * (((h⁻¹ : ℝ) : ℂ) • StrongIntegral.operatorIntegral (regularIntegralFamily B) 0 h)\r\n  rw [star_smul,Complex.star_def,Complex.conj_ofReal,integral_star,reverse_integral,mul_smul_comm]\r\n\r\nend F1Fecho.RegularAverageAdjoint\r\n#print axioms F1Fecho.RegularAverageAdjoint.integral_star\r\n#print axioms F1Fecho.RegularAverageAdjoint.reverse_integral\r\n#print axioms F1Fecho.RegularAverageAdjoint.regularAverage_star\r\n',
+    'TGLExt/F1Fecho394/RegularBoostedReflectionR1.lean': "import TGLExt.F1Fecho394.RegularSpectralBoostedAverageR2\r\nimport TGLExt.F1Fecho394.CoefficientConjugationR2\r\n/-! Exact reflected interval coefficient of the adjoint regular average.\r\nOnly null endpoints are discarded in Lebesgue L2. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularBoostedReflection\r\nopen MeasureTheory TGLV350.Regular\r\nopen F1Fecho.RegularCovariantCore F1Fecho.RegularSpectralAverage\r\nopen F1Fecho.RegularSpectralBoostedAverage\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem regular_boosted_reflection (B:UnitaryFlow H) (h:ℝ) (v:H) :\r\n    F1Fecho.RegularCovariantCore.regularUnitary B (-h) (boostedCoefficient B h v)=\r\n      CoefficientConjugation.reflection\r\n        (CoefficientBoost.multiplier B (-1) (coefficient h v)) := by\r\n  have ha := (measurePreserving_sub_right volume (-h)).quasiMeasurePreserving.ae\r\n    (boostedCoefficient_ae B h v)\r\n  have hb := (Measure.measurePreserving_neg (volume:Measure ℝ)).quasiMeasurePreserving.ae\r\n    (CoefficientBoost.multiplier_ae B (-1) (coefficient h v))\r\n  have hc := (Measure.measurePreserving_neg (volume:Measure ℝ)).quasiMeasurePreserving.ae\r\n    (coefficient_ae h v)\r\n  apply Lp.ext\r\n  filter_upwards [fibre_ae (boostCLM B (-h)) (shift (-h) (boostedCoefficient B h v)),\r\n    shift_ae (-h) (boostedCoefficient B h v),ha,\r\n    CoefficientConjugation.reflectionMap_ae\r\n      (CoefficientBoost.multiplier B (-1) (coefficient h v)),hb,hc,\r\n    (Ico_ae_eq_Ioc (μ:=(volume:Measure ℝ)) (a:=-h) (b:=0))]\r\n      with t h1 h2 h3 h4 h5 h6 h7\r\n  change fibre (boostCLM B (-h)) (shift (-h) (boostedCoefficient B h v)) t =\r\n    CoefficientConjugation.reflectionMap _ t\r\n  rw [h1,h2,h3,h4,h5,h6]\r\n  have hm1 : t-(-h)∈Set.Ioc 0 h ↔ t∈Set.Ioc (-h) 0 := by\r\n    simp only [Set.mem_Ioc]; constructor <;> intro ht <;> constructor <;> linarith [ht.1,ht.2]\r\n  have hm2 : -t∈Set.Ioc 0 h ↔ t∈Set.Ico (-h) 0 := by\r\n    simp only [Set.mem_Ioc,Set.mem_Ico]; constructor <;> intro ht <;> constructor <;> linarith [ht.1,ht.2]\r\n  by_cases ht : t∈Set.Ioc (-h) 0\r\n  · have ht' : t∈Set.Ico (-h) 0 := h7.mpr ht\r\n    simp only [Set.indicator_of_mem (hm1.mpr ht),Set.indicator_of_mem (hm2.mpr ht')]\r\n    change B.U (-h) (B.U (t-(-h)) v)=B.U (-1 * -t) v\r\n    have he := congrArg (fun U:H≃ₗᵢ[ℂ]H=>U v) (B.add (-h) (t-(-h)))\r\n    simp only [LinearIsometryEquiv.trans_apply] at he\r\n    rw [←he]\r\n    congr 2 <;> ring\r\n  · have ht' : t∉Set.Ico (-h) 0 := fun hh=>ht (h7.mp hh)\r\n    simp only [Set.indicator_of_notMem (fun hh=>ht (hm1.mp hh)),\r\n      Set.indicator_of_notMem (fun hh=>ht' (hm2.mp hh)),map_zero]\r\nend F1Fecho.RegularBoostedReflection\r\n#print axioms F1Fecho.RegularBoostedReflection.regular_boosted_reflection\r\n",
+    'TGLExt/F1Fecho394/RegularCoefficientBoundaryR3.lean': "import TGLExt.F1Fecho394.PositiveCoefficientBoundaryR4\r\nimport TGLExt.F1Fecho394.RegularMaxwellEnergyR2\r\nimport TGLExt.F1Fecho394.PhysicalSmearTranslationR2\r\nimport TGLExt.F1Fecho394.OrbitalContractionAnalyticR1\r\n\r\n/-! Finite first moments for all matrix coefficients whose second vector is\r\nan actual Maxwell Schwartz smearing. Circular basis transport preserves the\r\npointwise norm. This supplies the regularity needed by boundary uniqueness. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped InnerProductSpace ENNReal\r\nnamespace F1Fecho.RegularCoefficient\r\nopen TGLExt.ImportedSQ F1Fecho.MaxwellGlobal F1Fecho.MaxwellLocalization\r\nopen F1Fecho.OrbitalScreen ChatgptAudit.WignerRapidityMeasure016\r\nopen ChatgptAudit.WignerOrbit016 ChatgptAudit.PositiveEnergy016\r\n\r\ntheorem circularSmear_energySquare (f : SchwartzTensor) :\r\n    EnergySquareProfile (circularSmear f) := by\r\n  intro m\r\n  apply ((physicalSmear_strongRegular f).2 m).congr\r\n  filter_upwards [fiberLiftMap_ae circularFiber.symm (physicalSmearCLM f)] with y hy\r\n  change shellEnergy y^m*‖physicalSmearCLM f y‖^2=\r\n    shellEnergy y^m*‖fiberLiftMap circularFiber.symm (physicalSmearCLM f) y‖^2\r\n  rw [hy,circularFiber.symm.norm_map]\r\n\r\ntheorem coefficient_first_moment (p : MomentumCoordinates→ℝ) (hp : Measurable p)\r\n    (hn : ∀y,0≤p y) (hb : ∀y,p y≤2*shellEnergy y)\r\n    (ξ ψ : H1) (hψ : EnergySquareProfile ψ) :\r\n    Integrable (fun y=>p y*‖inner ℂ (ξ y) (ψ y)‖) (orbitalMeasure 0) := by\r\n  have hi : Integrable (fun y=>‖ξ y‖^2) (orbitalMeasure 0) :=\r\n    (Lp.memLp ξ).integrable_norm_pow (by norm_num : (2:ℕ)≠0)\r\n  apply (hi.add (hψ 2)).mono'\r\n  · exact hp.aestronglyMeasurable.mul\r\n      ((Lp.aestronglyMeasurable ξ).inner (Lp.aestronglyMeasurable ψ)).norm\r\n  · apply ae_of_all\r\n    intro y\r\n    rw [Real.norm_of_no