act (congrArg scalarWeightGNSEmbedding he).trans (scalarWeightGNSEmbedding_uniform u)\r\n\r\n/-- Both coordinates of the full-weight star graph are approximated by the\r\nsame uniform-star-core sandwich, in the GNS product topology. -/\r\ntheorem scalarWeightTomitaGraph_subset_closure_original  :\r\n    scalarWeightTomitaGraph ⊆ closure (F1Fecho.RegularScalarTomitaGraph.scalarTomitaGraph weightContext) := by\r\n  rintro _ ⟨A,rfl⟩\r\n  let a : scalarWeightLeftIdeal := ⟨A.val,A.property.1⟩\r\n  let astar : scalarWeightLeftIdeal := ⟨(star A).val,(star A).property.1⟩\r\n  have ht : Tendsto (fun h : ℝ =>\r\n      (scalarWeightGNSEmbedding (scalarWeightSandwich a h),\r\n        scalarWeightGNSEmbedding (scalarWeightSandwich astar h)))\r\n      (𝓝[>] (0 : ℝ))\r\n      (𝓝 (scalarWeightStarEmbedding A,scalarWeightStarEmbedding (star A))) :=\r\n    ((scalarWeightGNSEmbedding_sandwich_tendsto a).prodMk_nhds\r\n      (scalarWeightGNSEmbedding_sandwich_tendsto astar)).mono_left\r\n        (nhdsWithin_mono (0 : ℝ) (by intro h hh; exact ne_of_gt hh))\r\n  apply isClosed_closure.mem_of_tendsto ht\r\n  filter_upwards [self_mem_nhdsWithin] with h hh\r\n  let b : F1Fecho.RegularScalarTomitaGraph.finiteStarCore weightContext := ⟨F1Fecho.RegularFiniteStarCore.regularSandwich fockFlow M A.val h,\r\n    F1Fecho.CanonicalFockFiniteStarCore.finiteSandwich_mem A.val h hh⟩\r\n  apply subset_closure\r\n  refine ⟨b,?_⟩\r\n  apply Prod.ext\r\n  · exact (scalarWeightGNSEmbedding_sandwich_uniform a h hh).symm\r\n  · have he := congrArg (F1Fecho.RegularScalarTomitaGraph.scalarGNSStarEmbedding weightContext)\r\n      (show star b =\r\n        (⟨F1Fecho.RegularFiniteStarCore.regularSandwich fockFlow M (star A).val h,\r\n          F1Fecho.CanonicalFockFiniteStarCore.finiteSandwich_mem (star A).val h hh⟩ :\r\n            F1Fecho.RegularScalarTomitaGraph.finiteStarCore weightContext) from\r\n        Subtype.ext (F1Fecho.RegularFiniteStarCore.regularSandwich_star fockFlow M A.val h))\r\n    exact he.trans (scalarWeightGNSEmbedding_sandwich_uniform astar h hh).symm\r\n\r\ntheorem scalarWeightTomitaGraph_closure_eq  :\r\n    closure (scalarWeightTomitaGraph) = closure (F1Fecho.RegularScalarTomitaGraph.scalarTomitaGraph weightContext) :=\r\n  Set.Subset.antisymm\r\n    (closure_minimal (scalarWeightTomitaGraph_subset_closure_original) isClosed_closure)\r\n    (closure_mono (scalarTomitaGraph_subset_weight))\r\n\r\n/-- The existing closed S is exactly the closure of the full-weight star\r\ngraph. This does not assert equality with the raw algebraic graph. -/\r\ntheorem graph_eq_weight  :\r\n    Set.range (fun x : closedTomitaDomain =>\r\n      ((x : GNSHilbert),closedTomita x)) =\r\n        closure (scalarWeightTomitaGraph) := by\r\n  exact graph_eq.trans scalarWeightTomitaGraph_closure_eq.symm\r\n\r\ntheorem scalarWeightStar_mem_closedTomitaDomain \r\n    (A : scalarWeightStarCore) :\r\n    scalarWeightStarEmbedding A ∈ closedTomitaDomain :=\r\n  ⟨scalarWeightStarEmbedding (star A),\r\n    scalarWeightTomitaGraph_subset_closure_original ⟨A,rfl⟩⟩\r\n\r\ntheorem scalarClosedTomita_extends_weight_star \r\n    (A : scalarWeightStarCore) :\r\n    closedTomita ⟨scalarWeightStarEmbedding A,\r\n      scalarWeightStar_mem_closedTomitaDomain A⟩ = scalarWeightStarEmbedding (star A) :=\r\n  F1Fecho.RegularScalarTomitaClosure.scalarTomitaGraph_closure_single_valued (H := F) weightContext (scalarWeightStarEmbedding A) _ _\r\n    (F1Fecho.RegularScalarClosedTomita.scalarClosedTomita_graph (H := F) (D := weightContext) ⟨scalarWeightStarEmbedding A,\r\n      scalarWeightStar_mem_closedTomitaDomain A⟩)\r\n    (scalarWeightTomitaGraph_subset_closure_original ⟨A,rfl⟩)\r\n\r\n#print axioms scalarWeightGNSEmbedding_sandwich_uniform\r\n#print axioms scalarWeightTomitaGraph_subset_closure_original\r\n#print axioms scalarWeightTomitaGraph_closure_eq\r\n#print axioms graph_eq_weight\r\n#print axioms scalarWeightStar_mem_closedTomitaDomain\r\n#print axioms scalarClosedTomita_extends_weight_star\r\nend F1Fecho.CanonicalFockFullWeightTomita\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockGNSClosednessR5.lean': 'import TGLExt.F1Fecho394.GenericCountableCutsR1\r\nimport TGLExt.F1Fecho394.CanonicalFockGNSCutsR2\r\nimport TGLExt.V350DualOrbitStrongLimits\r\n/-! Closed graph of the actual full-weight Fock GNS inscription.\r\nCountably many finite-interval cuts identify the vector. Both operator-strong\r\nand GNS-norm convergence are required, exactly as in the incorporated v393 proof. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockGNSClosedness\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock MeasureTheory Filter\r\nopen TGLV350.Regular (RegularHilbert dualQuadraticIntegral dualHaarFactor dualHaarFactor_pos dualAmbient dualQuadraticIntegrand_star_mul measurableCut measurableCut_ae operatorFieldLift operatorFieldLift_ae dualOrbitRepresentation dualIntegralFamily dualOrbit_tendsto_of_uniformly_bounded)\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockWeightOrbit F1Fecho.CanonicalFockWeightCompletion\r\nopen F1Fecho.CanonicalFockGNSCuts\r\nopen scoped Topology ENNReal NNReal\r\ntheorem hasFiniteScalarSquare_iff_memLp \r\n    (A : RegularHilbert F →L[ℂ] RegularHilbert F) :\r\n    HasFiniteScalarSquare  A ↔ MemLp (fun s : ℝ => dualAmbient s A (regularFockVacuum)) 2 := by\r\n  constructor\r\n  · exact scalarWeightOrbit_memLp  A\r\n  · intro hm\r\n    have hi := hm.2\r\n    rw [eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top (by norm_num) (by norm_num)] at hi\r\n    have he (s : ℝ) : ENNReal.ofReal (‖dualAmbient s A (regularFockVacuum)‖ ^ 2) =\r\n        (‖dualAmbient s A (regularFockVacuum)‖₊ : ℝ≥0∞) ^ 2 := by\r\n      rw [ENNReal.ofReal_pow (norm_nonneg _),ofReal_norm,enorm_eq_nnnorm]\r\n    simp only [HasFiniteScalarSquare,dualQuadraticIntegral,dualQuadraticIntegrand_star_mul,he]\r\n    apply ENNReal.mul_lt_top ENNReal.ofReal_lt_top\r\n    simpa only [ENNReal.toReal_ofNat,ENNReal.rpow_two,enorm_eq_nnnorm,pow_two] using hi\r\n\r\n\r\n/-- Extend the existing cut identity from the uniform finite ideal to all n_nu. -/\r\ntheorem scalarGNSCutMap_weight_embedding (r : ℝ)\r\n    (A : scalarWeightLeftIdeal ) :\r\n    scalarGNSCutMap  r (scalarWeightGNSEmbedding  A) =\r\n      dualOrbitRepresentation A.val.val (scalarCutVacuum  r) := by\r\n  apply Lp.ext\r\n  filter_upwards [measurableCut_ae (Set.Ioc (-r) r) measurableSet_Ioc (scalarWeightOrbit  A),\r\n    scalarWeightOrbit_ae  A,\r\n    operatorFieldLift_ae (dualIntegralFamily A.val.val) (scalarCutVacuum  r),\r\n    scalarCutVacuum_ae  r] with s h1 h2 h3 h4\r\n  change measurableCut (Set.Ioc (-r) r) measurableSet_Ioc (scalarWeightOrbit  A) s =\r\n    operatorFieldLift (dualIntegralFamily A.val.val) (scalarCutVacuum  r) s\r\n  apply h1.trans\r\n  apply Eq.trans ?_ (h3.trans (congrArg (dualAmbient s A.val.val) h4)).symm\r\n  by_cases hs : s ∈ Set.Ioc (-r) r\r\n  · simp only [Set.indicator_of_mem hs]\r\n    exact h2.trans ((map_smul (dualAmbient s A.val.val) (↑(Real.sqrt dualHaarFactor) : ℂ) regularFockVacuum).symm)\r\n  · simp only [Set.indicator_of_notMem hs,map_zero]\r\n\r\n\r\n/-- Countably many existing cuts identify a full weight vector; no finite\r\nminorant formula for the nontracial weight is used. -/\r\ntheorem scalarWeightGNSEmbedding_of_cut_actions \r\n    (A : core.toStarSubalgebra) (v : GNSHilbert)\r\n    (hcut : ∀ n : ℕ, scalarGNSCutMap  (n : ℝ) v =\r\n      dualOrbitRepresentation A.val (scalarCutVacuum  (n : ℝ))) :\r\n    ∃ hA : A ∈ scalarWeightLeftIdeal , scalarWeightGNSEmbedding  ⟨A,hA⟩ = v := by\r\n  have he (n : ℕ) : ∀ᵐ s : ℝ, s ∈ Set.Ioc (-(n : ℝ)) (n : ℝ) →\r\n      v.val s = (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s A.val (regularFockVacuum) := by\r\n    filter_upwards [measurableCut_ae (Set.Ioc (-(n : ℝ)) (n : ℝ)) measurableSet_Ioc v.val,\r\n      operatorFieldLift_ae (dualIntegralFamily A.val) (scalarCutVacuum  (n : ℝ)),\r\n      scalarCutVacuum_ae  (n : ℝ)] with s h1 h2 h3\r\n    intro hs\r\n    have h := congrArg (fun f : RegularHilbert (RegularHilbert F) => f s) (hcut n)\r\n    change measurableCut (Set.Ioc (-(n : ℝ)) (n : ℝ)) measurableSet_Ioc v.val s =\r\n      operatorFieldLift (dualIntegralFamily A.val) (scalarCutVacuum  (n : ℝ)) s at h\r\n    have hh := h1.symm.trans (h.trans (h2.trans (congrArg (dualAmbient s A.val) h3)))\r\n    simp only [Set.indicator_of_mem hs] at hh\r\n    change v.val s = (↑(Real.sqrt dualHaarFactor) : ℂ) • dualAmbient s A.val regularFockVacuum\r\n    exact hh.trans (map_smul (dualAmbient s A.val) (↑(Real.sqrt dualHaarFactor) : ℂ) regularFockVacuum)\r\n\r\n  have hall : (v.val : ℝ → RegularHilbert F) =ᵐ[volume]\r\n      fun s => (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s A.val (regularFockVacuum) := by\r\n    exact F1Fecho.GenericCountableCuts.ae_eq_of_ioc _ _ he\r\n  have hc : Real.sqrt dualHaarFactor ≠ 0 := ne_of_gt (Real.sqrt_pos.2 dualHaarFactor_pos)\r\n  have hm : MemLp (fun s : ℝ => dualAmbient s A.val (regularFockVacuum)) 2 := by\r\n    have hf : ((Real.sqrt dualHaarFactor)⁻¹ : ℝ) •\r\n        (v.val : ℝ → RegularHilbert F) =ᵐ[volume]\r\n        fun s => dualAmbient s A.val (regularFockVacuum) := by\r\n      filter_upwards [hall] with s hs\r\n      simp only [Pi.smul_apply,hs,smul_smul,inv_mul_cancel₀ hc,one_smul]\r\n    exact (memLp_congr_ae hf).mp ((Lp.memLp v.val).const_smul ((Real.sqrt dualHaarFactor)⁻¹ : ℝ))\r\n  have hA : A ∈ scalarWeightLeftIdeal  := (hasFiniteScalarSquare_iff_memLp  A.val).mpr hm\r\n  refine ⟨hA,?_⟩\r\n  apply Subtype.ext\r\n  apply Lp.ext\r\n  exact (scalarWeightOrbit_ae  ⟨A,hA⟩).trans hall.symm\r\n\r\n/-- The two required convergences close the same GNS inscription. Strong\r\noperator convergence alone is not asserted to imply convergence in GNS norm. -/\r\ntheorem scalarWeightGNSEmbedding_closed_of_bounded_strong \r\n    {ι : Type*} {l : Filter ι} [NeBot l]\r\n    (T : ι → scalarWeightLeftIdeal )\r\n    (A : core.toStarSubalgebra) (v : GNSHilbert) (C : ℝ)\r\n    (hbound : ∀ i, ‖(T i).val.val‖ ≤ C)\r\n    (hstrong : ∀ x, Tendsto (fun i => (T i).val.val x) l (𝓝 (A.val x)))\r\n    (hgns : Tendsto (fun i => scalarWeightGNSEmbedding  (T i)) l (𝓝 v)) :\r\n    ∃ hA : A ∈ scalarWeightLeftIdeal , scalarWeightGNSEmbedding  ⟨A,hA⟩ = v := by\r\n  apply scalarWeightGNSEmbedding_of_cut_actions  A v\r\n  intro n\r\n  have h1 := (scalarGNSCutMap  (n : ℝ)).continuous.continuousAt.tendsto.comp hgns\r\n  have h2 := dualOrbit_tendsto_of_uniformly_bounded\r\n    (fun i => (T i).val.val) A.val C hbound hstrong (scalarCutVacuum  (n : ℝ))\r\n  simp only [Function.comp_def,scalarGNSCutMap_weight_embedding] at h1\r\n  exact tendsto_nhds_unique h1 h2\r\n\r\n\r\nend F1Fecho.CanonicalFockGNSClosedness\r\n#print axioms F1Fecho.CanonicalFockGNSClosedness.hasFiniteScalarSquare_iff_memLp\r\n#print axioms F1Fecho.CanonicalFockGNSClosedness.scalarGNSCutMap_weight_embedding\r\n#print axioms F1Fecho.CanonicalFockGNSClosedness.scalarWeightGNSEmbedding_of_cut_actions\r\n#print axioms F1Fecho.CanonicalFockGNSClosedness.scalarWeightGNSEmbedding_closed_of_bounded_strong\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockGNSCutsR2.lean': 'import TGLExt.F1Fecho394.CanonicalFockGNSRepresentationR6\r\nimport TGLExt.F1Fecho394.CanonicalFockWeightCompletionR5\r\nimport TGLExt.V350ScalarGNSCutMaps\r\nimport TGLExt.V350ScalarCutVacuum\r\n\r\n/-! Actual cut maps for the existing concrete Fock GNS completion.\r\nReuses the v393 cut proofs. No new GNS space, state or modular identity is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockGNSCuts\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock TGLV350.Regular MeasureTheory Filter\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockWeightOrbit F1Fecho.CanonicalFockWeightCompletion\r\nopen scoped Topology\r\n/-- A contraction from the actual scalar GNS completion into its ambient L² space.\r\nIts identification with the bounded cut functional is a separate norm theorem. -/\r\ndef scalarGNSCutMap (R : ℝ) :\r\n    GNSHilbert →L[ℂ] RegularHilbert (RegularHilbert F) :=\r\n  (measurableCut (Set.Ioc (-R) R) measurableSet_Ioc).comp (GNSSubspace).subtypeL\r\n\r\ntheorem scalarGNSCutMap_norm_le (R : ℝ) (v : GNSHilbert) :\r\n    ‖scalarGNSCutMap  R v‖ ≤ ‖v‖ :=\r\n  measurableCutLp_norm_le (Set.Ioc (-R) R) measurableSet_Ioc v.val\r\n\r\ntheorem scalarGNSCutMap_intertwines (R : ℝ)\r\n    (B : core.toStarSubalgebra) (v : GNSHilbert) :\r\n    scalarGNSCutMap  R (scalarGNSRepresentation  B v) =\r\n      dualOrbitRepresentation B.val (scalarGNSCutMap  R v) :=\r\n  measurableCut_operatorFieldLift (Set.Ioc (-R) R) measurableSet_Ioc\r\n    (dualIntegralFamily B.val) v.val\r\n\r\ntheorem scalarGNSCutMap_joint_zero (v : GNSHilbert)\r\n    (h : ∀ n : ℕ, scalarGNSCutMap  (n : ℝ) v = 0) : v = 0 := by\r\n  apply Subtype.ext\r\n  exact measurableCut_nat_joint_zero v.val h\r\n\r\n\r\n/-- A finite-interval vector in the existing ambient L² space. It is not normalized\r\nto a state and no separating property is included in its definition. -/\r\ndef scalarCutVacuum (R : ℝ) :\r\n    RegularHilbert (RegularHilbert F) :=\r\n  (Real.sqrt dualHaarFactor : ℝ) •\r\n    indicatorConstLp 2 (measurableSet_Ioc (a := -R) (b := R)) (by simp) (regularFockVacuum)\r\n\r\ntheorem scalarCutVacuum_ae (R : ℝ) :\r\n    (scalarCutVacuum  R : ℝ → RegularHilbert F) =ᵐ[volume]\r\n      (Set.Ioc (-R) R).indicator (fun _ => (Real.sqrt dualHaarFactor : ℝ) • regularFockVacuum) := by\r\n  let f : RegularHilbert (RegularHilbert F) :=\r\n    indicatorConstLp 2 (measurableSet_Ioc (a := -R) (b := R)) (by simp) (regularFockVacuum)\r\n  filter_upwards [Lp.coeFn_smul (Real.sqrt dualHaarFactor : ℝ) f,\r\n    indicatorConstLp_coeFn (p := (2 : ENNReal))\r\n      (hs := measurableSet_Ioc (a := -R) (b := R)) (hμs := by simp) (c := regularFockVacuum)]\r\n    with x h1 h2\r\n  change ((Real.sqrt dualHaarFactor : ℝ) • f) x = _\r\n  simp only [Pi.smul_apply] at h1\r\n  rw [h1,show f x = _ from h2]\r\n  by_cases hx : x ∈ Set.Ioc (-R) R <;> simp [hx]\r\n\r\n\r\nend F1Fecho.CanonicalFockGNSCuts\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarGNSCutMap\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarGNSCutMap_norm_le\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarGNSCutMap_intertwines\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarGNSCutMap_joint_zero\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarCutVacuum\r\n#print axioms F1Fecho.CanonicalFockGNSCuts.scalarCutVacuum_ae\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockGNSOrderR4.lean': 'import TGLExt.F1Fecho394.CanonicalFockGNSRepresentationR6\r\nimport TGLExt.F1Fecho394.GenericGNSOrderR2\r\n/-! Positivity and bounded-strong continuity of the actual Fock weight GNS representation. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockGNSOrder\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock TGLV350.Regular MeasureTheory Filter\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation\r\nopen scoped Topology\r\nlocal instance : CompleteSpace GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\nlocal instance : PartialOrder (GNSHilbert →L[ℂ] GNSHilbert) :=\r\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := GNSHilbert)\r\n/-- Transfer bounded strong nets to the actual completed finite-ideal representation.\r\nThis does not claim closability of the involutive graph. -/\r\ntheorem scalarGNSRepresentation_tendsto_of_uniformly_bounded \r\n    {ι : Type*} {l : Filter ι}\r\n    (T : ι → core.toStarSubalgebra)\r\n    (B : core.toStarSubalgebra) (C : ℝ)\r\n    (hbound : ∀ i, ‖(T i).val‖ ≤ C)\r\n    (hT : ∀ v, Tendsto (fun i => (T i).val v) l (𝓝 (B.val v)))\r\n    (v : GNSHilbert) :\r\n    Tendsto (fun i => scalarGNSRepresentation (T i) v) l\r\n      (𝓝 (scalarGNSRepresentation B v)) :=\r\n  F1Fecho.GenericGNSOrder.scalarGNSRepresentation_tendsto_of_uniformly_bounded\r\n    weightContext T B C hbound hT v\r\n\r\ntheorem scalarGNSRepresentation_nonneg \r\n    (B : core.toStarSubalgebra) (hB : 0 ≤ B) :\r\n    0 ≤ scalarGNSRepresentation B :=\r\n  F1Fecho.GenericGNSOrder.scalarGNSRepresentation_nonneg weightContext B hB\r\n\r\ntheorem scalarGNSRepresentation_monotone  :\r\n    Monotone (scalarGNSRepresentation) :=\r\n  F1Fecho.GenericGNSOrder.scalarGNSRepresentation_monotone weightContext\r\n\r\nend F1Fecho.CanonicalFockGNSOrder\r\n#print axioms F1Fecho.CanonicalFockGNSOrder.scalarGNSRepresentation_tendsto_of_uniformly_bounded\r\n#print axioms F1Fecho.CanonicalFockGNSOrder.scalarGNSRepresentation_nonneg\r\n#print axioms F1Fecho.CanonicalFockGNSOrder.scalarGNSRepresentation_monotone\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockInverseNormalR1.lean': 'import TGLExt.F1Fecho394.GeneralInverseAdditivityR3\r\nimport TGLExt.F1Fecho394.CanonicalFockInverseSupremumR2\r\n/-! Internal order normality and the infinite identity of the SAME inverse\r\nweight on the Fock core. The latter follows from proved scaling and\r\nfaithfulness, not from a zero surrogate or a finiteness assumption. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockInverseSupremum\r\nopen TGLExt TGLV350.Regular\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight\r\nopen F1Fecho.RegularInverseWeight\r\nopen scoped ENNReal\r\n\r\ntheorem value_mono (X Y:PositiveInput) (h:X.val≤Y.val) : value X≤value Y :=\r\n  inverseSupremum_mono fockFlow regularFockVacuum X.val Y.val h\r\n\r\ntheorem value_internal_normal {ι:Type*} [Preorder ι] [IsDirectedOrder ι] [Nonempty ι]\r\n    (A:ι→core.toStarSubalgebra) (S:core.toStarSubalgebra)\r\n    (hpos:∀i,0≤A i) (hmono:Monotone A) (hS:IsLUB (Set.range A) S) (hSpos:0≤S) :\r\n    value ⟨S.val,S.property,hSpos⟩=⨆i,value ⟨(A i).val,(A i).property,hpos i⟩ :=\r\n  inverseSupremum_preserves_internal_isLUB fockFlow regularFockVacuum core A S hpos hmono hS\r\n\r\ntheorem positiveDual_one (s:ℝ) : positiveDual s one=one := by\r\n  apply Subtype.ext\r\n  change (dualAction s (1:core.toStarSubalgebra)).val=(1:core.toStarSubalgebra).val\r\n  exact congrArg Subtype.val (map_one (dualAction s))\r\n\r\ntheorem value_one : value one=⊤ := by\r\n  have hn:value one≠0:=by\r\n    intro hz\r\n    have he:one.val=(0:TGLV350.Regular.RegularHilbert F1Rede.BosonicFock.F→L[ℂ]\r\n        TGLV350.Regular.RegularHilbert F1Rede.BosonicFock.F):=(value_faithful one).mp hz\r\n    exact positive_cone_nontrivial (Subtype.ext he)\r\n  by_contra ht\r\n  have he:=value_dual 1 one\r\n  rw [positiveDual_one] at he\r\n  have hc:ENNReal.ofReal (Real.exp (-1))=1:=(ENNReal.mul_eq_right hn ht).mp he.symm\r\n  have hl:ENNReal.ofReal (Real.exp (-1))<1:=\r\n    ENNReal.ofReal_lt_one.mpr (Real.exp_lt_one_iff.mpr (by norm_num))\r\n  exact (ne_of_lt hl) hc\r\n\r\nend F1Fecho.CanonicalFockInverseSupremum\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_mono\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_internal_normal\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.positiveDual_one\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_one\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockInverseSupremumR2.lean': "import TGLExt.F1Fecho394.GeneralInverseSupremumR3\r\nimport TGLExt.F1Fecho394.GeneralPositiveSandwichFaithfulR1\r\nimport TGLExt.F1Fecho394.CanonicalFockFaithfulWeightR2\r\n/-! Actual inverse-generator perturbation on the SAME Fock represented core.\r\nThe supremum is homogeneous, normal, faithful, and dual-scaled. Its positive\r\nadditivity and tracial law are not claimed until regulator order is proved.\r\nThis is not a total cyclic ENNReal-valued extension to arbitrary operators. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1500000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockInverseSupremum\r\nopen TGLExt TGLV350.Regular F1Rede.BosonicFock\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight\r\nopen F1Fecho.CanonicalFockFaithfulWeight F1Fecho.RegularInverseWeight\r\nopen Filter\r\nopen scoped ENNReal NNReal Topology\r\n\r\ndef cut (e:ℝ) (X:PositiveInput):ℝ≥0∞:=cutoffWeight fockFlow regularFockVacuum e X.val\r\ndef value (X:PositiveInput):ℝ≥0∞:=inverseSupremum fockFlow regularFockVacuum X.val\r\n\r\ntheorem value_zero:value zero=0:=inverseSupremum_zero fockFlow regularFockVacuum\r\n\r\ntheorem value_scale (r:ℝ≥0) (X:PositiveInput):\r\n    value (scale r X)=(r:ℝ≥0∞)*value X:=\r\n  inverseSupremum_scale fockFlow regularFockVacuum r X.val\r\n\r\ntheorem value_dual (s:ℝ) (X:PositiveInput):\r\n    value (positiveDual s X)=ENNReal.ofReal (Real.exp (-s))*value X:=\r\n  inverseSupremum_dual fockFlow regularFockVacuum s X.val\r\n\r\ntheorem cut_one_faithful (X:PositiveInput):cut 1 X=0 ↔ X.val=0 := by\r\n  constructor\r\n  · intro hz\r\n    let R:=RegularPositiveFlow.regularInverseGeneratorCutoff fockFlow 1\r\n    let b:=hilbertPositiveSqrt R\r\n    have hR:R∈core:=RegularPositiveFlow.regularInverseGeneratorCutoff_mem fockFlow M 1\r\n    have hb:b∈core:=sqrt_mem_core core R hR\r\n      (RegularPositiveFlow.regularInverseGeneratorCutoff_nonneg fockFlow 1 zero_lt_one)\r\n    have hm:star b*X.val*b∈core:=core.mul_mem\r\n      (core.mul_mem (core.toStarSubalgebra.star_mem' hb) X.property.1) hb\r\n    have he:star b*X.val*b=0:=\r\n      (weight_faithful ⟨star b*X.val*b,hm,star_left_conjugate_nonneg X.property.2 b⟩).mp hz\r\n    change star (hilbertPositiveSqrt R)*X.val*hilbertPositiveSqrt R=0 at he\r\n    have hr:R=RegularPositiveFlow.regularSpectralResolvent fockFlow:=\r\n      RegularPositiveFlow.regularInverseGeneratorCutoff_one fockFlow\r\n    rw [hr] at he\r\n    exact sqrt_conjugation_faithful _ X.val\r\n      (RegularPositiveFlow.regularSpectralResolvent_nonneg fockFlow)\r\n      (RegularPositiveFlow.regularSpectralResolvent_injective fockFlow) he\r\n  · intro hx\r\n    change cutoffWeight fockFlow regularFockVacuum 1 X.val=0\r\n    rw [hx,cutoffWeight_zero]\r\n\r\ntheorem value_faithful (X:PositiveInput):value X=0 ↔ X.val=0 := by\r\n  constructor\r\n  · intro hz\r\n    have hh:=cutoffWeight_le_supremum fockFlow regularFockVacuum\r\n      (⟨1,zero_lt_one⟩:PositiveRegulator) X.val\r\n    change cut 1 X ≤ value X at hh\r\n    rw [hz] at hh\r\n    exact (cut_one_faithful X).mp (le_antisymm hh bot_le)\r\n  · intro hx\r\n    change inverseSupremum fockFlow regularFockVacuum X.val=0\r\n    rw [hx,inverseSupremum_zero]\r\n\r\ntheorem value_normal {i:Type*} [Preorder i] [IsDirectedOrder i] [Nonempty i]\r\n    (A:i→PositiveInput) (S:PositiveInput)\r\n    (hmono:Monotone (fun j=>(A j).val))\r\n    (hlim:∀v,Tendsto (fun j=>(A j).val v) atTop (𝓝 (S.val v))) :\r\n    value S=⨆j,value (A j) :=\r\n  inverseSupremum_normal fockFlow regularFockVacuum (fun j=>(A j).val) S.val\r\n    (fun j=>(A j).property.2) hmono hlim\r\n\r\ntheorem value_subadditive (X Y:PositiveInput):value (add X Y) ≤ value X+value Y :=\r\n  inverseSupremum_subadditive fockFlow regularFockVacuum X.val Y.val X.property.2 Y.property.2\r\n\r\nend F1Fecho.CanonicalFockInverseSupremum\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_zero\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_scale\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_dual\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.cut_one_faithful\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_faithful\r\n\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_normal\r\n#print axioms F1Fecho.CanonicalFockInverseSupremum.value_subadditive\r\n",
+    'TGLExt/F1Fecho394/CanonicalFockMatrixCornerR2.lean': "import TGLExt.F1Fecho394.MatrixCornerFromNilpotentR3\r\nimport TGLExt.F1Fecho394.CanonicalFockDualWeightR3\r\nimport TGLExt.F1Fecho394.WedgeNonabelianR4\r\nimport TGLExt.V354FiniteTraceSupport\r\nimport Mathlib.Analysis.SpecialFunctions.ContinuousFunctionalCalculus.PosPart.Basic\r\n\r\n/-! DECLARADO / UNCOMPILED CANDIDATE, R51, 2026-10-16.\r\nAn actual nilpotent and orthogonal corner in the SAME represented Fock core.\r\nThe existing normalized Weyl pair is reused. With A=W(f)+W(f)* and U=W(g),\r\nU A U*=-A; the vacuum characteristic proves A is nonzero. Uniqueness of the\r\npositive and negative parts gives U A+ U*=A-. Consequently T=A+ U is nonzero\r\nand square-zero. Membership is proved inside the actual wedge algebra and\r\nthen transported by the injective fibre representation to the existing core.\r\nNo nonabelian, nilpotent, matrix-corner, type-II, trace or split premise is\r\nadded to the final suppliers. The generic sign-flip lemma has explicit\r\nhypotheses, all discharged by the concrete Weyl construction below.\r\nRequire EXIT0 and all five public axiom reports. -/\r\nset_option Elab.async false\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 400000\r\nset_option synthInstance.maxHeartbeats 500000\r\nset_option maxErrors 10\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockMatrixCornerR2\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Rede.CanonicalWedge\r\nopen TGLV350.Regular\r\nopen F1Fecho.CanonicalFockRegular (M core)\r\nopen F1Fecho.CanonicalFockWeight (PositiveInput zero)\r\nopen F1Fecho.WeylCoefficients\r\nopen F1Fecho.WedgeNonabelian (normalized_pair phase_half_pi)\r\n\r\ntheorem nilpotent_of_sign_flip {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (N : VonNeumannAlgebra H) (A U : H →L[ℂ] H)\r\n    (hAm : A ∈ N) (hUm : U ∈ N) (hAs : IsSelfAdjoint A) (hA : A ≠ 0)\r\n    (huL : star U * U = 1) (huR : U * star U = 1)\r\n    (hflip : U * A * star U = -A) :\r\n    ∃ T : H →L[ℂ] H, T ∈ N ∧ T ≠ 0 ∧ T*T = 0 := by\r\n  letI : IsClosed (N.toStarSubalgebra : Set (H →L[ℂ] H)) := vonNeumann_norm_closed N\r\n  have hpm : A⁺ ∈ N := by\r\n    rw [CFC.posPart_def]\r\n    exact cfcₙ_mem (𝕜' := ℂ) (s := N.toStarSubalgebra) (fun x : ℝ => x⁺) hAm\r\n  have hparts : U * A⁺ * star U = A⁻ := by\r\n    have hd : -A = (U*A⁺*star U) - (U*A⁻*star U) := by\r\n      calc\r\n        -A = U*A*star U := hflip.symm\r\n        _ = U*(A⁺-A⁻)*star U :=\r\n          congrArg (fun B : H →L[ℂ] H => U*B*star U)\r\n            (CFC.posPart_sub_negPart A hAs).symm\r\n        _ = _ := by noncomm_ring\r\n    have ho : (U*A⁺*star U)*(U*A⁻*star U) = 0 := by\r\n      calc\r\n        _ = U*(A⁺*(star U*U)*A⁻)*star U := by noncomm_ring\r\n        _ = U*(A⁺*A⁻)*star U := by rw [huL,mul_one]\r\n        _ = 0 := by rw [CFC.posPart_mul_negPart,mul_zero,zero_mul]\r\n    have hp := (CFC.posPart_negPart_unique hd ho\r\n      (star_right_conjugate_nonneg (CFC.posPart_nonneg A) U)\r\n      (star_right_conjugate_nonneg (CFC.negPart_nonneg A) U)).1\r\n    simpa only [CFC.posPart_neg] using hp.symm\r\n  have hpne : A⁺ ≠ 0 := by\r\n    intro hp\r\n    have hn : A⁻ = 0 := by rw [← hparts,hp,mul_zero,zero_mul]\r\n    apply hA\r\n    calc\r\n      A = A⁺-A⁻ := (CFC.posPart_sub_negPart A hAs).symm\r\n      _ = 0 := by rw [hp,hn,sub_zero]\r\n  have hmove : U*A⁺ = A⁻*U := by\r\n    have ht := congrArg (fun B : H →L[ℂ] H => B*U) hparts\r\n    simpa only [mul_assoc,huL,mul_one] using ht\r\n  refine ⟨A⁺*U,N.mul_mem hpm hUm,?_,?_⟩\r\n  · intro hz\r\n    apply hpne\r\n    have ht := congrArg (fun B : H →L[ℂ] H => B*star U) hz\r\n    simpa only [mul_assoc,huR,mul_one,zero_mul] using ht\r\n  · calc\r\n      (A⁺*U)*(A⁺*U) = A⁺*(U*A⁺)*U := by noncomm_ring\r\n      _ = A⁺*(A⁻*U)*U := by rw [hmove]\r\n      _ = (A⁺*A⁻)*(U*U) := by noncomm_ring\r\n      _ = 0 := by rw [CFC.posPart_mul_negPart,zero_mul]\r\n#print axioms nilpotent_of_sign_flip\r\n\r\n/- The adjoint algebra and existential packing are proved at a generic\r\nHilbert type, before supplying the native Fock dictionaries. -/\r\nprivate theorem real_part_selfAdjoint {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (X : H →L[ℂ] H) : IsSelfAdjoint (X+star X) := by\r\n  change star (X+star X) = X+star X\r\n  rw [star_add,star_star,add_comm]\r\n\r\nprivate theorem real_part_flip {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (X U : H →L[ℂ] H) (hx : U*X*star U = -X) :\r\n    U*(X+star X)*star U = -(X+star X) := by\r\n  have hs : U*star X*star U = -star X := by\r\n    simpa only [star_mul,star_star,star_neg,mul_assoc] using\r\n      congrArg (fun B : H →L[ℂ] H => star B) hx\r\n  rw [mul_add,add_mul,hx,hs,neg_add]\r\n\r\nprivate theorem positive_corner_from_nilpotent_exists {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (N : VonNeumannAlgebra H)\r\n    (h : ∃ T : H →L[ℂ] H, T ∈ N ∧ T ≠ 0 ∧ T*T = 0) :\r\n    ∃ (e : {B : H →L[ℂ] H // B ∈ N ∧ 0 ≤ B}) (v : N.toStarSubalgebra),\r\n      IsStarProjection e.val ∧ e ≠ ⟨0,N.zero_mem,le_rfl⟩ ∧\r\n      star v.val*v.val = e.val ∧ e.val*v.val = 0 := by\r\n  obtain ⟨T,hTm,hT,hTT⟩ := h\r\n  obtain ⟨e,v,hem,hvm,he,hene,hve,hev⟩ :=\r\n    F1Fecho.MatrixCornerFromNilpotent.matrix_corner_of_square_zero N T hTm hT hTT\r\n  refine ⟨⟨e,hem,he.nonneg⟩,⟨v,hvm⟩,he,?_,hve,hev⟩\r\n  intro hz\r\n  exact hene (congrArg Subtype.val hz)\r\n\r\nprivate abbrev fockNormedAddCommGroup : NormedAddCommGroup F := inferInstance\r\nprivate abbrev fockInnerProductSpace : InnerProductSpace ℂ F := inferInstance\r\nprivate abbrev fockCompleteSpace : CompleteSpace F := inferInstance\r\nprivate abbrev AmbientHilbert := RegularHilbert F\r\nprivate abbrev ambientNormedAddCommGroup : NormedAddCommGroup AmbientHilbert := inferInstance\r\nprivate abbrev ambientInnerProductSpace : InnerProductSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientNormedSpace : NormedSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientModule : Module ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientTopologicalSpace : TopologicalSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientUniformSpace : UniformSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientCompleteSpace : CompleteSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientStar : Star (AmbientHilbert →L[ℂ] AmbientHilbert) := inferInstance\r\nprivate abbrev ambientOrder : PartialOrder (AmbientHilbert →L[ℂ] AmbientHilbert) :=\r\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := AmbientHilbert)\r\nattribute [local instance] ambientNormedAddCommGroup ambientInnerProductSpace\r\n  ambientNormedSpace ambientModule ambientTopologicalSpace ambientUniformSpace\r\n  ambientCompleteSpace ambientStar ambientOrder\r\n\r\nprivate theorem weyl_mul_neg (f : H1) : FieldWeyl.W f * FieldWeyl.W (-f) = 1 := by\r\n  rw [FieldWeyl.W_ccr,phase_self_neg,add_neg_cancel,FieldWeyl.W_zero,one_smul]\r\n\r\ntheorem weyl_real_part_ne_zero (f : H1) : FieldWeyl.W f + star (FieldWeyl.W f) ≠ 0 := by\r\n  intro hz\r\n  have hv := congrArg (fun B : F →L[ℂ] F => inner ℂ vacuum (B vacuum)) hz\r\n  simp only [ContinuousLinearMap.add_apply,inner_add_right,FieldWeyl.W_star,\r\n    FieldWeyl.vacuum_characteristic,norm_neg,ContinuousLinearMap.zero_apply,inner_zero_right] at hv\r\n  have hv' : (2 : ℂ)*Complex.exp (-((‖f‖ : ℂ)^2)/2) = 0 := by\r\n    simpa only [two_mul] using hv\r\n  exact Complex.exp_ne_zero _ ((mul_eq_zero.mp hv').resolve_left (by norm_num))\r\n#print axioms weyl_real_part_ne_zero\r\n\r\ntheorem wedge_nilpotent_exists : ∃ T : F →L[ℂ] F, T ∈ M ∧ T ≠ 0 ∧ T*T = 0 := by\r\n  obtain ⟨f,hf,g,hg,hfg⟩ := normalized_pair\r\n  let X := FieldWeyl.W f\r\n  let U := FieldWeyl.W g\r\n  have hx : X ∈ M := FieldWeyl.W_mem_R _ f hf\r\n  have hu : U ∈ M := FieldWeyl.W_mem_R _ g hg\r\n  have huR : U*star U = 1 := by\r\n    change FieldWeyl.W g * star (FieldWeyl.W g) = 1\r\n    rw [FieldWeyl.W_star]\r\n    exact weyl_mul_neg g\r\n  have huL : star U*U = 1 := by\r\n    change star (FieldWeyl.W g) * FieldWeyl.W g = 1\r\n    rw [FieldWeyl.W_star]\r\n    simpa only [neg_neg] using weyl_mul_neg (-g)\r\n  obtain ⟨hp,hq⟩ := phase_half_pi f g hfg\r\n  have hanti : U*X = -(X*U) := by\r\n    change FieldWeyl.W g*FieldWeyl.W f = -(FieldWeyl.W f*FieldWeyl.W g)\r\n    rw [FieldWeyl.W_ccr,FieldWeyl.W_ccr,hq,hp,add_comm g f,neg_smul,neg_neg]\r\n  have hxflip : U*X*star U = -X := by\r\n    rw [hanti,neg_mul,mul_assoc,huR,mul_one]\r\n  have hAm : X+star X ∈ M := M.add_mem hx (M.toStarSubalgebra.star_mem' hx)\r\n  have hAs : IsSelfAdjoint (X+star X) :=\r\n    @real_part_selfAdjoint F fockNormedAddCommGroup fockInnerProductSpace\r\n      fockCompleteSpace X\r\n  have hflip : U*(X+star X)*star U = -(X+star X) :=\r\n    @real_part_flip F fockNormedAddCommGroup fockInnerProductSpace\r\n      fockCompleteSpace X U hxflip\r\n  exact @nilpotent_of_sign_flip F fockNormedAddCommGroup fockInnerProductSpace\r\n    fockCompleteSpace M (X+star X) U hAm hu hAs (weyl_real_part_ne_zero f) huL huR hflip\r\n#print axioms wedge_nilpotent_exists\r\n\r\ntheorem core_nilpotent_exists :\r\n    ∃ T : AmbientHilbert →L[ℂ] AmbientHilbert, T ∈ core ∧ T ≠ 0 ∧ T*T = 0 := by\r\n  obtain ⟨T,hTm,hT,hTT⟩ := wedge_nilpotent_exists\r\n  refine ⟨fibre T,F1Fecho.CanonicalFockRegular.fibre_mem T hTm,?_,?_⟩\r\n  · intro hz\r\n    apply hT\r\n    apply fibre_injective\r\n    exact hz.trans (map_zero fibreRepresentation).symm\r\n  · rw [← fibre_mul,hTT]\r\n    exact map_zero fibreRepresentation\r\n#print axioms core_nilpotent_exists\r\n\r\n/-- The orthogonal corner needed by the finite split, on the unchanged core. -/\r\ntheorem core_matrix_corner :\r\n    ∃ (e : PositiveInput) (v : core.toStarSubalgebra),\r\n      IsStarProjection e.val ∧ e ≠ zero ∧ star v.val*v.val = e.val ∧ e.val*v.val = 0 := by\r\n  exact @positive_corner_from_nilpotent_exists AmbientHilbert\r\n    ambientNormedAddCommGroup ambientInnerProductSpace ambientCompleteSpace\r\n    core core_nilpotent_exists\r\n#print axioms core_matrix_corner\r\n\r\nend F1Fecho.CanonicalFockMatrixCornerR2\r\n",
+    'TGLExt/F1Fecho394/CanonicalFockModularCoreInputR1.lean': 'import TGLExt.F1Fecho394.CanonicalFockCyclicTraceCompletionR3\r\nimport TGLExt.F1Fecho394.CanonicalFockNormalizedSplitR5\r\nimport TGLExt.F1Fecho394.PhysicalFockNetRealizationR2\r\n\r\n/-! DECLARADO / UNCOMPILED CANDIDATE, R52, 2026-10-16.\r\nAll 21 fields of the unchanged RemainingModularCoreInput are assembled from\r\nthe existing cyclic ENNReal completion and the normalized positive split on\r\nthe SAME regular Fock core. D stays explicit in the generic factory; the\r\nphysical specialization reuses the already constructed physicalCanonicalNet.\r\nNo trace, PF, corner, type-II, net inhabitance or equal-halves premise is added.\r\nThe positive reading agrees exactly with the existing inverse-supremum value.\r\nThis ENNReal cyclic completion does not assert complex linearity on the whole\r\nalgebra or a factor-type classification. Device and geometric-source contracts\r\nremain separate. SplitR5 is a candidate dependency and must compile first.\r\nRequire EXIT0 and all eleven public reports before integration. -/\r\nset_option Elab.async false\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 400000\r\nset_option synthInstance.maxHeartbeats 500000\r\nset_option maxErrors 10\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockModularCoreInputR1\r\nopen TGLExt.ImportedSQ TGLV350.Regular\r\nopen F1Fecho.NetworkReuse (CanonicalNetInput)\r\nopen F1Fecho.NetworkModularCore (RepresentedCore RemainingModularCoreInput coreEmbedding)\r\nopen F1Fecho.CanonicalFockRegular (core dualAction)\r\nopen F1Fecho.CanonicalFockWeight (PositiveInput add)\r\nopen F1Fecho.CanonicalFockInverseSupremum (value)\r\nopen F1Fecho.CanonicalFockActualInverseAdditivityR2 (value_add)\r\nopen F1Fecho.CanonicalFockPositiveShiftTransportR2 (positiveAsCore)\r\nopen F1Fecho.CanonicalFockCyclicTraceCompletionR3\r\nopen F1Fecho.CanonicalFockNormalizedSplitR5 (normalized_split_exists)\r\nopen F1Fecho.MaxwellLocalization (physicalCanonicalNet)\r\nopen scoped ENNReal\r\n\r\nprivate abbrev AmbientHilbert := RegularHilbert F1Rede.BosonicFock.F\r\nprivate abbrev ambientNormedAddCommGroup : NormedAddCommGroup AmbientHilbert := inferInstance\r\nprivate abbrev ambientInnerProductSpace : InnerProductSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientNormedSpace : NormedSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientModule : Module ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientTopologicalSpace : TopologicalSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientUniformSpace : UniformSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientCompleteSpace : CompleteSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientStar : Star (AmbientHilbert →L[ℂ] AmbientHilbert) := inferInstance\r\nprivate abbrev ambientOrder : PartialOrder (AmbientHilbert →L[ℂ] AmbientHilbert) :=\r\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := AmbientHilbert)\r\nattribute [local instance] ambientNormedAddCommGroup ambientInnerProductSpace\r\n  ambientNormedSpace ambientModule ambientTopologicalSpace ambientUniformSpace\r\n  ambientCompleteSpace ambientStar ambientOrder\r\n\r\nprivate def leftPositive : PositiveInput := Classical.choose normalized_split_exists\r\nprivate def rightPositive : PositiveInput :=\r\n  Classical.choose (Classical.choose_spec normalized_split_exists)\r\n\r\nprivate theorem chosen_split :\r\n    IsStarProjection leftPositive.val ∧ IsStarProjection rightPositive.val ∧\r\n      leftPositive.val*rightPositive.val=0 ∧\r\n      value (add leftPositive rightPositive)=1 ∧ value leftPositive=value rightPositive :=\r\n  Classical.choose_spec (Classical.choose_spec normalized_split_exists)\r\n\r\nprivate theorem chosen_sum_projection :\r\n    IsStarProjection (add leftPositive rightPositive).val :=\r\n  chosen_split.1.add chosen_split.2.1 chosen_split.2.2.1\r\n\r\nprivate theorem chosen_sum_trace :\r\n    cyclicTraceCandidate (positiveAsCore (add leftPositive rightPositive))=1 :=\r\n  (cyclicTraceCandidate_positive _).trans chosen_split.2.2.2.1\r\n\r\nprivate theorem chosen_sum_ne_zero :\r\n    positiveAsCore (add leftPositive rightPositive) ≠ 0 := by\r\n  intro hz\r\n  exact one_ne_zero (chosen_sum_trace.symm.trans\r\n    ((congrArg cyclicTraceCandidate hz).trans cyclicTraceCandidate_zero))\r\n\r\n/-- The full existing modular-core input, with only the global net D explicit. -/\r\ndef modularCoreInput (D : CanonicalNetInput) : RemainingModularCoreInput D where\r\n  trace := cyclicTraceCandidate\r\n  trace_zero := cyclicTraceCandidate_zero\r\n  trace_tracial := cyclicTraceCandidate_cyclic\r\n  trace_star := cyclicTraceCandidate_star\r\n  trace_dual_scaling := cyclicTraceCandidate_dual\r\n  PF := positiveAsCore (add leftPositive rightPositive)\r\n  PF_sa := Subtype.ext chosen_sum_projection.isSelfAdjoint.star_eq\r\n  PF_idem := Subtype.ext chosen_sum_projection.isIdempotentElem\r\n  PF_ne := chosen_sum_ne_zero\r\n  PF_pos := chosen_sum_trace.symm ▸ (zero_lt_one : (0 : ℝ≥0∞)<1)\r\n  PF_fin := chosen_sum_trace.symm ▸ ENNReal.one_lt_top\r\n  Pp := positiveAsCore leftPositive\r\n  Pm := positiveAsCore rightPositive\r\n  Pp_sa := Subtype.ext chosen_split.1.isSelfAdjoint.star_eq\r\n  Pp_idem := Subtype.ext chosen_split.1.isIdempotentElem\r\n  Pm_sa := Subtype.ext chosen_split.2.1.isSelfAdjoint.star_eq\r\n  Pm_idem := Subtype.ext chosen_split.2.1.isIdempotentElem\r\n  split := rfl\r\n  orth := Subtype.ext chosen_split.2.2.1\r\n  trace_additive := (cyclicTraceCandidate_positive _).trans\r\n    ((value_add leftPositive rightPositive).trans\r\n      (congrArg₂ (fun x y : ℝ≥0∞ => x+y)\r\n        (cyclicTraceCandidate_positive leftPositive).symm\r\n        (cyclicTraceCandidate_positive rightPositive).symm))\r\n  equal_halves := (cyclicTraceCandidate_positive leftPositive).trans\r\n    (chosen_split.2.2.2.2.trans (cyclicTraceCandidate_positive rightPositive).symm)\r\n#print axioms modularCoreInput\r\n\r\n