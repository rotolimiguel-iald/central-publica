ntheorem momentumSmear_smul (c : ℂ) (f : SchwartzTensor) :\r\n    momentumSmear (c•f)=c•momentumSmear f := by\r\n  apply Lp.ext\r\n  filter_upwards [(globalCoefficient_memLp (c•f)).coeFn_toLp,\r\n    (globalCoefficient_memLp f).coeFn_toLp,Lp.coeFn_smul c (momentumSmear f)] with y h1 h2 h3\r\n  simp only [momentumSmear] at *\r\n  rw [h1,h3]\r\n  simp only [Pi.smul_apply]\r\n  rw [h2]\r\n  exact congrFun (globalCoefficient_smul c f) y\r\n\r\ndef momentumSmearLinear : SchwartzTensor →ₗ[ℂ] H1 where\r\n  toFun := momentumSmear\r\n  map_add' := momentumSmear_add\r\n  map_smul' c f := by simpa using momentumSmear_smul c f\r\n\r\ndef spacetimeSmearLinear : SchwartzTensor →ₗ[ℂ] H1 where\r\n  toFun := spacetimeSmear\r\n  map_add' f g := by simp only [spacetimeSmear,minkowskiFourier_add,momentumSmear_add]\r\n  map_smul' c f := by simp only [spacetimeSmear,minkowskiFourier_smul,momentumSmear_smul,RingHom.id_apply]\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.globalCoefficient_add\r\n#print axioms F1Fecho.MaxwellGlobal.globalCoefficient_smul\r\n#print axioms F1Fecho.MaxwellGlobal.spacetimeSmearLinear\r\n",
+    'TGLExt/F1Fecho394/SchwartzMaxwellNonzeroR6.lean': "import TGLExt.F1Fecho394.SchwartzMaxwellSmearingR4\r\nimport Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension\r\n\r\n/-! A genuine spacetime Schwartz test with nonzero H1 image. The witness is\r\nobtained by inverse Minkowski Fourier from a compact smooth momentum bump.\r\nIt does not claim compact spacetime support or spacetime locality. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen MeasureTheory Filter Matrix SchwartzMap Set\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\n\r\ndef tensorUnit01 : TensorValue :=\r\n  fun μ ν => if μ=0 ∧ ν=1 then 1 else if μ=1 ∧ ν=0 then -1 else 0\r\n\r\ntheorem tensor01_coefficient (f : SchwartzTensor) (b : Spacetime→ℂ)\r\n    (hf : ∀ p,f p=b p•tensorUnit01) (y : MomentumCoordinates) :\r\n    globalCoefficient f y 0=b (shellEmbedding y)*(transverseMass 0 y.1:ℂ) := by\r\n  change (1/2:ℂ)*(∑ μ,∑ ν,(cartesianStrength y 0 μ ν:ℂ)*f (shellEmbedding y) μ ν)=_\r\n  rw [hf]\r\n  have h20 : (2:Fin 4)≠0 := by decide\r\n  have h21 : (2:Fin 4)≠1 := by decide\r\n  have h30 : (3:Fin 4)≠0 := by decide\r\n  have h31 : (3:Fin 4)≠1 := by decide\r\n  norm_num [Fin.sum_univ_four,tensorUnit01,h20,h21,h30,h31,cartesianStrength,\r\n    Matrix.cons_val_zero',Matrix.cons_val_succ',Pi.smul_apply,smul_eq_mul]\r\n  ring\r\n\r\ntheorem momentumSmear_nonzero_tensor01 (f : SchwartzTensor) (b : Spacetime→ℂ)\r\n    (hb : Continuous b) (hf : ∀ p,f p=b p•tensorUnit01)\r\n    (y : MomentumCoordinates) (hy : b (shellEmbedding y)*(transverseMass 0 y.1:ℂ)≠0) :\r\n    momentumSmear f≠0 := by\r\n  intro hz\r\n  have hcoe := (globalCoefficient_memLp f).coeFn_toLp\r\n  change momentumSmear f =ᵐ[orbitalMeasure 0] globalCoefficient f at hcoe\r\n  rw [hz] at hcoe\r\n  have ha : globalCoefficient f =ᵐ[orbitalMeasure 0] (fun _ => (0:Fib)) :=\r\n    hcoe.symm.trans (Lp.coeFn_zero Fib 2 (orbitalMeasure 0))\r\n  have hscalar : (fun z => b (shellEmbedding z)*(transverseMass 0 z.1:ℂ)) =ᵐ[orbitalMeasure 0]\r\n      (fun _ => (0:ℂ)) := by\r\n    filter_upwards [ha] with z hz\r\n    have ht:=congrArg (fun v : Fib => v 0) hz\r\n    simpa [tensor01_coefficient f b hf] using ht\r\n  letI := orbitalMeasure_openPos 0\r\n  have hc : Continuous (fun z : MomentumCoordinates =>\r\n      b (shellEmbedding z)*(transverseMass 0 z.1:ℂ)) :=\r\n    (hb.comp shellEmbedding_continuous).mul (by unfold transverseMass; fun_prop)\r\n  have he := (hc.ae_eq_iff_eq (orbitalMeasure 0) continuous_const).mp hscalar\r\n  exact hy (congrFun he y)\r\n\r\ntheorem exists_nonzero_momentumSmear : ∃ f : SchwartzTensor,momentumSmear f≠0 := by\r\n  let y : MomentumCoordinates := (![1,0],0)\r\n  obtain ⟨b,_,hbc,hbs,_,hb1⟩ := exists_contDiff_tsupport_subset\r\n    (x:=shellEmbedding y) (n:=⊤) (s:=Set.univ) (Filter.univ_mem)\r\n  let v : Spacetime→TensorValue := fun p => (b p:ℂ)•tensorUnit01\r\n  have hvC : HasCompactSupport v := hbc.of_isClosed_subset (isClosed_tsupport _) (by\r\n    apply closure_mono\r\n    intro p hp\r\n    contrapose! hp\r\n    simp only [Function.mem_support] at hp ⊢\r\n    simp [v,hp])\r\n  have hvD : ContDiff ℝ (⊤ : ℕ∞) v := by\r\n    convert hbs.smul (contDiff_const (c:=tensorUnit01)) using 1\r\n    funext p\r\n    simp [v]\r\n  let f : SchwartzTensor := hvC.toSchwartzMap hvD\r\n  refine ⟨f,momentumSmear_nonzero_tensor01 f (fun p => (b p:ℂ))\r\n    (Complex.continuous_ofReal.comp hbs.continuous) (fun _ => rfl) y ?_⟩\r\n  simp [hb1,y,transverseMass]\r\n\r\ntheorem exists_nonzero_spacetimeSmear : ∃ f : SchwartzTensor,spacetimeSmear f≠0 := by\r\n  obtain ⟨g,hg⟩ := exists_nonzero_momentumSmear\r\n  obtain ⟨f,hf⟩ := minkowskiFourier_surjective g\r\n  exact ⟨f,by simpa only [spacetimeSmear,hf] using hg⟩\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.tensor01_coefficient\r\n#print axioms F1Fecho.MaxwellGlobal.exists_nonzero_momentumSmear\r\n#print axioms F1Fecho.MaxwellGlobal.exists_nonzero_spacetimeSmear\r\n",
+    'TGLExt/F1Fecho394/SchwartzMaxwellSmearingR4.lean': "import TGLExt.F1Fecho394.MinkowskiSchwartzFourierR4\r\nimport Mathlib.Analysis.Distribution.SchwartzSpace.Fourier\r\n\r\n/-! Actual spacetime Schwartz tests, Fourier transformed and restricted to the\r\nphysical mass shell, are mapped into the original H1. Integrability is proved\r\nfrom energy cancellation and Schwartz decay, not supplied as a field. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen MeasureTheory Matrix SchwartzMap Filter\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\nopen F1Fecho.SchwartzRestriction\r\nopen scoped FourierTransform ENNReal\r\n\r\ntheorem shell_weighted_square_integrable (f : SchwartzTensor) :\r\n    Integrable (fun y => shellEnergy y*‖f (shellEmbedding y)‖^2) momentumMeasure := by\r\n  letI : momentumMeasure.IsAddHaarMeasure := by unfold momentumMeasure; infer_instance\r\n  exact energy_weighted_square_integrable f shellEmbedding shellEnergy\r\n    (by norm_num : (0:ℝ)≤2) shellEmbedding_proper_bound energy_le_twice_coordinate_norm\r\n    shellEnergy_nonneg shellEmbedding_continuous.measurable shellEnergy_continuous.measurable\r\n\r\ntheorem density_normsq_bound (f : SchwartzTensor) (y : MomentumCoordinates) :\r\n    ‖(orbitalWeight 0 y).toReal • ‖globalCoefficient f y‖^2‖ ≤\r\n      128*(shellEnergy y*‖f (shellEmbedding y)‖^2) := by\r\n  have hp:=shellEnergy_nonneg y\r\n  have hw : (orbitalWeight 0 y).toReal=1/shellEnergy y := by\r\n    unfold orbitalWeight shellEnergy\r\n    exact ENNReal.toReal_ofReal (by positivity)\r\n  rw [hw,smul_eq_mul,Real.norm_of_nonneg (mul_nonneg (by positivity) (sq_nonneg _))]\r\n  by_cases hz : shellEnergy y=0\r\n  · simp [hz]\r\n  · calc\r\n      (1/shellEnergy y)*‖globalCoefficient f y‖^2 ≤\r\n          (1/shellEnergy y)*(128*shellEnergy y^2*‖f (shellEmbedding y)‖^2) :=\r\n        mul_le_mul_of_nonneg_left (globalCoefficient_sq_bound f y) (by positivity)\r\n      _ = 128*(shellEnergy y*‖f (shellEmbedding y)‖^2) := by field_simp [hz]\r\n\r\ntheorem globalCoefficient_memLp (f : SchwartzTensor) :\r\n    MemLp (globalCoefficient f) 2 (orbitalMeasure 0) := by\r\n  apply (memLp_two_iff_integrable_sq_norm (globalCoefficient_measurable f).aestronglyMeasurable).mpr\r\n  change Integrable (fun y => ‖globalCoefficient f y‖^2)\r\n    (momentumMeasure.withDensity (orbitalWeight 0))\r\n  apply (integrable_withDensity_iff_integrable_smul' (orbitalWeight_measurable 0)\r\n    (Filter.Eventually.of_forall (fun y => ENNReal.ofReal_lt_top))).mpr\r\n  apply ((shell_weighted_square_integrable f).const_mul 128).mono'\r\n  · exact (((orbitalWeight_measurable 0).ennreal_toReal).mul\r\n      ((globalCoefficient_measurable f).norm.pow_const 2)).aestronglyMeasurable\r\n  · exact Filter.Eventually.of_forall (density_normsq_bound f)\r\n\r\ndef momentumSmear (f : SchwartzTensor) : H1 :=\r\n  (globalCoefficient_memLp f).toLp (globalCoefficient f)\r\n\r\ndef spacetimeSmear (f : SchwartzTensor) : H1 := momentumSmear (minkowskiFourier f)\r\n\r\ntheorem spacetimeSmear_ae (f : SchwartzTensor) :\r\n    spacetimeSmear f =ᵐ[orbitalMeasure 0] globalCoefficient (minkowskiFourier f) :=\r\n  (globalCoefficient_memLp (minkowskiFourier f)).coeFn_toLp\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.shell_weighted_square_integrable\r\n#print axioms F1Fecho.MaxwellGlobal.density_normsq_bound\r\n#print axioms F1Fecho.MaxwellGlobal.globalCoefficient_memLp\r\n#print axioms F1Fecho.MaxwellGlobal.spacetimeSmear\r\n#print axioms F1Fecho.MaxwellGlobal.spacetimeSmear_ae\r\n",
+    'TGLExt/F1Fecho394/SchwartzRestrictionEstimateR2.lean': 'import Mathlib.Analysis.Distribution.SchwartzSpace.Basic\r\n\r\n/-! A proper measurable restriction of a Schwartz function has an integrable\r\nenergy-weighted square when the energy grows at most linearly. The hypotheses\r\nare geometric estimates on the restriction, not an integrability assumption. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.SchwartzRestriction\r\nopen MeasureTheory SchwartzMap\r\nvariable {X E V : Type*}\r\n  [NormedAddCommGroup X] [NormedSpace ℝ X] [MeasurableSpace X] [BorelSpace X]\r\n  [SecondCountableTopology X] {μ : Measure X} [μ.HasTemperateGrowth]\r\n  [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E]\r\n  [NormedAddCommGroup V] [NormedSpace ℝ V] [MeasurableSpace V] [BorelSpace V]\r\n\r\ntheorem weighted_restriction_decay (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (n : ℕ) (x : X) :\r\n    ‖x‖^n*(w x*‖f (j x)‖^2) ≤\r\n      C*(SchwartzMap.seminorm ℝ (n+1) 0 f)*(SchwartzMap.seminorm ℝ 0 0 f) := by\r\n  have hN := f.norm_pow_mul_le_seminorm ℝ (n+1) (j x)\r\n  have h0 := f.norm_le_seminorm ℝ (j x)\r\n  have hp : ‖x‖^(n+1)*‖f (j x)‖≤SchwartzMap.seminorm ℝ (n+1) 0 f :=\r\n    (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hj x) _) (norm_nonneg _)).trans hN\r\n  calc\r\n    ‖x‖^n*(w x*‖f (j x)‖^2) ≤ ‖x‖^n*((C*‖x‖)*‖f (j x)‖^2) :=\r\n      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (hw x) (sq_nonneg _)) (by positivity)\r\n    _ = C*(‖x‖^(n+1)*‖f (j x)‖)*‖f (j x)‖ := by rw [pow_succ]; ring\r\n    _ ≤ C*(SchwartzMap.seminorm ℝ (n+1) 0 f)*(SchwartzMap.seminorm ℝ 0 0 f) := by\r\n      exact mul_le_mul (mul_le_mul_of_nonneg_left hp hC) h0 (norm_nonneg _)\r\n        (mul_nonneg hC (apply_nonneg _ _))\r\n\r\ntheorem energy_weighted_square_integrable (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (hwp : ∀ x,0≤w x) (hjm : Measurable j) (hwm : Measurable w) :\r\n    Integrable (fun x => w x*‖f (j x)‖^2) μ := by\r\n  have hn (x : X) : ‖w x*‖f (j x)‖^2‖=w x*‖f (j x)‖^2 :=\r\n    Real.norm_of_nonneg (mul_nonneg (hwp x) (sq_nonneg _))\r\n  have hmeas : AEStronglyMeasurable (fun x => w x*‖f (j x)‖^2) μ :=\r\n    (hwm.mul ((f.continuous.measurable.comp hjm).norm.pow_const 2)).aestronglyMeasurable\r\n  have hi := integrable_of_le_of_pow_mul_le (μ:=μ) (k:=0)\r\n    (f:=fun x => w x*‖f (j x)‖^2)\r\n    (fun x => by simpa [hn x] using weighted_restriction_decay f j w hC hj hw 0 x)\r\n    (fun x => by simpa [hn x] using weighted_restriction_decay f j w hC hj hw μ.integrablePower x)\r\n    hmeas\r\n  simpa only [pow_zero,one_mul,hn] using hi\r\n\r\nend F1Fecho.SchwartzRestriction\r\n#print axioms F1Fecho.SchwartzRestriction.weighted_restriction_decay\r\n#print axioms F1Fecho.SchwartzRestriction.energy_weighted_square_integrable\r\n',
+    'TGLExt/F1Fecho394/SchwartzRestrictionMomentsR1.lean': 'import TGLExt.F1Fecho394.SchwartzRestrictionEstimateR2\r\n\r\n/-! Every nonnegative integer energy moment of a proper Schwartz restriction is\r\nintegrable. This supplies a regular, concrete domain for pointwise wave kernels. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.SchwartzRestriction\r\nopen MeasureTheory SchwartzMap\r\nvariable {X E V : Type*}\r\n  [NormedAddCommGroup X] [NormedSpace ℝ X] [MeasurableSpace X] [BorelSpace X]\r\n  [SecondCountableTopology X] {μ : Measure X} [μ.HasTemperateGrowth]\r\n  [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E]\r\n  [NormedAddCommGroup V] [NormedSpace ℝ V] [MeasurableSpace V] [BorelSpace V]\r\n\r\ntheorem weighted_restriction_moment_decay (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (hwp : ∀ x,0≤w x) (m n : ℕ) (x : X) :\r\n    ‖x‖^n*(w x^m*‖f (j x)‖) ≤ C^m*SchwartzMap.seminorm ℝ (n+m) 0 f := by\r\n  have hp : ‖x‖^(n+m)*‖f (j x)‖≤SchwartzMap.seminorm ℝ (n+m) 0 f :=\r\n    (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hj x) _) (norm_nonneg _)).trans\r\n      (f.norm_pow_mul_le_seminorm ℝ (n+m) (j x))\r\n  calc\r\n    _ ≤ ‖x‖^n*((C*‖x‖)^m*‖f (j x)‖) :=\r\n      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right\r\n        (pow_le_pow_left₀ (hwp x) (hw x) m) (norm_nonneg _)) (by positivity)\r\n    _ = C^m*(‖x‖^(n+m)*‖f (j x)‖) := by rw [mul_pow,pow_add]; ring\r\n    _ ≤ _ := mul_le_mul_of_nonneg_left hp (by positivity)\r\n\r\ntheorem energy_moment_restriction_integrable (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (hwp : ∀ x,0≤w x) (hjm : Measurable j) (hwm : Measurable w) (m : ℕ) :\r\n    Integrable (fun x=>w x^m*‖f (j x)‖) μ := by\r\n  have hn (x : X) : ‖w x^m*‖f (j x)‖‖=w x^m*‖f (j x)‖ :=\r\n    Real.norm_of_nonneg (mul_nonneg (pow_nonneg (hwp x) _) (norm_nonneg _))\r\n  have hm : AEStronglyMeasurable (fun x=>w x^m*‖f (j x)‖) μ :=\r\n    ((hwm.pow_const m).mul (f.continuous.measurable.comp hjm).norm).aestronglyMeasurable\r\n  have hi:=integrable_of_le_of_pow_mul_le (μ:=μ) (k:=0)\r\n    (f:=fun x=>w x^m*‖f (j x)‖)\r\n    (fun x=>by simpa [hn x] using weighted_restriction_moment_decay f j w hC hj hw hwp m 0 x)\r\n    (fun x=>by simpa [hn x] using weighted_restriction_moment_decay f j w hC hj hw hwp m μ.integrablePower x) hm\r\n  simpa only [pow_zero,one_mul,hn] using hi\r\nend F1Fecho.SchwartzRestriction\r\n#print axioms F1Fecho.SchwartzRestriction.weighted_restriction_moment_decay\r\n#print axioms F1Fecho.SchwartzRestriction.energy_moment_restriction_integrable\r\n',
+    'TGLExt/F1Fecho394/SchwartzRestrictionSquareMomentsR1.lean': 'import TGLExt.F1Fecho394.SchwartzRestrictionMomentsR1\r\n\r\n/-! All quadratic energy moments of the same Schwartz restriction. L1 moments\r\nalone give pointwise waves; these L2 moments also control finite kinetic energy. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.SchwartzRestriction\r\nopen MeasureTheory SchwartzMap\r\nvariable {X E V : Type*}\r\n  [NormedAddCommGroup X] [NormedSpace ℝ X] [MeasurableSpace X] [BorelSpace X]\r\n  [SecondCountableTopology X] {μ : Measure X} [μ.HasTemperateGrowth]\r\n  [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E] [BorelSpace E]\r\n  [NormedAddCommGroup V] [NormedSpace ℝ V] [MeasurableSpace V] [BorelSpace V]\r\n\r\ntheorem weighted_restriction_square_moment_decay (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (hwp : ∀ x,0≤w x) (m n : ℕ) (x : X) :\r\n    ‖x‖^n*(w x^m*‖f (j x)‖^2) ≤\r\n      C^m*SchwartzMap.seminorm ℝ (n+m) 0 f*SchwartzMap.seminorm ℝ 0 0 f := by\r\n  have h:=mul_le_mul (weighted_restriction_moment_decay f j w hC hj hw hwp m n x)\r\n    (f.norm_le_seminorm ℝ (j x)) (norm_nonneg _)\r\n    (mul_nonneg (pow_nonneg hC _) (apply_nonneg _ _))\r\n  calc\r\n    _ = (‖x‖^n*(w x^m*‖f (j x)‖))*‖f (j x)‖ := by ring\r\n    _ ≤ _ := h\r\n\r\ntheorem energy_moment_square_restriction_integrable (f : 𝓢(E,V)) (j : X→E) (w : X→ℝ)\r\n    {C : ℝ} (hC : 0≤C) (hj : ∀ x,‖x‖≤‖j x‖) (hw : ∀ x,w x≤C*‖x‖)\r\n    (hwp : ∀ x,0≤w x) (hjm : Measurable j) (hwm : Measurable w) (m : ℕ) :\r\n    Integrable (fun x=>w x^m*‖f (j x)‖^2) μ := by\r\n  have hn (x : X) : ‖w x^m*‖f (j x)‖^2‖=w x^m*‖f (j x)‖^2 :=\r\n    Real.norm_of_nonneg (mul_nonneg (pow_nonneg (hwp x) _) (sq_nonneg _))\r\n  have hm : AEStronglyMeasurable (fun x=>w x^m*‖f (j x)‖^2) μ :=\r\n    ((hwm.pow_const m).mul ((f.continuous.measurable.comp hjm).norm.pow_const 2)).aestronglyMeasurable\r\n  have hi:=integrable_of_le_of_pow_mul_le (μ:=μ) (k:=0)\r\n    (f:=fun x=>w x^m*‖f (j x)‖^2)\r\n    (fun x=>by simpa [hn x] using weighted_restriction_square_moment_decay f j w hC hj hw hwp m 0 x)\r\n    (fun x=>by simpa [hn x] using weighted_restriction_square_moment_decay f j w hC hj hw hwp m μ.integrablePower x) hm\r\n  simpa only [pow_zero,one_mul,hn] using hi\r\nend F1Fecho.SchwartzRestriction\r\n#print axioms F1Fecho.SchwartzRestriction.weighted_restriction_square_moment_decay\r\n#print axioms F1Fecho.SchwartzRestriction.energy_moment_square_restriction_integrable\r\n',
+    'TGLExt/F1Fecho394/ScreenChargeConjugationR2.lean': "import TGLExt.F1Fecho394.ScreenFutureHelicityR2\r\nimport TGLExt.F1Fecho394.GeometricFiberConjugation\r\n\r\n/-! The existing helicity-exchanging fiber conjugation acts on canonical H1.\r\nIts Lorentz commutation is proved from the actual circular phase formula. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen MeasureTheory Filter Matrix Complex\r\nnamespace F1Fecho.OrbitalScreen\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016 ChatgptAudit.WignerOrbit016\r\nopen F1Fecho.OrbitalSpatial F1Rede.FiberConjugation\r\n\r\ndef thetaMap : H1 →SL[starRingEnd ℂ] H1 :=\r\n  fiberSwappedJ.toContinuousLinearEquiv.toContinuousLinearMap.compLpL 2 (orbitalMeasure 0)\r\n\r\ntheorem thetaMap_ae (f : H1) : thetaMap f=ᵐ[orbitalMeasure 0] fun p => fiberSwappedJ (f p) :=\r\n  fiberSwappedJ.toContinuousLinearEquiv.toContinuousLinearMap.coeFn_compLpL f\r\n\r\ntheorem thetaMap_involutive : Function.Involutive thetaMap := by\r\n  intro f\r\n  apply Lp.ext\r\n  filter_upwards [thetaMap_ae (thetaMap f),thetaMap_ae f] with p hp hq\r\n  rw [hp,hq,fiberSwappedJ_involutive]\r\n\r\ntheorem thetaMap_norm (f : H1) : ‖thetaMap f‖=‖f‖ := by\r\n  simp only [Lp.norm_def]\r\n  congr 1\r\n  apply eLpNorm_congr_norm_ae\r\n  filter_upwards [thetaMap_ae f] with p hp\r\n  rw [hp,fiberSwappedJ.norm_map]\r\n\r\ndef Theta : H1 ≃ₛₗᵢ[starRingEnd ℂ] H1 where\r\n  toLinearEquiv := {thetaMap.toLinearMap with\r\n    invFun := thetaMap\r\n    left_inv := thetaMap_involutive\r\n    right_inv := thetaMap_involutive}\r\n  norm_map' := thetaMap_norm\r\n\r\ntheorem Theta_ae (f : H1) : Theta f=ᵐ[orbitalMeasure 0] fun p => fiberSwappedJ (f p) :=\r\n  thetaMap_ae f\r\n\r\ntheorem Theta_involutive : Function.Involutive Theta := thetaMap_involutive\r\n\r\ntheorem phaseMatrix_swappedJ (z : ℂ) (v : Fiber) :\r\n    fiberSwappedJ (matrixFiberOperator (phaseMatrix z) v)=\r\n      matrixFiberOperator (phaseMatrix z) (fiberSwappedJ v) := by\r\n  ext i\r\n  fin_cases i <;>\r\n    simp [matrixFiberOperator,Matrix.ofLp_toEuclideanCLM,phaseMatrix,\r\n      Matrix.mulVec,dotProduct,Fin.sum_univ_two,fiberSwappedJ_apply,helicitySwap]\r\n\r\ntheorem Theta_helicity (L : generatedLorentz) (hd : L.val.val.det=1) (f : H1) :\r\n    Theta (helicityUnitary L f)=helicityUnitary L (Theta f) := by\r\n  have hc := (shellAction_lift L⁻¹).1.quasiMeasurePreserving.ae (Theta_ae f)\r\n  apply Lp.ext\r\n  filter_upwards [Theta_ae (helicityUnitary L f),helicityUnitary_diagonal_ae L hd f,\r\n    helicityUnitary_diagonal_ae L hd (Theta f),hc] with p hp hq hr hs\r\n  rw [hp,hq,hr,hs,phaseMatrix_swappedJ]\r\n\r\ntheorem orbitalPhase_negation (a : Fin 4 → ℝ) (p : MomentumCoordinates) :\r\n    star (orbitalPhase 0 a p)=orbitalPhase 0 (-a) p := by\r\n  have hn : orbitPairing (-a) (shellMomentum 0 p)= -orbitPairing a (shellMomentum 0 p) := by\r\n    simp [orbitPairing]\r\n    ring\r\n  unfold orbitalPhase phase\r\n  rw [hn]\r\n  change (starRingEnd ℂ) (Complex.exp _)=Complex.exp _\r\n  rw [←Complex.exp_conj]\r\n  congr 1\r\n  simp\r\n\r\ntheorem Theta_U1 (a : Fin 4 → ℝ) (f : H1) : Theta (U1 a f)=U1 (-a) (Theta f) := by\r\n  apply Lp.ext\r\n  filter_upwards [Theta_ae (U1 a f),orbitalTranslation_ae 0 a f,\r\n    orbitalTranslation_ae 0 (-a) (Theta f),Theta_ae f] with p hp hq hr hs\r\n  change U1 a f p=orbitalPhase 0 a p • f p at hq\r\n  change U1 (-a) (Theta f) p=orbitalPhase 0 (-a) p • Theta f p at hr\r\n  rw [hp,hq,hr,hs,map_smulₛₗ]\r\n  exact congrArg (fun z : ℂ => z • fiberSwappedJ (f p)) (orbitalPhase_negation a p)\r\n\r\nend F1Fecho.OrbitalScreen\r\n#print axioms F1Fecho.OrbitalScreen.Theta\r\n#print axioms F1Fecho.OrbitalScreen.Theta_involutive\r\n#print axioms F1Fecho.OrbitalScreen.phaseMatrix_swappedJ\r\n#print axioms F1Fecho.OrbitalScreen.Theta_helicity\r\n#print axioms F1Fecho.OrbitalScreen.Theta_U1\r\n",
+    'TGLExt/F1Fecho394/ScreenCircularBasisR2.lean': "import TGLExt.F1Fecho394.ScreenPoincareCovarianceR2\r\n\r\n/-! The fixed unitary change from helicity coordinates to the real transverse\r\nscreen basis, lifted to the unchanged canonical H1. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Filter Matrix Complex\r\nnamespace F1Fecho.OrbitalScreen\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\n\r\ndef circularMatrix : Matrix (Fin 2) (Fin 2) ℂ :=\r\n  ((Real.sqrt 2 : ℂ)⁻¹) • !![1,1;I,-I]\r\n\r\ntheorem circularMatrix_unitary : circularMatrix ∈ Matrix.unitaryGroup (Fin 2) ℂ := by\r\n  have hr : Real.sqrt 2 ≠ 0 := (Real.sqrt_pos.2 (by norm_num : (0:ℝ)<2)).ne'\r\n  have hrc : (Real.sqrt 2 : ℂ) ≠ 0 := by exact_mod_cast hr\r\n  have hs : (Real.sqrt 2 : ℂ)^2=2 := by exact_mod_cast Real.sq_sqrt (by norm_num : (0:ℝ)≤2)\r\n  apply Matrix.mem_unitaryGroup_iff'.mpr\r\n  ext i j\r\n  fin_cases i <;> fin_cases j <;>\r\n    simp [circularMatrix,Matrix.mul_apply,Matrix.star_apply,Fin.sum_univ_two,\r\n      Matrix.one_apply,Complex.star_def] <;>\r\n    field_simp <;> ring_nf <;> simp [Complex.I_sq,hs] <;> norm_num\r\n\r\ndef circularFiber : Fiber ≃ₗᵢ[ℂ] Fiber :=\r\n  Unitary.linearIsometryEquiv\r\n    ⟨matrixFiberOperator circularMatrix,\r\n      Unitary.map_mem (Matrix.toEuclideanCLM (𝕜:=ℂ) (n:=Fin 2)) circularMatrix_unitary⟩\r\n\r\ndef fiberLiftMap (e : Fiber ≃ₗᵢ[ℂ] Fiber) : H1 →L[ℂ] H1 :=\r\n  e.toLinearIsometry.toContinuousLinearMap.compLpL 2 (orbitalMeasure 0)\r\n\r\ntheorem fiberLiftMap_ae (e : Fiber ≃ₗᵢ[ℂ] Fiber) (f : H1) :\r\n    fiberLiftMap e f=ᵐ[orbitalMeasure 0] fun p => e (f p) :=\r\n  e.toLinearIsometry.toContinuousLinearMap.coeFn_compLpL f\r\n\r\ntheorem fiberLiftMap_norm (e : Fiber ≃ₗᵢ[ℂ] Fiber) (f : H1) : ‖fiberLiftMap e f‖=‖f‖ := by\r\n  apply le_antisymm\r\n  · apply Lp.norm_le_norm_of_ae_le\r\n    filter_upwards [fiberLiftMap_ae e f] with p hp\r\n    rw [hp,e.norm_map]\r\n  · apply Lp.norm_le_norm_of_ae_le\r\n    filter_upwards [fiberLiftMap_ae e f] with p hp\r\n    rw [hp,e.norm_map]\r\n\r\ntheorem fiberLiftMap_inverse (e : Fiber ≃ₗᵢ[ℂ] Fiber) (f : H1) :\r\n    fiberLiftMap e (fiberLiftMap e.symm f)=f := by\r\n  apply Lp.ext\r\n  filter_upwards [fiberLiftMap_ae e (fiberLiftMap e.symm f),fiberLiftMap_ae e.symm f] with p hp hq\r\n  rw [hp,hq,e.apply_symm_apply]\r\n\r\ndef fiberLiftIsometry (e : Fiber ≃ₗᵢ[ℂ] Fiber) : H1 →ₗᵢ[ℂ] H1 where\r\n  toLinearMap := (fiberLiftMap e).toLinearMap\r\n  norm_map' := fiberLiftMap_norm e\r\n\r\ndef fiberLift (e : Fiber ≃ₗᵢ[ℂ] Fiber) : H1 ≃ₗᵢ[ℂ] H1 :=\r\n  LinearIsometryEquiv.ofLinearIsometry (fiberLiftIsometry e) (fiberLiftMap e.symm).toLinearMap\r\n    (by apply LinearMap.ext; intro f; exact fiberLiftMap_inverse e f)\r\n    (by\r\n      apply LinearMap.ext\r\n      intro f\r\n      change fiberLiftMap e.symm (fiberLiftMap e f)=f\r\n      simpa only [LinearIsometryEquiv.symm_symm] using fiberLiftMap_inverse e.symm f)\r\n\r\ndef circularH1 : H1 ≃ₗᵢ[ℂ] H1 := fiberLift circularFiber\r\n\r\ntheorem fiberLift_U1 (e : Fiber ≃ₗᵢ[ℂ] Fiber) (a : Fin 4 → ℝ) (f : H1) :\r\n    fiberLift e (U1 a f)=U1 a (fiberLift e f) := by\r\n  change fiberLiftMap e (orbitalTranslation 0 a f)=orbitalTranslation 0 a (fiberLiftMap e f)\r\n  apply Lp.ext\r\n  filter_upwards [fiberLiftMap_ae e (orbitalTranslation 0 a f),orbitalTranslation_ae 0 a f,\r\n    orbitalTranslation_ae 0 a (fiberLiftMap e f),fiberLiftMap_ae e f] with p hp hq hr hs\r\n  rw [hp,hq,hr,hs,map_smul]\r\n\r\ntheorem fiberLift_B0 (e : Fiber ≃ₗᵢ[ℂ] Fiber) (s : ℝ) (f : H1) :\r\n    fiberLift e (B0 s f)=B0 s (fiberLift e f) := by\r\n  change fiberLiftMap e (orbitalScalarBoost 0 s f)=orbitalScalarBoost 0 s (fiberLiftMap e f)\r\n  have he := (coordinateBoost_measurePreserving 0 (-s)).quasiMeasurePreserving.ae (fiberLiftMap_ae e f)\r\n  apply Lp.ext\r\n  filter_upwards [fiberLiftMap_ae e (orbitalScalarBoost 0 s f),orbitalScalarBoost_ae 0 s f,\r\n    orbitalScalarBoost_ae 0