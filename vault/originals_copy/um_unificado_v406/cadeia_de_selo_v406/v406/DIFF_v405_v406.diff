:\r\n    cfc (fun z:ℂ=>∫t:ℝ,(w t:ℂ)*resolventPhaseFunction (c*t) z.re) R=\r\n      ∫t:ℝ,(w t:ℂ) • resolventPhaseOperator R (c*t) := by\r\n  have hc: Continuous (fun q : ℝ × ℂ=>(w q.1:ℂ)*resolventPhaseFunction (c*q.1) q.2.re) :=\r\n    (Complex.continuous_ofReal.comp (hw.comp continuous_fst)).mul\r\n      (resolventPhaseFunction_joint_continuous.comp\r\n        ((continuous_const.mul continuous_fst).prodMk (Complex.continuous_re.comp continuous_snd)))\r\n  have hbound:∀ᵐ t:ℝ ∂volume,∀z∈spectrum ℂ R,\r\n      ‖(w t:ℂ)*resolventPhaseFunction (c*t) z.re‖≤‖w t‖ := by\r\n    apply ae_of_all\r\n    intro t z hz\r\n    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]\r\n    exact (mul_le_mul_of_nonneg_left (phase_bound R hR h1 (c*t) z hz) (abs_nonneg _)).trans_eq (mul_one _)\r\n  rw [cfc_integral _ (fun t=>‖w t‖) R hc.continuousOn hbound hi.norm.hasFiniteIntegral\r\n    (IsSelfAdjoint.of_nonneg hR).isStarNormal]\r\n  apply integral_congr_ae\r\n  apply ae_of_all\r\n  intro t\r\n  exact cfc_const_mul _ _ R ((resolventPhaseFunction_continuous (c*t)).comp Complex.continuous_re).continuousOn\r\n\r\nend F1Fecho.ResolventScaledPhaseIntegral\r\n#print axioms F1Fecho.ResolventScaledPhaseIntegral.weighted_phase_integrable\r\n#print axioms F1Fecho.ResolventScaledPhaseIntegral.weighted_phase_integral\r\n',
+    'TGLExt/F1Fecho394/SchwartzCompactDensityR3.lean': 'import TGLExt.F1Fecho394.SchwartzCutoffEstimateR5\r\nimport Mathlib.Analysis.SpecificLimits.Basic\r\n\r\n/-! Every Schwartz test is the limit, in its own Schwartz topology, of\r\nsmooth compactly supported tests obtained with a fixed real cutoff. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen Filter SchwartzMap\r\nopen scoped Topology ContDiff\r\nnamespace F1Fecho.SchwartzCutoff\r\nvariable {F:Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]\r\n\r\ntheorem cutoff_compact (s:ℝ) (hs:0<s) (f:SchwartzMap E F) :\r\n    HasCompactSupport (cutoff s f:E→F) := by\r\n  apply (isCompact_closedBall (0:E) (2/s)).of_isClosed_subset isClosed_closure\r\n  apply closure_minimal _ Metric.isClosed_closedBall\r\n  intro x hx\r\n  have hb:bump (s • x)≠0 := by\r\n    intro hh\r\n    exact hx (by simp [cutoff_apply,hh])\r\n  have hball:s • x∈Metric.ball (0:E) 2 := by\r\n    have hm : s • x ∈ Function.support (bump:E→ℝ) := hb\r\n    rw [bump.support_eq] at hm\r\n    exact hm\r\n  have hn:s*‖x‖<2 := by\r\n    simpa only [Metric.mem_ball,dist_zero_right,norm_smul,Real.norm_of_nonneg hs.le] using hball\r\n  rw [Metric.mem_closedBall,dist_zero_right]\r\n  exact (le_div_iff₀ hs).mpr (by nlinarith)\r\n\r\ndef cutoffSequence (f:SchwartzMap E F) (n:ℕ) : SchwartzMap E F :=\r\n  cutoff (1/((n:ℝ)+1)) f\r\n\r\ntheorem cutoffSequence_tendsto (f:SchwartzMap E F) :\r\n    Tendsto (cutoffSequence f) atTop (𝓝 f) := by\r\n  apply (schwartz_withSeminorms ℝ E F).tendsto_nhds _ _ |>.mpr\r\n  rintro ⟨k,n⟩ ε hε\r\n  have ht:Tendsto (fun m:ℕ=>(1/((m:ℝ)+1))*errorBound k n f) atTop (𝓝 0) := by\r\n    simpa using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜:=ℝ)).mul_const (errorBound k n f)\r\n  filter_upwards [ht.eventually (gt_mem_nhds hε)] with m hm\r\n  have hb:=error_seminorm_bound (1/((m:ℝ)+1)) (by positivity)\r\n    (show 1/((m:ℝ)+1)≤1 by apply (div_le_one (by positivity)).mpr; linarith [Nat.cast_nonneg (α:=ℝ) m]) f k n\r\n  change SchwartzMap.seminorm ℝ k n (cutoffSequence f m-f)<ε\r\n  rw [←neg_sub f (cutoffSequence f m),map_neg_eq_map]\r\n  exact hb.trans_lt hm\r\n\r\ntheorem compact_tests_dense :\r\n    Dense {f:SchwartzMap E F|HasCompactSupport (f:E→F)} := by\r\n  intro f\r\n  exact isClosed_closure.mem_of_tendsto (cutoffSequence_tendsto f)\r\n    (Eventually.of_forall (fun n=>subset_closure (cutoff_compact _ (by positivity) f)))\r\n\r\nend F1Fecho.SchwartzCutoff\r\n#print axioms F1Fecho.SchwartzCutoff.cutoff_compact\r\n#print axioms F1Fecho.SchwartzCutoff.cutoffSequence_tendsto\r\n#print axioms F1Fecho.SchwartzCutoff.compact_tests_dense\r\n',
+    'TGLExt/F1Fecho394/SchwartzCutoffDerivativeR4.lean': "import Mathlib.Analysis.Distribution.SchwartzSpace.Basic\r\nimport Mathlib.Analysis.Calculus.BumpFunction.FiniteDimension\r\nimport Mathlib.Analysis.InnerProductSpace.PiL2\r\nimport Mathlib.Tactic\r\n\r\n/-! Uniform derivative control of a fixed smooth compact cutoff under dilations.\r\nThis is the first estimate for compact approximation in Schwartz topology. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen Filter\r\nopen scoped Topology ContDiff\r\nnamespace F1Fecho.SchwartzCutoff\r\nabbrev E := EuclideanSpace ℝ (Fin 4)\r\n\r\ndef bump : ContDiffBump (0:E) := ⟨1,2,by norm_num,by norm_num⟩\r\ndef bumpSchwartz : SchwartzMap E ℝ := bump.hasCompactSupport.toSchwartzMap bump.contDiff\r\n\r\ndef residual (s:ℝ) (x:E) : ℝ := 1-bump (s • x)\r\ndef bound (n:ℕ) : ℝ := 1+SchwartzMap.seminorm ℝ 0 n bumpSchwartz\r\n\r\ntheorem residual_smooth (s:ℝ) : ContDiff ℝ ∞ (residual s) :=\r\n  contDiff_const.sub (bump.contDiff.comp (contDiff_id.const_smul s))\r\n\r\ntheorem derivative_scaled (s:ℝ) (hs:0≤s) (hs1:s≤1) (n:ℕ) (x:E) :\r\n    ‖iteratedFDeriv ℝ n (fun y:E=>bump (s • y)) x‖≤\r\n      SchwartzMap.seminorm ℝ 0 n bumpSchwartz := by\r\n  rw [iteratedFDeriv_comp_const_smul s (bump.contDiff : ContDiff ℝ n bump)]\r\n  rw [norm_smul,Real.norm_of_nonneg (pow_nonneg hs n)]\r\n  have hb:=bumpSchwartz.le_seminorm ℝ 0 n (s • x)\r\n  simp only [pow_zero,one_mul] at hb\r\n  change ‖iteratedFDeriv ℝ n (fun y:E=>bump y) (s • x)‖≤SchwartzMap.seminorm ℝ 0 n bumpSchwartz at hb\r\n  have hs':s^n≤1 := pow_le_one₀ hs hs1\r\n  exact (mul_le_mul_of_nonneg_right hs' (norm_nonneg _)).trans (by simpa only [one_mul] using hb)\r\n\r\ntheorem residual_derivative_bound (s:ℝ) (hs:0≤s) (hs1:s≤1) (n:ℕ) (x:E) :\r\n    ‖iteratedFDeriv ℝ n (residual s) x‖≤bound n := by\r\n  have hc:‖iteratedFDeriv ℝ n (fun _:E=>(1:ℝ)) x‖≤1 := by\r\n    cases n with\r\n    | zero => simp\r\n    | succ n => simp [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero n)]\r\n  have he:iteratedFDeriv ℝ n (residual s) x=\r\n      iteratedFDeriv ℝ n (fun _:E=>(1:ℝ)) x-\r\n      iteratedFDeriv ℝ n (fun y:E=>bump (s • y)) x :=\r\n    iteratedFDeriv_sub_apply contDiffAt_const\r\n      ((bump.contDiff.comp (contDiff_id.const_smul s) :\r\n        ContDiff ℝ n (fun y:E=>bump (s • y))).contDiffAt)\r\n  rw [he]\r\n  exact (norm_sub_le _ _).trans (add_le_add hc (derivative_scaled s hs hs1 n x))\r\n\r\ntheorem residual_eventually_zero (s:ℝ) (x:E) (hx:‖s • x‖<1) :\r\n    residual s =ᶠ[𝓝 x] 0 := by\r\n  have h:=bump.eventuallyEq_one_of_mem_ball (by simpa [bump,Metric.mem_ball,dist_zero_right] using hx)\r\n  have hc:Continuous (fun y:E=>s • y):=continuous_const.smul continuous_id\r\n  filter_upwards [hc.continuousAt.preimage_mem_nhds h] with y hy\r\n  change bump (s • y)=1 at hy\r\n  simp only [residual,Pi.zero_apply,hy,sub_self]\r\n\r\ntheorem residual_product_derivative_zero {F:Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]\r\n    (s:ℝ) (f:E→F) (n:ℕ) (x:E) (hx:‖s • x‖<1) :\r\n    iteratedFDeriv ℝ n (fun y=>residual s y • f y) x=0 := by\r\n  have h:(fun y=>residual s y • f y)=ᶠ[𝓝 x] 0 := by\r\n    filter_upwards [residual_eventually_zero s x hx] with y hy\r\n    simp only [hy,zero_smul,Pi.zero_apply]\r\n  have hh:=(h.iteratedFDeriv (𝕜:=ℝ) n).eq_of_nhds\r\n  simpa using hh\r\n\r\nend F1Fecho.SchwartzCutoff\r\n#print axioms F1Fecho.SchwartzCutoff.residual_derivative_bound\r\n#print axioms F1Fecho.SchwartzCutoff.residual_product_derivative_zero\r\n",
+    'TGLExt/F1Fecho394/SchwartzCutoffEstimateR5.lean': "import TGLExt.F1Fecho394.SchwartzCutoffDerivativeR4\r\n\r\n/-! Quantitative compact-cutoff approximation in every Schwartz seminorm.\r\nThe rate is obtained from one extra spatial weight of the given test. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen Filter SchwartzMap\r\nopen scoped Topology ContDiff\r\nnamespace F1Fecho.SchwartzCutoff\r\nvariable {F:Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]\r\n\r\ndef cutoff (s:ℝ) (f:SchwartzMap E F) : SchwartzMap E F :=\r\n  SchwartzMap.smulLeftCLM F (fun x:E=>bump (s • x)) f\r\n\r\ntheorem scaled_temperate (s:ℝ) : (fun x:E=>bump (s • x)).HasTemperateGrowth := by\r\n  have hb:Function.HasTemperateGrowth (fun x:E=>bump x) := bumpSchwartz.hasTemperateGrowth\r\n  fun_prop\r\n\r\ntheorem cutoff_apply (s:ℝ) (f:SchwartzMap E F) (x:E) :\r\n    cutoff s f x=bump (s • x) • f x :=\r\n  SchwartzMap.smulLeftCLM_apply_apply (scaled_temperate s) f x\r\n\r\ntheorem error_apply (s:ℝ) (f:SchwartzMap E F) :\r\n    ((f-cutoff s f:SchwartzMap E F):E→F)=(fun x=>residual s x • f x) := by\r\n  funext x\r\n  change f x-cutoff s f x=residual s x • f x\r\n  simp only [cutoff_apply,residual,sub_smul,one_smul]\r\n\r\ndef errorBound (k n:ℕ) (f:SchwartzMap E F) : ℝ :=\r\n  ∑i∈Finset.range (n+1),(n.choose i:ℝ)*bound i*SchwartzMap.seminorm ℝ (k+1) (n-i) f\r\n\r\ntheorem bound_nonneg (i:ℕ) : 0≤bound i := by unfold bound;positivity\r\n\r\ntheorem errorBound_nonneg (k n:ℕ) (f:SchwartzMap E F) : 0≤errorBound k n f := by\r\n  apply Finset.sum_nonneg\r\n  intro i hi\r\n  exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (bound_nonneg _)) (apply_nonneg _ _)\r\n\r\ntheorem weighted_tail_bound (s:ℝ) (hs:0≤s) (f:SchwartzMap E F) (k n:ℕ) (x:E)\r\n    (hx:1≤s*‖x‖) :\r\n    ‖x‖^k*‖iteratedFDeriv ℝ n f x‖≤s*SchwartzMap.seminorm ℝ (k+1) n f := by\r\n  calc\r\n    ‖x‖^k*‖iteratedFDeriv ℝ n f x‖≤\r\n        (s*‖x‖)*(‖x‖^k*‖iteratedFDeriv ℝ n f x‖) :=\r\n      le_mul_of_one_le_left (by positivity) hx\r\n    _ = s*(‖x‖^(k+1)*‖iteratedFDeriv ℝ n f x‖) := by rw [pow_succ];ring\r\n    _ ≤s*SchwartzMap.seminorm ℝ (k+1) n f :=\r\n      mul_le_mul_of_nonneg_left (f.le_seminorm ℝ (k+1) n x) hs\r\n\r\ntheorem error_pointwise_bound (s:ℝ) (hs:0≤s) (hs1:s≤1)\r\n    (f:SchwartzMap E F) (k n:ℕ) (x:E) :\r\n    ‖x‖^k*‖iteratedFDeriv ℝ n (f-cutoff s f) x‖≤s*errorBound k n f := by\r\n  rw [error_apply]\r\n  by_cases hx:‖s • x‖<1\r\n  · rw [residual_product_derivative_zero s f n x hx,norm_zero,mul_zero]\r\n    exact mul_nonneg hs (errorBound_nonneg k n f)\r\n  · have hx':1≤s*‖x‖ := by\r\n      simpa only [norm_smul,Real.norm_of_nonneg hs] using le_of_not_gt hx\r\n    have hprod:=norm_iteratedFDeriv_smul_le (residual_smooth s) (f.smooth ⊤) x (n:=n)\r\n      (WithTop.coe_le_coe.mpr (show (n:ℕ∞)≤⊤ from le_top))\r\n    apply (mul_le_mul_of_nonneg_left hprod (by positivity)).trans\r\n    unfold errorBound\r\n    rw [Finset.mul_sum,Finset.mul_sum]\r\n    apply Finset.sum_le_sum\r\n    intro i hi\r\n    have hb:=residual_derivative_bound s hs hs1 i x\r\n    have htail:=weighted_tail_bound s hs f k (n-i) x hx'\r\n    calc\r\n      ‖x‖^k*((n.choose i:ℝ)*‖iteratedFDeriv ℝ i (residual s) x‖*\r\n          ‖iteratedFDeriv ℝ (n-i) f x‖)≤\r\n        (n.choose i:ℝ)*bound i*(‖x‖^k*‖iteratedFDeriv ℝ (n-i) f x‖) := by\r\n          nlinarith [mul_le_mul_of_nonneg_left hb\r\n            (show 0≤‖x‖^k*(n.choose i:ℝ)*‖iteratedFDeriv ℝ (n-i) f x‖ by positivity)]\r\n      _ ≤ (n.choose i:ℝ)*bound i*(s*SchwartzMap.seminorm ℝ (k+1) (n-i) f) :=\r\n        mul_le_mul_of_nonneg_left htail (mul_nonneg (Nat.cast_nonneg _) (bound_nonneg _))\r\n      _ =s*((n.choose i:ℝ)*bound i*SchwartzMap.seminorm ℝ (k+1) (n-i) f) := by ring\r\n\r\ntheorem error_seminorm_bound (s:ℝ) (hs:0≤s) (hs1:s≤1)\r\n    (f:SchwartzMap E F) (k n:ℕ) :\r\n    SchwartzMap.seminorm ℝ k n (f-cutoff s f)≤s*errorBound k n f :=\r\n  (f-cutoff s f).seminorm_le_bound ℝ k n\r\n    (mul_nonneg hs (errorBound_no