+    'TGLExt/F1Fecho394/CanonicalFockRightPolarBridgeR5.lean': 'import TGLExt.F1Fecho394.CanonicalFockRightRootR10\r\nimport TGLExt.F1Fecho394.CanonicalFockWeightPolarR9\r\nimport TGLExt.F1Fecho394.CanonicalFockPolarRightAlgebraR6\r\n\r\n/-! The actual polar conjugation exchanges regular left and right multiplication. Uses the dense range of the proved positive root, not an input right-action identity. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockRightPolar\r\nlocal instance : CompleteSpace F1Fecho.CanonicalFockGNS.GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\nlocal instance : Star (F1Fecho.CanonicalFockGNS.GNSHilbert →L[ℂ] F1Fecho.CanonicalFockGNS.GNSHilbert) :=\r\n  F1Fecho.ClosedSubmoduleRestriction.endomorphismStar F1Fecho.CanonicalFockGNS.GNSSubspace\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock MeasureTheory Filter\r\nopen TGLV350.Regular (antiunitaryConjugate antiunitaryConjugate_apply)\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockWeightOrbit F1Fecho.CanonicalFockWeightCompletion\r\nopen scoped Topology\r\nopen F1Fecho.CanonicalFockRegularRightGNS F1Fecho.CanonicalFockWeightClosedTomita\r\nopen F1Fecho.CanonicalFockRightTomita F1Fecho.CanonicalFockWeightPolar\r\nopen F1Fecho.CanonicalFockPolarRight\r\nopen F1Fecho.CanonicalFockRightRoot (scalarRegularRightRootInput scalarTomitaPositiveRoot_regular_right_commutes)\r\n/-- The actual polar antiunitary exchanges this right action with left\r\nmultiplication. The extension uses the dense image of the SAME positive root. -/\r\ntheorem scalarTomitaPolarFactor_regular_right  (t : ℝ)\r\n    (z : GNSHilbert) :\r\n    scalarTomitaPolarFactor (regularRightGNS t z) =\r\n      scalarGNSRepresentation (star (regularRightCoreElement t))\r\n        (scalarTomitaPolarFactor z) := by\r\n  refine (scalarTomitaPositiveRoot_denseRange).induction ?_\r\n    (isClosed_eq (by fun_prop) (by fun_prop)) z\r\n  rintro _ ⟨x,rfl⟩\r\n  have he : Submodule.inclusion (scalarTomitaRootDomain_le_closed)\r\n      (scalarRegularRightRootInput t x) =\r\n    scalarRegularRightClosedTomitaInput t\r\n      (Submodule.inclusion (scalarTomitaRootDomain_le_closed) x) := Subtype.ext rfl\r\n  calc\r\n    _ = scalarTomitaPolarFactor\r\n        (scalarTomitaPositiveRoot (scalarRegularRightRootInput t x)) :=\r\n      congrArg (scalarTomitaPolarFactor) (scalarTomitaPositiveRoot_regular_right_commutes t x).symm\r\n    _ = closedTomita (Submodule.inclusion (scalarTomitaRootDomain_le_closed)\r\n        (scalarRegularRightRootInput t x)) := scalarTomitaPolarFactor_root _\r\n    _ = closedTomita (scalarRegularRightClosedTomitaInput t\r\n        (Submodule.inclusion (scalarTomitaRootDomain_le_closed) x)) :=\r\n      congrArg (closedTomita) he\r\n    _ = scalarGNSRepresentation (star (regularRightCoreElement t))\r\n        (closedTomita (Submodule.inclusion (scalarTomitaRootDomain_le_closed) x)) :=\r\n      scalarClosedTomita_regular_right_intertwines t _\r\n    _ = _ := congrArg (scalarGNSRepresentation (star (regularRightCoreElement t)))\r\n      (scalarTomitaPolarFactor_root x).symm\r\n\r\ntheorem scalarTomitaPolar_conjugate_regular_right  (t : ℝ) :\r\n    antiunitaryConjugate (H := GNSHilbert) (scalarTomitaPolarFactor) (regularRightGNS t) =\r\n      scalarGNSRepresentation (star (regularRightCoreElement t)) := by\r\n  apply ContinuousLinearMap.ext\r\n  intro x\r\n  have h := scalarTomitaPolarFactor_regular_right t ((scalarTomitaPolarFactor).symm x)\r\n  simpa only [antiunitaryConjugate_apply,LinearIsometryEquiv.apply_symm_apply] using h\r\n\r\ntheorem scalarTomitaPolarFactor_regular_left  (t : ℝ)\r\n    (z : GNSHilbert) :\r\n    scalarTomitaPolarFactor\r\n      (scalarGNSRepresentation (star (regularRightCoreElement t)) z) =\r\n        regularRightGNS t (scalarTomitaPolarFactor z) := by\r\n  have h := congrArg (scalarTomitaPolarFactor)\r\n    (scalarTomitaPolarFactor_regular_right t (scalarTomitaPolarFactor z))\r\n  simpa only [scalarTomitaPolarFactor_involutive z,\r\n    scalarTomitaPolarFactor_involutive (regularRightGNS t (scalarTomitaPolarFactor z))] using h.symm\r\n\r\n/-- The previously constructed right translation is the original polar right\r\naction on every vector in the full scalar-weight ideal. -/\r\ntheorem scalarRightAction_regular  (t : ℝ)\r\n    (A : scalarWeightLeftIdeal) :\r\n    scalarWeightGNSEmbedding (scalarRegularRightProduct t A) =\r\n      antiunitaryConjugate (H := GNSHilbert) (scalarTomitaPolarFactor)\r\n        (scalarGNSRepresentation (star (regularRightCoreElement t)))\r\n          (scalarWeightGNSEmbedding A) := by\r\n  have h := scalarTomitaPolarFactor_regular_left t\r\n    (scalarTomitaPolarFactor.symm (scalarWeightGNSEmbedding A))\r\n  have hi := congrArg (regularRightGNS t)\r\n    (scalarTomitaPolarFactor.apply_symm_apply (scalarWeightGNSEmbedding A))\r\n  calc\r\n    _ = regularRightGNS t (scalarWeightGNSEmbedding A) :=\r\n      (regularRightGNS_intertwines t A).symm\r\n    _ = scalarTomitaPolarFactor (scalarGNSRepresentation (star (regularRightCoreElement t))\r\n        (scalarTomitaPolarFactor.symm (scalarWeightGNSEmbedding A))) := (h.trans hi).symm\r\n    _ = _ := rfl\r\n\r\ntheorem scalarPolarRightAlgebra_regular_mem (t : ℝ) :\r\n    regularRightCoreElement t ∈ scalarPolarRightAlgebra scalarTomitaPolarFactor := by\r\n  have h (s : ℝ) : ScalarPolarRight scalarTomitaPolarFactor (regularRightCoreElement s) := by\r\n    intro A\r\n    exact ⟨(scalarRegularRightProduct s A).property,scalarRightAction_regular s A⟩\r\n  apply (scalarPolarRightAlgebra_mem_iff scalarTomitaPolarFactor (regularRightCoreElement t)).mpr\r\n  refine ⟨h t,?_⟩\r\n  simpa only [regularRightCoreElement_star] using h (-t)\r\nend F1Fecho.CanonicalFockRightPolar\r\n#print axioms F1Fecho.CanonicalFockRightPolar.scalarTomitaPolarFactor_regular_right\r\n#print axioms F1Fecho.CanonicalFockRightPolar.scalarTomitaPolar_conjugate_regular_right\r\n#print axioms F1Fecho.CanonicalFockRightPolar.scalarTomitaPolarFactor_regular_left\r\n#print axioms F1Fecho.CanonicalFockRightPolar.scalarRightAction_regular\r\n#print axioms F1Fecho.CanonicalFockRightPolar.scalarPolarRightAlgebra_regular_mem\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockRightRootR10.lean': 'import TGLExt.F1Fecho394.GenericRightTomitaResolventR4\r\nimport TGLExt.F1Fecho394.GenericRootDomainTransportR2\r\nimport TGLExt.F1Fecho394.CanonicalFockWeightModularOperatorR3\r\nimport TGLExt.F1Fecho394.CanonicalFockRightTomitaR3\r\n\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.MappedStarFamily\r\nvariable {H A : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n  [Ring A] [StarRing A] [Algebra ℂ A]\r\ntheorem star_inverse_family (π : A →⋆ₐ[ℂ] (H →L[ℂ] H))\r\n    (b : ℝ → A) (hb : ∀ t, star (b t) = b (-t)) (t : ℝ) :\r\n    star (π (star (b t))) = π (star (b (-t))) := by\r\n  simp only [← map_star,star_star,hb,neg_neg]\r\nend F1Fecho.MappedStarFamily\r\n\r\n/-! Regular right multiplication commutes with the exact resolvent and its\r\npositive graph square root on the same Fock weight GNS. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 400000\r\nset_option maxErrors 3\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockRightRoot\r\nlocal instance : CompleteSpace F1Fecho.CanonicalFockGNS.GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\nlocal instance : Star (F1Fecho.CanonicalFockGNS.GNSHilbert →L[ℂ] F1Fecho.CanonicalFockGNS.GNSHilbert) :=\r\n  F1Fecho.ClosedSubmoduleRestriction.endomorphismStar F1Fecho.CanonicalFockGNS.GNSSubspace\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock MeasureTheory Filter\r\nopen TGLV350.Regular (resolventSquareRoot resolvent_sqrt_graph_transport_of_commute)\r\nopen F1Fecho.CanonicalFockGNS F1Fecho.CanonicalFockRegularRightGNS\r\nopen F1Fecho.CanonicalFockWeightModularOperator\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockRightTomita\r\n\r\nabbrev scalarTomitaPositiveRoot := resolventSquareRoot (H := GNSHilbert) scalarTomitaResolvent\r\n  scalarTomitaResolvent_nonneg scalarTomitaResolvent_injective\r\n/-- Commutation is transferred from the full domain of A to its actual\r\nbounded inverse (I+A)^(-1), using both inverse equations already proved. -/\r\ntheorem scalarTomitaResolvent_regular_right_commutes (t : ℝ) :\r\n    Commute scalarTomitaResolvent (regularRightGNS t) := by\r\n  let V : ℝ → GNSHilbert →L[ℂ] GNSHilbert := fun s =>\r\n    scalarGNSRepresentation (star (regularRightCoreElement s))\r\n  have hV (s : ℝ) : star (V s) = V (-s) := by\r\n    have h := map_star scalarGNSRepresentation (star (regularRightCoreElement s))\r\n    have he : star (star (regularRightCoreElement s)) = star (regularRightCoreElement (-s)) := by\r\n      simp only [star_star,regularRightCoreElement_star,neg_neg]\r\n    exact h.symm.trans (congrArg scalarGNSRepresentation he)\r\n  exact F1Fecho.GenericRightTomitaResolvent.resolvent_commutes\r\n    (H := GNSHilbert) actualClosedInput regularRightGNS V\r\n    regularRightGNS_star hV scalarRegularRight_mem_closedTomitaDomain\r\n    scalarClosedTomita_regular_right_intertwines t\r\n\r\ntheorem scalarTomitaPositiveRoot_regular_right_graph  (t : ℝ)\r\n    (x : (scalarTomitaPositiveRoot ).domain) :\r\n    (regularRightGNS  t (x : GNSHilbert),\r\n      regularRightGNS  t (scalarTomitaPositiveRoot  x)) ∈ (scalarTomitaPositiveRoot ).graph :=\r\n  resolvent_sqrt_graph_transport_of_commute (H := GNSHilbert) (scalarTomitaResolvent ) (regularRightGNS  t)\r\n    (scalarTomitaResolvent_nonneg ) (scalarTomitaResolvent_injective )\r\n    (scalarTomitaResolvent_regular_right_commutes  t) _ _\r\n    ((LinearPMap.mem_graph_iff (scalarTomitaPositiveRoot )).mpr ⟨x,rfl,rfl⟩)\r\n\r\ntheorem scalarRegularRight_mem_rootDomain (t : ℝ)\r\n    (x : scalarTomitaPositiveRoot.domain) :\r\n    regularRightGNS t (x : GNSHilbert) ∈ scalarTomitaPositiveRoot.domain := by\r\n  with_reducible\r\n    exact GenericRootDomainTransport.domain_map (H := GNSHilbert)\r\n      scalarTomitaResolvent (regularRightGNS t) scalarTomitaResolvent_nonneg\r\n      scalarTomitaResolvent_injective (scalarTomitaResolvent_regular_right_commutes t) x\r\n\r\nabbrev scalarRegularRightRootInput (t : ℝ)\r\n    (x : scalarTomitaPositiveRoot.domain) : scalarTomitaPositiveRoot.domain :=\r\n  GenericRootDomainTransport.mappedInput (H := GNSHilbert)\r\n    scalarTomitaResolvent (regularRightGNS t) scalarTomitaResolvent_nonneg\r\n    scalarTomitaResolvent_injective (scalarTomitaResolvent_regular_right_commutes t) x\r\n\r\ntheorem scalarTomitaPositiveRoot_regular_right_commutes (t : ℝ)\r\n    (x : scalarTomitaPositiveRoot.domain) :\r\n    scalarTomitaPositiveRoot (scalarRegularRightRootInput t x) =\r\n      regularRightGNS t (scalarTomitaPositiveRoot x) := by\r\n  with_reducible\r\n    exact GenericRootDomainTransport.root_map (H := GNSHilbert)\r\n      scalarTomitaResolvent (regularRightGNS t) scalarTomitaResolvent_nonneg\r\n      scalarTomitaResolvent_injective (scalarTomitaResolvent_regular_right_commutes t) x\r\n\r\ntheorem scalarRegularRight_rootDomain_iff (t : ℝ) (x : GNSHilbert) :\r\n    regularRightGNS t x ∈ scalarTomitaPositiveRoot.domain ↔ x ∈ scalarTomitaPositiveRoot.domain := by\r\n  have hi (y : GNSHilbert) : regularRightGNS (-t) (regularRightGNS t y) = y := by\r\n    have he : regularRightGNS (-t) * regularRightGNS t = 1 :=\r\n      (regularRightGNS_mul (-t) t).trans\r\n        ((congrArg regularRightGNS (neg_add_cancel t)).trans regularRightGNS_zero)\r\n    exact congrArg (fun A : GNSHilbert →L[ℂ] GNSHilbert => A y) he\r\n  with_reducible\r\n    exact GenericRootDomainTransport.domain_inverse_iff (H := GNSHilbert)\r\n      scalarTomitaResolvent (regularRightGNS t) scalarTomitaResolvent_nonneg\r\n      scalarTomitaResolvent_injective (scalarTomitaResolvent_regular_right_commutes t)\r\n      (regularRightGNS (-t)) (scalarTomitaResolvent_regular_right_commutes (-t)) hi x\r\n\r\n\r\nend F1Fecho.CanonicalFockRightRoot\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarTomitaResolvent_regular_right_commutes\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarTomitaPositiveRoot_regular_right_graph\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarRegularRight_mem_rootDomain\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarRegularRightRootInput\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarTomitaPositiveRoot_regular_right_commutes\r\n#print axioms F1Fecho.CanonicalFockRightRoot.scalarRegularRight_rootDomain_iff\r\n\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockRightTomitaR3.lean': 'import TGLExt.F1Fecho394.GenericFiniteStarRightR1\r\nimport TGLExt.F1Fecho394.CanonicalFockRegularRightGNSR11\r\nimport TGLExt.F1Fecho394.CanonicalFockFullWeightTomitaR5\r\n/-! Actual regular right multiplication preserves the full closed Tomita graph\r\non the existing Fock weight GNS. No modular identity is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockRightTomita\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock MeasureTheory Filter\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockWeightOrbit F1Fecho.CanonicalFockWeightCompletion\r\nopen F1Fecho.CanonicalFockRegularRightGNS F1Fecho.CanonicalFockWeightSandwich\r\nopen F1Fecho.CanonicalFockFullWeightStarCore F1Fecho.CanonicalFockFullWeightTomita\r\nopen F1Fecho.CanonicalFockWeightClosedTomita\r\nopen scoped Topology\r\ndef scalarWeightStarRegularRightProduct  (t : ℝ)\r\n    (A : scalarWeightStarCore ) : scalarWeightStarCore  :=\r\n  F1Fecho.GenericFiniteStarRight.product weightContext A (regularRightCoreElement t)\r\n    (scalarRegularRightProduct t ⟨A.val,A.property.1⟩).property\r\n\r\ntheorem scalarWeightStarRegularRight_embedding  (t : ℝ)\r\n    (A : scalarWeightStarCore ) :\r\n    scalarWeightStarEmbedding  (scalarWeightStarRegularRightProduct  t A) =\r\n      regularRightGNS  t (scalarWeightStarEmbedding  A) :=\r\n  (regularRightGNS_intertwines  t ⟨A.val,A.property.1⟩).symm\r\n\r\ntheorem scalarWeightStarRegularRight_star_embedding  (t : ℝ)\r\n    (A : scalarWeightStarCore ) :\r\n    scalarWeightStarEmbedding  (star (scalarWeightStarRegularRightProduct  t A)) =\r\n      scalarGNSRepresentation  (star (regularRightCoreElement  t))\r\n        (scalarWeightStarEmbedding  (star A)) := by\r\n  have hi := scalarWeightGNSAction_intertwines  (star (regularRightCoreElement  t))\r\n    ⟨(star A).val,(star A).property.1⟩\r\n  apply Eq.trans ?_ hi.symm\r\n  apply congrArg (scalarWeightGNSEmbedding )\r\n  apply Subtype.ext\r\n  apply Subtype.ext\r\n  have he : star (A.val * (⟨regularUnitary t,regular_mem t⟩ : weightContext.algebra.toStarSubalgebra)) =\r\n    star (⟨regularUnitary t,regular_mem t⟩ : weightContext.algebra.toStarSubalgebra) * star A.val :=\r\n    star_mul A.val (⟨regularUnitary t,regular_mem t⟩ : weightContext.algebra.toStarSubalgebra)\r\n  exact congrArg Subtype.val he\r\n\r\ndef regularRightGraphMap  (t : ℝ)\r\n    (p : GNSHilbert × GNSHilbert) :\r\n    GNSHilbert × GNSHilbert :=\r\n  (regularRightGNS  t p.1,\r\n    scalarGNSRepresentation  (star (regularRightCoreElement  t)) p.2)\r\n\r\ntheorem regularRightGraphMap_continuous  (t : ℝ) :\r\n    Continuous (regularRightGraphMap  t) :=\r\n  ((regularRightGNS  t).continuous.comp continuous_fst).prodMk\r\n    ((scalarGNSRepresentation  (star (regularRightCoreElement  t))).continuous.comp continuous_snd)\r\n\r\ntheorem regularRightGraphMap_preserves_weight_graph  (t : ℝ) :\r\n    Set.MapsTo (regularRightGraphMap  t) (scalarWeightTomitaGraph )\r\n      (scalarWeightTomitaGraph ) := by\r\n  rintro p ⟨A,rfl⟩\r\n  refine ⟨scalarWeightStarRegularRightProduct  t A,?_⟩\r\n  exact Prod.ext (scalarWeightStarRegularRight_embedding  t A)\r\n    (scalarWeightStarRegularRight_star_embedding  t A)\r\n\r\ntheorem regularRightGraphMap_preserves_closed_graph  (t : ℝ) :\r\n    Set.MapsTo (regularRightGraphMap  t) (closure (F1Fecho.RegularScalarTomitaGraph.scalarTomitaGraph weightContext))\r\n      (closure (F1Fecho.RegularScalarTomitaGraph.scalarTomitaGraph weightContext)) := by\r\n  have h := (regularRightGraphMap_preserves_weight_graph  t).closure\r\n    (regularRightGraphMap_continuous  t)\r\n  simpa only [scalarWeightTomitaGraph_closure_eq] using h\r\n\r\ntheorem scalarRegularRight_mem_closedTomitaDomain  (t : ℝ)\r\n    (x : closedTomitaDomain) :\r\n    regularRightGNS  t (x : GNSHilbert) ∈ closedTomitaDomain :=\r\n  ⟨scalarGNSRepresentation  (star (regularRightCoreElement  t)) (closedTomita x),\r\n    regularRightGraphMap_preserves_closed_graph  t (F1Fecho.RegularScalarClosedTomita.scalarClosedTomita_graph (H := F) (D := weightContext) x)⟩\r\n\r\ndef scalarRegularRightClosedTomitaInput  (t : ℝ)\r\n    (x : closedTomitaDomain) : closedTomitaDomain :=\r\n  ⟨regularRightGNS  t (x : GNSHilbert),scalarRegularRight_mem_closedTomitaDomain  t x⟩\r\n\r\n/-- The actual closed S intertwines right multiplication by lambda_t with\r\nleft multiplication by lambda_t*. The identity holds on its full domain. -/\r\ntheorem scalarClosedTomita_regular_right_intertwines  (t : ℝ)\r\n    (x : closedTomitaDomain) :\r\n    closedTomita (scalarRegularRightClosedTomitaInput  t x) =\r\n      scalarGNSRepresentation  (star (regularRightCoreElement  t)) (closedTomita x) :=\r\n  F1Fecho.RegularScalarTomitaClosure.scalarTomitaGraph_closure_single_valued (H := F) weightContext (regularRightGNS  t (x : GNSHilbert)) _ _\r\n    (F1Fecho.RegularScalarClosedTomita.scalarClosedTomita_graph (H := F) (D := weightContext) (scalarRegularRightClosedTomitaInput  t x))\r\n    (regularRightGraphMap_preserves_closed_graph  t (F1Fecho.RegularScalarClosedTomita.scalarClosedTomita_graph (H := F) (D := weightContext) x))\r\n\r\n\r\nend F1Fecho.CanonicalFockRightTomita\r\n#print axioms F1Fecho.CanonicalFockRightTomita.scalarWeightStarRegularRightProduct\r\n#print axioms F1Fecho.CanonicalFockRightTomita.scalarWeightStarRegularRight_embedding\r\n#print axioms F1Fecho.CanonicalFockRightTomita.scalarWeightStarRegularRight_star_embedding\r\n#print axioms F1Fecho.CanonicalFockRightTomita.regularRightGraphMap\r\n#print axioms F1Fecho.CanonicalFockRightTomita.regularRightGraphMap_continuous\r\n#print axioms F1Fecho.CanonicalFockRightTomita.regularRightGraphMap_preserves_weight_graph\r\n#print axioms F1Fecho.Canonic