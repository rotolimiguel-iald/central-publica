hysicalLeftWedge g hg)\r\n  simpa only [LinearIsometryEquiv.inner_map_map] using h\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.frame_region_transport\r\n#print axioms F1Fecho.MaxwellLocalization.localized_frame_transport\r\n#print axioms F1Fecho.MaxwellLocalization.physical_frame_opposite_symplectic\r\n',
+    'TGLExt/F1Fecho394/PhysicalLocalizedBoostR2.lean': "import TGLExt.F1Fecho394.PhysicalSmearBoostR2\r\n\r\n/-! Boost covariance for every physical region, with the actual supported\r\nMaxwell tests. No causal locality or wedge equality is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen TGLExt TGLExt.ImportedSQ F1Fecho.MaxwellGlobal F1Fecho.OrbitalScreen\r\nopen F1Fecho.SpacetimeLorentz F1Fecho.PhysicalTensorLorentz\r\n\r\ndef boostRegion (s:ℝ) (O:Set Spacetime) : Set Spacetime := action (theBoost s) '' O\r\n\r\ntheorem boost_action_neg (s:ℝ) (x:Spacetime) :\r\n    action (theBoost (-s)) (action (theBoost s) x)=x := by\r\n  rw [←F1Fecho.OrbitalSpatial.theBoost_inv_eq]\r\n  exact (action (theBoost s)).symm_apply_apply x\r\n\r\ntheorem boostRegion_inverse (s:ℝ) (O:Set Spacetime) :\r\n    boostRegion (-s) (boostRegion s O)=O := by\r\n  ext x\r\n  constructor\r\n  · rintro ⟨y,⟨z,hz,rfl⟩,rfl⟩\r\n    simpa only [boost_action_neg] using hz\r\n  · intro hx\r\n    exact ⟨action (theBoost s) x,⟨x,hx,rfl⟩,boost_action_neg s x⟩\r\n\r\ntheorem boosted_generator (s:ℝ) (O:Set Spacetime) (v:H1)\r\n    (hv:v∈supportedGenerators O) :\r\n    B0 s v∈supportedGenerators (boostRegion s O) := by\r\n  obtain ⟨f,hr,hs,rfl⟩:=hv\r\n  exact ⟨transform (theBoost s) f,transform_real _ f hr,\r\n    (transform_support _ f).trans (Set.image_mono hs),circularSmear_boost s f⟩\r\n\r\ntheorem localized_boost (s:ℝ) (O:Set Spacetime) (v:H1)\r\n    (hv:v∈localized O) : B0 s v∈localized (boostRegion s O) := by\r\n  let T:H1→L[ℝ]H1:=(B0 s).toLinearIsometry.toContinuousLinearMap.restrictScalars ℝ\r\n  have hs:(Submodule.span ℝ (supportedGenerators O)).map T.toLinearMap≤\r\n      Submodule.span ℝ (supportedGenerators (boostRegion s O)) := by\r\n    rw [Submodule.map_span]\r\n    apply Submodule.span_le.mpr\r\n    rintro w ⟨x,hx,rfl⟩\r\n    exact Submodule.subset_span (boosted_generator s O x hx)\r\n  exact (Submodule.topologicalClosure_mono hs)\r\n    ((Submodule.topologicalClosure_map T _) (Submodule.mem_map.mpr ⟨v,hv,rfl⟩))\r\n\r\ntheorem localized_boost_iff (s:ℝ) (O:Set Spacetime) (v:H1) :\r\n    v∈localized O ↔ B0 s v∈localized (boostRegion s O) := by\r\n  constructor\r\n  · exact localized_boost s O v\r\n  · intro hv\r\n    have h:=localized_boost (-s) (boostRegion s O) (B0 s v) hv\r\n    rw [boostRegion_inverse] at h\r\n    have hi:B0 (-s) (B0 s v)=v := by\r\n      have hh:=congrArg (fun u:H1≃ₗᵢ[ℂ]H1=>u v) (B0_add (-s) s)\r\n      rw [neg_add_cancel,B0_zero] at hh\r\n      exact hh.symm\r\n    rwa [hi] at h\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.boostRegion_inverse\r\n#print axioms F1Fecho.MaxwellLocalization.localized_boost\r\n#print axioms F1Fecho.MaxwellLocalization.localized_boost_iff\r\n",
+    'TGLExt/F1Fecho394/PhysicalLocalizedSubspacesR3.lean': 'import TGLExt.F1Fecho394.PhysicalSmearTranslationR2\r\n\r\n/-! The actual closed real subspaces generated by supported real Maxwell tests.\r\nThis block proves isotony, translation covariance and global nontriviality.\r\nCausal locality and equality of its right wedge with canonical KWR are NOT\r\nfields here and are not asserted by these elementary support statements. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen F1Fecho.MaxwellGlobal TGLExt.ImportedSQ\r\n\r\ndef supportedGenerators (O : Set Spacetime) : Set H1 :=\r\n  {v | ∃ f : SchwartzTensor, IsRealTest f ∧\r\n    Function.support (f : Spacetime → TensorValue) ⊆ O ∧ circularSmear f=v}\r\n\r\ndef localized (O : Set Spacetime) : Submodule ℝ H1 :=\r\n  (Submodule.span ℝ (supportedGenerators O)).topologicalClosure\r\n\r\ntheorem localized_closed (O : Set Spacetime) : IsClosed (localized O : Set H1) :=\r\n  Submodule.isClosed_topologicalClosure _\r\n\r\ntheorem localized_mono {O P : Set Spacetime} (h : O ⊆ P) : localized O ≤ localized P := by\r\n  apply Submodule.topologicalClosure_mono\r\n  apply Submodule.span_mono\r\n  rintro v ⟨f,hr,hs,hv⟩\r\n  exact ⟨f,hr,hs.trans h,hv⟩\r\n\r\ndef translateRegion (a : Spacetime) (O : Set Spacetime) : Set Spacetime :=\r\n  {x | x-a ∈ O}\r\n\r\ntheorem translated_generator (a : Spacetime) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ supportedGenerators O) :\r\n    U1 (fun i => a i) v ∈ supportedGenerators (translateRegion a O) := by\r\n  obtain ⟨f,hr,hs,rfl⟩:=hv\r\n  refine ⟨translateTest a f,translateTest_real a f hr,?_,circularSmear_translate a f⟩\r\n  intro x hx\r\n  exact hs hx\r\n\r\ntheorem localized_translate (a : Spacetime) (O : Set Spacetime) (v : H1)\r\n    (hv : v ∈ localized O) : U1 (fun i => a i) v ∈ localized (translateRegion a O) := by\r\n  let T : H1 →L[ℝ] H1 :=\r\n    (U1 (fun i => a i)).toLinearIsometry.toContinuousLinearMap.restrictScalars ℝ\r\n  have hs : (Submodule.span ℝ (supportedGenerators O)).map T.toLinearMap ≤\r\n      Submodule.span ℝ (supportedGenerators (translateRegion a O)) := by\r\n    rw [Submodule.map_span]\r\n    apply Submodule.span_le.mpr\r\n    rintro w ⟨v,hv,rfl⟩\r\n    exact Submodule.subset_span (translated_generator a O v hv)\r\n  exact (Submodule.topologicalClosure_mono hs)\r\n    ((Submodule.topologicalClosure_map T _)\r\n      (Submodule.mem_map.mpr ⟨v,hv,rfl⟩))\r\n\r\ntheorem translateRegion_inverse (a : Spacetime) (O : Set Spacetime) :\r\n    translateRegion (-a) (translateRegion a O)=O := by\r\n  ext x\r\n  simp [translateRegion]\r\n\r\ntheorem localized_translate_iff (a : Spacetime) (O : Set Spacetime) (v : H1) :\r\n    v ∈ localized O ↔ U1 (fun i => a i) v ∈ localized (translateRegion a O) := by\r\n  constructor\r\n  · exact localized_translate a O v\r\n  · intro hv\r\n    have h:=localized_translate (-a) (translateRegion a O) (U1 (fun i => a i) v) hv\r\n    rw [translateRegion_inverse] at h\r\n    have hi : U1 (fun i => (-a) i) (U1 (fun i => a i) v)=v := by\r\n      have hh:=congrArg (fun u : H1 ≃ₗᵢ[ℂ] H1 => u v)\r\n        (U1_add (fun i => (-a) i) (fun i => a i))\r\n      have hz : (fun i => (-a) i)+(fun i => a i)=(0 : Fin 4 → ℝ) := by\r\n        funext i\r\n        simp\r\n      rw [hz,U1_zero] at hh\r\n      exact hh.symm\r\n    rwa [hi] at h\r\n\r\ntheorem localized_univ_nonzero : ∃ v : H1,v ∈ localized Set.univ ∧ v≠0 := by\r\n  obtain ⟨f,hf⟩:=exists_nonzero_real_circularSmear\r\n  refine ⟨circularSmear f.val,?_,hf⟩\r\n  exact (Submodule.le_topologicalClosure _)\r\n    (Submodule.subset_span ⟨f.val,f.property,Set.subset_univ _,rfl⟩)\r\n\r\nend F1Fecho.MaxwellLocalization\r\n#print axioms F1Fecho.MaxwellLocalization.localized_mono\r\n#print axioms F1Fecho.MaxwellLocalization.localized_translate\r\n#print axioms F1Fecho.MaxwellLocalization.localized_translate_iff\r\n#print axioms F1Fecho.MaxwellLocalization.localized_univ_nonzero\r\n',
+    'TGLExt/F1Fecho394/PhysicalNetGeometryR1.lean': "import TGLExt.F1Fecho394.PhysicalLocalizedBoostR2\r\n\r\n/-! Coordinate adapter of the actual physical real-test net to LightNetData's\r\nregion type. Isotony and translation/boost covariance are supplied by terms.\r\nNo helicity label, causal locality or right-wedge equality is manufactured. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellLocalization\r\nopen TGLExt.ImportedSQ TGLExt.ContratoQGv31 F1Fecho.MaxwellGlobal\r\nopen F1Fecho.SpacetimeLorentz\r\n\r\ndef spacetimeOf (a:Fin 4→ℝ) : Spacetime := WithLp.toLp 2 a\r\ndef coordinateRegion (O:Set (Fin 4→ℝ)) : Set Spacetime :=\r\n  {x | (fun i=>x i)∈O}\r\ndef physicalNet (O:Set (Fin 4→ℝ)) : Submodule ℝ H1 := localized (coordinateRegion O)\r\n\r\ntheorem physicalNet_mono (O P:Set (Fin 4→ℝ)) (h:O⊆P) :\r\n    physicalNet O≤physicalNet P := localized_mono (fun _ hx=>h hx)\r\n\r\ntheorem coordinateRegion_translate (a:Fin 4→ℝ) (O:Set (Fin 4→ℝ)) :\r\n    coordinateRegion (TGL.SpecificAQFT.translate a O)=\r\n      translateRegion (spacetimeOf a) (coordinateRegion O) := by\r\n  ext x\r\n  constructor\r\n  · rintro ⟨y,hy,he⟩\r\n    have hx:(fun i=>(x-spacetimeOf a) i)=y := by\r\n      funext i\r\n      have hh:=congrFun he i\r\n      change y i+a i=x i at hh\r\n      change x i-a i=y i\r\n      linarith\r\n    change (fun i=>(x-spacetimeOf a) i)∈O\r\n    rwa [hx]\r\n  · intro hx\r\n    refine ⟨(fun i=>(x-spacetimeOf a) i),hx,?_⟩\r\n    funext i\r\n    change x i-a i+a i=x i\r\n    ring\r\n\r\ntheorem coordinateRegion_boost (s:ℝ) (O:Set (Fin 4→ℝ)) :\r\n    coordinateRegion (wedgeBoostMap s '' O)=boostRegion s (coordinateRegion O) := by\r\n  ext x\r\n  constructor\r\n  · rintro ⟨y,hy,he⟩\r\n    refine ⟨spacetimeOf y,hy,?_⟩\r\n    apply PiLp.ext\r\n    intro i\r\n    exact congrFun he i\r\n  · rintro ⟨y,hy,he⟩\r\n    refine ⟨(fun i=>y i),hy,?_⟩\r\n    funext i\r\n    exact congrArg (fun z:Spacetime=>