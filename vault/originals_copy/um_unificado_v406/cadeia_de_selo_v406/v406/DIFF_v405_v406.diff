+    'TGLExt/F1Fecho394/MaxwellScreenDualTensorR2.lean': "import TGLExt.F1Fecho394.CartesianMaxwellBivectorR6\r\n\r\n/-! Concrete right inverse of the actual antisymmetric tensor contraction,\r\non the regular transverse chart. It uses components 01 and 23 of the already\r\nconstructed p-wedge-screen bivectors. No spacetime extension is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen Matrix ChatgptAudit.WignerRapidityMeasure016\r\n\r\ndef screenDualTensor (q : Transverse) (v : Fin 2→ℂ) : Matrix (Fin 4) (Fin 4) ℂ :=\r\n  let r : ℂ:=transverseMass 0 q\r\n  !![0,v 0/r,0,0; -v 0/r,0,0,0; 0,0,0,v 1/r; 0,0,-v 1/r,0]\r\n\r\ntheorem screenDualTensor_antisymmetric (q : Transverse) (v : Fin 2→ℂ) (μ ν : Fin 4) :\r\n    screenDualTensor q v μ ν= -screenDualTensor q v ν μ := by\r\n  fin_cases μ <;> fin_cases ν <;> simp [screenDualTensor,neg_div]\r\n\r\ntheorem screenDualTensor_right_inverse (y : MomentumCoordinates) (hy : y.1≠0)\r\n    (v : Fin 2→ℂ) (j : Fin 2) :\r\n    (1/2:ℂ)*∑μ : Fin 4,∑ν : Fin 4,\r\n      (cartesianStrength y j μ ν : ℂ)*screenDualTensor y.1 v μ ν=v j := by\r\n  have hr : (transverseMass 0 y.1 : ℂ)≠0 := by\r\n    exact_mod_cast (transverseMass_pos_of_ne_zero 0 y.1 hy).ne'\r\n  fin_cases j <;>\r\n    simp [cartesianStrength,screenDualTensor,Fin.sum_univ_succ] <;>\r\n    field_simp [hr] <;> ring\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.screenDualTensor_antisymmetric\r\n#print axioms F1Fecho.MaxwellGlobal.screenDualTensor_right_inverse\r\n",
+    'TGLExt/F1Fecho394/MaxwellScreenIntertwinerR2.lean': 'import TGLExt.F1Fecho394.MaxwellOnShellBivectorR2\r\nimport TGLExt.O16.TransverseCocycle_v3\r\n\r\n/-! The concrete O16 screen cocycle intertwines the physical bivector p wedge\r\n epsilon. The longitudinal gauge remainder is eliminated algebraically.\r\n No global Lorentz representation, test-function map or stress tensor is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellOnShell\r\nopen Matrix ChatgptAudit.WignerOrbit016 ChatgptAudit.WignerRapidityMeasure016\r\n\r\ndef realStrength (p e : Fin 4 → ℝ) (μ ν : Fin 4) : ℝ := p μ*e ν-p ν*e μ\r\n\r\ntheorem real_strength_screen_transport\r\n    (g : (Fin 4 → ℝ) →ₗ[ℝ] (Fin 4 → ℝ)) (x y : MomentumCoordinates)\r\n    (hx : x.1≠0) (hy : y.1≠0)\r\n    (gp : g (shellMomentum 0 (rapidityChart 0 x))=shellMomentum 0 (rapidityChart 0 y))\r\n    (gm : ∀ a b,orbitPairing (g a) (g b)=orbitPairing a b) (j : Fin 2) (μ ν : Fin 4) :\r\n    realStrength (g (shellMomentum 0 (rapidityChart 0 x))) (g (screen x j)) μ ν =\r\n      screenCoefficient g x y 0 j*realStrength (shellMomentum 0 (rapidityChart 0 y)) (screen y 0) μ ν+\r\n      screenCoefficient g x y 1 j*realStrength (shellMomentum 0 (rapidityChart 0 y)) (screen y 1) μ ν := by\r\n  have ht : orbitPairing (g (screen x j)) (shellMomentum 0 (rapidityChart 0 y))=0 := by\r\n    rw [←gp,gm]\r\n    exact screen_transverse x hx j\r\n  have hd := transverse_decomposition y hy (g (screen x j)) ht\r\n  rw [gp]\r\n  unfold realStrength\r\n  rw [congrFun hd ν,congrFun hd μ]\r\n  simp only [Pi.sub_apply,Pi.smul_apply,smul_eq_mul]\r\n  simp only [screenCoefficient,screen,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one]\r\n  rw [orbitPairing_symm (screenOne y) (g (![screenOne x,screenTwo x] j)),\r\n    orbitPairing_symm (screenTwo y) (g (![screenOne x,screenTwo x] j))]\r\n  ring\r\n\r\ndef realLift (p : Fin 4 → ℝ) : Fin 4 → ℂ := fun i => (p i:ℂ)\r\n\r\ntheorem strength_of_real (p e : Fin 4 → ℝ) (μ ν : Fin 4) :\r\n    strength (realLift p) (realLift e) μ ν=(realStrength p e μ ν:ℂ) := by\r\n  simp [strength,realStrength,realLift]\r\n\r\ntheorem strength_screen_transport\r\n    (g : (Fin 4 → ℝ) →ₗ[ℝ] (Fin 4 → ℝ)) (x y : MomentumCoordinates)\r\n    (hx : x.1≠0) (hy : y.1≠0)\r\n    (gp : g (shellMomentum 0 (rapidityChart 0 x))=shellMomentum 0 (rapidityChart 0 y))\r\n    (gm : ∀ a b,orbitPairing (g a) (g b)=orbitPairing a b) (j : Fin 2) (μ ν : Fin 4) :\r\n    strength (realLift (g (shellMomentum 0 (rapidityChart 0 x)))) (realLift (g (screen x j))) μ ν =\r\n      (screenCoefficient g x y 0 j:ℂ)*strength (momentum y) (realLift (screen y 0)) μ ν+\r\n      (screenCoefficient g x y 1 j:ℂ)*strength (momentum y) (realLift (screen y 1)) μ ν := by\r\n  have hh := congrArg Complex.ofReal (real_strength_screen_transport g x y hx hy gp gm j μ ν)\r\n  simpa only [momentum,realLift,strength,realStrength,Complex.ofReal_add,Complex.ofReal_sub,\r\n    Complex.ofReal_mul] using hh\r\n\r\nend F1Fecho.MaxwellOnShell\r\n#print axioms F1Fecho.MaxwellOnShell.real_strength_screen_transport\r\n#print axioms F1Fecho.MaxwellOnShell.strength_of_real\r\n#print axioms F1Fecho.MaxwellOnShell.strength_screen_transport\r\n',
+    'TGLExt/F1Fecho394/MaxwellShellGeometryR3.lean': 'import TGLExt.F1Fecho394.MaxwellOnShellBivectorR2\r\nimport Mathlib.Analysis.InnerProductSpace.PiL2\r\n\r\n/-! Cartesian mass-shell geometry: properness and linear energy growth, before\r\nany integrability conclusion. The spatial coordinates are the canonical ones. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen Matrix MeasureTheory\r\nopen ChatgptAudit.WignerRapidityMeasure016 ChatgptAudit.WignerOrbit016\r\n\r\ndef shellEnergy (y : MomentumCoordinates) : ℝ := energy (transverseMass 0 y.1) y.2\r\nabbrev Spacetime := EuclideanSpace ℝ (Fin 4)\r\ndef shellEmbedding (y : MomentumCoordinates) : Spacetime := WithLp.toLp 2 (shellMomentum 0 y)\r\n\r\ntheorem shellEnergy_nonneg (y : MomentumCoordinates) : 0≤ shellEnergy y := Real.sqrt_nonneg _\r\ntheorem shellEnergy_sq (y : MomentumCoordinates) :\r\n    shellEnergy y^2=y.1 0^2+y.1 1^2+y.2^2 := by\r\n  rw [shellEnergy,energy,Real.sq_sqrt (by positivity),transverseMass_sq]\r\n  ring\r\n\r\ntheorem shellEnergy_continuous : Continuous shellEnergy := by\r\n  unfold shellEnergy energy transverseMass\r\n  fun_prop\r\n\r\ntheorem abs_spatial_le_energy (y : MomentumCoordinates) :\r\n    |y.1 0|≤ shellEnergy y ∧ |y.1 1|≤ shellEnergy y ∧ |y.2|≤ shellEnergy y := by\r\n  have hs := shellEnergy_sq y\r\n  have hn := shellEnergy_nonneg y\r\n  constructor\r\n  · rw [abs_le]; constructor <;> nlinarith [sq_nonneg (y.1 1),sq_nonneg y.2]\r\n  constructor\r\n  · rw [abs_le]; constructor <;> nlinarith [sq_nonneg (y.1 0),sq_nonneg y.2]\r\n  · rw [abs_le]; constructor <;> nlinarith [sq_nonneg (y.1 0),sq_nonneg (y.1 1)]\r\n\r\ntheorem coordinate_norm_le_energy (y : MomentumCoordinates) : ‖y‖≤ shellEnergy y := by\r\n  rw [Prod.norm_def]\r\n  apply max_le\r\n  · apply (pi_norm_le_iff_of_nonneg (shellEnergy_nonneg y)).mpr\r\n    intro i\r\n    fin_cases i\r\n    · exact (abs_spatial_le_energy y).1\r\n    · exact (abs_spatial_le_energy y).2.1\r\n  · exact (abs_spatial_le_energy y).2.2\r\n\r\ntheorem energy_le_twice_coordinate_norm (y : MomentumCoordinates) : shellEnergy y≤2*‖y‖ := by\r\n  have h0 : |y.1 0|≤‖y‖ := (norm_le_pi_norm y.1 0).trans (norm_fst_le y)\r\n  have h1 : |y.1 1|≤‖y‖ := (norm_le_pi_norm y.1 1).trans (norm_fst_le y)\r\n  have h2 : |y.2|≤‖y‖ := norm_snd_le y\r\n  have hs := shellEnergy_sq y\r\n  have hn := shellEnergy_nonneg y\r\n  have hh := norm_nonneg y\r\n  have h0s := pow_le_pow_left₀ (abs_nonneg (y.1 0)) h0 2\r\n  have h1s := pow_le_pow_left₀ (abs_nonneg (y.1 1)) h1 2\r\n  have h2s := pow_le_pow_left₀ (abs_nonneg y.2) h2 2\r\n  rw [sq_abs] at h0s h1s h2s\r\n  nlinarith\r\n\r\n\r\ntheorem shellEmbedding_continuous : Continuous shellEmbedding :=\r\n  (PiLp.continuous_toLp 2 (fun _ : Fin 4 => ℝ)).comp (shellMomentum_continuous 0)\r\n\r\ntheorem energy_le_embedding_norm (y : MomentumCoordinates) : shellEnergy y≤‖shellEmbedding y‖ := by\r\n  have h := PiLp.norm_apply_le (shellEmbedding y) 0\r\n  change |shellEnergy y| ≤ ‖shellEmbedding y‖ at h\r\n  simpa [abs_of_nonneg (shellEnergy_nonneg y)] using h\r\n\r\ntheorem shellEmbedding_proper_bound (y : MomentumCoordinates) : ‖y‖≤‖shellEmbedding y‖ :=\r\n  (coordinate_norm_le_energy y).trans (energy_le_embedding_norm y)\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.shellEnergy_sq\r\n#print axioms F1Fecho.MaxwellGlobal.coordinate_norm_le_energy\r\n#print axioms F1Fecho.MaxwellGlobal.energy_le_twice_coordinate_norm\r\n#print axioms F1Fecho.MaxwellGlobal.shellEmbedding_proper_bound\r\n',
+    'TGLExt/F1Fecho394/MaxwellSmearingLinearR2.lean': 'import TGLExt.F1Fecho394.MaxwellChartSmearingR4\r\n\r\n/-! Linearity of the explicit on-shell tensor-to-H1 map on its stated compact\r\nregular-chart test domain. Proof witnesses only certify support, not physics. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellSmearing\r\nopen MeasureTheory Filter Matrix\r\nopen ChatgptAudit.WignerRapidityMeasure016 TGLExt.ImportedSQ F1Fecho.MaxwellOnShell\r\nopen scoped CompactlySupported\r\n\r\ntheorem coefficient_add (f g : TestTensor) : coefficient (f+g)=coefficient f+coefficient g := by\r\n  funext y\r\n  apply PiLp.ext\r\n  intro j\r\n  simp [coefficient,mul_add,Finset.sum_add_distrib]\r\n\r\ntheorem coefficient_smul (c : ℂ) (f : TestTensor) : coefficient (c • f)=c • coefficient f := by\r\n  funext y\r\n  apply PiLp.ext\r\n  intro j\r\n  change (1/2:ℂ)*(∑ μ,∑ ν,strength (momentum y) (realLift (screen y j)) μ ν*\r\n    (c*f y μ ν))=c*((1/2:ℂ)*(∑ μ,∑ ν,strength (momentum y) (realLift (screen y j)) μ ν*f y μ ν))\r\n  have he : (∑ μ,∑ ν,strength (momentum y) (realLift (screen y j)) μ ν*(c*f y μ ν))=\r\n      c*(∑ μ,∑ ν,strength (momentum y) (realLift (screen y j)) μ ν*f y μ ν) := by\r\n    rw [Finset.mul_sum]\r\n    apply Finset.sum_congr rfl\r\n    intro μ _\r\n    rw [Finset.mul_sum]\r\n    apply Finset.sum_congr rfl\r\n    intro ν _\r\n    ring\r\n  rw [he]\r\n  ring\r\n\r\ntheorem smear_add (f g : TestTensor) (hf : ∀ y∈tsupport f,y.1≠0)\r\n    (hg : ∀ y∈tsupport g,y.1≠0) (hfg : ∀ y∈tsupport (f+g),y.1≠0) :\r\n    smear (f+g) hfg=smear f hf+smear g hg := by\r\n  apply (orbitalL2Pullback 0).injective\r\n  simp only [map_add,smear,orbitalL2Pullback_inverse]\r\n  apply Lp.ext\r\n  filter_upwards [(coefficient_memLp (f+g) hfg).coeFn_toLp,\r\n    (coefficient_memLp f hf).coeFn_toLp,(coefficient_memLp g hg).coeFn_toLp,\r\n    Lp.coeFn_add ((coefficient_memLp f hf).toLp _) ((coefficient_memLp g hg).toLp _)] with y h1 h2 h3 h4\r\n  rw [h1,h4]\r\n  simp only [Pi.add_apply]\r\n  rw [h2,h3]\r\n  exact congrFun (coefficient_add f g) y\r\n\r\ntheorem smear_smul (c : ℂ) (f : TestTensor) (hf : ∀ y∈tsupport f,y.1≠0)\r\n    (hcf : ∀ y∈tsupport (c • f),y.1≠0) : smear (c • f) hcf=c • smear f hf := by\r\n  apply (orbitalL2Pullback 0).injective\r\n  simp only [map_smul,smear,orbitalL2Pullback_inverse]\r\n  apply Lp.ext\r\n  filter_upwards [(coefficient_memLp (c • f) hcf).coeFn_toLp,\r\n    (coefficient_memLp f hf).coeFn_toLp,\r\n    Lp.coeFn_smul c ((coefficient_memLp f hf).toLp _)] with y h1 h2 h3\r\n  rw [h1,h3]\r\n  simp only [Pi.smul_apply]\r\n  rw [h2]\r\n  exact congrFun (coefficient_smul c f) y\r\n\r\nend F1Fecho.MaxwellSmearing\r\n#print axioms F1Fecho.MaxwellSmearing.coefficient_add\r\n#print axioms F1Fecho.MaxwellSmearing.coefficient_smul\r\n#print axioms F1Fecho.MaxwellSmearing.smear_add\r\n#print axioms F1Fecho.MaxwellSmearing.smear_smul\r\n',
+    'TGLExt/F1Fecho394/MaxwellStripCoefficientR5.lean': 'import TGLExt.F1Fecho394.MaxwellComplexRapidityR3\r\nimport TGLExt.F1Fecho394.WedgePhysicalFourierR2\r\nimport TGLExt.F1Fecho394.PhysicalFourierDerivativeR4\r\n\r\n/-! The strip coefficient uses the actual tensor entries and p-wedge-screen.\r\nIts real boundary is the existing global coefficient of physicalFourierCLM;\r\nits reflected lower boundary and analyticity are proved from real support. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 2000000\r\nnoncomputable section\r\nopen MeasureTheory Matrix\r\nopen scoped FourierTransform\r\nnamespace F1Fecho.MaxwellStrip\r\nopen F1Fecho.MaxwellGlobal F1Fecho.WedgeLaplace SchwartzMap\r\nopen ChatgptAudit.WignerRapidityMeasure016 F1Rede.WedgeReflectionTranslations\r\n\r\ndef componentProjection (μ ν : Fin 4) : TensorValue →L[ℂ] ℂ :=\r\n  (ContinuousLinearMap.proj ν : (Fin 4 → ℂ) →L[ℂ] ℂ).comp\r\n    (ContinuousLinearMap.proj μ : TensorValue →L[ℂ] (Fin 4 → ℂ))\r\n\r\ndef componentTest (f : SchwartzTensor) (μ ν : Fin 4) : 𝓢(Spacetime,ℂ) :=\r\n  SchwartzMap.postcompCLM (componentProjection μ ν) f\r\n\r\ntheorem componentTest_apply (f : SchwartzTensor) (μ ν : Fin 4) (x : Spacetime) :\r\n    componentTest f μ ν x=f x μ ν := rfl\r\n\r\ntheorem componentTest_real (f : SchwartzTensor) (hf : IsRealTest f) (μ ν : Fin 4) :\r\n    ∀ x,(componentTest f μ ν x).im=0 := fun x => hf x μ ν\r\n\r\ndef supportedTensorRight (f : SchwartzTensor) : Prop :=\r\n  ∀ x ∈ Function.support (f : Spacetime → TensorValue), |x 0| < x 1\r\n\r\ntheorem componentTest_supported (f : SchwartzTensor) (hf : supportedTensorRight f)\r\n    (μ ν : Fin 4) : supportedRight (componentTest f μ ν) := by\r\n  intro x hx\r\n  apply hf x\r\n  intro hz\r\n  apply hx\r\n  simp only [componentTest_apply,hz,Pi.zero_apply]\r\n\r\ndef maxwellLaplace (q : Fin 2 → ℝ) (f : SchwartzTensor) (j : Fin 2) (z : ℂ) : ℂ :=\r\n  (1/2:ℂ)*∑ μ,∑ ν,analyticStrength q j μ ν z *\r\n    scalarLaplace (transverseMass 0 q) (q 0) (q 1) (componentTest f μ ν) z\r\n\r\ntheorem componentLaplace_real (y : MomentumCoordinates) (hy : y.1 ≠ 0)\r\n    (f : SchwartzTensor) (μ ν : Fin 4) :\r\n    scalarLaplace (transverseMass 0 y.1) (y.1 0) (y.1 1) (componentTest f μ ν) y.2 =\r\n      physicalFourierCLM f (shellEmbedding (rapidityChart 0 y)) μ ν := by\r\n  rw [scalarLaplace_real_shell y hy]\r\n  change (𝓕⁻ (SchwartzMap.postcompCLM (componentProjection μ ν) f)) _ = _\r\n  rw [schwartz_fourierInv_postcomp,physicalFourier_apply]\r\n  rfl\r\n\r\ntheorem maxwellLaplace_real (y : MomentumCoordinates) (hy : y.1 ≠ 0)\r\n    (f : SchwartzTensor) (j : Fin 2) :\r\n    maxwellLaplace y.1 f j y.2=globalCoefficient (physicalFourierCLM f) (rapidityChart 0 y) j := by\r\n  change (1/2:ℂ)*(∑ μ,∑ ν,_)=(1/2:ℂ)*(∑ μ,∑ ν,_)\r\n  congr 1\r\n  apply Finset.sum_congr rfl\r\n  intro μ _\r\n  apply Finset.sum_congr rfl\r\n  intro ν _\r\n  rw [analyticStrength_real y hy,componentLaplace_real y hy]\r\n\r\ntheorem maxwellLaplace_differentiable (q : Fin 2 → ℝ) (f : SchwartzTensor)\r\n    (hf : supportedTensorRight f) (j : Fin 2) :\r\n    DifferentiableOn ℂ (maxwellLaplace q f j) lowerOpenStrip := by\r\n  apply DifferentiableOn.const_mul\r\n  apply DifferentiableOn.fun_sum\r\n  intro μ _\r\n  apply DifferentiableOn.fun_sum\r\n  intro ν _\r\n  exact (analyticStrength_entire q j μ ν).differentiableOn.mul\r\n    (scalarLaplace_diffContOnCl _ _ _ _ (by unfold transverseMass; positivity)\r\n      (componentTest_supported f hf μ ν)).1\r\n\r\ntheorem maxwellLaplace_continuous (q : Fin 2 → ℝ) (f : SchwartzTensor)\r\n    (hf : supportedTensorRight f) (j : Fin 2) :\r\n    ContinuousOn (maxwellLaplace q f j) lowerClosedStrip := by\r\n  apply ContinuousOn.const_mul\r\n  apply continuousOn_finsetSum\r\n  intro μ _\r\n  apply continuousOn_finsetSum\r\n  intro ν _\r\n  exact (analyticStrength_entire q j μ ν).continuous.continuousOn.mul\r\n    (scalarLaplace_continuous_closed _ _ _ _ (by unfold transverseMass; positivity)\r\n      (componentTest