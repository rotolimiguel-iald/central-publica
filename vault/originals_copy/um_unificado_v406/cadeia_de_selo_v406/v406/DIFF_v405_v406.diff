+    'TGLExt/F1Fecho394/RegularMaxwellWaveDensityR3.lean': "import TGLExt.F1Fecho394.PhysicalSchwartzMaxwellR1\r\nimport TGLExt.F1Fecho394.SchwartzRestrictionMomentsR1\r\n\r\n/-! Actual regular on-shell wave density from a Schwartz profile. All energy\r\nmoments are integrable, establishing the pointwise domain before local Wick\r\nstress is attempted. No covariance or coincident-point operator is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen MeasureTheory SchwartzMap Filter\r\nopen TGLExt.ImportedSQ ChatgptAudit.WignerRapidityMeasure016\r\nopen F1Fecho.SchwartzRestriction\r\nopen scoped ENNReal\r\n\r\ndef waveDensity (f : SchwartzTensor) (μ ν : Fin 4) (y : MomentumCoordinates) : ℂ :=\r\n  ∑ j : Fin 2,(cartesianStrength y j μ ν:ℂ)*globalCoefficient f y j\r\n\r\ntheorem waveDensity_measurable (f : SchwartzTensor) (μ ν : Fin 4) :\r\n    Measurable (waveDensity f μ ν) := by\r\n  apply Finset.measurable_sum\r\n  intro j hj\r\n  exact (Complex.continuous_ofReal.measurable.comp (cartesianStrength_measurable j μ ν)).mul\r\n    ((PiLp.continuous_apply 2 _ j).measurable.comp (globalCoefficient_measurable f))\r\n\r\ntheorem waveDensity_bound (f : SchwartzTensor) (μ ν : Fin 4) (y : MomentumCoordinates) :\r\n    ‖waveDensity f μ ν y‖≤16*shellEnergy y^2*‖f (shellEmbedding y)‖ := by\r\n  have hh (j : Fin 2) : ‖(cartesianStrength y j μ ν:ℂ)*globalCoefficient f y j‖≤\r\n      8*shellEnergy y^2*‖f (shellEmbedding y)‖ := by\r\n    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]\r\n    have h:=mul_le_mul (cartesianStrength_bound y j μ ν)\r\n      (globalCoefficient_component_bound f y j) (norm_nonneg _) (shellEnergy_nonneg y)\r\n    calc\r\n      _ ≤ shellEnergy y*(8*shellEnergy y*‖f (shellEmbedding y)‖) := h\r\n      _ = _ := by ring\r\n  have h:= (norm_sum_le Finset.univ (fun j : Fin 2=>\r\n    (cartesianStrength y j μ ν:ℂ)*globalCoefficient f y j)).trans\r\n      (Finset.sum_le_sum (fun j _=>hh j))\r\n  simp only [Finset.sum_const,Finset.card_univ,Fintype.card_fin,nsmul_eq_mul] at h\r\n  change ‖∑ j : Fin 2,(cartesianStrength y j μ ν:ℂ)*globalCoefficient f y j‖≤_\r\n  norm_num at h\r\n  rw [Fin.sum_univ_two]\r\n  nlinarith only [h]\r\n\r\ntheorem shell_moment_integrable (f : SchwartzTensor) (m : ℕ) :\r\n    Integrable (fun y=>shellEnergy y^m*‖f (shellEmbedding y)‖) momentumMeasure := by\r\n  letI : momentumMeasure.IsAddHaarMeasure := by unfold momentumMeasure; infer_instance\r\n  exact energy_moment_restriction_integrable f shellEmbedding shellEnergy\r\n    (by norm_num : (0:ℝ)≤2) shellEmbedding_proper_bound energy_le_twice_coordinate_norm\r\n    shellEnergy_nonneg shellEmbedding_continuous.measurable shellEnergy_continuous.measurable m\r\n\r\ntheorem waveDensity_weighted_bound (f : SchwartzTensor) (μ ν : Fin 4)\r\n    (m : ℕ) (y : MomentumCoordinates) :\r\n    ‖(orbitalWeight 0 y).toReal • (shellEnergy y^m*‖waveDensity f μ ν y‖)‖≤\r\n      16*(shellEnergy y^(m+1)*‖f (shellEmbedding y)‖) := by\r\n  have hp:=shellEnergy_nonneg y\r\n  have hw : (orbitalWeight 0 y).toReal=1/shellEnergy y := by\r\n    unfold orbitalWeight shellEnergy\r\n    exact ENNReal.toReal_ofReal (by positivity)\r\n  rw [hw,smul_eq_mul,Real.norm_of_nonneg\r\n    (mul_nonneg (div_nonneg zero_le_one hp) (mul_nonneg (pow_nonneg hp _) (norm_nonneg _)))]\r\n  by_cases hz : shellEnergy y=0\r\n  · simp [hz]\r\n  · calc\r\n      _ ≤ (1/shellEnergy y)*(shellEnergy y^m*(16*shellEnergy y^2*‖f (shellEmbedding y)‖)) :=\r\n        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left\r\n          (waveDensity_bound f μ ν y) (pow_nonneg hp _)) (div_nonneg zero_le_one hp)\r\n      _ = _ := by rw [pow_succ]; field_simp [hz]; ring\r\n\r\ntheorem waveDensity_moment_integrable (f : SchwartzTensor) (μ ν : Fin 4) (m : ℕ) :\r\n    Integrable (fun y=>shellEnergy y^m*‖waveDensity f μ ν y‖) (orbitalMeasure 0) := by\r\n  change Integrable _ (momentumMeasure.withDensity (orbitalWeight 0))\r\n  apply (integrable_withDensity_iff_integrable_smul' (orbitalWeight_measurable 0)\r\n    (Filter.Eventually.of_forall (fun y=>ENNReal.ofReal_lt_top))).mpr\r\n  apply ((shell_moment_integrable f (m+1)).const_mul 16).mono'\r\n  · exact (((orbitalWeight_measurable 0).ennreal_toReal).mul\r\n      ((shellEnergy_continuous.measurable.pow_const m).mul (waveDensity_measurable f μ ν).norm)).aestronglyMeasurable\r\n  · exact Filter.Eventually.of_forall (waveDensity_weighted_bound f μ ν m)\r\n\r\ntheorem waveDensity_integrable (f : SchwartzTensor) (μ ν : Fin 4) :\r\n    Integrable (waveDensity f μ ν) (orbitalMeasure 0) := by\r\n  apply (integrable_norm_iff (waveDensity_measurable f μ ν).aestronglyMeasurable).mp\r\n  simpa only [pow_zero,one_mul] using waveDensity_moment_integrable f μ ν 0\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.waveDensity_bound\r\n#print axioms F1Fecho.MaxwellGlobal.shell_moment_integrable\r\n#print axioms F1Fecho.MaxwellGlobal.waveDensity_moment_integrable\r\n#print axioms F1Fecho.MaxwellGlobal.waveDensity_integrable\r\n",
+    'TGLExt/F1Fecho394/RegularNormalizedFourierR2.lean': 'import TGLExt.F1Fecho394.RegularL2RescaleR4\r\nimport TGLExt.F1Fecho394.RegularFourierFibreR1\r\nimport TGLExt.F1Fecho394.RegularSpectralCodeR2\r\n/-! The actual normalized Fourier isometry and regular coefficient code.\r\nThe range is closed and bounded fibre operators intertwine. Identification\r\nwith the dual-weight GNS range is a separate obligation, not an input here. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 900000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularNormalizedFourier\r\nopen MeasureTheory TGLV350.Regular\r\nopen scoped FourierTransform\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem rescale_fibre (c : ℝ) (hc : 0 < c) (C : H →L[ℂ] H) (f : RegularHilbert H) :\r\n    RegularL2Rescale.rescale c hc (fibre C f) =\r\n      fibre C (RegularL2Rescale.rescale c hc f) := by\r\n  apply Lp.ext\r\n  filter_upwards [RegularL2Rescale.rescale_ae c hc (fibre C f),\r\n    (RegularL2Rescale.div_qmp c hc).ae (fibre_ae C f),\r\n    fibre_ae C (RegularL2Rescale.rescale c hc f),RegularL2Rescale.rescale_ae c hc f]\r\n    with x h1 h2 h3 h4\r\n  rw [h1,h2,h3,h4]\r\n  exact (C.map_smul_of_tower ((Real.sqrt c)⁻¹ : ℝ) (f (x/c))).symm\r\n\r\ndef normalizedFourier : RegularHilbert H ≃ₗᵢ[ℂ] RegularHilbert H :=\r\n  (Lp.fourierTransformₗᵢ ℝ H).trans\r\n    (RegularL2Rescale.rescaleEquiv (2*Real.pi) (by positivity))\r\n\r\ntheorem normalizedFourier_ae (f : RegularHilbert H) :\r\n    normalizedFourier f =ᵐ[volume] fun s : ℝ =>\r\n      ((Real.sqrt (2*Real.pi))⁻¹ : ℝ) • (Lp.fourierTransformₗᵢ ℝ H f) (s/(2*Real.pi)) :=\r\n  RegularL2Rescale.rescale_ae (2*Real.pi) (by positivity) _\r\n\r\ntheorem normalizedFourier_fibre (C : H →L[ℂ] H) (f : RegularHilbert H) :\r\n    normalizedFourier (fibre C f) = fibre C (normalizedFourier f) := by\r\n  change RegularL2Rescale.rescale (2*Real.pi) (by positivity) (Lp.fourierTransformₗᵢ ℝ H (fibre C f)) = _\r\n  rw [RegularFourierFibre.fourier_fibre,rescale_fibre]\r\n  rfl\r\n\r\ndef spectralCode : RegularHilbert H →ₗᵢ[ℂ] RegularHilbert (RegularHilbert H) :=\r\n  normalizedFourier.toLinearIsometry.comp RegularSpectralCode.codeIsometry\r\n\r\ntheorem spectralCode_fibre (C : H →L[ℂ] H) (f : RegularHilbert H) :\r\n    spectralCode (fibre C f) = fibre (fibre C) (spectralCode f) := by\r\n  change normalizedFourier (RegularSpectralCode.code (fibre C f)) = _\r\n  rw [RegularSpectralCode.code_fibre,normalizedFourier_fibre]\r\n  rfl\r\n\r\ntheorem spectralCode_injective : Function.Injective (spectralCode (H:=H)) :=\r\n  spectralCode.injective\r\n\r\ntheorem spectralCode_closedRange : IsClosed (Set.range (spectralCode (H:=H))) :=\r\n  spectralCode.isometry.isClosedEmbedding.isClosed_range\r\n\r\nend F1Fecho.RegularNormalizedFourier\r\n#print axioms F1Fecho.RegularNormalizedFourier.rescale_fibre\r\n#print axioms F1Fecho.RegularNormalizedFourier.normalizedFourier\r\n#print axioms F1Fecho.RegularNormalizedFourier.normalizedFourier_ae\r\n#print axioms F1Fecho.RegularNormalizedFourier.normalizedFourier_fibre\r\n#print axioms F1Fecho.RegularNormalizedFourier.spectralCode\r\n#print axioms F1Fecho.RegularNormalizedFourier.spectralCode_fibre\r\n#print axioms F1Fecho.RegularNormalizedFourier.spectralCode_injective\r\n#print axioms F1Fecho.RegularNormalizedFourier.spectralCode_closedRange\r\n',
+    'TGLExt/F1Fecho394/RegularOrbitMultiplicationR1.lean': 'import TGLExt.V350DualOrbitRepresentation\r\nset_option autoImplicit false\r\nset_option maxErrors 2\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularOrbitMultiplication\r\nopen TGLV350.Regular MeasureTheory\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\ntheorem apply_orbit\r\n    (A B : RegularHilbert H →L[ℂ] RegularHilbert H) (v : RegularHilbert H)\r\n    (c : ℝ) (f g : RegularHilbert (RegularHilbert H))\r\n    (hf : (f : ℝ → RegularHilbert H) =ᵐ[volume] fun s => c • dualAmbient s A v)\r\n    (hg : (g : ℝ → RegularHilbert H) =ᵐ[volume] fun s => c • dualAmbient s (B*A) v) :\r\n    dualOrbitRepresentation B f = g := by\r\n  apply Lp.ext\r\n  filter_upwards [operatorFieldLift_ae (dualIntegralFamily B) f,hf,hg] with s h1 h2 h3\r\n  change operatorFieldLift (dualIntegralFamily B) f s = _\r\n  rw [h1,h3]\r\n  change dualAmbient s B (f s) = _\r\n  rw [h2]\r\n  change dualAmbient s B ((c : ℂ) • dualAmbient s A v) =\r\n    (c : ℂ) • dualAmbient s (B*A) v\r\n  rw [map_smul,map_mul]\r\n  rfl\r\nend F1Fecho.RegularOrbitMultiplication\r\n#print axioms F1Fecho.RegularOrbitMultiplication.apply_orbit\r\n',
