+    'TGLExt/F1Fecho394/ClosedGraphRegularizationR3.lean': "import Mathlib.MeasureTheory.Measure.Lebesgue.Basic\r\nimport Mathlib.Analysis.InnerProductSpace.ProdL2\r\nimport Mathlib.Analysis.InnerProductSpace.Projection.Submodule\r\nimport Mathlib.MeasureTheory.Integral.Bochner.ContinuousLinearMap\r\n\r\n/-! Closed real graphs are preserved by integrable real group averages.\r\nA graph equality criterion requires actual regularizers with range in the\r\nsmaller domain and strong convergence, rather than mere involutivity. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.ClosedGraphRegularization\r\n\r\nvariable {E:Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\r\n\r\ntheorem integral_mem (G:Submodule ℝ E) (hG:IsClosed (G:Set E))\r\n    (f:ℝ→E) (hf:Integrable f volume) (hm:∀ᵐ t:ℝ ∂volume,f t∈G) :\r\n    (∫ t:ℝ,f t)∈G := by\r\n  letI : CompleteSpace G:=hG.completeSpace_coe\r\n  apply G.starProjection_eq_self_iff.mp\r\n  rw [←G.starProjection.integral_comp_comm hf]\r\n  apply integral_congr_ae\r\n  filter_upwards [hm] with t ht\r\n  exact G.starProjection_eq_self_iff.mpr ht\r\n\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nlocal instance : InnerProductSpace ℝ H := InnerProductSpace.complexToReal\r\n\r\ntheorem weighted_orbit_integrable (U:ℝ→H≃ₗᵢ[ℂ]H)\r\n    (hc:∀x,Continuous (fun t=>U t x)) (w:ℝ→ℝ) (hw:Integrable w volume) (x:H) :\r\n    Integrable (fun t=>w t • U t x) volume := by\r\n  apply (hw.norm.mul_const ‖x‖).mono'\r\n    (hw.aestronglyMeasurable.smul (hc x).aestronglyMeasurable)\r\n  apply ae_of_all\r\n  intro t\r\n  rw [norm_smul,(U t).norm_map]\r\n\r\ntheorem average_preserves_graph (G:Submodule ℝ (WithLp 2 (H×H)))\r\n    (hG:IsClosed (G:Set (WithLp 2 (H×H))))\r\n    (U:ℝ→H≃ₗᵢ[ℂ]H) (hc:∀x,Continuous (fun t=>U t x))\r\n    (hU:∀t x y,WithLp.toLp 2 (x,y)∈G→WithLp.toLp 2 (U t x,U t y)∈G)\r\n    (w:ℝ→ℝ) (hw:Integrable w volume) (x y:H) (hxy:WithLp.toLp 2 (x,y)∈G) :\r\n    WithLp.toLp 2 ((∫t,w t • U t x),(∫t,w t • U t y))∈G := by\r\n  let L: (H×H)≃L[ℝ]WithLp 2 (H×H):=(WithLp.prodContinuousLinearEquiv 2 ℝ H H).symm\r\n  have hx:=weighted_orbit_integrable U hc w hw x\r\n  have hy:=weighted_orbit_integrable U hc w hw y\r\n  have hi:Integrable (fun t=>L (w t • U t x,w t • U t y)) volume :=\r\n    L.toContinuousLinearMap.integrable_comp (hx.prodMk hy)\r\n  have hm:∀ᵐ t:ℝ ∂volume,L (w t • U t x,w t • U t y)∈G := by\r\n    apply ae_of_all\r\n    intro t\r\n    exact G.smul_mem (w t) (hU t x y hxy)\r\n  have he: (∫t:ℝ,L (w t • U t x,w t • U t y))=\r\n      WithLp.toLp 2 ((∫t,w t • U t x),(∫t,w t • U t y)) := by\r\n    rw [L.integral_comp_comm,integral_pair hx hy]\r\n    rfl\r\n  exact he ▸ integral_mem G hG _ hi hm\r\n\r\ntheorem graph_eq_of_regularizers (S T:Set (H×H)) (hS:IsClosed S)\r\n    (hST:S⊆T)\r\n    (hfun:∀x y z,(x,y)∈T→(x,z)∈T→y=z)\r\n    (A:ℕ→H→H) (ha:∀x,Tendsto (fun n=>A n x) atTop (𝓝 x))\r\n    (hcomm:∀n x y,(x,y)∈T→(A n x,A n y)∈T)\r\n    (hrange:∀n x,∃y,(A n x,y)∈S) : S=T := by\r\n  apply Set.Subset.antisymm hST\r\n  rintro ⟨x,y⟩ hxy\r\n  apply hS.mem_of_tendsto ((ha x).prodMk_nhds (ha y))\r\n  apply Eventually.of_forall\r\n  intro n\r\n  obtain ⟨z,hz⟩:=hrange n x\r\n  have he:=hfun (A n x) z (A n y) (hST hz) (hcomm n x y hxy)\r\n  rwa [he] at hz\r\n\r\nend F1Fecho.ClosedGraphRegularization\r\n#print axioms F1Fecho.ClosedGraphRegularization.integral_mem\r\n#print axioms F1Fecho.ClosedGraphRegularization.weighted_orbit_integrable\r\n#print axioms F1Fecho.ClosedGraphRegularization.average_preserves_graph\r\n#print axioms F1Fecho.ClosedGraphRegularization.graph_eq_of_regularizers\r\n",
+    'TGLExt/F1Fecho394/ClosedSubmoduleRestrictionR2.lean': 'import Mathlib.Analysis.InnerProductSpace.Adjoint\r\n/-! Adjoint of the restriction to a reducing closed subspace. -/\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.ClosedSubmoduleRestriction\r\nvariable {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]\r\nvariable (S : Submodule ℂ E) [CompleteSpace S]\r\ntheorem adjoint_restrict (A B : E →L[ℂ] E)\r\n    (hA : ∀ x∈S, A x∈S) (hB : ∀ x∈S, B x∈S) (hs : star A=B) :\r\n    (A.restrict hA).adjoint=B.restrict hB := by\r\n  ext1 x\r\n  apply ext_inner_left ℂ\r\n  intro y\r\n  rw [ContinuousLinearMap.adjoint_inner_right]\r\n  change inner ℂ (A y.val) x.val=inner ℂ y.val (B x.val)\r\n  rw [←hs,ContinuousLinearMap.star_eq_adjoint,ContinuousLinearMap.adjoint_inner_right]\r\ndef endomorphismStar : Star (S →L[ℂ] S) := inferInstance\r\n\r\ntheorem closure_range_preserved {X : Type} [AddCommMonoid X] [Module ℂ X]\r\n    (V : X →ₗ[ℂ] E) (A : E →L[ℂ] E)\r\n    (h : ∀ x, A (V x) ∈ V.range.topologicalClosure) :\r\n    ∀ y∈V.range.topologicalClosure, A y∈V.range.topologicalClosure := by\r\n  have hm : V.range.topologicalClosure ≤ V.range.topologicalClosure.comap A.toLinearMap := by\r\n    apply Submodule.topologicalClosure_minimal\r\n    · rintro _ ⟨x,rfl⟩\r\n      exact h x\r\n    · exact (Submodule.isClosed_topologicalClosure _).preimage A.continuous\r\n  exact fun y hy => hm hy\r\n\r\nend F1Fecho.ClosedSubmoduleRestriction\r\n#print axioms F1Fecho.ClosedSubmoduleRestriction.adjoint_restrict\r\n#print axioms F1Fecho.ClosedSubmoduleRestriction.endomorphismStar\r\n#print axioms F1Fecho.ClosedSubmoduleRestriction.closure_range_preserved\r\n',
+    'TGLExt/F1Fecho394/ClosedSubmoduleStarLawsR1.lean': 'import TGLExt.F1Fecho394.ClosedSubmoduleRestrictionR2\r\nset_option autoImplicit false\r\nnoncomputable section\r\nnamespace F1Fecho.ClosedSubmoduleRestriction\r\nvariable {E:Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]\r\nvariable (S:Submodule ℂ E) [CompleteSpace S]\r\ntheorem endomorphismStar_mul (A B:S→L[ℂ]S) :\r\n    @star _ (endomorphismStar S) (A*B)=\r\n      @star _ (endomorphismStar S) B * @star _ (endomorphismStar S) A :=\r\n  star_mul A B\r\nend F1Fecho.ClosedSubmoduleRestriction\r\n#print axioms F1Fecho.ClosedSubmoduleRestriction.endomorphismStar_mul\r\n',
+    'TGLExt/F1Fecho394/ClosedTomitaPolarFlipR2.lean': 'import TGLExt.F1Fecho394.ClosedTomitaSquareGraphR1\r\nimport TGLExt.V350ResolventGraphTransport\r\nimport TGLExt.V350AntiunitaryPositiveConjugation\r\n/-! Generic resolvent flip of a closed dense antilinear involution. The original\r\nv393-embedded proof is applied to Input H, without a SiteProfile surrogate.\r\nThe polar consequence below consumes a proved J-root factorization. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.ClosedTomitaOperator\r\nopen TGLExt TGLV350.Regular\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (A:Input H)\r\ntheorem scalarTomitaAdjoint_swap {y z : H}\r\n    (h : ∀ x : scalarClosedTomitaDomain A,\r\n      inner ℂ (scalarClosedTomita A x) y = inner ℂ z (x : H)) :\r\n    ∀ x : scalarClosedTomitaDomain A,\r\n      inner ℂ (scalarClosedTomita A x) z = inner ℂ y (x : H) := by\r\n  intro x\r\n  have hh := h ⟨scalarClosedTomita A x,scalarClosedTomita_maps_domain A x⟩\r\n  rw [scalarClosedTomita_involutive A] at hh\r\n  have hc := congrArg (starRingEnd ℂ) hh\r\n  calc\r\n    _ = (starRingEnd ℂ) (inner ℂ z (scalarClosedTomita A x)) :=\r\n      (inner_conj_symm (𝕜 := ℂ) (scalarClosedTomita A x) z).symm\r\n    _ = (starRingEnd ℂ) (inner ℂ (x : H) y) := hc.symm\r\n    _ = _ := inner_conj_symm (𝕜 := ℂ) y (x : H)\r\n\r\ntheorem scalarTomitaAdjoint_maps_domain (y : scalarTomitaAdjointDomain A) :\r\n    scalarTomitaAdjoint A y ∈ scalarTomitaAdjointDomain A :=\r\n  ⟨(y : H),scalarTomitaAdjoint_swap A (scalarTomitaAdjoint_pairing A y)⟩\r\n\r\ntheorem scalarTomitaAdjoint_involutive (y : scalarTomitaAdjointDomain A) :\r\n    scalarTomitaAdjoint A\r\n        ⟨scalarTomitaAdjoint A y,scalarTomitaAdjoint_maps_domain A y⟩ = y := by\r\n  apply antilinearAdjointRelation_unique (scalarClosedTomitaDomain A) (scalarClosedTomita A)\r\n    (scalarClosedTomita_domain_dense A)\r\n  · exact scalarTomitaAdjoint_pairing A ⟨_,scalarTomitaAdjoint_maps_domain A y⟩\r\n  · exact scalarTomitaAdjoint_swap A (scalarTomitaAdjoint_pairing A y)\r\n\r\n\r\ntheorem scalarTomitaResolvent_memDomain (z : H) :\r\n    scalarTomitaResolvent A z ∈ scalarClosedTomitaDomain A := by\r\n  obtain ⟨u,hu,_⟩ := scalarTomitaResolvent_equation A z\r\n  rw [← hu]\r\n  exact (scalarTomitaSquareInput A u).property\r\n\r\n/-- The actual resolvent is exchanged with its complement by S on D(S).\r\nThis bounded-resolvent identity does not by itself supply the square-root flip. -/\r\ntheorem scalarTomitaResolvent_flip (x : scalarClosedTomitaDomain A) :\r\n    scalarClosedTomita A ⟨scalarTomitaResolvent A (x : H),\r\n      scalarTomitaResolvent_memDomain A (x : H)⟩ =\r\n        scalarClosedTomita A x - scalarTomitaResolvent A (scalarClosedTomita A x) := by\r\n  obtain ⟨u,hu,hueq⟩ := scalarTomitaResolvent_equation A (x : H)\r\n  let uS := scalarTomitaSquareInput A u\r\n  let w : scalarClosedTomitaDomain A := x-uS\r\n  have hw : (w : H)=scalarTomitaSquare A u := by\r\n    change (x : H)-(u : H)=scalarTomitaSquare A u\r\n    rw [← hueq]\r\n    abel\r\n  have hwAdj : (w : H) ∈ scalarTomitaAdjointDomain A := by\r\n    rw [hw]\r\n    exact scalarTomitaAdjoint_maps_domain A (scalarTomitaSquareAdjointInput A u)\r\n  let v : scalarClosedTomitaDomain A :=\r\n    ⟨scalarClosedTomita A w,scalarClosedTomita_maps_domain A w⟩\r\n  have hvS : scalarClosedTomita A v=(w : H) :=\r\n    scalarClosedTomita_involutive A w\r\n  have hvAdj : scalarClosedTomita A v ∈ scalarTomitaAdjointDomain A := by\r\n    rw [hvS]\r\n    exact hwAdj\r\n  let vA : scalarTomitaSquareDomain A := ⟨(v : H),⟨v.property,hvAdj⟩⟩\r\n  have hAv : scalarTomitaSquare A vA=scalarClosedTomita A uS := by\r\n    have he : scalarTomitaSquareAdjointInput A vA =\r\n        ⟨scalarTomitaAdjoint A (scalarTomitaSquareAdjointInput A u),\r\n          scalarTomitaAdjoint_maps_domain A (scalarTomitaSquareAdjointInput A u)⟩ :=\r\n      Subtype.ext (hvS.trans hw)\r\n    change scalarTomitaAdjoint A (scalarTomitaSquareAdjointInput A vA)=_\r\n    rw [he]\r\n    exact scalarTomitaAdjoint_involutive A (scalarTomitaSquareAdjointInput A u)\r\n  have hveq : (vA : H)+scalarTomitaSquare A vA=scalarClosedTomita A x := by\r\n    calc\r\n      _ = scalarClosedTomita A w + scalarClosedTomita A uS :=\r\n        congrArg (fun y => (vA : H)+y) hAv\r\n      _ = scalarClosedTomita A (w+uS) := ((scalarClosedTomita A).map_add w uS).symm\r\n      _ = scalarClosedTomita A x := congrArg (scalarClosedTomita A) (sub_add_cancel x uS)\r\n  have hr : scalarTomitaResolvent A (scalarClosedTomita A x)=scalarClosedTomita A w := by\r\n    calc\r\n      _ = scalarTomitaResolvent A ((vA : H)+scalarTomitaSquare A vA) :=\r\n        congrArg (scalarTomitaResolvent A) hveq.symm\r\n      _ = (vA : H) := scalarTomitaResolvent_inverse A vA\r\n  have he : (⟨scalarTomitaResolvent A (x : H),\r\n      scalarTomitaResolvent_memDomain A (x : H)⟩ : scalarClosedTomitaDomain A)=uS :=\r\n    Subtype.ext hu.symm\r\n  rw [he,hr]\r\n  change scalarClosedTomita A uS=scalarClosedTomita A x-scalarClosedTomita A (x-uS)\r\n  rw [map_sub]\r\n  abel\r\n\r\n\r\nabbrev positiveRoot := resolventSquareRoot (scalarTomitaResolvent A)\r\n  (scalarTomitaResolvent_nonneg A) (scalarTomitaResolvent_injective A)\r\n\r\ntheorem positiveRoot_resolvent_graph (x:(positiveRoot A).domain) :\r\n    (scalarTomitaResolvent A (x:H),scalarTomitaResolvent A (positiveRoot A x)) ∈\r\n      (positiveRoot A).graph :=\r\n  resolvent_sqrt_graph_transport_of_commute (scalarTomitaResolvent A) (scalarTomitaResolvent A)\r\n    (scalarTomitaResolvent_nonneg A) (scalarTomitaResolvent_injective A) (Commute.refl _) _ _\r\n    ((LinearPMap.mem_graph_iff (positiveRoot A)).mpr ⟨x,rfl,rfl⟩)\r\n\r\ntheorem polar_resolvent (J:H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n    (hincl:(positiveRoot A).domain ≤ A.domain)\r\n    (hpolar:∀x:(positiveRoot A).domain,\r\n      J (positiveRoot A x)=A.operator (Submodule.inclusion hincl x))\r\n    (hdense:DenseRange (positiveRoot A).toFun) (z:H) :\r\n    J (scalarTomitaResolvent A z)=J z-scalarTomitaResolvent A (J z) := by\r\n  refine hdense.induction ?_ (isClosed_eq (by fun_prop) (by fun_prop)) z\r\n  rintro _ ⟨x,rfl⟩\r\n  obtain ⟨u,hu,hBu⟩ := (LinearPMap.mem_graph_iff (positiveRoot A)).mp\r\n    (positiveRoot_resolvent_graph A x)\r\n  have he : Submodule.inclusion hincl u =\r\n      (⟨scalarTomitaResolvent A (x:H),scalarTomitaResolvent_memDomain A (x:H)⟩ : A.domain) :=\r\n    Subtype.ext hu\r\n  calc\r\n    _ = J (positiveRoot A u) := congrArg J hBu.symm\r\n    _ = A.operator (Submodule.inclusion hincl u) := hpolar u\r\n    _ = A.operator ⟨scalarTomitaResolvent A (x:H),scalarTomitaResolvent_memDomain A (x:H)⟩ :=\r\n      congrArg A.operator he\r\n    _ = A.operator (Submodule.inclusion hincl x)-\r\n        scalarTomitaResolvent A (A.operator (Submodule.inclusion hincl x)) :=\r\n      scalarTomitaResolvent_flip A (Submodule.inclusion hincl x)\r\n    _ = _ := congrArg (fun y:H=>y-scalarTomitaResolvent A y) (hpolar x).symm\r\n\r\ntheorem polar_conjugate_resolvent (J:H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n    (hincl:(positiveRoot A).domain ≤ A.domain)\r\n    (hpolar:∀x:(positiveRoot A).domain,\r\n      J (positiveRoot A x)=A.operator (Submodule.inclusion hincl x))\r\n    (hdense:DenseRange (positiveRoot A).toFun) :\r\n    antiunitaryConjugate J (scalarTomitaResolvent A)=1-scalarTomitaResolvent A := by\r\n  ext1 x\r\n  have h:=polar_resolvent A J hincl hpolar hdense (J.symm x)\r\n  simpa only [antiunitaryConjugate_apply,LinearIsometryEquiv.apply_symm_apply,\r\n    ContinuousLinearMap.sub_apply,ContinuousLinearMap.one_apply] using h\r\nend F1Fecho.ClosedTomitaOperator\r\n#print axioms F1Fecho.ClosedTomitaOperator.scalarTomitaAdjoint_maps_domain\r\n#print axioms F1Fecho.ClosedTomitaOperator.scalarTomitaAdjoint_involutive\r\n#print axioms F1Fecho.ClosedTomitaOperator.scalarTomitaResolvent_flip\r\n#print axioms F1Fecho.ClosedTomitaOperator.positiveRoot_resolvent_graph\r\n#print axioms F1Fecho.ClosedTomitaOperator.polar_resolvent\r\n#print axioms F1Fecho.ClosedTomitaOperator.polar_conjugate_resolvent\r\n',
+    'TGLExt/F1Fecho394/ClosedTomitaSquareGraphR1.lean': "import TGLExt.F1Fecho394.ClosedTomitaOperatorR1\r\nimport TGLExt.O16.RecognitionSquare\r\n/-! The pairing-defined square relation is the exact maximal-adjoint\r\ncomposition already constructed from a closed dense antilinear involution. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 700000\r\nnoncomputable section\r\nnamespace F1Fecho.ClosedTomitaSquareGraph\r\nopen F1Fecho.ClosedTomitaOperator ORDEM016.D6\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (A:Input H)\r\n\r\ndef graph : Set (H×H) := Set.range (fun x:A.domain=>((x:H),A.operator x))\r\n\r\ntheorem square_graph : antilinearSquareGraph (graph A)=((scalarTomitaSquare A).graph:Set (H×H)) := by\r\n  ext p\r\n  constructor\r\n  · rintro ⟨sx,⟨v,hv⟩,hp⟩\r\n    have hx:(v:H)=p.1:=congrArg Prod.fst hv\r\n    have hs:A.operator v=sx:=congrArg Prod.snd hv\r\n    have hh:∀y:A.domain,inner ℂ (A.operator y) (A.operator v)=inner ℂ p.2 (y:H) := by\r\n      intro y\r\n      have he := (hp y (A.operator y) ⟨y,rfl⟩).symm\r\n      rwa [←hs] at he\r\n    obtain ⟨hy,hyval⟩:=scalarTomitaAdjoint_maximal A hh\r\n    let w:scalarTomitaSquareDomain A:=⟨v,v.property,hy⟩\r\n    apply (LinearPMap.mem_graph_iff (scalarTomitaSquare A)).mpr\r\n    exact ⟨w,hx,hyval⟩\r\n  · intro hp\r\n    obtain ⟨w,hx,hz⟩:=(LinearPMap.mem_graph_iff (scalarTomitaSquare A)).mp hp\r\n    refine ⟨A.operator (scalarTomitaSquareInput A w),?_,?_⟩\r\n    · exact ⟨scalarTomitaSquareInput A w,Prod.ext hx rfl⟩\r\n    · intro y sy hy\r\n      obtain ⟨v,hv⟩:=hy\r\n      have hyv:(v:H)=y:=congrArg Prod.fst hv\r\n      have hsy:A.operator v=sy:=congrArg Prod.snd hv\r\n      have he:=scalarTomitaSquare_pairing A w v\r\n      rwa [hz,hyv,hsy] at he\r\n\r\ntheorem resolvent_mem (x:H) :\r\n    (scalarTomitaResolvent A x,x-scalarTomitaResolvent A x)∈antilinearSquareGraph (graph A) := by\r\n  rw [square_graph]\r\n  obtain ⟨u,hu,he⟩:=scalarTomitaResolvent_equation A x\r\n  apply (LinearPMap.mem_graph_iff (scalarTomitaSquare A)).mpr\r\n  refine ⟨u,hu,?_⟩\r\n  rw [hu] at he\r\n  exact eq_sub_of_add_eq' he\r\n\r\ntheorem resolvent_inverse (x y:H) (hxy:(x,y)∈antilinearSquareGraph (graph A)) :\r\n    scalarTomitaResolvent A (x+y)=x := by\r\n  rw [square_graph] at hxy\r\n  obtain ⟨u,hu,hv⟩:=(LinearPMap.mem_graph_iff (scalarTomitaSquare A)).mp hxy\r\n  have he:=scalarTomitaResolvent_inverse A u\r\n  rwa [hu,hv] at he\r\nend F1Fecho.ClosedTomitaSquareGraph\r\n#print axioms F1Fecho.ClosedTomitaSquareGraph.square_graph\r\n#print axioms F1Fecho.ClosedTomitaSquareGraph.resolvent_mem\r\n#print axioms F1Fecho.ClosedTomitaSquareGraph.resolvent_inverse\r\n",
+    'TGLExt/F1Fecho394/CoefficientBoostR1.lean': "import TGLExt.F1Fecho394.RegularCovariantCoreR3\r\nimport TGLExt.V350StrongOperatorField\r\n\r\n/-! The coefficient boost f(a) -> B_(epsilon*a) f(a) is an actual\r\nL2 unitary. Strong continuity is sufficient; no norm-continuous boost is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.CoefficientBoost\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B : UnitaryFlow H) (epsilon : ℝ)\r\n\r\ndef family : TGLV350.StrongIntegral.Family (H:=H) where\r\n  op a := boostCLM B (epsilon*a)\r\n  continuous_apply v := (B.strong v).comp (continuous_const.mul continuous_id)\r\n  bound := 1\r\n  bound_nonneg := by norm_num\r\n  norm_bound a := by\r\n    apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num : (0:ℝ)≤1)\r\n    intro v\r\n    change ‖B.U (epsilon*a) v‖≤1*‖v‖\r\n    rw [(B.U (epsilon*a)).norm_map,one_mul]\r\n\r\ndef multiplier : RegularHilbert H →L[ℂ] RegularHilbert H :=\r\n  operatorFieldLift (family B epsilon)\r\n\r\ntheorem multiplier_ae (f : RegularHilbert H) :\r\n    multiplier B epsilon f =ᵐ[volume] fun a => B.U (epsilon*a) (f a) :=\r\n  operatorFieldLift_ae (family B epsilon) f\r\n\r\ntheorem multiplier_norm (f : RegularHilbert H) : ‖multiplier B epsilon f‖=‖f‖ := by\r\n  rw [Lp.norm_def,Lp.norm_def]\r\n  congr 1\r\n  apply eLpNorm_congr_norm_ae\r\n  filter_upwards [multiplier_ae B epsilon f] with a ha\r\n  rw [ha,(B.U (epsilon*a)).norm_map]\r\n\r\ntheorem multiplier_inverse (f : RegularHilbert H) :\r\n    multiplier B (-epsilon) (multiplier B epsilon f)=f := by\r\n  apply Lp.ext\r\n  filter_upwards [multiplier_ae B (-epsilon) (multiplier B epsilon f),\r\n    multiplier_ae B epsilon f] with a ha hb\r\n  rw [ha,hb]\r\n  have h := congrArg (fun U : H≃ₗᵢ[ℂ]H => U (f a)) (B.add (-epsilon*a) (epsilon*a))\r\n  simp only [LinearIsometryEquiv.trans_apply] at h\r\n  rw [show -epsilon*a+epsilon*a=0 by ring,B.zero] at h\r\n  exact h.symm\r\n\r\ndef unitary : RegularHilbert H ≃ₗᵢ[ℂ] RegularHilbert H where\r\n  toFun := multiplier B epsilon\r\n  map_add' := (multiplier B epsilon).map_add\r\n  map_smul' := (multiplier B epsilon).map_smul\r\n  norm_map' := multiplier_norm B epsilon\r\n  invFun := multiplier B (-epsilon)\r\n  left_inv := multiplier_inverse B epsilon\r\n  right_inv f := by simpa only [neg_neg] using multiplier_inverse B (-epsilon) f\r\n\r\ntheorem unitary_ae (f : RegularHilbert H) :\r\n    unitary B epsilon f =ᵐ[volume] fun a => B.U (epsilon*a) (f a) := multiplier_ae B epsilon f\r\n\r\ntheorem multiplier_commutes_fibre (A : H→L[ℂ]H)\r\n    (hA : ∀ a, boostCLM B a*A=A*boostCLM B a) :\r\n    multiplier B epsilon*fibre A=fibre A*multiplier B epsilon :=\r\n  operatorFieldLift_commutes_fibre (family B epsilon) A (fun a => hA (epsilon*a))\r\n\r\nend F1Fecho.CoefficientBoost\r\n#print axioms F1Fecho.CoefficientBoost.multiplier_norm\r\n#print axioms F1Fecho.CoefficientBoost.multiplier_inverse\r\n#print axioms F1Fecho.CoefficientBoost.unitary\r\n#print axioms F1Fecho.CoefficientBoost.unitary_ae\r\n#print axioms F1Fecho.CoefficientBoost.multiplier_commutes_fibre\r\n",
