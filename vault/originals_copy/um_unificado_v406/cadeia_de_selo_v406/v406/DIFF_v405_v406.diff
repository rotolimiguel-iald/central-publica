 hQ : IsStarProjection Q.val := by\r\n    rw [hdual]\r\n    exact hq.map (phi s)\r\n  have hR : IsStarProjection R.val := by\r\n    rw [hdual]\r\n    exact hr.map (phi s)\r\n  have hQR : Q.val*R.val=0 := by\r\n    rw [hdual,hdual]\r\n    exact mapped_orthogonal (phi s) q.val r.val hqr\r\n  have hsum : plus Q R=dual s (plus q r) := by\r\n    apply Subtype.ext\r\n    rw [hplus,hdual,hdual,hdual,hplus,map_add]\r\n  refine ⟨Q,R,hQ,hR,hQR,?_,?_⟩\r\n  · rw [hsum]\r\n    exact hcalibrate (plus q r) hpos hfin\r\n  · change W (dual s q)=W (dual s r)\r\n    rw [hscale,hscale,ht]\r\n\r\nprivate abbrev AmbientHilbert := RegularHilbert F1Rede.BosonicFock.F\r\nprivate abbrev ambientNormedAddCommGroup : NormedAddCommGroup AmbientHilbert := inferInstance\r\nprivate abbrev ambientInnerProductSpace : InnerProductSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientNormedSpace : NormedSpace ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientModule : Module ℂ AmbientHilbert := inferInstance\r\nprivate abbrev ambientTopologicalSpace : TopologicalSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientUniformSpace : UniformSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientCompleteSpace : CompleteSpace AmbientHilbert := inferInstance\r\nprivate abbrev ambientStar : Star (AmbientHilbert →L[ℂ] AmbientHilbert) := inferInstance\r\nprivate abbrev ambientOrder : PartialOrder (AmbientHilbert →L[ℂ] AmbientHilbert) :=\r\n  ContinuousLinearMap.instLoewnerPartialOrder (𝕜 := ℂ) (E := AmbientHilbert)\r\nattribute [local instance] ambientNormedAddCommGroup ambientInnerProductSpace\r\n  ambientNormedSpace ambientModule ambientTopologicalSpace ambientUniformSpace\r\n  ambientCompleteSpace ambientStar ambientOrder\r\n\r\ntheorem finite_equal_split :\r\n    ∃ q r : PositiveInput,\r\n      IsStarProjection q.val ∧ IsStarProjection r.val ∧ q.val*r.val=0 ∧\r\n      value q=value r ∧ 0<value q ∧ value q<⊤ :=\r\n  @finite_equal_split_generic AmbientHilbert ambientNormedAddCommGroup\r\n    ambientInnerProductSpace ambientCompleteSpace core value positiveSquare\r\n    (fun _ => rfl) value_tracial finite_subprojection_exists core_matrix_corner\r\n#print axioms finite_equal_split\r\n\r\n/-- The sum is a positive finite projection with equal positive faces. -/\r\ntheorem finite_split_support :\r\n    ∃ q r : PositiveInput,\r\n      IsStarProjection q.val ∧ IsStarProjection r.val ∧ q.val*r.val=0 ∧\r\n      IsStarProjection (add q r).val ∧ 0<value (add q r) ∧ value (add q r)<⊤ ∧\r\n      value q=value r ∧ 0<value q :=\r\n  @finite_split_support_generic AmbientHilbert ambientNormedAddCommGroup\r\n    ambientInnerProductSpace ambientCompleteSpace core value add\r\n    (fun _ _ => rfl) value_add finite_equal_split\r\n#print axioms finite_split_support\r\n\r\n/-- Exact positive-data interface for PF=Q+R in RemainingModularCoreInput. -/\r\ntheorem normalized_split_exists :\r\n    ∃ q r : PositiveInput,\r\n      IsStarProjection q.val ∧ IsStarProjection r.val ∧ q.val*r.val=0 ∧\r\n      value (add q r)=1 ∧ value q=value r :=\r\n  @normalized_split_generic AmbientHilbert ambientNormedAddCommGroup\r\n    ambientInnerProductSpace ambientCompleteSpace core value add (fun _ _ => rfl)\r\n    (fun s => dualAmbient (H := F1Rede.BosonicFock.F) s) positiveDual\r\n    (fun _ _ => rfl) value_dual dual_calibration finite_split_support\r\n#print axioms normalized_split_exists\r\n\r\nend F1Fecho.CanonicalFockNormalizedSplitR5\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockPolarFlipR4.lean': 'import TGLExt.F1Fecho394.CanonicalFockWeightPolarR9\r\nimport TGLExt.F1Fecho394.ClosedTomitaPolarFlipR2\r\n/-! The actual polar antiunitary exchanges the independently constructed GNS\r\nresolvent with its complement. All inputs below have concrete constructors;\r\nno modular flip, trace, or polar factorization is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1500000\r\nset_option synthInstance.maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockWeightPolar\r\nopen TGLV350.Regular F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockWeightModularOperator\r\nlocal instance : CompleteSpace GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\n\r\ntheorem scalarTomitaPolar_resolvent (z : GNSHilbert) :\r\n    scalarTomitaPolarFactor (CanonicalFockWeightModularOperator.scalarTomitaResolvent z)=\r\n      scalarTomitaPolarFactor z-CanonicalFockWeightModularOperator.scalarTomitaResolvent (scalarTomitaPolarFactor z) :=\r\n  ClosedTomitaOperator.polar_resolvent (H := GNSHilbert) actualClosedInput scalarTomitaPolarFactor\r\n    scalarTomitaRootDomain_le_closed scalarTomitaPolarFactor_root\r\n    scalarTomitaPositiveRoot_denseRange z\r\n\r\ntheorem scalarTomitaPolar_conjugate_resolvent :\r\n    antiunitaryConjugate (H := GNSHilbert) scalarTomitaPolarFactor CanonicalFockWeightModularOperator.scalarTomitaResolvent=\r\n      1-CanonicalFockWeightModularOperator.scalarTomitaResolvent :=\r\n  ClosedTomitaOperator.polar_conjugate_resolvent (H := GNSHilbert) actualClosedInput scalarTomitaPolarFactor\r\n    scalarTomitaRootDomain_le_closed scalarTomitaPolarFactor_root\r\n    scalarTomitaPositiveRoot_denseRange\r\nend F1Fecho.CanonicalFockWeightPolar\r\n#print axioms F1Fecho.CanonicalFockWeightPolar.scalarTomitaPolar_resolvent\r\n#print axioms F1Fecho.CanonicalFockWeightPolar.scalarTomitaPolar_conjugate_resolvent\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockPolarRightAlgebraR6.lean': 'import TGLExt.F1Fecho394.CanonicalFockGNSRepresentationR6\r\nimport TGLExt.F1Fecho394.CanonicalFockWeightCompletionR5\r\nimport TGLExt.V350AntiunitaryPositiveConjugation\r\nimport Mathlib.Algebra.Star.Subalgebra\r\nimport TGLExt.F1Fecho394.GenericPolarRightAlgebraR2\r\n/-! Algebraic closure on the actual full-weight Fock domain. Consumes the\r\ngeneric star algebra directly and checks its carrier against the native predicate.\r\nJ remains explicit until the actual polar consumer. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 200000\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockPolarRight\r\nopen TGLV350.Regular (antiunitaryConjugate antiunitaryConjugate_apply)\r\nopen F1Fecho.CanonicalFockGNS F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightCompletion\r\nopen F1Fecho.CanonicalFockRegular\r\nlocal instance : CompleteSpace GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\nvariable (J : GNSHilbert ≃ₛₗᵢ[starRingEnd ℂ] GNSHilbert)\r\n/-- The actual polar right identity on the existing full weight domain. -/\r\ndef ScalarPolarRight  (b : F1Fecho.CanonicalFockRegular.core.toStarSubalgebra) : Prop :=\r\n  ∀ A : scalarWeightLeftIdeal, ∃ h : A.val*b ∈ scalarWeightLeftIdeal,\r\n    scalarWeightGNSEmbedding ⟨A.val*b,h⟩ =\r\n      antiunitaryConjugate (H := GNSHilbert) J\r\n        (scalarGNSRepresentation (star b)) (scalarWeightGNSEmbedding A)\r\n\r\n/-- Consume the already proved generic star algebra in one application. -/\r\nabbrev scalarPolarRightAlgebra := F1Fecho.GenericPolarRightAlgebra.scalarPolarRightAlgebra\r\n  (H := GNSHilbert) (𝒜 := F1Fecho.CanonicalFockRegular.core.toStarSubalgebra)\r\n  scalarWeightLeftIdeal scalarWeightGNSEmbedding scalarGNSRepresentation J\r\n\r\ntheorem scalarPolarRightAlgebra_mem_iff\r\n    (b : F1Fecho.CanonicalFockRegular.core.toStarSubalgebra) :\r\n    b ∈ scalarPolarRightAlgebra J ↔ ScalarPolarRight J b ∧ ScalarPolarRight J (star b) := Iff.rfl\r\nend F1Fecho.CanonicalFockPolarRight\r\n#print axioms F1Fecho.CanonicalFockPolarRight.ScalarPolarRight\r\n#print axioms F1Fecho.CanonicalFockPolarRight.scalarPolarRightAlgebra\r\n#print axioms F1Fecho.CanonicalFockPolarRight.scalarPolarRightAlgebra_mem_iff\r\n',
+    'TGLExt/F1Fecho394/CanonicalFockPolarRightClosureR10.lean': "import TGLExt.F1Fecho394.GenericClosedEquationsCFCR5\r\nimport TGLExt.F1Fecho394.CanonicalFockPolarRightCutsR3\r\nimport TGLExt.F1Fecho394.RegularScalarGNSContinuityR2\r\nimport TGLExt.F1Fecho394.CanonicalFockPolarRightAlgebraR6\r\nimport TGLExt.F1Fecho394.CanonicalFockGNSClosednessR5\r\nimport TGLExt.F1Fecho394.CanonicalFockGNSOrderR4\r\nimport TGLExt.F1Fecho394.CanonicalFockRegularRightGNSR11\r\nimport TGLExt.F1Fecho394.GeneralSineResolventApproxR2\r\nimport TGLExt.F1Fecho394.GeneralRegularCutoffCFCR1\r\nimport Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range\r\nimport TGLExt.F1Fecho394.CanonicalFockWeightSandwichR5\r\nimport TGLExt.F1Fecho394.GenericHilbertStarNormOrderR1\r\n\r\n-- BEGIN SOURCE CanonicalFockPolarRightClosureR4\r\n/-! Closure, strong-star transport and cutoff consequences on the SAME Fock\r\nGNS. The regular-unitary polar identity remains explicit until its separate\r\nactual polar consumer. Reuses V351 modules as incorporated in v393. -/\r\n/-! Norm closure and ambient functional calculus for the actual polar-right\r\nidentity algebra. The antiunitary remains explicit until its concrete polar\r\nconsumer; the full-weight embedding is identified by proven cut maps. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 400000\r\nset_option maxErrors 3\r\nset_option synthInstance.maxHeartbeats 500000\r\nnoncomputable section\r\nnamespace F1Fecho.CanonicalFockPolarRight\r\nlocal instance : CompleteSpace F1Fecho.CanonicalFockGNS.GNSHilbert := F1Fecho.CanonicalFockGNS.gnsCompleteSpace\r\nlocal instance : Star (F1Fecho.CanonicalFockGNS.GNSHilbert →L[ℂ] F1Fecho.CanonicalFockGNS.GNSHilbert) :=\r\n  F1Fecho.ClosedSubmoduleRestriction.endomorphismStar F1Fecho.CanonicalFockGNS.GNSSubspace\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock MeasureTheory Filter\r\nopen TGLV350.Regular (RegularHilbert dualOrbitRepresentation operatorFieldLift dualIntegralFamily operatorFieldLift_norm_le antiunitaryConjugate antiunitaryConjugate_apply)\r\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockWeight F1Fecho.CanonicalFockGNS\r\nopen F1Fecho.CanonicalFockGNSRepresentation F1Fecho.CanonicalFockWeightDomain\r\nopen F1Fecho.CanonicalFockWeightOrbit F1Fecho.CanonicalFockWeightCompletion\r\nopen F1Fecho.CanonicalFockGNSCuts F1Fecho.CanonicalFockGNSClosedness\r\nopen scoped Topology\r\nvariable (J : GNSHilbert ≃ₛₗᵢ[starRingEnd ℂ] GNSHilbert)\r\n/-- Closedness uses bounded cut identities, not a false finite-minorant\r\ncharacterization of the nontracial weight. -/\r\ntheorem scalarPolarRight_isClosed  :\r\n    IsClosed {b : core.toStarSubalgebra | ScalarPolarRight J b} := by\r\n  have hπ : Continuous scalarGNSRepresentation :=\r\n    RegularScalarGNSContinuity.representation_continuous weightContext\r\n  have hdual : Continuous (dualOrbitRepresentation (H := F)) :=\r\n    RegularScalarGNSContinuity.dual_representation_continuous (H := F)\r\n  apply GenericClosedEquationsCFC.isClosed_of_equations\r\n    (fun b : core.toStarSubalgebra => ScalarPolarRight J b)\r\n    (fun (A : scalarWeightLeftIdeal) (n : ℕ) b => scalarGNSCutMap (n : ℝ)\r\n      (antiunitaryConjugate (H := GNSHilbert) J\r\n        (scalarGNSRepresentation (star b)) (scalarWeightGNSEmbedding A)))\r\n    (fun (A : scalarWeightLeftIdeal) (n : ℕ) b =>\r\n      dualOrbitRepresentation (A.val.val*b.val) (scalarCutVacuum (n : ℝ)))\r\n    (scalarPolarRight_iff_cuts J)\r\n  · intro A n\r\n    simp only [antiunitaryConjugate_apply]\r\n    exact (scalarGNSCutMap (n : ℝ)).continuous.comp\r\n      (J.continuous.comp ((hπ.comp continuous_star).clm_apply continuous_const))\r\n  · intro A n\r\n    exact (hdual.comp ((GenericClosedEquationsCFC.continuous_left_mul A.val.val).comp continuous_subtype_val)).clm_apply continuous_const\r\n\r\ntheorem scalarPolarRightAlgebra_isClosed  :\r\n    IsClosed (scalarPolarRightAlgebra J : Set core.toStarSubalgebra) :=\r\n  (scalarPolarRight_isClosed J).inter ((scala