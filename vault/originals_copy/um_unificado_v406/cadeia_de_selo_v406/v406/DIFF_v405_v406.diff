+    'TGLExt/F1Fecho394/WedgeLaplaceBoundaryR3.lean': 'import TGLExt.F1Fecho394.WedgeLaplaceIntegralR3\r\n\r\n/-! The lower-strip endpoint has the actual conjugate transverse-reflection\r\nboundary for real scalar tests. The vector Maxwell and L2 graph consumers\r\nremain separate; the endpoint is not assumed as a contract field. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.WedgeLaplace\r\nopen F1Fecho.MaxwellGlobal SchwartzMap\r\n\r\ntheorem longitudinal_lower_pi (m t x r : ℝ) :\r\n    longitudinal m t x ((r:ℂ)-Complex.I*Real.pi) = -longitudinal m t x r := by\r\n  have he : Complex.exp (Complex.I*(Real.pi:ℂ))=(-1:ℂ) := by\r\n    simpa only [mul_comm] using Complex.exp_pi_mul_I\r\n  have hn : -((r:ℂ)-Complex.I*Real.pi)=-(r:ℂ)+Complex.I*Real.pi := by ring\r\n  simp only [longitudinal,hn,Complex.exp_sub,Complex.exp_add,he]\r\n  ring\r\n\r\ntheorem kernel_lower_pi (m t x v r : ℝ) :\r\n    kernel m t x v ((r:ℂ)-Complex.I*Real.pi)=star (kernel m t x (-v) r) := by\r\n  simp only [kernel,longitudinal_lower_pi,longitudinal_real]\r\n  rw [Complex.star_def,←Complex.exp_conj]\r\n  congr 1\r\n  simp only [map_mul,map_sub,map_neg,Complex.conj_I,Complex.conj_ofReal]\r\n  push_cast\r\n  ring\r\n\r\ntheorem scalarLaplace_lower_pi_real (m q₂ q₃ r : ℝ) (f : 𝓢(Spacetime,ℂ))\r\n    (hf : ∀ x,(f x).im=0) :\r\n    scalarLaplace m q₂ q₃ f ((r:ℂ)-Complex.I*Real.pi) =\r\n      star (scalarLaplace m (-q₂) (-q₃) f r) := by\r\n  rw [scalarLaplace,scalarLaplace,Complex.star_def,←integral_conj]\r\n  apply integral_congr_ae\r\n  apply ae_of_all\r\n  intro x\r\n  have hs : star (f x)=f x := by\r\n    apply Complex.ext <;> simp [Complex.star_def,hf x]\r\n  change kernel m (x 0) (x 1) (q₂*x 2+q₃*x 3) ((r:ℂ)-Complex.I*Real.pi) * f x =\r\n    star (kernel m (x 0) (x 1) ((-q₂)*x 2+(-q₃)*x 3) r * f x)\r\n  have hv : -(q₂*x 2+q₃*x 3)=(-q₂)*x 2+(-q₃)*x 3 := by ring\r\n  rw [kernel_lower_pi,hv,star_mul,hs]\r\n  exact mul_comm _ _\r\n\r\nend F1Fecho.WedgeLaplace\r\n#print axioms F1Fecho.WedgeLaplace.longitudinal_lower_pi\r\n#print axioms F1Fecho.WedgeLaplace.kernel_lower_pi\r\n#print axioms F1Fecho.WedgeLaplace.scalarLaplace_lower_pi_real\r\n',
+    'TGLExt/F1Fecho394/WedgeLaplaceDerivativeR3.lean': 'import TGLExt.F1Fecho394.WedgeLaplaceKernelR2\r\n\r\n/-! Explicit derivative estimates for the actual rapidity Laplace kernel.\r\nThey provide a first-Schwartz-moment dominator for local differentiation. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1500000\r\nnoncomputable section\r\nnamespace F1Fecho.WedgeLaplace\r\n\r\ndef longitudinalDeriv (m t x : ℝ) (z : ℂ) : ℂ :=\r\n  (m:ℂ)*(((t-x)/2:ℝ)*Complex.exp z-((t+x)/2:ℝ)*Complex.exp (-z))\r\n\r\ntheorem longitudinal_hasDerivAt (m t x : ℝ) (z : ℂ) :\r\n    HasDerivAt (longitudinal m t x) (longitudinalDeriv m t x z) z := by\r\n  have h := (((Complex.hasDerivAt_exp z).const_mul (((t-x)/2:ℝ):ℂ)).add\r\n    (((Complex.hasDerivAt_exp (-z)).comp z (hasDerivAt_id z).neg).const_mul\r\n      (((t+x)/2:ℝ):ℂ))).const_mul (m:ℂ)\r\n  exact h.congr_deriv (by dsimp only [longitudinalDeriv]; ring)\r\n\r\ndef kernelDeriv (m t x v : ℝ) (z : ℂ) : ℂ :=\r\n  Complex.I*longitudinalDeriv m t x z*kernel m t x v z\r\n\r\ntheorem kernel_hasDerivAt (m t x v : ℝ) (z : ℂ) :\r\n    HasDerivAt (kernel m t x v) (kernelDeriv m t x v z) z := by\r\n  have h := (Complex.hasDerivAt_exp _).comp z\r\n    (((longitudinal_hasDerivAt m t x z).sub_const (v:ℂ)).const_mul Complex.I)\r\n  exact h.congr_deriv (by dsimp only [kernel,kernelDeriv]; ring)\r\n\r\ntheorem half_sum_abs_le (t x : ℝ) : |(t+x)/2| ≤ |t|+|x| := by\r\n  rw [abs_div,abs_of_pos (by norm_num : (0:ℝ)<2)]\r\n  have h:=abs_add_le t x\r\n  have ht:=abs_nonneg t\r\n  have hx:=abs_nonneg x\r\n  linarith\r\n\r\ntheorem half_sub_abs_le (t x : ℝ) : |(t-x)/2| ≤ |t|+|x| := by\r\n  simpa [sub_eq_add_neg] using half_sum_abs_le t (-x)\r\n\r\ntheorem longitudinalDeriv_bound (m t x M : ℝ) (z : ℂ) (hz : |z.re| ≤ M) :\r\n    ‖longitudinalDeriv m t x z‖ ≤ 2* |m| * (|t|+|x|)*Real.exp M := by\r\n  have hp : ‖Complex.exp z‖ ≤ Real.exp M := by\r\n    rw [Complex.norm_exp]\r\n    exact Real.exp_le_exp.mpr ((le_abs_self z.re).trans hz)\r\n  have hn