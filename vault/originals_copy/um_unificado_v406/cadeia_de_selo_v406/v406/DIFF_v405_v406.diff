+    'TGLExt/F1Fecho394/LowerGaussianControlR2.lean': "import TGLExt.F1Fecho394.LowerStripContourR1\r\nimport TGLExt.O16.LightRayVerticalDecay_v4\r\n\r\n/-! Gaussian control for a strip coefficient with one real exponential factor.\r\nCompleting the square reuses the actual O16 integrability and decay lemmas. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Filter Complex\r\nopen scoped Topology\r\nnamespace F1Fecho.WedgeLaplace\r\nopen ChatgptAudit.LightRayCore016\r\n\r\ndef lowerGaussian (b : ℝ) (z : ℂ) : ℂ := twistedGaussian b 0 (-z)\r\n\r\ntheorem lowerGaussian_entire (b : ℝ) : Differentiable ℂ (lowerGaussian b) := by\r\n  unfold lowerGaussian twistedGaussian\r\n  fun_prop\r\n\r\ntheorem lowerGaussian_bound (b : ℝ) (hb : 0 < b) (x y : ℝ)\r\n    (hy : -Real.pi ≤ y) (hy0 : y ≤ 0) :\r\n    ‖lowerGaussian b ((x:ℂ)+(y:ℂ)*I)‖ ≤ ‖twistedGaussian b 0 (x:ℂ)‖ := by\r\n  have he : -((x:ℂ)+(y:ℂ)*I)=((-x:ℝ):ℂ)+I*((-y:ℝ):ℂ) := by push_cast; ring\r\n  unfold lowerGaussian\r\n  rw [he]\r\n  have h:=gaussian_strip_bound b hb 0 (-x) (-y) (by linarith) (by linarith)\r\n  have hn : ‖twistedGaussian b 0 ((-x:ℝ):ℂ)‖=‖twistedGaussian b 0 (x:ℂ)‖ := by\r\n    rw [gaussian_real_norm,gaussian_real_norm]\r\n    congr 1\r\n    ring\r\n  exact h.trans_eq hn\r\n\r\ntheorem gaussian_exponential_complete_square (b : ℝ) (hb : b ≠ 0) (k x : ℝ) :\r\n    Real.exp (k*x)*‖twistedGaussian b 0 (x:ℂ)‖ =\r\n      Real.exp (k^2/(4*b))*‖twistedGaussian b (k/(2*b)) (x:ℂ)‖ := by\r\n  rw [gaussian_real_norm,gaussian_real_norm,←Real.exp_add,←Real.exp_add]\r\n  congr 1\r\n  field_simp\r\n  <;> ring\r\n\r\ndef regularized (b k p : ℝ) (F : ℂ → ℂ) (z : ℂ) : ℂ :=\r\n  exp ((-2*(Real.pi:ℂ)*I*(p:ℂ)+(k:ℂ))*z)*lowerGaussian b z*F z\r\n\r\ndef regularizationBound (b k p C : ℝ) : ℝ :=\r\n  Real.exp (2*Real.pi*|p| *Real.pi)*Real.exp (k^2/(4*b))*C\r\n\r\ntheorem regularized_strip_bound (b : ℝ) (hb : 0 < b) (k p C x y : ℝ)\r\n    (F : ℂ → ℂ) (hC : 0 ≤ C) (hF : ∀ z ∈ lowerClosedStrip, ‖F z‖ ≤ C)\r\n    (hy : -Real.pi ≤ y) (hy0 : y ≤ 0) :\r\n    ‖regularized b k p F ((x:ℂ)+(y:ℂ)*I)‖ ≤\r\n      regularizationBound b k p C*‖twistedGaussian b (k/(2*b)) (x:ℂ)‖ := by\r\n  have hf := hF ((x:ℂ)+(y:ℂ)*I) (by simpa [lowerClosedStrip] using And.intro hy hy0)\r\n  have he : ‖exp ((-2*(Real.pi:ℂ)*I*(p:ℂ)+(k:ℂ))*((x:ℂ)+(y:ℂ)*I))‖ =\r\n      Real.exp (2*Real.pi*p*y+k*x) := by\r\n    rw [norm_exp]\r\n    congr 1\r\n    simp [mul_re,mul_im]\r\n    ring\r\n  have hpy : p*y ≤ |p| *Real.pi := by\r\n    calc\r\n      p*y ≤ |p*y| := le_abs_self _\r\n      _ = |p| *|y| := abs_mul _ _\r\n      _ ≤ |p| *Real.pi := mul_le_mul_of_nonneg_left (abs_le.mpr ⟨hy,hy0.trans Real.pi_pos.le⟩) (abs_nonneg _)\r\n  have hex : Real.exp (2*Real.pi*p*y+k*x) ≤\r\n      Real.exp (2*Real.pi*|p| *Real.pi)*Real.exp (k*x) := by\r\n    rw [←Real.exp_add]\r\n    apply Real.exp_le_exp.mpr\r\n    nlinarith [Real.pi_pos]\r\n  unfold regularized\r\n  rw [norm_mul,norm_mul,he]\r\n  calc\r\n    _ ≤ (Real.exp (2*Real.pi*|p| *Real.pi)*Real.exp (k*x))*\r\n        ‖twistedGaussian b 0 (x:ℂ)‖*C :=\r\n      mul_le_mul (mul_le_mul hex (lowerGaussian_bound b hb x y hy hy0)\r\n        (norm_nonneg _) (by positivity)) hf (norm_nonneg _) (by positivity)\r\n    _ = regularizationBound b k p C*‖twistedGaussian b (k/(2*b)) (x:ℂ)‖ := by\r\n      rw [mul_assoc (Real.exp _) (Real.exp _) (‖twistedGaussian b 0 (x:ℂ)‖),\r\n        gaussian_exponential_complete_square b hb.ne']\r\n      unfold regularizationBound\r\n      ring\r\n\r\nend F1Fecho.WedgeLaplace\r\n#print axioms F1Fecho.WedgeLaplace.lowerGaussian_bound\r\n#print axioms F1Fecho.WedgeLaplace.gaussian_exponential_complete_square\r\n#print axioms F1Fecho.WedgeLaplace.regularized_strip_bound\r\n",
+    'TGLExt/F1Fecho394/LowerGaussianReflectionR1.lean': 'import TGLExt.F1Fecho394.LowerGaussianControlR2\r\n\r\n/-! The Gaussian regulator has the same lower-strip conjugate boundary as\r\nthe physical coefficient. Removing it later requires a separate L2 limit. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen Complex\r\nnamespace F1Fecho.WedgeLaplace\r\nopen ChatgptAudit.LightRayCore016\r\n\r\ntheorem lowerGaussian_reflect (b r : ℝ) :\r\n    lowerGaussian b ((r:ℂ)-I*Real.pi)=star (lowerGaussian b r) := by\r\n  unfold lowerGaussian twistedGaussian\r\n  rw [Complex.star_def,←Complex.exp_conj]\r\n  congr 1\r\n  simp only [map_mul,map_sub,map_neg,map_pow,map_div,map_zero,map_ofNat,\r\n    Complex.conj_I,Complex.conj_ofReal]\r\n  push_cast\r\n  ring\r\n\r\ntheorem lowerGaussian_real_bound (b : ℝ) (hb : 0 < b) (r : ℝ) :\r\n    ‖lowerGaussian b r‖ ≤ Real.exp (b*Real.pi^2/4) := by\r\n  have h := lowerGaussian_bound b hb r 0 (neg_nonpos.mpr Real.pi_pos.le) le_rfl\r\n  simp only [ofReal_zero,zero_mul,add_zero] at h\r\n  apply h.trans\r\n  rw [gaussian_real_norm]\r\n  apply Real.exp_le_exp.mpr\r\n  nlinarith [sq_nonneg r]\r\n\r\nend F1Fecho.WedgeLaplace\r\n#print axioms F1Fecho.WedgeLaplace.lowerGaussian_reflect\r\n#print axioms F1Fecho.WedgeLaplace.lowerGaussian_real_bound\r\n',
+    'TGLExt/F1Fecho394/LowerStripContourR1.lean': 'import TGLExt.F1Fecho394.WedgeLaplaceAnalyticR3\r\nimport TGLExt.O16.LightRayContourTransport_v2\r\n\r\n/-! The existing O16 contour transport is reused with the actual weaker\r\nhypothesis available for supported Schwartz tests: continuity on the closed\r\nstrip and complex differentiability in its interior, not entire analyticity.\r\nThe vertical limit and horizontal integrability remain explicit here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nnoncomputable section\r\nopen MeasureTheory Filter Complex Set\r\nopen scoped Topology\r\nnamespace F1Fecho.WedgeLaplace\r\nopen ChatgptAudit.LightRayCore016\r\n\r\ntheorem lower_rectangle_identity (F : ℂ → ℂ)\r\n    (hc : ContinuousOn F lowerClosedStrip)\r\n    (hd : DifferentiableOn ℂ F lowerOpenStrip) (T : ℝ) :\r\n    (∫ x : ℝ in -T..T, F (x : ℂ)) -\r\n      (∫ x : ℝ in -T..T, F ((x : ℂ) + (-Real.pi : ℝ) * I)) +\r\n      verticalDifference F (-Real.pi) T = 0 := by\r\n  have hp : -Real.pi ≤ 0 := neg_nonpos.mpr Real.pi_pos.le\r\n  have h := integral_boundary_rect_eq_zero_of_continuousOn_of_differentiableOn\r\n    F (-T) ((T : ℂ) + (-Real.pi : ℝ) * I)\r\n    (hc.mono (by\r\n      intro z hz\r\n      have hi := hz.2\r\n      simpa [lowerClosedStrip, uIcc, min_eq_right hp, max_eq_left hp] using hi))\r\n    (hd.mono (by\r\n      intro z hz\r\n      have hi := hz.2\r\n      simpa [lowerOpenStrip, min_eq_right hp, max_eq_left hp] using hi))\r\n  have he :\r\n      (∫ x : ℝ in -T..T, F (x : ℂ)) -\r\n        (∫ x : ℝ in -T..T, F ((x : ℂ) + (-Real.pi : ℝ) * I)) +\r\n        I * (∫ y : ℝ in (0:ℝ)..(-Real.pi), F ((T : ℂ) + (y : ℂ) * I)) -\r\n        I * (∫ y : ℝ in (0:ℝ)..(-Real.pi), F ((-T : ℝ) + (y : ℂ) * I)) = 0 := by\r\n    simpa only [neg_im, ofReal_im, neg_zero, ofReal_zero, zero_mul, add_zero, neg_re,\r\n      ofReal_re, add_re, mul_re, I_re, mul_zero, I_im, tsub_zero, add_im, mul_im,\r\n      mul_one, zero_add, smul_eq_mul, ofReal_neg] using h\r\n  unfold verticalDifference\r\n  linear_combination he\r\n\r\ntheorem lower_horizontal_integral_eq_of_vertical_limit\r\n    (F : ℂ → ℂ) (hc : ContinuousOn F lowerClosedStrip)\r\n    (hd : DifferentiableOn ℂ F lowerOpenStrip)\r\n    (h0 : Integrable (fun x : ℝ => F (x : ℂ)))\r\n    (hw : Integrable (fun x : ℝ => F ((x : ℂ) + (-Real.pi : ℝ) * I)))\r\n    (hv : Tendsto (verticalDifference F (-Real.pi)) atTop (𝓝 0)) :\r\n    (∫ x : ℝ, F ((x : ℂ) + (-Real.pi : ℝ) * I)) = ∫ x : ℝ, F (x : ℂ) := by\r\n  have ht := intervalIntegral_tendsto_integral hw tendsto_neg_atTop_atBot tendsto_id\r\n  have hb := intervalIntegral_tendsto_integral h0 tendsto_neg_atTop_atBot tendsto_id\r\n  have he : (fun T : ℝ => ∫ x : ℝ in -T..T, F ((x : ℂ) + (-Real.pi : ℝ) * I)) =\r\n      fun T : ℝ => (∫ x : ℝ in -T..T, F (x : ℂ)) + verticalDifference F (-Real.pi) T := by\r\n    funext T\r\n    have h := lower_rectangle_identity F hc hd T\r\n    linear_combination -h\r\n  simp only [id_eq] at ht hb\r\n  rw [he] at ht\r\n  simpa using tendsto_nhds_unique ht (hb.add hv)\r\n\r\nend F1Fecho.WedgeLaplace\r\n#print axioms F1Fecho.WedgeLaplace.lower_rectangle_identity\r\n#print axioms F1Fecho.WedgeLaplace.lower_horizontal_integral_eq_of_vertical_limit\r\n',
+    'TGLExt/F1Fecho394/LowerStripFourierBalanceR4.lean': "import TGLExt.F1Fecho394.LowerGaussianContourR2\r\n\r\n/-! The contour equality yields precisely the positive exp(2*pi^2*xi)\r\nFourier weight used by the canonical half-modular graph. No L2 domain or\r\nboundary conjugation is assumed or inferred in this pointwise integral lemma. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Complex\r\nopen scoped FourierTransform\r\nnamespace F1Fecho.WedgeLaplace\r\n\r\ndef regularizedReal (b k : ℝ) (F : ℂ → ℂ) (x : ℝ) : ℂ :=\r\n  exp ((k:ℂ)*(x:ℂ))*lowerGaussian b x*F x\r\n\r\ndef regularizedLower (b k : ℝ) (F : ℂ → ℂ) (x : ℝ) : ℂ :=\r\n  exp ((k:ℂ)*((x:ℂ)+(-Real.pi:ℝ)*I))*\r\n    lowerGaussian b ((x:ℂ)+(-Real.pi:ℝ)*I)*F ((x:ℂ)+(-Real.pi:ℝ)*I)\r\n\r\ntheorem regularized_real_factor (b k p x : ℝ) (F : ℂ → ℂ) :\r\n    regularized b k p F (x:ℂ)=\r\n      exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedReal b k F x := by\r\n  unfold regularized regularizedReal\r\n  rw [add_mul,exp_add]\r\n  ring\r\n\r\ntheorem regularized_lower_factor (b k p x : ℝ) (F : ℂ → ℂ) :\r\n    regularized b k p F ((x:ℂ)+(-Real.pi:ℝ)*I)=\r\n      (Real.exp (-2*Real.pi^2*p):ℂ)*\r\n        (exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedLower b k F x) := by\r\n  have he : (-2*(Real.pi:ℂ)*I*(p:ℂ)+(k:ℂ))*((x:ℂ)+(-Real.pi:ℝ)*I)=\r\n      ((-2*Real.pi^2*p:ℝ):ℂ)+(-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))+\r\n        (k:ℂ)*((x:ℂ)+(-Real.pi:ℝ)*I) := by\r\n    push_cast\r\n    ring_nf\r\n    simp [I_sq]\r\n    ring\r\n  unfold regularized regularizedLower\r\n  rw [he,exp_add,exp_add,←ofReal_exp]\r\n  ring\r\n\r\ntheorem regularized_integral_balance (b : ℝ) (hb : 0 < b) (k p C : ℝ)\r\n    (F : ℂ → ℂ) (hC : 0 ≤ C) (hc : ContinuousOn F lowerClosedStrip)\r\n    (hd : DifferentiableOn ℂ F lowerOpenStrip)\r\n    (hF : ∀ z ∈ lowerClosedStrip, ‖F z‖ ≤ C) :\r\n    (Real.exp (2*Real.pi^2*p):ℂ)*\r\n      (∫ x : ℝ, exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedReal b