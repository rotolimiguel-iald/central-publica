ientConjugation.reflection\r\n        (CoefficientBoost.multiplier B (-1) (intervalVector a b (WithLp.ofLp v).2))) := by\r\n  apply Prod.ext\r\n  · exact interval_lift ((WithLp.fstL 2 ℂ H H).restrictScalars ℝ) a b v\r\n  · change CoefficientConjugation.reflection\r\n      (CoefficientBoost.multiplier B (-1) (sndMap (intervalVector a b v)))=_\r\n    have hs : sndMap (intervalVector a b v)=intervalVector a b (WithLp.ofLp v).2 :=\r\n      interval_lift ((WithLp.sndL 2 ℂ H H).restrictScalars ℝ) a b v\r\n    rw [hs]\r\n\r\ntheorem coefficient_mem_of_dense_intervals\r\n    (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1) (hi:Function.Injective R)\r\n    (B:UnitaryFlow H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) (hJ:Function.Involutive J)\r\n    (hBJ:∀a x,J (B.U a x)=B.U a (J x))\r\n    (D:Set (PairH H))\r\n    (hD:closure D=(RealTomitaGraph.graph (resolventSquareRoot R hR hi) J:Set (PairH H)))\r\n    (N:Submodule ℝ (RegularHilbert H×RegularHilbert H))\r\n    (hN:IsClosed (N:Set (RegularHilbert H×RegularHilbert H)))\r\n    (hI:∀a b v,v∈D→decode B (intervalVector a b v)∈N)\r\n    (f g:RegularHilbert H)\r\n    (hfg:(f,g)∈CoefficientTomitaSquare.graph (FibreModularCalculus.liftedRoot R hR hi)\r\n        (CoefficientTwistedConjugation.twist B J)) : (f,g)∈N := by\r\n  let G:=RealTomitaGraph.graph (resolventSquareRoot R hR hi) J\r\n  have hG:IsClosed (G:Set (PairH H)):=RealTomitaGraph.graph_closed _\r\n    (resolventSquareRoot_closed R hR hi h1) J hJ\r\n  letI : CompleteSpace G:=hG.completeSpace_coe\r\n  let A:PairLp H→L[ℝ](RegularHilbert H×RegularHilbert H):=(decode B).restrictScalars ℝ\r\n  have hg:∀ᵐ a:ℝ ∂volume,encode B f g a∈G := by\r\n    have hh:=(CoefficientPointwise.graph_ae_direct R hR h1 hi B J hJ hBJ f g).mp hfg\r\n    filter_upwards [hh,encode_ae B f g] with a ha hb\r\n    change encode B f g a∈RealTomitaGraph.graph _ _\r\n    rw [RealTomitaGraph.mem_graph,hb]\r\n    exact ha\r\n  have hm:=LpClosedSubspaceCore.mem_of_dense_interval_values G D hD\r\n    (N.comap A.toLinearMap) (hN.preimage A.continuous) hI (encode B f g) hg\r\n  change decode B (encode B f g)∈N at hm\r\n  rwa [decode_encode] at hm\r\n\r\nend F1Fecho.CoefficientGraphCore\r\n#print axioms F1Fecho.CoefficientGraphCore.interval_lift\r\n#print axioms F1Fecho.CoefficientGraphCore.decode_interval\r\n#print axioms F1Fecho.CoefficientGraphCore.coefficient_mem_of_dense_intervals\r\n',
+    'TGLExt/F1Fecho394/CoefficientPointwiseR1.lean': 'import TGLExt.F1Fecho394.CoefficientTomitaSquareR2\r\nimport TGLExt.F1Fecho394.FibreRootPointwiseR1\r\n/-! Domain-exact coefficient graph for a general base resolvent. This avoids\r\nunfolding the nested concrete Fock construction during the AE argument. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.CoefficientPointwise\r\nopen TGLV350.Regular ChatgptAudit.Continuous049 ChatgptAudit.Continuous050\r\nopen F1Fecho.RegularCovariantCore\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem graph_iff (T:H→ₗ.[ℂ]H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n    (hJ:Function.Involutive J) (x y:H) :\r\n    (x,y)∈CoefficientTomitaSquare.graph T J ↔ (x,J y)∈T.graph := by\r\n  constructor\r\n  · rintro ⟨u,hu⟩\r\n    have hx:(u:H)=x:=congrArg Prod.fst hu\r\n    have hy:J (T u)=y:=congrArg Prod.snd hu\r\n    exact (LinearPMap.mem_graph_iff T).mpr ⟨u,hx,by rw [←hy,hJ]⟩\r\n  · intro h\r\n    obtain ⟨u,hx,hy⟩:=(LinearPMap.mem_graph_iff T).mp h\r\n    refine ⟨u,Prod.ext hx ?_⟩\r\n    change J (T u)=y\r\n    rw [hy,hJ]\r\n\r\ntheorem graph_ae_direct (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1) (hi:Function.Injective R)\r\n    (B:UnitaryFlow H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) (hJ:Function.Involutive J)\r\n    (hBJ:∀a x,J (B.U a x)=B.U a (J x)) (f g:RegularHilbert H) :\r\n    (f,g)∈CoefficientTomitaSquare.graph (FibreModularCalculus.liftedRoot R hR hi)\r\n        (CoefficientTwistedConjugation.twist B J) ↔\r\n      ∀ᵐ a:ℝ ∂volume,(f a,B.U a (g (-a)))∈\r\n        CoefficientTomitaSquare.graph (resolventSquareRoot R hR hi) J := by\r\n  rw [graph_iff _ _ (CoefficientTwistedConjugation.twist_involutive B J hJ hBJ)]\r\n  rw [FibreRootPointwise.root_graph_ae R hR h1 hi]\r\n  constructor\r\n  · intro h\r\n    filter_upwards [h,CoefficientTwistedConjugation.twist_ae B J g] with a ha hb\r\n    apply (graph_iff _ _ hJ _ _).mpr\r\n    rw [hBJ]\r\n    rwa [←hb]\r\n  · intro h\r\n    filter_upwards [h,CoefficientTwistedConjugation.twist_ae B J g] with a ha hb\r\n    have hh:=(graph_iff _ _ hJ _ _).mp ha\r\n    rw [hBJ] at hh\r\n    rwa [hb]\r\n\r\ntheorem graph_ae (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1) (hi:Function.Injective R)\r\n    (B:UnitaryFlow H) (J:H≃ₛₗᵢ[starRingEnd ℂ]H) (hJ:Function.Involutive J)\r\n    (hBJ:∀a x,J (B.U a x)=B.U a (J x)) (f g:RegularHilbert H) :\r\n    (f,g)∈CoefficientTomitaSquare.graph (FibreModularCalculus.liftedRoot R hR hi)\r\n        (CoefficientTwistedConjugation.twist B J) ↔\r\n      ∀ᵐ a:ℝ ∂volume,(f (-a),B.U (-a) (g a))∈\r\n        CoefficientTomitaSquare.graph (resolventSquareRoot R hR hi) J := by\r\n  rw [graph_ae_direct R hR h1 hi B J hJ hBJ]\r\n  constructor\r\n  · intro h\r\n    have hn:=(Measure.measurePreserving_neg (volume:Measure ℝ)).quasiMeasurePreserving.ae h\r\n    filter_upwards [hn] with a ha\r\n    simpa only [neg_neg] using ha\r\n  · intro h\r\n    have hn:=(Measure.measurePreserving_neg (volume:Measure ℝ)).quasiMeasurePreserving.ae h\r\n    filter_upwards [hn] with a ha\r\n    simpa only [neg_neg] using ha\r\nend F1Fecho.CoefficientPointwise\r\n#print axioms F1Fecho.CoefficientPointwise.graph_iff\r\n#print axioms F1Fecho.CoefficientPointwise.graph_ae_direct\r\n#print axioms F1Fecho.CoefficientPointwise.graph_ae\r\n',
+    'TGLExt/F1Fecho394/CoefficientTomitaSquareR2.lean': 'import TGLExt.F1Fecho394.FibreModularCalculusR2\r\nimport TGLExt.F1Fecho394.CoefficientTwistedConjugationR1\r\nimport TGLExt.O16.RecognitionModular_v2\r\n\r\n/-! Exact maximal-adjoint square of the coefficient operator.\r\nThe coefficient Hilbert space is concrete Lebesgue L2. Identification with\r\nthe actual weight GNS map and the pointwise base Tomita remain separate. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen scoped InnerProductSpace\r\nnamespace F1Fecho.CoefficientTomitaSquare\r\nopen TGLV350.Regular ChatgptAudit.Continuous050 ORDEM016.D6\r\nopen F1Fecho.FibreModularCalculus F1Fecho.CoefficientTwistedConjugation\r\nopen F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ndef graph (T : H→ₗ.[ℂ]H) (J : H≃ₛₗᵢ[starRingEnd ℂ]H) : Set (H×H) :=\r\n  Set.range (fun x:T.domain => ((x:H),genericTomita T J x))\r\n\r\ntheorem square_graph (T : H→ₗ.[ℂ]H) (hT : IsSelfAdjoint T)\r\n    (J : H≃ₛₗᵢ[starRingEnd ℂ]H) (hJ : Function.Involutive J) :\r\n    antilinearSquareGraph (graph T J)=(partialOperatorSquare T).graph := by\r\n  ext p\r\n  rcases p with ⟨x,z⟩\r\n  constructor\r\n  · rintro ⟨sx,⟨u,hu⟩,hp⟩\r\n    have hx : (u:H)=x := congrArg Prod.fst hu\r\n    have hsx : genericTomita T J u=sx := congrArg Prod.snd hu\r\n    obtain ⟨ha,hv⟩ := generic_adjoint_maximal T hT J hJ (y:=genericTomita T J u) (z:=z)\r\n      (fun v => by rw [hsx]; exact (hp v (genericTomita T J v) ⟨v,rfl⟩).symm)\r\n    have hTu := (generic_composition_domain T J hJ u).mp ha\r\n    have ht : T ⟨T u,hTu⟩=z := (generic_adjoint_comp T J hJ u hTu).symm.trans hv\r\n    apply (partialOperatorSquare_graph_iff T x z).mpr\r\n    refine ⟨T u,?_,?_⟩\r\n    · exact (LinearPMap.mem_graph_iff T).mpr ⟨u,hx,rfl⟩\r\n    · exact (LinearPMap.mem_graph_iff T).mpr ⟨⟨T u,hTu⟩,rfl,ht⟩\r\n  · intro hp\r\n    obtain ⟨y,hxy,hyz⟩ := (partialOperatorSquare_graph_iff T x z).mp hp\r\n    obtain ⟨u,hu,hy⟩ := (LinearPMap.mem_graph_iff T).mp hxy\r\n    obtain ⟨v,hv,hz⟩ := (LinearPMap.mem_graph_iff T).mp hyz\r\n    change (u:H)=x at hu\r\n    change (T u:H)=y at hy\r\n    change (v:H)=y at hv\r\n    change (T v:H)=z at hz\r\n    have hTu : T u∈T.domain := by rw [hy,←hv]; exact v.property\r\n    have htv : (⟨T u,hTu⟩:T.domain)=v := Subtype.ext (hy.trans hv.symm)\r\n    have hadj : genericTomitaAdjoint T J\r\n        ⟨genericTomita T J u,(generic_composition_domain T J hJ u).mpr hTu⟩=z := by\r\n      rw [generic_adjoint_comp T J hJ u hTu,htv]\r\n      exact hz\r\n    refine ⟨genericTomita T J u,⟨u,Prod.ext hu rfl⟩,?_⟩\r\n    intro q sq hq\r\n    obtain ⟨w,hw⟩ := hq\r\n    have hwq : (w:H)=q := congrArg Prod.fst hw\r\n    have hws : genericTomita T J w=sq := congrArg Prod.snd hw\r\n    rw [←hwq,←hws,←hadj]\r\n    exact (generic_adjoint_pairing T hT J hJ w\r\n      ⟨genericTomita T J u,(generic_composition_domain T J hJ u).mpr hTu⟩).symm\r\n\r\ndef coefficientS (R : H→L[ℂ]H) (hR : 0≤R) (hi : Function.Injective R)\r\n    (B : UnitaryFlow H) (J : H≃ₛₗᵢ[starRingEnd ℂ]H) :\r\n    RegularHilbert H→ₛₗ.[starRingEnd ℂ]RegularHilbert H :=\r\n  genericTomita (liftedRoot R hR hi) (twist B J)\r\n\r\ntheorem coefficient_square_graph (R : H→L[ℂ]H) (hR : 0≤R) (h1 : R≤1)\r\n    (hi : Function.Injective R) (B : UnitaryFlow H) (J : H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n    (hJ : Function.Involutive J) (hBJ : ∀ a x, J (B.U a x)=B.U a (J x)) :\r\n    antilinearSquareGraph (graph (liftedRoot R hR hi) (twist B J))=\r\n      (resolventGraphOperator (fibre R) (fibre_operator_injective R hi)).graph := by\r\n  rw [square_graph _ (liftedRoot_selfadjoint R hR h1 hi) _ (twist_involutive B J hJ hBJ),\r\n    liftedRoot_square R hR h1 hi]\r\n\r\nend F1Fecho.CoefficientTomitaSquare\r\n#print axioms F1Fecho.CoefficientTomitaSquare.square_graph\r\n#print axioms F1Fecho.CoefficientTomitaSquare.coefficientS\r\n#print axioms F1Fecho.CoefficientTomitaSquare.coefficient_square_graph\r\n',
+    'TGLExt/F1Fecho394/CoefficientTwistedConjugationR1.lean': 'import TGLExt.F1Fecho394.CoefficientBoostR1\r\nimport TGLExt.F1Fecho394.CoefficientConjugationR2\r\n\r\n/-! The antiunitary f(a) -> B_a J f(-a). Its involution is proved from\r\nthe named base conjugation/flow relations, not asserted as a new field. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.CoefficientTwistedConjugation\r\nopen TGLV350.Regular F1Fecho.RegularCovariantCore\r\nopen F1Fecho.CoefficientConjugation\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nvariable (B : UnitaryFlow H) (J : H≃ₛₗᵢ[starRingEnd ℂ]H)\r\n\r\ndef twist : RegularHilbert H≃ₛₗᵢ[starRingEnd ℂ]RegularHilbert H :=\r\n  (reflection.trans (lift J)).trans (CoefficientBoost.unitary B 1)\r\n\r\ntheorem twist_ae (f : RegularHilbert H) :\r\n    twist B J f =ᵐ[volume] fun a : ℝ => B.U a (J (f (-a))) := by\r\n  filter_upwards [CoefficientBoost.unitary_ae B 1 (lift J (reflection f)),\r\n    lift_ae J (reflection f),reflectionMap_ae f] with a ha hb hc\r\n  change CoefficientBoost.unitary B 1 (lift J (reflection f)) a = _\r\n  rw [ha,hb]\r\n  change B.U (1*a) (J (reflectionMap f a))=_\r\n  rw [hc,one_mul]\r\n\r\ntheorem twist_involutive (hJ : Function.Involutive J)\r\n    (hBJ : ∀ a x, J (B.U a x)=B.U a (J x)) : Function.Involutive (twist B J) := by\r\n  intro f\r\n  apply Lp.ext\r\n  have hn := (Measure.measurePreserving_neg (volume : Measure ℝ)).quasiMeasurePreserving.ae\r\n    (twist_ae B J f)\r\n  filter_upwards [twist_ae B J (twist B J f),hn] with a ha hb\r\n  rw [ha,hb,neg_neg,hBJ,hJ]\r\n  have h := congrArg (fun U : H≃ₗᵢ[ℂ]H => U (f a)) (B.add a (-a))\r\n  simp only [add_neg_cancel,B.zero,LinearIsometryEquiv.trans_apply] at h\r\n  exact h.symm\r\n\r\ntheorem twist_fibre (A C : H→L[ℂ]H)\r\n    (hJC : ∀ x, J (A x)=C (J x))\r\n    (hBC : ∀ a x, B.U a (C x)=C (B.U a x)) (f : RegularHilbert H) :\r\n    twist B J (fibre A f)=fibre C (twist B J f) := by\r\n  apply Lp.ext\r\n  have hn := (Measure.measurePreserving_neg (volume : Measure ℝ)).quasiMeasurePreserving.ae\r\n    (fibre_ae A f)\r\n  filter_upwards [twist_ae B J (fibre A f),hn,fibre_ae C (twist B J f),\r\n    twist_ae B J f] with a ha hb hc hd\r\n  rw [ha,hb,hJC,hBC,hc,hd]\r\n\r\nend F1Fecho.CoefficientTwistedConjugation\r\n#print axioms F1Fecho.CoefficientTwistedConjugation.twist\r\n#print axioms F1Fecho.CoefficientTwistedConjugation.twist_ae\r\n#print axioms F1Fecho.CoefficientTwistedConjugation.twist_involutive\r\n#print axioms F1Fecho.CoefficientTwistedConjugation.twist_fibre\r\n',
+    'TGLExt/F1Fecho394/CompactPairCoverR1.lean': "import Mathlib.Topology.Compactness.Compact\r\n\r\n/-! Finite rectangular localization for two compact sets. For each member of\r\nthe first cover the second compact set has its own finite cover. No single\r\npair of wedges for arbitrary sets is asserted. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 500000\r\nnoncomputable section\r\nopen Set\r\nnamespace F1Fecho.CompactPairCover\r\nvariable {X : Type} [TopologicalSpace X]\r\n\r\ntheorem finite_rectangular_cover (K L : Set X) (hK : IsCompact K) (hL : IsCompact L)\r\n    (R : Set X → Set X → Prop)\r\n    (hmono : ∀ U U' V, U' ⊆ U → R U V → R U' V)\r\n    (hloc : ∀ (x : K) (y : L), ∃ U V : Set X,\r\n      IsOpen U ∧ IsOpen V ∧ x.val ∈ U ∧ y.val ∈ V ∧ R U V) :\r\n    ∃ s : Finset K, ∃ t : K → Finset L, ∃ U : K → Set X, ∃ V : K → L → Set X,\r\n      K ⊆ ⋃ x ∈ s, U x ∧\r\n      ∀ x ∈ s, IsOpen (U x) ∧ L ⊆ ⋃ y ∈ t x, V x y ∧\r\n        ∀ y ∈ t x, IsOpen (V x y) ∧ R (U x) (V x y) := by\r\n  classical\r\n  choose U V hU hV hx hy hR using hloc\r\n  have hc (x : K) : L ⊆ ⋃ y : L, V x y := by\r\n    intro y hyL\r\n    exact mem_iUnion.mpr ⟨⟨y,hyL⟩,hy x ⟨y,hyL⟩⟩\r\n  choose t ht using (fun x : K => hL.elim_finite_subcover (V x) (hV x) (hc x))\r\n  let W (x : K) : Set X := ⋂ y ∈ t x, U x y\r\n  have hw (x : K) : IsOpen (W x) := isOpen_biInter_finset (fun y _ => hU x y)\r\n  have hwx (x : K) : x.val ∈ W x := by\r\n    exact mem_iInter.mpr (fun y => mem_iInter.mpr (fun _ => hx x y))\r\n  have hcover : K ⊆ ⋃ x : K, W x := by\r\n    intro x hxK\r\n    exact mem_iUnion.mpr ⟨⟨x,hxK⟩,hwx ⟨x,hxK⟩⟩\r\n  obtain ⟨s,hs⟩ := hK.elim_finite_subcover W hw hcover\r\n  refine ⟨s,t,W,V,hs,?_⟩\r\n  intro x _\r\n  refine ⟨hw x,ht x,?_⟩\r\n  intro y hyt\r\n  refine ⟨hV x y,hmono (U x y) (W x) (V x y) ?_ (hR x y)⟩\r\n  intro z hz\r\n  exact mem_iInter.mp (mem_iInter.mp hz y) hyt\r\n\r\nend F1Fecho.CompactPairCover\r\n#print axioms F1Fecho.CompactPairCover.finite_rectangular_cover\r\n",
+    'TGLExt/F1Fecho394/CompactSchwartzPartitionR3.lean': "import Mathlib.Geometry.Manifold.PartitionOfUnity\r\nimport Mathlib.Analysis.Distribution.SchwartzSpace.Basic\r\nimport Mathlib.Analysis.InnerProductSpace.PiL2\r\n\r\n/-! A compact Schwartz test splits into finitely many smooth compact tests\r\nsubordinate to an open cover. Each piece keeps the original support as well.\r\nThis supplies support decomposition, not causal commutation. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nopen Function Set SchwartzMap\r\nopen scoped Manifold ContDiff\r\nnamespace F1Fecho.CompactSchwartzPartition\r\nabbrev E := EuclideanSpace ℝ (Fin 4)\r\nvariable {F ι : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] [Fintype ι]\r\n\r\ntheorem finite_partition (f : SchwartzMap E F) (hf : HasCompactSupport (f : E → F))\r\n    (U : ι → Set E) (ho : ∀ i, IsOpen (U i))\r\n    (hcover : tsupport (f : E → F) ⊆ ⋃ i, U i) :\r\n    ∃ parts : ι → SchwartzMap E F, (∑ i, parts i) = f ∧\r\n      ∀ i, HasCompactSupport (parts i : E → F) ∧\r\n        (support (parts i : E → F) ⊆ U i ∩ support (f : E → F)) ∧\r\n        ∀ x, ∃ r : ℝ, parts i x = r • f x := by\r\n  classical\r\n  obtain ⟨ρ,hρ⟩ := SmoothPartitionOfUnity.exists_isSubordinate 𝓘(ℝ,E)\r\n    isClosed_closure U ho hcover\r\n  let g (i : ι) (x : E) : F := ρ i x • f x\r\n  have hc (i : ι) : HasCompactSupport (g i) := hf.smul_left\r\n  have hd (i : ι) : ContDiff ℝ ∞ (g i) :=\r\n    (contMDiff_iff_contDiff.mp (ρ i).contMDiff).smul f.smooth'\r\n  let parts (i : ι) : SchwartzMap E F := (hc i).toSchwartzMap (hd i)\r\n  have hp (i : ι) (x : E) : parts i x = ρ i x • f x := rfl\r\n  refine ⟨parts,?_,?_⟩\r\n  · ext x\r\n    by_cases hx : f x = 0\r\n    · simp [parts,g,hx]\r\n    · have hsum : (∑ i, ρ i x) = 1 := by\r\n        simpa only [finsum_eq_sum_of_fintype] using\r\n          ρ.sum_eq_one (show x ∈ tsupport (f : E → F) from subset_closure hx)\r\n      change (∑ i, parts i) x = f x\r\n      simp only [SchwartzMap.sum_apply,hp,\r\n        ← Finset.sum_smul,hsum,one_smul]\r\n  · intro i\r\n    refine ⟨hc i,?_,?_⟩\r\n    · intro x hx\r\n      change x ∈ support (g i) at hx\r\n      exact ⟨hρ i (subset_closure (support_smul_subset_left (ρ i) f hx)),\r\n        support_smul_subset_right (ρ i) f hx⟩\r\n    · intro x\r\n      exact ⟨ρ i x,hp i x⟩\r\n\r\nend F1Fecho.CompactSchwartzPartition\r\n#print axioms F1Fecho.CompactSchwartzPartition.finite_partition\r\n",
+    'TGLExt/F1Fecho394/ComplexHalfConjugationR1.lean': 'import Mathlib.Data.Complex.Basic\r\nset_option autoImplicit false\r\nopen scoped ComplexConjugate\r\nnamespace F1Fecho.ComplexNormalization\r\n theorem half_conj : conj (1/2:ℂ)=(1/2:ℂ) := by\r\n  simpa only [Complex.ofReal_div,Complex.ofReal_one,Complex.ofReal_ofNat] using\r\n    Complex.conj_ofReal (1/2)\r\nend F1Fecho.ComplexNormalization\r\n#print axioms F1Fecho.ComplexNormalization.half_conj\r\n',
+    'TGLExt/F1Fecho394/ContourFourierBalanceR2.lean': "import TGLExt.F1Fecho394.RegularizedContourSpaceR4\r\nimport TGLExt.F1Fecho394.LowerStripFourierBalanceR4\r\n\r\n/-! Fourier balance follows from the linear contour domain, independently\r\nof the particular coefficient used to establish membership. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen MeasureTheory Complex\r\nopen scoped FourierTransform\r\nnamespace F1Fecho.WedgeLaplace\r\n\r\ntheorem contour_integral_balance (b p : ℝ) (F : ℂ → ℂ)\r\n    (hF : F ∈ contourSpace b p) :\r\n    (Real.exp (2*Real.pi^2*p):ℂ)*\r\n      (∫ x : ℝ, exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedReal b 0 F x) =\r\n      ∫ x : ℝ, exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedLower b 0 F x := by\r\n  have h := hF.2.2\r\n  simp only [regSlice,ofReal_zero,zero_mul,add_zero] at h\r\n  simp_rw [regularized_real_factor,regularized_lower_factor] at h\r\n  rw [integral_const_mul] at h\r\n  have he : (Real.exp (2*Real.pi^2*p):ℂ)*(Real.exp (-2*Real.pi^2*p):ℂ)=1 := by\r\n    rw [←ofReal_mul,←Real.exp_add]\r\n    ring_nf\r\n    simp\r\n  calc\r\n    _ = (Real.exp (2*Real.pi^2*p):ℂ)*((Real.exp (-2*Real.pi^2*p):ℂ)*\r\n        (∫ x : ℝ, exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*regularizedLower b 0 F x)) :=\r\n      congrArg (fun z : ℂ => (Real.exp (2*Real.pi^2*p):ℂ)*z) h.symm\r\n    _ = _ := by rw [←mul_assoc,he,one_mul]\r\n\r\ntheorem contour_fourier_balance (b p : ℝ) (F : ℂ → ℂ)\r\n    (hF : F ∈ contourSpace b p) :\r\n    (Real.exp (2*Real.pi^2*p):ℂ)*𝓕 (regularizedReal b 0 F) p =\r\n      𝓕 (regularizedLower b 0 F) p := by\r\n  have he (g : ℝ → ℂ) : 𝓕 g p =\r\n      ∫ x : ℝ, exp (-2*(Real.pi:ℂ)*I*(p:ℂ)*(x:ℂ))*g x := by\r\n    rw [Real.fourier_eq']\r\n    apply integral_congr_ae\r\n    apply ae_of_all\r\n    intro x\r\n    simp only [Real.inner_apply,smul_eq_mul]\r\n    congr 1\r\n    congr 1\r\n    push_cast\r\n    ring\r\n  rw [he,he]\r\n  exact contour_integral_balance b p F hF\r\n\r\nend F1Fecho.WedgeLaplace\r\n#print axioms F1Fecho.WedgeLaplace.contour_integral_balance\r\n#print axioms F1Fecho.WedgeLaplace.contour_fourier_balance\r\n",
+    'TGLExt/F1Fecho394/CovariantTensorPullbackR3.lean': "import TGLExt.F1Fecho394.MaxwellScreenIntertwinerR2\r\nimport TGLExt.F1Fecho394.SchwartzMaxwellCoefficientR5\r\nimport Mathlib.Analysis.Normed.Module.FiniteDimension\r\n\r\n/-! Covariant test tensors transform by A-transpose T A. Their contraction\r\nwith p wedge epsilon therefore transports both contravariant vectors by A.\r\nThis finite algebra supplies the tensor part of the physical test action. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nopen Matrix\r\nnamespace F1Fecho.CovariantTensor\r\nopen F1Fecho.MaxwellGlobal F1Fecho.MaxwellOnShell\r\n\r\ndef pullLinear (A:Matrix (Fin 4) (Fin 4) ℂ) : TensorValue→ₗ[ℂ]TensorValue where\r\n  toFun T := A.transpose*(Matrix.of T)*A\r\n  map_add' T U := by\r\n    change A.transpose*(Matrix.of T+Matrix.of U)*A=_\r\n    simp only [Matrix.mul_add,Matrix.add_mul]\r\n    rfl\r\n  map_smul' c T := by\r\n    change A.transpose*(c • Matrix.of T)*A=c • (A.transpose*Matrix.of T*A)\r\n    simp only [Matrix.mul_smul,Matrix.smul_mul]\r\n\r\ndef pull (A:Matrix (Fin 4) (Fin 4) ℂ) : TensorValue→L[ℂ]TensorValue :=\r\n  (pullLinear A).toContinuousLinearMap\r\n\r\ndef contraction (p e:Fin 4→ℂ) (T:TensorValue) : ℂ :=\r\n  dotProduct p ((Matrix.of T).mulVec e)-dotProduct e ((Matrix.of T).mulVec p)\r\n\r\ntheorem contraction_eq_sum (p e:Fin 4→ℂ) (T:TensorValue) :\r\n    contraction p e T=∑μ,∑ν,(p μ*e ν-p ν*e μ)*T μ ν := by\r\n  simp only [contraction,Matrix.mulVec,dotProduct,Finset.mul_sum,\r\n    Finset.sum_sub_distrib,sub_mul]\r\n  congr 1 <;> apply Finset.sum_congr rfl <;> intro μ hμ <;>\r\n    apply Finset.sum_congr rfl <;> intro ν hν <;> simp only [Matrix.of_apply] <;> ring\r\n\r\ntheorem contraction_pull (A:Matrix (Fin 4) (Fin 4) ℂ)\r\n    (p e:Fin 4→ℂ) (T:TensorValue) :\r\n    contraction p e (pull A T)=contraction (A.mulVec p) (A.mulVec e) T := by\r\n  change dotProduct p ((A.transpose*(Matrix.of T)*A).mulVec e)-\r\n      dotProduct e ((A.transpose*(Matrix.of T)*A).mulVec p)=_\r\n  simp only [←Matrix.mulVec_mulVec,Matrix.dotProduct_transpose_mulVec,contraction]\r\n  rw [dotProduct_comm ((Matrix.of T).mulVec (A.mulVec e)),\r\n    dotProduct_comm ((Matrix.of T).mulVec (A.mulVec p))]\r\n\r\ntheorem real_contraction_eq_sum (p e:Fin 4→ℝ) (T:TensorValue) :\r\n    contraction (realLift p) (realLift e) T=\r\n      ∑μ,∑ν,(realStrength p e μ ν:ℂ)*T μ ν := by\r\n  rw [contraction_eq_sum]\r\n  simp only [realLift,realStrength,Complex.ofReal_sub,Complex.ofReal_mul]\r\n\r\ntheorem pull_real (A:Matrix (Fin 4) (Fin 4) ℝ) (T:TensorValue)\r\n    (hT:∀μ ν,(T μ ν).im=0) : ∀μ ν,(pull (A.map Complex.ofReal) T μ ν).im=0 := by\r\n  intro μ ν\r\n  change (((A.map Complex.ofReal).transpose*(Matrix.of T)*A.map Complex.ofReal) μ ν).im=0\r\n  simp [Matrix.mul_apply,Matrix.transpose_apply,Matrix.map_apply,Complex.mul_im,hT]\r\n\r\nend F1Fecho.CovariantTensor\r\n#print axioms F1Fecho.CovariantTensor.pull\r\n#print axioms F1Fecho.CovariantTensor.contraction_eq_sum\r\n#print axioms F1Fecho.CovariantTensor.contraction_pull\r\n#print axioms F1Fecho.CovariantTensor.real_contraction_eq_sum\r\n#print axioms F1Fecho.CovariantTensor.pull_real\r\n",
+    'TGLExt/F1Fecho394/DominatedWithinIntegralR3.lean': "import Mathlib.Analysis.Calculus.ParametricIntegral\r\nimport Mathlib.Tactic\r\n\r\n/-! Differentiation under a Bochner integral along a closed parameter set.\r\nThis is the within-set counterpart of the mathlib dominated Lipschitz lemma;\r\nall integrability, derivative, and domination hypotheses remain explicit. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.DominatedWithin\r\n\r\nvariable {X : Type*} [MeasurableSpace X] (μ : Measure X)\r\n  {F : ℂ → X → ℂ} {D : X → ℂ} {B : X → ℝ} {s : Set ℂ} {z : ℂ}\r\n\r\ntheorem integral_hasDerivWithinAt\r\n    (hF : ∀ w ∈ s, Integrable (F w) μ) (hz : z ∈ s)\r\n    (hD : Integrable D μ) (hB : Integrable B μ)\r\n    (hBn : ∀ᵐ x ∂μ, 0 ≤ B x)\r\n    (hLip : ∀ᵐ x ∂μ, ∀ w ∈ s, ‖F w x-F z x‖ ≤ B x*‖w-z‖)\r\n    (hd : ∀ᵐ x ∂μ, HasDerivWithinAt (fun w => F w x) (D x) s z) :\r\n    HasDerivWithinAt (fun w => ∫ x, F w x ∂μ) (∫ x, D x ∂μ) s z := by\r\n  let rem : ℂ → X → ℂ := fun w x => ‖w-z‖⁻¹ • (F w x-F z x-(w-z) • D x)\r\n  have hrep : ∀ᶠ w in 𝓝[s] z,\r\n      ‖w-z‖⁻¹*‖(∫ x,F w x ∂μ)-(∫ x,F z x ∂μ)-(w-z) • (∫ x,D x ∂μ)‖ =\r\n        ‖∫ x,rem w x ∂μ‖ := by\r\n    filter_upwards [self_mem_nhdsWithin] with w hw\r\n    dsimp only [rem]\r\n    rw [integral_smul,integral_sub,integral_sub,integral_smul,\r\n      norm_smul_of_nonneg (inv_nonneg.mpr (norm_nonneg _))]\r\n    exacts [hF w hw,hF z hz,(hF w hw).sub (hF z hz),hD.const_mul (w-z)]\r\n  rw [hasDerivWithinAt_iff_tendsto,tendsto_congr' hrep,\r\n    ←tendsto_zero_iff_norm_tendsto_zero]\r\n  have hi : Tendsto (fun w => ∫ x, rem w x ∂μ) (𝓝[s] z) (𝓝 (∫ x, (0:ℂ) ∂μ)) := by\r\n    apply tendsto_integral_filter_of_dominated_convergence (bound := fun x => B x+‖D x‖)\r\n    · filter_upwards [self_mem_nhdsWithin] with w hw\r\n      exact (((hF w hw).aestronglyMeasurable.sub (hF z hz).aestronglyMeasurable).sub\r\n        (hD.aestronglyMeasurable.const_smul (w-z))).const_smul ‖w-z‖⁻¹\r\n    · filter_upwards [self_mem_nhdsWithin] with w hw\r\n      filter_upwards [hLip,hBn] with x hl hb\r\n      dsimp only [rem]\r\n      rw [norm_smul_of_nonneg (inv_nonneg.mpr (norm_nonneg _))]\r\n      calc\r\n        ‖w-z‖⁻¹*‖F w x-F z x-(w-z) • D x‖ ≤\r\n            ‖w-z‖⁻¹*(‖F w x-F z x‖+‖(w-z) • D x‖) := by gcongr; exact norm_sub_le _ _\r\n        _ ≤ ‖w-z‖⁻¹*(B x*‖w-z‖+‖w-z‖*‖D x‖) := by rw [norm_smul]; gcongr; exact hl w hw\r\n        _ ≤ B x+‖D x‖ := by\r\n          by_cases he : w=z\r\n          · simp [he]; positivity\r\n          · have hn : ‖w-z‖≠0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr he)\r\n            field_simp\r\n            ring_nf\r\n            exact le_rfl\r\n    · exact hB.add hD.norm\r\n    · filter_upwards [hd] with x hx\r\n      rw [tendsto_zero_iff_norm_tendsto_zero]\r\n      simpa only [rem,norm_smul_of_nonneg (inv_nonneg.mpr (norm_nonneg _))] using\r\n        hasDerivWithinAt_iff_tendsto.mp hx\r\n  simpa only [integral_zero] using hi\r\n\r\nend F1Fecho.DominatedWithin\r\n#print axioms F1Fecho.DominatedWithin.integral_hasDerivWithinAt\r\n",
+    'TGLExt/F1Fecho394/FibreModularCalculusR2.lean': 'import TGLExt.V350L2Order\r\nimport TGLExt.V351ResolventImaginaryContinuity\r\nimport TGLExt.V350ResolventSquareRoot\r\nimport TGLExt.F1Fecho394.L2UnitaryMapR2\r\n\r\n/-! Lebesgue L2 amplification of the actual resolvent calculus.\r\nThis module constructs the positive root and spectral flow on coefficients.\r\nIdentification with the weight-GNS Tomita operator is a separate obligation. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.FibreModularCalculus\r\nopen TGLV350.Regular\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem fibre_operator_injective (A : H →L[ℂ] H) (hA : Function.Injective A) :\r\n    Function.Injective (fibre A) := by\r\n  intro f g h\r\n  apply Lp.ext\r\n  filter_upwards [fibre_ae A f, fibre_ae A g] with x hf hg\r\n  apply hA\r\n  rw [←hf,←hg,h]\r\n\r\ndef fibreLinear : (H →L[ℂ] H) →L[ℂ] (RegularHilbert H →L[ℂ] RegularHilbert H) :=\r\n  (fibreRepresentation (H:=H)).toLinearMap.mkContinuous 1 (by\r\n    intro A\r\n    change ‖fibre A‖≤1*‖A‖\r\n    simpa only [one_mul] using fibre_norm_le A)\r\n\r\ntheorem fibre_continuous : Continuous (fibreRepresentation (H:=H)) :=\r\n  fibreLinear.continuous\r\n\r\ntheorem fibre_cfc (A : H →L[ℂ] H) (hA : IsSelfAdjoint A)\r\n    (f : ℂ → ℂ) (hf : Continuous f) :\r\n    fibre (cfc f A)=cfc f (fibre A) := by\r\n  have hs : IsSelfAdjoint (fibre A) := by\r\n    change star (fibre A)=fibre A\r\n    rw [←fibre_star,hA.star_eq]\r\n  exact (fibreRepresentation (H:=H)).map_cfc f A hf.continuousOn\r\n    fibre_continuous hA.isStarNormal hs.isStarNormal\r\n\r\ntheorem fibre_damping (R : H →L[ℂ] H) :\r\n    fibre (resolventDampingOperator R)=resolventDampingOperator (fibre R) := by\r\n  unfold resolventDampingOperator\r\n  rw [fibre_mul]\r\n  have h := map_sub (fibreRepresentation (H:=H)) (1:H→L[ℂ]H) R\r\n  change fibre (1-R)=fibre 1-fibre R at h\r\n  rw [h,fibre_one]\r\n\r\ntheorem fibre_phase (R : H →L[ℂ] H) (hR : 0≤R) (t : ℝ) :\r\n    fibre (resolventPhaseOperator R t)=resolventPhaseOperator (fibre R) t :=\r\n  fibre_cfc R (IsSelfAdjoint.of_nonneg hR) _\r\n    ((resolventPhaseFunction_continuous t).comp Complex.continuous_re)\r\n\r\nvariable (R : H →L[ℂ] H) (hR : 0≤R) (h1 : R≤1)\r\n  (hi : Function.Injective R) (hj : Function.Injective (1-R:H→L[ℂ]H))\r\n\r\ninclude h1 in\r\ntheorem lifted_le_one : fibre R≤1 := by\r\n  simpa only [fibre_one] using fibre_monotone h1\r\n\r\ninclude hj in\r\ntheorem lifted_complement_injective : Function.Injective (1-fibre R:RegularHilbert H→L[ℂ]RegularHilbert H) := by\r\n  have he : fibre (1-R)=1-fibre R := by\r\n    have h := map_sub (fibreRepresentation (H:=H)) (1:H→L[ℂ]H) R\r\n    change fibre (1-R)=fibre 1-fibre R at h\r\n    simpa only [fibre_one] using h\r\n  rw [←he]\r\n  exact fibre_operator_injective _ hj\r\n\r\ndef liftedRoot : RegularHilbert H →ₗ.[ℂ] RegularHilbert H :=\r\n  resolventSquareRoot (fibre R) (fibre_nonneg hR) (fibre_operator_injective R hi)\r\n\r\ninclude h1 in\r\ntheorem liftedRoot_selfadjoint : IsSelfAdjoint (liftedRoot R hR hi) :=\r\n  resolventSquareRoot_selfadjoint _ _ _ (lifted_le_one R h1)\r\n\r\ninclude h1 in\r\ntheorem liftedRoot_square :\r\n    partialOperatorSquare (liftedRoot R hR hi)=\r\n      resolventGraphOperator (fibre R) (fibre_operator_injective R hi) :=\r\n  resolventSquareRoot_square _ _ _ (lifted_le_one R h1)\r\n\r\ndef liftedFlow (t : ℝ) : RegularHilbert H ≃ₗᵢ[ℂ] RegularHilbert H :=\r\n  resolventImaginaryPower (fibre R) (fibre_nonneg hR) (lifted_le_one R h1)\r\n    (fibre_operator_injective R hi) (lifted_complement_injective R hj) t\r\n\r\ntheorem liftedFlow_eq_fibre (t : ℝ) (f : RegularHilbert H) :\r\n    liftedFlow R hR h1 hi hj t f =\r\n      fibre ((resolventImaginaryPower R hR h1 hi hj t).toLinearIsometry.toContinuousLinearMap) f := by\r\n  let U := resolventImaginaryPower R hR h1 hi hj t\r\n  have hd :