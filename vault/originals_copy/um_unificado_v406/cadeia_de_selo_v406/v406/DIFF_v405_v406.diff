nction.comp_def,lowerGaussian,twistedGaussian,Complex.ofReal_zero,neg_zero,zero_mul,\r\n    Complex.exp_zero] using he\r\n\r\ndef regularize (n : ℕ) : TGLV350.Regular.RegularHilbert H →L[ℂ]\r\n    TGLV350.Regular.RegularHilbert H :=\r\n  multiply (fun r => lowerGaussian (width n) r) (regulator_continuous n)\r\n    bound bound_pos.le (regulator_bound n)\r\n\r\ntheorem regularize_ae (n : ℕ) (f : TGLV350.Regular.RegularHilbert H) :\r\n    regularize n f =ᵐ[volume] fun r => lowerGaussian (width n) r • f r :=\r\n  multiply_ae _ _ _ _ _ f\r\n\r\ntheorem regularize_tendsto (f : TGLV350.Regular.RegularHilbert H) :\r\n    Tendsto (fun n => regularize n f) atTop (𝓝 f) :=\r\n  multiply_tendsto _ regulator_continuous bound bound_pos.le regulator_bound regulator_tendsto f\r\n\r\nend F1Fecho.GaussianL2Removal\r\n#print axioms F1Fecho.GaussianL2Removal.regulator_bound\r\n#print axioms F1Fecho.GaussianL2Removal.regulator_tendsto\r\n#print axioms F1Fecho.GaussianL2Removal.regularize_tendsto\r\n',
+    'TGLExt/F1Fecho394/GaussianLogScalarR4.lean': "import Mathlib.Analysis.SpecialFunctions.Gaussian.FourierTransform\r\nimport TGLExt.ModularFlowLevel\r\n\r\n/-! Scalar Gaussian averaging and endpoint decay for the log-resolvent\r\ncoordinate. The constants are derived from the Fourier integral. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.GaussianLogScalar\r\nopen ChatgptAudit\r\n\r\ntheorem gaussian_fourier (a:ℝ) (ha:0<a) (l:ℝ) :\r\n    (∫t:ℝ,(Real.exp (-a*t^2):ℂ)*modularPhase t l)=\r\n      ((Real.pi:ℂ)/a)^(1/2:ℂ)*Complex.exp (-(l:ℂ)^2/(4*a)) := by\r\n  have he: (fun t:ℝ=>(Real.exp (-a*t^2):ℂ)*modularPhase t l)=\r\n      (fun t:ℝ=>Complex.exp (Complex.I*(l:ℂ)*t)*Complex.exp (-(a:ℂ)*t^2)) := by\r\n    funext t\r\n    unfold modularPhase\r\n    rw [Complex.ofReal_exp]\r\n    push_cast\r\n    rw [mul_comm]\r\n    congr 2 <;> ring\r\n  rw [he]\r\n  exact fourierIntegral_gaussian (by simpa using ha) (l:ℂ)\r\n\r\ntheorem gaussian_linear_atTop (b:ℝ) (hb:0<b) (c:ℝ) :\r\n    Tendsto (fun l:ℝ=>Real.exp (-b*l^2+c*l)) atTop (𝓝 0) := by\r\n  have hg:Tendsto (fun l:ℝ=>Real.exp (-b*l^2)) atTop (𝓝 0) :=\r\n    Real.tendsto_exp_atBot.comp\r\n      ((tendsto_pow_atTop (by norm_num : (2:ℕ)≠0)).const_mul_atTop_of_neg (neg_lt_zero.mpr hb))\r\n  have hs:Tendsto (fun l:ℝ=>l-c/(2*b)) atTop atTop := tendsto_atTop_add_const_right _ _ tendsto_id\r\n  have ht: Tendsto (fun l:ℝ=>Real.exp (c^2/(4*b))*Real.exp (-b*(l-c/(2*b))^2))\r\n      atTop (𝓝 0) := by simpa using (hg.comp hs).const_mul (Real.exp (c^2/(4*b)))\r\n  convert ht using 1\r\n  funext l\r\n  rw [←Real.exp_add]\r\n  congr 1\r\n  field_simp [ne_of_gt hb]\r\n  <;> ring\r\n\r\ntheorem gaussian_linear_atBot (b:ℝ) (hb:0<b) (c:ℝ) :\r\n    Tendsto (fun l:ℝ=>Real.exp (-b*l^2+c*l)) atBot (𝓝 0) := by\r\n  have h:=(gaussian_linear_atTop b hb (-c)).comp tendsto_neg_atBot_atTop\r\n  convert h using 1\r\n  funext l\r\n  congr 1\r\n  ring\r\n\r\ndef logCoordinate (x:ℝ):ℝ:=Real.log ((1-x)/x)\r\ndef compactify (f:ℝ→ℝ) (x:ℝ):ℝ:=if x=0 ∨ x=1 then 0 else f (logCoordinate x)\r\n\r\ntheorem logCoordinate_zero : Tendsto logCoordinate (𝓝[≠] (0:ℝ)) atTop := by\r\n  have h1:Tendsto (fun x:ℝ=>Real.log (1-x)) (𝓝[≠] (0:ℝ)) (𝓝 0) := by\r\n    have h:ContinuousAt (fun x:ℝ=>Real.log (1-x)) 0 :=\r\n      (continuousAt_const.sub continuousAt_id).log (by norm_num)\r\n    simpa using h.tendsto.mono_left nhdsWithin_le_nhds\r\n  have h:=h1.add_atTop (tendsto_neg_atBot_atTop.comp Real.tendsto_log_nhdsNE_zero)\r\n  apply h.congr'\r\n  filter_upwards [self_mem_nhdsWithin,\r\n    (eventually_ne_nhdsWithin (s:={0}ᶜ) (by norm_num : (0:ℝ)≠1))] with x hx hx1\r\n  simp only [Set.mem_compl_iff,Set.mem_singleton_iff] at hx\r\n  dsimp only [logCoordinate]\r\n  rw [Real.log_div (sub_ne_zero.mpr (Ne.symm hx1)) hx,sub_eq_add_neg]\r\n  simp only [Function.comp_apply,sub_eq_add_neg]\r\n\r\ntheorem logCoordinate_one : Tendsto logCoordinate (𝓝[≠] (1:ℝ)) atBot := by\r\n  have hn:Tendsto (fun x:ℝ=>1-x) (𝓝[≠] (1:ℝ)) (𝓝[≠] (0:ℝ)) := by\r\n    apply tendsto_nhdsWithin_iff.mpr\r\n    constructor\r\n    · have h:ContinuousAt (fun x:ℝ=>1-x) 1 := by fun_prop\r\n      simpa using h.tendsto.mono_left nhdsWithin_le_nhds\r\n    · filter_upwards [self_mem_nhdsWithin] with x hx\r\n      simp only [Set.mem_compl_iff,Set.mem_singleton_iff] at hx ⊢\r\n      exact sub_ne_zero.mpr (Ne.symm hx)\r\n  have h2:Tendsto (fun x:ℝ=>Real.log x) (𝓝[≠] (1:ℝ)) (𝓝 0) := by\r\n    simpa using (Real.continuousAt_log (by norm_num : (1:ℝ)≠0)).tendsto.mono_left nhdsWithin_le_nhds\r\n  have h:=(Real.tendsto_log_nhdsNE_zero.comp hn).atBot_add h2.neg\r\n  apply h.congr'\r\n  filter_upwards [self_mem_nhdsWithin,\r\n    (eventually_ne_nhdsWithin (s:={1}ᶜ) (by norm_num : (1:ℝ)≠0))] with x hx hx0\r\n  simp only [Set.mem_compl_iff,Set.mem_singleton_iff] at hx\r\n  dsimp only [logCoordinate]\r\n  rw [Real.log_div (sub_ne_zero.mpr (Ne.symm hx)) hx0,sub_eq_add_neg]\r\n  simp only [Function.comp_apply,sub_eq_add_neg]\r\n\r\ntheorem compactify_continuous (f:ℝ→ℝ) (hf:Continuous f)\r\n    (h0:Tendsto f atTop (𝓝 0)) (h1:Tendsto f atBot (𝓝 0)) : Continuous (compactify f) := by\r\n  rw [continuous_iff_continuousAt]\r\n  intro x\r\n  by_cases hz:x=0\r\n  · subst x\r\n    rw [continuousAt_iff_punctured_nhds]\r\n    simp only [compactify,ite_true,true_or]\r\n    apply (h0.comp logCoordinate_zero).congr'\r\n    filter_upwards [self_mem_nhdsWithin,\r\n      (eventually_ne_nhds (by norm_num : (0:ℝ)≠1)).filter_mono nhdsWithin_le_nhds] with y hy hy1\r\n    simp only [Set.mem_compl_iff,Set.mem_singleton_iff] at hy\r\n    simp [compactify,hy,hy1]\r\n  · by_cases ho:x=1\r\n    · subst x\r\n      rw [continuousAt_iff_punctured_nhds]\r\n      simp only [compactify,ite_true,or_true]\r\n      apply (h1.comp logCoordinate_one).congr'\r\n      filter_upwards [self_mem_nhdsWithin,\r\n        (eventually_ne_nhds (by norm_num : (1:ℝ)≠0)).filter_mono nhdsWithin_le_nhds] with y hy hy0\r\n      simp only [Set.mem_compl_iff,Set.mem_singleton_iff] at hy\r\n      simp [compactify,hy,hy0]\r\n    · have hc:ContinuousAt (fun y:ℝ=>f (logCoordinate y)) x := by\r\n        apply hf.continuousAt.comp\r\n        unfold logCoordinate\r\n        apply ContinuousAt.log\r\n        · fun_prop\r\n        · exact div_ne_zero (sub_ne_zero.mpr (Ne.symm ho)) hz\r\n      apply hc.congr_of_eventuallyEq\r\n      filter_upwards [eventually_ne_nhds hz,eventually_ne_nhds ho] with y hy0 hy1\r\n      simp [compactify,hy0,hy1]\r\n\r\nend F1Fecho.GaussianLogScalar\r\n#print axioms F1Fecho.GaussianLogScalar.gaussian_fourier\r\n#print axioms F1Fecho.GaussianLogScalar.gaussian_linear_atTop\r\n#print axioms F1Fecho.GaussianLogScalar.gaussian_linear_atBot\r\n#print axioms F1Fecho.GaussianLogScalar.compactify_continuous\r\n",
+    'TGLExt/F1Fecho394/GaussianProbabilityKernelR4.lean': 'import TGLExt.F1Fecho394.GaussianLogScalarR4\r\n\r\n/-! Fixed real Gaussian probability kernel and its exact angular Fourier\r\ntransform. A later group average uses this kernel with time c*t. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.GaussianLogScalar\r\nopen ChatgptAudit\r\n\r\ndef gaussianWeight (t:ℝ):ℝ:=(Real.sqrt Real.pi)⁻¹*Real.exp (-t^2)\r\n\r\ntheorem gaussianWeight_continuous : Continuous gaussianWeight := by unfold gaussianWeight; fun_prop\r\n\r\ntheorem gaussianWeight_integrable : Integrable gaussianWeight volume := by\r\n  unfold gaussianWeight\r\n  have h:= (integrable_exp_neg_mul_sq (by norm_num : (0:ℝ)<1)).const_mul ((Real.sqrt Real.pi)⁻¹)\r\n  simpa only [gaussianWeight, neg_one_mul] using h\r\n\r\ntheorem gaussianWeight_nonneg (t:ℝ) : 0≤gaussianWeight t := by unfold gaussianWeight; positivity\r\n\r\ntheorem gaussianWeight_integral : ∫t:ℝ,gaussianWeight t=1 := by\r\n  unfold gaussianWeight\r\n  rw [integral_const_mul]\r\n  have h: (∫t:ℝ,Real.exp (-t^2))=Real.sqrt Real.pi := by\r\n    simpa only [neg_one_mul,div_one] using integral_gaussian 1\r\n  rw [h,inv_mul_cancel₀ (ne_of_gt (Real.sqrt_pos.2 Real.pi_pos))]\r\n\r\ntheorem gaussian_fourier_constant : ((Real.pi:ℂ)/1)^(1/2:ℂ)=(Real.sqrt Real.pi:ℂ) := by\r\n  have hr: (∫t:ℝ,Real.exp (-t^2))=Real.sqrt Real.pi := by\r\n    simpa only [neg_one_mul,div_one] using integral_gaussian 1\r\n  have h:=gaussian_fourier 1 (by norm_num) 0\r\n  simp only [modularPhase,mul_zero,Complex.ofReal_zero,zero_mul,Complex.exp_zero,\r\n    mul_one,neg_one_mul,zero_pow (by norm_num : (2:ℕ)≠0),neg_zero,zero_div,\r\n    Complex.ofReal_one,div_one] at h ⊢\r\n  rw [integral_complex_ofReal, hr] at h\r\n  exact h.symm\r\n\r\ntheorem gaussianWeight_fourier (c l:ℝ) :\r\n    (∫t:ℝ,(gaussianWeight t:ℂ)*modularPhase (c*t) l)=\r\n      (Real.exp (-(c*l)^2/4):ℂ) := by\r\n  have hp (t:ℝ):modularPhase (c*t) l=modularPhase t (c*l) := by\r\n    unfold modularPhase\r\n    congr 1\r\n    push_cast\r\n    ring\r\n  simp only [gaussianWeight,Complex.ofReal_mul,mul_assoc,hp]\r\n  rw [integral_const_mul]\r\n  have h:=gaussian_fourier 1 (by norm_num) (c*l)\r\n  simp only [neg_one_mul] at h\r\n  rw [h]\r\n  simp only [Complex.ofReal_one]\r\n  rw [gaussian_fourier_constant]\r\n  have hn:(Real.sqrt Real.pi:ℂ)≠0:=Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.2 Real.pi_pos))\r\n  rw [Complex.ofReal_inv,←mul_assoc,inv_mul_cancel₀ hn,one_mul,Complex.ofReal_exp]\r\n  congr 1\r\n  push_cast\r\n  ring\r\n\r\nend F1Fecho.GaussianLogScalar\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianWeight_integrable\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianWeight_integral\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianWeight_fourier\r\n',
+    'TGLExt/F1Fecho394/GaussianResolventAverageR6.lean': 'import TGLExt.F1Fecho394.GaussianResolventRegularizerR4\r\nimport TGLExt.F1Fecho394.GroupAverageApproximationR2\r\nimport Mathlib.Analysis.SpecificLimits.Basic\r\n\r\n/-! The real Gaussian average is the spectral regularizer of the actual\r\nresolvent group. Equality is proved on the dense damped range, then on H.\r\nThis is an operator theorem, not a new assumption about the weight GNS. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.GaussianResolventAverage\r\nopen TGLV350.Regular F1Fecho.GaussianLogScalar F1Fecho.GaussianResolventRegularizer\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nlocal instance : Module ℝ (H→L[ℂ]H) := Module.restrictScalars ℝ ℂ _\r\nvariable (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1)\r\n  (hi:Function.Injective R) (hj:Function.Injective (1-R:H→L[ℂ]H))\r\n\r\ndef average (c:ℝ) : H→L[ℂ]H := StrongUnitaryAverage.average\r\n  (fun t=>resolventImaginaryPower R hR h1 hi hj (c*t))\r\n  (fun x=>(resolventImaginaryPower_strongly_continuous R hR h1 hi hj x).comp\r\n    (continuous_const.mul continuous_id)) gaussianWeight gaussianWeight_integrable\r\n\r\ntheorem average_apply (c:ℝ) (x:H) : average R hR h1 hi hj c x=\r\n    ∫t:ℝ,gaussianWeight t • resolventImaginaryPower R hR h1 hi hj (c*t) x := rfl\r\n\r\ninclude hR h1 in\r\ntheorem weighted_phase_operator (c:ℝ) (hc:c≠0) :\r\n    (∫t:ℝ,(gaussianWeight t:ℂ) • resolventPhaseOperator R (c*t))=\r\n      spectral R (c^2/4) * resolventDampingOperator R := by\r\n  have hb:0<c^2/4:=div_pos (sq_pos_of_ne_zero hc) (by norm_num)\r\n  have hs:=IsSelfAdjoint.of_nonneg hR\r\n  rw [←ResolventScaledPhaseIntegral.weighted_phase_integral R hR h1 c gaussianWeight\r\n    gaussianWeight_continuous gaussianWeight_integrable]\r\n  simp only [gaussian_phase_integral]\r\n  rw [spectral,cfc_real_eq_complex _ hs,←resolventDampingOperator_cfc R hs]\r\n  have hg:Continuous (fun z:ℂ=>(gaussianSymbol (c^2/4) z.re:ℂ)) :=\r\n    Complex.continuous_ofReal.comp ((gaussianSymbol_continuous _ hb).comp Complex.continuous_re)\r\n  have hd:Continuous (fun z:ℂ=>(resolventDamping z.re:ℂ)) := by\r\n    unfold resolventDamping\r\n    fun_prop\r\n  rw [←cfc_mul _ _ R hg.continuousOn hd.continuousOn]\r\n  apply cfc_congr\r\n  intro z hz\r\n  exact mul_comm _ _\r\n\r\ntheorem average_damping (c:ℝ) (hc:c≠0) (x:H) :\r\n    average R hR h1 hi hj c (resolventDampingOperator R x)=\r\n      spectral R (c^2/4) (resolventDampingOperator R x) := by\r\n  rw [average_apply]\r\n  simp only [resolventImaginaryPower_damping]\r\n  have hint:=ResolventScaledPhaseIntegral.weighted_phase_integrable R hR h1 c gaussianWeight\r\n    gaussianWeight_continuous gaussianWeight_integrable\r\n  have he:=ContinuousLinearMap.integral_apply hint x\r\n  have hv:=congrArg (fun A:H→L[ℂ]H=>A x) (weighted_phase_operator R hR h1 c hc)\r\n  rw [he] at hv\r\n  have hsmul (r : ℝ) (v : H) : (r : ℂ) • v = r • v := by\r\n    exact (RCLike.real_smul_eq_coe_smul (K := ℂ) r v).symm\r\n  simpa only [ContinuousLinearMap.smul_apply, hsmul, ContinuousLinearMap.mul_apply] using hv\r\n\r\ntheorem average_eq_spectral (c:ℝ) (hc:c≠0) :\r\n    average R hR h1 hi hj c=spectral R (c^2/4) := by\r\n  ext1 x\r\n  refine (resolventDampingOperator_denseRange R hR h1 hi hj).induction ?_\r\n    (isClosed_eq (average R hR h1 hi hj c).continuous (spectral R (c^2/4)).continuous) x\r\n  rintro _ ⟨y,rfl⟩\r\n  exact average_damping R hR h1 hi hj c hc y\r\n\r\ntheorem average_root_domain (c:ℝ) (hc:c≠0) (x:H) :\r\n    ∃y,(average R hR h1 hi hj c x,y)∈(resolventSquareRoot R hR hi).graph := by\r\n  rw [average_eq_spectral R hR h1 hi hj c hc]\r\n  exact spectral_root_domain R hR h1 hi _ (div_pos (sq_pos_of_ne_zero hc) (by norm_num)) x\r\n\r\ndef scale (n:ℕ):ℝ:=1/((n:ℝ)+1)\r\n\r\ntheorem scale_ne_zero (n:ℕ) : scale n≠0 := by unfold scale; positivity\r\n\r\ntheorem average_tendsto (x:H) :\r\n    Tendsto (fun n:ℕ=>average R hR h1 hi hj (scale n) x) atTop (𝓝 x) := by\r\n  exact GroupAverageApproximation.averages_tendsto_identity\r\n    (resolventImaginaryPower R hR h1 hi hj)\r\n    (resolventImaginaryPower_strongly_continuous R hR h1 hi hj)\r\n    (resolventImaginaryPower_zero R hR h1 hi hj)\r\n    gaussianWeight gaussianWeight_integrable gaussianWeight_integral scale\r\n    tendsto_one_div_add_atTop_nhds_zero_nat x\r\n\r\nend F1Fecho.GaussianResolventAverage\r\n#print axioms F1Fecho.GaussianResolventAverage.weighted_phase_operator\r\n#print axioms F1Fecho.GaussianResolventAverage.average_eq_spectral\r\n#print axioms F1Fecho.GaussianResolventAverage.average_root_domain\r\n#print axioms F1Fecho.GaussianResolventAverage.average_tendsto\r\n',
+    'TGLExt/F1Fecho394/GaussianResolventRegularizerR4.lean': "import TGLExt.F1Fecho394.GaussianResolventSymbolR2\r\nimport TGLExt.F1Fecho394.GaussianProbabilityKernelR4\r\nimport TGLExt.F1Fecho394.ResolventScaledPhaseIntegralR1\r\nimport TGLExt.F1Fecho394.StrongUnitaryAverageR1\r\nimport TGLExt.F1Fecho394.FibreRootGraphR3\r\n\r\n/-! Concrete Gaussian averaging of the resolvent modular group, including\r\nits range in the positive root domain. The GNS graph is not an input here. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1400000\r\nnoncomputable section\r\nopen MeasureTheory\r\nnamespace F1Fecho.GaussianResolventRegularizer\r\nopen TGLV350.Regular F1Fecho.GaussianLogScalar\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\nlocal instance : Module ℝ (H→L[ℂ]H) := Module.restrictScalars ℝ ℂ _\r\n\r\ndef spectral (R:H→L[ℂ]H) (b:ℝ) : H→L[ℂ]H := cfc (gaussianSymbol b) R\r\n\r\ntheorem spectral_factor (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1) (b:ℝ) (hb:0<b) :\r\n    spectral R b=R*cfc (gaussianRangeFactor b) R := by\r\n  have hs:=IsSelfAdjoint.of_nonneg hR\r\n  change cfc (gaussianSymbol b) R=_\r\n  have he:cfc (gaussianSymbol b) R=cfc (fun x:ℝ=>x*gaussianRangeFactor b x) R := by\r\n    apply cfc_congr\r\n    intro x hx\r\n    exact gaussianSymbol_factors b x (positive_contraction_spectrum_bounds R hR h1 hx)\r\n  rw [he,cfc_mul (fun x:ℝ=>x) (gaussianRangeFactor b) R (by fun_prop) (gaussianRangeFactor_continuous b hb).continuousOn,\r\n    cfc_id' ℝ R hs]\r\n\r\ntheorem spectral_root_domain (R:H→L[ℂ]H) (hR:0≤R) (h1:R≤1)\r\n    (hi:Function.Injective R) (b:ℝ) (hb:0<b) (x:H) :\r\n    ∃y,(spectral R b x,y)∈(resolventSquareRoot R hR hi).graph := by\r\n  rw [spectral_factor R hR h1 b hb]\r\n  exact ⟨_,FibreRootGraph.root_regularized_graph R hR h1 hi (cfc (gaussianRangeFactor b) R x)⟩\r\n\r\ntheorem gaussian_phase_integral (c x:ℝ) :\r\n    (∫t:ℝ,(gaussianWeight t:ℂ)*resolventPhaseFunction (c*t) x)=\r\n      (resolventDamping x:ℂ)*(gaussianSymbol (c^2/4) x:ℂ) := by\r\n  by_cases hx:x=0 ∨ x=1\r\n  · rcases hx with rfl|rfl <;> simp [resolventPhaseFunction,resolventDamping]\r\n  · have he: (fun t:ℝ=>(gaussianWeight t:ℂ)*resolventPhaseFunction (c*t) x)=\r\n      (fun t:ℝ=>(resolventDamping x:ℂ)*((gaussianWeight t:ℂ)*\r\n        ChatgptAudit.modularPhase (c*t) (logCoordinate x))) := by\r\n      funext t\r\n      unfold resolventPhaseFunction logCoordinate\r\n      ring\r\n    rw [he,integral_const_mul,gaussianWeight_fourier]\r\n    simp only [gaussianSymbol,compactify,if_neg hx]\r\n    congr 2\r\n    ring\r\n\r\nend F1Fecho.GaussianResolventRegularizer\r\n#print axioms F1Fecho.GaussianResolventRegularizer.spectral_factor\r\n#print axioms F1Fecho.GaussianResolventRegularizer.spectral_root_domain\r\n#print axioms F1Fecho.GaussianResolventRegularizer.gaussian_phase_integral\r\n",
+    'TGLExt/F1Fecho394/GaussianResolventSymbolR2.lean': 'import TGLExt.F1Fecho394.GaussianLogScalarR4\r\n\r\n/-! Continuous Gaussian spectral multipliers on the compact resolvent\r\ncoordinate; their range factors through R, with endpoint zero proved. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.GaussianLogScalar\r\n\r\ndef gaussianSymbol (b:ℝ) : ℝ→ℝ := compactify (fun l=>Real.exp (-b*l^2))\r\ndef gaussianRangeFactor (b:ℝ) : ℝ→ℝ :=\r\n  compactify (fun l=>Real.exp (-b*l^2)+Real.exp (-b*l^2+l))\r\n\r\ntheorem gaussianSymbol_continuous (b:ℝ) (hb:0<b) : Continuous (gaussianSymbol b) := by\r\n  apply compactify_continuous _ (by fun_prop)\r\n  · simpa using gaussian_linear_atTop b hb 0\r\n  · simpa using gaussian_linear_atBot b hb 0\r\n\r\ntheorem gaussianRangeFactor_continuous (b:ℝ) (hb:0<b) : Continuous (gaussianRangeFactor b) := by\r\n  apply compactify_continuous _ (by fun_prop)\r\n  · simpa using (gaussian_linear_atTop b hb 0).add (gaussian_linear_atTop b hb 1)\r\n  · simpa using (gaussian_linear_atBot b hb 0).add (gaussian_linear_atBot b hb 1)\r\n\r\ntheorem gaussianSymbol_nonneg (b x:ℝ) : 0≤gaussianSymbol b x := by\r\n  unfold gaussianSymbol compactify\r\n  split\r\n  · exact le_rfl\r\n  · exact (Real.exp_pos _).le\r\n\r\ntheorem gaussianSymbol_le_one (b:ℝ) (hb:0≤b) (x:ℝ) : gaussianSymbol b x≤1 := by\r\n  unfold gaussianSymbol compactify\r\n  split\r\n  · norm_num\r\n  · apply Real.exp_le_one_iff.mpr\r\n    exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hb) (sq_nonneg _)\r\n\r\ntheorem gaussianSymbol_factors (b x:ℝ) (hx:x∈Set.Icc (0:ℝ) 1) :\r\n    gaussianSymbol b x=x*gaussianRangeFactor b x := by\r\n  by_cases hz:x=0 ∨ x=1\r\n  · simp [gaussianSymbol,gaussianRangeFactor,compactify,hz]\r\n  · have hp:0<x:=lt_of_le_of_ne hx.1 (Ne.symm (not_or.mp hz).1)\r\n    have hq:x<1:=lt_of_le_of_ne hx.2 (not_or.mp hz).2\r\n    have he:Real.exp (logCoordinate x)=(1-x)/x :=\r\n      Real.exp_log (div_pos (sub_pos.mpr hq) hp)\r\n    simp only [gaussianSymbol,gaussianRangeFactor,compactify,if_neg hz,Real.exp_add,he]\r\n    field_simp\r\n    <;> ring\r\n\r\nend F1Fecho.GaussianLogScalar\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianSymbol_continuous\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianRangeFactor_continuous\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianSymbol_nonneg\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianSymbol_le_one\r\n#print axioms F1Fecho.GaussianLogScalar.gaussianSymbol_factors\r\n',
+    'TGLExt/F1Fecho394/GeneralCutoffAverageCommutationR1.lean': 'import TGLExt.F1Fecho394.GeneralRegularCutoffCFCR1\r\nimport TGLExt.F1Fecho394.RegularCoreAverageR2\r\nimport Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Commute\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\n\r\nnamespace F1Fecho.RegularPositiveFlow\r\nopen TGLExt TGLV350.Regular MeasureTheory\r\nnoncomputable section\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\nprivate theorem hilbertPositiveSqrt_commutes {H : Type}\r\n    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n    (A B : H →L[ℂ] H) (h : Commute A B) :\r\n    Commute (hilbertPositiveSqrt A) B :=\r\n  h.cfcₙ_nnreal NNReal.sqrt\r\n\r\n/-- The resolvent and regular group commute in their original realization. -/\r\ntheorem regularSpectralResolvent_commutes_regular (Q : F1Fecho.RegularCovariantCore.UnitaryFlow H) (t : ℝ) :\r\n    Commute (regularSpectralResolvent Q) (RegularCovariantCore.regularUnitary Q t) := by\r\n  let V := regularSpectralCoordinates Q\r\n  let C := characterMultiplier (H := H) (2*Real.pi*t)\r\n  let M := realScalarMultiplier (H := H) (fun x => Real.sigmoid (2*Real.pi*x))\r\n    (by fun_prop) (fun x => Real.sigmoid_nonneg _) (fun x => Real.sigmoid_le_one _)\r\n  have hchar (s : ℝ) : characterMultiplier s*C = C*characterMultiplier s := by\r\n    dsimp only [C]\r\n    rw [characterMultiplier_mul,characterMultiplier_mul,add_comm]\r\n  have hm : Commute M C :=\r\n    character_commutation_realScalarMultiplier C hchar _ _ _ _\r\n  have hv : V.conjStarAlgEquiv C = RegularCovariantCore.regularUnitary Q t := by\r\n    ext1 x\r\n    change V (C (V.symm x)) = RegularCovariantCore.regularUnitary Q t x\r\n    dsimp only [C]\r\n    rw [regularSpectralCoordinates_character,V.apply_symm_apply]\r\n  have hc := hm.map V.conjStarAlgEquiv\r\n  change Commute (regularSpectralResolvent Q) (V.conjStarAlgEquiv C) at hc\r\n  rwa [hv] at hc\r\n\r\n/-- The SAME positive square root of the existing cut commutes with the group. -/\r\ntheorem regularInverseCutoffSqrt_commutes_regular (Q : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (ε : ℝ) (hε : 0 < ε) (t : ℝ) :\r\n    Commute (hilbertPositiveSqrt (regularInverseGeneratorCutoff Q ε))\r\n      (RegularCovariantCore.regularUnitary Q t) := by\r\n  have hr := (IsSelfAdjoint.of_nonneg (regularSpectralResolvent_nonneg Q)).commute_cfc\r\n    (regularSpectralResolvent_commutes_regular Q t) (inverseCutoffFunction ε)\r\n  rw [← regularInverseGeneratorCutoff_cfc Q ε hε] at hr\r\n  exact hilbertPositiveSqrt_commutes _ _ hr\r\n\r\n/-- Integration preserves this proved commutation for every averaging interval. -/\r\ntheorem regularInverseCutoffSqrt_commutes_average (Q : F1Fecho.RegularCovariantCore.UnitaryFlow H)\r\n    (ε : ℝ) (hε : 0 < ε) (δ : ℝ) :\r\n    Commute (hilbertPositiveSqrt (regularInverseGeneratorCutoff Q ε))\r\n      (RegularCoreAverage.regularAverage Q δ) := by\r\n  let B := hilbertPositiveSqrt (regularInverseGeneratorCutoff Q ε)\r\n  ext1 v\r\n  change B (RegularCoreAverage.regularAverage Q δ v) = RegularCoreAverage.regularAverage Q δ (B v)\r\n  rw [RegularCoreAverage.regularAverage_apply,RegularCoreAverage.regularAverage_apply]\r\n  change B (((δ⁻¹ : ℝ) : ℂ) • ∫ t in 0..δ, RegularCovariantCore.regularUnitary Q t v) =\r\n    ((δ⁻¹ : ℝ) : ℂ) • ∫ t in 0..δ, RegularCovariantCore.regularUnitary Q t (B v)\r\n  rw [map_smul]\r\n  congr 1\r\n  rw [← B.intervalIntegral_comp_comm ((RegularCovariantCore.regular_strongly_continuous Q v).intervalIntegrable 0 δ)]\r\n  apply intervalIntegral.integral_congr\r\n  intro t _\r\n  exact congrArg (fun T : RegularHilbert (H) →L[ℂ] _ => T v)\r\n    (regularInverseCutoffSqrt_commutes_regular Q ε hε t).eq\r\n\r\nend\r\nend F1Fecho.RegularPositiveFlow\r\n\r\n#print axioms F1Fecho.RegularPositiveFlow.regularSpectralResolvent_commutes_regular\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseCutoffSqrt_commutes_regular\r\n#print axioms F1Fecho.RegularPositiveFlow.regularInverseCutoffSqrt_commutes_average\r\n',
+    'TGLExt/F1Fecho394/GeneralDampedPhaseBalanceR1.lean': "import TGLExt.V351ModularCutBalance\r\n/-! Public generic reuse of the three already-proved v351 phase-balance\r\nlemmas. The concrete GNS consumer must prove the phase intertwining and\r\ncommutation premises; they are not manufactured by this generic theorem. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.ModularCutBalance\r\nopen TGLV350.Regular ChatgptAudit TGLExt MeasureTheory Filter\r\nopen scoped ComplexOrder Topology\r\n/-- Endpoint-safe scalar consumer of the previously proved frequency separation.\r\nThis scalar calculation alone does not assert the original operator balance. -/\r\ntheorem damped_phase_scalar_balance (r a b : ℝ)\r\n    (hr : r ∈ Set.Icc 0 1) (ha : a ∈ Set.Icc 0 1) (hb : b ∈ Set.Icc 0 1)\r\n    (hphase : ∀ t : ℝ,\r\n      resolventPhaseFunction t r * (resolventDamping a : ℂ) * (resolventDamping b : ℂ) =\r\n      (resolventDamping r : ℂ) * resolventPhaseFunction t a * resolventPhaseFunction (-t) b) :\r\n    (resolventDamping r * resolventDamping a * resolventDamping b) *\r\n      ((1-r)*a*(1-b)-r*(1-a)*b) = 0 := by\r\n  by_cases hz : resolventDamping r * resolventDamping a * resolventDamping b = 0\r\n  · rw [hz, zero_mul]\r\n  have hdr : resolventDamping r ≠ 0 := fun h => hz (by rw [h, zero_mul, zero_mul])\r\n  have hda : resolventDamping a ≠ 0 := fun h => hz (by rw [h, mul_zero, zero_mul])\r\n  have hdb : resolventDamping b ≠ 0 := fun h => hz (by rw [h, mul_zero])\r\n  have hs (x : ℝ) (hx : x ∈ Set.Icc 0 1) (hd : resolventDamping x ≠ 0) :\r\n      0 < x ∧ 0 < 1-x := by\r\n    have h0 : x ≠ 0 := fun h => hd (by simp [resolventDamping,h])\r\n    have h1 : x ≠ 1 := fun h => hd (by simp [resolventDamping,h])\r\n    exact ⟨lt_of_le_of_ne hx.1 h0.symm, sub_pos.mpr (lt_of_le_of_ne hx.2 h1)⟩\r\n  obtain ⟨hr0, hr1⟩ := hs r hr hdr\r\n  obtain ⟨ha0, ha1⟩ := hs a ha hda\r\n  obtain ⟨hb0, hb1⟩ := hs b hb hdb\r\n  have hc : ((resolventDamping r * resolventDamping a * resolventDamping b : ℝ) : ℂ) ≠ 0 := by\r\n    exact_mod_cast hz\r\n  have hfreq : Real.log ((1-r)/r) = Real.log ((1-a)/a) - Real.log ((1-b)/b) := by\r\n    apply Commutation032.modular_phase_frequency_separation _ _ _ hc\r\n    intro t\r\n    have hp : modularPhase t (Real.log ((1-a)/a) - Real.log ((1-b)/b)) =\r\n        modularPhase t (Real.log ((1-a)/a)) * modularPhase (-t) (Real.log ((1-b)/b)) := by\r\n      unfold modularPhase\r\n      rw [← Complex.exp_add]\r\n      congr 1\r\n      push_cast\r\n      ring\r\n    rw [hp]\r\n    have ht := hphase t\r\n    simp only [resolventPhaseFunction] at ht\r\n    push_cast\r\n    calc\r\n      _ = (resolventDamping r : ℂ) * modularPhase t (Real.log ((1-r)/r)) *\r\n          (resolventDamping a : ℂ) * (resolventDamping b : ℂ) := by ring\r\n      _ = _ := ht\r\n      _ = _ := by ring\r\n  have he : (1-r)/r = ((1-a)/a) / ((1-b)/b) := by\r\n    calc\r\n      _ = Real.exp (Real.log ((1-r)/r)) := (Real.exp_log (div_pos hr1 hr0)).symm\r\n      _ = Real.exp (Real.log ((1-a)/a) - Real.log ((1-b)/b)) := congrArg Real.exp hfreq\r\n      _ = _ := by rw [Real.exp_sub, Real.exp_log (div_pos ha1 ha0), Real.exp_log (div_pos hb1 hb0)]\r\n  have he' : (1-r)*a*(1-b) = r*(1-a)*b := by\r\n    field_simp [ne_of_gt hr0, ne_of_gt ha0, ne_of_gt hb0, ne_of_gt hb1] at he\r\n    nlinarith [he]\r\n  rw [he', sub_self, mul_zero]\r\n\r\ntheorem damped_phase_commutative_balance {C : Type*} [CommCStarAlgebra C]\r\n    [ContinuousFunctionalCalculus ℂ C IsStarNormal]\r\n    [PartialOrder C] [StarOrderedRing C] (T A B : C)\r\n    (hT : T ∈ Set.Icc 0 1) (hA : A ∈ Set.Icc 0 1) (hB : B ∈ Set.Icc 0 1)\r\n    (hphase : ∀ t : ℝ,\r\n      cfc (fun z : ℂ => resolventPhaseFunction t z.re) T * (A*(1-A)) * (B*(1-B)) =\r\n      (T*(1-T)) * cfc (fun z : ℂ => resolventPhaseFunction t z.re) A *\r\n        cfc (fun z : ℂ => resolventPhaseFunction (-t) z.re) B) :\r\n    ((T*(1-T))*(A*(1-A))*(B*(1-B))) * ((1-T)*A*(1-B)-T*(1-A)*B) = 0 := by\r\n  apply (gelfandTransform_isometry C).injective\r\n  ext χ\r\n  change χ (((T*(1-T))*(A*(1-A))*(B*(1-B))) * ((1-T)*A*(1-B)-T*(1-A)*B)) = χ 0\r\n  have hrange (X : C) (hX : X ∈ Set.Icc 0 1) :\r\n      (χ X).re ∈ Set.Icc 0 1 ∧ χ X = ((χ X).re : ℂ) := by\r\n    have h0 : 0 ≤ χ X := by simpa only [map_zero] using (OrderHomClass.monotone χ hX.1)\r\n    have h1 : χ X ≤ 1 := by simpa only [map_one] using (OrderHomClass.monotone χ hX.2)\r\n    refine ⟨⟨(Complex.nonneg_iff.mp h0).1, h1.1⟩, ?_⟩\r\n    apply Complex.ext\r\n    · rfl\r\n    · simpa using (Complex.nonneg_iff.mp h0).2.symm\r\n  obtain ⟨htr, htc⟩ := hrange T hT\r\n  obtain ⟨har, hac⟩ := hrange A hA\r\n  obtain ⟨hbr, hbc⟩ := hrange B hB\r\n  have heval (X : C) (t : ℝ) :\r\n      χ (cfc (fun z : ℂ => resolventPhaseFunction t z.re) X) =\r\n        resolventPhaseFunction t (χ X).re := by\r\n    have hf : Continuous (fun z : ℂ => resolventPhaseFunction t z.re) :=\r\n      (resolventPhaseFunction_continuous t).comp Complex.continuous_re\r\n    have hh := StarAlgHomClass.map_cfc (S := ℂ) χ _ X hf.continuousOn\r\n    exact hh.trans (by\r\n      simpa using cfc_algebraMap (A := ℂ) (χ X) (fun z : ℂ => resolventPhaseFunction t z.re))\r\n  have hs := damped_phase_scalar_balance (χ T).re (χ A).re (χ B).re htr har hbr (by\r\n    intro t\r\n    have hh := congrArg χ (hphase t)\r\n    simp only [map_mul, map_sub, map_one, heval] at hh\r\n    rw [htc, hac, hbc] at hh\r\n    simpa only [Complex.ofReal_re, resolventDamping, Complex.ofReal_mul,\r\n      Complex.ofReal_sub, Complex.ofReal_one] using hh)\r\n  simp only [map_mul, map_sub, map_one, map_zero]\r\n  rw [htc, hac, hbc]\r\n  exact_mod_cast hs\r\n\r\nopen scoped IsMulCommutative in\r\ntheorem damped_phase_operator_balance {H : Type} [NormedAddCommGroup H]\r\n    [InnerProductSpace ℂ H] [CompleteSpace H] (T A B : H →L[ℂ] H)\r\n    (hT : T ∈ Set.Icc 0 1) (hA : A ∈ Set.Icc 0 1) (hB : B ∈ Set.Icc 0 1)\r\n    (hTA : Commute T A) (hTB : Commute T B) (hAB : Commute A B)\r\n    (hiT : Function.Injective T) (hjT : Function.Injective (1-T : H →L[ℂ] H))\r\n    (hiA : Function.Injective A) (hjA : Function.Injective (1-A : H →L[ℂ] H))\r\n    (hiB : Function.Injective B) (hjB : Function.Injective (1-B : H →L[ℂ] H))\r\n    (hphase : ∀ t : ℝ,\r\n      resolventPhaseOperator T t * resolventDampingOperator A * resolventDampingOperator B =\r\n      resolventDampingOperator T * resolventPhaseOperator A t * resolventPhaseOperator B (-t)) :\r\n    (1-T)*A*(1-B) = T*(1-A)*B := by\r\n  let U := StarAlgebra.adjoin ℂ ({T,A,B} : Set (H →L[ℂ] H))\r\n  let S := U.topologicalClosure\r\n  have hpair : ∀ x ∈ ({T,A,B} : Set (H →L[ℂ] H)), ∀ y ∈ ({T,A,B} : Set (H →L[ℂ] H)),\r\n      x*y=y*x := by\r\n    intro x hx y hy\r\n    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy\r\n    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl\r\n    all_goals first | rfl | exact hTA.eq | exact hTA.eq.symm | exact hTB.eq |\r\n      exact hTB.eq.symm | exact hAB.eq | exact hAB.eq.symm\r\n  have hstar (x : H →L[ℂ] H) (hx : x ∈ ({T,A,B} : Set (H →L[ℂ] H))) : star x=x := by\r\n    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx\r\n    rcases hx with rfl | rfl | rfl\r\n    · exact (IsSelfAdjoint.of_nonneg hT.1).star_eq\r\n    · exact (IsSelfAdjoint.of_nonneg hA.1).star_eq\r\n    · exact (IsSelfAdjoint.of_nonneg hB.1).star_eq\r\n  haveI : IsMulCommutative U := StarAlgebra.isMulCommutative_adjoin ℂ hpair (by\r\n    intro x hx y hy\r\n    rw [hstar y hy]\r\n    exact hpair x hx y hy)\r\n  letI : CommRing S := U.commRingTopologicalClosure (fun x y => mul_comm x y)\r\n  haveI : IsClosed (S : Set (H →L[ℂ] H)) := U.isClosed_topologicalClosure\r\n  letI : CommCStarAlgebra S := { }\r\n  letI : IsometricContinuousFunctionalCalculus ℂ S IsStarNormal :=\r\n    IsStarNormal.instIsometricContinuousFunctionalCalculus\r\n  letI : PartialOrder S := CStarAlgebra.spectralOrder S\r\n  letI : Preorder S := (CStarAlgebra.spectralOrder S).toPreorder\r\n  letI : 