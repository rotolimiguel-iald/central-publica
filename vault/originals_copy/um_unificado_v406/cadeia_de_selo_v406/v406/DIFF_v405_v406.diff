+    'TGLExt/F1Fecho394/GeometricIdentification.lean': 'import TGLExt.F1Fecho394.FourierConjugation\r\n\r\n/-! Exact identification of the previously constructed spectral conjugation in the original\r\nrapidity chart. This proves q -> -q, r unchanged, complex conjugation and helicity exchange.\r\nIt does not assert the remaining Poincare covariance or a complete four-dimensional net. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\n\r\nnamespace F1Rede.GeometricIdentification\r\nopen TGLExt.ImportedSQ AuditF13v31\r\nopen ChatgptAudit.WignerRapidityMeasure016\r\nopen F1Rede.Canonical F1Rede.CanonicalWedge F1Rede.FiberConjugation\r\n\r\ndef curriedRapidity : H1 ≃ₗᵢ[ℂ] RapidityHilbert := toRapidity.trans canonicalFub\r\n\r\n/-- Removing Fourier removes the reflected frequency: the antiunitary acts on each fiber at r. -/\r\ntheorem Jcandidate_curried (f : H1) :\r\n    curriedRapidity (Jcandidate f) =\r\n      FourierConjugation.pointwise transverseGeometricJ (curriedRapidity f) := by\r\n  apply (Lp.fourierTransformₗᵢ ℝ TransverseFiber).injective\r\n  rw [FourierConjugation.fourier_pointwise transverseGeometricJ transverseGeometricJ_involutive]\r\n  change Phi (Jcandidate f) = Js (Phi f)\r\n  rw [Jcandidate_apply, LinearIsometryEquiv.apply_symm_apply]\r\n\r\ndef reflectTransverse (p : Transverse × ℝ) : Transverse × ℝ := (-p.1,p.2)\r\n\r\ntheorem reflectTransverse_preserves :\r\n    MeasurePreserving reflectTransverse momentumMeasure momentumMeasure := by\r\n  exact (Measure.measurePreserving_neg (volume : Measure Transverse)).prod\r\n    (MeasurePreserving.id (volume : Measure ℝ))\r\n\r\ndef productReflection : Lp Fib 2 momentumMeasure →ₗᵢ[ℂ] Lp Fib 2 momentumMeasure :=\r\n  Lp.compMeasurePreservingₗᵢ ℂ reflectTransverse reflectTransverse_preserves\r\n\r\ntheorem productReflection_ae (f : Lp Fib 2 momentumMeasure) :\r\n    productReflection f =ᵐ[momentumMeasure] fun p => f (-p.1,p.2) :=\r\n  Lp.coeFn_compMeasurePreserving f reflectTransverse_preserves\r\n\r\n/-- Explicit geometric action in rapidity coordinates; it is defined without using Jcandidate. -/\r\ndef productJ : Lp Fib 2 momentumMeasure →SL[starRingEnd ℂ] Lp Fib 2 momentumMeasure :=\r\n  (fiberSwappedJ.toContinuousLinearEquiv.toContinuousLinearMap.compLpL 2 momentumMeasure).comp\r\n    productReflection.toContinuousLinearMap\r\n\r\ntheorem productJ_ae (f : Lp Fib 2 momentumMeasure) :\r\n    productJ f =ᵐ[momentumMeasure] fun p => fiberSwappedJ (f (-p.1,p.2)) := by\r\n  have hp := fiberSwappedJ.toContinuousLinearEquiv.toContinuousLinearMap.coeFn_compLpL\r\n    (productReflection f)\r\n  filter_upwards [hp,productReflection_ae f] with p h1 h2\r\n  change (fiberSwappedJ.toContinuousLinearEquiv.toContinuousLinearMap.compLpL 2 momentumMeasure\r\n    (productReflection f)) p = _\r\n  rw [h1]\r\n  change fiberSwappedJ (productReflection f p) = _\r\n  rw [h2]\r\n\r\n/-- Fubini preserves the explicit transverse action, as equality of L² operators. -/\r\ntheorem canonicalFub_productJ (f : Lp Fib 2 momentumMeasure) :\r\n    canonicalFub (productJ f) =\r\n      FourierConjugation.pointwise transverseGeometricJ (canonicalFub f) := by\r\n  apply Lp.ext\r\n  filter_upwards [canonicalFub_sections (productJ f),\r\n    FourierConjugation.pointwise_ae transverseGeometricJ (canonicalFub f),\r\n    canonicalFub_sections f,\r\n    ae_ae_reverse (μ := (volume : Measure Transverse)) (ν := (volume : Measure ℝ))\r\n      (productJ_ae f)] with r hc hj hf hp\r\n  rw [hj]\r\n  apply Lp.ext\r\n  have hneg := (Measure.measurePreserving_neg (volume : Measure Transverse)).quasiMeasurePreserving.ae hf\r\n  filter_upwards [hc, hp, hneg, transverseGeometricJ_ae (canonicalFub f r)] with q h1 h2 h3 h4\r\n  rw [h1,h2,h4,h3]\r\n\r\n/-- The previously constructed spectral antiunitary equals the independently defined geometric action. -/\r\ntheorem Jcandidate_rapidity (f : H1) : toRapidity (Jcandidate f) = productJ (toRapidity f) := by\r\n  apply canonicalFub.injective\r\n  rw [canonicalFub_productJ]\r\n  exact Jcandidate_curried f\r\n\r\ndef geometricJ : H1 →SL[starRingEnd ℂ] H1 :=\r\n  toRapidity.symm.toContinuousLinearEquiv.toContinuousLinearMap.comp\r\n    (productJ.comp toRapidity.toContinuousLinearEquiv.toContinuousLinearMap)\r\n\r\ntheorem Jcandidate_eq_geometricJ (f : H1) : Jcandidate f = geometricJ f := by\r\n  apply toRapidity.injective\r\n  change toRapidity (Jcandidate f) = toRapidity (toRapidity.symm (productJ (toRapidity f)))\r\n  rw [LinearIsometryEquiv.apply_symm_apply]\r\n  exact Jcandidate_rapidity f\r\n\r\n/-- Full almost-everywhere formula on the product measure: r is unchanged. -/\r\ntheorem Jcandidate_rapidity_ae (f : H1) :\r\n    toRapidity (Jcandidate f) =ᵐ[momentumMeasure]\r\n      fun p => fiberSwappedJ (toRapidity f (-p.1,p.2)) := by\r\n  rw [Jcandidate_rapidity]\r\n  exact productJ_ae (toRapidity f)\r\n\r\ntheorem Jcandidate_rapidity_coordinates (f : H1) :\r\n    ∀ᵐ p ∂momentumMeasure, ∀ i : Fin 2,\r\n      toRapidity (Jcandidate f) p i = star (toRapidity f (-p.1,p.2) (helicitySwap i)) := by\r\n  filter_upwards [Jcandidate_rapidity_ae f] with p hp\r\n  intro i\r\n  rw [hp,fiberSwappedJ_apply]\r\n\r\n#print axioms Jcandidate_curried\r\n#print axioms canonicalFub_productJ\r\n#print axioms Jcandidate_rapidity\r\n#print axioms Jcandidate_eq_geometricJ\r\n#print axioms Jcandidate_rapidity_coordinates\r\nend F1Rede.GeometricIdentification\r\n',
+    'TGLExt/F1Fecho394/GlobalMaxwellSegalR1.lean': "import TGLExt.F1Fecho394.RealSchwartzTestsR1\r\nimport TGLExt.F1Fecho394.SchwartzMaxwellNonzeroR6\r\nimport TGLExt.F1Fecho394.CanonicalSegalEssentialR6\r\n\r\n/-! A real spacetime Schwartz test is mapped into the same H1 and then into\r\nan essentially self-adjoint Segal operator on the same Fock. A real test has\r\nnonzero vacuum excitation. Neither wedge localization nor Maxwell stress is\r\nassumed or concluded; the Segal assignment is not complex-linear in its label. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1800000\r\nnoncomputable section\r\nnamespace F1Fecho.MaxwellGlobal\r\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.Annihilation F1Fecho.Creation\r\n\r\nabbrev RealTest := {f : SchwartzTensor // IsRealTest f}\r\n\r\ntheorem exists_nonzero_real_spacetimeSmear :\r\n    ∃ f : RealTest,spacetimeSmear f.val≠0 := by\r\n  obtain ⟨f,hf⟩ := exists_nonzero_spacetimeSmear\r\n  by_cases hr : spacetimeSmear (realPart f)=0\r\n  · refine ⟨⟨imagPart f,imagPart_real f⟩,?_⟩\r\n    intro hi\r\n    apply hf\r\n    have hd:=congrArg spacetimeSmearLinear (real_imag_decomposition f)\r\n    change spacetimeSmear f=spacetimeSmearLinear (realPart f+Complex.I•imagPart f) at hd\r\n    rw [map_add,map_smul] at hd\r\n    change spacetimeSmear f=spacetimeSmear (realPart f)+Complex.I•spacetimeSmear (imagPart f) at hd\r\n    simpa only [hr,hi,smul_zero,add_zero] using hd\r\n  · exact ⟨⟨realPart f,realPart_real f⟩,hr⟩\r\n\r\ndef field (f : RealTest) : F →ₗ.[ℂ] F := segal (spacetimeSmear f.val)\r\n\r\ntheorem field_essentially_selfadjoint (f : RealTest) :\r\n    IsSelfAdjoint (field f).closure := segal_essentially_selfadjoint _\r\n\r\ntheorem field_has_exponential_core (f : RealTest) :\r\n    (field f).closure.HasCore domain := segal_closure_has_exponential_core _\r\n\r\ntheorem field_vacuum (f : RealTest) :\r\n    field f ⟨vacuum,vacuum_mem_domain⟩ =\r\n      ((Real.sqrt 2)⁻¹ : ℂ) • oneParticle (spacetimeSmear f.val) := segal_vacuum _\r\n\r\ntheorem exists_nonzero_real_field_vacuum : ∃ f : RealTest,\r\n    field f ⟨vacuum,vacuum_mem_domain⟩≠0 := by\r\n  obtain ⟨f,hf⟩ := exists_nonzero_real_spacetimeSmear\r\n  refine ⟨f,?_⟩\r\n  rw [field_vacuum]\r\n  apply smul_ne_zero\r\n  · exact inv_ne_zero (Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (by norm_num)))\r\n  · intro hz\r\n    apply hf\r\n    apply oneParticle.injective\r\n    simpa using hz\r\n\r\nend F1Fecho.MaxwellGlobal\r\n#print axioms F1Fecho.MaxwellGlobal.exists_nonzero_real_spacetimeSmear\r\n#print axioms F1Fecho.MaxwellGlobal.field_essentially_selfadjoint\r\n#print axioms F1Fecho.MaxwellGlobal.field_has_exponential_core\r\n#print axioms F1Fecho.MaxwellGlobal.field_vacuum\r\n#print axioms F1Fecho.MaxwellGlobal.exists_nonzero_real_field_vacuum\r\n",
+    'TGLExt/F1Fecho394/GroupAverageApproximationR2.lean': 'import TGLExt.F1Fecho394.ClosedGraphRegularizationR3\r\nimport Mathlib.MeasureTheory.Integral.DominatedConvergence\r\n\r\n/-! Strong approximation to the identity by actual group averages.\r\nThe same real kernel can be used on a real closed Tomita graph. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nopen MeasureTheory Filter\r\nopen scoped Topology\r\nnamespace F1Fecho.GroupAverageApproximation\r\nvariable {H:Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem averages_tendsto_identity (U:ℝ→H≃ₗᵢ[ℂ]H)\r\n    (hc:∀x,Continuous (fun t=>U t x)) (h0:∀x,U 0 x=x)\r\n    (w:ℝ→ℝ) (hw:Integrable w volume) (hw1:∫t:ℝ,w t=1)\r\n    (e:ℕ→ℝ) (he:Tendsto e atTop (𝓝 0)) (x:H) :\r\n    Tendsto (fun n=>∫t:ℝ,w t • U (e n*t) x) atTop (𝓝 x) := by\r\n  have hm:∀n,AEStronglyMeasurable (fun t:ℝ=>w t • U (e n*t) x) volume := by\r\n    intro n\r\n    exact hw.aestronglyMeasurable.smul ((hc x).comp (continuous_const.mul continuous_id)).aestronglyMeasurable\r\n  have hb:∀n,∀ᵐ t:ℝ ∂volume,‖w t • U (e n*t) x‖≤‖w t‖*‖x‖ := by\r\n    intro n\r\n    apply ae_of_all\r\n    intro t\r\n    rw [norm_smul,(U _).norm_map]\r\n  have hl:∀ᵐ t:ℝ ∂volume,Tendsto (fun n=>w t • U (e n*t) x) atTop (𝓝 (w t • x)) := by\r\n    apply ae_of_all\r\n    intro t\r\n    have ht:Tendsto (fun n=>e n*t) atTop (𝓝 (0:ℝ)) := by simpa using he.mul_const t\r\n    have hu:=((hc x).continuousAt.tendsto.comp ht).const_smul (w t)\r\n    simpa only [h0,Function.comp_apply] using hu\r\n  have h:=tendsto_integral_of_dominated_convergence (fun t:ℝ=>‖w t‖*‖x‖)\r\n    hm (hw.norm.mul_const ‖x‖) hb hl\r\n  simpa only [integral_smul_const,hw1,one_smul] using h\r\n\r\ntheorem scaled_average_preserves_graph (G:Submodule ℝ (WithLp 2 (H×H)))\r\n    (hG:IsClosed (G:Set (WithLp 2 (H×H))))\r\n    (U:ℝ→H≃ₗᵢ[ℂ]H) (hc:∀x,Continuous (fun t=>U t x))\r\n    (hU:∀t x y,WithLp.toLp 2 (x,y)∈G→WithLp.toLp 2 (U t x,U t y)∈G)\r\n    (w:ℝ→ℝ) (hw:Integrable w volume) (c:ℝ) (x y:H)\r\n    (hxy:WithLp.toLp 2 (x,y)∈G) :\r\n    WithLp.toLp 2 ((∫t,w t • U (c*t) x),(∫t,w t • U (c*t) y))∈G := by\r\n  exact ClosedGraphRegularization.average_preserves_graph G hG (fun t=>U (c*t))\r\n    (fun x=>(hc x).comp (continuous_const.mul continuous_id))\r\n    (fun t=>hU (c*t)) w hw x y hxy\r\n\r\nend F1Fecho.GroupAverageApproximation\r\n#print axioms F1Fecho.GroupAverageApproximation.averages_tendsto_identity\r\n#print axioms F1Fecho.GroupAverageApproximation.scaled_average_preserves_graph\r\n',
+    'TGLExt/F1Fecho394/HalfPlaneBoundaryUniquenessR4.lean': 'import Mathlib.Analysis.Complex.RealDeriv\r\nimport Mathlib.Analysis.Complex.Convex\r\nimport Mathlib.Analysis.Analytic.IsolatedZeros\r\nimport Mathlib.Analysis.Complex.CauchyIntegral\r\n\r\n/-! Boundary uniqueness after unilateral regularization. The regularity on\r\nthe closed half-plane is explicit; this lemma alone does not regularize a\r\npositive-energy coefficient or assert density of any localized net. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nopen Set Filter Complex\r\nopen scoped Topology\r\nnamespace F1Fecho.HalfPlaneBoundary\r\n\r\ndef upper : Set ℂ := {z | 0 ≤ z.im}\r\ndef interiorUpper : Set ℂ := {z | 0 < z.im}\r\ndef right : Set ℂ := {z | 0 < z.re}\r\n\r\ntheorem boundary_derivative_zero (f : ℂ → ℂ) (x : ℝ) (hx : 0 < x)\r\n    (d : ℂ) (hd : HasDerivWithinAt f d upper (x : ℂ))\r\n    (hz : ∀ t : ℝ, 0 < t → f t = 0) : d = 0 := by\r\n  have hreal : HasDerivAt (fun t : ℝ => f (t : ℂ)) d x := by\r\n    simpa only [Function.comp_apply, ofRealCLM_apply, ofReal_one, mul_one] using!\r\n      hd.comp_hasDerivAt x ofRealCLM.hasDerivAt\r\n        (Filter.Eventually.of_forall (fun t : ℝ => by simp [upper]))\r\n  have heq : (fun t : ℝ => f (t : ℂ)) =ᶠ[𝓝 x] fun _ => 0 := by\r\n    filter_upwards [Ioi_mem_nhds hx] with t ht\r\n    exact hz t ht\r\n  exact hreal.unique ((hasDerivAt_const x (0 : ℂ)).congr_of_eventuallyEq heq)\r\n\r\ndef zeroExtension (f : ℂ → ℂ) (z : ℂ) : ℂ := if 0 ≤ z.im then f z else 0\r\n\r\ntheorem zeroExtension_differentiable (f : ℂ → ℂ)\r\n    (hd : ∀ z ∈ upper, ∃ d, HasDerivWithinAt f d upper z)\r\n    (hz : ∀ t : ℝ, 0 < t → f t = 0) :\r\n    DifferentiableOn ℂ (zeroExtension f) right := by\r\n  intro z hzr\r\n  by_cases hp : 0 < z.im\r\n  · obtain ⟨d,hd⟩ := hd z hp.le\r\n    have hn : upper ∈ 𝓝 z := mem_of_superset\r\n      ((isOpen_lt continuous_const continuous_im).mem_nhds hp) (fun w h => (show 0 ≤ w.im from le_of_lt h))\r\n    have he : zeroExtension f =ᶠ[𝓝 z] f := by\r\n      filter_upwards [hn] with w hw\r\n      exact if_pos (show 0 ≤ w.im from hw)\r\n    exact ((hd.hasDerivAt hn).congr_of_eventuallyEq he).differentiableAt.differentiableWithinAt\r\n  · by_cases hn : z.im < 0\r\n    · have he : zeroExtension f =ᶠ[𝓝 z] fun _ => 0 := by\r\n        filter_upwards [(isOpen_lt continuous_im continuous_const).mem_nhds hn] with w hw\r\n        simp only [zeroExtension,if_neg (not_le_of_gt hw)]\r\n      exact ((hasDerivAt_const z (0 : ℂ)).congr_of_eventuallyEq he).differentiableAt.differentiableWithinAt\r\n    · have hi : z.im = 0 := le_antisymm (le_of_not_gt hp) (le_of_not_gt hn)\r\n      have hzre : (z.re : ℂ) = z := by apply Complex.ext <;> simp [hi]\r\n      obtain ⟨d,hdf⟩ := hd z (by simp [upper,hi])\r\n      have hd0 : d=0 := boundary_derivative_zero f z.re hzr d (hzre.symm ▸ hdf) hz\r\n      subst d\r\n      have hU : HasDerivWithinAt (zeroExtension f) 0 upper z := by\r\n        apply hdf.congr\r\n        · intro w hw\r\n          exact if_pos hw\r\n        · exact if_pos (by simp [hi])\r\n      have hL : HasDerivWithinAt (zeroExtension f) 0 {w : ℂ | w.im ≤ 0 ∧ 0 < w.re} z := by\r\n        apply (hasDerivWithinAt_const z {w : ℂ | w.im ≤ 0 ∧ 0 < w.re} (0 : ℂ)).congr\r\n        · intro w hw\r\n          by_cases he : 0 ≤ w.im\r\n          · have hwi : w.im=0 := le_antisymm hw.1 he\r\n            have hwr : (w.re : ℂ)=w := by apply Complex.ext <;> simp [hwi]\r\n            simp only [zeroExtension,if_pos he]\r\n            rw [←hwr]\r\n            exact hz _ hw.2\r\n          · exact if_neg he\r\n        · change (if 0 ≤ z.im then f z else 0)=0\r\n          rw [if_pos (by simp [hi]),←hzre]\r\n          exact hz _ hzr\r\n      have hu : upper ∪ {w : ℂ | w.im ≤ 0 ∧ 0 < w.re} ∈ 𝓝 z := by\r\n        apply mem_of_superset ((isOpen_lt continuous_const continuous_re).mem_nhds hzr)\r\n        intro w hw\r\n        rcases le_total 0 w.im with hi | hi\r\n        · exact Or.inl hi\r\n        · exact Or.inr ⟨hi,hw⟩\r\n      exact ((hU.union hL).hasDerivAt hu).differentiableAt.differentiableWithinAt\r\n\r\ntheorem eq_zero_on_upper (f : ℂ → ℂ)\r\n    (hd : ∀ z ∈ upper, ∃ d, HasDerivWithinAt f d upper z)\r\n    (hz : ∀ t : ℝ, 0 < t → f t = 0) :\r\n    ∀ z ∈ interiorUpper, f z = 0 := by\r\n  have hg := (zeroExtension_differentiable f hd hz).analyticOnNhd\r\n    (isOpen_lt continuous_const continuous_re)\r\n  have hge : zeroExtension f =ᶠ[𝓝 (1-Complex.I)] 0 := by\r\n    filter_upwards [(isOpen_lt continuous_im continuous_const).mem_nhds\r\n      (show (1-Complex.I).im < 0 by simp)] with z hz\r\n    exact if_neg (not_le_of_gt hz)\r\n  have hg0 := hg.eqOn_zero_of_preconnected_of_eventuallyEq_zero\r\n    (convex_halfSpace_re_gt 0).isPreconnected\r\n    (show 1-Complex.I ∈ right by simp [right]) hge\r\n  have hfd : DifferentiableOn ℂ f interiorUpper := by\r\n    intro z hz\r\n    obtain ⟨d,h⟩ := hd z (show 0≤z.im from le_of_lt hz)\r\n    exact ((h.hasDerivAt (mem_of_superset\r\n      ((isOpen_lt continuous_const continuous_im).mem_nhds (show 0<z.im from hz))\r\n      (fun w h => (show 0 ≤ w.im from le_of_lt h)))).differentiableAt).differentiableWithinAt\r\n  have hf := hfd.analyticOnNhd (isOpen_lt continuous_const continuous_im)\r\n  have he : f =ᶠ[𝓝 (1+Complex.I)] 0 := by\r\n    filter_upwards [(isOpen_lt continuous_const continuous_re).mem_nhds\r\n      (show 0<(1+Complex.I).re by simp),\r\n      (isOpen_lt continuous_const continuous_im).mem_nhds\r\n      (show 0<(1+Complex.I).im by simp)] with z hr hi\r\n    simpa only [zeroExtension,if_pos hi.le] using hg0 hr\r\n  exact hf.eqOn_zero_of_preconnected_of_eventuallyEq_zero\r\n    (convex_halfSpace_im_gt 0).isPreconnected\r\n    (show 1+Complex.I ∈ interiorUpper by simp [interiorUpper]) he\r\n\r\nend F1Fecho.HalfPlaneBoundary\r\n#print axioms F1Fecho.HalfPlaneBoundary.boundary_derivative_zero\r\n#print axioms F1Fecho.HalfPlaneBoundary.zeroExtension_differentiable\r\n#print axioms F1Fecho.HalfPlaneBoundary.eq_zero_on_