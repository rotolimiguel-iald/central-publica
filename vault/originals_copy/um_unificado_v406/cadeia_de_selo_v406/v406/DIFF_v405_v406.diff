+    'TGLExt/F1Fecho394/RegularSpectralAverageR6.lean': 'import TGLExt.F1Fecho394.RegularNormalizedFourierR2\r\nimport TGLExt.F1Fecho394.RegularCoreFiniteWeightR3\r\n/-! Exact coefficient formula for finite regular averages. This discharges the\r\nHaar normalization by the existing vector-valued L1/L2 Fourier theorem. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularSpectralAverage\r\nopen MeasureTheory Filter TGLV350.Regular\r\nopen scoped FourierTransform\r\nopen F1Fecho.RegularNormalizedFourier F1Fecho.RegularCovariantCore\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem normalizedFourier_toLp_ae (f : ℝ → H) (hf1 : Integrable f) (hf2 : MemLp f 2) :\r\n    normalizedFourier (hf2.toLp f) =ᵐ[volume] fun s : ℝ =>\r\n      ((Real.sqrt (2*Real.pi))⁻¹ : ℝ) • (𝓕 f) (s/(2*Real.pi)) := by\r\n  filter_upwards [normalizedFourier_ae (hf2.toLp f),\r\n    (RegularL2Rescale.div_qmp (2*Real.pi) (by positivity)).ae\r\n      (TGLV350.Fourier.fourier_integral_ae_eq_L2 f hf1 hf2)] with s hs ht\r\n  exact hs.trans (congrArg (fun v : H => ((Real.sqrt (2*Real.pi))⁻¹ : ℝ) • v) ht.symm)\r\n\r\ndef coefficientMemLp (h : ℝ) (Ω : H) :\r\n    MemLp ((Set.Ioc 0 h).indicator (fun _ : ℝ => Ω)) 2 volume :=\r\n  memLp_indicator_const 2 measurableSet_Ioc Ω (Or.inr (by simp [Real.volume_Ioc]))\r\n\r\ndef coefficient (h : ℝ) (Ω : H) : RegularHilbert H :=\r\n  (coefficientMemLp h Ω).toLp ((Set.Ioc 0 h).indicator (fun _ : ℝ => Ω))\r\n\r\ntheorem coefficient_ae (h : ℝ) (Ω : H) :\r\n    coefficient h Ω =ᵐ[volume] (Set.Ioc 0 h).indicator (fun _ : ℝ => Ω) :=\r\n  (coefficientMemLp h Ω).coeFn_toLp\r\n\r\ntheorem regularUnitary_testVector (B : UnitaryFlow H) (Ω : H)\r\n    (hΩ : ∀ t, B.U t Ω=Ω) (t : ℝ) :\r\n    F1Fecho.RegularCovariantCore.regularUnitary B t (testVector Ω) = shift t (testVector Ω) := by\r\n  change fibre (boostCLM B t) (shift t (testVector Ω)) = _\r\n  rw [← ContinuousLinearMap.mul_apply,←shift_commutes_fibre,ContinuousLinearMap.mul_apply,\r\n    fibre_testVector]\r\n  change shift t (testVector (B.U t Ω)) = _\r\n  rw [hΩ]\r\n\r\ntheorem code_coefficient (B : UnitaryFlow H) (Ω : H)\r\n    (hΩ : ∀ t, B.U t Ω=Ω) (h : ℝ) :\r\n    RegularSpectralCode.code (coefficient h Ω) =\r\n      (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector Ω) 2).toLp\r\n        (RegularCoreFiniteWeight.regularOrbitCut B h (testVector Ω)) := by\r\n  apply Lp.ext\r\n  filter_upwards [RegularSpectralCode.code_ae (coefficient h Ω),coefficient_ae h Ω,\r\n    (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector Ω) 2).coeFn_toLp] with a h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  by_cases ha : a ∈ Set.Ioc 0 h\r\n  · simp only [Set.indicator_of_mem ha,RegularCoreFiniteWeight.regularOrbitCut]\r\n    exact (regularUnitary_testVector B Ω hΩ a).symm\r\n  · simp only [RegularCoreFiniteWeight.regularOrbitCut,Set.indicator_of_notMem ha,Pi.zero_apply]\r\n    have hz : testVector (0 : H) = 0 := by\r\n      apply norm_eq_zero.mp\r\n      rw [testVector_norm,norm_zero]\r\n    rw [hz,map_zero]\r\n\r\ntheorem spectralCode_average_ae (B : UnitaryFlow H) (Ω : H)\r\n    (hΩ : ∀ t, B.U t Ω=Ω) (h : ℝ) (hh : 0<h) :\r\n    spectralCode ((h⁻¹ : ℝ) • coefficient h Ω) =ᵐ[volume] fun s : ℝ =>\r\n      (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s (RegularCoreAverage.regularAverage B h)\r\n        (testVector Ω) := by\r\n  have hs : Real.sqrt dualHaarFactor = (Real.sqrt (2*Real.pi))⁻¹ := by\r\n    unfold dualHaarFactor\r\n    rw [Real.sqrt_inv]\r\n  have hmap : spectralCode ((h⁻¹ : ℝ) • coefficient h Ω) =\r\n      (h⁻¹ : ℝ) • normalizedFourier (RegularSpectralCode.code (coefficient h Ω)) :=\r\n    spectralCode.map_smul_of_tower (h⁻¹ : ℝ) _\r\n  rw [hmap,code_coefficient B Ω hΩ]\r\n  filter_upwards [Lp.coeFn_smul (h⁻¹ : ℝ)\r\n    (normalizedFourier ((RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector Ω) 2).toLp\r\n      (RegularCoreFiniteWeight.regularOrbitCut B h (testVector Ω)))),\r\n    normalizedFourier_toLp_ae (RegularCoreFiniteWeight.regularOrbitCut B h (testVector Ω))\r\n      (RegularCoreFiniteWeight.regularOrbitCut_integrable B h (testVector Ω))\r\n      (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector Ω) 2)] with s h1 h2\r\n  simp only [Pi.smul_apply] at h1\r\n  rw [h1,h2,RegularCoreFiniteWeight.regularAverage_dual_fourier B s h hh,hs]\r\n  have hc (a b : ℝ) (v : RegularHilbert H) : a • b • v = b • a • v := by\r\n    rw [smul_smul,smul_smul,mul_comm]\r\n  exact hc h⁻¹ ((Real.sqrt (2*Real.pi))⁻¹) _\r\n\r\nend F1Fecho.RegularSpectralAverage\r\n#print axioms F1Fecho.RegularSpectralAverage.normalizedFourier_toLp_ae\r\n#print axioms F1Fecho.RegularSpectralAverage.coefficient_ae\r\n#print axioms F1Fecho.RegularSpectralAverage.regularUnitary_testVector\r\n#print axioms F1Fecho.RegularSpectralAverage.code_coefficient\r\n#print axioms F1Fecho.RegularSpectralAverage.spectralCode_average_ae\r\n',
+    'TGLExt/F1Fecho394/RegularSpectralBoostedAverageR2.lean': 'import TGLExt.F1Fecho394.RegularSpectralAverageR6\r\nimport TGLExt.F1Fecho394.CoefficientBoostR1\r\n/-! The Fourier coefficient of a regular average on an arbitrary base vector.\r\nThe boost is retained pointwise; invariance of that vector is not assumed. -/\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1200000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularSpectralBoostedAverage\r\nopen MeasureTheory TGLV350.Regular\r\nopen F1Fecho.RegularCovariantCore F1Fecho.RegularNormalizedFourier\r\nopen F1Fecho.RegularSpectralAverage\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ndef boostedCoefficient (B : UnitaryFlow H) (h : ℝ) (v : H) : RegularHilbert H :=\r\n  CoefficientBoost.unitary B 1 (coefficient h v)\r\n\r\ntheorem boostedCoefficient_ae (B : UnitaryFlow H) (h : ℝ) (v : H) :\r\n    boostedCoefficient B h v =ᵐ[volume] fun t =>\r\n      (Set.Ioc 0 h).indicator (fun t => B.U t v) t := by\r\n  filter_upwards [CoefficientBoost.unitary_ae B 1 (coefficient h v),\r\n    coefficient_ae h v] with t ht hv\r\n  change CoefficientBoost.unitary B 1 (coefficient h v) t = _\r\n  rw [ht,hv,one_mul]\r\n  by_cases hmem : t∈Set.Ioc 0 h\r\n  · simp only [Set.indicator_of_mem hmem]\r\n  · simp only [Set.indicator_of_notMem hmem,map_zero]\r\n\r\ntheorem regularUnitary_testVector (B : UnitaryFlow H) (v : H) (t : ℝ) :\r\n    F1Fecho.RegularCovariantCore.regularUnitary B t (testVector v) =\r\n      shift t (testVector (B.U t v)) := by\r\n  change fibre (boostCLM B t) (shift t (testVector v)) = _\r\n  rw [←ContinuousLinearMap.mul_apply,←shift_commutes_fibre,\r\n    ContinuousLinearMap.mul_apply,fibre_testVector]\r\n  rfl\r\n\r\ntheorem code_boostedCoefficient (B : UnitaryFlow H) (h : ℝ) (v : H) :\r\n    RegularSpectralCode.code (boostedCoefficient B h v) =\r\n      (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector v) 2).toLp\r\n        (RegularCoreFiniteWeight.regularOrbitCut B h (testVector v)) := by\r\n  apply Lp.ext\r\n  filter_upwards [RegularSpectralCode.code_ae (boostedCoefficient B h v),\r\n    boostedCoefficient_ae B h v,\r\n    (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector v) 2).coeFn_toLp]\r\n    with t h1 h2 h3\r\n  rw [h1,h2,h3]\r\n  by_cases ht : t∈Set.Ioc 0 h\r\n  · simp only [Set.indicator_of_mem ht,RegularCoreFiniteWeight.regularOrbitCut]\r\n    exact (regularUnitary_testVector B v t).symm\r\n  · simp only [RegularCoreFiniteWeight.regularOrbitCut,Set.indicator_of_notMem ht,\r\n      Pi.zero_apply]\r\n    have hz : testVector (0 : H)=0 := by\r\n      apply norm_eq_zero.mp\r\n      rw [testVector_norm,norm_zero]\r\n    rw [hz,map_zero]\r\n\r\ntheorem spectralCode_boostedAverage_ae (B : UnitaryFlow H) (v : H)\r\n    (h : ℝ) (hh : 0<h) :\r\n    spectralCode ((h⁻¹ : ℝ) • boostedCoefficient B h v) =ᵐ[volume] fun s : ℝ =>\r\n      (Real.sqrt dualHaarFactor : ℝ) • dualAmbient s\r\n        (RegularCoreAverage.regularAverage B h) (testVector v) := by\r\n  have hs : Real.sqrt dualHaarFactor = (Real.sqrt (2*Real.pi))⁻¹ := by\r\n    unfold dualHaarFactor\r\n    rw [Real.sqrt_inv]\r\n  have hmap : spectralCode ((h⁻¹ : ℝ) • boostedCoefficient B h v) =\r\n      (h⁻¹ : ℝ) • normalizedFourier\r\n        (RegularSpectralCode.code (boostedCoefficient B h v)) :=\r\n    spectralCode.map_smul_of_tower (h⁻¹ : ℝ) _\r\n  rw [hmap,code_boostedCoefficient]\r\n  filter_upwards [Lp.coeFn_smul (h⁻¹ : ℝ)\r\n    (normalizedFourier ((RegularCoreFiniteWeight.regularOrbitCut_memLp B h\r\n      (testVector v) 2).toLp (RegularCoreFiniteWeight.regularOrbitCut B h (testVector v)))),\r\n    normalizedFourier_toLp_ae (RegularCoreFiniteWeight.regularOrbitCut B h (testVector v))\r\n      (RegularCoreFiniteWeight.regularOrbitCut_integrable B h (testVector v))\r\n      (RegularCoreFiniteWeight.regularOrbitCut_memLp B h (testVector v) 2)] with s h1 h2\r\n  simp only [Pi.smul_apply] at h1\r\n  rw [h1,h2,RegularCoreFiniteWeight.regularAverage_dual_fourier B s h hh,hs]\r\n  have hc (a b : ℝ) (v : RegularHilbert H) : a • b • v = b • a • v := by\r\n    rw [smul_smul,smul_smul,mul_comm]\r\n  exact hc h⁻¹ ((Real.sqrt (2*Real.pi))⁻¹) _\r\nend F1Fecho.RegularSpectralBoostedAverage\r\n#print axioms F1Fecho.RegularSpectralBoostedAverage.boostedCoefficient_ae\r\n#print axioms F1Fecho.RegularSpectralBoostedAverage.regularUnitary_testVector\r\n#print axioms F1Fecho.RegularSpectralBoostedAverage.code_boostedCoefficient\r\n#print axioms F1Fecho.RegularSpectralBoostedAverage.spectralCode_boostedAverage_ae\r\n',
+    'TGLExt/F1Fecho394/RegularSpectralCodeR2.lean': "import TGLExt.V350UnitIntervalShiftProjection\r\nimport TGLExt.V350StrongOperatorField\r\n/-! Concrete norm-preserving regular spectral code. The range is not yet\r\nidentified with the weight GNS completion, and no modular identification is assumed. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 900000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularSpectralCode\r\nopen TGLV350.Regular MeasureTheory Filter\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ndef testLp : RegularHilbert H →L[ℂ] RegularHilbert (RegularHilbert H) :=\r\n  (testEmbeddingCLM (H := H)).compLpL 2 volume\r\n\r\ntheorem testLp_ae (f : RegularHilbert H) :\r\n    testLp f =ᵐ[volume] fun a : ℝ => testVector (f a) :=\r\n  (testEmbeddingCLM (H := H)).coeFn_compLpL f\r\n\r\ntheorem testLp_norm (f : RegularHilbert H) : ‖testLp f‖ = ‖f‖ := by\r\n  rw [Lp.norm_def,Lp.norm_def]\r\n  congr 1\r\n  apply eLpNorm_congr_norm_ae\r\n  filter_upwards [testLp_ae f] with a ha\r\n  rw [ha,testVector_norm]\r\n\r\ndef code : RegularHilbert H →L[ℂ] RegularHilbert (RegularHilbert H) :=\r\n  (operatorFieldLift (shiftIntegralFamily (H := H))).comp testLp\r\n\r\ntheorem code_ae (f : RegularHilbert H) :\r\n    code f =ᵐ[volume] fun a : ℝ => shift a (testVector (f a)) := by\r\n  filter_upwards [operatorFieldLift_ae (shiftIntegralFamily (H := H)) (testLp f),\r\n    testLp_ae f] with a ha hb\r\n  change operatorFieldLift (shiftIntegralFamily (H := H)) (testLp f) a = _\r\n  rw [ha,hb]\r\n  rfl\r\n\r\ntheorem code_norm (f : RegularHilbert H) : ‖code f‖ = ‖f‖ := by\r\n  rw [Lp.norm_def,Lp.norm_def]\r\n  congr 1\r\n  apply eLpNorm_congr_norm_ae\r\n  filter_upwards [code_ae f] with a ha\r\n  rw [ha,shift_norm,testVector_norm]\r\n\r\ndef codeIsometry : RegularHilbert H →ₗᵢ[ℂ] RegularHilbert (RegularHilbert H) where\r\n  toLinearMap := code.toLinearMap\r\n  norm_map' := code_norm\r\n\r\ntheorem code_injective : Function.Injective (code (H := H)) :=\r\n  codeIsometry.injective\r\n\r\ntheorem code_fibre (C : H →L[ℂ] H) (f : RegularHilbert H) :\r\n    code (fibre C f) = fibre (fibre C) (code f) := by\r\n  apply Lp.ext\r\n  filter_upwards [code_ae (fibre C f),fibre_ae C f,\r\n    fibre_ae (fibre C) (code f),code_ae f] with a ha hb hc hd\r\n  rw [ha,hb,hc,hd,← fibre_testVector]\r\n  exact congrArg (fun T : RegularHilbert H →L[ℂ] RegularHilbert H => T (testVector (f a)))\r\n    (shift_commutes_fibre a C)\r\n\r\nend F1Fecho.RegularSpectralCode\r\n#print axioms F1Fecho.RegularSpectralCode.testLp_ae\r\n#print axioms F1Fecho.RegularSpectralCode.testLp_norm\r\n#print axioms F1Fecho.RegularSpectralCode.code_ae\r\n#print axioms F1Fecho.RegularSpectralCode.code_norm\r\n#print axioms F1Fecho.RegularSpectralCode.codeIsometry\r\n#print axioms F1Fecho.RegularSpectralCode.code_injective\r\n#print axioms F1Fecho.RegularSpectralCode.code_fibre\r\n",
+    'TGLExt/F1Fecho394/RegularSpectralCoreRangeR3.lean': 'import TGLExt.F1Fecho394.RegularSpectralTranslationR2\r\nimport TGLExt.F1Fecho394.RegularDualOrbitGeneratedR2\r\nimport TGLExt.F1Fecho394.IsometricReducingRangeR1\r\nimport TGLExt.F1Fecho394.RegularCovariantCoreR3\r\nimport TGLExt.F1Fecho394.RegularRightOrbitPointwiseR1\r\n/-! The actual spectral-code range is reducing for the complete represented\r\nregular core, using star-bicommutant transport rather than an assumed density result. -/\r\nset_option autoImplicit false\r\nset_option maxErrors 3\r\nset_option maxHeartbeats 1000000\r\nnoncomputable section\r\nnamespace F1Fecho.RegularSpectralCoreRange\r\nopen TGLV350.Regular F1Fecho.RegularNormalizedFourier\r\nopen F1Fecho.RegularCovariantCore F1Fecho.RegularSpectralTranslation\r\nvariable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]\r\n\r\ntheorem dualOrbit_fibre (A : H →L[ℂ] H) :\r\n    dualOrbitRepresentation (fibre A)=fibre (fibre A) :=\r\n  operatorFieldLift_constant (dualIntegralFamily (fibre A)) (fibre A)\r\n    (fun s => dualAmbient_fibre s A)\r\n\r\ntheorem dualOrbit_regular (B : UnitaryFlow H) (t : ℝ) :\r\n    dualOrbitRepresentation (regularUnitary B t) =\r\n      characterMultiplier t * fibre (regularUnitary B t) := by\r\n  ext1 f\r\n  apply MeasureTheory.Lp.ext\r\n  filter_upwards [operatorFieldLift_ae (dualIntegralFamily (regularUnitary B t)) f,\r\n    characterMultiplier_ae t (fibre (regularUnitary B t) f),fibre_ae (regularUnitary B t) f]\r\n    with s h1 h2 h3\r\n  change operatorFieldLift (dualIntegralFamily (regularUnitary B t)) f s =\r\n    characterMultiplier t (fibre (regularUnitary B t) f) s\r\n  rw [h1,h2,h3]\r\n  change dualAmbient s (regularUnitary B t) (f s) = characterPhase t s • regularUnitary B t (f s)\r\n  rw [dual_on_regular]\r\n  rw [RegularRightAction.phase_symmetric s t]\r\n  rfl\r\n\r\ntheorem spectralCode_regular (B : UnitaryFlow H) (t : ℝ) (f : RegularHilbert H) :\r\n    spectralCode (regularUnitary B t f) = dualOrbitRepresentation (regularUnitary B t) (spectralCode f) := by\r\n  change spectralCode (fibre (boostCLM B t) (shift t f)) = _\r\n  rw [spectralCode_fibre,spectralCode_shift,dualOrbit_regular]\r\n  change fibre (fibre (boostCLM B t))\r\n      (characterMultiplier t (fibre (shift t) (spectralCode f))) =\r\n    characterMultiplier t (fibre (fibre (boostCLM B t) * shift t) (spectralCode f))\r\n  rw [fibre_mul]\r\n  exact congrArg (fun T : RegularHilbert (RegularHilbert H) →L[ℂ]\r\n      RegularHilbert (RegularHilbert H) => T (fibre (shift t) (spectralCode f)))\r\n    (characterMultiplier_commutes_fibre t (fibre (boostCLM B t))).symm\r\n\r\ndef codeProjection : RegularHilbert (RegularHilbert H) →L[ℂ] RegularHilbert (RegularHilbert H) :=\r\n  IsometricReducingRange.projection spectralCode\r\n\r\ntheorem projection_commutes_fibre (A : H →L[ℂ] H) :\r\n    dualOrbitRepresentation (fibre A) * codeProjection =\r\n      codeProjection * dualOrbitRepresentation (fibre A) := by\r\n  apply IsometricReducingRange.projection_commutes spectralCode (fibre A)\r\n  · ext1 f\r\n    rw [dualOrbit_fibre]\r\n    exact (spectralCode_fibre A f).symm\r\n  · rw [←map_star,←fibre_star]\r\n    ext1 f\r\n    rw [dualOrbit_fibre]\r\n    exact (spectralCode_fibre (star A) f).symm\r\n\r\ntheorem projection_commutes_regular (B : UnitaryFlow H) (t : ℝ) :\r\n    dualOrbitRepresentation (regularUnitary B t) * codeProjection =\r\n      codeProjection * dualOrbitRepresentation (regularUnitary B t) := by\r\n  apply IsometricReducingRange.projection_commutes spectralCode (regularUnitary B t)\r\n  · ext1 f\r\n    exact (spectralCode_regular B t f).symm\r\n  · rw [←map_star,RegularCovariantCore.regular_star]\r\n    ext1 f\r\n    exact (spectralCode_regular B (-t) f).symm\r\n\r\ntheorem projection_commutes_core (B : UnitaryFlow H) (M : VonNeumannAlgebra H)\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A ∈ core B M) :\r\n    dualOrbitRepresentation A * codeProjection=codeProjection * dualOrbitRepresentation A := by\r\n  apply RegularDualOrbitGenerated.dualOrbit_commutes_of_generators (generators B M) codeProjection ?_ A hA\r\n  rw [StarSubalgebra.mem_centralizer_iff]\r\n  rintro _ ⟨a,ha,rfl⟩\r\n  have h : dualOrbitRepresentation a * codeProjection=codeProjection * dualOrbitRepresentation a := by\r\n    rcases ha with ⟨b,hb,rfl⟩ | ⟨t,rfl⟩\r\n    · exact projection_commutes_fibre b\r\n    · exact projection_commutes_regular B t\r\n  refine ⟨h,?_⟩\r\n  have hs := congrArg star h\r\n  simpa only [star_mul,codeProjection,IsometricReducingRange.projection_star] using hs.symm\r\n\r\ntheorem spectralCode_range_preserved (B : UnitaryFlow H) (M : VonNeumannAlgebra H)\r\n    (A : RegularHilbert H →L[ℂ] RegularHilbert H) (hA : A ∈ core B M) :\r\n    Set.MapsTo (dualOrbitRepresentation A) (Set.range (spectralCode (H:=H)))\r\n      (Set.range (spectralCode (H:=H))) := by\r\n  intro x hx\r\n  apply (IsometricReducingRange.mem_range_iff (spectralCode (H:=H)) _).mpr\r\n  have hh := congrArg (fun T : RegularHilbert (RegularHilbert H) →L[ℂ]\r\n    RegularHilbert (RegularHilbert H) => T x) (projection_commutes_core B M A hA)\r\n  change dualOrbitRepresentation A (codeProjection x)=codeProjection (dualOrbitRepresentation A x) at hh\r\n  have hp : codeProjection x=x :=\r\n    (IsometricReducingRange.mem_range_iff (spectralCode (H:=H)) x).mp hx\r\n  rw [hp] at hh\r\n  exact hh.symm\r\n\r\n\r\nend F1Fecho.RegularSpectralCoreRange\r\n#print axioms F1Fecho.RegularSpectralCoreRange.dualOrbit_fibre\r\n#print axioms F1Fecho.RegularSpectralCoreRange.dualOrbit_regular\r\n#print axioms F1Fecho.RegularSpectralCoreRange.spectralCode_regular\r\n#print axioms F1Fecho.RegularSpectralCoreRange.projection_commutes_fibre\r\n#print axioms F1Fecho.RegularSpectralCoreRange.projection_commutes_regular\r\n#print axioms F1Fecho.RegularSpectralCoreRange.projection_commutes_core\r\n#print axioms F1Fecho.RegularSpectralCoreRange.spectralCode_range_preserved\r\n',
