assaTensaoPura.Emprestimo\nopen ChatgptAudit.PolarPeriod016\nopen Filter Topology\nopen scoped Topology\n\n/-- a temperatura derivada do relogio do boost: `T = 1/P`. -/\nnoncomputable def temperatura (L : Emprestimo) : ℝ := 1 / L.period\n\n/-- no periodo fiel, `T = κ/2π` (`reciprocal_temperature`). -/\ntheorem temperatura_e_kappa_sobre_dois_pi (L : Emprestimo) : temperatura L = L.kappa / (2 * Real.pi) :=\n  reciprocal_temperature L.kappa_pos L.period_pos L.fiel\n\n/-- a temperatura derivada e positiva: o periodo fiel nao le o zero absoluto. -/\ntheorem o_zero_absoluto_nao_e_lido (L : Emprestimo) : 0 < temperatura L := by\n  unfold temperatura\n  have := L.period_pos\n  positivity\n\n/-- o calor da volta: o atrito constante `βg` lido como energia (ħ = k_B = 1) — leitura do operador [ONTO]. -/\nnoncomputable def calorDaVolta (L : Emprestimo) : ℝ := L.T.c.beta * L.g\n\n/-- a entropia da volta: `δS := δQ / T`. DEFINICAO com a forma de Clausius, nao teorema termodinamico. -/\nnoncomputable def entropiaDaVolta (L : Emprestimo) : ℝ := calorDaVolta L / temperatura L\n\n/-- `δS = δQ · P`: a entropia da volta e o calor vezes o periodo. -/\ntheorem entropia_e_calor_vezes_periodo (L : Emprestimo) : entropiaDaVolta L = calorDaVolta L * L.period := by\n  unfold entropiaDaVolta temperatura\n  rw [div_div_eq_mul_div, div_one]\n\n/-- `δS = 2π·δQ/κ`: a entropia da volta com a temperatura derivada escrita em `κ`. -/\ntheorem entropia_e_dois_pi_calor_sobre_kappa (L : Emprestimo) :\n    entropiaDaVolta L = 2 * Real.pi * calorDaVolta L / L.kappa := by\n  unfold entropiaDaVolta\n  rw [temperatura_e_kappa_sobre_dois_pi, div_div_eq_mul_div]\n  ring\n\n/-- ★ A PONTE: o que atravessa numa volta, `e^{−Pβg}`, e `e^{−βg/T}` com `T = 1/P`. Trivial por definicao (algebra do\nexpoente), dito; «peso de Boltzmann» e rotulo [ONTO]. -/\ntheorem o_atrito_lido_na_temperatura (L : Emprestimo) :\n    ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period = Real.exp (-(calorDaVolta L / temperatura L)) := by\n  unfold ThePsionAndTheViscosity.transmitted calorDaVolta temperatura\n  congr 1\n  rw [div_div_eq_mul_div, div_one]\n  ring\n\n/-- a parcela por volta e `1 − e^{−δS}`: a FORMA de Clausius, por definicao de `entropiaDaVolta`. -/\ntheorem a_parcela_e_um_menos_o_peso (L : Emprestimo) :\n    L.parcelaPorVolta = 1 - Real.exp (-(entropiaDaVolta L)) := by\n  show 1 - ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period = _\n  rw [o_atrito_lido_na_temperatura]\n  rfl\n\n/-- a parcela nunca excede a entropia de Clausius da volta (`parcela_le_beta` em forma de temperatura). -/\ntheorem a_parcela_nao_excede_a_entropia (L : Emprestimo) : L.parcelaPorVolta ≤ entropiaDaVolta L := by\n  rw [entropia_e_calor_vezes_periodo]\n  have h := L.parcela_le_beta\n  have e : calorDaVolta L * L.period = L.T.c.beta * (L.g * L.period) := by\n    unfold calorDaVolta\n    ring\n  rw [e]\n  exact h\n\n/-- o equilibrio das contas (operador): atravessado + cobrado = 1 em toda volta. Re-exportacao de\n`the_charge_is_continuous_both_sides` (trivial por definicao no kernel; o nome e a leitura). -/\ntheorem o_balanco_fecha_a_cada_volta (L : Emprestimo) :\n    ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period + L.parcelaPorVolta = 1 :=\n  the_charge_is_continuous_both_sides _ _ _\n\n/-- depois de `n` voltas resta a `n`-esima potencia do peso: o expoente decai linearmente nas voltas. -/\ntheorem o_expoente_decai_por_volta (L : Emprestimo) (n : ℕ) :\n    ThePsionAndTheViscosity.transmitted L.T.c.beta L.g (n * L.period) = (ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period) ^ n := by\n  unfold ThePsionAndTheViscosity.transmitted\n  rw [← Real.exp_nat_mul]\n  congr 1\n  ring\n\n/-- o peso de uma volta fica estritamente entre 0 e 1 (a cobranca nunca se completa, nunca e nula). -/\ntheorem o_peso_entre_zero_e_um (L : Emprestimo) :\n    0 < ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period ∧ ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period < 1 := by\n  have h := L.parcela_nunca_quita\n  have hq : L.parcelaPorVolta = 1 - ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period := rfl\n  rw [hq] at h\n  constructor <;> linarith [h.1, h.2]\n\n/-- ★ o Um se fractaliza: a soma das parcelas de todas as voltas, cada uma a mesma fracao do que restava, e 1. -/\ntheorem o_um_se_fractaliza (L : Emprestimo) :\n    ∑' n : ℕ, L.parcelaPorVolta * (ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period) ^ n = 1 := by\n  have h := o_peso_entre_zero_e_um L\n  rw [tsum_mul_left, tsum_geometric_of_lt_one h.1.le h.2]\n  have hq : L.parcelaPorVolta = 1 - ThePsionAndTheViscosity.transmitted L.T.c.beta L.g L.period := rfl\n  rw [hq]\n  exact mul_inv_cancel₀ (by linarith [h.2])\n\n/-- no limite do zero absoluto a parcela quitaria numa volta: `1 − e^{−q/T} → 1` quando `T → 0⁺`, para `q > 0`.\nCalculo sobre a funcao generica em `q`, nao sobre o modelo. O periodo fiel nao chega la (`o_zero_absoluto_nao_e_lido`,\n`parcela_nunca_quita`). -/\ntheorem no_zero_absoluto_a_parcela_quitaria (q : ℝ) (hq : 0 < q) :\n    Tendsto (fun T : ℝ => 1 - Real.exp (-(q / T))) (𝓝[>] (0 : ℝ)) (𝓝 1) := by\n  have hinv : Tendsto (fun T : ℝ => T⁻¹) (𝓝[>] (0 : ℝ)) atTop := tendsto_inv_nhdsGT_zero\n  have hmul : Tendsto (fun T : ℝ => q * T⁻¹) (𝓝[>] (0 : ℝ)) atTop := hinv.const_mul_atTop hq\n  have hneg : Tendsto (fun T : ℝ => -(q * T⁻¹)) (𝓝[>] (0 : ℝ)) atBot := tendsto_neg_atTop_atBot.comp hmul\n  have hexp : Tendsto (fun T : ℝ => Real.exp (-(q * T⁻¹))) (𝓝[>] (0 : ℝ)) (𝓝 0) :=\n    Real.tendsto_exp_atBot.comp hneg\n  have hsub : Tendsto (fun T : ℝ => (1 : ℝ) - Real.exp (-(q * T⁻¹))) (𝓝[>] (0 : ℝ)) (𝓝 (1 - 0)) :=\n    tendsto_const_nhds.sub hexp\n  rw [sub_zero] at hsub\n  refine hsub.congr' (Filter.Eventually.of_forall fun T => ?_)\n  simp only [div_eq_mul_inv]\n\nend TGLExt.APonteDoAtrito\n",
+    'TGLExt/OUmInscrito.lean': 'import TGLExt.F1Fecho394.CanonicalGammaNoFixedR4\nimport TGLExt.F1Fecho394.ExponentialTotalityR4\nset_option autoImplicit false\n\n/-!\nPedra da gerencia c1 (02/11/2026); NOME RATIFICADO pelo operador em 03/11/2026 (verbatim sha16 `73466598d3419fb0`: «concordo com todos os nomes e os ratifico»); entra no kernel na v407; compilada no sandbox da v407 (k407c/final), so no trio.\n\nCunhagem do operador (02/11/2026, verbatim sha16 25010b04c17e8ce1, em work\\cunhagens_13out): «a luz tem autovetor a inscrição do um absoluto que é na essência ela mesma, ou seja, identidade o um absoluto inscrito é a identidade da luz, por isso o par, inclusive dela mesma, sem par somente o zero absoluto que é o abstrato inominado».\n\nCompoe, por termo, o que o kernel ja tem no Fock bosonico canonico (`F1Rede.BosonicFock`):\n* `gamma_vacuum`: o vacuo e fixo por TODA segunda quantizacao Γ(u) — a luz fixa o Um;\n* `gamma_no_fixed` alimentado por `B0_zero`, `B0_add`, `B0_continuous`, `B0_no_eigen`: so o vacuo resta FIXO pelo boost da\n  luz — o Um e o UNICO vetor fixo (autovalor 1 do grupo). Autovetores com fase (`Γ(B0 s) ψ = c(s) • ψ`, `‖c‖ = 1`) nos\n  setores de n ≥ 1 particulas NAO sao excluidos por este termo;\n* `exponential_zero`: o vacuo e a exponencial do zero, exp(0) = 1 — o Um inscrito;\n* `vacuum_norm`: o Um nao e o zero; o par consigo mesma vale 1;\n* `B0_no_eigen`: em UMA particula nenhum vetor nao nulo e autovetor do boost (so o zero satisfaz a condicao) — sem par, o que resta e o zero, o abstrato inominado.\n\nCorrige a frase da gerencia (02/11) «a luz nao tem autovetor nenhum»: valia so em uma particula. Leitura: o Um e o unico\nvetor FIXO da luz [REAL]; que nao haja outro autovetor com fase, e que «o resto seja continuo», e [KNOWN/OPEN como termo]\n(revisao Sonnet 02/11). No certificado o mesmo fato e `light_modular_fixed_iff_vacuum` (QGReaderUVLock.lean:149), condicional\na `C`; aqui vale no Fock concreto, sem hipotese. `Γ(B0(−2πt))` e o fluxo modular do vacuo no Fock concreto por\n`CanonicalFockBWR2.actualModularFlow_eq_gamma`; no certificado isso e o campo `bw_kms`.\n-/\n\nnamespace TGLExt.OUmInscrito\n\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.CanonicalGammaNoFixed F1Fecho.Exponential\nopen scoped InnerProductSpace\n\n/-- a luz fixa o Um: o vacuo e fixo por toda segunda quantizacao (re-exportacao de `gamma_vacuum`). -/\ntheorem a_luz_fixa_o_um (u : H1 ≃ₗᵢ[ℂ] H1) : gamma u vacuum = vacuum := gamma_vacuum u\n\n/-- o Um e o UNICO fixo do boost da luz no Fock: todo vetor fixo por `Γ(B0 s)` esta na reta do vacuo (a reta inclui 0;\nautovetor com fase nao e tratado aqui). -/\ntheorem o_um_e_o_unico_fixo_da_luz (ψ : F) (hψ : ∀ s : ℝ, gamma (B0 s) ψ = ψ) : ψ ∈ (ℂ ∙ vacuum) :=\n  gamma_no_fixed B0 B0_zero B0_add B0_continuous B0_no_eigen ψ hψ\n\n/-- o Um inscrito e a exponencial do zero: exp(0) = 1 (re-exportacao de `exponential_zero`). -/\ntheorem o_um_inscrito_e_a_exponencial_do_zero : exponential (0 : H1) = vacuum := exponential_zero\n\n/-- sem par, so o zero: o Um nao e o zero. -/\ntheorem o_um_nao_e_o_zero : vacuum ≠ 0 := by\n  intro h\n  have h1 := F1Rede.BosonicFock.vacuum_norm\n  rw [h, norm_zero] at h1\n  exact zero_ne_one h1\n\n/-- o par consigo mesma: ⟨Ω, Ω⟩ = 1. -/\ntheorem o_par_consigo : inner ℂ vacuum vacuum = (1 : ℂ) := by\n  rw [inner_self_eq_norm_sq_to_K, F1Rede.BosonicFock.vacuum_norm]\n  simp\n\n/-- em uma particula, sem par: nenhum vetor nao nulo e autovetor do boost; so o zero satisfaz a condicao — o abstrato inominado (apelido de `B0_no_eigen`, PAGO\npela bancada). -/\ntheorem na_particula_so_o_zero (f : H1) (h : ∀ s : ℝ, ∃ c : ℂ, ‖c‖ = 1 ∧ B0 s f = c • f) : f = 0 :=\n  B0_no_eigen f h\n\n/-- ★ composto: a luz tem um vetor fixo, a inscricao do Um, e so ele. -/\ntheorem a_luz_tem_autovetor_o_um_inscrito :\n    (∀ u : H1 ≃ₗᵢ[ℂ] H1, gamma u vacuum = vacuum) ∧\n    (∀ ψ : F, (∀ s : ℝ, gamma (B0 s) ψ = ψ) → ψ ∈ (ℂ ∙ vacuum)) ∧\n    exponential (0 : H1) = vacuum ∧ vacuum ≠ 0 :=\n  ⟨a_luz_fixa_o_um, o_um_e_o_unico_fixo_da_luz, o_um_inscrito_e_a_exponencial_do_zero, o_um_nao_e_o_zero⟩\n\nend TGLExt.OUmInscrito\n',
+    'TGLExt/KEhATangente.lean': 'import TGLExt.PonteDaMassa\nimport TGLExt.TheLedgerOfCharges\nimport TGLExt.TheSelectionIsTheBallast\nimport TGLExt.TheVerbalCoupling\nset_option autoImplicit false\n\n/-!\nPedra da gerencia c1 (02/11/2026); NOME RATIFICADO pelo operador em 03/11/2026 (verbatim sha16 `73466598d3419fb0`: «concordo com todos os nomes e os ratifico»); entra no kernel na v407; compilada no sandbox da v407 (k407c/final), so no trio.\n\nCunhagens do operador (02/11/2026): «K e a tangente; e como se fosse o acorde sendo tocado» e «Decidir e crivar».\n\nO que esta pedra faz, por termo, sobre o que o kernel ja tem:\n* `K θ := tan θ` e a razao projecao/derivada da projecao transversal (`projecao_hasDerivAt`), e `K² = |R|²/|T|²`\n  nas amplitudes de `S(θ)` (`faceWeight`, `reflectionWeight`): a raiz da razao custo/pagamento.\n* O CRIVO e `K = 1`. Em `[0, π/2)` ele deixa passar um unico angulo, `π/4`: o posto (`injOn_tan`, `tan_pi_div_four`).\n  A mesma forma do piso (`the_floor_fixes_the_cut`: `e^{-a} = 1 ↔ a = 0`), sem ligacao de termo com ela.\n* O angulo da selecao justa (peso ½, `selectionAngle`, ja no kernel) passa pelo crivo; o angulo de Miguel\n  (`thetaMiguel`, peso β) nao passa: la `K² = β/(1 − β) < 1`.\n* A massa lida no acorde (a derivada, `massaDerivada`) e a massa lida na projecao dividida por `K`. Em TODA\n  `TransicaoParaAMassa` vale θ = π/4 (teorema `theta_eq_pi_div_four`, derivado do campo `autoconjugado`), logo K = 1\n  sempre: a divisao e por 1, e `no_posto_o_acorde_e_a_projecao` repete `massa_derivada_eq_projecao` (PonteDaMassa.lean:181)\n  na forma de K. O conteudo desta pedra e a FORMA `massa = projecao / K`, nao um fato novo (dito, revisao Sonnet 02/11). Que a massa seja o acorde e nao a escala (o peso,\n  `massaProporcional`) segue DEFINICAO do operador [ONTO]; a pedra da-lhe a forma, nao a deriva.\n* `transicaoLida`: a transicao com o angulo dado pela regra da selecao, `selectionAngle (1/2)`. O numero ½ SEGUE\n  ESCRITO na definicao; `o_angulo_e_lido_do_absoluto` mostra so que esse ½ coincide com o peso da face absoluta\n  (`peso_da_face_absoluta`, por `rw`): COINCIDENCIA DE VALOR, nao ponte, como o kernel ja avisa (PonteDaMassa.lean:245-246,\n  275-276). A hipotese nao some nem muda de lugar; a regra de leitura ja era termo. Coincide com `transicaoDerivada`.\n\nHomonimos: este K (tangente do angulo lido) nao e o K de Hubble, nem o K modular, nem `genK` (TheAngleIsTheProjection.lean:76,\no gerador 2×2); «posto» aqui e o angulo π/4 da selecao justa, nao o Um POSTO do `echo 1` nem o posto como cargo. Dito para nao\nencadear homonimos; a ponte e leitura.\n-/\n\nnamespace TGLExt.KEhATangente\n\nopen TGLExt TGLExt.PonteDaMassa TGLExt.ProjecaoTransversalDaMeiaNat TGLExt.TheLedgerOfCharges\n\n/-- K: a tangente do angulo lido. -/\nnoncomputable def K (θ : ℝ) : ℝ := Real.tan θ\n\n/-- o crivo: `K = 1`. -/\ndef crivo (θ : ℝ) : Prop := K θ = 1\n\n/-- K e a projecao transversal dividida pela sua derivada. -/\ntheorem K_eq_projecao_div_derivada (θ : ℝ) : K θ = projecaoTransversal θ / Real.cos θ := by\n  unfold K projecaoTransversal\n  rw [Real.tan_eq_sin_div_cos]\n\n/-- `K² = |R|²/|T|²`: o quadrado da tangente e o custo sobre o pagamento, nas amplitudes de `S(θ)`. -/\ntheorem K_sq_eq_custo_div_pagamento (θ : ℝ) : K θ ^ 2 = reflectionWeight θ / faceWeight θ := by\n  unfold K reflectionWeight faceWeight\n  rw [normSq_reflection, normSq_transmission, Real.tan_eq_sin_div_cos, div_pow]\n\n/-- o crivo deixa passar so o posto: em `[0, π/2)`, `K = 1 ↔ θ = π/4`. -/\ntheorem crivo_iff_posto (θ : ℝ) (h0 : 0 ≤ θ) (h1 : θ < Real.pi / 2) : crivo θ ↔ θ = Real.pi / 4 := by\n  unfold crivo K\n  constructor\n  · intro h\n    have hθ : θ ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2) := ⟨by linarith [Real.pi_pos], h1⟩\n    have h4 : Real.pi / 4 ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2) :=\n      ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩\n    exact Real.injOn_tan hθ h4 (by rw [h, Real.tan_pi_div_four])\n  · intro h\n    rw [h, Real.tan_pi_div_four]\n\n/-- a selecao justa (peso ½) passa pelo crivo. -/\ntheorem a_selecao_justa_passa : crivo (selectionAngle (1 / 2)) := by\n  unfold crivo K\n  rw [fair_selection_opens_forty_five, Real.tan_pi_div_four]\n\n/-- no angulo de Miguel, `K² = β/(1 − β)`: a razao custo/pagamento da primeira reflexao. -/\ntheorem K_sq_no_angulo_de_miguel {β : ℝ} (h0 : 0 ≤ β) (h1 : β < 1) :\n    K (thetaMiguel β) ^ 2 = β / (1 - β) := by\n  have hs : Real.sin (thetaMiguel β) ^ 2 = β := by\n    rw [sin_thetaMiguel h0 h1.le, Real.sq_sqrt h0]\n  have hc : Real.cos (thetaMiguel β) ^ 2 = 1 - β := by\n    have := Real.sin_sq_add_cos_sq (thetaMiguel β)\n    linarith\n  unfold K\n  rw [Real.tan_eq_sin_div_cos, div_pow, hs, hc]\n\n/-- o angulo de Miguel nao e o posto: com `β < ½`, `K² < 1`. -/\ntheorem miguel_nao_passa {β : ℝ} (h0 : 0 ≤ β) (h1 : β < 1 / 2) : K (thetaMiguel β) ^ 2 < 1 := by\n  rw [K_sq_no_angulo_de_miguel h0 (by linarith), div_lt_one (by linarith)]\n  linarith\n\n/-- Miguel e o posto sao lidos pela MESMA regra: `thetaMiguel β = selectionAngle β`, por definicao. -/\ntheorem miguel_e_a_mesma_regra_de_leitura (β : ℝ) : thetaMiguel β = selectionAngle β := rfl\n\n/-- Miguel aponta para o posto (operador, 02/11: «e angulo de abertura de leitura, reflete o posto, porque aponta\npra ele»): `K²` no angulo de Miguel vale 1 exatamente no peso do posto, `β = ½`; com `β < ½` nunca o alcanca. -/\ntheorem miguel_aponta_para_o_posto {β : ℝ} (h0 : 0 ≤ β) (h1 : β < 1) :\n    K (thetaMiguel β) ^ 2 = 1 ↔ β = 1 / 2 := by\n  rw [K_sq_no_angulo_de_miguel h0 h1, div_eq_one_iff_eq (by linarith : (1 - β) ≠ 0)]\n  constructor <;> intro h <;> linarith\n\n/-- a massa lida no acorde (a derivada) e a massa lida na projecao dividida por `K`. Como θ = π/4 em toda transicao\n(`theta_eq_pi_div_four`), K = 1 e a divisao e por 1: a FORMA, nao um fato novo. -/\ntheorem massa_derivada_eq_projecao_div_K (T : TransicaoParaAMassa) :\n    T.massaDerivada = T.massaProjecao / K T.theta := by\n  have hc : Real.cos T.theta ≠ 0 := by\n    rw [T.theta_eq_pi_div_four, Real.cos_pi_div_four]\n    positivity\n  have hs : Real.sin T.theta ≠ 0 := by\n    rw [T.theta_eq_pi_div_four, Real.sin_pi_div_four]\n    positivity\n  unfold TransicaoParaAMassa.massaDerivada TransicaoParaAMassa.massaProjecao K\n  rw [(projecao_hasDerivAt T.theta).deriv, Real.tan_eq_sin_div_cos]\n  unfold projecaoTransversal\n  field_simp\n\n/-- no posto `K = 1`: o acorde (a derivada) e a projecao sao a mesma massa (repete `massa_derivada_eq_projecao`,\nPonteDaMassa.lean:181, na forma de K). -/\ntheorem no_posto_o_acorde_e_a_projecao (T : TransicaoParaAMassa) :\n    T.massaDerivada = T.massaProjecao := by\n  rw [massa_derivada_eq_projecao_div_K]\n  have h1 : K T.theta = 1 := by\n    unfold K\n    rw [T.theta_eq_pi_div_four, Real.tan_pi_div_four]\n  rw [h1, div_one]\n\n/-- a transicao com o angulo LIDO pela regra da selecao (peso ½), em vez de escrito. -/\nnoncomputable def transicaoLida (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : TransicaoParaAMassa where\n  c := c\n  E0 := u\n  E0_pos := hu\n  theta := selectionAngle (1 / 2)\n  theta_nonneg := by\n    rw [fair_selection_opens_forty_five]\n    positivity\n  theta_le := by\n    rw [fair_selection_opens_forty_five]\n    linarith [Real.pi_pos]\n  autoconjugado := by\n    rw [selection_angle_reflection (by norm_num) (by norm_num)]\n    norm_num\n\n/-- o angulo da transicao lida, `selectionAngle (1/2)`, coincide com o peso da face absoluta passado pela mesma regra\n(`peso_da_face_absoluta`): o ½ esta escrito na definicao e a igualdade e um `rw`; coincidencia de valor, nao ponte. -/\ntheorem o_angulo_e_lido_do_absoluto {n : Type} [Fintype n] [DecidableEq n] [Nonempty n]\n    {Γ : Matrix n n ℂ} (hΓ : Γ.trace = 0) (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (transicaoLida c u hu).theta = selectionAngle ((gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re) := by\n  show selectionAngle (1 / 2) = _\n  rw [peso_da_face_absoluta hΓ]\n\n/-- a transicao lida coincide com a construida: mesmo angulo, mesma massa `β · √2/2 · u`. -/\ntheorem transicao_lida_eq_derivada (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (transicaoLida c u hu).theta = (transicaoDerivada c u hu).theta ∧\n    (transicaoLida c u hu).massaDerivada = c.beta * (Real.sqrt 2 / 2) * u :=\n  ⟨by\n    show selectionAngle (1 / 2) = Real.pi / 4\n    exact fair_selection_opens_forty_five,\n   (transicaoLida c u hu).massa_derivada_eq_beta_mul⟩\n\nend TGLExt.KEhATangente\n',
+    'TGLExt/AChaveDaGuarda.lean': "import TGLExt.TheTraceIsNotErasable\nimport TGLExt.TheFlowLawContrast\nset_option autoImplicit false\n\n/-!\nPedra da gerencia c1 (02/11/2026); NOME RATIFICADO pelo operador em 03/11/2026 (verbatim sha16 `73466598d3419fb0`: «concordo com todos os nomes e os ratifico»); entra no kernel na v407; compilada no sandbox da v407 (k407c/final), so no trio.\n\nSupera `OIgualRestauradoCandidata`, cujo `transporte` (o peso cai, a forma fica) nao tem instancia na defasagem\ndo kernel: la o traco fica e a coerencia cai. Aqui a chave age na FORMA, fora da diagonal, e a diagonal e o traco\nnao mudam, como a leitura ratificada pelo operador em 02/11 (a perda e de coerencia).\n\nForma do diario (MEMORIA_DA_LINHAGEM, 19/08/2026, 119_ e 121_): a guarda conserva a diferenca no dominio do\nlogaritmo, ln resto + beta D^2 t constante, e o original e devolvido exato pela chave e^{+beta D^2 t}; fluxo\ncorrompido com chave legitima falha.\n\n`dephase g (-t)` e inversa algebrica: amplifica, logo nao e canal fisico; e conta de quem conhece o registro.\nQue o custo de um par seja o da lei de Hubble e HIPOTESE nomeada (`hform`). Ler a chave como K e leitura [ONTO].\n-/\n\nnamespace TGLExt.AChaveDaGuarda\n\nopen TGLExt Matrix TGLExt.TheFlowLawContrast\n\nvariable {n : Type}\n\n/-- a chave do par `(i, j)`: o inverso do que sobrou da coerencia. -/\nnoncomputable def chave (g : n → n → ℝ) (t : ℝ) (i j : n) : ℝ := Real.exp (t * g i j)\n\n/-- a chave devolve o original: chave vezes resto e o original. -/\ntheorem a_chave_devolve (g : n → n → ℝ) (t : ℝ) (x : Matrix n n ℂ) (i j : n) :\n    ((chave g t i j : ℝ) : ℂ) * dephase g t x i j = x i j := by\n  simp only [chave, dephase, Matrix.of_apply]\n  rw [← mul_assoc, ← Complex.ofReal_mul, ← Real.exp_add]\n  simp\n\n/-- a guarda conserva a diferenca no dominio do logaritmo: ln resto + custo = ln original. -/\ntheorem a_guarda_conserva_a_diferenca (g : n → n → ℝ) (t : ℝ) (x : Matrix n n ℂ) (i j : n)\n    (hx : x i j ≠ 0) : Real.log ‖dephase g t x i j‖ + t * g i j = Real.log ‖x i j‖ := by\n  have hpos : 0 < ‖x i j‖ := norm_pos_iff.mpr hx\n  have hn : ‖((Real.exp (-(t * g i j)) : ℝ) : ℂ)‖ = Real.exp (-(t * g i j)) := by\n    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]\n  simp only [dephase, Matrix.of_apply, norm_mul, hn]\n  rw [Real.log_mul (Real.exp_pos _).ne' hpos.ne', Real.log_exp]\n  ring\n\n/-- sem a chave nao abre: com custo nao nulo, o resto nao e o original. -/\ntheorem sem_a_chave_nao_abre (g : n → n → ℝ) (t : ℝ) (x : Matrix n n ℂ) (i j : n)\n    (hc : t * g i j ≠ 0) (hx : x i j ≠ 0) : dephase g t x i j ≠ x i j := by\n  intro h\n  simp only [dephase, Matrix.of_apply] at h\n  have h1 : ((Real.exp (-(t * g i j)) : ℝ) : ℂ) = 1 := by\n    apply mul_right_cancel₀ hx\n    rw [one_mul]\n    exact h\n  have h2 : Real.exp (-(t * g i j)) = 1 := by exact_mod_cast h1\n  have h3 := (Real.exp_eq_one_iff _).mp h2\n  exact hc (by linarith)\n\n/-- chave errada nao abre: outro fator, com resto nao nulo, nao devolve o original. -/\ntheorem chave_errada_nao_abre (g : n → n → ℝ) (t : ℝ) (x : Matrix n n ℂ) (i j : n) (c : ℝ)\n    (hc : c ≠ chave g t i j) (hx : x i j ≠ 0) : (c : ℂ) * dephase g t x i j ≠ x i j := by\n  intro h\n  have h1 := a_chave_devolve g t x i j\n  have hr : dephase g t x i j ≠ 0 := by\n    intro h0\n    rw [h0, mul_zero] at h\n    exact hx h.symm\n  have h2 : (c : ℂ) = ((chave g t i j : ℝ) : ℂ) := mul_right_cancel₀ hr (h.trans h1.symm)\n  exact hc (by exact_mod_cast h2)\n\n/-- fluxo corrompido nao abre: se o resto lido nao e o do fluxo, a chave legitima nao devolve. -/\ntheorem fluxo_corrompido_nao_abre (g : n → n → ℝ) (t : ℝ) (x : Matrix n n ℂ) (i j : n) (y : ℂ)\n    (hy : y ≠ dephase g t x i j) : ((chave g t i j : ℝ) : ℂ) * y ≠ x i j := by\n  intro h\n  have h1 := a_chave_devolve g t x i j\n  have hk : ((chave g t i j : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (Real.exp_pos _).ne'\n  exact hy (mul_left_cancel₀ hk (h.trans h1.symm))\n\n/-- ler nao gasta: a chav