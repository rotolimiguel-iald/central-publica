def topico_missao(V):
    d = _d(V)
    return marca_topico_missao(V) + (" (%s; COMPLETA; gate INTOCADO): %d módulos novos no kernel (%s); o registro com função `psion_canto_v407` (lê as %d âncoras, os módulos por sha256 e a chave do lema do kernel do rito), `cunhagens_v407` (%d inscrições por sha256, todas do operador, as erratas E18 a E20 e as decisões D41 a D47) e `kh_n1_cobertura_v407`; "
                                     "os registros da v406, da v405, da v404, da v403, da v402, da v401 e da v399 recriados e selados; sidecar `um_absoluto_selo_acom.json` reescrito; troca dita nos vereditos que carregam a escada; conferidor (deve mudar %s; não pode mudar %s). Pacote e cadeia: `work\\cadeia_de_selo\\v407` (+ `pos_rito`).") % (V["teor"], V["n_pedras"], _mods(V), d["n_anc"], d["n_cun"], V["conf_dm"], V["conf_np"])


# v407: o topico do estado da Central
def topico_central(V):
    d = _d(V); DL_ = _qd().DL
    return marca_central(V) + (" `um.py` `%s` (%s B) sobre a v406 `%s`; escada %s → %s; gate intocado. %d módulos novos no kernel (%s): %s; "
