        V["data"], V["s16"], V["teor"], V["n_pedras"], _mods(V), DL_.FRASE_DA_MOLDURA_V407_PT, d["g"]["n_calc"], d["g"]["n_flags"], d["g"]["n_lit"], d["n_cun"], V["escada_antes"], d["depois"], _erratas_e(V), TOPICO_NOVO))


