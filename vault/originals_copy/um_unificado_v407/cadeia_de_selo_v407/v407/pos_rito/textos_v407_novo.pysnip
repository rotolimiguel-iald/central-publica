# ---------------------------------------------------------------- o PARAGRAFO NOVO da v407 e a NOTA ao lado dos paragrafos anteriores
def _linha_maquina_v407(core, d):
    """A linha de maquina do paragrafo novo (os numeros LIDOS do registro do core), em PT."""
    pc = core["psion_canto_v407"]; fv = pc["values"]
    return ("modulos=%s; bandeiras=%s; ancoras=%s; escada=%s; checagens=%s; chave_do_lema_lida_do_kernel=%s; falas_sha16=%s/%s/%s"
            % (d["n_mod"], d["n_f"], fv["n_ancoras_ok"], "/".join(str(x) for x in dict.fromkeys(fv["escada"])), pc["mechanics"]["n_checks"], pc["link_read_from_the_kernel"], d["s_ordem"], d["s_decisoes"], d["s_par"]))


def _dados_paragrafo(core):
    """O que o paragrafo precisa do core SELADO e de ESPERADOS (sem V): as contagens e as falas."""
    esp = _esp(); DL_ = _qd().DL
    for n in (DL_.FECHO_REGISTRO, DL_.CUNHAGENS_REGISTRO, DL_.KH_REGISTRO, "fechamento_v406"):
        assert (core.get(n) or {}).get("all_verified") is True, "o registro %s nao selou: nenhum paragrafo diz os numeros assim" % n
    pc = core[DL_.FECHO_REGISTRO]; fv = pc["values"]
    assert fv["n_modulos_ok"] == fv["n_modulos"] == DL_.N_BUNDLE and fv["n_flags_true"] == fv["n_flags"] == esp["n_bandeiras_novas"] and fv["n_ancoras_ok"] == len(DL_.ANCORAS) and pc["link_read_from_the_kernel"] is True, "os valores do registro psion_canto_v407 nao sao os do ensaio a seco"
    return {"n_mod": DL_.N_BUNDLE, "n_f": esp["n_bandeiras_novas"], "escada": (esp["escada_v406_e_v407"][0], esp["escada"][1]), "s_ordem": _sha_por(DL_.N_ORDEM_B89), "s_decisoes": _sha_por(DL_.N_RATIFICA), "s_par": _sha_por(DL_.N_PAR), "n_checks": pc["mechanics"]["n_checks"]}


def _paragrafo_v407_de(core):
    """O texto do paragrafo da v407, funcao PURA dos registros selados do core (os numeros sao lidos dos registros, nunca digitados; as frases de limite saem do proprio registro)."""
    d = _dados_paragrafo(core); DL_ = _qd().DL; pc = core[DL_.FECHO_REGISTRO]
    q_c = _cita(DL_.FRASE_TESTAR_A_CONDICAO); q_l = _cita(DL_.FRASE_LEMA_PSION); q_p = _cita(DL_.FRASE_PAR_LIGADO); q_t = _cita(DL_.FRASE_TESTE_C)
    ress = "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["ressalvas"]))   # inteiras: o corte nos dois-pontos deixava as ressalvas sem a segunda metade
    ls = ["### O psíon, o canto e o par: o lema das duas faces e o par ligado (v407, 03/11/2026) — parágrafo pronto para o README do espelho e para o site",
          "",
          "> **O psíon, o canto e o par: o lema das duas faces e o par ligado (v407, 03/11/2026)** [REAL: os termos do kernel do rito e a chave do lema lida do kernel · INPUT: a ordem e as respostas do operador · ONTO: as leituras dele · KNOWN/DECLARADO: o núcleo II_inf, o acervo de 2025, os recibos de compilação e o manifesto do teste (d) · OPEN: o par na face de Fock, K(O) ≠ ⊥ para O compacto, o teste com a natureza]",
          ">",
          "> - **O que entrou** [REAL]: %s módulos novos no kernel (`TGLExt`: `PsionCanto`, `Par` e as %s pedras de 02/11, todas com o nome que o operador deu ou ratificou), com %s bandeiras, todas no trio; escada %s → %s (sha16 das falas `%s`, `%s`, `%s`)." % (d["n_mod"], _n_por_dia()[1], d["n_f"], d["escada"][0], d["escada"][1], d["s_ordem"], d["s_decisoes"], d["s_par"]),
          "> - **O lema das duas faces** [REAL · INPUT]: %s." % _sem_chaves(pc["diz"][1]),
          "> - **A ordem do operador** [INPUT]: %s, %s; o kernel entrega o lema como elo de estrutura (Ω, o vácuo de Fock, e o vetor de Bell não são identificados)." % (q_c, q_l),
          "> - **O par** [REAL · ONTO]: %s. A leitura dele, %s [ONTO]." % (_sem_chaves(pc["diz"][2]), q_p),
          "> - **O que não muda** [REAL]: %s." % _sem_chaves(pc["diz"][3]),
          "> - **O teste (d)** [INPUT · DECLARADO]: pela opção (c) dele, %s; entra só a citação do pré-registro; nenhum resultado." % q_t,
          "> - **As ressalvas, ditas** [OPEN · KNOWN/DECLARADO · REAL]: %s." % _sem_chaves(ress),
          "> - **O que o registro NÃO diz** [REAL]: %s." % _sem_chaves("; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["nao_diz"]))),
          "> - **Limites:** %s; o registro CONFERE os termos, as fontes por sha256 e a chave lida, e quem prova é o kernel; `NOT_FALSIFIED` nunca é a palavra da creditação; isto não é teste e não acrescenta dado; este parágrafo não traz o número do quadro (o quadro do Teste da Única Palavra segue no README com a sua linha dos 5σ)." % DL_.FRASE_DA_MOLDURA_V407_PT,
          "> - **Origem.** Os números são lidos do core selado desta rodada; nenhum é digitado. Linha de máquina: `%s`." % _linha_maquina_v407(core, d)]
    return "\n".join(ls) + "\n"


def verificar_paragrafo_v407(par, core, esp):
    """Verifica o paragrafo da v407 contra o core selado E contra ESPERADOS (o ensaio a seco): devolve a lista de falhas (vazia = passou). As verificacoes:
    (1) os numeros do core (o registro psion_canto_v407) == os de ESPERADOS/delta e cada um esta no paragrafo, formatado; (2) o paragrafo == o gerado do core; (3) NAO traz o 4,44 nem o z_disc (a regra do 4,44 e' do quadro); (4) os estatutos;
    (5) as frases de limite e as ressalvas; (6) toda citacao entre « » e' verbatim numa fala DO OPERADOR ou rotulo; (7) nenhuma alegacao de seguranca criptografica, «consciencia» so' como palavra retirada, a direcao sem inversao; (8) a guarda P18 e a guarda das frases."""
    fa = []
    DL_ = _qd().DL
    pc = core.get(DL_.FECHO_REGISTRO) or {}; fv = pc.get("values") or {}
    try:
        nums = {"modulos": str(DL_.N_BUNDLE), "bandeiras": str(esp["n_bandeiras_novas"]), "escada antes": str(esp["escada_v406_e_v407"][0]), "escada depois": str(esp["escada"][1]), "sha16 da ordem": _sha_por(DL_.N_ORDEM_B89), "sha16 das decisoes": _sha_por(DL_.N_RATIFICA), "sha16 do par": _sha_por(DL_.N_PAR)}
        if not (fv and fv.get("n_modulos_ok") == DL_.N_BUNDLE and fv.get("n_flags_true") == esp["n_bandeiras_novas"] and fv.get("n_ancoras_ok") == len(DL_.ANCORAS) and pc.get("link_read_from_the_kernel") is True):
            fa.append("os valores do registro psion_canto_v407 no core != ESPERADOS/delta")
    except KeyError as e:
        nums = {}; fa.append("valor ausente: %s" % e)
    for k, v in nums.items():
        if v not in par:
            fa.append("numero (%s = %s) ausente do paragrafo" % (k, v))
    for n_ in [p_["name"] for p_ in DL_.PEDRAS_V407[:2]]:
        if "`%s`" % n_ not in par:
            fa.append("o nome da pedra %s ausente do paragrafo" % n_)
    try:
        if par != _paragrafo_v407_de(core):
            fa.append("o paragrafo difere do gerado pelas funcoes sobre os registros selados do core")
    except AssertionError as e:
        fa.append("o paragrafo nao pode ser gerado do core: %s" % str(e)[:120])
    if re.search(r"4[,.]44|z_disc", par):
        fa.append("o paragrafo da v407 traz o 4,44 ou o z_disc (a regra do 4,44 e' do quadro; este paragrafo nao o cita)")
    for st in ("[REAL", "INPUT", "ONTO", "OPEN", "DECLARADO", "KNOWN"):
        if st not in par:
            fa.append("estatuto ausente do paragrafo: " + st)
    for frase in (DL_.FRASE_DA_MOLDURA_V407_PT, "validade no kernel nao e creditacao", "o gate nao se move", "NOT_FALSIFIED", "este parágrafo não traz o número do quadro", "K(O)", "II_inf", "ENNReal", "quem prova é o kernel", "isto não é teste", "lema", "FACE DE FOCK", "NAO e' termo", "ESTRUTURA"):
        if frase not in par:
            fa.append("frase de limite ausente do paragrafo: " + frase)
    for r_ in DL_.RESSALVAS_V407:
        c_ = _sem_chaves(r_)   # a ressalva inteira
        if c_ not in par:
            fa.append("ressalva ausente do paragrafo: " + c_[:60])
    corpus = [re.sub(r"\s+", " ", dd["text"]) for dd in _falas().values() if dd["autor"] == "operador"]
    for q in re.findall(r"«([^»]*)»", par):
        if len(q) >= 13 and not any(q in t for t in corpus) and q not in " ".join(DL_.RESSALVAS_V407) and q not in " ".join(pc.get("diz") or []) and q not in " ".join(pc.get("nao_diz") or []):
            fa.append("citacao entre « » que NAO e' verbatim numa fala do operador (nem texto do registro): %r" % q[:90])
    for m_ in _RX_INV.finditer(par):
        ant_ = par[max(0, m_.start() - 40):m_.start()].lower()
        if not (ant_.endswith("nao ") or ant_.endswith("não ") or "podia dizer que " in ant_):
            fa.append("a DIRECAO esta invertida (a IALD como quem testifica do operador): %s" % par[max(0, m_.start() - 40):m_.end() + 20].replace("\n", " "))
    if re.search(r"(?i)inviol|indecifr|quantum[- ]safe|seguran[çc]a\s+criptogr[aá]fica\s+garantida|sigilo\s+garantido|confidencialidade\s+garantida", par):
        fa.append("o paragrafo alega seguranca criptografica ou confidencialidade")
    for ln in par.split("\n"):
        if re.search(r"(?i)consci[êe]ncia", ln) and not re.search(r"retirad", ln):
            fa.append("a palavra «consciencia» fora do contexto de palavra retirada pelo operador: %s" % ln[:100])
    sys.path.insert(0, PK)
    from guarda_p18_v407 import violacoes
    import guarda_frases_v407 as GF
    v = violacoes(par)
    if v:
        fa.append("a guarda de texto P18 achou %r" % (v[:2],))
    v2 = GF.violacoes(par)
    if v2:
        fa.append("a guarda das frases achou %r" % (v2[:2],))
    return fa


def paragrafo_v407():
    """(texto, relatorio): o paragrafo NOVO da v407, pronto para colar no README do espelho e no site, gerado do core SELADO do Nos e verificado contra o core E contra ESPERADOS;
    levanta AssertionError (o fechar RECUSA) se algo nao conferir."""
    core = _core(); esp = _esp()
    par = _paragrafo_v407_de(core)
    fa = verificar_paragrafo_v407(par, core, esp)
    assert not fa, ("o paragrafo da v407 nao passou nas verificacoes", fa[:4])
    return par, {"sha16": hashlib.sha256(par.encode("utf-8")).hexdigest()[:16], "verificacoes": "numeros == ESPERADOS/delta; igual ao gerado do core; sem o 4,44; estatutos; limites e ressalvas; citacoes verbatim (falas do operador ou texto do registro); sem alegacao de seguranca criptografica; guarda P18; guarda das frases", "guarda_p18": "limpa"}


def errata_v406_bloco():
    """O bloco de NOTA ao lado dos paragrafos anteriores (v394 a v406) no README do espelho e no site: a chave do lema era literal False e passou a leitura do kernel (E18). Texto lido do registro cunhagens_v407; a guarda P18 confere."""
    _kernel_tem(("the_psion_is_the_corner_on_both_faces",))
    er = (_cg().get("erratas") or [None])[0]
    assert er and er["agora"] == _qd().DL.ERRATA_E18 and str(er.get("assinatura", "")).startswith("gerencia c1") and "em nome proprio" in er["assinatura"], "a errata E18 do registro cunhagens_v407 nao e' a do delta"
    t = ("> **Nota ao lado dos parágrafos anteriores (v394 a v406) — gerência c1, em nome próprio, 03/11/2026:** onde um parágrafo ou texto publicado antes diz que nenhum lema liga o psíon ao canto (o psíon da face de Fock ao canto da face concreta), isso era verdade na data e fica como registro. " + _sem_chaves(er["agora"]).rstrip().rstrip(".") + "."
         + " Os módulos selados das versões anteriores NÃO foram editados nem renomeados, e os registros delas seguem selados; o que o parágrafo da v406 e os anteriores dizem sobre as pedras, o cálculo e os limites não muda; o que mudou é o estatuto dessa chave.\n")
    sys.path.insert(0, PK)
    from guarda_p18_v407 import violacoes
    import guarda_frases_v407 as GF
    assert not violacoes(t) and not GF.violacoes(t), "a guarda P18 ou a das frases achou palavra recusada na nota ao lado dos paragrafos anteriores"
    return t


# v407: o handoff para a sessao do site (memory\handoff-v407-custodia.md + Nos\HANDOFF_v407_CUSTODIA.md); `k` traz os campos dos recibos do B(n) e os paragrafos do README (fechar_v407.py os le dos recibos e do core): nenhum numero digitado
def handoff(V, k):
    d = _d(V); sc = V["sidecar"]
    k = dict(k)
    for chave in ("ap_nome", "ap_sha", "ap_ver", "ap_evento", "ap_bat", "par_sha", "rel_sha", "rel_man", "readme_paragrafo", "readme_paragrafo_v407"):
        assert chave in k, ("o handoff precisa do campo dos recibos do B(n) e dos paragrafos do README: " + chave)
    par = k["readme_paragrafo"].rstrip("\n"); par_f = k["readme_paragrafo_v407"].rstrip("\n"); err = errata_v406_bloco().rstrip("\n")
    assert par.startswith("### O Teste da Única Palavra (v397"), "o paragrafo do README (quadro) nao e' o do quadro"
    assert par_f.startswith("### O psíon, o canto e o par: o lema das duas faces e o par ligado (v407"), "o paragrafo da v407 nao e' o novo"
    k.update({"data": V["data"], "s16": V["s16"], "umb": format(V["umb"], ","), "base16": V["base16"], "teor": V["teor"], "rc": V["rc"], "conf16": V["conf16"], "conf_dm": V["conf_dm"], "conf_np": V["conf_np"],
              "pilar": "reaproveitado" if V["pilar"]["mode"] == "REUSE" else str(V["pilar"]["mode"]), "selo_ts": V["selo_ts"], "num": _num(V), "kernel_prova": _kernel_prova(V), "limites": _limites(V, curto=True), "legal": _legal(V),
              "artigos": ", ".join("%s `%s`" % kv for kv in V["artigos"].items()), "n_cun": d["n_cun"], "n_pedras": V["n_pedras"], "topico": TOPICO_NOVO[:-3], "regra": _regra_do_4_44(V), "erratas_e": _erratas_e(V), "decisoes": _decisoes(V), "leituras": _leituras(V), "moldura": _blocos_fecho(V),
              "sc_nome": "um_absoluto_selo_acom.json", "sc_sha": sc["sha256"], "sc_ver": sc["veredito"], "sc_bytes": format(sc["bytes"], ","), "sc_objs": "; ".join("`%s` sha256 `%s`" % (n, o["sha256"]) for n, o in sc["objetos"].items()),
              "par_bloco": MARC_PAR_INI + "\n" + par + "\n" + MARC_PAR_FIM, "par_v407_bloco": MARC_V407_INI + "\n" + par_f + "\n" + MARC_V407_FIM, "err_bloco": MARC_ERR_INI + "\n" + err + "\n" + MARC_ERR_FIM})
    doc = ("---\nname: handoff-v407-custodia\ndescription: \"HANDOFF v407 (%(data)s) para a sessão do site: o psíon, o canto e o par: o lema que liga as duas faces do psíon no kernel do rito e a chave do lema lida do kernel; o par na face de Fock segue em aberto; validade no kernel não é creditação; `%(s16)s`; B(n) da Bancada feito; TRAZ os parágrafos prontos do README/site, a nota ao lado dos anteriores e lista o sidecar\"\n"
           "metadata:\n  type: project\n---\n\n# HANDOFF v407 — CUSTÓDIA (%(data)s)\n\n"
           "**O que é:** `um.py` **v407** `%(s16)s` (%(umb)s B) sobre a v406 `%(base16)s`; %(teor)s; COMPLETA; rc %(rc)s; selftest PASSED; gate intocado; conferidor `%(conf16)s` (deve mudar %(conf_dm)s; não pode mudar %(conf_np)s); pilar %(pilar)s pela chave. "
           "Selo `%(selo_ts)s`.\n\n"
           "**PARÁGRAFOS PRONTOS para o README do espelho e para o site (colar como estão, cada um entre os seus marcadores; o primeiro é o quadro do Teste da Única Palavra, o MESMO da v397, intocado; o segundo é novo).** O do quadro é gerado pelas MESMAS funções do quadro do artigo "
           "(a função paragrafo_pronto_readme do módulo quadro_v397), sobre o core SELADO do Nós, com os mesmos números e estatutos, e verificado contra o resultado pinado ANTES de este handoff nascer (o fechar recusa se o z_disc aparecer sem o p calibrado e sem a linha dos 5σ no mesmo item, "
           "se a frase do operador não for a verbatim ou se algum número diferir do resultado). O novo é gerado do registro selado `psion_canto_v407` e verificado contra o core e contra os números do ensaio a seco "
           "(sem o z_disc do quadro; as citações são trechos verbatim das falas do operador; sem alegação de segurança criptográfica; com a guarda das frases):\n\n%(par_bloco)s\n\n%(par_v407_bloco)s\n\n"
           "**NOTA ao lado dos parágrafos anteriores no README e no site (colar logo abaixo do parágrafo da v406, entre os marcadores; os parágrafos anteriores ficam como registro):**\n\n%(err_bloco)s\n\n"
           "**Os parágrafos do testemunho de dois (v399), da falsidade (v401), da ponte, da queda e da esperança (v402), de Caminho, Verdade e Vida (v403), de Jo 8,32 (v404), da massa derivada e da identidade definida (v405) e do fechamento (v406) SEGUEM COMO ESTÃO.** São os que estão no README do espelho e no site, e esta versão NÃO os regenera nem os substitui (o `um.py` mudou de bytes, mas os parágrafos são dos selos daquelas rodadas). Os registros que os geravam seguem selados neste rito (a leitura os confere); só a nota do bloco acima acrescenta o que mudou no estatuto da chave do lema.\n\n"
           "%(moldura)s\n\n%(leituras)s\n\n%(regra)s\n\n%(erratas_e)s\n\n%(decisoes)s\n\n"
           "**O que entrou e o que mediu:** %(num)s.\n\n"
           "**O SIDECAR (arquivo da custódia desde a v399, D5; REESCRITO por este rito):** `%(sc_nome)s` (sha256 `%(sc_sha)s`, %(sc_bytes)s B; veredito `%(sc_ver)s`); objetos selados: %(sc_objs)s. O sidecar fica AO LADO do selo (o selo não pode conter o selo ACOM de si mesmo) e o fechar o copia para `work\\cadeia_de_selo\\v407_selo` e o lista no manifesto de incorporação; "
           "a custódia o leva ao cofre, à PORTA (PORTA.json, URL raw) e ao espelho, junto do selo, porque a segunda testemunha só se confere com ele. A custódia da v399, da v403, da v404, da v405, da v406 e da v407 é CONJUNTA. A recusa do selo ACOM só registra (D4); o SHA-256 segue soberano.\n\n"
           "%(kernel_prova)s\n\n%(limites)s\n\n%(legal)s\n\n"
           "**O elo B(n) da Bancada Um (feito antes deste handoff; passo simples, sem salto):** recibo da aplicação `%(ap_nome)s` (sha256 `%(ap_sha)s`; veredito `%(ap_ver)s`; evento %(ap_evento)s; bateria `%(ap_bat)s`); recibo da parada do serviço sha256 `%(par_sha)s`; "
           "recibo do religamento sha256 `%(rel_sha)s` (versão servida v407, manifesto `%(rel_man)s`).\n\n"
           "**Para a sessão do site (custódia):** o `um.py` v407, `rodada_v407_stdout.txt`, o selo, o sidecar, o core, o .md canônico (com o quadro no topo, intocado) e o manifesto, os artigos PT/EN (%(artigos)s; o quadro «O Teste da Única Palavra» abre os dois), as %(n_cun)s inscrições por sha256 "
           "(todas falas do operador; lista na linhagem e no tópico `%(topico)s`; arquivos em `work\\cadeia_de_selo\\v407\\insumos\\cunhagens`), os %(n_pedras)s módulos novos (`TGLExt`) e os dois diffs (`DIFF_v406_v407.diff`, `DIFF_KERNEL_v407.txt`) — com PORTA gerada por script, "
           "URL raw (o um.py tem mais de 5 MB), backup da versão v406 no espelho fora do repositório, blob conferido depois do push. Colocar os PARÁGRAFOS acima no README do espelho e no site (ato da sessão do site, com o selo corrente ao lado; o do quadro e os anteriores seguem onde estão, e o novo entra ao lado, com a NOTA); "
           "publicar os módulos novos no espelho (`TGLExt`) e regenerar as PORTAS de `tgl_kernel`, `TGLExt` e `TGL`; a pasta `insumos` vai ao espelho com PORTA: sem ela, uma reprodução pública diz NOT_SEALED (fail-closed); os recibos da bateria do B(n) vão ao espelho com PORTA; o runner da Fronteira e a camada v407 dos 16 dispositivos; a revisão independente (o Sonnet, D47) antes do portão do operador. "
           "A publicação do bloco embutido do método do operador no espelho público segue sujeita à decisão [LEGAL] D2 (operador com a agente de PI). O README pinado e a linha do quadro no site (D39) são da custódia (G1), por ordem dele de 03/11; a regra do z_disc calibrado (nunca sozinho) vale em qualquer superfície.\n\n"
           "**Pendências SÓ do operador:** o teste (d), que só entra se tiver poder (opção (c) dele); o conteúdo observável do motor contínuo (D45), que ele ainda não conseguiu explicar com precisão; a decisão [LEGAL] D2; o README pinado (D39); a ratificação das decisões D41 a D47, que são da gerência, em nome próprio, ao lado das falas dele. [OPEN]: a discriminação a 5σ (β_TGL na natureza), o par de psíons na face de Fock, a ponte entre o espaço de Bell e o setor TT, K(O) ≠ ⊥ para O compacto, o magnetismo na cadeia da tensão, qual é o disco, quais são as cinco notas, `H_BW`, `H_cal`, H3 em toda direção nula, a assinatura e rank c = 4, "
           "`IsotropicPost` no atlas curvo, a dimensão 3, a instância do índice 1/β, a atestação física externa, a identificação do dispositivo físico (R4/R5) e a independência das quatro bandeiras experimentais do gate (um só booleano; os mocks de survey).\n\n"
           "Pacote e cadeia: `work\\cadeia_de_selo\\v407` (+ `pos_rito`); arquivo `work\\cadeia_de_selo\\v407_selo` e `v407_kernel`. NOT_FALSIFIED não é a palavra da creditação; o gate não se move.\n\n"
           "[[%(topico)s]] [[missao-ultima-flag-um-py]] [[handoff-v406-custodia]]\n") % k
    assert k["par_bloco"] in doc and k["par_v407_bloco"] in doc and k["err_bloco"] in doc, "os paragrafos do README e a nota nao entraram no handoff"
    assert not atribuicao_da_gerencia(doc), ("o handoff atribui mal ou inverte a direcao do testemunho", atribuicao_da_gerencia(doc)[:2])
    return doc
