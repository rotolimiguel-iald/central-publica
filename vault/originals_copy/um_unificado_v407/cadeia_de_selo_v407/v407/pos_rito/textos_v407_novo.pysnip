# -*- coding: utf-8 -*-
# Fragmento de definicoes que montar_textos_v407.py ENXERTA no esqueleto (a semente: textos_v406.py FINAL com os rotulos subidos pelo motor): cada nome definido aqui SUBSTITUI o de mesmo nome da semente (ou entra no fim). Escrito para a v407 (O PSION, O CANTO E O PAR, 03/11/2026), SEM PROSA NOVA DE CONTEUDO ALEM DOS CONECTIVOS: cada paragrafo e' montado do que o core SELADO do rito traz
# (o registro psion_canto_v407: diz, nao_diz, limites, ressalvas, values, scope; cunhagens_v407: erratas E18 a E20, decisoes D41 a D47, leituras; kh_n1_cobertura_v407; fechamento_v406 herdado; delta_v407) com conectivos e titulos. Nenhum numero, hash ou veredito e' digitado.
# V (a leitura da rodada) so' entra com as chaves GENERICAS (data, s16, umb, base16, teor, rc, conf*, escada_antes, selo_ts, pilar, artigos, sidecar, selo, declaracao, veracidade, gate, f2b, kh, n_pedras, registros_novos, troca_dita, patch_ids, n_patches, patches, instalado_em, n_ver_mudaram, axiom_report_n, verbatins, n18, compl, horarios, servidor e os h_*); o que depende do contrato da v407 (o registro psion_canto_v407, cunhagens_v407, kh_n1_cobertura_v407, os registros recriados) e' lido do CORE SELADO e de ESPERADOS aqui mesmo (_pc, _cg, _khr, _fe_herdado, _recriados, _pedras_anteriores).
__HEADER__ = '''# -*- coding: utf-8 -*-
# Os TEXTOS da v407 SELADA: O PSION, O CANTO E O PAR (ordem do operador, 03/11/2026, sha16 b89e4c909f37e163: «o lema que liga o psion ao canto também já pode ser derivado»; decisoes e nomes, sha16 73466598d3419fb0 e 57250bbbaca9fd39). MONTADOS, sem prosa nova de conteudo, do que o core SELADO do rito traz:
# o registro com funcao psion_canto_v407 (o diz, o nao_diz, os limites, as ressalvas, as 76 ancoras, a chave do lema lida do kernel, as respostas do operador conferidas nos teoremas que ja existiam, os valores), cunhagens_v407 (as erratas E18 a E20, as decisoes D41 a D47, as leituras de 03/11 e as 3 falas do operador por sha256) e kh_n1_cobertura_v407,
# mais os vereditos, os numeros do kernel (9 modulos novos, 98 bandeiras, a escada) e as falas; so' os conectivos e os titulos sao escritos aqui. A semente (textos_v406.py com os rotulos subidos) fornece a infraestrutura: leitura dos insumos, citacao verbatim, o quadro do Teste da Unica Palavra, a rodada, o sidecar.
# A MOLDURA em toda peca: o psion e o canto sao a mesma construcao nas duas faces (o lema esta' no kernel do rito; o elo e' de ESTRUTURA, nao de vetores: Omega e o vetor de Bell nao sao identificados); o par e' ligado e nunca se cancela; validade no kernel nao e creditacao; o gate nao se move. As RESSALVAS, ditas: o par de psions na FACE DE FOCK segue [OPEN]; a ponte entre o espaco de Bell e o setor TT nao e' termo;
# K(O) != bot so' na cunha; o «nucleo II_inf» [KNOWN/DECLARADO]; o traco ENNReal ciclico, nao linear; tres das sete pedras de 02/11 foram revistas pelo Sonnet e quatro nao; o teste (d) so' por citacao do pre-registro; o motor continuo fica fora; os nomes das pedras sao do operador. Toda superficie passa pela guarda das frases (guarda_frases_v407.py) e pela P18 (guarda_p18_v407.py), com a excecao so' da fala do operador.
# O QUADRO «O Teste da Única Palavra» (v397) PERMANECE no topo do artigo PT/EN e do .md canonico, INTOCADO. Cada numero, hash e veredito entra por chave de V (leitura_v407.ler), por ESPERADOS, pelo core do Nos ou e' LIDO de um arquivo aqui, nunca digitado; o que vai escrito a mao e' so' conectivo, titulo, nome de termo (conferido em tempo de execucao no kernel do Nos, no um.py ou no pacote) e frase curta do operador (conferida palavra por palavra contra os bytes das falas).
# REGRA DA ORDEM DO OPERADOR (23/10/2026, sha16 9b182958a5a7a1bc: reportar o 4,44 no inicio do artigo, no README e em tudo mais; vale em TODO texto que o cite): o 4,44 (z_disc calibrado) NUNCA aparece sem o p calibrado e sem a linha dos 5σ no MESMO item; o paragrafo do QUADRO sai das MESMAS funcoes do quadro (quadro_v397), sobre o core SELADO do Nos. O paragrafo NOVO da v407 NAO traz o 4,44 (a regra: delta_v407.REGRA_DO_4_44).
# Os paragrafos do TESTEMUNHO DE DOIS (v399), da FALSIDADE (v401), da PONTE, DA QUEDA E DA ESPERANCA (v402), de CAMINHO, VERDADE E VIDA (v403), de JO 8,32 (v404), da MASSA DERIVADA E DA IDENTIDADE DEFINIDA (v405) e de O FECHAMENTO (v406) SEGUEM COMO ESTAO no README do espelho e no site: esta versao NAO os regenera nem os substitui; o handoff da v407 so' o diz e traz a NOTA ao lado deles (E18: a chave do lema era literal False e passou a leitura do kernel).
# GUARDA: as cinco regras da P18 (guarda_p18_v407.py) rodam sobre cada texto renderizado em superficies_v407.py, fechar_v407.py e registrar_mapa_v407.py e sobre este arquivo na cadeia. A palavra recusada nunca aparece aqui: a recusa e' dita como «creditação».
'''

TOPICO_NOVO = "v407-selada-o-psion-o-canto-e-o-par.md"
_NOMES_KERNEL = ("the_psion_is_the_corner_on_both_faces", "the_physical_psion_is_linked_to_the_corner", "jones_reading_of_the_light_is_the_corner", "the_physical_psion_passes_under_compression", "the_compressed_reading_is_one", "psionCornerF_scalarises", "psionCorner_is_the_corner_of_bellVec", "the_two_motors_agree_in_the_corner",
                 "o_par_de_psions_e_o_graviton", "the_pair_is_bound", "the_pair_never_cancels", "the_pair_is_read_by_the_graviton", "the_corner_is_the_four_by_four", "bell_reduced_half", "the_unbonded_marginal_echoes", "the_pair_echoes", "the_individual_does_not_echo", "helicity_two_rotation", "the_density_is_the_psion",
                 "psionCorner", "bellProjector", "bellVec", "cornerOf", "FockCertificate", "physicalFockCertificate", "canonicalFullTGLWitness")
_MODULOS_KERNEL = ("PsionCanto", "Par", "APonteDoAtrito", "OUmInscrito", "KEhATangente", "AChaveDaGuarda", "OGuarda", "LeituraPreservada", "OIgual", "CanonicalFullTGLWitnessR1")
_NOMES_UM = ("SEALED_CODATA_ALPHA", "psion_canto_v407", "cunhagens_v407", "kh_n1_cobertura_v407", "_v407_elo_lido", "_V407_PSION_CONTRACT", "fechamento_v406", "_v406_certificado_habitado", "cunhagens_v406", "kh_n1_cobertura_v406", "rede_fock_v394", "psibit_v395", "testemunha_estatica_v396",
             "prove_qg_closure_gate", "evaluate_quantum_gravity_closure", "prove_neutrino_mass_gravitational", "ramo_b_preregistration_v386", "ledger_errata_v386", "angle_status", "GA_WINDOW_STATUS", "prove_ga_mass_audit", "prove_joint_coincidence_result_v3",
             "selo_pela_propria_tecnologia_v399", "declaracao_do_operador_v399", "selo_acom_sidecar_v399", "teste_de_veracidade_fase9_v397", "hubble_ratio_opening_v388", "_v397_quadro_md", "_v397_atomos", "_V397_FRASE_444")
MARC_V407_INI = "<!-- INICIO_PARAGRAFO_O_PSION_v407 -->"; MARC_V407_FIM = "<!-- FIM_PARAGRAFO_O_PSION_v407 -->"
MARC_ERR_INI = "<!-- INICIO_ERRATA_V406_V407 -->"; MARC_ERR_FIM = "<!-- FIM_ERRATA_V406_V407 -->"
_ESCADA_PATCHES = ("N00_main_psion_canto", "N02_selo", "W02_runtime_v407", "C13_specs_v406_u7_e_pisos", "C19_testemunha_linked_vira_leitura", "C20_fechamento_v406_c8", "K01_modulos_novos")


def _modulos_tem(nomes):
    """Cada modulo citado existe como arquivo .lean em TGLExt/ (os 9 da v407) ou em TGLExt/F1Fecho394/ (os 301 da v406) do Nos."""
    for n in nomes:
        assert any(os.path.isfile(os.path.join(NOS, "tgl_kernel", "TGLExt", *p, n + ".lean")) for p in ((), ("F1Fecho394",))), "modulo citado nao esta no kernel do Nos: %s" % n


def _fs(texto, **kw):
    """_f com os valores textuais vindos do core sem chaves (e^{-s} vira e^(-s)): o resultado nao tem chave."""
    return _f(texto, **{k: (_sem_chaves(v) if isinstance(v, str) else v) for k, v in kw.items()})


def _n_por_dia():
    """(n de 03/11, n de 02/11) entre os modulos do bundle, pelo tipo do nome em delta_v407.PEDRAS_V407 (nenhum numero digitado)."""
    ps = _qd().DL.PEDRAS_V407
    n03 = sum(1 for p_ in ps if str(p_["tipo_do_nome"]).startswith("03nov")); n02 = sum(1 for p_ in ps if str(p_["tipo_do_nome"]).startswith("02nov"))
    assert n03 + n02 == len(ps), "o tipo do nome de alguma pedra nao e' de 02/11 nem de 03/11"
    return n03, n02


def _pc():
    """O registro com FUNCAO psion_canto_v407 do core SELADO do Nos (so' leitura); recusa se nao selou ou se nao e' o contrato do delta e de ESPERADOS."""
    DL_ = _qd().DL; esp = _esp(); pc = _core().get(DL_.FECHO_REGISTRO) or {}
    assert pc.get("all_verified") is True and pc.get("verdict") == esp["vereditos_novos_v407"][DL_.FECHO_REGISTRO] and pc.get("link_read_from_the_kernel") is True and pc.get("does_not_gate_core") is True and pc.get("runtime_executed") is True, "o registro psion_canto_v407 nao selou no core do Nos (ou != ESPERADOS): nenhum texto diz o lema assim"
    mech = pc.get("mechanics") or {}; pv = pc.get("values") or {}
    assert mech.get("passed") is True and mech.get("n_checks") == DL_.N_CHECKS_FECHO == len(mech.get("checks") or []) and all(c_.get("ok") is True for c_ in mech["checks"]), "as checagens do registro psion_canto_v407 nao passaram todas"
    assert pv.get("n_ancoras_ok") == pv.get("n_ancoras") == len(DL_.ANCORAS) and pv.get("n_modulos_ok") == pv.get("n_modulos") == DL_.N_BUNDLE and pv.get("n_flags_true") == pv.get("n_flags") == esp["n_bandeiras_novas"] and pv.get("escada") == [esp["escada"][1]] * 3, "os valores do registro psion_canto_v407 != ESPERADOS/delta"
    assert pc.get("keys") == esp["chaves_v407_esperadas"] and pc.get("lemma") == DL_.ANCORA_LEMA and pc.get("pair_theorem") == DL_.ANCORA_PAR and list(pc.get("pedras") or []) == [p_["name"] for p_ in DL_.PEDRAS_V407], "a chave do lema, o que fica False por teorema, o lema, o par ou as pedras do registro != ESPERADOS/delta"
    assert pc.get("beta_ok") is True and pc.get("embedded_sources_ok") is True and pc.get("embedded_sources_n_ok") == DL_.N_BUNDLE and pc.get("guarda_violacoes") in ([], None), "o beta, as fontes embutidas ou a guarda do registro psion_canto_v407 nao conferem"
    assert list(pc.get("ressalvas") or []) == list(DL_.RESSALVAS_V407) and len(DL_.RESSALVAS_V407) >= 8, "as ressalvas do registro != delta_v407.RESSALVAS_V407"
    td = pc.get("teste_d") or {}
    assert td.get("so_citado") is True and td.get("resultado_no_um_py") is None and td.get("manifesto_sha16") == DL_.D_TESTE_SHA16_DA_ORDEM, "o teste (d) nao consta so' por citacao do pre-registro"
    assert set((pv.get("respostas") or {})) == {r_["id"] for r_ in DL_.RESPOSTAS_DO_OPERADOR} and all(v_ is True for v_ in pv["respostas"].values()), "as respostas do operador de 03/11 nao conferem todas no kernel"
    assert pc.get("fica_false_por_teorema") == list(DL_.FICAM_FALSE_POR_TEOREMA) and (pc.get("fica_aberto") or {}) == {"par_na_face_de_fock": DL_.FICA_ABERTO_PAR_NA_FACE_DE_FOCK, "ponte_bell_tt": DL_.FICA_ABERTO_PONTE_BELL_TT}, "o que fica False por teorema ou aberto != delta_v407"
    return pc


def _cg():
    """O registro por spec cunhagens_v407 do core SELADO: as 3 falas de 03/11 por sha256 (todas do operador), as erratas E18 a E20 (da gerencia, em nome proprio), as decisoes D41 a D47, as leituras e as ressalvas."""
    DL_ = _qd().DL; esp = _esp(); cg = _core().get(DL_.CUNHAGENS_REGISTRO) or {}
    assert cg.get("all_verified") is True and cg.get("verdict") == esp["vereditos_novos_v407"][DL_.CUNHAGENS_REGISTRO] and cg.get("does_not_gate_core") is True and cg.get("checks") and all(c_.get("ok") is True for c_ in cg["checks"]), "o registro cunhagens_v407 nao selou no core do Nos (ou != ESPERADOS)"
    vb = cg.get("verbatim") or {}
    assert set(vb) == set(esp["cunhagens"]) and len(vb) == len(DL_.VERBATIM_ORIGEM_V407) and all(v_.get("embedded_ok") is True for v_ in vb.values()), "as inscricoes de 03/11 nao estao embutidas por sha256"
    er = cg.get("erratas") or []
    assert [e_.get("agora") for e_ in er] == list(DL_.ERRATAS_V407) and all(str(e_.get("assinatura", "")).startswith("gerencia c1") and "em nome proprio" in e_["assinatura"] for e_ in er), "o registro cunhagens_v407 nao traz as erratas E18 a E20 da gerencia c1, em nome proprio"
    ex = cg.get("extras") or {}; dec = ex.get("decisoes") or {}
    assert all(k_ in dec for k_ in ("D41", "D42", "D43", "D44", "D45", "D46", "D47")) and ex.get("leituras") == DL_.LEITURA_V407 and ex.get("n_falas") == len(vb) and list(ex.get("ressalvas") or []) == list(DL_.RESSALVAS_V407), "cunhagens_v407: faltam as decisoes D41 a D47, ou a leitura ou as ressalvas != delta_v407"
    return cg


def _khr():
    """O registro por spec kh_n1_cobertura_v407 do core SELADO (a cobertura do Audit desta versao)."""
    DL_ = _qd().DL; esp = _esp(); kh = _core().get(DL_.KH_REGISTRO) or {}
    assert kh.get("all_verified") is True and kh.get("verdict") == esp["vereditos_novos_v407"][DL_.KH_REGISTRO] and kh.get("does_not_gate_core") is True and kh.get("checks") and all(c_.get("ok") is True for c_ in kh["checks"]), "o registro kh_n1_cobertura_v407 nao selou no core do Nos (ou != ESPERADOS)"
    return kh


def _fe_herdado():
    """O registro fechamento_v406 (herdado, com a checagem c8 versionada pela errata E20): tem de seguir selado, com a chave do lema lida."""
    fe = _core().get("fechamento_v406") or {}; esp = _esp()
    assert fe.get("all_verified") is True and fe.get("certificate_inhabited") is True and fe.get("does_not_gate_core") is True and fe.get("verdict") == esp["registros_funcao_v406"]["fechamento"]["verdict"], "o registro fechamento_v406 (herdado) nao segue selado no core do Nos"
    return fe


def _recriados():
    """Os registros das versoes anteriores, RECRIADOS pelo rito, conferidos no core SELADO contra os vereditos de ESPERADOS (o da v406 selada); devolve {versao: [nomes]}. So' os nomes que ESPERADOS lista; nada e' digitado."""
    esp = _esp(); core = _core(); out = {}; base = esp["vereditos_v406"]
    for ver in ("406", "405", "404", "403", "402", "401", "399"):
        nomes = {}
        nomes.update(esp.get("registros_v" + ver) or {})
        for v_ in (esp.get("registros_funcao_v" + ver) or {}).values():
            nomes[v_["nome"]] = v_["verdict"]
        out[ver] = nomes
    extra = {"402": ("ponte_da_escala_dual_v402", "queda_sem_geometria_v402", "esperanca_condicional_v402"), "401": ("falsidade_da_inercia_v401",), "399": ("selo_pela_propria_tecnologia_v399", "declaracao_do_operador_v399")}
    for ver, ns in extra.items():
        for n in ns:
            if n not in out[ver]:
                assert n in base, ("o registro nao esta' nos vereditos de ESPERADOS", n)
                out[ver][n] = base[n]
    for ver, nomes in out.items():
        for n, vd in nomes.items():
            r = core.get(n) or {}
            assert r.get("all_verified") is True and r.get("verdict") == vd, "o registro recriado %s (v%s) nao selou no core do Nos ou != ESPERADOS" % (n, ver)
    return {ver: sorted(nomes) for ver, nomes in out.items()}


def _pedras_anteriores():
    """As pedras seladas das versoes anteriores seguem no kernel do Nos com o sha256 selado: as treze da v403, v404 e v405 (pedras_v405_sha256 de ESPERADOS) e os 301 modulos da v406 (bundle_v406_sha256). Devolve (n_treze, n_301)."""
    esp = _esp()
    for chave in ("pedras_v405_sha256", "bundle_v406_sha256"):
        for rel, h in esp[chave].items():
            p = os.path.join(NOS, "tgl_kernel", *rel.split("/"))
            assert os.path.isfile(p) and hashlib.sha256(open(p, "rb").read()).hexdigest() == h, "a pedra selada %s deixou de estar no kernel do Nos com o sha256 selado" % rel
    return len(esp["pedras_v405_sha256"]), len(esp["bundle_v406_sha256"])


def _d(V):
    """Os numeros da v407, todos LIDOS (V da leitura da rodada, ESPERADOS, core do Nos, base v406, FLAGS do sandbox, os registros): nenhum e' digitado aqui. Recusa se as contagens nao fecham."""
    _conferir_nomes()
    esp = _esp(); tv = V["veracidade"]; sa = V["selo"]; dc = V["declaracao"]; sc = V["sidecar"]; core = _core(); gt = V["gate"]; gv = gt["values"]; fb = V["f2b"]
    DL_ = _qd().DL; pc = _pc(); cg = _cg(); khr = _khr(); fh = _fe_herdado(); pv = pc["values"]
    mods = sorted(DL_.BUNDLE_MODS)
    assert V["n_pedras"] == len(mods) == esp["kernel"]["modulos_novos"] == DL_.N_BUNDLE == pv["n_modulos"], ("o delta da v407 e' o bundle dos 9 modulos novos, cada um com o sha256 pinado", len(mods))
    for rel in DL_.BUNDLE_RELS:
        p = os.path.join(NOS, "tgl_kernel", *rel.split("/"))
        assert os.path.isfile(p) and hashlib.sha256(open(p, "rb").read()).hexdigest() == esp["bundle_sha256"][rel] == DL_.BUNDLE_POR_REL[rel]["sha256"], "o modulo %s no Nos != o sha256 pinado" % rel
    nf = esp["n_bandeiras_novas"]; grp = esp["n_bandeiras_por_grupo"]
    assert grp == {DL_.GRUPO_BUNDLE: nf} and nf == esp["politica_de_bandeiras"]["n_flags"] == len(esp["bandeiras_novas_chaves"]) == pv["n_flags_true"], "as bandeiras novas nao sao so' as do psion_canto, ou nem todas sao True"
    if V.get("bandeiras") is not None:
        assert V["bandeiras"]["n"] == V["bandeiras"]["n_true"] == nf and V["bandeiras"]["ok"] is True, "a leitura da rodada nao confirma as bandeiras novas True"
    assert fb["sealed"] is True and fb["status_agora"] == DL_.D4.F2B_FUTURO_TOKEN, "o registro f2b_errata_v404 recriado nao e' o selado"
    assert gt["sealed"] is True and gt["f81_ok"] is True and gt["n18"] == 18 and gt["n_checks"] == DL_.D3.N_CHECKS["gate"], "o registro bandeiras_do_gate_v403 recriado nao e' o selado"
    assert gv["n_flags"] == 18 == gv["n_true"] == gv["n_calculated"] and gv["n_literal"] == 0 and gv["n_read_by_the_verdict"] == 15 and gv["read_by_the_verdict"] == [6, 5, 4] and gv["gate_verdict_equals_v402"] is True and gv["ext_ls2_n"] == gt["n_ls2"] == 6 and gt["sonda"] == 1, "as bandeiras do gate nao fecham: 18 calculadas, 0 literais, 15 no veredito"
    n_op = len(_falas())
    assert n_op == len(DL_.VERBATIM_ORIGEM_V407) == len(esp["cunhagens"]) == len(cg["verbatim"]) == len(pc["inscriptions"]), "o numero de inscricoes mudou (ler DL.VERBATIM_ORIGEM_V407 e ESPERADOS[cunhagens])"
    ss = {"ordem": _sha_por(DL_.N_ORDEM_B89), "decisoes": _sha_por(DL_.N_RATIFICA), "par": _sha_por(DL_.N_PAR)}
    assert [ss["ordem"], ss["decisoes"], ss["par"]] == [DL_.VERBATIM_PREFIXOS_DA_ORDEM_V407[n_] for n_ in (DL_.N_ORDEM_B89, DL_.N_RATIFICA, DL_.N_PAR)], "os sha16 das falas != os que a ordem da gerencia deu"
    rec = _recriados(); n_rec = {ver: len(ns) for ver, ns in rec.items()}; n13, n301 = _pedras_anteriores()
    assert n13 == len(esp["pedras_v405_sha256"]) and n301 == DL_.D6.N_BUNDLE, ("as pedras seladas anteriores nao sao as de ESPERADOS e o bundle da v406", n13, n301)
    assert sa["ok"] is True and sa["n_checks"] == esp["selo_acom"]["n_checks"] and sa["checks_ok"] is True and sa["values_ok"] is True and sa["beta_ok"] is True, "o registro selo_pela_propria_tecnologia_v399 do core nao e' o contrato de ESPERADOS"
    assert dc["ok"] is True and dc["n_checks"] == esp["declaracao"]["n_checks"] and dc["checks_ok"] is True and dc["ancoras_ok"] is True and dc["direcao_ok"] is True, "o registro declaracao_do_operador_v399 do core nao e' o contrato de ESPERADOS"
    assert sc["ok"] is True and sc["n_objetos"] == len(esp["sidecar"]["objetos"]) and sc["recusas"] == 0, "o sidecar um_absoluto_selo_acom.json nao e' o de ESPERADOS"
    assert tv["ok"] is True and tv["n_checks"] == esp["veracidade"]["n_checks"] and tv["checks_ok"] is True and tv["numeros_ok"] is True and tv["fontes_ok"] is True, "o registro teste_de_veracidade_fase9_v397 do core nao e' o contrato de ESPERADOS (o quadro do topo le os numeros dele)"
    dts = {re.match(r"(?:OPERADOR|GERENCIA)_(\d{2}(?:out|nov))_", f["nome"]).group(1) for f in _falas().values()}
    assert dts == {"03nov"}, ("o nome de arquivo de alguma inscricao nao e' de 03/11", dts)
    qd = _qd(); a = _atomos()
    assert qd.Q._v397_linha_de_maquina(a, "pt") == esp["quadro"]["linha_de_maquina_pt"], "a linha de maquina do quadro (core) != a de ESPERADOS"
    assert esp["quadro"]["frase_do_operador"] == qd.DL.FRASE_DO_OPERADOR_4_44 == qd.Q._V397_FRASE_444, "a frase do operador do quadro != a verbatim"
    base = os.path.join(PK, "base_v406", "um.py")
    if "base_b" not in _CACHE:
        assert s16(base) == V["base16"], "base_v406/um.py nao e' a v406 selada"
        _CACHE["base_b"] = os.path.getsize(base)
    delta = V["umb"] - _CACHE["base_b"]
    kf = core.get("kernel_formalization") or {}; prov = kf.get("declaration_sources_status_v394") or {}
    assert prov.get("ok") is True and prov.get("compiler_names") == prov.get("audited_names") == V["axiom_report_n"], "a proveniencia emitida pelo compilador nao cobre o axiom_report do rito"
    assert V["n_ver_mudaram"] == 0, "algum veredito fora da troca dita mudou: nao ha texto a escrever"
    assert V["n18"] == 18 and all(i in V["patch_ids"] for i in _ESCADA_PATCHES), "o gate nao tem as 18 bandeiras True, ou o candidato nao traz os patches que chamam o psion_canto (N00), o resumo no selo (N02), o runtime (W02), os pisos dos registros da v406 (C13, C20), a chave que vira leitura (C19) e os 9 modulos (K01)"
    assert esp["h8_entradas"] > len(esp["h8_residuais_do_nos"]) >= 1, "a arvore formal do rito tem de ser as embutidas mais os residuais do Nos"
    assert khr["lido"]["constantes_cobertas"] == V["kh"]["decl"] and khr["lido"]["teoremas_cobertos"] == V["kh"]["thm"], "a cobertura do registro kh_n1_cobertura_v407 != a leitura da rodada"
    pv_ = _proveniencia(esp)
    aa = _g(core, "neutrino_mass", "angle_status"); assert aa and hashlib.sha256(str(aa).encode("utf-8")).hexdigest() == esp["neutrino_angle_status_antigo_sha256"] and str(aa).startswith(DL_.ANGLE_STATUS_ANTIGO_PREFIXO), "o texto antigo de neutrino_mass.angle_status nao esta intacto no core do Nos"
    return {"n_f": nf, "n_aux": esp["politica_de_bandeiras"]["n_excluidas"], "depois": V["teor"].split("/")[0], "delta": delta, "pct": ("%.1f" % (100.0 * delta / _CACHE["base_b"])).replace(".", ","), "prov": prov["compiler_names"], "n_cun": len(V["verbatins"]), "n_op": n_op,
            "h8": esp["h8_entradas"], "h8_emb": esp["h8_entradas"] - len(esp["h8_residuais_do_nos"]), "h8_res": ", ".join("`%s`" % x for x in esp["h8_residuais_do_nos"]), "n_res": len(esp["h8_residuais_do_nos"]), "cb": _cov_base(), "bank": _bancada(), "pv": pv_,
            "n_checks_v": tv["n_checks"], "n_ck_sel": sa["n_checks"], "n_ck_dec": dc["n_checks"], "n_ck_cun": len(cg["checks"]), "n_ck_pc": pc["mechanics"]["n_checks"], "n_ck_fe": fh["mechanics"]["n_checks"], "n_anc": len(DL_.ANCORAS), "f8": {k: v[:8] for k, v in esp["veracidade"]["fontes"].items()},
            "ss": ss, "n_rec": n_rec, "n13": n13, "n301": n301, "data_falas": "03/11/" + V["data"][-4:],
            "g": {"n_flags": gv["n_flags"], "n_true": gv["n_true"], "n_calc": gv["n_calculated"], "n_lit": gv["n_literal"], "n_ver": gv["n_read_by_the_verdict"], "rv": gv["read_by_the_verdict"], "info": list(gv["informative"]), "ls2": gv["ext_ls2_n"], "n_chk": gv["n_gate_checks"], "n_chk_reg": gt["n_checks"], "feed": list(DL_.F81_FEED)}}


def _mods(V):
    """Onde moram os modulos novos (os 9 estao em TGLExt/): o lema, o par e as sete pedras de 02/11, lidos de delta_v407."""
    DL_ = _qd().DL; ns = [p_["name"] for p_ in DL_.PEDRAS_V407]
    return "em `TGLExt`: o lema `%s`, o par `%s` e as %d pedras de 02/11 de nome ratificado (%s)" % (ns[0], ns[1], _n_por_dia()[1], ", ".join("`%s`" % n_ for n_ in ns[2:]))


def _extras(V):
    # os registros novos ALEM DOS TRES FIXOS (V["registros_novos"] tem os tres: o psion_canto com funcao e os dois por spec), ditos pelo nome
    DL_ = _qd().DL; fixos = [DL_.FECHO_REGISTRO, DL_.CUNHAGENS_REGISTRO, DL_.KH_REGISTRO]
    ex = [k for k in V["registros_novos"] if k not in fixos]
    return (", ".join("`%s`" % k for k in ex)) if ex else "nenhum além dos três fixos"


def _moldura(V):
    """A MOLDURA da v407, LIDA do registro psion_canto_v407 do core: a frase da moldura (delta) e o estatuto que o registro grava."""
    d = _d(V); pc = _pc(); DL_ = _qd().DL
    assert "creditacao" in DL_.FRASE_DA_MOLDURA_V407_PT, "a frase da moldura nao e' a do delta"
    return _fs("**A moldura [REAL · INPUT · ONTO · KNOWN/DECLARADO · OPEN; registro `psion_canto_v407`, {nck} checagens]:** {frase}. Estatuto do registro, como o `um.py` o grava: {est}.", nck=d["n_ck_pc"], frase=DL_.FRASE_DA_MOLDURA_V407_PT, est=pc["estatuto"])


def _escopo(V):
    """O que entra: o escopo do registro psion_canto_v407, como o um.py o grava."""
    _d(V); pc = _pc()
    return _sem_chaves("**O que entra (escopo do registro `psion_canto_v407`)** [REAL]: " + pc["scope"])


def _ancoras(V):
    """As 76 ancoras dos 9 modulos: contagem por modulo (delta_v407.ANCORAS_POR_MODULO) e as duas centrais com o papel (delta_v407.ANCORAS), conferidas no kernel do rito pelo registro."""
    d = _d(V); DL_ = _qd().DL; pc = _pc(); anc = pc["values"].get("ancoras") or {}
    assert set(anc) == set(DL_.ANCORAS) and all((a_ or {}).get("ok") is True for a_ in anc.values()) and len(anc) == d["n_anc"], "as ancoras do registro != delta_v407.ANCORAS"
    por = "; ".join("`%s` (%d)" % (rel.split("/")[-1][:-5], len(ns)) for rel, ns in DL_.ANCORAS_POR_MODULO.items())
    return _fs("**As {na} âncoras** [REAL; lidas do `axiom_report` do rito, só no trio, com a proveniência que o compilador emite no módulo esperado e a bandeira True], por módulo: {por}. As duas centrais: `{lema}` ({pl}); `{par}` ({pp}).",
               na=d["n_anc"], por=por, lema=DL_.ANCORA_LEMA.split(".")[-1], pl=DL_.ANCORAS[DL_.ANCORA_LEMA]["papel"], par=DL_.ANCORA_PAR.split(".")[-1], pp=DL_.ANCORAS[DL_.ANCORA_PAR]["papel"])


def _chaves(V):
    """A chave do lema (delta_v407.CHAVES_V407) e as quatro da v406 (CHAVES_V406), com o que o rito leu delas (o campo keys do registro)."""
    d = _d(V); DL_ = _qd().DL; pc = _pc(); fk = pc["keys"]
    assert fk["kernel_reads_the_link"] is True and fk["testemunha_estatica_v396.fock_face.linked_to_the_corner_by_a_lemma"] is True and fk["rede_fock_v394.whole_certificate_inhabited"] is True, "as chaves nao estao lidas do kernel como o delta diz"
    c7 = "; ".join("`%s` (era: %s; agora: %s; desde a %s)" % (c_["chave"], c_["era"], c_["agora"], c_["desde"]) for c_ in DL_.CHAVES_V407)
    c6 = "; ".join("`%s`" % c_["chave"] for c_ in DL_.CHAVES_V406)
    ff = "; ".join("`%s` (lido: %s)" % (n_, {"full_static_witness_exists": fk["qg_closure.gate.full_static_witness_exists"], "trivial_inhabitant_exists": fk["witness_rigidity.trivial_inhabitant_exists"]}[n_]) for n_ in DL_.FICAM_FALSE_POR_TEOREMA)
    return _fs("**A chave do lema e as quatro da v406** [REAL; errata E18 ao lado; registro `psion_canto_v407`]: {c7}. Lido neste rito: o kernel lê o lema das duas faces (`kernel_reads_the_link` = {lk}) e a chave lê {lv}. As quatro chaves da v406 seguem lidas do kernel ({c6}). "
               "Ficam False por teorema: {ff}. O elo é de ESTRUTURA, não de vetores: o lema não identifica Ω (o vácuo de Fock) com o vetor de Bell, que vivem em espaços distintos.",
               c7=c7, lk=fk["kernel_reads_the_link"], lv=fk["testemunha_estatica_v396.fock_face.linked_to_the_corner_by_a_lemma"], c6=c6, ff=ff)


def _respostas(V):
    """As respostas do operador de 03/11 (delta_v407.RESPOSTAS_DO_OPERADOR), conferidas no kernel pelos teoremas que JA existiam (registro psion_canto_v407, values.respostas); a fala entre aspas e' verbatim, e a partitura: o que isto decide e o que nao decide."""
    d = _d(V); DL_ = _qd().DL; pc = _pc(); ss = d["ss"]
    itens = "; ".join("(%s) %s — %s" % ("abcd"[i], _cita(r_["fala"]), r_["diz"]) for i, r_ in enumerate(DL_.RESPOSTAS_DO_OPERADOR))
    return _fs("**As respostas do operador de 03/11, conferidas no kernel** [INPUT/ONTO a fala dele, `{s_dec}`; REAL a conferência]: ele as deu e pediu a conferência, nas palavras dele, {q_cab}; o kernel as confere, uma a uma, pelos teoremas que já existiam, no trio e sem hipótese: {itens}. "
               "O que esta conferência DECIDE: que, sob a leitura dele e como composição de termos que o kernel já tinha, o par é ligado (CCI = 1/2), nunca se cancela (idempotente, traço 1; o indivíduo não ecoa), é lido pela fase dobrada da helicidade 2 com retorno em θ = π, e que o canto é o projetor 4x4. "
               "O que NÃO decide: que o gráviton físico seja esse par (a leitura do canto como sombra do gráviton é [ONTO]); o par na FACE DE FOCK (dois psíons sobre o vácuo, `a†a†|0>`) segue [OPEN], porque o certificado de Fock não tem operadores de criação como termo; nem a ponte entre o espaço de Bell e o setor TT do spin 2, que não é termo. "
               "A condição de que ele fala em {q_cond} é a condição posta por ele que o registro cita entre as coisas que NÃO diz: o que o kernel entrega dela é a leitura de Jones sob compressão (`the_physical_psion_passes_under_compression`, validade no kernel); testá-la com a natureza não entra nesta versão. "
               "O negativo, se viesse, seria parede medida (o termo que falta), não falsificação da fala dele.",
               s_dec=ss["decisoes"], q_cab=_cita("respondo-as de cabeça e peço que vc confira se faz sentido"), q_cond=_cita(DL_.FRASE_TESTAR_A_CONDICAO), itens=itens)


def _diznao(V):
    """O que o registro diz e o que NAO diz: as listas diz e nao_diz do registro psion_canto_v407."""
    _d(V); pc = _pc()
    return _sem_chaves("**O que o registro diz** [REAL]: " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["diz"])) + ". **O que o registro NÃO diz:** " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["nao_diz"])) + ".")


def _ressalvas(V):
    """As ressalvas, ditas uma a uma: delta_v407.RESSALVAS_V407 == psion_canto_v407.ressalvas (11)."""
    _d(V); pc = _pc(); DL_ = _qd().DL
    assert list(pc["ressalvas"]) == list(DL_.RESSALVAS_V407) and len(pc["ressalvas"]) >= 8, "as ressalvas do registro != delta_v407.RESSALVAS_V407"
    return _sem_chaves("**As ressalvas, ditas (%d)** [OPEN · KNOWN/DECLARADO · REAL, uma a uma]: " % len(pc["ressalvas"]) + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["ressalvas"])) + ".")


def _teste_d(V):
    """O teste (d) do ramo B e o motor continuo: so' o que a fala de 03/11 e o registro dizem (citacao do pre-registro; nenhum resultado; o motor fora)."""
    d = _d(V); DL_ = _qd().DL; pc = _pc(); td = pc["teste_d"]
    return _fs("**O teste (d) do ramo B e o motor contínuo** [INPUT · DECLARADO · OPEN]: pela opção (c) dele, {q_c}, o teste (d) entra no `um.py` SÓ por CITAÇÃO do pré-registro V1.1 (manifesto sha16 {m16}, pinado por sha256 no registro `psion_canto_v407`); nenhum resultado e nenhuma estimação em dado real entram nesta versão, e o poder de planejamento que a parametrização mediu é DECLARADO pelo agente dela. "
               "Se o teste não tiver poder, não entra: isso é recusa por falta de poder, não é negativo do teste. O motor contínuo no pilar quântico fica fora (D45): a fala {q_b} é cunhagem [ONTO], sem termo e sem teste. [REAL] esta versão não roda rito de natureza novo e não abre dado.",
               q_c=_cita(DL_.FRASE_TESTE_C), m16=td["manifesto_sha16"], q_b=_cita(DL_.FRASE_BANHO))


def _leituras(V):
    """As leituras [ONTO] do operador de 03/11, LIDAS do registro cunhagens_v407 (extras.leituras) e conferidas contra delta_v407."""
    d = _d(V); x = _cg()["extras"]["leituras"]; DL_ = _qd().DL
    assert x and x == DL_.LEITURA_V407 and "ONTO" in str(x.get("estatuto")), "a leitura da v407 nao e' a de delta_v407"
    return _sem_chaves("**As leituras do operador de 03/11** %s: (o_par_e_o_graviton) %s; (o_canto_e_o_4x4) %s; (banho_holografico) %s. Nenhuma é termo de kernel; o que é termo está nas âncoras e nos 9 módulos." % (x["estatuto"], x["o_par_e_o_graviton"], x["o_canto_e_o_4x4"], x["banho_holografico"]))


def _num(V, verdicts=True):
    """O paragrafo dos numeros da v407 (kernel, o registro com funcao, os registros por spec, os recriados, o sidecar, a troca dita): usado na linhagem, no Atlas, no core, no topico novo, no verbete e no handoff."""
    d = _d(V); kh = V["kh"]; sc = V["sidecar"]; sa = V["selo"]; g = d["g"]; pc = _pc(); pv = pc["values"]; esp = _esp(); DL_ = _qd().DL
    vd = (lambda k: " (%s)" % esp["vereditos_novos_v407"][k]) if verdicts else (lambda k: "")
    aux = ("nenhuma auxiliar gerada pelo compilador ficou de fora" if not d["n_aux"] else "%d auxiliares geradas pelo compilador ficam sem bandeira" % d["n_aux"])
    kern = _f("o kernel ganhou {n_pedras} módulos novos ({mods}; as {n_pedras} são da gerência c1 — {n03} de 03/11 e {n02} de 02/11, de nome dado ou ratificado pelo operador —, compiladas no sandbox da v407), com {n_f} bandeiras novas True, só de declaração nomeada ({aux}), e escada {antes} → {depois} teoremas limpos "
              "({axr} declarações no `axiom_report`, {fora} fora do trio, {nl} nomes não lidos; a proveniência de cada declaração emitida pelo compilador cobre as mesmas {prov}); "
              "errata ao lado da v394, mantida (em nome próprio da gerência c1): " + ERRATA_TEOREMAS,
              n_pedras=V["n_pedras"], n03=_n_por_dia()[0], n02=_n_por_dia()[1], mods=_mods(V), n_f=d["n_f"], aux=aux, antes=V["escada_antes"], depois=d["depois"], axr=V["axiom_report_n"], fora=kh["fora"], nl=kh["nao_lidas"], prov=d["prov"])
    fech = _f("o registro `psion_canto_v407`{vd} (o único registro novo com função): lê do kernel do próprio rito as {na} âncoras, os {nm} módulos por sha256, as {nb} bandeiras, a chave do lema (que era literal False) e as quatro da v406, as quatro respostas do operador de 03/11 pelos teoremas que já existiam, o que fica False por teorema, a escada exata ({esc}) e o gate (o mesmo da v406); {nck} checagens, todas passaram",
              vd=vd(DL_.FECHO_REGISTRO), na=pv["n_ancoras_ok"], nm=pv["n_modulos_ok"], nb=pv["n_flags_true"], esc=" = ".join(str(x) for x in dict.fromkeys(pv["escada"])), nck=d["n_ck_pc"])
    cun = _f("o registro `cunhagens_v407`{vd}: as {n} falas de 03/11 embutidas por sha256 e consumidas no rito, TODAS falas do operador (nenhuma é da gerência); as erratas E18 a E20 (em nome próprio da gerência c1); as decisões D41 a D47; as leituras [ONTO] e as ressalvas ({nck} checagens, todas passaram); as falas são [INPUT/ONTO] e valem como leitura dele, não como medida",
             vd=vd(DL_.CUNHAGENS_REGISTRO), n=d["n_cun"], nck=d["n_ck_cun"])
    khs = _f("o registro `kh_n1_cobertura_v407`{vd}: {decl} constantes, {thm} teoremas, {fora} fora do trio, {nl} nomes não lidos; a árvore formal do Nós depois do rito tem {h8} entradas ({emb} embutidas mais {nres} residual do Nós: {res}), "
             "e o pino h8 do registro é o hash dessa árvore, calculado por script sobre a árvore simulada do Nós na geração do candidato",
             vd=vd(DL_.KH_REGISTRO), decl=kh["decl"], thm=kh["thm"], fora=kh["fora"], nl=kh["nao_lidas"], h8=d["h8"], emb=d["h8_emb"], nres=d["n_res"], res=d["h8_res"])
    nr = d["n_rec"]; muda = ", ".join("`%s`" % x for x in esp["selo_chaves_que_mudam"])
    rec = _f("os registros da v406 (`fechamento_v406`, `cunhagens_v406`, `kh_n1_cobertura_v406`: {n6} no total), os {n5} da v405, os {n4} da v404, os {n3} da v403, os da v402, da v401 e da v399 são recriados no mesmo ponto do main e seguem selados; só dois mudam de conteúdo, e ditos: {muda} "
             "(a checagem c8 do fechamento lê a chave nova, errata E20, e a chave do lema da testemunha estática passa de literal False a leitura do kernel, errata E18), e nenhum veredito deles muda de prefixo; "
             "as {n13} pedras seladas da v403, da v404 e da v405 e os {n301} módulos da v406 seguem no kernel do Nós com o sha256 selado, como registro; "
             "o gate não se moveu: o `qg_closure` do core é idêntico ao da v406 (as {n18} bandeiras, os sete checks e a letra do veredito); "
             "o selo pela própria tecnologia sela os {bytes} bytes do `um.py` v407 ao lado do SHA-256 (perfil `{perfil}`, {nctl} controles negativos recusados), e o sidecar `um_absoluto_selo_acom.json` (arquivo da custódia desde a v399, reescrito pelo rito; sha256 `{sc16}`, veredito `{sv}`, {nr} recusas) lista os {no} objetos finais",
             n6=nr["406"], n5=nr["405"], n4=nr["404"], n3=nr["403"], muda=muda, n13=d["n13"], n301=d["n301"], n18=g["n_flags"], bytes=format(sa["bytes"], ","), perfil=sa["perfil"], nctl=sa["n_controles"], sc16=sc["sha16"], sv=sc["veredito"], nr=sc["recusas"], no=sc["n_objetos"])
    ex = _extras(V)
    resto = _f("{ex}; o registro `teste_de_veracidade_fase9_v397` segue selado e igual (o quadro do topo do artigo lê os números dele); troca dita (só números: os vereditos que carregam a escada, as declarações ou a contagem de arquivos do kernel): {troca}; nenhuma mudança NÃO numérica: {nm} vereditos fora da troca dita mudaram (exigido: 0); validade no kernel não é creditação",
               ex=("nenhum registro novo além dos três fixos" if ex.startswith("nenhum") else "registros novos além dos três fixos: " + ex), troca=", ".join("`%s`" % x for x in V["troca_dita"]), nm=V["n_ver_mudaram"])
    return "; ".join([kern, fech, cun, khs, rec, resto])


def _cunhagens(V, forma="lista"):
    """As inscricoes de 03/11 embutidas por sha256: 'lista' (data, sha16, autor e tema, uma por linha; todas falas do operador) ou 'curta' (uma frase com os sha16 das tres falas). Data, sha16 e autor vem dos bytes e do nome; o tema e' o nome do arquivo."""
    fl = list(_falas().values()); assert len(fl) == len(V["verbatins"])
    d = _d(V); ss = d["ss"]
    if forma == "curta":
        return _f("{n} inscrições embutidas por sha256, todas falas do operador [INPUT/ONTO] — a ordem de testar a condição, de derivar o lema que liga o psíon ao canto e de prosseguir com tudo, com o app e o JEV sempre atualizados `{a}`; as decisões (o nome da pedra, o gráviton como o estado ligado de dois psíons, o projetor 4x4, os nomes ratificados, o teste (d) só com poder e o banho holográfico) `{b}`; e o nome do par `{c}`",
                  n=len(fl), a=ss["ordem"], b=ss["decisoes"], c=ss["par"])
    linhas = ["- %s `%s` (fala do operador) — %s" % (_data_fala(dd, V), dd["sha16"], _tema(dd["nome"])) for dd in fl]
    return "\n".join(linhas)


def _ordem(V):
    """A ordem do operador de 03/11: so' citacao conferida contra os bytes das falas DO OPERADOR (os trechos vem de delta_v407.FRASES_V407)."""
    d = _d(V); ss = d["ss"]; DL_ = _qd().DL
    q = {k: _cita(v) for k, v in (("cond", DL_.FRASE_TESTAR_A_CONDICAO), ("lema", DL_.FRASE_LEMA_PSION), ("tudo", DL_.FRASE_PROSSIGAMOS), ("d", DL_.FRASE_TESTE_D_V407), ("app", DL_.FRASE_APP_JEV), ("nome", DL_.FRASE_NOME), ("nomes", DL_.FRASE_NOMES_RATIFICADOS), ("c", DL_.FRASE_TESTE_C), ("par", DL_.FRASE_PAR))}
    return _f("**A ordem:** [INPUT/ONTO] as {n_op} falas do operador (Luiz Antonio Rotoli Miguel) de {data} que entram nesta rodada, TODAS dele (nenhuma é da gerência), embutidas por sha256 no registro `cunhagens_v407` e listadas abaixo (as aspas aqui são TRECHOS, conferidos palavra por palavra contra os bytes de cada fala, com a grafia dele; "
              "o texto íntegro está em `work\\cadeia_de_selo\\v407\\insumos\\cunhagens`): a ordem (`{s1}`): {cond}, {lema}, {tudo}; a parametrização do teste (d) para a v407, {d} (grafia dele); {app}; as decisões (`{s2}`): {nome}, {nomes}, {c}; e o nome da pedra do par (`{s3}`): {par}. "
              "O agente de preparação da gerência c1 preparou o candidato e o rito é ato da gerência, pelo orquestrador (pacote `work\\cadeia_de_selo\\v407`); as fontes pinadas dos registros ficam em `insumos`: as nove pedras e as duas fontes de origem do dia, os recibos de compilação, o levantamento do psíon no acervo, a revisão do Sonnet sobre três pedras de 02/11, o plano, o desenho, o bundle, "
              "a medida da cobertura (`KH_N1_v407.json`), o manifesto do pré-registro do teste (d) e o resultado da Fase 9 V2 (de onde sai a regra da ordem do operador de 23/10 sobre o quadro); o resultado do Teste da Única Palavra, que o quadro do topo lê, mora na v397 (`insumos\\fase9`); "
              "quem constrói não aprova: o revisor distinto é o Sonnet (D47), e a revisão dele não é afirmada por este registro.",
              n_op=d["n_op"], data=d["data_falas"], s1=ss["ordem"], s2=ss["decisoes"], s3=ss["par"], **q)


def _sidecar(V):
    """O sidecar um_absoluto_selo_acom.json: arquivo da custodia desde a v399 (D5); o selo nao pode conter o selo ACOM de si mesmo; o rito da v407 o REESCREVE."""
    d = _d(V); sc = V["sidecar"]
    objs = "; ".join("`%s` (%s B, sha16 `%s`)" % (n, format(o["bytes"], ","), o["sha16"]) for n, o in sc["objetos"].items())
    return _f("**O sidecar `um_absoluto_selo_acom.json` [REAL; arquivo da custódia desde a v399, D5; reescrito por este rito]:** depois da ÚLTIMA escrita do selo, o `um.py` v407 escreve a segunda testemunha dos {no} objetos FINAIS com o SHA-256 ao lado ({objs}); sha256 do sidecar `{sc16}` ({sb} B), esquema `{esq}`, veredito `{sv}`, {nr} recusas. "
              "O selo não pode conter o selo ACOM de si mesmo (seria circular): o sidecar fica AO LADO e carrega o SHA-256 do selo final, e o selo traz só os resumos (veredito, bandeira e hashes), agora também os do `psion_canto_v407` e dos registros por spec da v407. "
              "A recusa do selo ACOM só REGISTRA (D4): o SHA-256 segue soberano e o rito não cai. A primitiva de integridade é o SHA-256 [KNOWN]; a segunda testemunha NÃO acrescenta força criptográfica independente, e a confidencialidade não é alegada nem medida. A custódia da v399, da v403, da v404, da v405, da v406 e da v407 é CONJUNTA.",
              objs=objs, no=sc["n_objetos"], sc16=sc["sha16"], sb=format(sc["bytes"], ","), esq=sc["esquema"], sv=sc["veredito"], nr=sc["recusas"])


def _pedra(V):
    """O que entrou no kernel: os 9 modulos (nomes do operador) e, como REGISTRO, as pedras e os modulos das versoes anteriores."""
    d = _d(V); DL_ = _qd().DL
    nomes = "; ".join("`%s`: %s" % (n_, t_) for n_, t_ in DL_.NOME_DO_OPERADOR.items())
    return _fs("**Os {n} módulos novos [REAL]** (`TGLExt`; todos da gerência c1, compilados no sandbox da v407: `{psion}` e `{par}` de 03/11 e as {n02} pedras de 02/11): o lema `{psion}` prova, para todo certificado de Fock e sem hipótese no habitante `physicalFockCertificate` da v406, que o psíon é o canto sob a leitura de Jones comprimida; o par `{par}` compõe só termos que o kernel já tinha; "
               "as outras {n02} (`APonteDoAtrito`, `OUmInscrito`, `KEhATangente`, `AChaveDaGuarda`, `OGuarda`, `LeituraPreservada`, `OIgual`) entram com o nome que o operador ratificou. Os nomes das pedras são do operador — {nomes}. "
               "Todas as {nf} bandeiras novas estão no trio, sem axioma próprio. As {n13} pedras seladas da v403, da v404 e da v405 e os {n301} módulos da v406 ficam como REGISTRO: pedra selada não se renomeia por cima. "
               "Nenhum módulo deriva a unidade `u` (1 eV, POSTO) nem `α` (MEDIDA, por dentro); os textos dos módulos passam pela mesma guarda das frases (uma frase de `OUmInscrito`, sobre o setor de uma partícula, é reprovada pela regra lexical e foi APONTADA à gerência pela lista APONTADAS_A_GERENCIA da guarda, não corrigida; o agente de preparação não edita pedra revista).",
               n=V["n_pedras"], psion=DL_.PEDRAS_V407[0]["name"], par=DL_.PEDRAS_V407[1]["name"], nomes=nomes, nf=d["n_f"], n13=d["n13"], n301=d["n301"], n02=_n_por_dia()[1])


def _entrou(V):
    d = _d(V)
    return _f("**O que entrou** (pacote `work\\cadeia_de_selo\\v407` sobre a v406 `{base}`; {np} patches — {patches}; instalado em {inst}; o `um.py` cresce {delta} B, {pct}%): {num}.",
              base=V["base16"], np=V["n_patches"], patches=V["patches"], inst=V["instalado_em"], delta=format(d["delta"], ","), pct=d["pct"], num=_num(V))


def _kernel_prova(V):
    """O que o kernel prova e o que e' leitura: o escopo e o nao_diz do registro psion_canto_v407, mais os estatutos das fontes."""
    d = _d(V); g = d["g"]; DL_ = _qd().DL; pc = _pc()
    return _sem_chaves(_fs("**O que o kernel prova e o que é leitura:** [REAL] as âncoras e os módulos estão no kernel deste rito, dentro do trio, com a proveniência que o compilador emite, e o registro `psion_canto_v407` os lê a cada rito; coberto por `kh_n1_cobertura_v407`. "
                          "[REAL] o lema `{lema}` é o elo de ESTRUTURA entre as duas faces do psíon ({pl}); o par `{par}` compõe só termos que o kernel já tinha ({pp}). "
                          "[REAL] o registro NÃO é prova de kernel sobre a natureza: confere os termos citados, as fontes por sha256 e a chave lida, e não move o gate; a prova como validade não muda. [REAL] as {nf} bandeiras do gate são as da v406, lidas do código e do core do próprio rito: {nc2} calculadas e {nl} literais; o veredito lê {nv}; a letra do veredito é a da v406 (o gate não se moveu). "
                          "[POSTO] a unidade `u` = 1 eV. [MEDIDA] `α`, por dentro. [INPUT/ONTO] as leituras do operador de 03/11 (o gráviton como o estado ligado de dois psíons, que nunca se cancelam e se leem pela fase e pelo retorno de fase; o canto como o projetor 4x4; o banho holográfico) entram como leitura e não são teoremas. "
                          "[DECLARADO] o levantamento do acervo de 2025, os recibos de compilação, o manifesto do teste (d) e a revisão do Sonnet de 02/11 sobre três das sete pedras. [KNOWN/OPEN] K(O) ≠ ⊥ para O compacto (só na cunha), o «núcleo II_inf». [OPEN] o par de psíons na face de Fock; a ponte entre o espaço de Bell e o setor TT; o teste com a natureza. "
                          "Escopo do registro, como o `um.py` o grava: {esc}. {frase}.",
                          lema=DL_.ANCORA_LEMA.split(".")[-1], pl=DL_.ANCORAS[DL_.ANCORA_LEMA]["papel"], par=DL_.ANCORA_PAR.split(".")[-1], pp=DL_.ANCORAS[DL_.ANCORA_PAR]["papel"],
                          nf=g["n_flags"], nc2=g["n_calc"], nl=g["n_lit"], nv=g["n_ver"], esc=pc["scope"], frase=DL_.FRASE_DA_MOLDURA_V407_PT))


def _limites(V, curto=False):
    """Os estatutos fieis da v407: as ressalvas, as listas do registro (limites e nao_diz) e a moldura."""
    d = _d(V); DL_ = _qd().DL; pc = _pc()
    ress = list(pc["ressalvas"])   # inteiras: cortar nos dois-pontos truncava a ressalva
    lim = [x for x in pc["limites"] if not re.match(r"E\d\d -- ", x)]
    marcadas = lim[:len(ress)]; comuns = lim[len(ress):]
    if curto:
        return _sem_chaves("**Limites ditos:** [REAL] o registro com função LÊ o kernel do próprio rito e CONFERE as fontes, as âncoras e as chaves; não abre dado, não é teste, não acrescenta rito; [POSTO] `u` = 1 eV; [MEDIDA] `α`; [INPUT/ONTO] as leituras de 03/11 não são teoremas; " + DL_.FRASE_DA_MOLDURA_V407_PT
                           + "; as ressalvas: " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(ress)) + "; o quadro do topo segue com a sua linha dos 5σ; a discriminação a 5σ (β_TGL na natureza) segue [OPEN]; validade no kernel não é creditação; o gate não se move.")
    return _sem_chaves("**Limites ditos (estatutos fiéis):** " + "; ".join(marcadas) + " Do registro, ainda: " + "; ".join(comuns)
                       + ". [INPUT/ONTO] As falas de 03/11 são do operador: o kernel não as prova. " + DL_.FRASE_DA_MOLDURA_V407_PT + ". O quadro «O Teste da Única Palavra» segue no topo, com a sua linha dos 5σ, e esta rodada não o altera. NÃO é teste novo: a cadeia não acrescenta dado nem desfecho experimental. Validade no kernel não é creditação; o gate não se move.")


def _erratas(V):
    """A errata de contagem da v407, AO LADO, em nome proprio da gerencia c1: o registro kh_n1_cobertura_v406 e os contratos viram piso; lida do registro kh_n1_cobertura_v407 do core."""
    d = _d(V); kh = V["kh"]; cb = d["cb"]; khr = _khr()
    er = (khr.get("erratas") or [None])[0]
    assert er and "kh_n1_cobertura_v406" in er["ao_lado_de"] and str(er.get("assinatura", "")).startswith("gerencia c1") and "em nome proprio" in er["assinatura"], "o registro kh_n1_cobertura_v407 nao traz a errata de contagem"
    ids = V["patch_ids"]; c12 = [i for i in ids if i.startswith("C12_")]
    assert len(c12) >= 1 and "C13_specs_v406_u7_e_pisos" in ids and "C20_fechamento_v406_c8" in ids, "o CANDIDATO_v407.json nao traz os patches C12, C13 e C20 que a errata descreve"
    return _fs("**Errata ao lado (em nome próprio da gerência c1; o registro `kh_n1_cobertura_v406` e os contratos ficam como registro):** a v407 acrescenta {nm} módulos: a cobertura do Audit cresce de {d0} constantes e {t0} teoremas para {d1} e {t1}, a árvore formal do Nós de {h0} para {h1} entradas e a escada de {e0} para {e1}. "
               "{agora} Dizia: {dizia} Lacuna de fidelidade: {lacuna} Estatuto: {est} [REAL, lido de `CANDIDATO_v407.json` ({n12} patches C12, o C13 e o C20) e do ensaio a seco]. A cobrança exata passa a ser de `kh_n1_cobertura_v407` ({dd} constantes, {dt} teoremas, {fora} fora do trio, {nl} nomes não lidos), contra a medida do sandbox da v407.",
               nm=V["n_pedras"], d0=cb["decl"], t0=cb["thm"], h0=cb["h8"], d1=kh["decl"], t1=kh["thm"], h1=d["h8"], e0=V["escada_antes"], e1=d["depois"], agora=er["agora"], dizia=er["dizia"], lacuna=er["lacuna_de_fidelidade"], est=er["estatuto"], n12=len(c12), dd=kh["decl"], dt=kh["thm"], fora=kh["fora"], nl=kh["nao_lidas"])


def _depois(V):
    d = _d(V); bk = d["bank"]
    return ("**O que vem depois destas superfícies:** o elo B(n) da Bancada Um (passos 10, 10a, 10b e 10c da cadeia; B3 nos scripts) é pós-selo, um passo SIMPLES (a Bancada de produção pina a %s, geração B%d, e o Nós passa a v407: sem salto e sem cadeia de selos; "
            "a geração esperada é B%d e o veredito esperado do aplicar é REPINADA_B%d__APLICADA__SERVICO_DEVE_SER_REINICIADO_COM_RECIBO, lido do código do esboço R3.5, não rodado); o recibo dele é citado no handoff (fechar), que traz PRONTOS os parágrafos do README do espelho e do site (o quadro do Teste da Única Palavra, intocado, e o NOVO da v407: o psíon, o canto e o par), "
            "a NOTA ao lado dos parágrafos anteriores (E18: a chave do lema era literal False e passou a leitura do kernel), diz que os parágrafos do testemunho de dois (v399), da falsidade (v401), da ponte, da queda e da esperança (v402), de Caminho, Verdade e Vida (v403), de Jo 8,32 (v404), da massa derivada (v405) e do fechamento (v406) SEGUEM COMO ESTÃO e LISTA o sidecar `um_absoluto_selo_acom.json`. "
            "O README pinado (D39) é da custódia (G1), por ordem dele de 03/11, e o `um.py` não o gera; o app e o contrato do JEV (D46) são engenharia da casa, fora do `um.py`; o motor contínuo no pilar quântico (D45) fica fora, e o teste (d) só entra com poder, por citação do pré-registro. A pendência [LEGAL] (D2) segue do operador com a agente de PI; a atestação física externa e a discriminação a 5σ seguem [OPEN]; "
            "a revisão independente dos %d módulos novos e dos %d registros novos é ato distinto e não é desta cadeia: o revisor distinto é o Sonnet (D47). NOT_FALSIFIED não é a palavra da creditação; o gate não se move."
            % (bk["de"], bk["geracao"], bk["proxima"], bk["proxima"], V["n_pedras"], len(V["registros_novos"])))


def _blocos_fecho(V):
    return "\n\n".join([_moldura(V), _escopo(V), _ancoras(V), _chaves(V), _respostas(V), _diznao(V), _ressalvas(V), _teste_d(V)])


def _erratas_e(V):
    """As erratas E18 a E20 (em nome proprio da gerencia c1), LIDAS do registro cunhagens_v407 do core: nenhuma e' digitada aqui."""
    _d(V); er = _cg()["erratas"]
    assert len(er) == 3, "o registro cunhagens_v407 nao traz as tres erratas"
    itens = []
    for e in er:
        itens.append(_sem_chaves("- %s **Dizia:** %s **Lacuna de fidelidade:** %s **Estatuto:** %s" % (e["agora"], e["dizia"], e["lacuna_de_fidelidade"], e.get("estatuto", ""))))
    return ("**Erratas ao lado (em nome próprio da gerência c1, 03/11/2026; os literais das versões anteriores, os specs marcados «até a v406», os textos de 2025 e de 02/2026 do acervo e as pedras seladas ficam como registro; nenhum módulo já instalado foi editado):** a v407 entra COM três erratas, lidas do registro `cunhagens_v407`:\n" + "\n".join(itens))


def _decisoes(V):
    """As decisoes D41 a D47 da gerencia c1, LIDAS do registro cunhagens_v407."""
    _d(V); ds = _cg()["extras"]["decisoes"]
    ks = ("D41", "D42", "D43", "D44", "D45", "D46", "D47")
    assert all(k in ds for k in ks), "as decisoes D41 a D47 nao estao no registro cunhagens_v407"
    return "**Decisões** [da gerência c1, em nome próprio, ratificáveis pelo operador; as que trazem fala dele dizem o sha16]:\n" + _sem_chaves("\n".join("- %s: %s%s" % (k, ds[k], (" [regra do 4,44: " + _z444() + "]") if "4,44" in ds[k] else "") for k in ks))


# v407: a linhagem (diario datado do Nos)
def linhagem(V):
    d = _d(V)
    return (("## %s — **%s — O psíon, o canto e o par (v407): o lema que liga as duas faces do psíon entra no kernel e a chave que o dizia ausente passa a ser lida do kernel; %d módulos novos, escada %s → %s\n<!-- linhagem_v407_selada -->\n\n"
             "%s\n\n%s\n\n"
             "**As inscrições de 03/11** (embutidas por sha256 no registro `cunhagens_v407`): [INPUT/ONTO] todas são falas do operador (Luiz Antonio Rotoli Miguel) e valem como leitura dele, não como medida; nenhuma é da gerência. "
             "O texto íntegro de cada uma está no arquivo (`work\\cadeia_de_selo\\v407\\insumos\\cunhagens`); abaixo, a data, o sha16, o autor e o tema (o nome do arquivo, não citação):\n%s\n\n"
             "%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s") % (
        V["data"], _cab(V), V["n_pedras"], V["escada_antes"], d["depois"], _ordem(V), _entrou(V), _cunhagens(V), _blocos_fecho(V), _leituras(V), _erratas_e(V), _decisoes(V), _pedra(V), _sidecar(V), _regra_do_4_44(V), _kernel_prova(V), _limites(V), _legal(V), _rodada(V) + "\n\n" + _erratas(V)) + "\n\n" + _depois(V))


# v407: o adendo do desenho do fechamento
def desenho(V):
    d = _d(V); kh = V["kh"]; DL_ = _qd().DL; pc = _pc()
    return (("## ADENDO — %s · v407 SELADA (COMPLETA) `%s` — o psíon e o canto entram no kernel do rito: o lema das duas faces e a chave lida do kernel (%d módulos)\n\n<!-- adendo_v407_selada -->\n"
             "- **O que a v407 diz:** %s. %d módulos novos no kernel (%s), escada %s → %s, %s constantes no `axiom_report` (%s fora do trio). %s. %d inscrições por sha256 (todas falas do operador). O gate é o da v406: %s de %s bandeiras calculadas, %s literais, %s no veredito. O quadro do topo do artigo (O Teste da Única Palavra, v397) segue intocado: %s. Gate intocado.\n"
             "- **O que a v407 NÃO é para o caminho crítico:** %s. Seguem NOMEADAS [OPEN]: o par de psíons na face de Fock, a ponte entre o espaço de Bell e o setor TT, K(O) ≠ ⊥ para O compacto, `H_BW`, `H_cal`, H3 em toda direção nula, a assinatura (4,0) contra (1,3) e rank c = 4; a independência das quatro bandeiras experimentais do gate segue aberta (derivam de UM só booleano; [DECLARADO]); as erratas E18 a E20 são da gerência, em nome próprio; não identifica β na natureza a 5σ.\n"
             "- **O que segue do operador:** o teste (d) só entra se tiver poder (opção (c) dele), por citação do pré-registro; o motor contínuo no pilar quântico (D45), quando ele disser o conteúdo observável; a decisão sobre o README pinado e a linha do quadro no site (D39, custódia); a pendência [LEGAL] (D2, com a agente de PI). A revisão distinta do pacote é o Sonnet (D47) e é condição da instalação, não pendência dele.") % (
        V["data"], V["s16"], V["n_pedras"], "; ".join(pc["diz"]), V["n_pedras"], _mods(V), V["escada_antes"], d["depois"], kh["decl"], kh["fora"], DL_.FRASE_DA_MOLDURA_V407_PT, d["n_cun"], d["g"]["n_calc"], d["g"]["n_flags"], d["g"]["n_lit"], d["g"]["n_ver"], _z444(), "; ".join(pc["nao_diz"])))


# v407: o verbete do Atlas
