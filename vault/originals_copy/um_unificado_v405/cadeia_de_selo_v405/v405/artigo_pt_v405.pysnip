    # v405 (01/11/2026) -- A MASSA DERIVADA E A IDENTIDADE DEFINIDA: oito pedras novas no kernel, com os nomes do operador; os campos das estruturas fecharam; as leituras do operador passaram do campo para a definicao; a leitura fisica nao virou teorema; dadas as entradas, a FORMA e' teorema. Os numeros sao LIDOS dos registros da v405, nunca digitados.
    # O quadro do topo (O Teste da Unica Palavra, v397) fica onde esta: a regra do 4,44 nao se mexe. A secao «A identidade» e' o ensaio do operador, verbatim: a ressalva fica na moldura, nunca dentro do texto dele. Nada aqui move o gate.
    _rg405 = ("ponte_da_massa_v405", "massa_tensao_pura_v405", "identidade_v405", "observador_terminal_v405", "lei_do_diminuto_v405", "tonica_do_hamiltoniano_v405", "disco_de_euler_v405", "ponto_zero_do_psion_v405", "cunhagens_v405", "campos_fechados_e_leituras_v405", "ga_reclassificacao_v405", "gap_v405", "kh_n1_cobertura_v405")
    _ok405 = all((core.get(k_) or {}).get("all_verified") is True for k_ in _rg405)
    _vl405 = lambda k_: (core.get(k_) or {}).get("values") or {}
    _pv405 = _vl405("ponte_da_massa_v405"); _mv405 = _vl405("massa_tensao_pura_v405"); _iv405 = _vl405("identidade_v405"); _ov405 = _vl405("observador_terminal_v405")
    _dv405 = _vl405("lei_do_diminuto_v405"); _tv405 = _vl405("tonica_do_hamiltoniano_v405"); _ev405 = _vl405("disco_de_euler_v405"); _zv405 = _vl405("ponto_zero_do_psion_v405")
    _cg405 = core.get("cunhagens_v405") or {}
    _el405 = core.get("external_ladder") or {}
    _cvr405 = ((core.get("kernel_formalization") or {}).get("axiom_coverage_v392")) or {}
    _i405 = lambda x_: str(x_) if isinstance(x_, int) and not isinstance(x_, bool) else r"\text{n/d}"
    _f405 = lambda x_, n_=6: (("%." + str(n_) + "f") % x_) if isinstance(x_, float) and not isinstance(x_, bool) else r"\text{n/d}"
    _g405 = lambda x_, n_=3: (("%." + str(n_) + "e") % x_).replace("e+", r"\times10^{").replace("e-", r"\times10^{-") + "}" if isinstance(x_, float) and not isinstance(x_, bool) else r"\text{n/d}"
    _tx_405_t = lambda x_: "n/d" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    s.append(r"\section*{A massa derivada e a identidade definida}")
    s.append(r"\addcontentsline{toc}{section}{A massa derivada e a identidade definida}")
    s.append((r"\textbf{Nesta rodada os registros da v405 NÃO selaram todos: o que segue é o enunciado, não um selo.} " if not _ok405 else r"")
             + r"\textbf{O que entra.} Oito pedras novas no kernel, com os nomes do operador: \texttt{TGLExt/PonteDaMassa} (Ponte da Massa), \texttt{TGLExt/MassaTensaoPura} (Massa = tensão pura), \texttt{TGLExt/Identidade} (Identidade), \texttt{TGLExt/ObservadorTerminal} (Observador = terminal), \texttt{TGLExt/LeiDoDiminuto} (Lei do diminuto), \texttt{TGLExt/TonicaDoHamiltoniano} (Tônica do Hamiltoniano), \texttt{TGLExt/DiscoDeEuler} (Disco de Euler) e \texttt{TGLExt/PontoZeroDoPsion} (Ponto Zero do Psíon), com "
             + _i405((_cg405.get("extras") or {}).get("n_bandeiras")) + r" bandeiras, só de declaração nomeada. As pedras e os registros da v404 \emph{ficam como estão}. Oito registros com função, lidos no ponto do rito depois dos três da v404, e as " + _i405(len(_V405_VERBATINS2)) + r" falas de 30/10 a 01/11, embutidas por sha256 (\texttt{cunhagens\_v405}), todas do operador. A escada do kernel lê " + _i405(_el405.get("n_theorems_clean")) + r" de " + _i405(_el405.get("n_theorems_expected"))
             + r"; a cobertura do \texttt{axiom\_report} lê " + _i405(_cvr405.get("decl")) + r" constantes e " + _i405(_cvr405.get("thm")) + r" teoremas, nenhuma fora do trio $\{\texttt{propext},\texttt{Classical.choice},\texttt{Quot.sound}\}$. O número da massa \emph{não muda} (" + _f405(_pv405.get("m_derivada_meV"), 4).replace(".", ",") + r" meV, o mesmo da v404) e o veredito do canal do neutrino \emph{não muda}.")
    s.append(r"\textbf{A moldura: o que fechou e o que entra.} \textsf{[REAL]} Os \emph{campos} das estruturas fecharam: o que era campo livre da transição, da lei, do empréstimo e do disco passou a ser preenchido por construção, e as estruturas ficam como tipos, habitadas (\texttt{transicaoDerivada}, \texttt{leiDerivada}, \texttt{emprestimoDerivado}, \texttt{Disco.doAcoplamento}). As \emph{leituras} do operador passaram do campo para a \emph{definição}: a leitura física não virou teorema. O título da seção vem da fala dele, «derivando a massa e definindo a identidade»: a derivação é da \emph{forma}, dadas as entradas; a leitura física segue leitura. "
             r"O que entra, por estatuto: \textsf{[POSTO]} o 1, $u=1$ eV (\texttt{umPosto}), decisão do operador de 31/10/2026: «o meu um absoluto é o um de 1 eV»; nunca derivado. \textsf{[MEDIDA]} $\alpha$, por dentro (\texttt{TGLCoupling.alpha}; \texttt{alpha\_is\_measured\_from\_within}); nunca derivada: à pergunta «mas você agora consegue derivar a constante da estrutura fina?» a resposta foi não, parede medida, não falsificação; a leitura dele: «não tem teorema para o ângulo de Miguel é a definição de singularidade, a meu ver». "
             r"\textsf{[INPUT/ONTO]} As leituras da cadeia da massa, que entram como definição ou identificação e não são teoremas, numa lista que não é fechada: (1) \texttt{massaDerivada}: massa = energia retida vezes a derivada da projeção transversal; (2) o estado inscrito lido em $\theta=\pi/4$: em \texttt{transicaoDerivada} o ângulo é \emph{escrito}; o kernel confere $\sin^2(\pi/4)=\tfrac12$ e que esse valor é o do peso da face absoluta, coincidência de valor, não ponte; (3) a tônica $(\beta/\alpha)\,u$ (\texttt{tonica}): $\beta/\alpha=\sqrt{e}$ é a definição de \texttt{TGLCoupling.alpha}, e $E_0=u$ é identidade algébrica, que não fixa $u$: o no-go \emph{não} cai, ele se localiza no Um posto; (4) $R=\beta\,u^2$ (\texttt{pagamentoComoCurvatura}), a escolha dimensional de uma unidade só; (5) o meio-tom $e^{-1/2}$ (\texttt{meioTom}): o tom é a nat; (6) a dispersão $\omega^2=2\beta R$ (\texttt{omegaSq}; Tratado, §3, teoria própria); (7) a identificação $\tfrac12\omega=$ massa (o enunciado de \texttt{the\_mass\_is\_the\_zero\_point} iguala números; o nome é leitura); (8) o acoplamento da onda de matéria = a massa inscrita, hipótese de \texttt{area\_por\_volta\_da\_massa\_inscrita}; (9) $b=0$ lido como o fóton; (10) no disco, a taxa de \emph{dephasing} lida como perda de energia; (11) $E_0$ como o valor da tônica modulada (\texttt{modular}); (12) $m_1=0$, entrada da identificação com $\Delta m^2_{21}$; (13) \texttt{tempoDoRetido} lido como o $\tau_\star$ do sistema, a ratificar pelo operador; (14) $\alpha$ lida como a inscrição elétrica que leva o retido à tônica; (15) o ângulo de Miguel como o sistema que dá a medida da tônica por um gap com unidade. \textsf{[INPUT]} Entram ainda, como dados do sistema que lê, o contraste $g$ e o relógio $\kappa$ do empréstimo e, no disco, $K$, $\tau$ e $E_0$. "
             r"\textsf{[REAL]} A forma: dadas essas leituras, $m_2=\beta\sin45^\circ u$ é teorema (\texttt{massa\_derivada\_eq\_form}); o $\tfrac12$ da face absoluta é teorema (\texttt{absolute\_faces\_half}); a unicidade de $\pi/4$ é teorema (\texttt{forty\_five\_unique}); $\tfrac12\cdot\sqrt2=\sin45^\circ$ é aritmética. Em uma frase: um Um posto, uma $\alpha$ medida e as leituras do operador; dadas essas entradas, a FORMA é teorema.")
    s.append(r"\textbf{A Ponte da Massa.} \textsf{[INPUT]} A ordem do operador, em 30/10/2026: «realizar a prova que falta, a ponte». \textsf{[REAL]} A pedra faz da identificação uma definição e prova: a projeção transversal $\sin\theta$ tem derivada $\cos\theta$ e, no ponto autoconjugado, a projeção \emph{é} a sua derivada, e só ali em $[0,\pi/2]$; a energia incidente se reparte sem perda entre o retido ($\beta E_0$) e o transmitido; sob a definição, a massa é a forma do neutrino, $\beta\sin45^\circ E_0$; a leitura proporcional difere da derivada por $\sqrt2$; e, para todo acoplamento, a estrutura é habitada com $E_0=1$, $\theta=\pi/4$ e $m=\beta\sqrt2/2$ (\texttt{a\_transicao\_existe\_para\_todo\_acoplamento}). "
             r"\textsf{[REAL]} Neste rito, com $\beta=\alpha\sqrt{e}=" + _f405(_pv405.get("beta"), 12) + r"$ em tempo de execução (nunca literal): massa $" + _f405(_pv405.get("m_derivada_meV"), 6) + r"$ meV, leitura proporcional $" + _f405(_pv405.get("m_proporcional_meV"), 6) + r"$ meV, $m_\nu$ do programa $" + _f405(_pv405.get("m_nu_meV_core"), 6) + r"$ meV. Esses números são deste rito, não estão no kernel. \textsf{[ONTO]} Que a massa do neutrino \emph{seja} esta grandeza é leitura do operador: a pedra prova que a definição implica a forma, não que a natureza a adota; quem a testa é o rito do neutrino, bilateral, que não muda.")
    s.append(r"\textbf{Massa = tensão pura.} \textsf{[REAL]} A forma genérica $b\,(\sqrt2/2)\,E_0$ anula com $b=0$, e então toda a energia atravessa (\texttt{foton\_sem\_massa}, álgebra da forma); ela se reparte como resíduo, incidente menos transmitido, lido na projeção transversal. \textsf{[ONTO]} $b=0$ é lido como o fóton, que acopla pela energia, não por massa: \texttt{TGLCoupling} exclui $b=0$ e nenhum termo do kernel tem fóton. Sob a leitura \texttt{massaDerivada}, a massa é o produto do acoplamento. \textsf{[REAL]} O período fiel do empréstimo é teorema, $P=2\pi/\kappa$ (\texttt{one\_turn\_gives\_faithful\_period}); a parcela não quita numa volta (para qualquer tempo finito, \texttt{the\_charge\_never\_completes}); e, sob a leitura \texttt{massaDerivada}, o principal é a energia retida $\beta u$ projetada no transversal (\texttt{massa\_e\_tensao\_pura}). \textsf{[REAL]} Neste rito: retida $" + _f405(_mv405.get("retida_eV"), 9) + r"$ eV, transmitida $" + _f405(_mv405.get("transmitida_eV"), 9) + r"$ eV. "
             r"\textsf{[ONTO]} A leitura do empréstimo (massa = principal, $\beta$ = parcela, credor = o acoplamento) foi ratificada pelo operador em 30/10/2026; não é termo de kernel. \textsf{[OPEN]} Da cadeia tensão, atrito, temperatura e magnetismo, os três primeiros têm termo no kernel; o magnetismo não tem.")
    s.append(r"\textbf{A lei do diminuto.} \textsf{[INPUT]} O operador, em 31/10 e 01/11/2026: «ele desce meio tom pinado, essa é a lei», «pra mim o TOm é a NAT», «E0 é igual ler um acorde E0» e «no diminuto vc não desce toda a escala e nem muda o tom da escala, vc apenas modula a tônica». \textsf{[REAL]} O diminuto é modulação, não transposição: só a nota principal desce o meio-tom $e^{-1/2}$ (\texttt{modular}), as demais ficam sustentadas (\texttt{modular\_sustenta}), elas e as razões entre elas ficam (\texttt{modular\_mantem\_a\_escala}: a escala é o que fica parado; a razão à tônica muda, e é a tônica que se move), e nenhum fator leva o acorde ao acorde modulado (\texttt{modular\_nao\_e\_transposicao}): o meio-tom pinado quebra a simetria do acorde, porque separa a tônica das notas sustentadas, mas não quebra a liberdade global. \textsf{[INPUT]} O tom fica, na fala dele: o kernel não tem termo para o tom. \textsf{[REAL]} $E_0$ é o valor da tônica modulada, e $E_0/\text{tônica}=e^{-1/2}$ em todo acorde (\texttt{E0\_relativo\_pinado}, a definição de \texttt{lerE0} dita como razão). Cada intervalo à tônica abre meio-tom (\texttt{razao\_abre\_meio\_tom}), e a nota que estava um tom acima fica em $e^{3/2}$ (\texttt{um\_tom\_vira\_terca\_menor}): «o sistema está operando em terças» é, no kernel, a aritmética $1$ nat $+\ \tfrac12$ nat; a resolução devolve o acorde (\texttt{resolver\_modular}). O meio-tom desfaz exatamente o $\sqrt{e}$; $\beta=\alpha\,e^{1/2}$; dadas as entradas, a forma $m=U\,\alpha\,e^{1/2}\,\sqrt2/2$ é teorema; a oitava não é número inteiro de meios-tons. \texttt{Acorde}, \texttt{transpor}, \texttt{razao} e o teorema da razão vêm do \texttt{AcordeE0.lean} do Kimi (sha256 \texttt{" + _tx_405_t(_dv405.get("acorde_kimi_sha16")) + r"}); \texttt{transpor} multiplica o acorde inteiro pelo mesmo fator e é só a liberdade do no-go. "
             r"\textsf{[INPUT]} A distinção é do operador: «E0 não é absolutamente livre». \textsf{[REAL]} O valor \emph{absoluto} segue livre e o no-go não cai; o valor \emph{relativo} à tônica está pinado; sobra um único grau de liberdade global, a transposição do acorde inteiro. \textsf{[ONTO]} «no harmônico o diminuto é a espera» é leitura do operador; a forma no kernel é \texttt{the\_charge\_never\_completes}. \textsf{[INPUT/ONTO]} O meio-tom (\texttt{meioTom}), a modulação (\texttt{modular}, \texttt{lerE0}) e a tônica $(\beta/\alpha)\,u=\sqrt{e}\,u$ são definições: não trazem informação além do $u$ posto. \texttt{meioTom\_e\_o\_pedagio\_local} e \texttt{meioTom\_e\_a\_face} são igualdades de \emph{valor}, e \texttt{CollapseCostLaw} é \textsf{[INPUT]} no kernel. \textsf{[DECLARADO]} A calibração $\langle K_\partial\rangle_{\mathrm{total}}=1$ nat de 24/06/2026 (\texttt{half\_nat\_araki\_hidden\_hamiltonian}, relatório sha256 \texttt{" + _tx_405_t(_dv405.get("half_nat_sha16")) + r"}) é normalização definicional, $\omega(I)=1$ na base $e$; não é termo do kernel nem medida; fixa intervalos em nat, não a unidade em eV: \texttt{U\_E\_NOT\_DERIVED} fica como está e $m_2$ não muda. \textsf{[OPEN]} Quais são as cinco notas: a pêntada do teorema mestre são cinco componentes, não cinco autovalores. "
             r"\textsf{[REAL]} Neste rito: meio-tom $" + _f405(_dv405.get("meio_tom"), 9) + r"$, tônica $" + _f405(_dv405.get("tonica_eV"), 9) + r"$ eV, $E_0=" + _f405(_dv405.get("E0_eV"), 9) + r"$ eV, massa pela fórmula $" + _f405(_dv405.get("massa_formula_meV"), 6) + r"$ meV. \textsf{[ONTO]} $\alpha$ como a magnitude (cauda) da inscrição no bulk é leitura do operador.")
    s.append(r"\textbf{A Tônica do Hamiltoniano.} \textsf{[REAL]} O no-go: nenhuma função da inscrição fixa $E_0$; a mesma inscrição carrega $E_0=1$ e $E_0=2$ (\texttt{no\_function\_of\_the\_inscription\_fixes\_E0}); o que a forma fixa é a razão: a reescala muda $E_0$ e a massa pelo mesmo fator, e $m/E_0=\beta\sin45^\circ$ não muda (\texttt{the\_ratio\_survives\_the\_rescaling}); a reescala corresponde à transposição do acorde, a liberdade do no-go. Esse no-go \emph{não cai}: ele fala do valor absoluto e se localiza no Um posto. Na lei construída a tônica pousa em $E_0=u$ por identidade algébrica (\texttt{the\_tonic\_lands\_on\_the\_posted\_unit}): quem fixa $E_0$ é o $u$ posto que a tônica carrega; no Um posto, $E_0=1$ e $m=\beta\sqrt2/2$ (\texttt{the\_tonic\_at\_the\_posted\_one}). $\Gamma_B=\beta/\tau$ é a lei canônica lida na frequência do sistema; a rota do monopolo é o horizonte do próprio sistema, tautológica quanto ao valor absoluto. \textsf{[REAL]} Neste rito: $m/E_0=" + _f405(_tv405.get("razao_m_sobre_E0"), 12) + r"$.")
    s.append(r"\textbf{O Ponto Zero do Psíon.} \textsf{[INPUT/ONTO]} A leitura do operador, que entra como definição: $R=\beta\,u^2$, o pagamento lido como curvatura (\texttt{pagamentoComoCurvatura}). \textsf{[INPUT, Tratado §3]} A dispersão $\omega^2=2\beta R$, que entra como definição (\texttt{omegaSq}). \textsf{[KNOWN]} O ponto zero $\tfrac12\hbar\omega$. \textsf{[REAL]} Sob essas definições, $\tfrac12\omega=\beta\sin45^\circ u$, a forma do neutrino (\texttt{the\_mass\_is\_the\_zero\_point}); a coincidência com a projeção transversal é a aritmética $\tfrac12\cdot\sqrt2=\sin45^\circ$; $\hbar\omega=2m$; a cobrança contínua do kernel tende a 1 e é menor que 1 em todo tempo finito. \textsf{[ONTO]} O enunciado iguala números: que $\tfrac12\omega$ \emph{seja} a massa é leitura; Tetelestai é o nome do operador para o limite da cobrança, e ler o que permanece no limite como o ponto zero é leitura dele: nenhum teorema liga os dois. \textsf{[REAL]} Neste rito: $\hbar\omega=" + _f405(_zv405.get("hbar_omega_meV"), 6) + r"$ meV; $\tfrac12\hbar\omega=" + _f405(_zv405.get("meia_hbar_omega_meV"), 6) + r"$ meV; $R=" + _g405(_zv405.get("R_si_m2")) + r"$ m$^{-2}$; comprimento de onda do psíon $" + _g405(_zv405.get("lambda_psion_m")) + r"$ m (números registrados, não vereditos).")
    _gv405 = _vl405("gap_v405")
    s.append(r"\textbf{O gap, ao lado.} \textsf{[INPUT]} O operador, em 01/11/2026: «o sistema físico que fornece a medidade da tônica por ujm gap com unidade e pertence à mesma pêntada é o ângulo de MIguel». \textsf{[ONTO]} Que o ângulo de Miguel seja esse sistema é leitura dele. \textsf{[REAL]} Em qualquer espaço de Hilbert, o lock mínimo $1-P$ sobre um vetor $\Omega$ (\texttt{lockDe}) tem gap espectral 1: vale 0 em $\Omega$ e 1 em todo vetor ortogonal (\texttt{o\_lock\_tem\_gap\_um}). Na unidade posta o gap vale $u$ (\texttt{o\_gap\_com\_unidade}), o $E_0$ da Lei do Diminuto, e a tônica fica meio-tom acima dele. Num estado a um ângulo $\theta$ de $\Omega$ o lock tem valor esperado $\sin^2\theta$ (\texttt{lock\_no\_angulo}); no ângulo de Miguel, $\beta$ (\texttt{lock\_no\_angulo\_de\_miguel}); na unidade posta esse valor esperado é $\Delta=\beta u$, a energia retida (\texttt{retidoNoAngulo}, \texttt{o\_retido\_e\_o\_valor\_esperado\_do\_lock}). $\Delta$ não é gap: é $1/\beta$ vezes menor. \textsf{[REAL, condicional]} O \texttt{HminMic} do kernel é instância desses lemas (\texttt{HminMic\_e\_o\_lock}), condicional a um \texttt{FockCertificate}, que o kernel não habita. \textsf{[REAL]} A tônica é $\Delta/\alpha$ (\texttt{a\_tonica\_e\_o\_retido\_sobre\_alpha}); a massa é a projeção transversal de $\Delta$ (\texttt{a\_massa\_e\_a\_projecao\_do\_retido}); $\omega_\psi=\sqrt2\,\Delta$ (\texttt{o\_psion\_e\_raiz\_de\_dois\_retidos}); e $\sqrt2/\tau=\omega_\psi$ se e só se $\tau=1/\Delta$ (\texttt{a\_frequencia\_do\_sistema\_e\_a\_do\_psion\_iff}). O fecho é \texttt{the\_gap\_closes} (registro \texttt{gap\_v405}). \textsf{[REAL]} Neste rito: $\Delta=" + _f405(_gv405.get("Delta_eV"), 9) + r"$ eV (o gap é " + _f405(_gv405.get("gap_sobre_Delta"), 1) + r" vezes $\Delta$), $\tau=" + _g405(_gv405.get("tau_s")) + r"$ s, $\Gamma_B=" + _g405(_gv405.get("Gamma_B_eV")) + r"$ eV, $Q=\sqrt2/\beta=" + _f405(_gv405.get("Q"), 3) + r"$. \textsf{[ONTO, a ratificar pelo operador]} Ler \texttt{tempoDoRetido} como o $\tau_\star$ do sistema: é tempo próprio, não $t_P$, e não mexe no ramo canônico. "
             r"\textsf{[REAL]} $\kappa$ segue testemunha: $\kappa=F(\alpha,\beta,\theta_M)$ é proibido como objetivo de busca, e $\kappa$ só aparece como hipótese em \texttt{o\_relogio\_do\_retido}. \texttt{U\_E\_NOT\_DERIVED} fica: $\Delta$ carrega $u$, e nada fixa $u$. Medida negativa: sob esta leitura, $E_{\mathrm{fluxo}}=c^5\tau/(4\pi G)$ vale $" + _g405(_gv405.get("E_fluxo_eV")) + r"$ eV: não é $E_0$, e a ponte $E_{\mathrm{fluxo}}=E_0$ do Kimi não vale aqui. \textsf{[OPEN]} Quais são as cinco notas; só se sabe, por fala dele, que o ângulo de Miguel pertence a elas.")
    s.append(r"\textbf{A inscrição e a medida.} \textsf{[ONTO]} O operador, em 01/11/2026: «a inscrição da luz que singulariza o sistema é a eletricidade», e «a origem da medida é a matemática, ou seja, o 1 absoluto, que representa 1 Eletrovolt». \textsf{[REAL]} Dois teoremas existem no kernel: \texttt{zero\_mode\_weight\_is\_one} (o peso $L^2$ de $\tfrac12\,\mathrm{sech}(\kappa/2)$ em toda a reta é 1, faces $\tfrac12$) e \texttt{alpha\_transport} ($\alpha'=-(q/2)\,\alpha$, com $\alpha=\mathrm{sech}(\kappa/2)$ e $q=\tanh(\kappa/2)$: o gradiente é negativo em $\kappa>0$). \textsf{[ONTO, da gerência]} Lê-los como a forma da fala do operador é leitura da gerência. Homônimo, dito: ali \texttt{alphaKappa} não é a $\alpha$ de estrutura fina, e $\kappa$ é a profundidade modular, não o relógio; a palavra cauda não está no teorema. Isso não deriva a unidade.")
    s.append(r"\textbf{O Disco de Euler.} \textsf{[DEF]} O disco é tipado por um invariante $K=\Omega^2E>0$, a lei canônica e a energia inicial; a energia é linear por definição, $E(t)=E_0-c\,t$ com $c=\tfrac12\beta\tau_\star K$, e $\Omega^2=K/E$. \textsf{[REAL]} Dadas essas definições: $\Gamma_\Omega E=c$; antes da parada, $dE/dt=-\Gamma_\Omega E$ (\texttt{the\_flow\_is\_the\_canonical\_law}), isto é, a $E$ definida é uma solução do fluxo; $E(t_0)=0$ em tempo finito (\texttt{stops\_in\_finite\_time}); antes da parada $\Omega^2$ não tem cota (\texttt{frequency\_squared\_unbounded\_at\_the\_stop}); com taxa constante a energia nunca toca o zero; o corte $\hbar\Omega=E$ é, por álgebra, $E^3=\hbar^2K$; a parede nomeada é $K=(e^{1/2}U)^3/\hbar^2$; $\beta$ do disco vem do acoplamento (\texttt{Disco.doAcoplamento}). \textsf{[INPUT/ONTO]} Ler a taxa de \emph{dephasing} como taxa de perda de energia é entrada, não teorema. \textsf{[ONTO]} A inscrição do zero absoluto no infinito e a terceira lei na forma do disco são leituras do operador sobre $\Omega^2$ sem cota, como a energia do corte lida como a ressonância que permanece. \textsf{[OPEN]} $K$, $\tau$ e $E_0$ são dados do disco, e qual é o disco é pergunta do operador: ele respondeu que o sistema que dá a medida da tônica é o ângulo de Miguel, e o invariante $K$ não depende da inclinação, logo o ângulo não fixa $K$; o $K$ que a nota posta de 1 eV exigiria é registrado, $" + _g405(_ev405.get("K_si_para_u_posto_J_s2")) + r"$ J/s$^2$, não escolhido. \textsf{[ONTO]} O disco como condensado psiônico é leitura do operador.")
    s.append(r"\textbf{Observador = terminal.} \textsf{[REAL]} Num modelo finito cujos níveis são rótulos de posição (a pedra não afirma nada sobre o observador humano, a gravidade ou a luz como entidades), sobre a cascata de quatro níveis do kernel: o terminal é só o nível \texttt{gravidade}; a resistência se consome a cada leitura e zera só no terminal; reler no terminal não acrescenta; a fusão é o colapso, e o colapso é um Um posto do kernel: pagou perda (a função não é injetiva) e foi medido antes de ser posto (\emph{medido} é o campo do tipo \texttt{UmPosto}: antes $\neq$ depois); com o par 1=1 $|$ 1=0 os pontos fixos do colapso são exatamente o posto e o abismo; o terminal lê 1 e o abismo lê 0 na leitura binária (\texttt{the\_fixed\_points\_read\_one\_and\_zero}); sem o abismo a fusão leria como pressuposta. Ao lado, o polo $\omega$ do par lê 1 na identidade (\texttt{the\_omega\_pole\_reads\_one}). \textsf{[ONTO]} Homônimo, dito: lá \emph{terminal} é polo do par $\alpha/\omega$, aqui é o nível da cascata; nenhum termo liga os dois, e ligá-los é leitura do operador. A leitura de engenharia, o colapso como ponto terminal da resistência da estrutura, é do operador.")
    s.append(r"\textbf{A pedra Identidade.} \textsf{[REAL]} A pedra prova um fato sobre projeções no estado traço normalizado: $\mathrm{tr}(1)/n=\mathrm{tr}(P)/n$ sse $P=1$ sse ($P=(\mathrm{tr}(P)/n)\cdot1$ e $P\neq0$); o vazio ($P=0$) e a face ($\tfrac12(1+\Gamma)$) não satisfazem a equação. O cálculo confere em " + _i405(_iv405.get("n_nomes")) + r" nomes. \textsf{[ONTO]} Que esse fato \emph{seja} a identidade é leitura do operador, tipada como modelo. O nome é dele: «a pedra passaria a ser identidade». O ensaio dele vem na seção seguinte.")
    s.append(r"\textbf{O Grande Atrator.} \textsf{[DECISÃO da gerência c1, por ordem do operador]} A classe do teste do Grande Atrator mudou, ao lado, de \texttt{A3\_APOSENTADO} para \texttt{A13\_FORMA\_CONDICIONAL\_SEM\_INCERTEZA} (registro \texttt{ga\_reclassificacao\_v405}; a saída iii da ENTREGA 005), porque a auditoria mediu a falha da extensão ao ramo galáctico, não um erro na massa do Grande Atrator: a forma fica viva e condicional à ponte de fonte, à lei radial e à admissibilidade da borda; a janela mantém o veto, não é evidência e não discrimina da RG. A constante, a linha da tabela e a auditoria selada ficam como estão.")
    s.append(r"\textbf{Erratas ao lado (v405).} \textsf{[REAL]} \textbf{E10:} o texto de \texttt{neutrino\_mass.angle\_status} e a errata E7 da v404 continuam no registro; o fator $\sin45^\circ$ tem duas leituras que coincidem na forma (a derivada da projeção transversal e o ponto zero do psíon), e mais uma leitura do mesmo $\sin45^\circ$, por aritmética (\texttt{o\_psion\_e\_a\_projecao\_do\_modo}); e $E_0=u=1$ eV é \textsf{[POSTO]}, não declarado nem derivado. \textbf{E11:} os nomes provisórios e o estatuto declarado de $E_0$ eram verdadeiros na data; o operador pôs a unidade em 31/10 e deu os nomes em 01/11/2026. \textbf{E12} \textsf{[KNOWN/DECLARADO]}\textbf{:} com a energia total, o invariante do disco de Euler real é $K=6Mg^2$; $4Mg^2$ era a conta só com a energia potencial, escrita no adendo 4 do handoff e na pedra antes da errata R2, que agora a guarda ao lado; nenhum número de $K$ é escolhido pelo alvo. "
             r"\textbf{E13} \textsf{[REAL]}\textbf{:} a gerência escreveu, no recibo da nomeação e no adendo 6 do handoff, que a cadeia da massa ficava sem hipótese e que só restavam o Um posto e $\alpha$: isso afirmava demais e foi erro da gerência, em nome próprio. Os campos fecharam; as leituras passaram à definição. Quatro teoremas foram rebatizados antes do selo, porque o nome afirmava mais do que o teorema prova (nenhuma prova mudou por isso): \texttt{a\_transicao\_existe\_para\_todo\_acoplamento}, \texttt{the\_tonic\_lands\_on\_the\_posted\_unit}, \texttt{the\_tonic\_at\_the\_posted\_one} e \texttt{the\_omega\_pole\_reads\_one}; e o disco ganhou \texttt{the\_flow\_is\_the\_canonical\_law}. A revisita da Lei do Diminuto, ordenada pelo operador, corrigiu três coisas: o acorde não estava tipado (o \texttt{AcordeE0.lean} do Kimi o tinha); a frase sobre o no-go errou por excesso e por falta; e a primeira correção leu a segunda metade da lei como transposição, erro da gerência: o diminuto é modulação, e \texttt{transpor} é só a liberdade do no-go.")
    s.append(r"\textbf{Limites.} \textsf{[OPEN]} A unidade $u$ e $\alpha$ não são derivadas; que a massa do neutrino seja a grandeza $m_2$ é leitura \textsf{[ONTO]}, e quem a testa é a natureza (JUNO), não o kernel; qual é o disco; quais são as cinco notas; o magnetismo na cadeia da tensão. Nenhum número foi escolhido por proximidade. A RG é o limite clássico, não rival, e $\beta$ não renormaliza $G$ local. Validade no kernel não é creditação; o gate não se move. O quadro «O Teste da Única Palavra» segue no topo, com a sua linha dos $5\sigma$.")
    s.append(r"\textbf{O fecho.} \textsf{[INPUT]} O operador, em 01/11/2026: «estamos terminando onde tinha que terminar mesmo, derivando a massa e definindo a identidade, isso é a TGL».")
    s.append(r"\textbf{Origem.} \textsf{[REAL]} Linha de máquina, lida do core deste rito: base v404 selada \texttt{" + _V405_CONTRACTS["ponte"]["baseline"]["sha256"][:16] + r"}; registros selados " + ", ".join(k_.replace("_", r"\_") + "=" + ("sim" if (core.get(k_) or {}).get("all_verified") is True else "não") for k_ in _rg405)
             + r"; veredito do canal do neutrino \texttt{" + _tx_405_t((core.get("neutrino_mass") or {}).get("verdict")) + r"} (inalterado).")
    _pa405 = _v405_ensaio_tex(_V405_IDENTIDADE_TXT)
    s.append(r"\section*{" + _pa405[0] + r"}")
    s.append(r"\addcontentsline{toc}{section}{" + _pa405[0] + r"}")
    s.append(r"\textbf{Moldura da seção.} \textsf{[DECLARAÇÃO DO OPERADOR / INPUT; leitura ONTO]} O texto abaixo, entre os dois fios, é do operador, verbatim: a revisão r2 (a forma é da gerência c1; as seis decisões de conteúdo são dele), ratificada por ele em 01/11/2026 («é isso , perfeito, concordo com tudo»); o original como recebido está embutido por sha256 (\texttt{" + _V405_ENSAIO_ORIGINAL_SHA16 + r"}). Não é teorema. A pedra \texttt{TGLExt/Identidade} prova um fato sobre projeções no estado traço; que isso seja a identidade é leitura \textsf{[ONTO]}, tipada como modelo. Esta ressalva fica aqui, fora do texto dele.")
    s.append(r"\medskip\hrule\medskip")
    s.extend(_pa405[1:])
    s.append(r"\medskip\hrule\medskip")
