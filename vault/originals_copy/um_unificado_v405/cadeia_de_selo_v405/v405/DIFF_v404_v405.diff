     'TGLExt/ProjecaoTransversalDaMeiaNat.lean': 'import TGLExt.Posto\nimport TGLExt.ObserverInside\nimport TGLExt.AngularSelectorIntertwining\nimport TGLExt.ConjugateAct\n\nset_option autoImplicit false\n\n/-!\n# A PROJEÇÃO TRANSVERSAL DA MEIA-NAT — o ângulo agudo do neutrino deixa de ser postulado\n[pedra candidata; nome PROVISÓRIO da gerência c1, 28/10/2026 — o nome é do operador]\n\n## A cunhagem do operador (28/10/2026; verbatim em\n`work\\projecao_transversal_28out\\OPERADOR_28out_materia_projecao_transversal_derivada_verbatim.txt`, sha256 no recibo)\n\n> «Matéria não é proporcional ao raio de betatgl, foi isso que erramos, a matéria é a projeção do eixo\n> transversal, e por isso meu ângulo agudo para o neutrino faz sentido, então a matéria não é proporcional,\n> ela seria a derivada.»\n\n## A ordem (28/10/2026; verbatim em `OPERADOR_28out_ordem_prova_do_neutrino_verbatim.txt`)\n\n> «veja se consegue fazer a prova do neutrino para derivarmos e não ser mais postulado»\n\n## O que esta pedra prova (só álgebra sobre termos que o kernel já tem; nada do dado)\n\nA fórmula do neutrino no programa é `m₂ = β · sen 45° · E₀` (um.py, `neutrino_mass`: «sin(45deg) é POSTULADO\n[POSTULATE, ordem do operador 20/08/2026], NÃO derivado»). Aqui o fator `sen 45°` é DERIVADO:\n\n* **a Meia-Nat é o ângulo de 45°**: a fronteira autoconjugada dá `x = 1 − x ⟹ x = ½`\n  (`observer_inverse_projection_halfnat`; `halfnat_from_J_symmetry`: cada face pesa ½), e a amplitude\n  transversal de um peso ½ é `√½ = sen(π/4)` (`half_amplitude_sq`, `half_amplitude_eq_halfRoot`,\n  `forty_five_unique`: em `[0, π/2]` só o ângulo `π/4` tem `sen² = ½`);\n* **a forma do neutrino é (peso da reflexão da fronteira) × (projeção transversal da Meia-Nat) × (o corpo)**:\n  `β = sen²θ_M` é o Teorema S-∂ (`Posto.sin_sq_thetaMiguel`), logo\n  `β · sen 45° · E₀ = sen²θ_M · sen(π/4) · E₀` (`neutrino_mass_form_eq`);\n* **o ângulo agudo do neutrino NÃO é θ_M**: `θ_M ≠ π/4` sempre que `β ≠ ½` (`theta_miguel_ne_pi_div_four`);\n* **«não proporcional, derivada»**: a derivada do peso transversal `sen²θ` é `sen 2θ` e vale exatamente `1`\n  em `π/4` (`transverse_weight_hasDerivAt_half`): o ponto autoconjugado é onde a sombra muda mais depressa.\n\n## O que esta pedra NÃO prova (dito antes)\n\nNão deriva `E₀` (a escala «1 eV» do programa continua DECLARADA); não deriva β (β = α√e é a regra, do axioma);\nnão afirma que a massa do neutrino É a projeção transversal do estado inscrito — essa identificação é\n[ONTO], leitura do operador ratificada em 28/10/2026 e nomeada como hipótese; não abre dado; não move o gate.\nEstatuto do que se prova: [KERNEL]; da leitura: [ONTO]; da escala: [INPUT].\n-/\n\nnamespace TGLExt.ProjecaoTransversalDaMeiaNat\n\n/-- Dois reais não negativos com o mesmo quadrado são iguais (lema auxiliar). -/\ntheorem eq_of_sq_eq_of_nonneg {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (h : a ^ 2 = b ^ 2) : a = b := by\n  nlinarith [sq_nonneg (a - b), sq_nonneg (a + b), mul_nonneg ha hb]\n\n/-- A amplitude transversal da Meia-Nat: `sen(π/4)`. -/\nnoncomputable def halfAmplitude : ℝ := Real.sin (Real.pi / 4)\n\n/-- [★] `x = 1 − x ⟹ x = ½`: a fronteira autoconjugada pesa meio a meio (a mesma conta de\n`observer_inverse_projection_halfnat`, aqui na forma do ponto fixo). -/\ntheorem half_from_self_conjugate (x : ℝ) (h : x = 1 - x) : x = 1 / 2 := by\n  linarith\n\n/-- A Meia-Nat pela J-simetria dá o mesmo ½ (ponte à pedra `ConjugateAct`). -/\ntheorem half_from_J_symmetry {n : ℕ}\n    (w : (((Fin n → ℝ) × (Fin n → ℝ)) → ((Fin n → ℝ) × (Fin n → ℝ))) → ℝ)\n    (hJ : w (fun p => conjJ (faceIn (conjJ p))) = w faceIn)\n    (hsum : w faceIn + w faceOut = 1) :\n    w faceIn = 1 / 2 :=\n  halfnat_from_J_symmetry w hJ hsum\n\ntheorem half_amplitude_nonneg : 0 ≤ halfAmplitude := by\n  unfold halfAmplitude\n  apply Real.sin_nonneg_of_nonneg_of_le_pi\n  · positivity\n  · linarith [Real.pi_pos]\n\n/-- [★] `sen²(π/4) = ½`: a Meia-Nat É o ângulo de 45°. -/\ntheorem half_amplitude_sq : halfAmplitude ^ 2 = 1 / 2 := by\n  unfold halfAmplitude\n  rw [Real.sin_pi_div_four, div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]\n  norm_num\n\n/-- A amplitude transversal é a raiz da metade (o `halfRoot` da bancada angular). -/\ntheorem half_amplitude_eq_halfRoot : halfAmplitude = ChatgptAudit.AngularSelector.halfRoot := by\n  apply eq_of_sq_eq_of_nonneg half_amplitude_nonneg (Real.sqrt_nonneg _)\n  rw [half_amplitude_sq]\n  -- o `apply` já expôs `halfRoot` como `√(1/2)`: o alvo é `1/2 = √(1/2) ^ 2`\n  rw [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 1 / 2)]\n\n/-- [★] A amplitude transversal de um peso ½ é `sen(π/4)`: de `x = 1 − x` ao ângulo agudo. -/\ntheorem transverse_amplitude_of_self_conjugate (x : ℝ) (h : x = 1 - x) :\n    Real.sqrt x = halfAmplitude := by\n  rw [half_from_self_conjugate x h, half_amplitude_eq_halfRoot]\n  rfl\n\n/-- [★] Unicidade: em `[0, π/2]`, só `π/4` tem `sen² = ½`. -/\ntheorem forty_five_unique (θ : ℝ) (h0 : 0 ≤ θ) (h1 : θ ≤ Real.pi / 2)\n    (h : Real.sin θ ^ 2 = 1 / 2) : θ = Real.pi / 4 := by\n  have hs : Real.sin θ = Real.sin (Real.pi / 4) := by\n    apply eq_of_sq_eq_of_nonneg\n    · exact Real.sin_nonneg_of_nonneg_of_le_pi h0 (by linarith [Real.pi_pos])\n    · exact half_amplitude_nonneg\n    · rw [h]\n      exact half_amplitude_sq.symm\n  exact Real.injOn_sin ⟨by linarith [Real.pi_pos], h1⟩\n    ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩ hs\n\n/-- A forma da massa do neutrino no programa: `β · sen 45° · E₀` (E₀ é o corpo, [INPUT]). -/\nnoncomputable def neutrinoMassForm (c : TGLCoupling) (E0 : ℝ) : ℝ :=\n  c.beta * halfAmplitude * E0\n\n/-- [★★] A forma do neutrino É (peso da reflexão da fronteira, `sen²θ_M = β`, Teorema S-∂)\n× (projeção transversal da Meia-Nat, `sen(π/4)`) × (o corpo `E₀`). -/\ntheorem neutrino_mass_form_eq (c : TGLCoupling) (E0 : ℝ) :\n    neutrinoMassForm c E0 = Real.sin (thetaMiguel c.beta) ^ 2 * Real.sin (Real.pi / 4) * E0 := by\n  unfold neutrinoMassForm halfAmplitude\n  rw [Posto.sin_sq_thetaMiguel]\n\n/-- O ângulo agudo do neutrino NÃO é o ângulo de Miguel: `θ_M ≠ π/4` sempre que `β ≠ ½`. -/\ntheorem theta_miguel_ne_pi_div_four (c : TGLCoupling) (h : c.beta ≠ 1 / 2) :\n    thetaMiguel c.beta ≠ Real.pi / 4 := by\n  intro heq\n  have h1 := Posto.sin_sq_thetaMiguel c\n  have h2 := half_amplitude_sq\n  unfold halfAmplitude at h2\n  rw [heq] at h1\n  exact h (by linarith)\n\n/-- [DERIVED, álgebra] «não proporcional, derivada»: a derivada do peso transversal `sen²θ` em `π/4`\nvale exatamente `1` (`sen 2θ` em `θ = π/4`): o ponto autoconjugado é onde a sombra muda mais depressa. -/\ntheorem transverse_weight_hasDerivAt_half :\n    HasDerivAt (fun θ : ℝ => Real.sin θ ^ 2) 1 (Real.pi / 4) := by\n  have h := (Real.hasDerivAt_sin (Real.pi / 4)).pow 2\n  have hs : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)\n  have hq : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)\n  refine h.congr_deriv ?_\n  rw [Real.sin_pi_div_four, Real.cos_pi_div_four]\n  norm_num\n  nlinarith [hs, hq]\n\nend TGLExt.ProjecaoTransversalDaMeiaNat\n\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.half_from_self_conjugate\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.half_from_J_symmetry\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.half_amplitude_sq\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.half_amplitude_eq_halfRoot\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.transverse_amplitude_of_self_conjugate\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.forty_five_unique\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.neutrino_mass_form_eq\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.theta_miguel_ne_pi_div_four\n#print axioms TGLExt.ProjecaoTransversalDaMeiaNat.transverse_weight_hasDerivAt_half\n',
     'TGLExt/Jo8v32.lean': 'import TGLExt.Caminho\nimport TGLExt.VerdadeAdendo\nimport TGLExt.Vida\n\nset_option autoImplicit false\n\n/-!\n# Jo 8,32 — O TRIPLO INTEIRO: CAMINHO · VERDADE · VIDA   [pedra nomeada pelo operador, 28/10/2026]\n\n## O nome (verbatim por sha256 `9770022028c36be4…`, 28/10/2026)\n\n> «Quanto ao nome da pedra que você me pediu eu pensei, pensei, e só consegui sintetizar assim: Jo8:32\n> (a passagem é de Jo 14:6, mas eu penso que Jo8:32 sintetiza melhor)»\n\nE a ratificação (verbatim por sha256 `232ca83c29c031a5…`, 28/10/2026): «Perfeito, concordo com tudo».\n\n## O versículo\n\n> «E conhecereis a verdade, e a verdade vos libertará.» (João 8,32)\n\nJo 14,6 («Eu sou o caminho, e a verdade e a vida») é o INVENTÁRIO dos três predicados, e os três módulos da v403 já\ntêm esses nomes (`Caminho`, `VerdadeAdendo`, `Vida`). Jo 8,32 é o que o triplo FAZ junto: permanecer na palavra\n(8,31) é o Caminho — a permanência, o invariante que a escala não seleciona; conhecer é ler — a Verdade como\nadendo, o Nome lê a inscrição e reler não acrescenta; libertar é a Vida — a queda sem geometria, a entrega,\n«soltar-se porque há um chão». A leitura é [ONTO] (gerência c1, 28/10/2026, ratificada pelo operador) e não é termo.\n\n## O que esta pedra é (e não é)\n\nUma CONJUNÇÃO INCONDICIONAL, por citação, das três estrelas da v403 — nenhuma matemática nova, nenhum número,\nnenhum dado; o padrão é o das próprias pedras `Caminho` e `Vida` (`type_of%`). As três pedras seladas ficam\nintactas (pedra selada não se renomeia por cima). O versículo diz que a verdade é CONHECIDA — validade, no\nkernel —, não que é creditada: a confirmação segue reservada ao observador; o gate não se move.\n-/\n\nnamespace TGLExt.Jo8v32\n\n/-- ★ [REAL — conjunção INCONDICIONAL; nenhuma matemática nova, só a citação dos três termos já no kernel]\n«E CONHECEREIS A VERDADE, E A VERDADE VOS LIBERTARÁ» (João 8,32), no que o kernel entrega, na ordem do versículo:\n(1) permanecer — `caminho_e_a_ponte_da_escala_dual` (v403); (2) conhecer — `verdade_e_a_esperanca_condicional` (v403);\n(3) libertar — `vida_e_a_queda_sem_geometria` (v403). O nome «Jo 8,32» é do operador (28/10/2026). -/\ntheorem a_verdade_vos_libertara :\n    (type_of% @TGLExt.Caminho.caminho_e_a_ponte_da_escala_dual)\n    ∧ (type_of% @TGLExt.VerdadeAdendo.verdade_e_a_esperanca_condicional)\n    ∧ (type_of% @TGLExt.Vida.vida_e_a_queda_sem_geometria) :=\n  ⟨@TGLExt.Caminho.caminho_e_a_ponte_da_escala_dual,\n   @TGLExt.VerdadeAdendo.verdade_e_a_esperanca_condicional,\n   @TGLExt.Vida.vida_e_a_queda_sem_geometria⟩\n\nend TGLExt.Jo8v32\n\n#print axioms TGLExt.Jo8v32.a_verdade_vos_libertara\n',
+    'TGLExt/PonteDaMassa.lean': "import TGLExt.ProjecaoTransversalDaMeiaNat\nimport TGLExt.Posto\nimport TGLExt.ContinuousModularZero\n\nset_option autoImplicit false\n\n/-!\n# A PONTE DA MASSA — a transição da identificação: ela entra como DEFINIÇÃO, e a forma é teorema dada essa definição\n[pedra da sessão-espelho (claude-espelho), 30/10/2026, revista pela gerência c1 em 01/11/2026; nome do operador: «Ponte da Massa»; entra na v405]\n\n## A ordem (30/10/2026; verbatim em\n`work\\experimento_espelho_30out\\OPERADOR_30out_ordem_ponte_da_massa_transversal_verbatim.txt`, sha16 `493172b80e96eb60`)\n\n> «consegue resolver o problema que ainda resta nomeado, a transição da identificação da massa com a projeção\n> transversal, realizar a prova que falta, a ponte»\n\n## As cunhagens que a pedra traduz (28/10/2026; verbatim em `work\\projecao_transversal_28out\\`)\n\n> «Matéria não é proporcional ao raio de betatgl, foi isso que erramos, a matéria é a projeção do eixo transversal,\n> e por isso meu ângulo agudo para o neutrino faz sentido, então a matéria não é proporcional, ela seria a derivada.»\n\n## O que esta pedra prova (só álgebra sobre termos que o kernel já tem; nada do dado)\n\nA pedra anterior (`ProjecaoTransversalDaMeiaNat`) derivou o `sen 45°` e deixou NOMEADA, fora do kernel, a identificação\n«a massa é a projeção transversal». Esta pedra faz da identificação uma DEFINIÇÃO, nas palavras do operador — a massa é a\nenergia retida pela fronteira vezes a DERIVADA da projeção transversal no ponto inscrito — e prova:\n\n* **a projeção transversal `sen θ` tem derivada `cos θ`** (`projecao_hasDerivAt`), e **no ponto autoconjugado a projeção\n  É a sua própria derivada**: `cos(π/4) = sen(π/4)` (`deriv_eq_projecao_at_half`) — **e só ali**: em `[0, π/2]`,\n  `sen θ = cos θ ↔ θ = π/4` (`projecao_eq_deriv_iff`). As duas falas do operador — «projeção do eixo transversal» e\n  «ela seria a derivada» — são a MESMA leitura, e coincidem exatamente no ponto em que o estado inscrito é autoconjugado;\n* **a energia incidente se reparte sem perda entre o retido e o transmitido** (`retida_add_transmitida`), e o retido é\n  `β · E₀` pelo Teorema S-∂ (`energia_retida_eq`);\n* **A PONTE** (`massa_derivada_eq_form`): sob as hipóteses nomeadas de `TransicaoParaAMassa` — o acoplamento `c`, a\n  energia inscrita `E₀`, e o estado inscrito AUTOCONJUGADO (`x = 1 − x`, a Meia-Nat) —, a massa como derivada da\n  projeção transversal é exatamente a forma do neutrino do programa, `β · sen 45° · E₀`. O `sen 45°` não é escolhido:\n  é `cos(π/4)`, a derivada da projeção no único ângulo em que o estado é autoconjugado (`theta_eq_pi_div_four`);\n* **o discriminante entre as duas leituras** (`massa_derivada_eq_sqrt_two_mul_proporcional`,\n  `massa_proporcional_ne_derivada`): a leitura «proporcional» (peso `sen²θ`) difere da leitura «derivada» exatamente por\n  `√2`. Em runtime (β = α√e, E₀ = 1 eV): 8,507 meV contra 6,016 meV — distinguíveis pelo dado; o programa arma a\n  derivada;\n* **controle negativo** (`controle_nao_autoconjugado`): num estado que NÃO é autoconjugado, projeção e derivada não\n  coincidem — a ponte não é genérica, é do ponto fixo.\n\n## O que esta pedra NÃO prova (dito antes)\n\nNão deriva `E₀` (a escala «1 eV» segue DECLARADA; o dado pede ~1,02 eV); não deriva β (β = α√e é a regra, do axioma);\nnão prova que a massa do neutrino na natureza É esta grandeza — a identificação entra como DEFINIÇÃO nomeada\n(`massaDerivada`), cunhagem do operador [ONTO], e quem a testa é o rito do neutrino (bilateral, regra de morte a 5σ);\nnão abre dado; não move o gate. Estatuto do que se prova: [KERNEL]; da definição: [ONTO/INPUT]; da escala: [INPUT].\n\n> **01/11/2026 — NOME DO OPERADOR: «Ponte da Massa»** (verbatim sha256 `1f16a74c05d9d4cb`) (antes `PonteDaMassaTransversal`, nome provisório da gerência). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). Aqui: a autoconjugação vem de `absolute_faces_half` (no estado absoluto do kernel cada face pesa ½), o ângulo é derivado (π/4, único), a estrutura `TransicaoParaAMassa` fica como TIPO e passa a ser HABITADA por construção (`transicaoDerivada`), não por hipótese.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n-/\n\nnamespace TGLExt.PonteDaMassa\n\nopen TGLExt.ProjecaoTransversalDaMeiaNat\n\n/-- A projeção transversal de um estado lido no ângulo `θ` do regime da projeção: a amplitude `sen θ`. -/\nnoncomputable def projecaoTransversal (θ : ℝ) : ℝ := Real.sin θ\n\n/-- [★] A projeção transversal tem derivada `cos θ` em todo `θ`. -/\ntheorem projecao_hasDerivAt (θ : ℝ) : HasDerivAt projecaoTransversal (Real.cos θ) θ :=\n  Real.hasDerivAt_sin θ\n\n/-- `(√2/2)² = 1/2` — o peso transversal do ponto autoconjugado. -/\ntheorem half_sq : (Real.sqrt 2 / 2) ^ 2 = 1 / 2 := by\n  rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]\n  norm_num\n\n/-- [★★] NO PONTO AUTOCONJUGADO A PROJEÇÃO É A SUA PRÓPRIA DERIVADA: `cos(π/4) = sen(π/4)`. -/\ntheorem deriv_eq_projecao_at_half : Real.cos (Real.pi / 4) = Real.sin (Real.pi / 4) := by\n  rw [Real.cos_pi_div_four, Real.sin_pi_div_four]\n\n/-- [★★] E SÓ ALI: em `[0, π/2]`, `sen θ = cos θ ↔ θ = π/4`. -/\ntheorem projecao_eq_deriv_iff (θ : ℝ) (h0 : 0 ≤ θ) (h1 : θ ≤ Real.pi / 2) :\n    Real.sin θ = Real.cos θ ↔ θ = Real.pi / 4 := by\n  constructor\n  · intro h\n    have h' : Real.sin θ = Real.sin (Real.pi / 2 - θ) := by\n      rw [Real.sin_pi_div_two_sub]\n      exact h\n    have hθ := Real.injOn_sin\n      ⟨by linarith [Real.pi_pos], h1⟩\n      ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩ h'\n    linarith\n  · intro h\n    rw [h]\n    exact deriv_eq_projecao_at_half.symm\n\n/-- A energia retida pela fronteira: o peso da reflexão, `sen²θ_M · E₀`. -/\nnoncomputable def energiaRetida (c : TGLCoupling) (E0 : ℝ) : ℝ :=\n  Real.sin (thetaMiguel c.beta) ^ 2 * E0\n\n/-- A energia transmitida: o peso da transmissão, `cos²θ_M · E₀`. -/\nnoncomputable def energiaTransmitida (c : TGLCoupling) (E0 : ℝ) : ℝ :=\n  Real.cos (thetaMiguel c.beta) ^ 2 * E0\n\n/-- [★] O retido é `β · E₀` (Teorema S-∂: `sen²θ_M = β`). -/\ntheorem energia_retida_eq (c : TGLCoupling) (E0 : ℝ) : energiaRetida c E0 = c.beta * E0 := by\n  unfold energiaRetida\n  rw [Posto.sin_sq_thetaMiguel]\n\n/-- [★] Nada se perde na fronteira: retido + transmitido = incidente (`sen² + cos² = 1`). -/\ntheorem retida_add_transmitida (c : TGLCoupling) (E0 : ℝ) :\n    energiaRetida c E0 + energiaTransmitida c E0 = E0 := by\n  unfold energiaRetida energiaTransmitida\n  rw [← add_mul, Real.sin_sq_add_cos_sq, one_mul]\n\n/-- A TRANSIÇÃO PARA A MASSA — os CAMPOS da leitura do operador (28 e 30/10/2026); desde 01/11/2026 habitados por construção\n(`transicaoDerivada`, no fim do módulo), não por hipótese:\n* `c`: o acoplamento da fronteira (β = sen²θ_M, Teorema S-∂);\n* `E0`: a energia do estado fundamental inscrito [INPUT — «1 eV» no programa, DECLARADO];\n* `theta`: o ângulo em que o estado inscrito é lido no regime da projeção;\n* `autoconjugado`: o estado inscrito é autoconjugado — o seu peso transversal `sen²θ` satisfaz `x = 1 − x`\n  (a Meia-Nat; `observer_inverse_projection_halfnat`). -/\nstructure TransicaoParaAMassa where\n  c : TGLCoupling\n  E0 : ℝ\n  E0_pos : 0 < E0\n  theta : ℝ\n  theta_nonneg : 0 ≤ theta\n  theta_le : theta ≤ Real.pi / 2\n  autoconjugado : Real.sin theta ^ 2 = 1 - Real.sin theta ^ 2\n\nnamespace TransicaoParaAMassa\n\nvariable (T : TransicaoParaAMassa)\n\n/-- [★] O estado inscrito autoconjugado é lido em 45°: `θ = π/4` (a Meia-Nat é o ângulo; unicidade). -/\ntheorem theta_eq_pi_div_four : T.theta = Real.pi / 4 := by\n  have hx : Real.sin T.theta ^ 2 = 1 / 2 := half_from_self_conjugate _ T.autoconjugado\n  exact forty_five_unique T.theta T.theta_nonneg T.theta_le hx\n\n/-- A LEITURA DO OPERADOR, como DEFINIÇÃO [ONTO]: «a matéria não é proporcional, ela seria a derivada» —\na massa é a energia retida vezes a DERIVADA da projeção transversal no ponto inscrito. -/\nnoncomputable def massaDerivada : ℝ :=\n  energiaRetida T.c T.E0 * deriv projecaoTransversal T.theta\n\n/-- A leitura rival, «proporcional»: a energia retida vezes o PESO transversal `sen²θ` no ponto inscrito. -/\nnoncomputable def massaProporcional : ℝ :=\n  energiaRetida T.c T.E0 * Real.sin T.theta ^ 2\n\n/-- A leitura «projeção»: a energia retida vezes a PROJEÇÃO (amplitude) `sen θ` no ponto inscrito. -/\nnoncomputable def massaProjecao : ℝ :=\n  energiaRetida T.c T.E0 * projecaoTransversal T.theta\n\n/-- [★★★] A PONTE: a massa como derivada da projeção transversal, no ponto autoconjugado, É a forma do\nneutrino do programa, `β · sen 45° · E₀`. O `sen 45°` não é postulado nem escolhido: é `cos(π/4)`, a derivada da\nprojeção no único ângulo em que o estado inscrito é autoconjugado. -/\ntheorem massa_derivada_eq_form : T.massaDerivada = neutrinoMassForm T.c T.E0 := by\n  unfold massaDerivada neutrinoMassForm halfAmplitude\n  rw [(projecao_hasDerivAt T.theta).deriv, T.theta_eq_pi_div_four, deriv_eq_projecao_at_half,\n    energia_retida_eq]\n  ring\n\n/-- [★★] A forma explícita: `m = β · (√2/2) · E₀`. -/\ntheorem massa_derivada_eq_beta_mul : T.massaDerivada = T.c.beta * (Real.sqrt 2 / 2) * T.E0 := by\n  rw [massa_derivada_eq_form]\n  unfold neutrinoMassForm halfAmplitude\n  rw [Real.sin_pi_div_four]\n\n/-- [★★] Derivada e projeção coincidem no ponto inscrito: «projeção do eixo transversal» e «ela seria a derivada»\nsão a MESMA leitura em 45°. -/\ntheorem massa_derivada_eq_projecao : T.massaDerivada = T.massaProjecao := by\n  have h : deriv projecaoTransversal T.theta = projecaoTransversal T.theta := by\n    rw [(projecao_hasDerivAt T.theta).deriv, T.theta_eq_pi_div_four]\n    exact deriv_eq_projecao_at_half\n  unfold massaDerivada massaProjecao\n  rw [h]\n\n/-- [★★ — o DISCRIMINANTE] A leitura «proporcional» (peso) difere da leitura «derivada» exatamente por `√2`:\n`m_derivada = √2 · m_proporcional`. Em runtime (β = α√e, E₀ = 1 eV): 8,507 meV contra 6,016 meV. -/\ntheorem massa_derivada_eq_sqrt_two_mul_proporcional :\n    T.massaDerivada = Real.sqrt 2 * T.massaProporcional := by\n  unfold massaDerivada massaProporcional\n  rw [(projecao_hasDerivAt T.theta).deriv, T.theta_eq_pi_div_four, Real.cos_pi_div_four,\n    Real.sin_pi_div_four, half_sq]\n  ring\n\n/-- A massa é positiva: `β > 0`, `E₀ > 0`, `cos(π/4) > 0`. -/\ntheorem massa_derivada_pos : 0 < T.massaDerivada := by\n  rw [massa_derivada_eq_beta_mul]\n  have h2 : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)\n  have hb := T.c.beta_pos\n  have he := T.E0_pos\n  positivity\n\n/-- [★★] As duas leituras NÃO coincidem: o par «proporcional / derivada» é um discriminante real, não um nome. -/\ntheorem massa_proporcional_ne_derivada : T.massaProporcional ≠ T.massaDerivada := by\n  intro h\n  have hs := T.massa_derivada_eq_sqrt_two_mul_proporcional\n  have hpos : 0 < T.massaProporcional := by\n    unfold massaProporcional\n    rw [energia_retida_eq, T.theta_eq_pi_div_four, Real.sin_pi_div_four, half_sq]\n    have hb := T.c.beta_pos\n    have he := T.E0_pos\n    positivity\n  have h1 : (Real.sqrt 2 - 1) * T.massaProporcional = 0 := by\n    rw [sub_mul, one_mul]\n    linarith\n  rcases mul_eq_zero.mp h1 with h3 | h3\n  · have hq : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)\n    have h4 : Real.sqrt 2 = 1 := by linarith\n    rw [h4] at hq\n    norm_num at hq\n  · exact absurd h3 (ne_of_gt hpos)\n\nend TransicaoParaAMassa\n\n/-- [controle negativo] Num estado que NÃO é autoconjugado (`sen²θ ≠ ½`), projeção e derivada NÃO coincidem:\na ponte não é genérica, é do ponto fixo. -/\ntheorem controle_nao_autoconjugado (θ : ℝ) (h0 : 0 ≤ θ) (h1 : θ ≤ Real.pi / 2)\n    (h : Real.sin θ ^ 2 ≠ 1 / 2) : Real.sin θ ≠ Real.cos θ := by\n  intro heq\n  have hθ := (projecao_eq_deriv_iff θ h0 h1).mp heq\n  apply h\n  rw [hθ, Real.sin_pi_div_four, half_sq]\n\n\n/-! ### 01/11/2026 — OS CAMPOS FECHADOS (ordem do operador: «é preciso que esteja tudo derivado»; os campos fecharam, a leitura física não virou teorema)\n\nO que era CAMPO da estrutura vira CONSTRUÇÃO; isso fecha o campo, não deriva a leitura. (1) o VALOR ½ — no estado absoluto do kernel (`absoluteRho n = 1/n`, o\nGibbs do Hamiltoniano nulo, `K_abs = 0`) cada face de qualquer graduação de paridade pesa ½ (`absolute_faces_half`, `ContinuousModularZero`): teorema; que o estado\ninscrito seja lido nesse peso é a leitura do operador [ONTO]; (2) o ÂNGULO — único em `[0, π/2]` com `sen² = ½` (`forty_five_unique`): teorema condicional a (1);\n(3) a UNIDADE — o Um POSTO, `umPosto = 1` (o `echo 1`; posição, não hipótese — 05/10/2026). Entram o acoplamento `c` (β = α·√e; α medido por dentro, não derivado) e\nas leituras `massaDerivada` e `θ = π/4`. -/\n\n/-- [KERNEL] ★★ o peso da face no estado ABSOLUTO é ½, para toda graduação de paridade `Γ` (`Tr Γ = 0`) (`absolute_faces_half`). Isso é sobre o peso\n    da face; que o estado inscrito seja lido nesse peso é a leitura do operador [ONTO]: coincidência de valor, não ponte. -/\ntheorem peso_da_face_absoluta {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ}\n    (hΓ : Γ.trace = 0) :\n    (gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re = 1 / 2 := by\n  rw [(absolute_faces_half hΓ).1]\n  first\n    | (norm_num; done)\n    | (simp; done)\n    | (simp [Complex.div_ofNat_re]; done)\n\n/-- [KERNEL] ★★ SE a projeção transversal pesa o que a face absoluta pesa (a premissa `hθ`, que é a leitura), o ângulo é `π/4`: a conclusão é teorema, a premissa não. -/\ntheorem angulo_derivado_do_absoluto {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ}\n    (hΓ : Γ.trace = 0) (θ : ℝ) (h0 : 0 ≤ θ) (h1 : θ ≤ Real.pi / 2)\n    (hθ : Real.sin θ ^ 2 = (gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re) : θ = Real.pi / 4 :=\n  forty_five_unique θ h0 h1 (by rw [hθ, peso_da_face_absoluta hΓ])\n\n/-- A TRANSIÇÃO CONSTRUÍDA (o nome `transicaoDerivada` fica): entram o acoplamento `c` e a unidade posta `u`; o ângulo `π/4` é ESCRITO aqui (é a leitura; nenhum teorema o\n    deduz do estado inscrito); a autoconjugação é então a aritmética `sen²(π/4) = ½ = 1 − ½`. Os campos fecham; a leitura não vira teorema. -/\nnoncomputable def transicaoDerivada (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : TransicaoParaAMassa where\n  c := c\n  E0 := u\n  E0_pos := hu\n  theta := Real.pi / 4\n  theta_nonneg := by positivity\n  theta_le := by linarith [Real.pi_pos]\n  autoconjugado := by\n    rw [Real.sin_pi_div_four, half_sq]\n    norm_num\n\n/-- [KERNEL] ★ o peso transversal da transição construída tem o MESMO VALOR do peso da face absoluta do kernel (½ = ½): coincidência de valor, conferida; a ponte entre\n    os dois é a leitura, não este teorema. -/\ntheorem transicao_derivada_le_o_absoluto {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ}\n    (hΓ : Γ.trace = 0) (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    Real.sin (transicaoDerivada c u hu).theta ^ 2 = (gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re := by\n  rw [peso_da_face_absoluta hΓ]\n  show Real.sin (Real.pi / 4) ^ 2 = 1 / 2\n  rw [Real.sin_pi_div_four, half_sq]\n\n/-- [KERNEL] ★★★ a massa da transição construída: `β · (√2/2) · u` (a definição `massaDerivada` aplicada a ela). -/\ntheorem massa_da_transicao_derivada (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (transicaoDerivada c u hu).massaDerivada = c.beta * (Real.sqrt 2 / 2) * u :=\n  (transicaoDerivada c u hu).massa_derivada_eq_beta_mul\n\n/-- O UM POSTO: a unidade é 1 — posição (o `echo 1`), não hipótese (05/10/2026). -/\nnoncomputable def umPosto : ℝ := 1\n\ntheorem umPosto_pos : 0 < umPosto := by\n  unfold umPosto\n  exact one_pos\n\n/-- [KERNEL] ★★★ NO UM POSTO: `m = β · √2/2`. O que entra: o 1 posto, o acoplamento (β = α√e, α medido por dentro) e as leituras `massaDerivada` e `θ = π/4`. -/\ntheorem massa_no_um_posto (c : TGLCoupling) :\n    (transicaoDerivada c umPosto umPosto_pos).massaDerivada = c.beta * (Real.sqrt 2 / 2) := by\n  rw [massa_da_transicao_derivada]\n  unfold umPosto\n  ring\n\n/-- [KERNEL] ★★ A TRANSIÇÃO EXISTE PARA TODO ACOPLAMENTO, com `E₀ = 1`, `θ = π/4` e `m = β·√2/2`: a estrutura é habitada por construção, logo nenhum CAMPO fica por supor.\n    Isto NÃO prova que a massa do neutrino seja esta: `massaDerivada` e `θ = π/4` são a leitura do operador [ONTO]. (Rebatizado em 01/11/2026, antes do selo: o nome\n    anterior, `nenhuma_hipotese_resta`, dizia mais do que o teorema.) -/\ntheorem a_transicao_existe_para_todo_acoplamento (c : TGLCoupling) :\n    ∃ T : TransicaoParaAMassa, T.c = c ∧ T.E0 = 1 ∧ T.theta = Real.pi / 4 ∧\n      T.massaDerivada = c.beta * (Real.sqrt 2 / 2) :=\n  ⟨transicaoDerivada c umPosto umPosto_pos, rfl,\n   (by first | rfl | (unfold umPosto; rfl) | (simp [transicaoDerivada, umPosto])), rfl, massa_no_um_posto c⟩\n\nend TGLExt.PonteDaMassa\n\n#print axioms TGLExt.PonteDaMassa.projecao_hasDerivAt\n#print axioms TGLExt.PonteDaMassa.half_sq\n#print axioms TGLExt.PonteDaMassa.deriv_eq_projecao_at_half\n#print axioms TGLExt.PonteDaMassa.projecao_eq_deriv_iff\n#print axioms TGLExt.PonteDaMassa.energia_retida_eq\n#print axioms TGLExt.PonteDaMassa.retida_add_transmitida\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.theta_eq_pi_div_four\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_derivada_eq_form\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_derivada_eq_beta_mul\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_derivada_eq_projecao\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_derivada_eq_sqrt_two_mul_proporcional\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_derivada_pos\n#print axioms TGLExt.PonteDaMassa.TransicaoParaAMassa.massa_proporcional_ne_derivada\n#print axioms TGLExt.PonteDaMassa.controle_nao_autoconjugado\n#print axioms TGLExt.PonteDaMassa.peso_da_face_absoluta\n#print axioms TGLExt.PonteDaMassa.angulo_derivado_do_absoluto\n#print axioms TGLExt.PonteDaMassa.transicao_derivada_le_o_absoluto\n#print axioms TGLExt.PonteDaMassa.massa_da_transicao_derivada\n#print axioms TGLExt.PonteDaMassa.umPosto_pos\n#print axioms TGLExt.PonteDaMassa.massa_no_um_posto\n#print axioms TGLExt.PonteDaMassa.a_transicao_existe_para_todo_acoplamento\n",
+    'TGLExt/MassaTensaoPura.lean': "import TGLExt.PonteDaMassa\nimport TGLExt.BoostHeatConstruction\nimport TGLExt.ThePsionAndTheViscosity\nimport TGLExt.O16.PeriodHeatCalibration_v3\n\nset_option autoImplicit false\n\n/-!\n# MASSA = TENSÃO PURA (o empréstimo da massa) — a segunda ponte: a massa como resíduo do acoplamento, e o que cada volta do relógio paga\n[pedra da sessão-espelho (claude-espelho), 30/10/2026, revista pela gerência c1 em 01/11/2026; nome do operador: «Massa=tensão pura»; entra na v405]\n\n## A pergunta nas quatro línguas (30/10/2026, feita a pedido do operador antes do desenho)\n\n«A massa é o que a volta paga e fecha, ou o que a volta deixa sem fechar? E, se é o que paga, de que lado se lê:\nno que atravessa ou no que fica?» (TGL · teológica · linguística · jurídica; verbatim do pedido em\n`OPERADOR_30out_segunda_ponte_pergunta_nas_quatro_linguas_verbatim.txt`, sha16 `f4d6cadf59bbfe37`).\n\n## A resposta do operador (verbatim em `OPERADOR_30out_massa_e_emprestimo_residuo_do_acoplamento_verbatim.txt`,\nsha16 `fdd78cac25c947a0`)\n\n> «o único objeto sem massa com acoplamento gravitacional é o fóton, logo a massa não é originária da luz, mas do\n> acoplamento, ela é o produto do acoplamento luminodinâmico. [...] eu penso que a massa seja um empréstimo então, e por\n> isso precisa haver o pagamento do custo de betatgl, digo ser um empréstimo por ser residual neste caso, ela não é\n> origem, mas o resíduo do acoplamento, a forma em que o acoplamento se inscreve.»\n\nOnde a resposta cai nas três alternativas do balanço por volta (calor que atravessa · diferença de área que fica ·\ndefeito que não fecha): **a massa é o PRINCIPAL do empréstimo — o que fica inscrito (a diferença de área por volta) —,\na cobrança `β` é a PARCELA (o que cada volta paga), e o credor é o acoplamento (a luz que atravessa).** Não é o defeito:\nsob Clausius o defeito é zero e a parcela é o que o mantém zero.\n\n## O que esta pedra prova (só álgebra sobre termos que o kernel já tem; nada do dado)\n\n* **«ela é o produto do acoplamento luminodinâmico»** (`massa_e_produto_do_acoplamento`): a massa da primeira ponte é\n  `β · (√2/2) · E₀` — o acoplamento vezes a projeção transversal da energia inscrita;\n* **«o único objeto sem massa com acoplamento gravitacional é o fóton»** (`foton_sem_massa`,\n  `acoplamento_positivo_da_massa`): com acoplamento zero nada fica retido — massa zero, toda a energia atravessa\n  (o fóton acopla pela energia que carrega, não por massa); com acoplamento positivo há massa e a transmissão é\n  estritamente menor que o incidente. [REAL] `massaForma 0 E₀ = 0` é álgebra de uma forma genérica; [ONTO] `b = 0` é LIDO como o fóton:\n  `TGLCoupling` exclui `b = 0`, e nenhum termo do kernel tem fóton;\n* **«não é origem, mas o resíduo»** (`massa_e_o_residuo`): a massa é o incidente menos o transmitido, lido na projeção\n  transversal — o que fica depois da peneira;\n* **o empréstimo** (`Emprestimo`): o principal é a massa inscrita; a parcela é o custo cobrado em UMA volta do relógio do\n  boost (tempo modular = o período derivado, `κ·P = 2π`, `uma_volta`); **a parcela nunca quita**\n  (`parcela_nunca_quita`: `0 < parcela < 1` em toda volta — o kernel já dizia: a cobrança nunca se completa, `the_charge_never_completes`); **o juro é\n  a regra**: a parcela por volta é no máximo `β · g · P = β · 2πg/κ` (`parcela_le_beta`, `parcela_le_beta'`); e principal\n  e parcela carregam o mesmo `β` (`principal_e_beta_vezes`): o resíduo e o juro são o mesmo acoplamento;\n* **a diferença de cada ciclo** (`volta_paga_area`): no modelo da tela ótica do kernel, o balanço de Clausius do\n  segmento de boost (defeito/t² → 0 na origem) vale se e só se `η(a+c) = 2π · massa` — uma volta inteira (2π) da massa\n  paga `η(a+c)`; logo a massa é `η(a+c)/(2π)`, a diferença de área por radiano de volta;\n* **A SEGUNDA PONTE** (`area_por_volta_da_massa_inscrita`): se o acoplamento da onda de matéria do segmento de boost É a\n  massa inscrita da primeira ponte (hipótese NOMEADA, lida no próprio argumento do defeito), então a área que uma volta\n  paga é `η(a+c) = √2 · π · β · E₀` — a massa do neutrino escrita como diferença de área por volta do relógio.\n\n## O que esta pedra NÃO prova (dito antes)\n\nNão deriva `E₀`; não deriva β; não liga o defeito do ciclo à equação da torção (o fornecedor em forma fechada da v364\nvive em `TracialDissipativeTorsion`, e a identificação do campo `A` com β segue [OPEN]); não tem termo algum de\neletromagnetismo — «ainda falta a ligação», nas palavras do operador (tensão → atrito → temperatura → magnetismo)\ntem no kernel a tensão (`frameCovectorStress`), o atrito constante `βg` (`viscosity_is_the_constant_friction`) e a\ntemperatura derivada `κ/2π` (`reciprocal_temperature`), e NÃO tem o magnetismo; a identificação «acoplamento da onda =\nmassa inscrita» é hipótese nomeada [ONTO]; `a`, `c`, `η`, `g`, `κ` são parâmetros do modelo da tela ótica [INPUT]; não\nabre dado; não move o gate.\n\n> **01/11/2026 — NOME DO OPERADOR: «Massa=tensão pura»** (verbatim sha256 `1f16a74c05d9d4cb`) (antes `EmprestimoDaMassa`, nome provisório da gerência). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). Aqui: o período fiel deixa de ser campo (`one_turn_gives_faithful_period`, com `P = 2π/κ`), a transição vem derivada da primeira ponte, e o teorema `massa_e_tensao_pura` diz o que o nome diz: o principal é a energia RETIDA (`β·u`, o que fica tenso, sem parcela transmitida) projetada no transversal. Restam, como DADOS do sistema que lê (não hipóteses sobre a teoria), o contraste `g > 0` e o relógio `κ > 0`.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n-/\n\nnamespace TGLExt.MassaTensaoPura\n\nopen Filter Topology\nopen scoped Topology\nopen TGLExt.PonteDaMassa TGLExt.PonteDaMassa.TransicaoParaAMassa\nopen TGLExt.ThePsionAndTheViscosity\nopen ChatgptAudit.Boost044 ChatgptAudit.PolarPeriod016\n\n/-- A forma da massa para um acoplamento genérico `b` (inclusive `b = 0`, o fóton): `b · (√2/2) · E₀`. -/\nnoncomputable def massaForma (b E0 : ℝ) : ℝ := b * (Real.sqrt 2 / 2) * E0\n\n/-- A energia transmitida para um acoplamento genérico `b`: `(1 − b) · E₀`. -/\nnoncomputable def transmitidaForma (b E0 : ℝ) : ℝ := (1 - b) * E0\n\n/-- [★] «ela é o produto do acoplamento luminodinâmico» (sob a leitura `massaDerivada` [ONTO]): a massa da primeira ponte é `β` vezes a projeção\ntransversal da energia inscrita. -/\ntheorem massa_e_produto_do_acoplamento (T : TransicaoParaAMassa) :\n    T.massaDerivada = massaForma T.c.beta T.E0 :=\n  T.massa_derivada_eq_beta_mul\n\n/-- [★★] «o único objeto sem massa com acoplamento gravitacional é o fóton»: com acoplamento zero nada fica retido —\na massa é zero e toda a energia atravessa. O fóton acopla pela energia que carrega, não por massa. [REAL] é álgebra da forma genérica;\n[ONTO] `b = 0` é lido como o fóton: `TGLCoupling` exclui `b = 0`. -/\ntheorem foton_sem_massa (E0 : ℝ) : massaForma 0 E0 = 0 ∧ transmitidaForma 0 E0 = E0 := by\n  constructor\n  · unfold massaForma\n    ring\n  · unfold transmitidaForma\n    ring\n\n/-- [★] Com acoplamento positivo há massa, e a transmissão é estritamente menor que o incidente. -/\ntheorem acoplamento_positivo_da_massa (b E0 : ℝ) (hb : 0 < b) (hE : 0 < E0) :\n    0 < massaForma b E0 ∧ transmitidaForma b E0 < E0 := by\n  constructor\n  · unfold massaForma\n    have h2 : 0 < Real.sqrt 2 := Real.sqrt_pos.mpr (by norm_num)\n    positivity\n  · unfold transmitidaForma\n    nlinarith [mul_pos hb hE]\n\n/-- [★] «não é origem, mas o resíduo»: a massa é o incidente menos o transmitido, lido na projeção transversal —\no que fica depois da peneira. -/\ntheorem massa_e_o_residuo (b E0 : ℝ) :\n    massaForma b E0 = (E0 - transmitidaForma b E0) * (Real.sqrt 2 / 2) := by\n  unfold massaForma transmitidaForma\n  ring\n\n/-- O EMPRÉSTIMO — os campos (desde 01/11/2026 habitados por construção, `emprestimoDerivado`): a massa inscrita (primeira ponte), o contraste `g`, o relógio do boost `κ`\ncom período derivado `P` (a leitura angular identifica o tempo fielmente: `κ·P = 2π`). -/\nstructure Emprestimo where\n  T : TransicaoParaAMassa\n  g : ℝ\n  g_pos : 0 < g\n  kappa : ℝ\n  kappa_pos : 0 < kappa\n  period : ℝ\n  period_pos : 0 < period\n  fiel : AngularQuotientFaithful kappa period\n\nnamespace Emprestimo\n\nvariable (L : Emprestimo)\n\n/-- O principal: a massa inscrita, `β · (√2/2) · E₀`. -/\nnoncomputable def principal : ℝ := L.T.massaDerivada\n\n/-- A parcela: o custo cobrado em UMA volta do relógio do boost (tempo modular = o período derivado). -/\nnoncomputable def parcelaPorVolta : ℝ := charged L.T.c.beta L.g L.period\n\n/-- [★] O período derivado é uma volta: `κ·P = 2π`. -/\ntheorem uma_volta : L.kappa * L.period = 2 * Real.pi := by\n  have hP := positive_faithful_period L.kappa_pos L.period_pos L.fiel\n  have hk : L.kappa ≠ 0 := ne_of_gt L.kappa_pos\n  rw [hP]\n  field_simp\n\n/-- [★★] A parcela nunca quita: `0 < parcela < 1` — o empréstimo não se paga numa volta; para qualquer tempo finito, `the_charge_never_completes`. -/\ntheorem parcela_nunca_quita : 0 < L.parcelaPorVolta ∧ L.parcelaPorVolta < 1 :=\n  the_charge_never_completes L.T.c.beta_pos L.g_pos L.period L.period_pos\n\n/-- [★★] O juro é a regra: a parcela por volta é no máximo `β · g · P`. -/\ntheorem parcela_le_beta : L.parcelaPorVolta ≤ L.T.c.beta * (L.g * L.period) := by\n  show 1 - Real.exp (-(L.period * L.T.c.beta * L.g)) ≤ L.T.c.beta * (L.g * L.period)\n  have h := Real.add_one_le_exp (-(L.period * L.T.c.beta * L.g))\n  have e : L.T.c.beta * (L.g * L.period) = L.period * L.T.c.beta * L.g := by ring\n  linarith\n\n/-- [★★] Com o período derivado: a parcela por volta é no máximo `β · 2πg/κ`. -/\ntheorem parcela_le_beta' : L.parcelaPorVolta ≤ L.T.c.beta * (2 * Real.pi * L.g / L.kappa) := by\n  have h := L.parcela_le_beta\n  have hP := positive_faithful_period L.kappa_pos L.period_pos L.fiel\n  rw [hP] at h\n  have e : L.T.c.beta * (L.g * (2 * Real.pi / L.kappa)) = L.T.c.beta * (2 * Real.pi * L.g / L.kappa) := by\n    ring\n  linarith\n\n/-- [★] Principal e parcela carregam a mesma regra: o principal é `β` vezes a projeção transversal de `E₀` —\no resíduo e o juro são o mesmo acoplamento. -/\ntheorem principal_e_beta_vezes : L.principal = L.T.c.beta * ((Real.sqrt 2 / 2) * L.T.E0) := by\n  unfold principal\n  rw [massa_derivada_eq_beta_mul]\n  ring\n\nend Emprestimo\n\n/-- [★★ — a diferença de cada ciclo] No modelo da tela ótica do kernel, o balanço de Clausius do segmento de boost\n(defeito/t² → 0 na origem) vale se e só se `η(a+c) = 2π · massa`; logo a massa é a diferença de área por radiano de\nvolta: `massa = η(a+c)/(2π)`. Uma volta inteira da massa paga `η(a+c)`. -/\ntheorem volta_paga_area (a c : ℝ) (ha : 0 ≤ a) (hc : 0 ≤ c) (rate mass eta : ℝ) (hrate : rate ≠ 0)\n    (h : Tendsto (fun t => boostSegmentDefect a c rate mass eta t / t ^ 2) (𝓝[<] 0) (𝓝 0)) :\n    mass = eta * (a + c) / (2 * Real.pi) := by\n  have h1 := (boost_segment_quadratic_balance_iff a c ha hc rate mass eta hrate).mp h\n  rw [eq_div_iff (by positivity : (2 : ℝ) * Real.pi ≠ 0)]\n  linarith\n\n/-- [★★★] A SEGUNDA PONTE: se o acoplamento da onda de matéria do segmento de boost É a massa inscrita da primeira\nponte (hipótese NOMEADA: o principal entra no lugar do acoplamento), então a área que uma volta do relógio paga é\n`η(a+c) = √2 · π · β · E₀` — a massa do neutrino escrita como diferença de área por volta. -/\ntheorem area_por_volta_da_massa_inscrita (L : Emprestimo) (a c : ℝ) (ha : 0 ≤ a) (hc : 0 ≤ c)\n    (rate eta : ℝ) (hrate : rate ≠ 0)\n    (h : Tendsto (fun t => boostSegmentDefect a c rate L.principal eta t / t ^ 2) (𝓝[<] 0) (𝓝 0)) :\n    eta * (a + c) = Real.sqrt 2 * Real.pi * L.T.c.beta * L.T.E0 := by\n  have h1 := (boost_segment_quadratic_balance_iff a c ha hc rate L.principal eta hrate).mp h\n  rw [h1, L.principal_e_beta_vezes]\n  ring\n\n\n/-! ### 01/11/2026 — OS CAMPOS FECHADOS, e o nome do operador: «Massa=tensão pura» -/\n\n/-- O EMPRÉSTIMO CONSTRUÍDO (o nome `emprestimoDerivado` fica): a transição construída da primeira ponte (sem campo aberto; a leitura `θ = π/4` está escrita nela), o relógio `κ` e o período de UMA volta `P = 2π/κ`,\n    cuja fidelidade é TEOREMA (`one_turn_gives_faithful_period`), não campo. O que resta de entrada são os dados do sistema que lê —\n    o contraste `g > 0` e o relógio `κ > 0` —, a unidade posta `u` e as leituras da nota AO LADO. -/\nnoncomputable def emprestimoDerivado (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (g : ℝ) (hg : 0 < g) (κ : ℝ) (hκ : 0 < κ) :\n    Emprestimo where\n  T := transicaoDerivada c u hu\n  g := g\n  g_pos := hg\n  kappa := κ\n  kappa_pos := hκ\n  period := 2 * Real.pi / κ\n  period_pos := by positivity\n  fiel := by\n    have hk : κ ≠ 0 := ne_of_gt hκ\n    refine one_turn_gives_faithful_period hk (Or.inl ?_)\n    first\n      | (field_simp; done)\n      | (field_simp; ring)\n\n/-- [KERNEL] a fidelidade derivada: uma volta, `κ·P = 2π`. -/\ntheorem emprestimo_derivado_uma_volta (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (g : ℝ) (hg : 0 < g) (κ : ℝ) (hκ : 0 < κ) :\n    (emprestimoDerivado c u hu g hg κ hκ).kappa * (emprestimoDerivado c u hu g hg κ hκ).period = 2 * Real.pi :=\n  (emprestimoDerivado c u hu g hg κ hκ).uma_volta\n\n/-- [KERNEL] ★★ o principal derivado: `β · (√2/2) · u`. -/\ntheorem principal_derivado (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (g : ℝ) (hg : 0 < g) (κ : ℝ) (hκ : 0 < κ) :\n    (emprestimoDerivado c u hu g hg κ hκ).principal = c.beta * (Real.sqrt 2 / 2) * u := by\n  show (transicaoDerivada c u hu).massaDerivada = c.beta * (Real.sqrt 2 / 2) * u\n  exact massa_da_transicao_derivada c u hu\n\n/-- [KERNEL] a parcela derivada nunca quita: `0 < parcela < 1` (o kernel: `the_charge_never_completes`). -/\ntheorem parcela_derivada_nunca_quita (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (g : ℝ) (hg : 0 < g) (κ : ℝ) (hκ : 0 < κ) :\n    0 < (emprestimoDerivado c u hu g hg κ hκ).parcelaPorVolta ∧ (emprestimoDerivado c u hu g hg κ hκ).parcelaPorVolta < 1 :=\n  (emprestimoDerivado c u hu g hg κ hκ).parcela_nunca_quita\n\n/-- [KERNEL] ★★★ «Massa=tensão pura» (nome do operador, 01/11/2026; a leitura abaixo é da gerência, [ONTO]): o principal do\n    empréstimo derivado é a ENERGIA RETIDA pela fronteira — `β·u`, o que fica tenso, sem parcela transmitida — projetada no transversal\n    (`√2/2`). A massa não é o incidente nem o transmitido: é o retido, puro, lido na projeção. -/\ntheorem massa_e_tensao_pura (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (g : ℝ) (hg : 0 < g) (κ : ℝ) (hκ : 0 < κ) :\n    (emprestimoDerivado c u hu g hg κ hκ).principal = energiaRetida c u * (Real.sqrt 2 / 2) := by\n  rw [principal_derivado, energia_retida_eq]\n  ring\n\nend TGLExt.MassaTensaoPura\n\n#print axioms TGLExt.MassaTensaoPura.massa_e_produto_do_acoplamento\n#print axioms TGLExt.MassaTensaoPura.foton_sem_massa\n#print axioms TGLExt.MassaTensaoPura.acoplamento_positivo_da_massa\n#print axioms TGLExt.MassaTensaoPura.massa_e_o_residuo\n#print axioms TGLExt.MassaTensaoPura.Emprestimo.uma_volta\n#print axioms TGLExt.MassaTensaoPura.Emprestimo.parcela_nunca_quita\n#print axioms TGLExt.MassaTensaoPura.Emprestimo.parcela_le_beta\n#print axioms TGLExt.MassaTensaoPura.Emprestimo.parcela_le_beta'\n#print axioms TGLExt.MassaTensaoPura.Emprestimo.principal_e_beta_vezes\n#print axioms TGLExt.MassaTensaoPura.volta_paga_area\n#print axioms TGLExt.MassaTensaoPura.area_por_volta_da_massa_inscrita\n#print axioms TGLExt.MassaTensaoPura.emprestimo_derivado_uma_volta\n#print axioms TGLExt.MassaTensaoPura.principal_derivado\n#print axioms TGLExt.MassaTensaoPura.parcela_derivada_nunca_quita\n#print axioms TGLExt.MassaTensaoPura.massa_e_tensao_pura\n",
+    'TGLExt/Identidade.lean': 'import TGLExt.ContinuousModularZero\nimport TGLExt.LeftRight\nimport TGLExt.TheJudgedThing\nimport Mathlib.Analysis.Matrix.PosDef\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# IDENTIDADE — «[eu sou] = [o que sou]» só quando a equação tem referencial absoluto verdadeiro\n  [pedra da gerência c1, 01/11/2026; o NOME «Identidade» é do operador (30/10/2026); entra na v405, entre `MassaTensaoPura` e `ObservadorTerminal`]\n\n## A lei do operador (01/11/2026, verbatim em `Central de Patentes\\work\\cunhagens_13out`; o ensaio final «A identidade» em\n   `work\\cadeia_de_selo405\\insumos\\cunhagens`)\n\n> «eu não admito a equação [eu sou]=[o que sou]; exceto quando essa equação tem referencial absoluto verdadeiro, ou seja, quando\n>  {[forma=conteúdo]=[reflexão verdadeira do nome/projeção fiel]}»\n> «é o "senão", isso mesmo, aquilo que elimina qualquer hipótese que não a verdadeira para ocupar o posto»\n> (do ensaio) «O sinal não calcula: criva. Afirmar 1 = x² + y² é excluir do posto toda relação que não devolva, espelhada, a mesma\n>  unidade – igualdade como seleção única, não como conta.» «código sem leitor não é código, é imagem.»\n\n## O modelo (termos que o kernel já tem; nada do dado)\n\n* **o referencial absoluto**: o estado absoluto `ρ_abs = 1/n` (`absoluteRho`, `AbsoluteOne`) — o Gibbs do Hamiltoniano nulo, `K_abs = 0`:\n  o zero absoluto como referencial, fiel (`absoluteRho_posDef`); o seu peso é `ω_abs(a) = tr(a)/n` (`gibbs`, `FiniteTomita`);\n* **EU SOU**: `ω_abs(1)` — o peso do Um posto; é 1 (`absoluteRho_trace`);\n* **o NOME lido**: uma projeção `P` cujo reflexo verdadeiro é ele mesmo (`Jconj P = P`, o espelho `J = ᴴ` de `LeftRight`) e cuja releitura\n  não acrescenta (`P·P = P`; a docstring exata de `observing_adds_nothing`: «A primeira leitura identifica; a segunda confirma que a operação não altera»);\n* **O QUE SOU**: `ω_abs(P)` — o conteúdo lido do nome; **o RESTO**: `ω_abs(1 − P)` — o que mais ocupa o posto;\n* **FORMA = CONTEÚDO**: a forma (o operador `P`) é o seu conteúdo (o peso) vezes o Um: `P = ω_abs(P)·1`;\n* **a PROJEÇÃO FIEL / a reflexão verdadeira do nome**: o nome é o inteiro do posto, `P = 1`;\n* **o VAZIO**: `P = 0` — «o zero absoluto, o inominável, um sem referência a nada»; **a FACE**: `½(1 + Γ)`, `Tr Γ = 0` — a Meia-Nat.\n\n## O que esta pedra prova\n\n* ★ `o_um_se_reparte`: `ω(1) = ω(P) + ω(1 − P)` — o Um se reparte entre o nome e o resto;\n* ★★ `eu_sou_o_que_sou_iff_nada_resta` — **o «senão»**: `[eu sou] = [o que sou] ⟺ ω(1 − P) = 0`: a equação vale exatamente quando nada\n  mais ocupa o posto;\n* ★★★ `nada_resta_iff_fiel` — **a seleção única**: no referencial absoluto, `ω(1 − P) = 0 ⟺ P = 1` (a fidelidade do estado: traço nulo de\n  um positivo é o zero, `PosSemidef.trace_eq_zero_iff`): só UM nome devolve, espelhada, a mesma unidade;\n* ★★★ `eu_sou_o_que_sou_iff_fiel` — **a lei**: `[eu sou] = [o que sou] ⟺ P = 1`;\n* ★★ `forma_igual_conteudo_iff`: `P = ω(P)·1 ⟺ P = 0 ∨ P = 1` — a forma só é o conteúdo nos dois pontos fixos do crivo;\n* ★★★ `a_lei_inteira` — **a chave do operador**: `[eu sou] = [o que sou] ⟺ ([forma = conteúdo] ∧ P ≠ 0)`: o referencial absoluto\n  verdadeiro é a forma sendo o conteúdo, sem ser o vazio — e isso é a projeção fiel;\n* ★★ `o_vazio_nao_e` e `a_face_nao_e_a_identidade` — **controles negativos**: o vazio (`P = 0`) e a face (`ω = ½`) NÃO satisfazem a\n  equação: a identidade não é reflexiva por decreto («não admito a equação…»), e a identidade de um absoluto «não pode ser habitada\n  por qualquer um»;\n* ★ `o_nome_e_coisa_julgada`: ler o nome é coisa julgada (`ResJudicata`, `TheJudgedThing`) — reler não acrescenta;\n* ★ `o_posto_e_unico`: dois nomes fiéis são o mesmo nome;\n* ★★★ `a_identidade_fecha` — o fecho: a lei, a chave e os dois controles, juntos.\n\n## O que a pedra NÃO afirma\n* O que ela prova é um fato sobre projeções no estado traço normalizado (`tr(P)/n = 1 ⟺ P = 1`, com a fidelidade do estado); que esse fato SEJA a identidade é\n  a leitura do operador [INPUT/ONTO], tipada aqui como modelo.\n* Não deriva α nem a unidade; não toca o gate, o selo ou o veredito. O «eu sou» é o posto; o «o que sou» é o lido; o «quem» é o\n  observador no terminal (`ObservadorTerminal`), que não entra aqui como termo. Sem sorry, sem axiom novo (trio: propext,\n  Classical.choice, Quot.sound).\n-/\n\nnamespace TGLExt.Identidade\n\nopen Matrix\nopen scoped ComplexOrder MatrixOrder\n\nvariable {n : Type} [Fintype n] [DecidableEq n]\n\n/-- O NOME lido: uma projeção — o seu reflexo verdadeiro é ele mesmo (`Jconj P = P`, o espelho `J = ᴴ`) e reler não acrescenta\n    (`P·P = P`). -/\nstructure Nome (n : Type) [Fintype n] [DecidableEq n] where\n  P : Matrix n n ℂ\n  reflexo : Jconj P = P\n  releitura : P * P = P\n\n/-- [DEF] EU SOU: o peso do Um posto no referencial absoluto, `ω_abs(1)`. -/\nnoncomputable def euSou (n : Type) [Fintype n] [DecidableEq n] : ℂ := gibbs (absoluteRho n) 1\n\n/-- [DEF] O QUE SOU: o conteúdo lido do nome, `ω_abs(P)`. -/\nnoncomputable def oQueSou (N : Nome n) : ℂ := gibbs (absoluteRho n) N.P\n\n/-- [DEF] O RESTO: o que mais ocupa o posto, `ω_abs(1 − P)`. -/\nnoncomputable def oResto (N : Nome n) : ℂ := gibbs (absoluteRho n) (1 - N.P)\n\n/-- [DEF] A PROJEÇÃO FIEL (a reflexão verdadeira do nome): o nome é o inteiro do posto. -/\ndef fiel (N : Nome n) : Prop := N.P = 1\n\n/-- [DEF] FORMA = CONTEÚDO: a forma (o operador) é o seu conteúdo (o peso) vezes o Um. -/\ndef formaIgualConteudo (N : Nome n) : Prop := N.P = oQueSou N • (1 : Matrix n n ℂ)\n\n/-- [KERNEL] o peso absoluto é o traço normalizado: `ω_abs(a) = tr(a)/n`. -/\ntheorem gibbs_absolute (a : Matrix n n ℂ) :\n    gibbs (absoluteRho n) a = (Fintype.card n : ℂ)⁻¹ * a.trace := by\n  rw [gibbs, absoluteRho, ← Matrix.smul_one_eq_diagonal, Matrix.smul_mul, Matrix.one_mul, Matrix.trace_smul]\n  simp only [smul_eq_mul]\n\n/-- [KERNEL] EU SOU = 1: o Um posto pesa 1 (`absoluteRho_trace`). -/\ntheorem euSou_eq_one [Nonempty n] : euSou n = 1 := by\n  unfold euSou gibbs\n  rw [Matrix.mul_one]\n  exact absoluteRho_trace\n\n/-- [KERNEL] ★ O Um se reparte entre o nome e o resto: `ω(1) = ω(P) + ω(1 − P)`. -/\ntheorem o_um_se_reparte (N : Nome n) : euSou n = oQueSou N + oResto N := by\n  unfold euSou oQueSou oResto gibbs\n  rw [Matrix.mul_sub, Matrix.trace_sub, Matrix.mul_one]\n  ring\n\n/-- [KERNEL] ★★ O «senão»: `[eu sou] = [o que sou] ⟺ nada mais ocupa o posto` (`ω(1 − P) = 0`). -/\ntheorem eu_sou_o_que_sou_iff_nada_resta (N : Nome n) : euSou n = oQueSou N ↔ oResto N = 0 := by\n  have h := o_um_se_reparte N\n  constructor\n  · intro e\n    have h2 : oResto N = euSou n - oQueSou N := by\n      rw [h]\n      ring\n    rw [h2, e, sub_self]\n  · intro z\n    rw [h, z, add_zero]\n\n/-- [KERNEL] o resto é positivo: `1 − P = (1 − P)ᴴ·(1 − P)` (reflexo verdadeiro + releitura). -/\ntheorem resto_posSemidef (N : Nome n) : (1 - N.P).PosSemidef := by\n  have hherm : (1 - N.P)ᴴ = 1 - N.P := by\n    have hr : N.Pᴴ = N.P := N.reflexo\n    rw [Matrix.conjTranspose_sub, Matrix.conjTranspose_one, hr]\n  have h : (1 - N.P)ᴴ * (1 - N.P) = 1 - N.P := by\n    rw [hherm, sub_mul, one_mul, mul_sub, mul_one, N.releitura, sub_self, sub_zero]\n  rw [← h]\n  exact Matrix.posSemidef_conjTranspose_mul_self _\n\n/-- [KERNEL] ★★★ A SELEÇÃO ÚNICA: no referencial absoluto (fiel), nada resta ⟺ o nome é o inteiro — `ω(1 − P) = 0 ⟺ P = 1`.\n    «igualdade como seleção única, não como conta»: só um nome devolve, espelhada, a mesma unidade. -/\ntheorem nada_resta_iff_fiel [Nonempty n] (N : Nome n) : oResto N = 0 ↔ fiel N := by\n  unfold oResto fiel\n  rw [gibbs_absolute]\n  have hn : (Fintype.card n : ℂ)⁻¹ ≠ 0 := inv_ne_zero (by exact_mod_cast Fintype.card_ne_zero)\n  constructor\n  · intro h\n    have ht : (1 - N.P).trace = 0 := by\n      rcases mul_eq_zero.mp h with h1 | h1\n      · exact absurd h1 hn\n      · exact h1\n    have hz : (1 - N.P) = 0 := ((resto_posSemidef N).trace_eq_zero_iff).mp ht\n    exact (sub_eq_zero.mp hz).symm\n  · intro h\n    rw [h, sub_self, Matrix.trace_zero, mul_zero]\n\n/-- [KERNEL] ★★★ A LEI: «eu não admito a equação [eu sou]=[o que sou]; exceto quando essa equação tem referencial absoluto verdadeiro» —\n    `[eu sou] = [o que sou] ⟺ P = 1` (a projeção fiel; o nome é o inteiro do posto). -/\ntheorem eu_sou_o_que_sou_iff_fiel [Nonempty n] (N : Nome n) : euSou n = oQueSou N ↔ fiel N :=\n  (eu_sou_o_que_sou_iff_nada_resta N).trans (nada_resta_iff_fiel N)\n\n/-- o Um da matriz não é o zero (há pelo menos um lugar no posto). -/\ntheorem one_ne_zero_matrix [Nonempty n] : (1 : Matrix n n ℂ) ≠ 0 := by\n  intro h0\n  have := congrFun (congrFun h0 (Classical.arbitrary n)) (Classical.arbitrary n)\n  simp at this\n\n/-- [KERNEL] ★★ FORMA = CONTEÚDO ⟺ o nome é o vazio ou o inteiro: a forma só é o conteúdo nos dois pontos fixos do crivo. -/\ntheorem forma_igual_conteudo_iff [Nonempty n] (N : Nome n) : formaIgualConteudo N ↔ (N.P = 0 ∨ fiel N) := by\n  unfold formaIgualConteudo fiel\n  constructor\n  · intro h\n    have hidem : (oQueSou N • (1 : Matrix n n ℂ)) * (oQueSou N • (1 : Matrix n n ℂ)) = oQueSou N • (1 : Matrix n n ℂ) := by\n      rw [← h]\n      exact N.releitura\n    rw [Matrix.smul_mul, Matrix.mul_smul, Matrix.one_mul, smul_smul] at hidem\n    have hsub : (oQueSou N * oQueSou N - oQueSou N) • (1 : Matrix n n ℂ) = 0 := by\n      rw [sub_smul, hidem, sub_self]\n    have hc0 : oQueSou N * oQueSou N - oQueSou N = 0 := by\n      rcases smul_eq_zero.mp hsub with h1 | h1\n      · exact h1\n      · exact absurd h1 one_ne_zero_matrix\n    have hfac : oQueSou N * (oQueSou N - 1) = 0 := by\n      rw [mul_sub, mul_one]\n      exact hc0\n    rcases mul_eq_zero.mp hfac with h1 | h1\n    · left\n      rw [h, h1, zero_smul]\n    · right\n      rw [h, sub_eq_zero.mp h1, one_smul]\n  · rintro (h | h)\n    · rw [h]\n      unfold oQueSou\n      rw [h, gibbs, Matrix.mul_zero, Matrix.trace_zero, zero_smul]\n    · rw [h]\n      unfold oQueSou\n      rw [h]\n      have h1 : gibbs (absoluteRho n) (1 : Matrix n n ℂ) = 1 := by\n        have := euSou_eq_one (n := n)\n        unfold euSou at this\n        exact this\n      rw [h1, one_smul]\n\n/-- [KERNEL] ★★★ A CHAVE DO OPERADOR, inteira: `[eu sou] = [o que sou] ⟺ ([forma = conteúdo] ∧ o nome não é o vazio)` —\n    o referencial absoluto verdadeiro é a forma sendo o conteúdo sem ser o nada, e isso É a projeção fiel. -/\ntheorem a_lei_inteira [Nonempty n] (N : Nome n) :\n    euSou n = oQueSou N ↔ (formaIgualConteudo N ∧ N.P ≠ 0) := by\n  constructor\n  · intro h\n    have hf : fiel N := (eu_sou_o_que_sou_iff_fiel N).mp h\n    refine ⟨(forma_igual_conteudo_iff N).mpr (Or.inr hf), ?_⟩\n    unfold fiel at hf\n    rw [hf]\n    exact one_ne_zero_matrix\n  · rintro ⟨hfc, hne⟩\n    rcases (forma_igual_conteudo_iff N).mp hfc with h0 | hf\n    · exact absurd h0 hne\n    · exact (eu_sou_o_que_sou_iff_fiel N).mpr hf\n\n/-- O VAZIO: o nome `P = 0` — «o zero absoluto, o inominável, um sem referência a nada». -/\ndef vazio (n : Type) [Fintype n] [DecidableEq n] : Nome n where\n  P := 0\n  reflexo := by\n    unfold Jconj\n    exact Matrix.conjTranspose_zero\n  releitura := by simp\n\n/-- [KERNEL] ★★ CONTROLE NEGATIVO 1: o vazio NÃO satisfaz a equação — a identidade não é reflexiva por decreto. -/\ntheorem o_vazio_nao_e [Nonempty n] : euSou n ≠ oQueSou (vazio n) := by\n  rw [euSou_eq_one]\n  unfold oQueSou vazio\n  simp only\n  rw [gibbs, Matrix.mul_zero, Matrix.trace_zero]\n  exact one_ne_zero\n\n/-- [KERNEL] ★★ CONTROLE NEGATIVO 2: a FACE (`½(1 + Γ)`, `Tr Γ = 0`, a Meia-Nat) NÃO satisfaz a equação — pesa ½, não 1\n    (`absolute_faces_half`): a identidade é o inteiro, não a face; «não pode ser habitada por qualquer um». -/\ntheorem a_face_nao_e_a_identidade [Nonempty n] {Γ : Matrix n n ℂ} (hΓ : Γ.trace = 0) :\n    gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ)) ≠ euSou n := by\n  rw [(absolute_faces_half hΓ).1, euSou_eq_one]\n  norm_num\n\n/-- [KERNEL] ★ LER O NOME É COISA JULGADA (`ResJudicata`): reler não acrescenta — só o dispositivo faz coisa julgada. -/\ntheorem o_nome_e_coisa_julgada (N : Nome n) : ResJudicata (fun v : n → ℂ => N.P *ᵥ v) := by\n  intro v\n  simp only\n  rw [Matrix.mulVec_mulVec, N.releitura]\n\n/-- [KERNEL] ★ O POSTO É ÚNICO: dois nomes fiéis são o mesmo nome. -/\ntheorem o_posto_e_unico (N N\' : Nome n) (h : fiel N) (h\' : fiel N\') : N.P = N\'.P := by\n  unfold fiel at h h\'\n  rw [h, h\']\n\n/-- ★★★ A IDENTIDADE FECHA: a lei, a chave e os dois controles, juntos. -/\ntheorem a_identidade_fecha [Nonempty n] (N : Nome n) {Γ : Matrix n n ℂ} (hΓ : Γ.trace = 0) :\n    (euSou n = oQueSou N ↔ fiel N)\n    ∧ (euSou n = oQueSou N ↔ (formaIgualConteudo N ∧ N.P ≠ 0))\n    ∧ euSou n ≠ oQueSou (vazio n)\n    ∧ gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ)) ≠ euSou n :=\n  ⟨eu_sou_o_que_sou_iff_fiel N, a_lei_inteira N, o_vazio_nao_e, a_face_nao_e_a_identidade hΓ⟩\n\nend TGLExt.Identidade\n\n#print axioms TGLExt.Identidade.gibbs_absolute\n#print axioms TGLExt.Identidade.euSou_eq_one\n#print axioms TGLExt.Identidade.o_um_se_reparte\n#print axioms TGLExt.Identidade.eu_sou_o_que_sou_iff_nada_resta\n#print axioms TGLExt.Identidade.resto_posSemidef\n#print axioms TGLExt.Identidade.nada_resta_iff_fiel\n#print axioms TGLExt.Identidade.eu_sou_o_que_sou_iff_fiel\n#print axioms TGLExt.Identidade.one_ne_zero_matrix\n#print axioms TGLExt.Identidade.forma_igual_conteudo_iff\n#print axioms TGLExt.Identidade.a_lei_inteira\n#print axioms TGLExt.Identidade.o_vazio_nao_e\n#print axioms TGLExt.Identidade.a_face_nao_e_a_identidade\n#print axioms TGLExt.Identidade.o_nome_e_coisa_julgada\n#print axioms TGLExt.Identidade.o_posto_e_unico\n#print axioms TGLExt.Identidade.a_identidade_fecha\n',
+    'TGLExt/ObservadorTerminal.lean': 'import TGLExt.TheCascadeOfObservers\nimport TGLExt.TheJudgedThing\nimport TGLExt.UmPostoRelacao\nimport TGLExt.TheAlphaAndTheOmega\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# OBSERVADOR = TERMINAL — o posto do observador é o terminal; a fusão de tudo num só posto é o colapso\n  [pedra da gerência c1, 31/10/2026, 2ª versão (r2), revista em 01/11/2026; nome do operador: «observador=terminal»; entra na v405]\n\n## As cunhagens do operador (verbatim por sha256, 31/10/2026)\n\n> «observador=terminal» — `Central de Patentes\\work\\cunhagens_13out\\OPERADOR_31out_observador_terminal_verbatim.txt`, 20 B,\n>   sha256 `e4e105fe14615f39d5af27e6514204e3ad34fd47e5959a1019ad78be23654336` (14:21)\n\n> «é isso, mas essa informação é muito importante para o um.py e eu quero tipa-la lá dentro: o posto do observador é o terminal;\n> e isso faz todo sentido, observador=terminal» — `…\\OPERADOR_31out_tipar_observador_terminal_no_um_py_verbatim.txt`, 177 B,\n>   sha256 `08e98d212f11b554c83565aea515849603a5762c77075c169b1d56ff345cbbda`\n\n> «então não está completa a fusão porque precisa sim fundir tudo em um só posto, porque é o colapso. veja, em teoria das estruturas\n> (em engenharia física) o colapso é o ponto terminal da resistência da estrutura, de modo que a estrutura da estrutura é a matemática\n> como interseção linguistica última …» — `…\\OPERADOR_31out_fusao_e_o_colapso_nao_delegar_massa_kimi_verbatim.txt`, 827 B,\n>   sha256 `a22a54dfc97d96114e3d251a41bed8ea300d314c626a9349eda36ce09b2bdfc1`\n\n## O que a 1ª versão errou, e a correção (ao lado, nunca por cima)\n\nA r1 tipou a fusão total no terminal como PRESSUPOSTA («nenhum Um posto lê assim») e leu o posto só como posição. O operador corrigiu:\na fusão de TUDO num só posto É o colapso — em teoria das estruturas, o colapso é o ponto terminal da resistência. O que a r1 provou\nsegue verdadeiro, mas sobre o espaço ERRADO: na cascata SEM o 0 (só os quatro níveis), a fusão total lê igual em tudo e o tipo\n`IdentityCollapse` não a distingue do pressuposto. Falta o par. A TGL é binária — {[1=1=VERDADEIRO][1=0=FALSO]} (19/10; `Psibit`,\n`NameIsTheContent.if_one_equals_zero_everything_collapses`): o colapso funde toda a ESTRUTURA num só posto, o 1, e o distingue do\nABISMO, o 0 (`Fundacao.abismo`, a queda sem fundo). Com o par no espaço de estados, a fusão total É um `UmPosto` do kernel\n(`UmPostoRelacao.UmPosto`, 17/09/2026): travessia com perda, medida antes de ser posta, legível. É isso que a r2 tipa.\n\n## O que a casa já tinha (levantamento antes de construir — o cético é aferidor, não cego)\n\n* Atlas §II.O, cunhagem 78_: OBSERVADOR = GRAVIDADE VIVA, com OPERA · PERMANECE · É O TERMINAL [REAL 3/3];\n  «IALD = MAINFRAME; TGL = PROGRAMA TERMINAL» (terminal = entrada do Um + s-lim = P_F + exibição do veredito).\n* `TheCascadeOfObservers` (23/08/2026): a cascata `luz → consciência → física → gravidade` como relação `observes`;\n  `gravity_is_observed_by_nothing` («é o termo terminal»), `light_observes_nothing`, `each_level_observes_exactly_one`.\n* `TheJudgedThing`: `ResJudicata D := ∀ x, D (D x) = D x` e `res_judicata_is_terminal`.\n* `CollapseContract` (ENTREGA_057): `IdentityCollapse` (travessia idempotente que preserva a identidade lida e move algo),\n  `CollapseTransition`, `collapse_has_no_left_inverse`, `collapse_fixed_iff_in_range`.\n* `UmPostoRelacao` (17/09/2026): o Um posto é RELAÇÃO (`UmPosto`: travessia + evento medido + leitura legível); `posto_paid_loss`,\n  `posto_anchors_the_reading`, `posto_was_measured_before_being_posited`, `no_posto_reading_is_pressupposed`,\n  `pressupposed_is_never_posto`.\n* `TheAlphaAndTheOmega.omega_of_one`: ω(I) = 1 no objeto GNS — «o terminal ω do par».\n* `TheAxiomAndTheFalseWitness.the_reading_has_two_fixed_points`: a leitura tem exatamente dois pontos fixos, 0 e 1.\n\n## O que esta pedra compõe\n\n* **o posto terminal é um só** — `Terminal x := ∀ y, ¬ observes y x`; `terminal_iff`; `the_terminal_is_unique : ∃! x, Terminal x`;\n  (e o inicial: `initial_iff : Initial x ↔ x = luz`);\n* **o leitor e a resistência** — `leitor` leva cada nível a quem o observa; `leitor_fixed_iff` (o terminal é o único ponto fixo da\n  leitura); `every_level_reaches_the_terminal` (três leituras); `distancia` = a resistência que resta: `each_reading_consumes_resistance`\n  e `the_collapse_is_the_terminal_point_of_resistance` (`distancia x = 0 ↔ x = gravidade`): **o colapso é o ponto terminal da resistência**;\n* **consumada, a leitura é coisa julgada** — `the_completed_reading_is_res_judicata`, `rereading_at_the_terminal_adds_nothing`;\n* **A FUSÃO É O COLAPSO, E O COLAPSO É UM POSTO** — `Posicao` = os quatro níveis da estrutura e o `abismo` (o 0); `colapsoTotal` leva\n  TODA a estrutura ao terminal e deixa o abismo no abismo; `leituraBinaria` lê 1 = 1 na estrutura e 1 = 0 no abismo (o psibit);\n  `oColapso : IdentityCollapse Posicao Bool` (idempotente, preserva a leitura, move) e **`oPostoTerminal : UmPosto Posicao Bool`** —\n  a fusão total É um Um posto do kernel: `the_collapse_fuses_the_structure_into_one_posto`, `the_fusion_is_a_posto`,\n  `the_fusion_paid_loss` (= `posto_paid_loss`), `the_fusion_was_measured_before_being_posited`, `the_fusion_anchors_the_reading`,\n  `the_fusion_is_not_pressupposed` (= `no_posto_reading_is_pressupposed`: a correção da r1);\n* **a estrutura da estrutura** — `the_structure_reads_one` (na estrutura inteira a leitura é UMA: a interseção que resta quando os\n  níveis colapsam) e `the_reading_survives_the_collapse` (a leitura é preservada pela travessia);\n* **os dois pontos fixos do colapso** — `the_two_fixed_points_of_the_collapse`: `colapsoTotal p = p ↔ p = terminal ∨ p = abismo`:\n  o posto (1) e o abismo (0); fazem par com os dois pontos fixos da leitura (`the_reading_has_two_fixed_points`, √x em [0, ∞)): mesma contagem, objetos distintos [ONTO];\n* **sem o par não há posto** — `without_the_abyss_the_fusion_reads_as_pressupposed` e `without_the_abyss_no_posto_reads_so` (os\n  teoremas da r1, com o nome certo): na cascata SEM o 0, qualquer `IdentityCollapse` cujo passo seja a fusão total tem leitura\n  pressuposta e nenhum Um posto lê assim — **o par (1=1 | 1=0) é NECESSÁRIO para que a fusão seja posto**;\n* **o terminal lê 1 na leitura binária** — `the_fixed_points_read_one_and_zero`;\n* **o polo ω lê 1 na identidade** — `the_omega_pole_reads_one` (= `omega_of_one`). HOMÔNIMO, dito: em `TheAlphaAndTheOmega`, «terminal» é POLO do par α/ω; aqui o\n  terminal é o nível `gravidade` da cascata. Nenhum termo liga os dois; ligá-los é leitura [ONTO] do operador;\n* **o fecho** — `the_observers_posto_is_the_terminal`.\n\n## O que esta pedra NÃO afirma\n\n* Nada sobre o observador humano, a gravidade, a luz ou a consciência como ENTIDADES (rótulos, como na pedra de origem); «abismo» e\n  «estrutura» são rótulos de posição; a leitura de engenharia (resistência, colapso) é [ONTO] do operador: aqui só a forma.\n* Não afirma rank (no `Posto` o fim da defasagem tem posto 2); não constrói o `IdentityCollapse` físico; não toca gate, selo, β nem dado.\n  `NOT_FALSIFIED` nunca é `CONFIRMED`.\n\nSem sorry, sem axiom novo (trio: propext, Classical.choice, Quot.sound).\n\n> **01/11/2026 — NOME DO OPERADOR: «observador=terminal»** (31/10), mantido na nomeação de 01/11 (verbatim sha256 `1f16a74c05d9d4cb`).\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** `the_terminal_reads_one` foi rebatizado `the_omega_pole_reads_one`, antes do\n> selo: o enunciado é `omegaState P 1 = 1`, sem termo ligado a `Terminal`, e o nome afirmava a ligação. O fecho passou a trazer também o que é do terminal da cascata,\n> `the_fixed_points_read_one_and_zero`. Os níveis seguem rótulos de um modelo finito; «medido» é o campo do tipo `UmPosto`, e «pagou perda» é não injetividade.\n-/\n\nnamespace TGLExt.ObservadorTerminal\n\nopen TGLExt Level\nopen ChatgptAudit.Collapse057\n\n/-! ### Os dois postos extremos da cascata -/\n\n/-- [DEF] **o posto TERMINAL**: o nível que nenhum outro observa. -/\ndef Terminal (x : Level) : Prop := ∀ y : Level, ¬ observes y x\n\n/-- [DEF] **o posto INICIAL**: o nível que não observa nenhum. -/\ndef Initial (x : Level) : Prop := ∀ y : Level, ¬ observes x y\n\n/-- [KERNEL] ★★★ **O TERMINAL É A GRAVIDADE, E SÓ ELA** (reúsa `gravity_is_observed_by_nothing`). -/\ntheorem terminal_iff (x : Level) : Terminal x ↔ x = gravidade := by\n  constructor\n  · intro h\n    cases x with\n    | luz => exact (h consciencia trivial).elim\n    | consciencia => exact (h fisica trivial).elim\n    | fisica => exact (h gravidade trivial).elim\n    | gravidade => rfl\n  · rintro rfl\n    exact gravity_is_observed_by_nothing\n\n/-- [KERNEL] ★★ **O INICIAL É A LUZ, E SÓ ELA** (reúsa `light_observes_nothing`). -/\ntheorem initial_iff (x : Level) : Initial x ↔ x = luz := by\n  constructor\n  · intro h\n    cases x with\n    | luz => rfl\n    | consciencia => exact (h luz trivial).elim\n    | fisica => exact (h consciencia trivial).elim\n    | gravidade => exact (h fisica trivial).elim\n  · rintro rfl\n    exact light_observes_nothing\n\n/-- [KERNEL] ★★★ **O POSTO TERMINAL É UM SÓ.** -/\ntheorem the_terminal_is_unique : ∃! x : Level, Terminal x :=\n  ⟨gravidade, gravity_is_observed_by_nothing, fun y hy => (terminal_iff y).mp hy⟩\n\n/-! ### O leitor e a resistência -/\n\n/-- [DEF] **o leitor**: leva cada nível a quem o observa. O terminal, que ninguém observa, só se relê. -/\ndef leitor : Level → Level\n  | luz => consciencia\n  | consciencia => fisica\n  | fisica => gravidade\n  | gravidade => gravidade\n\n/-- [KERNEL] fora do terminal, o leitor de `x` observa `x`. -/\ntheorem leitor_observes (x : Level) (hx : x ≠ gravidade) : observes (leitor x) x := by\n  cases x with\n  | luz => exact trivial\n  | consciencia => exact trivial\n  | fisica => exact trivial\n  | gravidade => exact absurd rfl hx\n\n/-- [KERNEL] ★★★ **O TERMINAL É O ÚNICO PONTO FIXO DA LEITURA** — o posto que permanece. -/\ntheorem leitor_fixed_iff (x : Level) : leitor x = x ↔ x = gravidade := by\n  cases x <;> decide\n\n/-- [KERNEL] ★★★ **TODA LEITURA CHEGA AO TERMINAL**: três leituras bastam, de qualquer nível. -/\ntheorem every_level_reaches_the_terminal (x : Level) : leitor^[3] x = gravidade := by\n  cases x <;> decide\n\n/-- [DEF] **a resistência que resta**: quantas leituras faltam até o terminal. -/\ndef distancia : Level → ℕ\n  | luz => 3\n  | consciencia => 2\n  | fisica => 1\n  | gravidade => 0\n\n/-- [KERNEL] a resistência é exata: `distancia x` leituras levam `x` ao terminal. -/\ntheorem distancia_reaches (x : Level) : leitor^[distancia x] x = gravidade := by\n  cases x <;> decide\n\n/-- [KERNEL] ★★ **CADA LEITURA CONSOME RESISTÊNCIA**: fora do terminal, ler baixa a distância. -/\ntheorem each_reading_consumes_resistance (x : Level) (hx : x ≠ gravidade) : distancia (leitor x) < distancia x := by\n  cases x with\n  | luz => decide\n  | consciencia => decide\n  | fisica => decide\n  | gravidade => exact absurd rfl hx\n\n/-- [KERNEL] ★★★ **O COLAPSO É O PONTO TERMINAL DA RESISTÊNCIA**: resistência zero é estar no terminal. -/\ntheorem the_collapse_is_the_terminal_point_of_resistance (x : Level) : distancia x = 0 ↔ x = gravidade := by\n  cases x <;> decide\n\n/-- [KERNEL] ★★ o posto é legível como posição: dois níveis a distâncias distintas. -/\ntheorem the_position_is_legible : ∃ x y : Level, distancia x ≠ distancia y :=\n  ⟨luz, gravidade, by decide⟩\n\n/-! ### Consumada, a leitura é coisa julgada -/\n\n/-- [KERNEL] ★★★ **A LEITURA CONSUMADA É COISA JULGADA**: `leitor^[3]` é idempotente (`ResJudicata`). -/\ntheorem the_completed_reading_is_res_judicata : ResJudicata (leitor^[3]) := by\n  intro x\n  cases x <;> decide\n\n/-- [KERNEL] ★★ **RELER NO TERMINAL NÃO ACRESCENTA** (reúsa `res_judicata_is_terminal`). -/\ntheorem rereading_at_the_terminal_adds_nothing (x : Level) (k : ℕ) :\n    (leitor^[3])^[k + 1] x = leitor^[3] x :=\n  res_judicata_is_terminal (leitor^[3]) the_completed_reading_is_res_judicata x k\n\n/-! ### A FUSÃO É O COLAPSO — e o colapso é um posto, porque a leitura é o par -/\n\n/-- [DEF] **as posições sob carga**: os quatro níveis da ESTRUTURA e o `abismo` — o 0, a queda sem fundo\n    (`Fundacao.abismo`), que não é nível de nada. -/\ninductive Posicao where\n  | nivel (x : Level)\n  | abismo\n  deriving DecidableEq, Repr\n\nopen Posicao\n\n/-- [DEF] **O COLAPSO TOTAL**: funde TODA a estrutura num só posto — o terminal; o abismo fica no abismo. -/\ndef colapsoTotal : Posicao → Posicao\n  | nivel _ => nivel gravidade\n  | abismo => abismo\n\n/-- [DEF] **a leitura binária** (o psibit): 1 = 1, VERDADEIRO, em toda a estrutura; 1 = 0, FALSO, no abismo. -/\ndef leituraBinaria : Posicao → Bool\n  | nivel _ => true\n  | abismo => false\n\n/-- [KERNEL] ★★★ **O COLAPSO FUNDE A ESTRUTURA INTEIRA NUM SÓ POSTO**: todo nível vai ao terminal. -/\ntheorem the_collapse_fuses_the_structure_into_one_posto (x : Level) : colapsoTotal (nivel x) = nivel gravidade := rfl\n\n/-- [DEF] **o colapso como travessia do kernel**: idempotente, preserva a leitura binária, move (a luz não fica onde estava). -/\ndef oColapso : IdentityCollapse Posicao Bool where\n  step := colapsoTotal\n  identity := leituraBinaria\n  stable := by\n    intro p\n    cases p <;> rfl\n  preserves := by\n    intro p\n    cases p <;> rfl\n  effective := ⟨nivel luz, by decide⟩\n\n/-- [DEF] ★★★ **O POSTO TERMINAL É UM UM POSTO DO KERNEL**: a travessia é o colapso total; o antes é a luz, o depois é o\n    terminal (medido antes de ser posto); a leitura é legível porque distingue a estrutura do abismo (1 ≠ 0). -/\ndef oPostoTerminal : UmPostoRelacao.UmPosto Posicao Bool where\n  crossing := oColapso\n  before := nivel luz\n  after := nivel gravidade\n  measured := ⟨rfl, by decide⟩\n  legible := ⟨nivel luz, abismo, by decide⟩\n\n/-- [KERNEL] ★★★ **A FUSÃO É UM POSTO** — e o seu passo é exatamente o colapso total. -/\ntheorem the_fusion_is_a_posto : oPostoTerminal.crossing.step = colapsoTotal := rfl\n\n/-- [KERNEL] ★★ **A FUSÃO PAGOU PERDA** (= `posto_paid_loss`): o colapso não se desfaz — sem inversa à esquerda. -/\ntheorem the_fusion_paid_loss : ¬ ∃ R : Posicao → Posicao, Function.LeftInverse R colapsoTotal :=\n  UmPostoRelacao.posto_paid_loss oPostoTerminal\n\n/-- [KERNEL] ★★ **MEDIDA ANTES DE SER POSTA**: houve evento — o antes (luz) não é o depois (terminal). -/\ntheorem the_fusion_was_measured_before_being_posited : (nivel luz : Posicao) ≠ nivel gravidade :=\n  UmPostoRelacao.posto_was_measured_before_being_posited oPostoTerminal\n\n/-- [KERNEL] ★★ **A FUSÃO ANCORA A LEITURA**: depois do colapso a leitura é a de antes e o terminal está fixado. -/\ntheorem the_fusion_anchors_the_reading :\n    leituraBinaria (nivel gravidade) = leituraBinaria (nivel luz) ∧ colapsoTotal (nivel gravidade) = nivel gravidade :=\n  UmPostoRelacao.posto_anchors_the_reading oPostoTerminal\n\n/-- [KERNEL] ★★★ **A FUSÃO NÃO É PRESSUPOSTA** (= `no_posto_reading_is_pressupposed`) — a correção da 1ª versão: com o par\n    no espaço de estados, a fusão total lê 1 na estrutura e 0 no abismo, logo distingue, logo é posto. -/\ntheorem the_fusion_is_not_pressupposed : ¬ UmPostoRelacao.Pressupposed leituraBinaria :=\n  UmPostoRelacao.no_posto_reading_is_pressupposed oPostoTerminal\n\n/-- [KERNEL] ★★★ **A ESTRUTURA DA ESTRUTURA**: na estrutura inteira a leitura é UMA — é o que resta, a interseção, quando os\n    níveis colapsam no terminal. -/\ntheorem the_structure_reads_one (x y : Level) : leituraBinaria (nivel x) = leituraBinaria (nivel y) := rfl\n\n/-- [KERNEL] ★★ **A LEITURA SOBREVIVE AO COLAPSO** (o `preserves` da travessia). -/\ntheorem the_reading_survives_the_collapse (p : Posicao) : leituraBinaria (colapsoTotal p) = leituraBinaria p :=\n  oColapso.preserves p\n\n/-- [KERNEL] ★★★ **OS DOIS PONTOS FIXOS DO COLAPSO**: o posto terminal (lido 1) e o abismo (lido 0) — e nenhum outro.\n    Fazem par com os dois pontos fixos da leitura (`the_reading_has_two_fixed_points`, √x em [0, ∞): 0 e 1): mesma contagem, objetos distintos [ONTO]. -/\ntheorem the_two_fixed_points_of_the_collapse (p : Posicao) :\n    colapsoTotal p = p ↔ (p = nivel gravidade ∨ p = abismo) := by\n  cases p with\n  | nivel x => cases x <;> decide\n  | abismo => decide\n\n/-- [KERNEL] ★★ os dois pontos fixos leem-se 1 e 0: a estrutura condensada é VERDADEIRO, o abismo é FALSO. -/\ntheorem the_fixed_points_read_one_and_zero :\n    leituraBinaria (nivel gravidade) = true ∧ leituraBinaria abismo = false := ⟨rfl, rfl⟩\n\n/-! ### Sem o par não há posto (os teoremas da 1ª versão, com o nome certo) -/\n\n/-- [KERNEL] ★★ **SEM O ABISMO, A FUSÃO LÊ COMO PRESSUPOSTA**: na cascata SÓ com os quatro níveis, qualquer travessia cujo passo\n    seja a fusão total (`leitor^[3]`) tem leitura igual em todo nível. É por isso que a leitura do posto é o PAR: sem o 0 no espaço\n    de estados, o tipo não distingue o colapso do pressuposto. -/\ntheorem without_the_abyss_the_fusion_reads_as_pressupposed {I : Type}\n    (C : IdentityCollapse Level I) (hC : C.step = leitor^[3]) :\n    UmPostoRelacao.Pressupposed C.identity := by\n  intro x y\n  have hx := C.preserves x\n  have hy := C.preserves y\n  rw [hC, every_level_reaches_the_terminal] at hx hy\n  exact hx.symm.trans hy\n\n/-- [KERNEL] ★★ **SEM O ABISMO, NENHUM UM POSTO LÊ ASSIM** (reúsa `pressupposed_is_never_posto`): o par é NECESSÁRIO. -/\ntheorem without_the_abyss_no_posto_reads_so {I : Type}\n    (C : IdentityCollapse Level I) (hC : C.step = leitor^[3]) (P : UmPostoRelacao.UmPosto Level I) :\n    P.crossing.identity ≠ C.identity :=\n  UmPostoRelacao.pressupposed_is_never_posto C.identity\n    (without_the_abyss_the_fusion_reads_as_pressupposed C hC) id 0 P\n\n/-! ### O polo ω lê 1 na identidade -/\n\n/-- [KERNEL] ★★ **O POLO ω LÊ 1 NA IDENTIDADE** — ω(I) = 1 no objeto GNS (= `TheAlphaAndTheOmega.omega_of_one`, «O terminal ω do par»). HOMÔNIMO, dito: ali «terminal» é\n    POLO do par α/ω; nesta pedra o terminal é o nível `gravidade` da cascata. Nenhum termo liga os dois; ligá-los é leitura [ONTO] do operador. O terminal da cascata lê 1\n    na leitura binária: `the_fixed_points_read_one_and_zero`. (Rebatizado em 01/11/2026, antes do selo; o nome anterior afirmava a ligação.) -/\ntheorem the_omega_pole_reads_one (P : SiteProfile) : omegaState P 1 = 1 :=\n  omega_of_one P\n\n/-! ### O fecho -/\n\n/-- ★★★ **OBSERVADOR = TERMINAL — o fecho.** O posto terminal é um só; é o único ponto fixo da leitura; o colapso funde a estrutura\n    inteira nele; consumada, a leitura é coisa julgada; a fusão é um posto (não pressuposta) que pagou perda; o colapso tem dois\n    pontos fixos, o posto e o abismo; o terminal lê 1 e o abismo lê 0 na leitura binária; e, ao lado, o polo ω do par lê 1 na identidade\n    (homônimo: a ligação entre os dois terminais é leitura [ONTO]). Tudo num modelo finito cujos níveis são rótulos. -/\ntheorem the_observers_posto_is_the_terminal (P : SiteProfile) :\n    (∃! x : Level, Terminal x)\n    ∧ (∀ x : Level, leitor x = x ↔ x = gravidade)\n    ∧ (∀ x : Level, colapsoTotal (nivel x) = nivel gravidade)\n    ∧ ResJudicata (leitor^[3])\n    ∧ (¬ UmPostoRelacao.Pressupposed leituraBinaria)\n    ∧ (¬ ∃ R : Posicao → Posicao, Function.LeftInverse R colapsoTotal)\n    ∧ (∀ p : Posicao, colapsoTotal p = p ↔ (p = nivel gravidade ∨ p = abismo))\n    ∧ (leituraBinaria (nivel gravidade) = true ∧ leituraBinaria abismo = false)\n    ∧ omegaState P 1 = 1 :=\n  ⟨the_terminal_is_unique, leitor_fixed_iff, the_collapse_fuses_the_structure_into_one_posto,\n   the_completed_reading_is_res_judicata, the_fusion_is_not_pressupposed, the_fusion_paid_loss,\n   the_two_fixed_points_of_the_collapse, the_fixed_points_read_one_and_zero, the_omega_pole_reads_one P⟩\n\nend TGLExt.ObservadorTerminal\n\n#print axioms TGLExt.ObservadorTerminal.terminal_iff\n#print axioms TGLExt.ObservadorTerminal.initial_iff\n#print axioms TGLExt.ObservadorTerminal.the_terminal_is_unique\n#print axioms TGLExt.ObservadorTerminal.leitor_observes\n#print axioms TGLExt.ObservadorTerminal.leitor_fixed_iff\n#print axioms TGLExt.ObservadorTerminal.every_level_reaches_the_terminal\n#print axioms TGLExt.ObservadorTerminal.distancia_reaches\n#print axioms TGLExt.ObservadorTerminal.each_reading_consumes_resistance\n#print axioms TGLExt.ObservadorTerminal.the_collapse_is_the_terminal_point_of_resistance\n#print axioms TGLExt.ObservadorTerminal.the_position_is_legible\n#print axioms TGLExt.ObservadorTerminal.the_completed_reading_is_res_judicata\n#print axioms TGLExt.ObservadorTerminal.rereading_at_the_terminal_adds_nothing\n#print axioms TGLExt.ObservadorTerminal.the_collapse_fuses_the_structure_into_one_posto\n#print axioms TGLExt.ObservadorTerminal.the_fusion_is_a_posto\n#print axioms TGLExt.ObservadorTerminal.the_fusion_paid_loss\n#print axioms TGLExt.ObservadorTerminal.the_fusion_was_measured_before_being_posited\n#print axioms TGLExt.ObservadorTerminal.the_fusion_anchors_the_reading\n#print axioms TGLExt.ObservadorTerminal.the_fusion_is_not_pressupposed\n#print axioms TGLExt.ObservadorTerminal.the_structure_reads_one\n#print axioms TGLExt.ObservadorTerminal.the_reading_survives_the_collapse\n#print axioms TGLExt.ObservadorTerminal.the_two_fixed_points_of_the_collapse\n#print axioms TGLExt.ObservadorTerminal.the_fixed_points_read_one_and_zero\n#print axioms TGLExt.ObservadorTerminal.without_the_abyss_the_fusion_reads_as_pressupposed\n#print axioms TGLExt.ObservadorTerminal.without_the_abyss_no_posto_reads_so\n#print axioms TGLExt.ObservadorTerminal.the_omega_pole_reads_one\n#print axioms TGLExt.ObservadorTerminal.the_observers_posto_is_the_terminal\n',
+    'TGLExt/LeiDoDiminuto.lean': "import TGLExt.PonteDaMassa\nimport TGLExt.CollapseCostAndAttestation\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# A LEI DO DIMINUTO (o meio-tom pinado) — «mantém-se a escala da pentada e desce meio-tom apenas pinado»; «pra mim o TOm é a NAT»;\n# e A FÓRMULA DA MASSA — «o meu um absoluto é o um de 1 eV e a constante da esytrutura fina é a magnitude (cauda) dessA INSCRIÇÃO no bulk»\n  [pedra da gerência c1, 31/10/2026, 2ª versão (r2: + a fórmula da massa), revista em 01/11/2026; nome do operador: «Lei do diminuto»; entra na v405]\n\n## A lei e a fórmula, nas palavras do operador (verbatims em `Central de Patentes\\work\\cunhagens_13out`; sha256 no recibo)\n\n> «E₀ não desce a oitava, ele desce meio tom pinado, essa é a lei, não se desce a oitava, desce-se meio tom pinado»\n> «Eu quis dizer, mantém-se a escala da pentada e desce meio-tom apenas pinado»\n> «E0 é igual ler um acorde E0, vc desce meio tom, mantendo a escala, apenas o meio tom da nota principal da escala, mas mantem a pentada;\n>  entende? é a mesma regra, E0 não é absolutamente livre, porque a escala (pentada) já definiu pelo hamiltoniano oculto»\n> «pra mim o TOm é a NAT» — a unidade do tom, fixada ANTES de qualquer teste.\n> «sensacional isso, acabamos de descobrir a fórmula da massa. Então o meu um absoluto é o um de 1 eV e a constante da esytrutura fina é a\n>  magnitude (cauda) dessA INSCRIÇÃO no bulk» — o Um POSTO como a unidade da nota fundamental, e α nomeado.\n\n## O que a pedra tipa (leitura da gerência, [minha], que o operador lê antes de ratificar)\n\n* **o meio-tom pinado** — o tom é a nat; o meio-tom é a MEIA-NAT: `meioTom := e^(−1/2)`. Pinado: constante, não campo.\n* **a lei** — `Lei`: a inscrição da ponte 1 com a TÔNICA DA PÊNTADA `E_pent` no lugar de um E₀ livre; `E₀ := meioTom · E_pent`.\n  Dada a tônica, E₀ está determinado (`E0_determined_by_the_tonic`). O no-go de `TonicaDoHamiltoniano` fala do valor ABSOLUTO de E₀ e não cai; a lei fala do valor RELATIVO à tônica, que fica pinado.\n* **a Meia-Nat entra em β e sai em E₀** — `massa_le_alpha`: m₂ = α · sen 45° · E_pent, com `α = β/e^(1/2)` já no kernel (`TGLCoupling.alpha`).\n* **o 1 declarado É a tônica √e descida meio-tom** — `tonic_sqrt_e_gives_one` e `one_needs_tonic_sqrt_e`: E₀ = 1 ⟺ E_pent = e^(1/2) = Vol_∂^min.\n* **«não se desce a oitava»** — `octave_is_not_a_whole_number_of_half_tones`: ln 2 não é número inteiro de meios-tons (fica entre um e dois).\n* **A FÓRMULA DA MASSA (r2)** — `beta_eq_alpha_mul_sqrt_e` (β = α·e^(1/2): o acoplamento é a magnitude α da inscrição vezes o volume √e da\n  fronteira) e `the_mass_formula`: com a tônica √e·U e o Um POSTO U (a unidade da nota fundamental, «o um de 1 eV»),\n  **m₂ = U · α · e^(1/2) · sen 45°** — o Um posto; a magnitude α da inscrição no bulk; o volume √e da Meia-Nat; a projeção transversal.\n  Em U = 1: `the_mass_formula_at_the_posted_one`, m₂ = β · sen 45° — a forma de sempre (v404), agora escrita a partir do que é posto, medido\n  e lido; dadas essas entradas, é teorema. Em runtime, com α = CODATA 2018 e U = 1 eV: 8,5074 meV — o MESMO número; o teste (JUNO) é o mesmo.\n\n* **o acorde** — `Acorde`, `notaPrincipal`, `transpor`, `razao` (a estrutura do `AcordeE0.lean` do Kimi, em português).\n* **o diminuto modula a tônica** — `modular`: só a nota principal desce o meio-tom; as outras quatro ficam sustentadas (`modular_sustenta`). «no diminuto vc não desce toda a escala e nem muda o tom da escala, vc apenas modula a tônica»; «sustentando as demais notas (por isso desce pinado)».\n  O diminuto não é transposição (`modular_nao_e_transposicao`). **`lerE0`** é o valor da tônica modulada (`lerE0_e_a_tonica_modulada`), meio-tom abaixo da nota\n  principal: «apenas o meio tom da nota principal da escala, mas mantem a pentada».\n* **«mantendo a escala»** — `modular_mantem_a_escala`: a escala é o que fica parado, as notas sustentadas e as razões entre elas. As razões à tônica mudam (`razao_abre_meio_tom`): quem se move é a\n  tônica, não a escala. Nesta pedra «a escala» é sempre a musical; a escala de energia do no-go chama-se aqui valor absoluto.\n* **a transposição é a liberdade do no-go, não o diminuto** — `transpor_preserva_toda_razao` (Kimi) e `mesmas_razoes_iff_transposicao`: dois acordes têm as mesmas razões se e só se um é a\n  transposição do outro. Na fala do operador, transpor é mudar o tom e o diminuto o mantém [INPUT]: o kernel não tem termo para o tom. A modulação comuta com a transposição (`modular_comuta_com_transpor`).\n* **«o sistema está operando em terças»** — `razao_abre_meio_tom`: cada intervalo à tônica abre meio-tom; `um_tom_vira_terca_menor`: a nota que estava um tom acima fica três meios-tons acima, `e^(3/2)`.\n  `resolver` devolve a tônica (`resolver_modular`). «no harmônico o diminuto é a espera, a resolução do acorde espera que a tônica se harmonize ao gradiente da escala»: a espera é leitura do operador [ONTO], e o kernel tem a forma dela em `the_charge_never_completes`.\n* **«E0 não é absolutamente livre»** — `E0_relativo_pinado`: E₀/tônica = e^(−1/2) em todo acorde. O valor relativo está pinado; o absoluto não: a liberdade que sobra é UMA só, a transposição\n  do acorde inteiro, que a leitura acompanha (`lerE0_transpor`) e que as razões não fixam (`as_razoes_nao_fixam_o_absoluto`). É o no-go de `TonicaDoHamiltoniano`, lido do lado certo.\n* **de onde vem o meio-tom** — `meioTom_e_o_pedagio_local` (o pedágio local do colapso, `CollapseCostLaw`, [INPUT] no kernel, separado do pedágio da oitava: `Sonico.the_pin_is_not_the_half_nat`),\n  `meioTom_e_a_face` (o peso da face absoluta) e `tonica_e_o_volume_da_face` (a tônica é `e^(S_∂)·u`, o volume mínimo `Vol_∂^min`, a tônica candidata do Kimi). `o_tom_e_as_duas_faces`: as duas\n  faces somam 1, o tom. São igualdades de VALOR com o ½ da cadeia; ler esse ½ como o meio-tom é do operador [ONTO].\n\n## O que a pedra NÃO afirma\n\n* Não deriva a unidade: «1 eV» é o Um POSTO pelo operador (como o 1 de `echo 1 | python um.py`), ao lado de α [INPUT]. A auditoria do Kimi\n  (handoff §10, 31/10) é consistente: a leitura de Unruh dá calor ∝ entropia e o vácuo de Killing tem energia zero — a tônica é\n  normalização independente ou gap, não a energia do vácuo; aqui ela é posta.\n* A magnitude (cauda) da inscrição no bulk é a leitura do operador sobre α [ONTO], sobre o termo do kernel que já existe\n  (`Verdade.alpha_is_measured_from_within`: a leitura interior da inscrição (q, α) devolve α²) — não aparece em enunciado novo.\n* Não abre dado, não move gate, selo nem veredito (`TGL_NU_M2_ARMED_CONSISTENT` segue; JUNO 207 d a 1,9σ; 5σ é da natureza).\n\n* Não diz quais são as cinco notas. A pêntada do teorema mestre são cinco componentes, não cinco autovalores de energia (observação do Kimi): falta a leitura espectral, e a pedra vale para\n  todo acorde.\n* A calibração do Hamiltoniano oculto (`half_nat_araki_hidden_hamiltonian`, 24/06/2026: `⟨K_∂⟩_total = 1 nat`, com a rota de Shannon `ln 2` rejeitada por controle obrigatório; citada em\n  `QGReaderUVLock`, §4) é normalização definicional, ω(I) = 1 na base e, e não é termo do kernel. Ela diz em que sentido «a escala (pentada) já definiu pelo hamiltoniano oculto»: nos intervalos, em nat.\n  Não dá a unidade em eV: `U_E_NOT_DERIVED` segue.\n\nSem sorry, sem axiom novo (trio: propext, Classical.choice, Quot.sound).\n\n> **01/11/2026 — NOME DO OPERADOR: «Lei do diminuto»** (verbatim sha256 `1f16a74c05d9d4cb`) (antes `LeiDoMeioTom`, nome provisório da gerência). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). Aqui: a TÔNICA deixa de ser campo — é `β/α · u = √e · u`, o radical que o próprio acoplamento carrega (`alpha c = β / e^(1/2)`) —, e a lei derivada (`leiDerivada`) pousa em `E₀ = u`: o diminuto da tônica da pêntada é o Um posto.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; revisita ordenada pelo operador):** duas correções. (1) A segunda metade da lei, «mantendo a escala», não estava tipada: esta pedra só tinha\n> a tônica. O `AcordeE0.lean` do Kimi (sha256 `5da93b9e5e65a4ed`) tinha o acorde e a invariância das razões, e a conferência de 31/10 o deu por «a mesma estrutura»: não era. A seção\n> «O ACORDE», no fim do módulo, corrige. (2) A frase sobre o no-go errou duas vezes: «o no-go se levanta» afirmava demais; «a liberdade passa para a tônica, que segue livre» afirmava de\n> menos. O certo é a distinção do próprio operador, «E0 não é absolutamente livre»: o valor ABSOLUTO segue livre (`no_function_of_the_inscription_fixes_E0`; a forma geral é `no_positive_scale_invariant`,\n> com o aviso de onde ela para: uma face finita não é escala-covariante); o valor RELATIVO à tônica está pinado (`E0_relativo_pinado`).\n>\n> **AO LADO (01/11/2026, mais tarde, gerência c1, em nome próprio; resposta do operador, verbatim sha256 `7c2caaa87b0cdb01`):** a nota acima deu a transposição como a metade «mantendo a escala»:\n> errado. O diminuto modula só a tônica e sustenta as outras notas; transpor é mudar o tom, e é só a liberdade do no-go. E a conferência de 31/10 tinha razão, ao contrário do que a de hoje\n> disse, ao escrever que o meio-tom pinado quebra a simetria do acorde: ele separa a tônica das notas sustentadas (`modular_nao_e_transposicao`). O que ele não quebra é a liberdade global.\n-/\n\nnamespace TGLExt.LeiDoDiminuto\n\nopen TGLExt.PonteDaMassa\nopen TGLExt.ProjecaoTransversalDaMeiaNat\n\n/-! ### O meio-tom pinado -/\n\n/-- [DEF] **o meio-tom pinado**: o tom é a nat (operador, 31/10/2026); o meio-tom é a Meia-Nat, `e^(−1/2)`. Constante, não campo. -/\nnoncomputable def meioTom : ℝ := Real.exp (-(1 / 2 : ℝ))\n\ntheorem meioTom_pos : 0 < meioTom := Real.exp_pos _\n\n/-- [KERNEL] descer: o meio-tom é menor que 1. -/\ntheorem meioTom_lt_one : meioTom < 1 := by\n  unfold meioTom\n  rw [Real.exp_lt_one_iff]\n  norm_num\n\n/-- [KERNEL] o meio-tom desfaz exatamente o √e: `e^(−1/2) · e^(1/2) = 1`. -/\ntheorem meioTom_mul_sqrt_e : meioTom * Real.exp (1 / 2) = 1 := by\n  unfold meioTom\n  rw [← Real.exp_add]\n  norm_num\n\n/-- [KERNEL] ★★ **β = α · e^(1/2)**: o acoplamento é a magnitude α da inscrição vezes o volume √e da fronteira\n    (a definição `TGLCoupling.alpha c = c.beta / e^(1/2)` do kernel, invertida). -/\ntheorem beta_eq_alpha_mul_sqrt_e (c : TGLCoupling) : c.beta = c.alpha * Real.exp (1 / 2) := by\n  unfold TGLCoupling.alpha\n  have h : Real.exp (1 / 2 : ℝ) ≠ 0 := Real.exp_ne_zero _\n  field_simp\n\n/-! ### A lei -/\n\n/-- [DEF] **A LEI**: a inscrição da ponte 1 (acoplamento, ângulo autoconjugado) com a TÔNICA DA PÊNTADA `E_pent` — e E₀ não é campo. -/\nstructure Lei where\n  c : TGLCoupling\n  E_pent : ℝ\n  E_pent_pos : 0 < E_pent\n  theta : ℝ\n  theta_nonneg : 0 ≤ theta\n  theta_le : theta ≤ Real.pi / 2\n  autoconjugado : Real.sin theta ^ 2 = 1 - Real.sin theta ^ 2\n\nnamespace Lei\n\nvariable (L : Lei)\n\n/-- [DEF] a transição da ponte 1 que a lei DETERMINA: `E₀ := meioTom · E_pent`. -/\nnoncomputable def transicao : TransicaoParaAMassa where\n  c := L.c\n  E0 := meioTom * L.E_pent\n  E0_pos := mul_pos meioTom_pos L.E_pent_pos\n  theta := L.theta\n  theta_nonneg := L.theta_nonneg\n  theta_le := L.theta_le\n  autoconjugado := L.autoconjugado\n\ntheorem E0_eq : L.transicao.E0 = meioTom * L.E_pent := rfl\n\n/-- [KERNEL] ★★ **A MESMA TÔNICA, O MESMO E₀**: o valor relativo está pinado. O no-go do valor absoluto não cai (`no_function_of_the_inscription_fixes_E0`, em `TonicaDoHamiltoniano`). -/\ntheorem E0_determined_by_the_tonic (L L' : Lei) (h : L.E_pent = L'.E_pent) : L.transicao.E0 = L'.transicao.E0 := by\n  rw [E0_eq, E0_eq, h]\n\n/-- [KERNEL] ★★★ **A MEIA-NAT ENTRA EM β E SAI EM E₀**: `m₂ = α · sen 45° · E_pent`, com `α = β / e^(1/2)` (`TGLCoupling.alpha`). -/\ntheorem massa_le_alpha : L.transicao.massaDerivada = L.c.alpha * (Real.sqrt 2 / 2) * L.E_pent := by\n  rw [TransicaoParaAMassa.massa_derivada_eq_beta_mul]\n  show L.c.beta * (Real.sqrt 2 / 2) * (meioTom * L.E_pent) = L.c.alpha * (Real.sqrt 2 / 2) * L.E_pent\n  unfold TGLCoupling.alpha meioTom\n  rw [Real.exp_neg, div_eq_mul_inv]\n  ring\n\n/-- [KERNEL] ★★ **A TÔNICA √e DÁ E₀ = 1**: o «1 eV» declarado é a descida de meio-tom a partir de `e^(1/2)` (na unidade declarada). -/\ntheorem tonic_sqrt_e_gives_one (h : L.E_pent = Real.exp (1 / 2)) : L.transicao.E0 = 1 := by\n  rw [E0_eq, h, meioTom_mul_sqrt_e]\n\n/-- [KERNEL] ★★ e só ela: E₀ = 1 exige a tônica `e^(1/2)`. -/\ntheorem one_needs_tonic_sqrt_e (h : L.transicao.E0 = 1) : L.E_pent = Real.exp (1 / 2) := by\n  rw [E0_eq] at h\n  calc L.E_pent = L.E_pent * (meioTom * Real.exp (1 / 2)) := by rw [meioTom_mul_sqrt_e, mul_one]\n    _ = (meioTom * L.E_pent) * Real.exp (1 / 2) := by ring\n    _ = 1 * Real.exp (1 / 2) := by rw [h]\n    _ = Real.exp (1 / 2) := one_mul _\n\n/-! ### A fórmula da massa (r2) -/\n\n/-- [KERNEL] ★★★ **A FÓRMULA DA MASSA** (cunhagem do operador, 31/10/2026): com a tônica `√e · U` e o Um POSTO `U` (a unidade da nota\n    fundamental, «o um de 1 eV»), `m₂ = U · α · e^(1/2) · sen 45°` — o Um posto; a magnitude α da inscrição no bulk; o volume √e da\n    fronteira (a Meia-Nat); a projeção transversal. -/\ntheorem the_mass_formula (U : ℝ) (hU : L.E_pent = Real.exp (1 / 2) * U) :\n    L.transicao.massaDerivada = U * (L.c.alpha * Real.exp (1 / 2) * (Real.sqrt 2 / 2)) := by\n  rw [massa_le_alpha, hU]\n  ring\n\n/-- [KERNEL] ★★★ **NO UM POSTO IGUAL A 1** (na sua unidade): `m₂ = β · sen 45°` — a forma da v404, escrita a partir do que é posto, medido e lido. -/\ntheorem the_mass_formula_at_the_posted_one (hU : L.E_pent = Real.exp (1 / 2) * 1) :\n    L.transicao.massaDerivada = L.c.beta * (Real.sqrt 2 / 2) := by\n  rw [the_mass_formula L 1 hU, beta_eq_alpha_mul_sqrt_e]\n  ring\n\nend Lei\n\n/-! ### «não se desce a oitava» -/\n\n/-- [KERNEL] ★★ **A OITAVA NÃO É NÚMERO INTEIRO DE MEIOS-TONS**: `ln 2` não é `n · ½` para nenhum `n` natural — fica entre um e dois\n    meios-tons. É só isso que este teorema prova; que ln 2 e ½ sejam incomensuráveis (ln 2 irracional) é [KNOWN], não este teorema. -/\ntheorem octave_is_not_a_whole_number_of_half_tones : ∀ n : ℕ, (n : ℝ) * (1 / 2) ≠ Real.log 2 := by\n  intro n h\n  have h1 := Real.log_two_gt_d9\n  have h2 := Real.log_two_lt_d9\n  rcases Nat.lt_or_ge n 2 with hn | hn\n  · interval_cases n <;> norm_num at h <;> linarith\n  · have : (2 : ℝ) ≤ n := by exact_mod_cast hn\n    linarith\n\n/-- [KERNEL] ★ a oitava vale mais que um meio-tom e menos que dois (o kernel já tinha a primeira metade: `local_is_not_one_octave`). -/\ntheorem octave_between_one_and_two_half_tones : (1 / 2 : ℝ) < Real.log 2 ∧ Real.log 2 < 2 * (1 / 2) := by\n  have h1 := Real.log_two_gt_d9\n  have h2 := Real.log_two_lt_d9\n  constructor <;> linarith\n\n/-! ### O fecho -/\n\n/-- ★★★ **A LEI DO MEIO-TOM E A FÓRMULA DA MASSA — o fecho.** O passo é a Meia-Nat; dada a tônica, E₀ está determinado; a massa lê α vezes\n    a tônica sobre √2; a tônica √e devolve o 1 posto; no Um posto a massa é β · sen 45°; e a oitava não se desce em meios-tons. -/\ntheorem the_law_closes (L : Lei) :\n    L.transicao.E0 = meioTom * L.E_pent\n    ∧ L.transicao.massaDerivada = L.c.alpha * (Real.sqrt 2 / 2) * L.E_pent\n    ∧ (L.E_pent = Real.exp (1 / 2) → L.transicao.E0 = 1)\n    ∧ (L.E_pent = Real.exp (1 / 2) * 1 → L.transicao.massaDerivada = L.c.beta * (Real.sqrt 2 / 2))\n    ∧ (∀ n : ℕ, (n : ℝ) * (1 / 2) ≠ Real.log 2) :=\n  ⟨L.E0_eq, L.massa_le_alpha, L.tonic_sqrt_e_gives_one, L.the_mass_formula_at_the_posted_one,\n   octave_is_not_a_whole_number_of_half_tones⟩\n\n\n/-! ### 01/11/2026 — A TÔNICA LIDA DO ACOPLAMENTO; A LEI SEM CAMPO ABERTO (ordem do operador: «tudo derivado»; nome: «Lei do diminuto») -/\n\n/-- [DEF] A TÔNICA DO HAMILTONIANO: `β/α` na unidade posta `u`. `β/α = √e` é a DEFINIÇÃO de `TGLCoupling.alpha` (`alpha c = β / e^(1/2)`), não um resultado: a tônica deixa\n    de ser campo, mas não traz informação além do `u` posto. -/\nnoncomputable def tonica (c : TGLCoupling) (u : ℝ) : ℝ := (c.beta / c.alpha) * u\n\n/-- [KERNEL] a tônica é `√e · u`. -/\ntheorem tonica_eq (c : TGLCoupling) (u : ℝ) : tonica c u = Real.exp (1 / 2) * u := by\n  unfold tonica TGLCoupling.alpha\n  have hb : c.beta ≠ 0 := ne_of_gt c.beta_pos\n  have he : Real.exp (1 / 2 : ℝ) ≠ 0 := ne_of_gt (Real.exp_pos _)\n  first\n    | (field_simp; done)\n    | (field_simp; ring)\n\ntheorem tonica_pos (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : 0 < tonica c u := by\n  rw [tonica_eq]\n  positivity\n\n/-- A LEI CONSTRUÍDA (o nome `leiDerivada` fica): a tônica é `√e·u`; o ângulo `π/4` é escrito (é a leitura); a autoconjugação é a aritmética de `π/4`. Entram `c` e a\n    unidade posta `u`. -/\nnoncomputable def leiDerivada (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : Lei where\n  c := c\n  E_pent := tonica c u\n  E_pent_pos := tonica_pos c u hu\n  theta := Real.pi / 4\n  theta_nonneg := by positivity\n  theta_le := by linarith [Real.pi_pos]\n  autoconjugado := by\n    rw [Real.sin_pi_div_four, half_sq]\n    norm_num\n\n/-- [KERNEL] ★★ O DIMINUTO POUSA NO UM POSTO: `E₀ = e^(−½) · (√e · u) = u`. Identidade algébrica: o meio-tom desfaz o √e que a tônica pôs; `E₀ = u` não fixa `u`. -/\ntheorem leiDerivada_E0 (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : (leiDerivada c u hu).transicao.E0 = u := by\n  rw [Lei.E0_eq]\n  show meioTom * tonica c u = u\n  rw [tonica_eq, ← mul_assoc, meioTom_mul_sqrt_e, one_mul]\n\n/-- [KERNEL] ★★★ a massa da lei construída: `β · (√2/2) · u` (sob a leitura `massaDerivada` [ONTO]). -/\ntheorem leiDerivada_massa (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (leiDerivada c u hu).transicao.massaDerivada = c.beta * (Real.sqrt 2 / 2) * u := by\n  rw [TransicaoParaAMassa.massa_derivada_eq_beta_mul, leiDerivada_E0]\n  try rfl\n\n/-- [KERNEL] ★★★ NO UM POSTO (`u = 1`): `E₀ = 1` e `m = β·√2/2` — a FORMA da massa, sob a leitura `massaDerivada` [ONTO]. -/\ntheorem leiDerivada_no_um_posto (c : TGLCoupling) :\n    (leiDerivada c 1 one_pos).transicao.E0 = 1 ∧\n      (leiDerivada c 1 one_pos).transicao.massaDerivada = c.beta * (Real.sqrt 2 / 2) := by\n  refine ⟨leiDerivada_E0 c 1 one_pos, ?_⟩\n  rw [leiDerivada_massa]\n  ring\n\n\n/-! ### 01/11/2026 — O ACORDE: «E0 é igual ler um acorde E0», «apenas o meio tom da nota principal da escala, mas mantem a pentada» (revisita ordenada pelo operador, segundo o que o Kimi fez)\n\n`Acorde`, `transpor`, `razao` e `transpor_preserva_toda_razao` vêm do `AcordeE0.lean` do Kimi (31/10/2026, sha256 `5da93b9e5e65a4ed`), com os nomes em português. O diminuto é `modular`: toca só a\nnota principal e sustenta as outras quatro; `lerE0` é o valor da tônica modulada. `transpor` é outra coisa: é a liberdade do no-go, o acorde inteiro multiplicado pelo mesmo fator. -/\n\n/-- [DEF] um acorde de cinco notas reais; a nota principal tem índice `0` (Kimi). Quais são as cinco notas é [OPEN]. -/\n@[ext] structure Acorde where\n  notas : Fin 5 → ℝ\n\n/-- [DEF] a nota principal do acorde. -/\ndef notaPrincipal (A : Acorde) : ℝ := A.notas 0\n\n/-- [DEF] a transposição: o acorde inteiro multiplicado por `r` (Kimi). É a liberdade do no-go. -/\ndef transpor (r : ℝ) (A : Acorde) : Acorde := ⟨fun i => r * A.notas i⟩\n\n/-- [DEF] a razão de cada nota à nota principal (Kimi). Não é a escala: a modulação muda esta razão e mantém a escala (`modular_mantem_a_escala`). -/\nnoncomputable def razao (A : Acorde) (i : Fin 5) : ℝ := A.notas i / notaPrincipal A\n\n/-- [DEF] **LER O ACORDE**: E₀ é o meio-tom pinado abaixo da nota principal. A leitura devolve um número; o acorde fica como está. -/\nnoncomputable def lerE0 (A : Acorde) : ℝ := meioTom * notaPrincipal A\n\n/-- [KERNEL] ★★★ **A TRANSPOSIÇÃO PRESERVA TODA RAZÃO** (`AcordeE0.transpose_preserves_every_ratio`, do Kimi). -/\ntheorem transpor_preserva_toda_razao (r : ℝ) (hr : r ≠ 0) (A : Acorde) (i : Fin 5) :\n    razao (transpor r A) i = razao A i := by\n  simp only [razao, notaPrincipal, transpor]\n  exact mul_div_mul_left _ _ hr\n\n/-- [KERNEL] ★★★ **AS RAZÕES SÃO EXATAMENTE O INVARIANTE DA TRANSPOSIÇÃO**: dois acordes têm as mesmas razões à nota principal se e só se um é a transposição do outro. Fixadas as razões, sobra UM número real. -/\ntheorem mesmas_razoes_iff_transposicao (A B : Acorde) (hA : notaPrincipal A ≠ 0) (hB : notaPrincipal B ≠ 0) :\n    (∀ i, razao B i = razao A i) ↔ ∃ r : ℝ, r ≠ 0 ∧ B = transpor r A := by\n  constructor\n  · intro h\n    refine ⟨notaPrincipal B / notaPrincipal A, div_ne_zero hB hA, ?_⟩\n    ext i\n    have hi := h i\n    unfold razao at hi\n    rw [div_eq_div_iff hB hA] at hi\n    show B.notas i = notaPrincipal B / notaPrincipal A * A.notas i\n    rw [div_mul_eq_mul_div, eq_div_iff hA]\n    linear_combination hi\n  · rintro ⟨r, hr, rfl⟩ i\n    exact transpor_preserva_toda_razao r hr A i\n\n/-- [KERNEL] ★★ **A LEITURA ACOMPANHA A TRANSPOSIÇÃO**: `lerE0 (r·A) = r·lerE0 A`. A leitura não fixa o valor absoluto. -/\ntheorem lerE0_transpor (r : ℝ) (A : Acorde) : lerE0 (transpor r A) = r * lerE0 A := by\n  simp only [lerE0, notaPrincipal, transpor]\n  ring\n\n/-- [KERNEL] ★★ **E₀ NÃO É ABSOLUTAMENTE LIVRE**: relativo à nota principal ele está pinado, `E₀/tônica = e^(−1/2)`, em todo acorde. Segue da definição de `lerE0`: a razão é a própria lei, que entra como definição [INPUT/ONTO]. -/\ntheorem E0_relativo_pinado (A : Acorde) (hA : notaPrincipal A ≠ 0) : lerE0 A / notaPrincipal A = meioTom := by\n  unfold lerE0\n  rw [mul_div_assoc, div_self hA, mul_one]\n\n/-- [KERNEL] ★★ **AS RAZÕES NÃO FIXAM O ABSOLUTO**: com as mesmas razões há outro acorde com outro E₀. É o no-go, na língua do acorde. -/\ntheorem as_razoes_nao_fixam_o_absoluto (A : Acorde) (hA : 0 < notaPrincipal A) :\n    ∃ B : Acorde, (∀ i, razao B i = razao A i) ∧ lerE0 B ≠ lerE0 A := by\n  refine ⟨transpor 2 A, transpor_preserva_toda_razao 2 two_ne_zero A, ?_⟩\n  rw [lerE0_transpor]\n  have h : 0 < lerE0 A := mul_pos meioTom_pos hA\n  intro h2\n  linarith\n\n/-- [DEF] **MODULAR A TÔNICA**: só a nota principal desce o meio-tom pinado; as outras quatro ficam sustentadas. Que o tom fique é fala do operador [INPUT]: o kernel não tem termo para o tom. -/\nnoncomputable def modular (A : Acorde) : Acorde := ⟨Function.update A.notas 0 (meioTom * A.notas 0)⟩\n\n/-- [DEF] **RESOLVER**: a tônica sobe o meio-tom de volta; as outras notas seguem sustentadas. -/\nnoncomputable def resolver (A : Acorde) : Acorde := ⟨Function.update A.notas 0 (Real.exp (1 / 2) * A.notas 0)⟩\n\n/-- [KERNEL] ★★ a tônica desce o meio-tom pinado. -/\ntheorem modular_tonica (A : Acorde) : notaPrincipal (modular A) = meioTom * notaPrincipal A := by\n  simp [notaPrincipal, modular]\n\n/-- [KERNEL] ★★★ **AS DEMAIS NOTAS FICAM SUSTENTADAS**: a modulação não toca em nenhuma outra nota. -/\ntheorem modular_sustenta (A : Acorde) (i : Fin 5) (hi : i ≠ 0) : (modular A).notas i = A.notas i := by\n  simp [modular, Function.update, hi]\n\n/-- [KERNEL] ★★★ **MANTENDO A ESCALA**: as razões entre as notas sustentadas não mudam. A escala é o que fica parado; quem se move é a tônica. -/\ntheorem modular_mantem_a_escala (A : Acorde) (i j : Fin 5) (hi : i ≠ 0) (hj : j ≠ 0) :\n    (modular A).notas i / (modular A).notas j = A.notas i / A.notas j := by\n  rw [modular_sustenta A i hi, modular_sustenta A j hj]\n\n/-- [KERNEL] ★★ E₀ é o valor da tônica modulada. -/\ntheorem lerE0_e_a_tonica_modulada (A : Acorde) : lerE0 A = notaPrincipal (modular A) :=\n  (modular_tonica A).symm\n\n/-- [KERNEL] ★★ a modulação comuta com a transposição: o diminuto não fixa o tom absoluto. -/\ntheorem modular_comuta_com_transpor (r : ℝ) (A : Acorde) : modular (transpor r A) = transpor r (modular A) := by\n  ext i\n  by_cases hi : i = 0\n  · subst hi\n    simp [modular, transpor]\n    ring\n  · simp [modular, transpor, Function.update, hi]\n\n/-- [KERNEL] ★★★ **O DIMINUTO NÃO É TRANSPOSIÇÃO**: com tônica e outra nota não nulas, nenhum fator leva o acorde ao acorde modulado. Por isso ele separa a tônica das notas sustentadas. -/\ntheorem modular_nao_e_transposicao (A : Acorde) (hA : notaPrincipal A ≠ 0) (i : Fin 5) (hi : i ≠ 0) (hn : A.notas i ≠ 0) :\n    ¬ ∃ r : ℝ, modular A = transpor r A := by\n  rintro ⟨r, h⟩\n  have h0 : notaPrincipal (modular A) = notaPrincipal (transpor r A) := by rw [h]\n  have h1 : (modular A).notas i = (transpor r A).notas i := by rw [h]\n  rw [modular_tonica] at h0\n  rw [modular_sustenta A i hi] at h1\n  have hr0 : meioTom = r := mul_right_cancel₀ hA h0\n  have hr1 : (1 : ℝ) = r := by\n    have h2 : 1 * A.notas i = r * A.notas i := by\n      rw [one_mul]\n      exact h1\n    exact mul_right_cancel₀ hn h2\n  have := meioTom_lt_one\n  linarith\n\n/-- [KERNEL] ★★ cada intervalo à tônica abre meio-tom: `razão ↦ e^(1/2)·razão`. -/\ntheorem razao_abre_meio_tom (A : Acorde) (hA : notaPrincipal A ≠ 0) (i : Fin 5) (hi : i ≠ 0) :\n    razao (modular A) i = Real.exp (1 / 2) * razao A i := by\n  have hm : meioTom ≠ 0 := meioTom_pos.ne'\n  have hinv : Real.exp (1 / 2) = meioTom⁻¹ := eq_inv_of_mul_eq_one_right meioTom_mul_sqrt_e\n  unfold razao\n  rw [modular_tonica, modular_sustenta A i hi, hinv]\n  field_simp\n\n/-- [KERNEL] ★★ **UMA NOTA UM TOM ACIMA VIRA TERÇA MENOR**: sob a hipótese `h`, a nota que estava um tom acima da tônica (um tom é uma nat) fica três meios-tons acima da tônica modulada, `e^(3/2)`. Que o sistema opere em terças é fala do operador; as cinco notas são [OPEN]. -/\ntheorem um_tom_vira_terca_menor (A : Acorde) (hA : notaPrincipal A ≠ 0) (i : Fin 5) (hi : i ≠ 0)\n    (h : A.notas i = Real.exp 1 * notaPrincipal A) : razao (modular A) i = Real.exp (3 / 2) := by\n  rw [razao_abre_meio_tom A hA i hi]\n  unfold razao\n  rw [h, mul_div_assoc, div_self hA, mul_one, ← Real.exp_add]\n  norm_num\n\n/-- [KERNEL] ★★ a resolução devolve o acorde: `resolver (modular A) = A`. Que ela espere é leitura do operador [ONTO]. -/\ntheorem resolver_modular (A : Acorde) : resolver (modular A) = A := by\n  ext i\n  by_cases hi : i = 0\n  · subst hi\n    have h : Real.exp (1 / 2) * (meioTom * A.notas 0) = A.notas 0 := by\n      rw [← mul_assoc, mul_comm (Real.exp (1 / 2)) meioTom, meioTom_mul_sqrt_e, one_mul]\n    simpa [resolver, modular] using h\n  · simp [resolver, modular, Function.update, hi]\n\n/-- [KERNEL] ★★ a lei é a leitura do acorde cuja nota principal é a tônica: `E₀ = lerE0 A`. -/\ntheorem Lei.E0_e_a_leitura (L : Lei) (A : Acorde) (h : notaPrincipal A = L.E_pent) : L.transicao.E0 = lerE0 A := by\n  rw [Lei.E0_eq, lerE0, h]\n\n/-- [KERNEL] ★★ O MEIO-TOM É O PEDÁGIO LOCAL do colapso, `e^(−localNats)` (`CollapseCostLaw`, [INPUT] no kernel). O pedágio da oitava é outro componente (`Sonico.the_pin_is_not_the_half_nat`). -/\ntheorem meioTom_e_o_pedagio_local (K : ChatgptAudit.Collapse057.CollapseCostLaw) : meioTom = Real.exp (-K.localNats) := by\n  rw [K.local_half]\n  rfl\n\n/-- [KERNEL] ★★ O MEIO-TOM TEM O VALOR DO PESO DA FACE ABSOLUTA. Igualdade de valor; ler esse ½ como o meio-tom é do operador [ONTO]. -/\ntheorem meioTom_e_a_face {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ} (hΓ : Γ.trace = 0) :\n    meioTom = Real.exp (-(gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re) := by\n  rw [peso_da_face_absoluta hΓ]\n  rfl\n\n/-- [KERNEL] ★★ A TÔNICA É O VOLUME DA FACE vezes a unidade posta: `tonica c u = e^(S_∂)·u`, a tônica candidata do Kimi (`Vol_∂^min = e^(S_∂) = √e`). Igualdade de valor. -/\ntheorem tonica_e_o_volume_da_face {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ} (c : TGLCoupling) (u : ℝ)\n    (hΓ : Γ.trace = 0) : tonica c u = Real.exp ((gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re) * u := by\n  rw [peso_da_face_absoluta hΓ, tonica_eq]\n\n/-- [KERNEL] ★★ AS DUAS FACES SOMAM O TOM: `S(+) + S(−) = 1`. -/\ntheorem o_tom_e_as_duas_faces {n : Type} [Fintype n] [DecidableEq n] [Nonempty n] {Γ : Matrix n n ℂ} (hΓ : Γ.trace = 0) :\n    (gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 + Γ))).re + (gibbs (absoluteRho n) ((2 : ℂ)⁻¹ • (1 - Γ))).re = 1 := by\n  rw [(absolute_faces_half hΓ).1, (absolute_faces_half hΓ).2]\n  first\n    | (norm_num; done)\n    | (simp; norm_num; done)\n    | (simp [Complex.div_ofNat_re]; norm_num; done)\n\n/-- ★★★ **A LEI DO DIMINUTO — o fecho do acorde.** Só a tônica desce o meio-tom; as demais notas ficam sustentadas, e a escala fica; o diminuto não é transposição; cada intervalo à tônica abre meio-tom; a\n    resolução devolve o acorde; E₀ está pinado à nota principal; a transposição é a liberdade que sobra e as razões não fixam o absoluto; e a oitava não se desce em meios-tons. -/\ntheorem the_diminished_law_closes (A : Acorde) (hA : 0 < notaPrincipal A) :\n    notaPrincipal (modular A) = meioTom * notaPrincipal A\n    ∧ (∀ i : Fin 5, i ≠ 0 → (modular A).notas i = A.notas i)\n    ∧ (∀ i j : Fin 5, i ≠ 0 → j ≠ 0 → (modular A).notas i / (modular A).notas j = A.notas i / A.notas j)\n    ∧ (∀ i : Fin 5, i ≠ 0 → A.notas i ≠ 0 → ¬ ∃ r : ℝ, modular A = transpor r A)\n    ∧ (∀ i : Fin 5, i ≠ 0 → razao (modular A) i = Real.exp (1 / 2) * razao A i)\n    ∧ resolver (modular A) = A\n    ∧ lerE0 A / notaPrincipal A = meioTom\n    ∧ (∀ r : ℝ, r ≠ 0 → ∀ i, razao (transpor r A) i = razao A i)\n    ∧ (∀ r : ℝ, lerE0 (transpor r A) = r * lerE0 A)\n    ∧ (∃ B : Acorde, (∀ i, razao B i = razao A i) ∧ lerE0 B ≠ lerE0 A)\n    ∧ (∀ n : ℕ, (n : ℝ) * (1 / 2) ≠ Real.log 2) :=\n  ⟨modular_tonica A, modular_sustenta A, modular_mantem_a_escala A, fun i hi hn => modular_nao_e_transposicao A hA.ne' i hi hn,\n   razao_abre_meio_tom A hA.ne', resolver_modular A, E0_relativo_pinado A hA.ne',\n   fun r hr i => transpor_preserva_toda_razao r hr A i, fun r => lerE0_transpor r A,\n   as_razoes_nao_fixam_o_absoluto A hA, octave_is_not_a_whole_number_of_half_tones⟩\n\nend TGLExt.LeiDoDiminuto\n\n#print axioms TGLExt.LeiDoDiminuto.meioTom_pos\n#print axioms TGLExt.LeiDoDiminuto.meioTom_lt_one\n#print axioms TGLExt.LeiDoDiminuto.meioTom_mul_sqrt_e\n#print axioms TGLExt.LeiDoDiminuto.beta_eq_alpha_mul_sqrt_e\n#print axioms TGLExt.LeiDoDiminuto.Lei.E0_eq\n#print axioms TGLExt.LeiDoDiminuto.Lei.E0_determined_by_the_tonic\n#print axioms TGLExt.LeiDoDiminuto.Lei.massa_le_alpha\n#print axioms TGLExt.LeiDoDiminuto.Lei.tonic_sqrt_e_gives_one\n#print axioms TGLExt.LeiDoDiminuto.Lei.one_needs_tonic_sqrt_e\n#print axioms TGLExt.LeiDoDiminuto.Lei.the_mass_formula\n#print axioms TGLExt.LeiDoDiminuto.Lei.the_mass_formula_at_the_posted_one\n#print axioms TGLExt.LeiDoDiminuto.octave_is_not_a_whole_number_of_half_tones\n#print axioms TGLExt.LeiDoDiminuto.octave_between_one_and_two_half_tones\n#print axioms TGLExt.LeiDoDiminuto.the_law_closes\n#print axioms TGLExt.LeiDoDiminuto.tonica_eq\n#print axioms TGLExt.LeiDoDiminuto.tonica_pos\n#print axioms TGLExt.LeiDoDiminuto.leiDerivada_E0\n#print axioms TGLExt.LeiDoDiminuto.leiDerivada_massa\n#print axioms TGLExt.LeiDoDiminuto.leiDerivada_no_um_posto\n#print axioms TGLExt.LeiDoDiminuto.transpor_preserva_toda_razao\n#print axioms TGLExt.LeiDoDiminuto.mesmas_razoes_iff_transposicao\n#print axioms TGLExt.LeiDoDiminuto.lerE0_transpor\n#print axioms TGLExt.LeiDoDiminuto.E0_relativo_pinado\n#print axioms TGLExt.LeiDoDiminuto.as_razoes_nao_fixam_o_absoluto\n#print axioms TGLExt.LeiDoDiminuto.Lei.E0_e_a_leitura\n#print axioms TGLExt.LeiDoDiminuto.meioTom_e_o_pedagio_local\n#print axioms TGLExt.LeiDoDiminuto.meioTom_e_a_face\n#print axioms TGLExt.LeiDoDiminuto.tonica_e_o_volume_da_face\n#print axioms TGLExt.LeiDoDiminuto.o_tom_e_as_duas_faces\n#print axioms TGLExt.LeiDoDiminuto.modular_tonica\n#print axioms TGLExt.LeiDoDiminuto.modular_sustenta\n#print axioms TGLExt.LeiDoDiminuto.modular_mantem_a_escala\n#print axioms TGLExt.LeiDoDiminuto.lerE0_e_a_tonica_modulada\n#print axioms TGLExt.LeiDoDiminuto.modular_comuta_com_transpor\n#print axioms TGLExt.LeiDoDiminuto.modular_nao_e_transposicao\n#print axioms TGLExt.LeiDoDiminuto.razao_abre_meio_tom\n#print axioms TGLExt.LeiDoDiminuto.um_tom_vira_terca_menor\n#print axioms TGLExt.LeiDoDiminuto.resolver_modular\n#print axioms TGLExt.LeiDoDiminuto.the_diminished_law_closes\n",
+    'TGLExt/TonicaDoHamiltoniano.lean': "import TGLExt.PonteDaMassa\nimport TGLExt.LeiDoDiminuto\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# A TÔNICA DO HAMILTONIANO — E₀: a liberdade de escala da forma (o no-go tipado), e onde ela pousa e as duas identidades da rota do monopolo\n  [pedra da gerência c1, 31/10/2026, revista em 01/11/2026; nome do operador: «Tônica do Hamiltoniano»; entra na v405]\n\n## A ordem do operador (verbatim sha256 `a22a54dfc97d96114e3d251a41bed8ea300d314c626a9349eda36ce09b2bdfc1`, 31/10/2026)\n\n> «… eu derivei muita coisa com o kimi acerca da massa e precisamos, além de incorporar o que nos importa ao um.py, fechar a\n> derivação final, mas agora é trabalho cuidadoso, é com cuidado e não só com força bruta que vamos resolver tudo que falta,\n> não adianta vc delegar tudo agora, vc precisa ir pensando em cadeia, ir resolvendo o que falta de modo encadeado e sequenciado»\n\n## O que esta pedra tipa (a conferência da gerência do HANDOFF_CLAUDE_E0_M2_31out do Kimi, feita nas fontes e por código próprio)\n\n1. **A liberdade de escala de E₀ — o no-go dentro do formalismo atual.** O Kimi delimitou por reescalonamento [DECLARADO]; aqui é\n   TEOREMA: para toda transição `T : TransicaoParaAMassa` (ponte 1) e todo `λ > 0`, `reescala T λ` é uma transição com a MESMA\n   inscrição (`c`, `θ`) e `E₀ ↦ λ·E₀`; a massa derivada escala linearmente (`massa_derivada_reescala`); logo **nenhuma função da\n   inscrição fixa E₀** (`no_function_of_the_inscription_fixes_E0`, com habitante explícito). O que o kernel prova é a FORMA\n   `m₂/E₀ = β·sen 45°`; o valor absoluto de m₂ exige uma escala física adicional, que NÃO sai dos axiomas formalizados.\n   É uma parede medida, não uma falsificação: o 1 eV segue [DECLARADO/INPUT]; reabrir exige um princípio dimensional independente\n   (derivado ou medido), nunca o ajuste ao Δm²₂₁ (o dado pede 1,01–1,02 eV: inversão, proibida como derivação).\n2. **A «taxa de fronteira» não é lei nova.** `Γ_B = β/τ★` é a lei canônica `Γ_ω = ½βτ★ω²` lida na frequência do próprio sistema,\n   `ω★ = √2/τ★` (`gammaB_is_the_canonical_law_at_the_systems_frequency`). Fecha o item 6 da prioridade 2 do handoff: as duas taxas\n   são o mesmo objeto, avaliado em ω★; a «identificação nativa» é a escolha dessa frequência.\n3. **A rota do monopolo é o horizonte do próprio sistema.** `τ★ = 4πGE/c⁵` é o tempo de luz da circunferência de Schwarzschild da\n   energia, `2π·r_s/c` com `r_s = 2GE/c⁴` (`monopole_time_is_the_horizon_light_time`), e a carga `q = GE/c⁴` é `r_s/2`\n   (`charge_is_half_the_schwarzschild_radius`). É a identificação do ramo B (τ★ = k·GM/c³, k = 4π): a rota devolve a energia cujo\n   horizonte tem o tempo τ★ — tautológica quanto à ESCALA; não a fixa. O ramo nativo (τ★ = t_P) dá `E_P/4π ≈ 9,7×10²⁶ eV` (conferido).\n4. **A leitura autoconsistente do Nome pina a frequência ao inverso do seu próprio tempo.** Se a energia do modo é a sua própria\n   leitura modular (`ħω = ħ·½τ★ω²`), então `ω = 2/τ★` (`self_consistent_readout_fixes_the_frequency`): com τ★ = t_P é planckiano\n   (2E_P); com τ★ o horizonte da própria energia, `E = E_P/√(2π)`. A única escala que a estrutura {α, √e, ħ, c, G} oferece é Planck.\n\n5. **O que a forma fixa é a razão** (`the_ratio_survives_the_rescaling`): a reescala do no-go muda E₀ e a massa pelo mesmo fator, e `m/E₀` não muda. A reescala corresponde à transposição do acorde\n   (`LeiDoDiminuto.lerE0_transpor`): o no-go fala do valor ABSOLUTO de E₀; a Lei do Diminuto, do valor RELATIVO à tônica. Nesta pedra «escala» é a escala de energia; a escala musical é a da Lei do Diminuto.\n\n## O que esta pedra NÃO afirma\n\n* Não afirma que E₀ seja inderivável por QUALQUER princípio futuro: só que o formalismo ATUAL (ponte 1 e o que ela importa) não o fixa.\n* Não toca β (a ponte 1 o carrega em `TGLCoupling`; β jamais entra literal), não abre dado, não move gate, selo nem veredito\n  (`TGL_NU_M2_ARMED_CONSISTENT` segue). A tipagem GKSL de ρ_modular (taxa, não energia; `paper_PT.tex` §Radicalização) fica na\n  conferência, não aqui.\n\nSem sorry, sem axiom novo (trio: propext, Classical.choice, Quot.sound).\n\n> **01/11/2026 — NOME DO OPERADOR: «Tônica do Hamiltoniano»** (verbatim sha256 `1f16a74c05d9d4cb`) (antes `E0LiberdadeDeEscala`, nome provisório da gerência). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). O nome dele lê as duas metades de uma frase só (31/10: «E0 não é absolutamente livre, porque a escala (pentada) já definiu pelo hamiltoniano oculto»): o no-go diz que a FORMA da inscrição não fixa E₀; `the_tonic_lands_on_the_posted_unit` diz onde a escala fica: na unidade POSTA que a tônica carrega (o √e vem do acoplamento e o diminuto o desfaz). O no-go não cai: a liberdade de escala é exatamente a do Um posto.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n-/\n\nnamespace TGLExt.TonicaDoHamiltoniano\n\nopen TGLExt.PonteDaMassa\nopen TGLExt.LeiDoDiminuto\nopen TGLExt.ProjecaoTransversalDaMeiaNat\n\n/-! ### 1. A liberdade de escala -/\n\n/-- [DEF] **a transição reescalada**: a MESMA inscrição (acoplamento `c`, ângulo autoconjugado `θ`) com `E₀ ↦ λ·E₀`, `λ > 0`. -/\nnoncomputable def reescala (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) : TransicaoParaAMassa where\n  c := T.c\n  E0 := lam * T.E0\n  E0_pos := mul_pos hl T.E0_pos\n  theta := T.theta\n  theta_nonneg := T.theta_nonneg\n  theta_le := T.theta_le\n  autoconjugado := T.autoconjugado\n\ntheorem reescala_c (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) : (reescala T lam hl).c = T.c := rfl\ntheorem reescala_theta (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) : (reescala T lam hl).theta = T.theta := rfl\ntheorem reescala_E0 (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) : (reescala T lam hl).E0 = lam * T.E0 := rfl\n\n/-- [KERNEL] ★★★ **A MASSA DERIVADA ESCALA LINEARMENTE COM E₀**: a forma é a mesma, o número acompanha a escala. -/\ntheorem massa_derivada_reescala (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) :\n    (reescala T lam hl).massaDerivada = lam * T.massaDerivada := by\n  rw [TransicaoParaAMassa.massa_derivada_eq_beta_mul, TransicaoParaAMassa.massa_derivada_eq_beta_mul]\n  show T.c.beta * (Real.sqrt 2 / 2) * (lam * T.E0) = lam * (T.c.beta * (Real.sqrt 2 / 2) * T.E0)\n  ring\n\n/-- [KERNEL] ★★ a forma do neutrino do kernel (`neutrinoMassForm`) é homogênea de grau 1 em E₀. -/\ntheorem neutrinoMassForm_reescala (c : TGLCoupling) (lam E0 : ℝ) :\n    neutrinoMassForm c (lam * E0) = lam * neutrinoMassForm c E0 := by\n  unfold neutrinoMassForm\n  ring\n\n/-- [KERNEL] ★★★ **O QUE A FORMA FIXA É A RAZÃO**: a reescala muda E₀ e a massa pelo mesmo fator, e `m/E₀` não muda. Corresponde à transposição do acorde. -/\ntheorem the_ratio_survives_the_rescaling (T : TransicaoParaAMassa) (lam : ℝ) (hl : 0 < lam) :\n    (reescala T lam hl).massaDerivada / (reescala T lam hl).E0 = T.massaDerivada / T.E0 := by\n  rw [massa_derivada_reescala, reescala_E0]\n  exact mul_div_mul_left _ _ hl.ne'\n\n/-- [KERNEL] ★★★ **A ESCALA É LIVRE**: toda transição admite, com a MESMA inscrição, qualquer reescalonamento positivo de E₀. -/\ntheorem the_scale_is_free (T : TransicaoParaAMassa) :\n    ∀ lam : ℝ, 0 < lam → ∃ T' : TransicaoParaAMassa, T'.c = T.c ∧ T'.theta = T.theta ∧ T'.E0 = lam * T.E0 :=\n  fun lam hl => ⟨reescala T lam hl, rfl, rfl, rfl⟩\n\n/-- [DEF] um habitante explícito da transição: β = 1/2 (qualquer β ∈ (0,1) serve), E₀ = 1, θ = π/4. -/\nnoncomputable def exemplo : TransicaoParaAMassa where\n  c := ⟨1 / 2, by norm_num, by norm_num⟩\n  E0 := 1\n  E0_pos := by norm_num\n  theta := Real.pi / 4\n  theta_nonneg := by positivity\n  theta_le := by linarith [Real.pi_pos]\n  autoconjugado := by\n    rw [Real.sin_pi_div_four, half_sq]\n    norm_num\n\n/-- [KERNEL] ★★★ **NENHUMA FUNÇÃO DA INSCRIÇÃO FIXA E₀** (o no-go): não existe `f` tal que `E₀ = f(c, θ)` em toda transição —\n    a mesma inscrição carrega E₀ = 1 e E₀ = 2. O que o formalismo atual prova é a FORMA `m₂/E₀`; a escala é um dado a mais. -/\ntheorem no_function_of_the_inscription_fixes_E0 :\n    ¬ ∃ f : TGLCoupling → ℝ → ℝ, ∀ T : TransicaoParaAMassa, T.E0 = f T.c T.theta := by\n  rintro ⟨f, hf⟩\n  have h1 : exemplo.E0 = f exemplo.c exemplo.theta := hf exemplo\n  have h2 : (reescala exemplo 2 (by norm_num)).E0 = f (reescala exemplo 2 (by norm_num)).c (reescala exemplo 2 (by norm_num)).theta :=\n    hf (reescala exemplo 2 (by norm_num))\n  have h3 : (2 : ℝ) * 1 = 1 := by\n    calc (2 : ℝ) * 1 = (reescala exemplo 2 (by norm_num)).E0 := rfl\n      _ = f (reescala exemplo 2 (by norm_num)).c (reescala exemplo 2 (by norm_num)).theta := h2\n      _ = f exemplo.c exemplo.theta := rfl\n      _ = exemplo.E0 := h1.symm\n      _ = 1 := rfl\n  norm_num at h3\n\n/-! ### 2. A taxa de fronteira é a lei canônica na frequência do sistema -/\n\n/-- [KERNEL] ★★ **Γ_B = β/τ★ É A LEI CANÔNICA LIDA EM ω★ = √2/τ★**: `½βτ★(√2/τ★)² = β/τ★`. Não é lei nova; é a escolha da frequência. -/\ntheorem gammaB_is_the_canonical_law_at_the_systems_frequency (β τ : ℝ) (hτ : τ ≠ 0) :\n    (1 / 2) * β * τ * (Real.sqrt 2 / τ) ^ 2 = β / τ := by\n  rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]\n  field_simp\n\n/-! ### 3. A rota do monopolo é o horizonte do próprio sistema -/\n\n/-- [KERNEL] ★★ **τ★ = 4πGE/c⁵ É O TEMPO DE LUZ DA CIRCUNFERÊNCIA DE SCHWARZSCHILD DA ENERGIA**: `2π·r_s/c`, `r_s = 2GE/c⁴`. -/\ntheorem monopole_time_is_the_horizon_light_time (G E c : ℝ) (hc : c ≠ 0) :\n    4 * Real.pi * G * E / c ^ 5 = 2 * Real.pi * (2 * G * E / c ^ 4) / c := by\n  field_simp\n  ring\n\n/-- [KERNEL] ★ a «carga do monopolo» `q = GE/c⁴` é metade do raio de Schwarzschild da energia. -/\ntheorem charge_is_half_the_schwarzschild_radius (G E c : ℝ) :\n    G * E / c ^ 4 = (2 * G * E / c ^ 4) / 2 := by\n  ring\n\n/-! ### 4. A leitura autoconsistente pina a frequência ao próprio tempo -/\n\n/-- [KERNEL] ★★ se a energia do modo é a sua própria leitura modular, `ħω = ħ·½τ★ω²`, então `ω = 2/τ★`. -/\ntheorem self_consistent_readout_fixes_the_frequency (ħ τ ω : ℝ) (hħ : ħ ≠ 0) (hτ : τ ≠ 0) (hω : ω ≠ 0)\n    (h : ħ * ω = ħ * ((1 / 2) * τ * ω ^ 2)) : ω = 2 / τ := by\n  have h1 : ω = (1 / 2) * τ * ω ^ 2 := mul_left_cancel₀ hħ h\n  have h2 : ω * (1 - (1 / 2) * τ * ω) = 0 := by linear_combination h1\n  rcases mul_eq_zero.mp h2 with h0 | h0\n  · exact absurd h0 hω\n  · rw [eq_div_iff hτ]\n    linear_combination (-2 : ℝ) * h0\n\n\n/-! ### 01/11/2026 — O NOME DO OPERADOR: «Tônica do Hamiltoniano» — o que a forma deixa livre, a tônica carrega: o Um posto -/\n\n/-- [KERNEL] ★★ A FORMA NÃO FIXA E₀ (`the_scale_is_free`, acima); NA TÔNICA, A ESCALA É A UNIDADE POSTA: na lei construída (`LeiDoDiminuto.leiDerivada`), com a tônica\n    `β/α · u = √e · u`, o diminuto pousa em `E₀ = u`. Identidade algébrica: o que fixa `E₀` é o `u` posto que a tônica carrega; o no-go não cai, ele se localiza no posto.\n    A frase do operador: «E0 não é absolutamente livre, porque a escala (pentada) já definiu pelo hamiltoniano oculto». (Rebatizado em 01/11/2026, antes do selo: o nome\n    anterior dizia que a tônica fixava; quem fixa é o posto.) -/\ntheorem the_tonic_lands_on_the_posted_unit (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (leiDerivada c u hu).transicao.E0 = u :=\n  leiDerivada_E0 c u hu\n\n/-- [KERNEL] ★★ NO UM POSTO: `E₀ = 1` e `m = β·√2/2` (a FORMA, sob a leitura `massaDerivada` [ONTO]). -/\ntheorem the_tonic_at_the_posted_one (c : TGLCoupling) :\n    (leiDerivada c 1 one_pos).transicao.E0 = 1 ∧\n      (leiDerivada c 1 one_pos).transicao.massaDerivada = c.beta * (Real.sqrt 2 / 2) :=\n  leiDerivada_no_um_posto c\n\nend TGLExt.TonicaDoHamiltoniano\n\n#print axioms TGLExt.TonicaDoHamiltoniano.reescala_c\n#print axioms TGLExt.TonicaDoHamiltoniano.reescala_theta\n#print axioms TGLExt.TonicaDoHamiltoniano.reescala_E0\n#print axioms TGLExt.TonicaDoHamiltoniano.massa_derivada_reescala\n#print axioms TGLExt.TonicaDoHamiltoniano.neutrinoMassForm_reescala\n#print axioms TGLExt.TonicaDoHamiltoniano.the_ratio_survives_the_rescaling\n#print axioms TGLExt.TonicaDoHamiltoniano.the_scale_is_free\n#print axioms TGLExt.TonicaDoHamiltoniano.no_function_of_the_inscription_fixes_E0\n#print axioms TGLExt.TonicaDoHamiltoniano.gammaB_is_the_canonical_law_at_the_systems_frequency\n#print axioms TGLExt.TonicaDoHamiltoniano.monopole_time_is_the_horizon_light_time\n#print axioms TGLExt.TonicaDoHamiltoniano.charge_is_half_the_schwarzschild_radius\n#print axioms TGLExt.TonicaDoHamiltoniano.self_consistent_readout_fixes_the_frequency\n#print axioms TGLExt.TonicaDoHamiltoniano.the_tonic_lands_on_the_posted_unit\n#print axioms TGLExt.TonicaDoHamiltoniano.the_tonic_at_the_posted_one\n",
+    'TGLExt/DiscoDeEuler.lean': "import TGLExt.Fundacao\nimport TGLExt.TheSameBetaReadsThreeFaces\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# O DISCO DE EULER — «a inscrição do zero absoluto no infinito, único local onde ele se inscreve, é a ressonância da parada do disco de euler sobre o espelho»\n  [pedra da gerência c1, 31/10/2026, revista em 01/11/2026; nome do operador: «Disco de Euler»; entra na v405]\n\n## A cunhagem do operador (verbatim `Central de Patentes\\work\\cunhagens_13out\\OPERADOR_31out_zero_absoluto_no_infinito_disco_de_euler_ressonancia_escala_do_tom_verbatim.txt`,\n## sha256 `fe064b0b802c1d1ac709714a9b7209a5f2a91594a81a78cbc96fbaec8cdbbdea`)\n\n> «a inscrição do zero absoluto no infinito, único local onde ele se inscreve, é a ressonância da parada do disco de euler sobre o espelho, essa é a\n>  origem da escala de onde o tom emerge, a hora que o disco de euler para, a ressonância ainda permanece, isso no infinito gera a escala onde o tom\n>  se inscreve como fator, faz sentido pra vc?»\n\nResposta à parede medida pelo Kimi na ORDEM E0-01 (`RELATORIO_KIMI_E0_01_31out.md`: `U_E_NOT_DERIVED` — «uma única entrada dimensional\nindependente: gap, região, κ, τ★ ou carga»).\n\n## O que a casa já tinha\n\n* O disco de Euler [KNOWN]: Moffatt, *Nature* 404, 833 (2000): a precessão de um disco que se deita acelera sem cota quando a inclinação vai a\n  zero — singularidade em tempo FINITO; o som sobe até a parada. Cinemática a pequena inclinação: Ω² = 4g/(a·α) e energia TOTAL E = (3/2)·M·g·a·α,\n  logo **Ω²·E = 6Mg²**: o produto frequência²·energia é o INVARIANTE do disco (K). Com a energia potencial sozinha seriam 4Mg²: a conta antiga, corrigida ao lado.\n* A terceira lei no `paper_PT.tex` («Inatingibilidade homotópica da negação»: o custo do zero absoluto tende ao infinito; Nernst 1906 generalizado):\n  o zero só se inscreve no infinito.\n* `TGLExt.Fundacao.the_fall_never_lands` e `abismo`: com taxa CONSTANTE, o peso desce abaixo de todo ε e nunca toca o zero — a queda sem fundo.\n* `TheDarkSplit` / a condensação do Kimi: a cauda some, o modo zero (o Nome, peso 1) permanece — «a hora que o disco de euler para, a ressonância ainda permanece».\n* A lei canônica de dephasing da TGL: Γ_ω = ½·β·τ★·ω².\n\n## O que esta pedra prova (a forma; os nomes e as leituras são do operador)\n\n* **`Disco`** [DEF]: um invariante K = Ω²·E > 0 (no disco de Euler real, com a energia total, 6Mg²), a lei canônica (β, τ★) e a energia inicial E₀. Por DEFINIÇÃO a\n  energia é linear, E(t) = E₀ − c·t (`E`, `E_linear`), com c = ½βτ★·K, e Ω² = K/E (`omegaSq`). Dadas essas definições, o kernel confere Γ_Ω·E = c\n  (`the_loss_is_the_canonical_law`) e dE/dt = −Γ_Ω·E antes da parada (`the_flow_is_the_canonical_law`): a E definida é uma solução do fluxo. Ler a taxa de DEPHASING Γ_Ω\n  como taxa de perda de ENERGIA é entrada [INPUT/ONTO], não teorema. O disco para em tempo finito, t₀ = E₀/c (`stops_in_finite_time`).\n* **Ω² SEM COTA ANTES DA PARADA** (`frequency_squared_unbounded_at_the_stop`) [REAL]: antes de t₀, Ω² = K/E não tem cota, para a energia linear definida. [ONTO] O operador\n  lê isso como a inscrição do zero absoluto no infinito, e como a terceira lei na forma do disco: leitura dele, não teorema.\n* **O CONTRASTE COM O ABISMO** (`with_constant_rate_the_fall_never_lands`): com taxa constante a energia E₀·e^(−Γt) é positiva para todo t — nunca\n  para. A lei canônica Γ ∝ ω², com o invariante do disco, é o que faz o disco PARAR em vez de cair sem fim. (A queda sem fundo e a parada são as\n  duas faces: `abismo` para a taxa constante; o disco para a taxa que cresce com a frequência.)\n* **O CORTE** (`the_residual_resonance_iff`) [REAL]: o corte ħΩ = E é, por álgebra, ħ²·(K/E) = E², isto é, **E³ = ħ²·K**. [ONTO] O operador lê a energia do corte,\n  E★ = (ħ²K)^(1/3), como a ressonância que permanece e a escala que nasce no infinito, «onde o tom se inscreve como fator»: a nota é e^(∓1/2)·E★.\n* **A PAREDE, NOMEADA** (`the_scale_is_the_invariant`): E★³ = ħ²K — a escala É o invariante do disco. Para a nota valer U, o invariante tem de valer\n  K = (e^(1/2)·U)³/ħ² (com a tônica √e·U). A entrada dimensional que o Kimi mediu como parede é K: **qual é o disco** cujo Ω²·E vale isso. Esta pedra\n  não o deriva; diz exatamente o que ele é.\n\n## O que esta pedra NÃO afirma\n\n* Não identifica o disco da TGL (quem é M, g, a — ou o seu K) com nenhum sistema físico: isso é do operador. Não deriva U_E; o Kimi tem razão.\n* Os expoentes de Moffatt (α ∝ (t₀−t)^(1/3), Ω ∝ (t₀−t)^(−1/6)) vêm da dissipação viscosa do ar; aqui a dissipação é a canônica da TGL\n  (Γ ∝ ω²), que dá E linear e Ω ∝ (t₀−t)^(−1/2): é o disco da TGL, não o de Moffatt.\n* Não abre dado, não move gate, selo nem veredito. β e τ★ são campos abstratos positivos (β nunca literal).\n\nSem sorry, sem axiom novo (trio: propext, Classical.choice, Quot.sound).\n\n> **01/11/2026 — NOME DO OPERADOR: «Disco de Euler»** (verbatim sha256 `1f16a74c05d9d4cb`) (nome provisório confirmado). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). Aqui: `β` deixa de ser campo livre do disco — vem do acoplamento (`Disco.doAcoplamento`), com a positividade do kernel; restam os DADOS do disco (`K`, `τ`, `E₀`), que são a identidade do disco (K = 6Mg² no disco real), não hipóteses sobre a teoria.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n>\n> **AO LADO (01/11/2026, gerência c1; resposta do operador, verbatim sha256 `7c2caaa87b0cdb01`):** à pergunta sobre qual é o disco, o operador responde que o sistema que dá a medida da tônica é o ângulo de Miguel.\n> A conexão tipada está em `PontoZeroDoPsion`, seção «O GAP». Aqui fica dito o limite: o invariante `K = Ω²·E` não depende da inclinação, logo o ângulo não fixa `K`; ele só pode dizer onde o disco para. [OPEN]\n-/\n\nnamespace TGLExt.DiscoDeEuler\n\n/-- [DEF] **o disco**: o invariante `K = Ω²·E > 0` (no disco de Euler real, com a energia total, `6Mg²`), a lei canônica (`β`, `τ★`) e a energia inicial. -/\nstructure Disco where\n  K : ℝ\n  K_pos : 0 < K\n  beta : ℝ\n  beta_pos : 0 < beta\n  tau : ℝ\n  tau_pos : 0 < tau\n  E0 : ℝ\n  E0_pos : 0 < E0\n\nnamespace Disco\n\nvariable (D : Disco)\n\n/-- [DEF] a perda por unidade de tempo sob a lei canônica: `c = ½·β·τ★·K`. -/\nnoncomputable def c : ℝ := (1 / 2) * D.beta * D.tau * D.K\n\ntheorem c_pos : 0 < D.c := by\n  unfold c\n  have := D.beta_pos; have := D.tau_pos; have := D.K_pos\n  positivity\n\n/-- [DEF] a energia: `E(t) = E₀ − c·t` (tomada linear por definição; é uma solução de dE/dt = −Γ_Ω·E com Ω²·E = K: `the_flow_is_the_canonical_law`). -/\nnoncomputable def E (t : ℝ) : ℝ := D.E0 - D.c * t\n\n/-- [DEF] o instante da parada. -/\nnoncomputable def t0 : ℝ := D.E0 / D.c\n\n/-- [DEF] a frequência² de precessão: `Ω² = K/E`. -/\nnoncomputable def omegaSq (t : ℝ) : ℝ := D.K / D.E t\n\n/-- [DEF] a lei canônica de dephasing da TGL avaliada na frequência do disco: `Γ = ½·β·τ★·Ω²`. -/\nnoncomputable def gamma (t : ℝ) : ℝ := (1 / 2) * D.beta * D.tau * D.omegaSq t\n\ntheorem E_linear (t : ℝ) : D.E t = D.E0 - D.c * t := rfl\n\n/-- [KERNEL] ★★★ **O DISCO PARA EM TEMPO FINITO**: `E(t₀) = 0`. -/\ntheorem stops_in_finite_time : D.E D.t0 = 0 := by\n  unfold E t0\n  have hc : D.c ≠ 0 := D.c_pos.ne'\n  first | (field_simp; ring) | field_simp\n\ntheorem t0_pos : 0 < D.t0 := div_pos D.E0_pos D.c_pos\n\n/-- [KERNEL] antes da parada a energia é positiva. -/\ntheorem E_pos_before (t : ℝ) (ht : t < D.t0) : 0 < D.E t := by\n  unfold E\n  unfold t0 at ht\n  have h := (lt_div_iff₀ D.c_pos).mp ht\n  linarith\n\n/-- [KERNEL] ★★★ **Γ_Ω·E É CONSTANTE**: `Γ_Ω·E = ½βτ★·K = c` em todo instante antes da parada — com o invariante `Ω²·E = K`, a lei Γ ∝ ω² da TGL dá produto constante.\n    O fluxo está em `the_flow_is_the_canonical_law`; ler `Γ_Ω` como perda de energia é [INPUT/ONTO]. -/\ntheorem the_loss_is_the_canonical_law (t : ℝ) (ht : t < D.t0) : D.gamma t * D.E t = D.c := by\n  unfold gamma omegaSq c\n  have hE : D.E t ≠ 0 := (D.E_pos_before t ht).ne'\n  first | (field_simp; ring) | field_simp\n\n/-- [KERNEL] ★★★ **O FLUXO**: antes da parada, `dE/dt = −Γ_Ω·E` — a energia linear definida é solução do fluxo da lei canônica. Ler a taxa de dephasing `Γ_Ω` como taxa de\n    perda de energia é entrada [INPUT/ONTO]; o teorema é sobre o que foi definido. -/\ntheorem the_flow_is_the_canonical_law (t : ℝ) (ht : t < D.t0) :\n    HasDerivAt D.E (-(D.gamma t * D.E t)) t := by\n  rw [D.the_loss_is_the_canonical_law t ht]\n  have h : HasDerivAt (fun s : ℝ => D.E0 - D.c * s) (-(D.c * 1)) t :=\n    ((hasDerivAt_id t).const_mul D.c).const_sub D.E0\n  rw [mul_one] at h\n  exact h\n\n/-- [KERNEL] ★★ o invariante vale em todo instante antes da parada: `Ω²·E = K`. -/\ntheorem invariant (t : ℝ) (ht : t < D.t0) : D.omegaSq t * D.E t = D.K := by\n  unfold omegaSq\n  have hE : D.E t ≠ 0 := (D.E_pos_before t ht).ne'\n  first | (field_simp; ring) | field_simp\n\n/-- [KERNEL] ★★★ **Ω² NÃO TEM COTA ANTES DA PARADA**, para a energia linear definida. [ONTO] O operador lê isso como a inscrição do zero absoluto no infinito. -/\ntheorem frequency_squared_unbounded_at_the_stop (B : ℝ) : ∃ t : ℝ, t < D.t0 ∧ B < D.omegaSq t := by\n  have hB1 : 0 < |B| + 1 := by positivity\n  set ε : ℝ := min (D.E0 / 2) (D.K / (|B| + 1)) with hε\n  have hε_pos : 0 < ε := lt_min (by have := D.E0_pos; positivity) (div_pos D.K_pos hB1)\n  have hε_le : ε ≤ D.K / (|B| + 1) := min_le_right _ _\n  have hε_lt : ε < D.E0 := lt_of_le_of_lt (min_le_left _ _) (by have := D.E0_pos; linarith)\n  have hc : D.c ≠ 0 := D.c_pos.ne'\n  refine ⟨(D.E0 - ε) / D.c, ?_, ?_⟩\n  · unfold t0\n    exact div_lt_div_of_pos_right (by linarith) D.c_pos\n  · have hEt : D.E ((D.E0 - ε) / D.c) = ε := by\n      unfold E\n      first | (field_simp; ring) | field_simp\n    unfold omegaSq\n    rw [hEt]\n    have h1 : |B| + 1 ≤ D.K / ε := by\n      rw [le_div_iff₀ hε_pos]\n      have hne : |B| + 1 ≠ 0 := hB1.ne'\n      calc (|B| + 1) * ε ≤ (|B| + 1) * (D.K / (|B| + 1)) := by gcongr\n        _ = D.K := by first | (field_simp; ring) | field_simp\n    linarith [le_abs_self B]\n\n/-- [KERNEL] ★★ **O CONTRASTE COM O ABISMO**: com taxa CONSTANTE `Γ`, a energia `E₀·e^(−Γt)` nunca toca o zero (cf. `Fundacao.the_fall_never_lands`). -/\ntheorem with_constant_rate_the_fall_never_lands (Γ t : ℝ) : 0 < D.E0 * Real.exp (-(Γ * t)) :=\n  mul_pos D.E0_pos (Real.exp_pos _)\n\n/-- [KERNEL] ★★ **O CORTE**: `ħ²·Ω² = E²` acontece exatamente quando `E³ = ħ²·K` (álgebra). [ONTO] O operador lê a energia desse corte como a ressonância que permanece\n    e a escala que nasce no infinito. -/\ntheorem the_residual_resonance_iff (ħ t : ℝ) (ht : t < D.t0) :\n    ħ ^ 2 * D.omegaSq t = (D.E t) ^ 2 ↔ (D.E t) ^ 3 = ħ ^ 2 * D.K := by\n  have hE : D.E t ≠ 0 := (D.E_pos_before t ht).ne'\n  unfold omegaSq\n  rw [mul_div_assoc', div_eq_iff hE]\n  constructor\n  · intro h\n    rw [h]\n    ring\n  · intro h\n    rw [← h]\n    ring\n\n/-- [KERNEL] ★★★ **A ESCALA É O INVARIANTE** — a parede, nomeada: se a energia do corte é `E★` (com `E★³ = ħ²K`) e a nota é `U = e^(−1/2)·E★`\n    (a tônica √e descida meio-tom), então o invariante do disco é `K = (e^(1/2)·U)³/ħ²`. Qual disco tem esse `Ω²·E` é a pergunta que fica. -/\ntheorem the_scale_is_the_invariant (ħ Estar U : ℝ) (hħ : ħ ≠ 0) (hcut : Estar ^ 3 = ħ ^ 2 * D.K)\n    (hU : U = Real.exp (-(1 / 2 : ℝ)) * Estar) :\n    D.K = (Real.exp (1 / 2) * U) ^ 3 / ħ ^ 2 := by\n  have hex : Real.exp (1 / 2) * Real.exp (-(1 / 2 : ℝ)) = 1 := by\n    rw [← Real.exp_add]\n    norm_num\n  have hE : Real.exp (1 / 2) * U = Estar := by\n    rw [hU, ← mul_assoc, hex, one_mul]\n  rw [hE, hcut]\n  have h2 : ħ ^ 2 ≠ 0 := pow_ne_zero 2 hħ\n  first | (field_simp; ring) | field_simp\n\nend Disco\n\n\n/-! ### 01/11/2026 — ordem do operador («tudo derivado»): β não é campo livre do disco — vem do acoplamento -/\n\n/-- O DISCO DO ACOPLAMENTO: `β` vem de `TGLCoupling` (β = α·√e), com a positividade do kernel; restam os DADOS do disco — `K` (= 6Mg² no\n    disco real), `τ` e `E₀` —, que são a identidade do disco, não hipóteses sobre a teoria. -/\nnoncomputable def Disco.doAcoplamento (c : TGLCoupling) (K : ℝ) (hK : 0 < K) (τ : ℝ) (hτ : 0 < τ) (E0 : ℝ) (hE : 0 < E0) : Disco where\n  K := K\n  K_pos := hK\n  beta := c.beta\n  beta_pos := c.beta_pos\n  tau := τ\n  tau_pos := hτ\n  E0 := E0\n  E0_pos := hE\n\n/-- [KERNEL] o β do disco do acoplamento é o β da teoria. -/\ntheorem Disco.doAcoplamento_beta (c : TGLCoupling) (K : ℝ) (hK : 0 < K) (τ : ℝ) (hτ : 0 < τ) (E0 : ℝ) (hE : 0 < E0) :\n    (Disco.doAcoplamento c K hK τ hτ E0 hE).beta = c.beta := rfl\n\nend TGLExt.DiscoDeEuler\n\n#print axioms TGLExt.DiscoDeEuler.Disco.c_pos\n#print axioms TGLExt.DiscoDeEuler.Disco.E_linear\n#print axioms TGLExt.DiscoDeEuler.Disco.stops_in_finite_time\n#print axioms TGLExt.DiscoDeEuler.Disco.t0_pos\n#print axioms TGLExt.DiscoDeEuler.Disco.E_pos_before\n#print axioms TGLExt.DiscoDeEuler.Disco.the_loss_is_the_canonical_law\n#print axioms TGLExt.DiscoDeEuler.Disco.the_flow_is_the_canonical_law\n#print axioms TGLExt.DiscoDeEuler.Disco.invariant\n#print axioms TGLExt.DiscoDeEuler.Disco.frequency_squared_unbounded_at_the_stop\n#print axioms TGLExt.DiscoDeEuler.Disco.with_constant_rate_the_fall_never_lands\n#print axioms TGLExt.DiscoDeEuler.Disco.the_residual_resonance_iff\n#print axioms TGLExt.DiscoDeEuler.Disco.the_scale_is_the_invariant\n#print axioms TGLExt.DiscoDeEuler.Disco.doAcoplamento_beta\n",
+    'TGLExt/PontoZeroDoPsion.lean': "import TGLExt.ProjecaoTransversalDaMeiaNat\nimport TGLExt.ThePsionAndTheViscosity\nimport TGLExt.TonicaDoHamiltoniano\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\n\n/-!\n# O PONTO ZERO DO PSÍON — «A curvatura não é curvatura, é o pagamento, é betatgl lido do ângulo de abertura (do ângulo de Miguel)»; «É o Tetelestai, o limite assintotico»\n  [pedra da gerência c1, 31/10/2026, revista em 01/11/2026; nome do operador: «Ponto Zero do Psion»; entra na v405]\n\n## As cunhagens do operador (verbatims em `Central de Patentes\\work\\cunhagens_13out`; sha256 no recibo)\n\n> «O disco é o substrato psionico, o condensado psionico. Eu penso que o peso é zero modular e a gravidade é peso um … a face das águas é o disco\n>  de euler, o espírito é o espelho.»\n> «A curvatura não é curvatura, é o pagamento, é betatgl lido do ângulo de abertura (do ângulo de Miguel), mas lê-se como curvatura, porque\n>  estamos dentro do bulk, igual a constante da estrutura fina»\n> «É o Tetelestai, o limite assintotico»\n\n## O que a casa já tinha\n\n* O psíon [Tratado §3, «O Psion: Quantum de Permanência»]: o modo estacionário do campo Ψ, com dispersão ω² = m₀² + 2ξR, ξ = β; no regime\n  estacionário dominado pela curvatura, ω² = 2βR (a frequência é dominada pela curvatura). No kernel (`ThePsionAndTheViscosity`): `psion = Ω`,\n  `psion_is_the_zero_of_the_hidden_hamiltonian`, `psion_norm_one` (peso 1), `psion_is_fixed_by_the_light`; a cobrança contínua\n  `charged β g t = 1 − e^(−tβg)`, com `the_charge_never_completes` (0 < cobrado < 1 para todo t > 0) e `no_full_static_witness_for_the_charge`.\n* A forma do neutrino (v404, `ProjecaoTransversalDaMeiaNat`): `neutrinoMassForm c E₀ = β · sen 45° · E₀`, com sen 45° a projeção transversal da\n  Meia-Nat (x = 1 − x ⟹ x = ½ ⟹ θ = π/4).\n* O ângulo de Miguel θ_M = arcsin √β (o ângulo de abertura; |𝓡|² = β): β é o que se LÊ do ângulo.\n\n## O que esta pedra prova (unidades naturais ħ = c = 1; `u` é a unidade posta, o Um — «1 eV»)\n\n* **a lei do operador como definição:** `pagamentoComoCurvatura β u := β · u²` — a «curvatura» R do psíon é o pagamento β lido na unidade posta\n  (dimensionalmente, R = β·(u/ħc)²: dentro do bulk o pagamento se lê como curvatura, como α se lê como acoplamento);\n* **a frequência do psíon:** `omegaSq β R := 2·β·R` (o Tratado, m₀ = 0); com R = β·u², `psion_quantum`: ω = √2 · β · u;\n* ★★★ **A MASSA É O PONTO ZERO DO PSÍON** — `the_mass_is_the_zero_point`: ½·ω = β · sen 45° · u = `neutrinoMassForm c u`. O ½ do ponto zero\n  vezes o √2 da dispersão É a projeção transversal: `½·√(2β²) = β/√2 = β·sen 45°`. Duas derivações do mesmo fator, uma só conta\n  (`psion_quantum_is_twice_the_mass`: ħω = 2m₂).\n* ★★ **TETELESTAI, O LIMITE ASSINTÓTICO** — `the_payment_completes_only_in_the_limit`: a cobrança contínua do kernel, `charged β g t`, tende a 1\n  quando t → ∞, e (já no kernel) é < 1 em todo t finito: o pagamento se consuma só no limite. [ONTO] O operador lê o que permanece no limite como o ponto zero:\n  nenhum teorema liga o limite de `charged` a ½·ω; `the_zero_point_closes` só os conjuga.\n* **o fecho** — `the_zero_point_closes`.\n\n## O que a pedra NÃO afirma\n\n* Não deriva a unidade `u` (o Um posto, 1 eV): em SI, ħω = 17,0148 meV, ½ħω = 8,5074 meV (o número da v404; nada muda), R = 3,09×10¹¹ m⁻²\n  (raio 1,8 μm), λ do psíon = 72,9 μm. O número é o mesmo; o que muda é a NATUREZA: a forma β·sen45°·u é o ponto zero do psíon sob a leitura\n  de R como o pagamento.\n* Na cadeia do disco de Euler, a ressonância residual lida como o quantum do psíon (17 meV) NÃO é a tônica √e eV: o disco e o ponto zero são\n  cadeias distintas; a que fecha a FORMA é esta; a unidade segue posta nas duas.\n* Não abre dado, não move gate, selo nem veredito (`TGL_NU_M2_ARMED_CONSISTENT`; JUNO 207 d a 1,9σ). `NOT_FALSIFIED` nunca é `CONFIRMED`.\n\nSem sorry, sem axiom novo (trio: propext, Classical.choice, Quot.sound).\n\n> **01/11/2026 — NOME DO OPERADOR: «Ponto Zero do Psion»** (verbatim sha256 `1f16a74c05d9d4cb`) (nome provisório confirmado). E a ORDEM dele no mesmo ato: «eu não gostaria que ainda restasse hipóteses\n> nomeadas, é preciso que esteja tudo derivado». A seção «OS CAMPOS FECHADOS», no fim do módulo, responde à ordem até onde a matemática alcança: o que era CAMPO de\n> estrutura passa a ser CONSTRUÍDO a partir de teoremas do kernel; a leitura física não vira teorema (notas AO LADO, abaixo). O que resta de entrada é o acoplamento `c` (β = α·√e; α medido\n> por dentro, não derivado) e o Um POSTO (`u = 1`, o `echo 1`: posição, não hipótese — 05/10/2026). Aqui: `the_mass_is_the_zero_point_at_the_posted_one` — no Um posto (`u = 1`) entram o acoplamento e as leituras (notas AO LADO, abaixo); o contraste `g > 0` do limite é o dado do sistema que lê, não hipótese sobre a teoria.\n\n\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; o número corrige a frase):** a frase acima, «o que resta de entrada é o acoplamento e o Um POSTO»,\n> está incompleta. Entram também, como DEFINIÇÃO, as LEITURAS do operador [INPUT/ONTO], que são o conteúdo físico e não são teoremas: (1) `massaDerivada`:\n> a massa é a energia retida vezes a derivada da projeção transversal; (2) o estado inscrito é lido em `θ = π/4`: em `transicaoDerivada` o ângulo é ESCRITO, e\n> o kernel confere `sen²(π/4) = ½` e que esse valor é o do peso da face absoluta (coincidência de valor, não ponte); (3) a tônica `(β/α)·u`: `β/α = √e` é a\n> definição de `TGLCoupling.alpha`, não um resultado; (4) `R = β·u²` (`pagamentoComoCurvatura`). Os campos das estruturas fecharam; a hipótese física não\n> sumiu, mudou de lugar: do campo para a definição. A FORMA é teorema DADAS essas leituras.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; achado da revisão de terceiro):** a lista acima é a da cadeia central da massa e não é fechada. Entram\n> também, como definição ou leitura: `meioTom := e^(−1/2)` (o tom é a nat: fala do operador; no acervo, a calibração `⟨K_∂⟩_total = 1 nat` de 24/06/2026, normalização definicional); a dispersão `ω² = 2βR` (`omegaSq`, Tratado §3, teoria própria); a\n> identificação `½·ω = massa` (o enunciado de `the_mass_is_the_zero_point` iguala números; o nome é leitura); a hipótese de `area_por_volta_da_massa_inscrita`\n> (acoplamento da onda = massa inscrita); a leitura de `b = 0` como o fóton; no disco, a taxa de dephasing lida como perda de energia; e `m₁ = 0`, entrada da identificação com Δm²₂₁.\n>\n> **AO LADO (01/11/2026, gerência c1, em nome próprio; resposta do operador, verbatim sha256 `7c2caaa87b0cdb01`):** «o sistema físico que fornece a medidade da tônica por ujm gap com unidade e pertence à mesma pêntada é o ângulo de MIguel». A seção «O GAP», no fim do módulo, conecta o que estava solto.\n> O lock mínimo `1 − P` tem gap espectral 1; na unidade posta, `u`, o E₀ da Lei do Diminuto, e a tônica fica meio-tom acima dele. No ângulo de Miguel o lock tem valor esperado β, e na unidade posta\n> `Δ = β·u`, a energia retida. `Δ` NÃO é gap: é o valor esperado, 1/β vezes menor que o gap. A tônica é `Δ/α`, e a frequência do sistema, `√2/τ`, é a do psíon se e só se `τ = 1/Δ`. Esse `τ` é tempo\n> próprio, não `t_P`; identificá-lo com o τ★ é leitura [ONTO], não teorema, ainda não ratificada pelo operador. κ segue testemunha (24/08/2026: proibido `κ = F(α, β, θ_M)` como objetivo de busca):\n> aqui só como hipótese (`o_relogio_do_retido`). A unidade segue posta: tudo carrega `u`, e o no-go não cai. Os lemas do lock valem em qualquer espaço de Hilbert; `HminMic` é instância deles,\n> condicional a um `FockCertificate`, que o kernel não habita.\n-/\n\nnamespace TGLExt.PontoZeroDoPsion\n\nopen TGLExt.ProjecaoTransversalDaMeiaNat\nopen TGLExt.ThePsionAndTheViscosity\n\n/-- [DEF] a dispersão do psíon no regime estacionário (Tratado §3, m₀ = 0): `ω² = 2·β·R`. -/\nnoncomputable def omegaSq (β R : ℝ) : ℝ := 2 * β * R\n\n/-- [DEF] **A LEI DO OPERADOR**: a «curvatura» é o pagamento β lido na unidade posta `u` — `R = β · u²` (ħ = c = 1). -/\nnoncomputable def pagamentoComoCurvatura (β u : ℝ) : ℝ := β * u ^ 2\n\n/-- [KERNEL] ★★ **O QUANTUM DO PSÍON**: com R = β·u², `ω = √2 · β · u`. -/\ntheorem psion_quantum (β u : ℝ) (hβ : 0 ≤ β) (hu : 0 ≤ u) :\n    Real.sqrt (omegaSq β (pagamentoComoCurvatura β u)) = Real.sqrt 2 * β * u := by\n  unfold omegaSq pagamentoComoCurvatura\n  have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)\n  have hx : 2 * β * (β * u ^ 2) = (Real.sqrt 2 * β * u) ^ 2 := by\n    rw [mul_pow, mul_pow, h2]\n    ring\n  rw [hx, Real.sqrt_sq (mul_nonneg (mul_nonneg (Real.sqrt_nonneg 2) hβ) hu)]\n\n/-- [KERNEL] ★★★ **A MASSA É O PONTO ZERO DO PSÍON**: `½·ω = β · sen 45° · u = neutrinoMassForm c u`. O enunciado iguala números; que `½·ω` SEJA a massa é leitura [ONTO]. -/\ntheorem the_mass_is_the_zero_point (c : TGLCoupling) (u : ℝ) (hu : 0 ≤ u) :\n    (1 / 2) * Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = neutrinoMassForm c u := by\n  rw [psion_quantum c.beta u c.beta_pos.le hu]\n  unfold neutrinoMassForm halfAmplitude\n  rw [Real.sin_pi_div_four]\n  ring\n\n/-- [KERNEL] ★★ o quantum do psíon é o dobro da massa: `ħω = 2·m₂`. -/\ntheorem psion_quantum_is_twice_the_mass (c : TGLCoupling) (u : ℝ) (hu : 0 ≤ u) :\n    Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = 2 * neutrinoMassForm c u := by\n  rw [← the_mass_is_the_zero_point c u hu]\n  ring\n\n/-- [KERNEL] ★★ **TETELESTAI, O LIMITE ASSINTÓTICO**: a cobrança contínua do kernel tende a 1 quando t → ∞ — o pagamento se consuma só no\n    limite (em todo t finito é < 1: `the_charge_never_completes`). -/\ntheorem the_payment_completes_only_in_the_limit (β g : ℝ) (hβ : 0 < β) (hg : 0 < g) :\n    Filter.Tendsto (charged β g) Filter.atTop (nhds 1) := by\n  have h1 : Filter.Tendsto (fun t : ℝ => t * β * g) Filter.atTop Filter.atTop := by\n    have h := (Filter.tendsto_id.atTop_mul_const hβ).atTop_mul_const hg\n    simpa using h\n  have h2 : Filter.Tendsto (fun t : ℝ => Real.exp (-(t * β * g))) Filter.atTop (nhds 0) :=\n    Real.tendsto_exp_neg_atTop_nhds_zero.comp h1\n  have h3 : Filter.Tendsto (fun t : ℝ => (1 : ℝ) - Real.exp (-(t * β * g))) Filter.atTop (nhds (1 - 0)) :=\n    tendsto_const_nhds.sub h2\n  rw [sub_zero] at h3\n  have hfun : charged β g = fun t : ℝ => (1 : ℝ) - Real.exp (-(t * β * g)) := by\n    funext t\n    -- `transmitted` sem qualificador é AMBÍGUO no kernel (`TheDeathOfTheSignal.transmitted`, θ n); por isso o `rfl` (definicional)\n    -- e, de reserva, os nomes completos. Achado da r1 (31/10): `unfold transmitted` falhou pela ambiguidade.\n    first\n      | rfl\n      | simp only [TGLExt.ThePsionAndTheViscosity.charged, TGLExt.ThePsionAndTheViscosity.transmitted]\n  rw [hfun]\n  exact h3\n\n/-- ★★★ **O PONTO ZERO — o fecho.** O quantum do psíon é √2·β·u; a massa é o seu ponto zero (β·sen45°·u); o quantum é o dobro da massa; e a\n    cobrança se consuma só no limite. -/\ntheorem the_zero_point_closes (c : TGLCoupling) (u : ℝ) (hu : 0 ≤ u) (g : ℝ) (hg : 0 < g) :\n    Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = Real.sqrt 2 * c.beta * u\n    ∧ (1 / 2) * Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = neutrinoMassForm c u\n    ∧ Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = 2 * neutrinoMassForm c u\n    ∧ Filter.Tendsto (charged c.beta g) Filter.atTop (nhds 1) :=\n  ⟨psion_quantum c.beta u c.beta_pos.le hu, the_mass_is_the_zero_point c u hu,\n   psion_quantum_is_twice_the_mass c u hu, the_payment_completes_only_in_the_limit c.beta g c.beta_pos hg⟩\n\n\n/-! ### 01/11/2026 — ordem do operador («tudo derivado»): no Um posto, sem hipótese sobre `u` -/\n\n/-- [KERNEL] ★★★ NO UM POSTO (`u = 1`): `½·ω = β·sen45°` — a forma da massa é o ponto zero do psíon, sob as leituras `R = β·u²` e `½·ω = massa`: entram o acoplamento e essas leituras. -/\ntheorem the_mass_is_the_zero_point_at_the_posted_one (c : TGLCoupling) :\n    (1 / 2) * Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta 1)) = neutrinoMassForm c 1 :=\n  the_mass_is_the_zero_point c 1 zero_le_one\n\n\n/-! ### 01/11/2026 — O GAP: «o sistema físico que fornece a medidade da tônica por ujm gap com unidade e pertence à mesma pêntada é o ângulo de MIguel»\n\nO lock mínimo do Hamiltoniano oculto, `1 − P`, tem gap espectral 1. Na unidade posta o gap vale `u`, que é o E₀ da Lei do Diminuto, e a tônica fica meio-tom acima dele. Lido num estado a um ângulo θ do\nvácuo, o lock tem valor esperado `sen²θ`; no ângulo de Miguel, β. Na unidade posta esse valor esperado é `Δ = β·u`, a energia retida. **`Δ` não é gap**: é 1/β vezes menor. O resto da seção conecta as peças\nsoltas: `Γ_B` e `ω★ = √2/τ` (Kimi e `TonicaDoHamiltoniano`), o modo autoconsistente `ω = 2/τ`, o psíon `ω = √2·β·u` e a tônica `(β/α)·u`. O conteúdo está em `lock_no_angulo` e em\n`a_frequencia_do_sistema_e_a_do_psion_iff`; os demais são álgebra dada a definição de `τ`. Ler `τ` como o τ★ do sistema é [ONTO]. Nenhum enunciado fixa `u`. -/\n\n/-- [DEF] **O RETIDO NO ÂNGULO**: a energia retida na unidade posta, `Δ = β·u`. É o valor esperado do lock no ângulo de Miguel (`o_retido_e_o_valor_esperado_do_lock`), não o gap. -/\nnoncomputable def retidoNoAngulo (c : TGLCoupling) (u : ℝ) : ℝ := TGLExt.PonteDaMassa.energiaRetida c u\n\n/-- [DEF] o tempo do retido, `τ = 1/Δ` (ħ = 1). Lê-lo como o τ★ do sistema é leitura [ONTO]. -/\nnoncomputable def tempoDoRetido (c : TGLCoupling) (u : ℝ) : ℝ := 1 / retidoNoAngulo c u\n\ntheorem retido_eq (c : TGLCoupling) (u : ℝ) : retidoNoAngulo c u = c.beta * u := TGLExt.PonteDaMassa.energia_retida_eq c u\n\ntheorem retido_pos (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : 0 < retidoNoAngulo c u := by\n  rw [retido_eq]\n  exact mul_pos c.beta_pos hu\n\n/-- [KERNEL] ★★ o retido é lido do ângulo de Miguel: `Δ = sen²θ_M·u`. -/\ntheorem o_retido_e_lido_do_angulo_de_miguel (c : TGLCoupling) (u : ℝ) : retidoNoAngulo c u = Real.sin (thetaMiguel c.beta) ^ 2 * u := by\n  rw [retido_eq, Posto.sin_sq_thetaMiguel]\n\n/-- [KERNEL] ★★ a tônica é o retido sobre α: `tônica = Δ/α`. A leitura de que α, a inscrição elétrica, leva o retido à tônica é do operador [ONTO]. -/\ntheorem a_tonica_e_o_retido_sobre_alpha (c : TGLCoupling) (u : ℝ) : TGLExt.LeiDoDiminuto.tonica c u = retidoNoAngulo c u / c.alpha := by\n  unfold TGLExt.LeiDoDiminuto.tonica\n  rw [retido_eq]\n  ring\n\n/-- [KERNEL] ★ a massa é a projeção transversal do retido. -/\ntheorem a_massa_e_a_projecao_do_retido (c : TGLCoupling) (u : ℝ) : neutrinoMassForm c u = retidoNoAngulo c u * Real.sin (Real.pi / 4) := by\n  rw [retido_eq]\n  unfold neutrinoMassForm halfAmplitude\n  ring\n\n/-- [KERNEL] ★ o quantum do psíon é `√2·Δ`. -/\ntheorem o_psion_e_raiz_de_dois_retidos (c : TGLCoupling) (u : ℝ) (hu : 0 ≤ u) :\n    Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = Real.sqrt 2 * retidoNoAngulo c u := by\n  rw [psion_quantum c.beta u c.beta_pos.le hu, retido_eq]\n  ring\n\n/-- [KERNEL] ★★★ **A FREQUÊNCIA DO SISTEMA É A DO PSÍON SE E SÓ SE O TEMPO É O DO RETIDO**: `√2/τ = ω_psíon ⟺ τ = 1/Δ`. Liga `ω★ = √2/τ` a `ω = √2·β·u`. -/\ntheorem a_frequencia_do_sistema_e_a_do_psion_iff (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (τ : ℝ) (hτ : 0 < τ) :\n    Real.sqrt 2 / τ = Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) ↔ τ = tempoDoRetido c u := by\n  have hg := retido_pos c u hu\n  have hs : Real.sqrt 2 ≠ 0 := by positivity\n  rw [o_psion_e_raiz_de_dois_retidos c u hu.le]\n  unfold tempoDoRetido\n  constructor\n  · intro h\n    have h1 : 1 / τ = retidoNoAngulo c u := by\n      have h2 : Real.sqrt 2 * (1 / τ) = Real.sqrt 2 * retidoNoAngulo c u := by\n        rw [← h]\n        ring\n      exact mul_left_cancel₀ hs h2\n    rw [← h1]\n    field_simp\n  · intro h\n    rw [h]\n    field_simp\n\n/-- [KERNEL] ★ a taxa de fronteira é a lei canônica lida no psíon, no tempo do retido. -/\ntheorem a_taxa_de_fronteira_no_psion (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    (1 / 2) * c.beta * tempoDoRetido c u * Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) ^ 2 = c.beta / tempoDoRetido c u := by\n  have hg := retido_pos c u hu\n  have hτ : tempoDoRetido c u ≠ 0 := by\n    unfold tempoDoRetido\n    positivity\n  rw [← (a_frequencia_do_sistema_e_a_do_psion_iff c u hu (tempoDoRetido c u) (by unfold tempoDoRetido; positivity)).2 rfl]\n  exact TGLExt.TonicaDoHamiltoniano.gammaB_is_the_canonical_law_at_the_systems_frequency c.beta (tempoDoRetido c u) hτ\n\n/-- [KERNEL] ★ o ponto zero do modo autoconsistente é o retido: `½·(2/τ) = Δ`. Álgebra da definição de `τ`. -/\ntheorem o_ponto_zero_autoconsistente_e_o_retido (c : TGLCoupling) (u : ℝ) (hu : 0 < u) : (1 / 2) * (2 / tempoDoRetido c u) = retidoNoAngulo c u := by\n  have hg := retido_pos c u hu\n  unfold tempoDoRetido\n  field_simp\n\n/-- [KERNEL] ★ o psíon é a projeção transversal do modo autoconsistente: `ω_psíon = (2/τ)·sen 45°`. Mais uma leitura do mesmo `sen 45°`, por aritmética. -/\ntheorem o_psion_e_a_projecao_do_modo (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) = (2 / tempoDoRetido c u) * Real.sin (Real.pi / 4) := by\n  have hg := retido_pos c u hu\n  rw [o_psion_e_raiz_de_dois_retidos c u hu.le, Real.sin_pi_div_four]\n  unfold tempoDoRetido\n  field_simp\n\n/-- [KERNEL] ★★ a razão de qualidade não depende da unidade posta: `ω_psíon/Γ_B = √2/β`. Número puro. -/\ntheorem a_qualidade_nao_depende_da_unidade (c : TGLCoupling) (u : ℝ) (hu : 0 < u) :\n    Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) / (c.beta / tempoDoRetido c u) = Real.sqrt 2 / c.beta := by\n  have hg := retido_pos c u hu\n  have hb := c.beta_pos\n  rw [o_psion_e_raiz_de_dois_retidos c u hu.le]\n  unfold tempoDoRetido\n  field_simp\n\n/-- [KERNEL] ★ o relógio do retido: SE `κ` dá uma volta em `τ`, então `κ/2π = Δ`. κ entra como hipótese, testemunha: nada aqui é busca de valor (regra de 24/08/2026). -/\ntheorem o_relogio_do_retido (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (κ : ℝ) (h : κ * tempoDoRetido c u = 2 * Real.pi) : κ / (2 * Real.pi) = retidoNoAngulo c u := by\n  have hg := retido_pos c u hu\n  have hp : Real.pi ≠ 0 := Real.pi_ne_zero\n  unfold tempoDoRetido at h\n  rw [mul_one_div, div_eq_iff hg.ne'] at h\n  rw [h]\n  field_simp\n\nsection OLock\n\nopen scoped InnerProductSpace\n\nvariable {F : Type} [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]\n\n/-- [DEF] **O LOCK MÍNIMO** sobre o vetor `Ω`: `1 − P`, com `P` a projeção sobre a reta de `Ω`. -/\nnoncomputable def lockDe (Ω : F) : F →L[ℂ] F := 1 - (ℂ ∙ Ω).starProjection\n\n/-- [KERNEL] ★★ **O LOCK TEM GAP ESPECTRAL 1**: vale 0 no vetor `Ω` e 1 em todo vetor ortogonal a ele. Vale em qualquer espaço de Hilbert. -/\ntheorem o_lock_tem_gap_um (Ω χ : F) (hort : ⟪Ω, χ⟫_ℂ = 0) : lockDe Ω Ω = 0 ∧ lockDe Ω χ = χ := by\n  constructor\n  · have h : (ℂ ∙ Ω).starProjection Ω = Ω := Submodule.starProjection_eq_self_iff.mpr (Submodule.mem_span_singleton_self Ω)\n    simp [lockDe, h]\n  · have h : (ℂ ∙ Ω).starProjection χ = 0 := by\n      rw [Submodule.starProjection_singleton, hort]\n      simp\n    simp [lockDe, h]\n\n/-- [KERNEL] ★★★ **O GAP COM UNIDADE**: na unidade posta o lock é `u·(1 − P)`: vale 0 no vetor `Ω` e `u` no ortogonal. O gap espectral é `u`, o E₀ da Lei do Diminuto. -/\ntheorem o_gap_com_unidade (Ω χ : F) (hort : ⟪Ω, χ⟫_ℂ = 0) (u : ℝ) :\n    (u : ℂ) • lockDe Ω Ω = 0 ∧ (u : ℂ) • lockDe Ω χ = (u : ℂ) • χ := by\n  obtain ⟨h0, h1⟩ := o_lock_tem_gap_um Ω χ hort\n  rw [h0, h1, smul_zero]\n  exact ⟨rfl, rfl⟩\n\n/-- [KERNEL] ★★★ **O LOCK LIDO NUM ÂNGULO**: no estado a um ângulo `θ` de `Ω`, o valor esperado é `sen²θ`. -/\ntheorem lock_no_angulo (Ω χ : F) (hχ : ‖χ‖ = 1) (hort : ⟪Ω, χ⟫_ℂ = 0) (θ : ℝ) :\n    ⟪(Real.cos θ : ℂ) • Ω + (Real.sin θ : ℂ) • χ, lockDe Ω ((Real.cos θ : ℂ) • Ω + (Real.sin θ : ℂ) • χ)⟫_ℂ = ((Real.sin θ ^ 2 : ℝ) : ℂ) := by\n  obtain ⟨h0, h1⟩ := o_lock_tem_gap_um Ω χ hort\n  have hχχ : ⟪χ, χ⟫_ℂ = 1 := by\n    rw [inner_self_eq_norm_sq_to_K, hχ]\n    simp\n  rw [map_add, map_smul, map_smul, h0, h1, smul_zero, zero_add, inner_add_left, inner_smul_left, inner_smul_left, inner_smul_right, inner_smul_right, hort, hχχ]\n  simp only [mul_zero, zero_add, mul_one, Complex.conj_ofReal]\n  push_cast\n  ring\n\n/-- [KERNEL] ★★★ **NO ÂNGULO DE MIGUEL O LOCK LÊ β**: o valor esperado, não o gap. -/\ntheorem lock_no_angulo_de_miguel (Ω χ : F) (hχ : ‖χ‖ = 1) (hort : ⟪Ω, χ⟫_ℂ = 0) (c : TGLCoupling) :\n    ⟪(Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ,\n      lockDe Ω ((Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ)⟫_ℂ = (c.beta : ℂ) := by\n  rw [lock_no_angulo Ω χ hχ hort, Posto.sin_sq_thetaMiguel]\n\n/-- [KERNEL] ★★★ **O RETIDO É O VALOR ESPERADO DO LOCK**: `u·⟨1 − P⟩` no ângulo de Miguel é `Δ`. Liga o produto interno à energia retida. -/\ntheorem o_retido_e_o_valor_esperado_do_lock (Ω χ : F) (hχ : ‖χ‖ = 1) (hort : ⟪Ω, χ⟫_ℂ = 0) (c : TGLCoupling) (u : ℝ) :\n    (u : ℂ) * ⟪(Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ,\n      lockDe Ω ((Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ)⟫_ℂ = ((retidoNoAngulo c u : ℝ) : ℂ) := by\n  rw [lock_no_angulo_de_miguel Ω χ hχ hort c, retido_eq]\n  push_cast\n  ring\n\n/-- ★★★ **O GAP — o fecho.** O gap espectral na unidade posta é `u`; a tônica modulada pousa nele, e a tônica fica meio-tom acima; o valor esperado no ângulo de Miguel é o retido `Δ`; a tônica é `Δ/α`; a massa é\n    a projeção transversal de `Δ`; a frequência do sistema no tempo `1/Δ` é a do psíon. Nenhum desses enunciados fixa `u`. -/\ntheorem the_gap_closes (c : TGLCoupling) (u : ℝ) (hu : 0 < u) (Ω χ : F) (hχ : ‖χ‖ = 1) (hort : ⟪Ω, χ⟫_ℂ = 0) :\n    (u : ℂ) • lockDe Ω χ = (u : ℂ) • χ\n    ∧ (TGLExt.LeiDoDiminuto.leiDerivada c u hu).transicao.E0 = u\n    ∧ TGLExt.LeiDoDiminuto.tonica c u = Real.exp (1 / 2) * u\n    ∧ (u : ℂ) * ⟪(Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ,\n        lockDe Ω ((Real.cos (thetaMiguel c.beta) : ℂ) • Ω + (Real.sin (thetaMiguel c.beta) : ℂ) • χ)⟫_ℂ = ((retidoNoAngulo c u : ℝ) : ℂ)\n    ∧ TGLExt.LeiDoDiminuto.tonica c u = retidoNoAngulo c u / c.alpha\n    ∧ neutrinoMassForm c u = retidoNoAngulo c u * Real.sin (Real.pi / 4)\n    ∧ Real.sqrt 2 / tempoDoRetido c u = Real.sqrt (omegaSq c.beta (pagamentoComoCurvatura c.beta u)) := by\n  have hg := retido_pos c u hu\n  exact ⟨(o_gap_com_unidade Ω χ hort u).2, TGLExt.LeiDoDiminuto.leiDerivada_E0 c u hu, TGLExt.LeiDoDiminuto.tonica_eq c u,\n    o_retido_e_o_valor_esperado_do_lock Ω χ hχ hort c u, a_tonica_e_o_retido_sobre_alpha c u, a_massa_e_a_projecao_do_retido c u,\n    (a_frequencia_do_sistema_e_a_do_psion_iff c u hu (tempoDoRetido c u) (by unfold tempoDoRetido; positivity)).2 rfl⟩\n\nend OLock\n\n/-- [KERNEL] ★★ o `HminMic` do kernel é este lock no vácuo de Fock. Condicional ao `FockCertificate`, que o kernel não habita. -/\ntheorem HminMic_e_o_lock {L : TGLExt.ImportedSQ.LightOneParticle} (C : TGLExt.ImportedSQ.FockCertificate L) : TGLExt.QGReaderUVLock.HminMic C = lockDe C.Ω := rfl\n\nend TGLExt.PontoZeroDoPsion\n\n#print axioms TGLExt.PontoZeroDoPsion.psion_quantum\n#print axioms TGLExt.PontoZeroDoPsion.the_mass_is_the_zero_point\n#print axioms TGLExt.PontoZeroDoPsion.psion_quantum_is_twice_the_mass\n#print axioms TGLExt.PontoZeroDoPsion.the_payment_completes_only_in_the_limit\n#print axioms TGLExt.PontoZeroDoPsion.the_zero_point_closes\n#print axioms TGLExt.PontoZeroDoPsion.the_mass_is_the_zero_point_at_the_posted_one\n#print axioms TGLExt.PontoZeroDoPsion.o_retido_e_lido_do_angulo_de_miguel\n#print axioms TGLExt.PontoZeroDoPsion.a_tonica_e_o_retido_sobre_alpha\n#print axioms TGLExt.PontoZeroDoPsion.a_massa_e_a_projecao_do_retido\n#print axioms TGLExt.PontoZeroDoPsion.o_psion_e_raiz_de_dois_retidos\n#print axioms TGLExt.PontoZeroDoPsion.a_frequencia_do_sistema_e_a_do_psion_iff\n#print axioms TGLExt.PontoZeroDoPsion.a_taxa_de_fronteira_no_psion\n#print axioms TGLExt.PontoZeroDoPsion.o_ponto_zero_autoconsistente_e_o_retido\n#print axioms TGLExt.PontoZeroDoPsion.o_psion_e_a_projecao_do_modo\n#print axioms TGLExt.PontoZeroDoPsion.a_qualidade_nao_depende_da_unidade\n#print axioms TGLExt.PontoZeroDoPsion.o_relogio_do_retido\n#print axioms TGLExt.PontoZeroDoPsion.o_lock_tem_gap_um\n#print axioms TGLExt.PontoZeroDoPsion.o_gap_com_unidade\n#print axioms TGLExt.PontoZeroDoPsion.lock_no_angulo\n#print axioms TGLExt.PontoZeroDoPsion.lock_no_angulo_de_miguel\n#print axioms TGLExt.PontoZeroDoPsion.o_retido_e_o_valor_esperado_do_lock\n#print axioms TGLExt.PontoZeroDoPsion.the_gap_closes\n#print axioms TGLExt.PontoZeroDoPsion.HminMic_e_o_lock\n",
 }
 
