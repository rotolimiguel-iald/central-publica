def montar(V, core, selo, ids, arts):
    """Monta os registros (a ROTA nova, as ANOTACOES e a ERRATA), cada afirmacao testada contra o core/selo/ESPERADOS; devolve a lista; recusa (assert) se algo nao conferir. Nao escreve nada."""
    assert selo.get("um_version") == "v405", "o selo nao e a v405"
    assert NOVA not in ids, "a rota %s ja existe no mapa" % NOVA
    for r in ANOTADAS + REFS:
        assert r in ids, "a rota %s nao existe no mapa (anotada ou citada em refs)" % r
    ESP = _esp(); DL_ = T._qd().DL
    S = ESP["candidato_sha16"]
    assert str((selo.get("sha256") or {}).get("um.py", ""))[:16] == S, "o um.py do selo nao e o candidato de ESPERADOS"
    assert V.get("s16") in (None, S), "o s16 da leitura != o candidato de ESPERADOS"
    BASE = ESP["origem_sha16"]
    esc0, esc1 = ESP["escada_v404_e_v405"]
    NF = ESP["n_bandeiras_novas"]
    assert esc1 - esc0 == NF == sum(ESP["n_bandeiras_por_grupo"].values()) == len(ESP["bandeiras_novas_chaves"]) == ESP["politica_de_bandeiras"]["n_flags"], "a escada nao fecha com as bandeiras novas"
    assert ESP["kernel"]["modulos_novos"] == len(GRUPOS) == len(ESP["pedras"]) == 8, "o delta do kernel nao e de oito modulos"
    BETA = ESP["beta"] if isinstance(ESP.get("beta"), float) else None
    FRASE = DL_.FRASE_DA_MOLDURA_PT

    # --- o quadro do topo (a regra do 4,44): o registro selado, lido pelas MESMAS funcoes do artigo
    tvr = core.get("teste_de_veracidade_fase9_v397") or {}
    a = T._qd().Q._v397_atomos(tvr, "pt"); assert a["sealed"] is True, "o registro teste_de_veracidade_fase9_v397 nao sela no core: o mapa nao registra o 4,44 assim"
    z, p = a["z_disc"]["md"], a["p_disc"]["md"]
    z444 = "z_disc = %s (calibrado; p unilateral %s), abaixo do degrau de 5σ da creditação, que não foi alcançado (%s < 5)" % (z, p, z)

    def selou(k):
        return (core.get(k) or {}).get("all_verified") is True

    # --- as oito pedras e os oito registros com FUNCAO: tudo lido do core e conferido contra ESPERADOS
    PINOS_ORDEM = json.load(open(os.path.join(PK, "pedras_sha16_da_ordem.json"), encoding="utf-8")) if os.path.isfile(os.path.join(PK, "pedras_sha16_da_ordem.json")) else None
    G = {}
    for g, nome in GRUPOS.items():
        r = core.get(nome)
        assert isinstance(r, dict) and r.get("all_verified") is True, "o registro %s nao selou no core" % nome
        assert r.get("verdict") == ESP["vereditos_novos_v405"][nome], "o veredito de %s != ESPERADOS" % nome
        kt = r.get("key_theorem") or {}; un = r.get("unconditional") or {}; est = ESP["estrelas_v405"][g]
        assert kt.get("theorem") == est["teorema"] and kt.get("flag") == est["bandeira"] and kt.get("flag_true") is True and kt.get("in_trio") is True and kt.get("in_kernel") is True, "a estrela de %s no kernel do rito != ESPERADOS" % g
        assert un.get("theorem") == ESP["teoremas_das_pedras"][g] and un.get("flag") == ESP["bandeiras_das_pedras"][g] and un.get("flag_true") is True and un.get("in_trio") is True and un.get("in_kernel") is True, "a composicao de %s no kernel do rito != ESPERADOS" % g
        mech = r.get("mechanics") or {}; assert mech.get("passed") is True and mech.get("n_checks") == len(mech.get("checks") or []) and all(c.get("ok") is True for c in mech["checks"]), "as checagens do calculo de %s nao passaram" % g
        ft = r.get("formal_theorems") or {}; st = r.get("support_theorems") or {}
        assert ft and all(v is True for v in ft.values()) and len(ft) == len(ESP["contrato_das_pedras"][g]) and set(ft) == set(ESP["contrato_das_pedras"][g]), "o contrato de %s no kernel do rito != ESPERADOS" % g
        assert st and all(v is True for v in st.values()) and set(st) == set(ESP["suporte_das_pedras"][g]), "os termos antigos citados por %s != ESPERADOS" % g
        assert r.get("embedded_source_ok") is True and r.get("beta_ok") is True and r.get("does_not_gate_core") is True and r.get("guarda_p18_violacoes") in ([], None), "a fonte embutida, o beta ou a guarda de %s nao conferem" % g
        mod = ".".join(un["theorem"].split(".")[:2]); rel = mod.replace(".", "/") + ".lean"; ped = ESP["pedras"][rel]
        nb = ESP["n_bandeiras_por_grupo"][g]; assert ped["bandeiras"] == nb, "as bandeiras de %s != ESPERADOS" % g
        pref = DL_.STONE_BY_KEY[g]["flag_prefix"]; fl = sorted(k for k in ESP["bandeiras_novas_chaves"] if k.startswith(pref)); assert len(fl) == nb, "as chaves de bandeira de %s != %d" % (g, nb)
        lean = os.path.join(PK, "pedra", mod.split(".")[-1] + ".lean")
        if os.path.isfile(lean):
            assert _sha256(lean) == ped["sha256"], "o arquivo %s != o sha256 de ESPERADOS" % lean
        if PINOS_ORDEM is not None:
            assert PINOS_ORDEM.get(g) == ped["sha16"], "o sha16 da pedra %s (%s) != o pino da ordem da gerencia (%s)" % (g, ped["sha16"], PINOS_ORDEM.get(g))
        G[g] = dict(nome=nome, mod=mod, curto=mod.split(".")[-1], sha16=ped["sha16"], n_flags=nb, f0=fl[0], f1=fl[-1], comp=un["theorem"].split(".")[-1], comp_flag=un["flag"], estrela=kt["theorem"].split(".")[-1], estrela_flag=kt["flag"],
                    n_checks=mech["n_checks"], n_contrato=len(ft), n_sup=len(st), verdict=r["verdict"], vals=r.get("values") or {}, lean=lean, oper=ped.get("nome_do_operador"))
    vp, vt, vi, vo, vd, vn, ve, vz = (G[k_]["vals"] for k_ in GRUPOS)
    assert all(G[k_]["vals"].get("beta") == vp.get("beta") for k_ in GRUPOS) and (BETA is None or abs(vp["beta"] - BETA) <= 1e-9 * BETA), "o beta dos registros != o do core/ESPERADOS (tolerancia relativa 1e-9; cada registro ja confere beta_core_rel_diff)"
    beta = vp["beta"]
    # --- o gate NAO se moveu: o registro segue selado e a letra do veredito e' a da v404
    gk = core.get("bandeiras_do_gate_v403") or {}; gvv = gk.get("values") or {}; eg = ESP["registros_funcao_v403"]["gate"]
    assert gk.get("all_verified") is True and gk.get("verdict") == eg["verdict"] and gvv == eg["values"] and (gk.get("mechanics") or {}).get("passed") is True, "bandeiras_do_gate_v403 (recriado) nao selou ou != a v404 selada"
    qg = core.get("qg_closure") or {}; fam = [len(qg.get(f) or {}) for f in ("formal_flags", "physics_flags", "experiment_flags")]
    assert (qg.get("gate") or {}).get("verdict") == ESP["qg_closure_gate_verdict_v404"] == selo.get("qg_closure_verdict") == ESP["qg_closure_verdict"], "a letra do veredito do gate mudou"
    # --- os cinco registros por spec
    cg = core.get("cunhagens_v405") or {}; cf = core.get("campos_fechados_e_leituras_v405") or {}; ga = core.get("ga_reclassificacao_v405") or {}; gp = core.get("gap_v405") or {}; kh = core.get("kh_n1_cobertura_v405") or {}
    for nome_, r_ in (("cunhagens_v405", cg), ("campos_fechados_e_leituras_v405", cf), ("ga_reclassificacao_v405", ga), ("gap_v405", gp), ("kh_n1_cobertura_v405", kh)):
        assert r_.get("all_verified") is True and r_.get("verdict") == ESP["vereditos_novos_v405"][nome_], "%s nao selou ou != ESPERADOS" % nome_
    verb = cg.get("verbatim") or {}; ex = cg.get("extras") or {}
    assert len(verb) == len(ESP["cunhagens"]) and set(verb) == set(ESP["cunhagens"]) and all(v.get("embedded_ok") is True for v in verb.values()), "as inscricoes de 30/10 a 01/11 nao estao embutidas por sha256"
    assert set((ex.get("autor_de_cada_inscricao") or {}).values()) == {"operador"} and len(ex["autor_de_cada_inscricao"]) == len(verb), "alguma inscricao nao e' fala do operador"
    erratas = cg.get("erratas") or []; assert len(erratas) == 4 and all("gerencia c1, em nome proprio" in e.get("assinatura", "") for e in erratas), "as erratas E10 a E13 nao estao no registro ou nao sao da gerencia c1 em nome proprio"
    dec = ex.get("decisoes_da_gerencia") or {}; assert all(("D%d" % i) in dec for i in range(27, 34)), "faltam decisoes D27 a D33 no registro"
    assert set((ex.get("nomes") or {})) >= set(GRUPOS), "os nomes das oito pedras nao estao no registro"
    assert ex.get("leitura_v405") == ESP["leitura_v405"], "a leitura da v405 no registro != ESPERADOS"
    xf = cf.get("extras") or {}; xg = ga.get("extras") or {}; gv = ga.get("values") or {}
    assert xf.get("a_frase_da_moldura") == FRASE and len((xf.get("o_que_entra") or {}).get("leituras_da_cadeia_da_massa") or []) >= 4 and (xf.get("o_que_entra") or {}).get("lista_de_leituras_fechada") is False, "a moldura do registro nao e' a do delta"
    leit = "; ".join("(%d) %s (%s)" % (l_["n"], l_["leitura"], (l_.get("definicao_lean") or "sem termo no kernel").split(".")[-1]) for l_ in xf["o_que_entra"]["leituras_da_cadeia_da_massa"])
    assert xg.get("classe_agora") == DL_.GA_CLASSE_AGORA and xg.get("classe_antes") == DL_.GA_CLASSE_ANTES and ga.get("errata_do_parecer_ok") is True, "a classe nova do Grande Atrator ou a errata do parecer nao conferem"
    cob = kh.get("lido") or {}; assert cob.get("constantes_cobertas") and cob.get("teoremas_cobertos"), "kh_n1_cobertura_v405 sem a cobertura"
    seguem = ("projecao_transversal_v404", "jo8v32_v404", "f2b_errata_v404", "cunhagens_v404", "kh_n1_cobertura_v404", "caminho_v403", "vida_v403", "verdade_adendo_v403", "bandeiras_do_gate_v403", "cunhagens_v403", "kh_n1_cobertura_v403", "falsidade_da_inercia_v401", "cunhagens_v401", "ponte_da_escala_dual_v402", "queda_sem_geometria_v402", "esperanca_condicional_v402", "cunhagens_v402", "kh_n1_cobertura_v402",
              "teste_de_veracidade_fase9_v397", "cunhagens_v397", "selo_pela_propria_tecnologia_v399", "declaracao_do_operador_v399", "sonico_v398", "afinacao_das_cordas_v398")
    c_seguem = all(selou(k) for k in seguem)
    tv_v = ESP["veracidade"]; c_q = bool(selou("teste_de_veracidade_fase9_v397") and selou("cunhagens_v397") and tvr.get("verdict") == tv_v["verdict"])
    sc = _sidecar(V); conf_dm = V.get("conf_dm", "nao lido"); conf_np = V.get("conf_np", "nao lido"); nvm = V.get("n_ver_mudaram", "nao lido")
    bank = _bancada(); regs = livro()
    # --- o seq que a errata corrige, lido do livro (e o registro tem de trazer o trecho corrigido)
    sq_v404 = seq_do_alvo(regs, R_V404, "ROTA", contem=("DECLARADO",))
    KR = os.path.join(PK, "kernel", "KERNEL_RECIBO_v405.json")
    E = {}
    for e in erratas:
        m_ = re.match(r"^(E1[0-3]) -- ", e.get("agora", "")); assert m_, "uma errata do registro nao comeca por E<n> --"
        E[m_.group(1)] = e
    assert sorted(E) == ["E10", "E11", "E12", "E13"], "as erratas do registro nao sao E10 a E13"

    def anot(rota_id, titulo, resultado, proximo, refs=None, nota=None, estatuto="REAL", artefatos=None, defeito=None):
        x = {"tipo": "ANOTACAO", "rota_id": rota_id, "estatuto": estatuto, "olhou_dados": False, "titulo": titulo, "resultado": resultado, "proximo_passo": proximo, "refs": [NOVA] + (refs or [])}
        if defeito:
            x["defeito"] = defeito
        if nota:
            x["nota"] = nota
        if artefatos:
            x["artefatos"] = _existentes(*artefatos)
        return x

    def errata(rota_id, corrige, nota, refs=None, artefatos=None, estatuto="REAL"):
        x = {"tipo": "ERRATA", "rota_id": rota_id, "corrige": corrige, "estatuto": estatuto, "olhou_dados": False, "nota": nota, "refs": [NOVA] + (refs or [])}
        if artefatos:
            x["artefatos"] = _existentes(*artefatos)
        return x

    def corpo(k):
        e = E[k]
        return "%s | lacuna de fidelidade: %s | estatuto: %s | assinatura: %s" % (e["agora"], e["lacuna_de_fidelidade"], e["estatuto"], e["assinatura"])

    def pedra_txt(g):
        d_ = G[g]
        return f"{d_['curto']} (nome do operador: {d_['oper']}; sha16 {d_['sha16']}): composicao {d_['comp']} (bandeira {d_['comp_flag']}), estrela {d_['estrela']} (bandeira {d_['estrela_flag']}), no trio, {d_['n_contrato']} itens de contrato e {d_['n_sup']} termos citados; {d_['n_flags']} bandeiras ({d_['f0']} a {d_['f1']}); o registro {d_['nome']} selou={selou(d_['nome'])} com {d_['n_checks']} checagens"

    gp = G["ponte"]
    PEDRAS = [G[g]["lean"] for g in GRUPOS]
    T9 = []
    T9.append(anot(R_PONTE, "v405 SELADA %s: a Ponte da Massa entrou no kernel do rito com o nome do operador; a identificacao candidata passou a DEFINICAO (massaDerivada): dadas as entradas, a forma e' teorema" % S,
                   f"{pedra_txt('ponte')}, com beta = alfa x raiz de e em runtime (= {beta!r}): massa derivada {vp['m_derivada_meV']!r} meV, leitura proporcional {vp['m_proporcional_meV']!r} meV, m_nu do canal do core {vp['m_nu_meV_core']!r} meV (diferenca relativa {vp['m_nu_rel_diff']:g}). "
                   f"E13 (errata ao lado, gerencia c1, em nome proprio): {E['E13']['agora']} O numero da massa e' o da v404; prove_neutrino_mass_gravitational NAO foi reescrita; E10 fica ao lado de neutrino_mass.angle_status.",
                   "quem testa a identificacao e' o canal vivo do neutrino, bilateral (TGL_NU_M2_ARMED_CONSISTENT, sem mudanca); revisao independente da pedra, ver o caderno revisao_terceiro do pacote v405 (quem construiu nao aprova).", refs=[R_MASSA, R_E0, "neutrinos.m2.normalizacao"], artefatos=[G["ponte"]["lean"], KR],
                   estatuto="REAL (a pedra no kernel do rito e o calculo no modelo); POSTO (u = 1 eV); MEDIDA (alfa); INPUT/ONTO (massaDerivada e o angulo escrito em transicaoDerivada, leituras do operador, entram como definicao, nao sao teoremas)",
                   defeito="o calculo e' numerico em dupla precisao e CONFERE os teoremas, nao os prova; a leitura fisica nao virou teorema: a pedra prova que a definicao implica a forma, nao que a natureza a adota"))
    T9.append(anot(R_EMPR, "v405 SELADA %s: o emprestimo da massa entrou no kernel como Massa = tensao pura (nome do operador); o periodo fiel e' teorema, a leitura segue leitura" % S,
                   f"{pedra_txt('tensao')}: transmitida {vt['transmitida_eV']!r} eV, retida {vt['retida_eV']!r} eV, massa {vt['massa_meV']!r} meV; o periodo fiel P = 2 pi/kappa e' teorema (one_turn_gives_faithful_period); a leitura do emprestimo, ratificada pelo operador em 30/10/2026, nao e' termo de kernel.",
                   "da cadeia tensao, atrito, temperatura e magnetismo, o magnetismo nao tem termo no kernel [OPEN]; revisao independente da pedra, ver o caderno revisao_terceiro do pacote v405.", refs=[R_PONTE], artefatos=[G["tensao"]["lean"], KR],
                   estatuto="REAL (a pedra no kernel do rito e o calculo no modelo); INPUT/ONTO (a leitura do emprestimo e o nome); OPEN (o magnetismo)"))
    T9.append(anot(R_OBS, "v405 SELADA %s: a pedra ObservadorTerminal entrou no kernel do rito" % S,
                   f"{pedra_txt('observador')}: o terminal da cascata e' so' {vo['terminal'][0]}, a distancia ao terminal se consome a cada leitura, a fusao e' o colapso e o colapso e' um Um posto do kernel; os pontos fixos do colapso sao {vo['pontos_fixos_do_colapso']}.",
                   "a leitura de engenharia e' do operador; revisao independente da pedra, ver o caderno revisao_terceiro do pacote v405.", refs=[R_ID], artefatos=[G["observador"]["lean"], KR], estatuto="REAL (a pedra no kernel do rito e o calculo no modelo); INPUT/ONTO (a leitura de engenharia)",
                   defeito="nada sobre entidades: os niveis sao rotulos, como na pedra de origem; nao constroi o colapso fisico"))
    T9.append(anot(R_ID, "v405 SELADA %s: a pedra Identidade entrou no kernel do rito; prova um fato sobre projecoes no estado traco; que isso seja a identidade e' leitura, tipada como modelo" % S,
                   f"{pedra_txt('identidade')}: nas dimensoes {vi['dimensoes']} a equacao fecha so' em P = 1; a face pesa {vi['faces_peso'][0][1]!r} e o vazio {vi['vazio_peso']!r}, e nenhum dos dois satisfaz a equacao; {vi['n_nomes']} nomes conferidos no calculo. O ensaio A identidade e' do operador, entra no artigo verbatim (r2 ratificada) e nao e' teorema; a ressalva fica na moldura da secao, nunca dentro do texto dele.",
                   "revisao independente da pedra, ver o caderno revisao_terceiro do pacote v405.", refs=[R_OBS], artefatos=[G["identidade"]["lean"], KR], estatuto="REAL (a pedra no kernel do rito e o calculo no modelo); INPUT/ONTO (a leitura como identidade; a declaracao do operador)",
                   defeito="o fato e' sobre projecoes no estado traco normalizado, num modelo; a leitura nao e' termo de kernel"))
    T9.append(anot(R_E0, "v405 SELADA %s: a Lei do diminuto, a Tonica do Hamiltoniano, o Disco de Euler e o Ponto Zero do Psion entraram no kernel do rito; o no-go de E0 NAO cai: localiza-se no Um posto; o valor absoluto segue livre e o relativo a tonica esta pinado; o diminuto e' modulacao, nao transposicao; o registro gap_v405 le o gap espectral do lock (u, na unidade posta) e o valor esperado dele no angulo de Miguel (Delta, que nao e' gap), ao lado, sem fixar u; quais sao as cinco notas e' OPEN" % S,
                   f"{pedra_txt('diminuto')}: meio-tom {vd['meio_tom']!r}, tonica {vd['tonica_eV']!r} eV (definicao), E0 = {vd['E0_eV']!r} eV (identidade algebrica, que nao fixa u). {pedra_txt('tonica')}: nenhuma funcao da inscricao fixa E0. {pedra_txt('disco')}: K para u posto = {ve['K_si_para_u_posto_J_s2']:.6e} J/s2, registrado, nao escolhido (E12: o invariante do disco real e' 6Mg2, nao 4Mg2). {pedra_txt('psion')}: hbar omega = {vz['hbar_omega_meV']!r} meV, metade = {vz['meia_hbar_omega_meV']!r} meV, sob a leitura R = beta u2.",
                   "o valor absoluto do setor e qual e' o disco sao do operador; revisao independente das quatro pedras: ver o caderno revisao_terceiro do pacote v405.", refs=[R_PONTE, R_ALFA], artefatos=[G["diminuto"]["lean"], G["tonica"]["lean"], G["disco"]["lean"], G["psion"]["lean"], KR],
                   estatuto="REAL (as pedras no kernel do rito e o calculo nos modelos); POSTO (u = 1 eV); MEDIDA (alfa); INPUT/ONTO (a tonica e pagamentoComoCurvatura, leituras do operador, entram como definicao); INPUT (a dispersao do psion, Tratado secao 3, como definicao); KNOWN (o ponto zero); OPEN (o valor absoluto do setor; qual e' o disco)",
                   defeito="as duas cadeias (disco e ponto zero) sao distintas; a unidade segue posta nas duas; nada aqui deriva a unidade nem alfa"))
    T9.append(anot(R_ALFA, "v405 SELADA %s: alfa segue MEDIDA, por dentro; a resposta foi nao e fica registrada no selo como parede medida, nao falsificacao" % S,
                   f"o registro campos_fechados_e_leituras_v405 selou={selou('campos_fechados_e_leituras_v405')}: alfa entra como [MEDIDA] (CODATA 2018 no runtime; alpha_is_measured_from_within, pedra Verdade), o Um como [POSTO]; a leitura do operador sobre o angulo de Miguel entra como nota [INPUT], nao como teorema. Nenhum numero foi escolhido por proximidade.",
                   "nada a refazer nesta rota enquanto nao houver grau de liberdade novo.", refs=[R_E0], estatuto="REAL (o registro); MEDIDA (alfa); INPUT (a leitura do operador)"))
    T9.append(anot(R_GA, "v405 SELADA %s: a classe nova do teste do Grande Atrator entrou no selo AO LADO (%s); a linha da tabela, a constante e a auditoria ficam identicas" % (S, xg["classe_agora"]),
                   f"o registro ga_reclassificacao_v405 selou={selou('ga_reclassificacao_v405')} com {(ga.get('mechanics') or {}).get('n_checks')} medidas em runtime, sem abrir dado: dM/du = {gv['dM_du']!r}; M = M com residuo maximo {max(gv['residuos_M_igual_M']):.1e}; R_B/r_s = 2 pi/beta = {gv['dois_pi_sobre_beta']!r}; piso de definicao {gv['piso_de_definicao']!r}; precisao necessaria {gv['sigma_relativo_forma_ancora']!r} (forma contra ancora) e {gv['sigma_relativo_resposta_beta']!r} (resposta de materia). "
                   f"De {xg['classe_antes']} para {xg['classe_agora']} ({xg['saida']}); a janela mantem o veto; nao e' evidencia; nao discrimina da RG. A errata ao lado do parecer da ENTREGA 005 entra verbatim no registro.",
                   "as escolhas da partitura (qual raio, qual forma, qual dominio) sao do operador; o teste com dado so' depois delas; nada foi aberto.", refs=[R_GATE, "natureza.cinco_sigma_02_kimi_01nov"],
                   estatuto="REAL (as medidas em runtime); DECLARADO (a reclassificacao e' decisao da gerencia por ordem do operador); KNOWN (a ordem linear); INPUT/ONTO (a ponte de fonte)",
                   defeito="a forma segue condicional a ponte de fonte, a lei radial e a admissibilidade da borda; nao muda o veredito de nenhum teste"))
    T9.append(anot(R_MASSA, "v405 SELADA %s: a transicao para a massa fica no selo como forma condicional as entradas; o numero da massa nao muda" % S,
                   f"a v404 derivou o sen 45 condicional a uma identificacao ONTO com E0 declarado; a v405 faz da identificacao uma DEFINICAO e poe a unidade: {FRASE}. As leituras da cadeia da massa (a lista nao e' fechada): {leit}. O veredito do canal do neutrino nao muda.",
                   "E0 segue posto, nao derivado; a identificacao fisica segue leitura do operador.", refs=[R_PONTE, R_E0], estatuto="REAL (a forma, dadas as entradas); POSTO (u); MEDIDA (alfa); INPUT/ONTO (as leituras da cadeia da massa)"))
    T9.append(anot(R_FORMA, "v405 SELADA %s: a forma madura da TGL esta no selo com a frase corrigida" % S,
                   f"o registro campos_fechados_e_leituras_v405 ({(cf.get('extras') or {}).get('a_frase_da_moldura')}) lista o que fechou (campos), os dois postos e as leituras da cadeia da massa, lista que nao e' fechada, cada uma com o nome Lean; a errata E13 fica ao lado; a guarda das frases roda a cada rito e em cada texto.",
                   "a ratificacao das decisoes D27 a D33 que o operador ainda nao leu.", refs=[R_E0], estatuto="REAL (o registro); INPUT/ONTO (as leituras)"))
    T9.append(anot(R_GATE, "v405 SELADA %s: o gate NAO se moveu — o qg_closure do core e' identico ao da v404 (as 18 bandeiras calculadas, a letra do veredito)" % S,
                   f"o registro bandeiras_do_gate_v403 (recriado) selou={selou('bandeiras_do_gate_v403')} com os mesmos valores da v404 selada: das {gvv['n_flags']} bandeiras ({fam[0]} formais, {fam[1]} fisicas, {fam[2]} experimentais) {gvv['n_true']} sao True e {gvv['n_calculated']} sao CALCULADAS ({gvv['n_literal']} literais); o veredito le {gvv['n_read_by_the_verdict']}; a letra do veredito do gate e' a da v404 e a do selo. "
                   "Nenhuma bandeira do gate depende das pedras da v405. [DECLARADO, GV-03 da auditoria de 28/09/2026] As 4 bandeiras experimentais derivam de UM so' booleano; o degrau experimental le so' o rito V11 do piso, unilateral (GV-01).",
                   "a independencia das 4 experimentais e os mocks de survey seguem [OPEN]; o gate nao se move por esta rota.", refs=[R_PONTE],
                   artefatos=[os.path.join(PK, "CANDIDATO_v405.json")], estatuto="REAL (o core do rito); DECLARADO (GV-01, GV-03, EV-12 da auditoria de 28/09/2026); OPEN (a independencia das 4 experimentais)",
                   defeito="o gate nao e' teste e nao discrimina o LCDM raso; NOT_FALSIFIED nunca e' a palavra da creditacao"))
    T9.append(anot(R_BANC, "v405 SELADA %s: o B(n) da v405 e' um passo SIMPLES v404 -> v405 (a Bancada de producao ja' pinava a v404)" % S,
                   f"o kernel da v405 difere do da v404 so' pelas OITO pedras novas (recibo do kernel KERNEL_RECIBO_v405, contrato R3_2; DIFF_KERNEL_v405.txt: oito modulos novos, TGLExt.lean com as oito linhas de import a mais); o recibo pre_selo foi gerado e pinado ANTES da instalacao, em ensaio contra a producao (nada gravado; a Bancada pinava {bank['deployment_id']}), "
                   f"e a cadeia confere os pinos de PINOS_BN_v405.json na hora; o veredito esperado do aplicar e' REPINADA_B{bank['proxima']}__APLICADA__SERVICO_DEVE_SER_REINICIADO_COM_RECIBO, sem __SALTO_ e sem cadeia de selos, lido do codigo do esboco R3.5. Parada e religamento do servico exigem V405_AUTORIZACAO_OPERADOR (texto sem o nome do script do servico).",
                   "depois do aplicar, a Bancada pina a v405.", refs=[R_PONTE],
                   artefatos=[os.path.join(PK, "PINOS_BN_v405.json"), os.path.join(PK, "PINO_RECIBO_PRE_SELO_v405.json"), KR]))
    T9.append(anot(R_QUADRO, "v405 SELADA %s: o quadro do topo (O Teste da Única Palavra) segue intocado e o registro teste_de_veracidade_fase9_v397 segue selado" % S,
                   f"teste_de_veracidade_fase9_v397 selou={c_q} no rito da v405 (veredito igual ao de ESPERADOS; {tv_v['n_checks']} checagens): o quadro do artigo PT/EN e do .md, conferido contra o resultado pinado, segue no topo, com os numeros e a regra da ordem de sempre: {z444}. "
                   "Nenhum sigma, p ou lnB novo e' calculado nesta rota; a regra do 4,44 (nunca sem o p calibrado e sem a linha dos 5 sigma) vale em todo texto que o cite; o paragrafo do quadro segue no README/site e o handoff da v405 traz tambem o paragrafo novo (a massa derivada e a identidade definida), sem o 4,44.",
                   "o paragrafo do README/site e' ato da sessao do site; a creditacao segue sendo beta_TGL na natureza a 5 sigma (nao ha o que repetir deste pacote, a abertura esta consumida).", refs=[R_PONTE]))
    T9.append(anot(R_V404, "v405 SELADA %s: a v404 e' a base selada da v405; a unidade foi posta e os nomes foram dados" % S,
                   f"a v405 parte da v404 selada (um.py {BASE}) e acrescenta OITO modulos de kernel, oito registros com funcao e cinco por spec, e as secoes do artigo; os registros da v404 (projecao_transversal_v404 selou={selou('projecao_transversal_v404')}, jo8v32_v404 selou={selou('jo8v32_v404')}, cunhagens_v404 selou={selou('cunhagens_v404')}), da v403, da v402, da v401 e da v399 seguem selados neste rito "
                   f"(caminho_v403 selou={selou('caminho_v403')}, falsidade_da_inercia_v401 selou={selou('falsidade_da_inercia_v401')}), como seguem o selo pela propria tecnologia e a declaracao do operador (v399), o sonico e a afinacao (v398) e o quadro (v397); sidecar um_absoluto_selo_acom.json {sc['veredito']} ({sc['n_objetos']} objetos, {sc['recusas']} recusas, sha16 {sc['sha16']}). "
                   "E0, que esta rota (seq %s) deixava declarado, passou a POSTO em 31/10/2026 pelo operador, e a correcao vai AO LADO (ERRATA seguinte, E11), sem tocar nos registros da v404 e sem editar nenhum modulo ja' instalado." % sq_v404,
                   "custodia conjunta pela sessao do site (o handoff lista o sidecar e traz a nota ao lado do paragrafo da v404).", refs=[R_PONTE, R_E0]))
    T9.append(anot(R_PREP405, "v405 SELADA %s: a preparacao fechou — o rito rodou; a rota da versao selada e' %s" % (S, NOVA),
                   f"o candidato {S} (preparado nesta rota) selou: as {NF} bandeiras novas, a escada {esc0} -> {esc1}, os oito modulos, os oito registros com funcao e os cinco por spec e as {len(verb)} falas por sha256, conferidos pelo conferidor ({conf_dm}; nao pode mudar {conf_np}) e pela leitura da rodada; "
                   "nada do que a preparacao pinou foi alterado entre a preparacao e o selo.", "a custodia (G1) e o registro da rota selada sao os passos seguintes.", refs=[R_PONTE]))
    T9.append(errata(R_V404, sq_v404,
                     f"[E11 · ERRATA AO LADO, gerencia c1, em nome proprio, 01/11/2026, v405 {S}] Corrige o registro seq {sq_v404} desta rota (a v404 selada), que deixa E0 = 1 eV como DECLARADO; o mesmo texto esta nos registros da v404 do core, cobertos por esta errata. {corpo('E11')}. Os registros corrigidos NAO foram apagados nem reescritos: a correcao vai ao lado.",
                     refs=[R_E0, R_PONTE]))
    for x in T9:
        assert x["rota_id"] in ids, "a rota %s nao existe no mapa" % x["rota_id"]
    resumo_conf = ("conferidor %s e %s" % (conf_dm, conf_np)) if "nao lido" not in (conf_dm, conf_np) else "conferidor: o resultado nao veio na leitura desta rodada"
    nomes_curtos = ", ".join(G[g]["curto"] for g in GRUPOS)
    _vr405 = lambda v_: v_ if len(v_) <= 200 else v_[:197] + "..."   # o campo resultado do Mapa tem teto de 6000 caracteres (rotas._valida: resuma e aponte o artefato): a integra de cada veredito esta no core da rodada e nos ESPERADOS
    ROTA = {"tipo": "ROTA", "rota_id": NOVA, "dominio": "SELO_UM_PY", "status": "EXAMINADA", "estatuto": "REAL", "olhou_dados": False,
            "titulo": "v405 SELADA %s: a massa derivada e a identidade definida — %d modulos de kernel com os nomes do operador (%s), oito registros com funcao, cunhagens_v405, campos_fechados_e_leituras_v405, ga_reclassificacao_v405 e kh_n1_cobertura_v405, %d inscricoes de 30/10 a 01/11 por sha256; escada %s -> %s; %s; o gate nao se move" % (
                S, len(GRUPOS), nomes_curtos, len(verb), esc0, esc1, FRASE),
            "pergunta": "o candidato v405 selou com os OITO modulos de kernel, os oito registros com FUNCAO (cada um le do kernel do proprio rito a composicao e a estrela da sua pedra e CALCULA, com beta = alfa x raiz de e em runtime, um modelo) e os cinco por spec (as falas do operador por sha256, as decisoes D27 a D33, as erratas E10 a E13, os campos fechados e as leituras, a classe nova do Grande Atrator ao lado, o gap ao lado, a cobertura KH-N1), "
                        "com os registros da v404, da v403, da v402, da v401 e da v399, o selo pela propria tecnologia e o quadro do topo seguindo selados, o sidecar reescrito, a letra do veredito do gate igual a da v404 e nenhum veredito fora da troca dita mudado?",
            "dados": ["as oito pedras (%s), pinadas por sha256 em pedra e insumos (so' lidas), e a medida da cobertura (KH_N1_v405.json)" % nomes_curtos,
                      "as %d falas de 30/10 a 01/11 por sha256 em insumos\\cunhagens (todas falas do operador; a lista esta no registro cunhagens_v405 e na linhagem)" % len(verb),
                      "o kernel do rito (a composicao e a estrela de cada pedra e os termos que ela cita), a reclassificacao do Grande Atrator e o parecer da ENTREGA 005 (lidos por hash), o proprio um.py, o core e o selo da rodada; nenhum dado novo foi aberto nesta rota"],
            "metodo": "ensaio a seco do candidato; um lake build e um Audit no sandbox; rito completo; conferidor (deve mudar / nao pode mudar, com o quadro do topo conferido de novo contra o resultado pinado nas duas linguas e no .md, e os 16 itens C1-C16 do selo mais o round trip do um.py instalado); "
                      "leitura da rodada (inclui o sidecar e a linha final do rito); superficies com a regra da linhagem completa (o MEMORY.md nao e' compactado: recusa por contagem); elo B(n) da Bancada (passo simples v404 -> v405, sem salto; recibos); a guarda das frases em todo texto novo; o paragrafo novo e o do quadro, a nota ao lado do paragrafo da v404 e o sidecar, no handoff",
            "resultado": " | ".join(_vr405(v_) for v_ in [G[g]["verdict"] for g in GRUPOS] + [cg["verdict"], cf["verdict"], ga["verdict"], (core.get("gap_v405") or {})["verdict"], kh["verdict"]]) + " | (vereditos resumidos a 200 caracteres; a integra esta no core da rodada, um_absoluto.json) | sidecar %s (%s objetos, %s recusas) | %s | %s | escada %s -> %s (teoremas limpos %s/%s; %d bandeiras novas: %s)" % (
                sc["veredito"], sc["n_objetos"], sc["recusas"], resumo_conf, ("%s vereditos fora da troca dita mudaram (exigido 0)" % nvm) if nvm != "nao lido" else "vereditos fora da troca dita: nao lidos nesta leitura", esc0, esc1, ESP["escada"][0], ESP["escada"][1], NF, " + ".join("%d %s" % (G[g]["n_flags"], G[g]["curto"]) for g in GRUPOS)),
            "defeito": "as pedras NAO derivam a unidade u (POSTO) nem alfa (MEDIDA); as leituras da cadeia da massa entram como definicao ou identificacao, nao sao teoremas, e a lista nao e' fechada: " + leit + "; a Identidade prova um fato sobre projecoes no estado traco; que isso seja a identidade e' leitura, tipada como modelo; o no-go de E0 nao cai, localiza-se no Um posto; "
                       "o gate nao se moveu e a independencia das 4 bandeiras experimentais segue aberta (derivam de UM so' booleano) [DECLARADO, GV-01 e GV-03]; a pendencia [LEGAL] (D2) segue do operador; a revisao independente das oito pedras nao e' afirmada por este registro",
            "nao_refazer": "a integracao dos oito modulos e a escada %s -> %s estao medidas; o calculo de cada pedra no kernel do rito esta feito e conferido contra o um.py instalado; repetir os registros so' com kernel ou um.py novo; a pergunta sobre derivar alfa foi respondida nao (parede medida; a rota esta no mapa)" % (esc0, esc1),
            "proximo_passo": "o valor absoluto do setor e as escolhas da partitura do Grande Atrator (operador); a ordem Kimi 5 sigma 02 (natureza.cinco_sigma_02_kimi_01nov); decisao [LEGAL] D2 com a agente de PI; custodia conjunta pela sessao do site (o handoff traz os paragrafos prontos do README e do site, a nota ao lado do paragrafo da v404 e lista o sidecar); revisao independente das pedras e dos derivados: ver o caderno revisao_terceiro do pacote v405",
            "onde": PK, "artefatos": arts, "refs": sorted(set(x["rota_id"] for x in T9) | set(REFS) | set(preparo_no_livro(ids)) - {NOVA}),
            "nota": "validade no kernel nao e' creditacao; NOT_FALSIFIED nao e' a palavra da creditacao; o gate nao se move; as erratas E10 a E13 e as decisoes D27 a D33 sao da gerencia c1, em nome proprio, ao lado (nada foi apagado nem reescrito); %s." % sim(c_seguem, "os registros anteriores seguem selados", "ALGUM REGISTRO ANTERIOR NAO SELOU")}
    for r in ROTA["refs"]:
        assert r in ids, "a rota citada em refs nao existe no mapa: %s" % r
    REG = [ROTA] + T9
    bad = [(x["rota_id"], violacoes(json.dumps(x, ensure_ascii=False))[:2]) for x in REG if violacoes(json.dumps(x, ensure_ascii=False))]
    assert not bad, "a guarda de texto (P18) achou violacao(oes): %r" % bad
    import guarda_frases_v405 as GF
    bad2 = [(x["rota_id"], GF.violacoes(json.dumps(x, ensure_ascii=False))[:2]) for x in REG if GF.violacoes(json.dumps(x, ensure_ascii=False))]
    assert not bad2, "a guarda das frases achou violacao(oes): %r" % bad2
    atrib = [(x["rota_id"], T.atribuicao_da_gerencia(json.dumps(x, ensure_ascii=False))[:2]) for x in REG if T.atribuicao_da_gerencia(json.dumps(x, ensure_ascii=False))]
    assert not atrib, "a direcao do testemunho esta invertida ou a atribuicao falhou: %r" % atrib
    ruins = regra_4_44(REG, z, p)
    assert not ruins, "a regra do 4,44 (o p calibrado e a linha dos 5 sigma no mesmo campo) falhou em: %r" % ruins[:3]
    assert c_seguem and c_q, "algum registro anterior (quadro, v404, v403, falsidade, ponte, queda, esperanca, selo, declaracao, sonico, afinacao) nao selou no core: o mapa nao registra a v405 assim"
    return REG


