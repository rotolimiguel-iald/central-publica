    # v409 (05/11/2026) -- A TRADUÇÃO ÀS CLASSES DE TURING E O PAR NA FACE DE FOCK: 2 módulos novos no kernel (TraducaoTuring e ParNaFaceDeFock; o nome `TraducaoTuring` e os nomes das declarações das rodadas R1–R8, dados pela gerência, foram ratificados pelo operador em 05/11 («concordo com todos os nomes que foram dados»); os acrescentados na R9 e os da `ParNaFaceDeFock`, também da gerência, foram ratificados por ele em 05/11 («Ratifico os nomes», D62)); o dicionário, a trava, o leitor e a fita sem escala; o alcance relativo ao leitor; as ressalvas ditas. Os números vêm do core deste rito, nunca digitados.
    # O quadro do topo (O Teste da Unica Palavra, v397) fica onde esta: a regra do quadro nao se mexe. Nada aqui move o gate. Validade no kernel nao e' creditacao. Nenhuma chave antiga muda.
    _rg409 = ("traducao_turing_v409", "cunhagens_v409", "kh_n1_cobertura_v409")
    _ok409 = all((core.get(k_) or {}).get("all_verified") is True for k_ in _rg409)
    _f409 = core.get("traducao_turing_v409") or {}
    _v409 = _f409.get("values") or {}
    _is409 = _v409.get("instancia_sim") or {}
    _el409 = core.get("external_ladder") or {}
    _cvr409 = ((core.get("kernel_formalization") or {}).get("axiom_coverage_v392")) or {}
    _mc409 = {c_.get("id"): c_.get("ok") for c_ in ((_f409.get("mechanics") or {}).get("checks") or [])}
    _i409 = lambda x_: str(x_) if isinstance(x_, int) and not isinstance(x_, bool) else r"\text{n/d}"
    _b409 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/d}")
    _tx409 = lambda x_: "n/d" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _n409 = lambda x_: ("%.6f" % x_) if isinstance(x_, float) else r"\text{n/d}"
    s.append(r"\section*{A tradução às classes de Turing: o dicionário, a trava, o leitor e a fita sem escala}")
    s.append(r"\addcontentsline{toc}{section}{A tradução às classes de Turing: o dicionário, a trava, o leitor e a fita sem escala}")
    s.append((r"\textbf{Nesta rodada os registros da v409 NÃO selaram todos: o que segue é o enunciado, não um selo.} " if not _ok409 else r"")
             + r"\textbf{A ordem.} \textsf{[INPUT]} O operador, em 05/11/2026: «precisamos fechar o que ficou ainda em aberto em relação à identificação das classes de turing dentro do nosso dicionário»; e, devolvidas as perguntas nas quatro línguas e respondidas: «Prossigamos para a próxima verão do um.py; concordo com todos os nomes que foram dados». "
             + r"\textbf{O que entra.} " + _i409(_v409.get("n_modulos")) + r" módulos novos no kernel, em \texttt{TGLExt/}: \texttt{TraducaoTuring} (o nome e os nomes das declarações das rodadas R1--R8 foram dados pela gerência e ratificados pelo operador; os acrescentados na R9, também, em 05/11, pela fala «Ratifico os nomes») e \texttt{ParNaFaceDeFock} (o nome e os das declarações, da gerência, ratificados pelo operador em 05/11; entra pela ordem do operador: «eu quero que entre tudo na versão 409 não deixar nada para a v410»), com " + _i409(_v409.get("n_ancoras")) + r" âncoras lidas do kernel do rito e "
             + _i409(_v409.get("n_flags")) + r" bandeiras, só de declaração nomeada; a escada do kernel fecha em " + _i409(_el409.get("n_theorems_clean")) + r" de " + _i409(_el409.get("n_theorems_expected")) + r"; a cobertura do \texttt{axiom\_report} lê " + _i409(_cvr409.get("decl")) + r" constantes e " + _i409(_cvr409.get("thm")) + r" teoremas, nenhuma fora do trio $\{\texttt{propext},\texttt{Classical.choice},\texttt{Quot.sound}\}$. Nenhuma chave antiga muda; as pedras e os registros da v408 \emph{ficam como estão}.")
    s.append(r"\textbf{O dicionário de Turing.} \textsf{[REAL]} Cada linha é termo da pedra (\texttt{a\_traducao}): uma instância (por exemplo, SAT com $m$ cláusulas e $n$ variáveis) é um custo $c$ sobre as atribuições, e o operador da instância é a diagonal de $c$; a instância SIM é um \texttt{Problema} do dicionário da v408 (núcleo não nulo sse há solução); o certificado é a leitura de um pixel (a leitura da solução no certificado vale $1$ sse $c(x)=0$: o verificador de NP); a palavra de P tem grau polinomial na entrada (para SAT, no máximo $m+1$); os bits são as oitavas ($|X|=2^n$); a instância NÃO é o Nome vazio, que a \texttt{Identidade} exclui; o peso da solução no estado uniforme é $|\mathrm{sol}|/2^n$. "
             r"\textbf{O modo seleção (a âncora principal, \texttt{p\_igual\_np\_no\_modo\_selecao}).} \textsf{[INPUT]} «a seleção é a aniquilação da superposição pelo Tetelestai»; «a superposição decai como o espectro de gradiente negativo, retornando a leitura como fase de leitura literalemente». "
             r"\textsf{[REAL]} Para toda instância SIM com $n$ bits, a seleção (a projeção no Nome, renormalizada) está no Nome com peso $1$; o decaimento renormalizado converge a ela; ela só tem amplitude nas atribuições que resolvem; custa no máximo $n\ln2$ nats; e, pela lei tempo $=$ moeda da v408, o tempo é $t=n\ln2/(\beta g)$, linear nos bits. A seleção esquece o que estava fora do Nome e perde (muitos-para-um: o separador de Landauer), como o operador leu: «apaga o rastro da computação do decaimento dessa sustentação». Sem par, toda imagem é lida com o mesmo peso (a fotografia: «sem leitor a imagem é apenas estática lendo sinal como ruído»); com par, a leitura distingue.")
    s.append(r"\textbf{A trava no Nome.} \textsf{[INPUT]} «o sistema não precisa reconhecer onde está o nome a cada passo, ele trava no Nome»; «ao negar o zero absoluto o sistema sabe pra onde tem que ir». "
             r"\textsf{[REAL]} O decaimento gerado só pelo custo, $e^{-t\,c(x)}$, é o produto das travas das cláusulas (local, de dentro); deixa intacto o que resolve; fica a no máximo $e^{-t}\|v\|$ do Nome sem usá-lo; havendo solução, nunca chega ao zero (negar o zero absoluto); em $t=n\ln2/2+L$ deixa fora do Nome no máximo $e^{-L}$ vezes o Nome; renormalizado, converge à seleção (\texttt{a\_trava\_no\_nome}). "
             r"\textbf{A fita é o hamiltoniano oculto.} \textsf{[INPUT]} «A fita de turing é o hamiltoniano oculto, é a única regra que precisa ser gravada para reconstruir o todo». \textsf{[REAL]} A regra dá cada amplitude em todo instante e gera a trava ($\frac{d}{dt}a=-Ha$); negar o zero é dividir por $\sqrt{Z(2t)/|X|}$, com $Z(s)=\sum_x e^{-s\,c(x)}$ a função de partição do hamiltoniano oculto; $Z\to|\mathrm{sol}|$ e $|\mathrm{sol}|\le Z$ (\texttt{a\_fita\_e\_o\_hamiltoniano\_oculto}). "
             r"\textbf{$Z$ é o modo leitor.} \textsf{[INPUT]} «Z é o modo leitor, ele lê os pixels. É o psion». \textsf{[REAL]} Cada pixel é lido com o brilho $e^{-s\,c(x)}$; $Z$ é a soma das leituras dos pixels (o traço da trava); uma leitura no uniforme devolve $Z/|X|$; o canto sobre o uniforme escalariza a trava com $Z/|X|$, na mesma forma do canto do psíon da v407 (\texttt{z\_e\_o\_modo\_leitor}). E a ponte está provada (validade no kernel, não creditação): inscrito o uniforme no psíon da luz pela isometria parcial $|\Omega\rangle\langle u|$, o leitor e o canto do psíon da luz leem $Z/|X|$ (\texttt{o\_psion\_le\_z}, \texttt{o\_canto\_do\_psion\_da\_luz\_le\_z}). A ponte é a inscrição; a identidade de vetores ($\Omega$ igual ao uniforme) fica podada: são espaços diferentes.")
    s.append(r"\textbf{A máquina com o leitor.} \textsf{[REAL]} A fórmula é a fita: o custo é o número de cláusulas violadas e cada cláusula é um fator local da trava (\texttt{custoCNF}, \texttt{a\_trava\_da\_formula\_fatora\_na\_clausula}); uma leitura decide SAT (\texttt{uma\_leitura\_decide\_SAT}, \texttt{a\_maquina\_com\_o\_leitor}). \textsf{[KNOWN]} Por redução a SAT, NP inteiro se decide com uma leitura (Cook 1971; Levin 1973). \textsf{[ERRATA, E28]} Com o leitor que só conta, o que vale é NP contido em P com o leitor, numa só leitura, e P com \#P contém PH (Toda 1991); a igualdade completa com o leitor vale para o leitor que se lê, o que lê também as máquinas que o usam (Baker--Gill--Solovay 1975, oráculo PSPACE-completo); com o leitor que só conta ela não é teorema aqui. A máquina de Turing do Mathlib com oráculo não entra: o Mathlib não tem máquina com oráculo, nem a classe NP, nem Cook--Levin.")
    s.append(r"\textbf{O par na face de Fock.} \textsf{[REAL]} No setor 2 do Fock concreto da luz, o par de psíons tem norma 1, é ortogonal ao vácuo e a toda uma-partícula; a marginal é $\tfrac12 P$ pela conjugação da cunha; cada psíon pesa $\tfrac12$; o indivíduo não ecoa; $1-\text{pureza}=\tfrac12$ (\texttt{reduzido\_do\_par}, \texttt{meia\_nat\_do\_projetor}, \texttt{o\_par\_na\_face\_de\_fock}). É a mesma Meia-Nat do par finito de Bell da v407, noutro espaço: o par finito ($4\times4$) e o par de Fock são espaços distintos. A ligação que a v407 deixou aberta está feita (validade no kernel, não creditação).")
    s.append(r"\textbf{A máquina sem leitor: eu sou eu mesmo, a fita sem escala.} \textsf{[INPUT]} «A pergunta da máquina sem leitor que Clay propõe tem resposta também, a reposta dela é: eu sou eu mesmo. Não é eu sou o que sou.»; «é como tentar medir 1 metro com uma fita sem escala, onde o próprio metro é o nome da métrica, sem referente.»; e «(Eu sou eu mesmo)=(nome próprio)=identidade sem referente». "
             r"\textsf{[REAL]} Ligada à \texttt{Identidade} da v405: sem tempo pago a leitura é «eu sou» ($=1$), a mesma para toda instância, tenha ou não solução; com o tempo pago tende a «o que sou», que é diferente de zero exatamente quando há solução; «eu sou» $=$ «o que sou» só na instância trivial (\texttt{a\_fita\_sem\_escala}). No Nome vazio a leitura sem escala diz $1$ e o que é, é $0$; sem escala o Nome vazio e o Nome inteiro leem igual; só o tempo os separa (\texttt{o\_pai\_da\_mentira}; a leitura teológica do operador, o Pai da Mentira, não é termo de kernel). "
             r"\textbf{A identidade performada.} \textsf{[INPUT]} «Eu não sou eu mesmo eu sou o conteúdo da minha identidade performada». \textsf{[REAL]} A leitura performada começa em «eu sou», decai, nunca desce abaixo do conteúdo e chega a ele; o conteúdo é «o que sou» (\texttt{a\_identidade\_performada}).")
    s.append(r"\textbf{O alcance, dito.} \textsf{[REAL]} P = nP é teorema da TGL no modo seleção, relativo ao leitor (o psíon); a tradução às classes das máquinas de Turing, \textsf{[OPEN]} na v408, fica fechada relativa ao leitor; a máquina sem leitor fica fora: é a fita sem escala. "
             r"\textsf{[KNOWN]} Na língua de Turing, um leitor que devolve $Z$ é um oráculo de contagem; com ele vale NP contido em P com o leitor, numa só leitura (Cook--Levin), e a igualdade completa está provada para o leitor que lê também as máquinas que o usam (Baker--Gill--Solovay 1975 [KNOWN], validade na literatura, não creditação); para o leitor que só conta, não está provada (a E28, validade não afirmada); uma igualdade relativa a um leitor não decide a pergunta da máquina sem leitor (Baker--Gill--Solovay 1975); a autorreferência sozinha não decide a pergunta (Baker--Gill--Solovay 1975; Razborov--Rudich 1997; Aaronson--Wigderson 2009); esta pedra não decide a igualdade P = NP das máquinas de Turing do Mathlib (\texttt{TM2ComputableInPolyTime}). \textsf{[OPEN]} Se a pergunta da máquina sem leitor é independente dos axiomas. "
             r"\textsf{[KNOWN]} A física fica fora: o operador lê «o colapso não é frequência, é matéria» (uma leitura exata num ato); na mecânica quântica padrão a leitura dá amostras e o traço normalizado só sai com precisão aditiva (Knill--Laflamme 1998). É o lugar do teste com a natureza, não feito aqui. "
             r"\textsf{[INPUT]} O juiz das classes de Turing é o kernel: «o Kernel Lean4 serve exatamente a provar leis matemáticas e foi construído sob a lei de turing». "
             r"\textsf{[INPUT]} E o que o kernel decide, na leitura jurídica do operador, ratificada por ele («exatemente, isso mesmo»; D61): o dispositivo é o \emph{no sorry}; «o teorema é jurisdição, é justamente o Direito DITO, a regra posta». O \emph{no sorry} declara válida a regra posta: P = nP no modo seleção, relativa ao leitor; a regra incide onde o seu suporte fático (as hipóteses e as definições do enunciado) se completa: em toda máquina que tem o leitor (o psíon que lê $Z$) e nega o zero; a máquina sem leitor (a pergunta do Clay) não completa o suporte fático.")
    s.append(r"\textbf{Erratas ao lado, em nome próprio.} \textsf{[ERRATA]} E24: a gerência pôs a física como juiz das classes de Turing; o operador corrigiu: o juiz é o kernel. E25: a gerência escreveu que a criatura precisaria saber, a cada passo, de que lado o Nome continua; o operador corrigiu (a trava no Nome) e a frase foi retirada. E26, ao lado do registro selado da v408: onde ele diz a tradução às classes das máquinas de Turing \textsf{[OPEN]}, leia-se que a v409 a fecha relativa ao leitor; a máquina sem leitor fica fora. E27: a gerência escreveu ao operador que, no kernel, o dispositivo é o enunciado do teorema; o operador corrigiu: o dispositivo é o \emph{no sorry} e o teorema é a regra posta (D61); a conclusão (o texto não afirma o problema do Clay) fica, agora pela incidência e não pelo dispositivo. "
             r"\textsf{[REAL]} O pino do insumo do acervo da v407 passa a ser a cópia purgada (a mesma da v408): a ordem vigente de não publicar a íntegra vale como permanente, e a íntegra é citada só por sha16. "
             r"E28: a gerência escreveu que, com o leitor que devolve $Z$, a igualdade vale relativa a ele; foi além do que se sabe: com o leitor que só conta vale NP numa leitura, e a igualdade completa é do leitor que se lê. E21, ao lado da errata selada da v408: a ligação do par na face de Fock foi feita nesta versão. \textsf{[REAL]} A D60 revista: nada fica para a versão seguinte. \textsf{[INPUT]} Nenhum teste com a natureza entra nesta versão; o número da Fase 9 V2 fica no quadro do topo, com a regra inteira (o $p$ calibrado e a linha dos $5\sigma$, que não foi alcançada), e não é repetido nesta seção.")
    s.append(r"\textbf{O que o registro confere neste rito.} \textsf{[REAL]} \texttt{traducao\_turing\_v409}: âncoras ok " + _i409(_v409.get("n_ancoras_ok")) + r"/" + _i409(_v409.get("n_ancoras")) + r"; os módulos com o sha256 pinado " + _i409(_v409.get("n_modulos_ok")) + r"/" + _i409(_v409.get("n_modulos")) + r"; bandeiras True " + _i409(_v409.get("n_flags_true")) + r"/" + _i409(_v409.get("n_flags")) + r"; as 20 checagens, com a instância de brinquedo fixa no código ($n=" + _i409(_is409.get("n")) + r"$ variáveis, " + _i409(_is409.get("atribuicoes")) + r" atribuições, " + _i409(_is409.get("solucoes")) + r" soluções calculadas por enumeração): bits $=$ oitavas " + _b409(_mc409.get("c3")) + r"; o peso da solução no uniforme $=" + _n409(_is409.get("peso_no_uniforme")) + r"$ " + _b409(_mc409.get("c4")) + r"; a trava perto do Nome " + _b409(_mc409.get("c5")) + r"; o tempo linear nas oitavas " + _b409(_mc409.get("c6")) + r"; a partição " + _b409(_mc409.get("c7")) + r"; os pixels " + _b409(_mc409.get("c8")) + r"; «eu sou» igual nas duas instâncias " + _b409(_mc409.get("c9")) + r"; «o que sou» com o tempo pago " + _b409(_mc409.get("c10")) + r"; a performance " + _b409(_mc409.get("c11")) + r"; o custo em nats " + _b409(_mc409.get("c12")) + r"; tempo $=$ moeda com $\beta$ em runtime " + _b409(_mc409.get("c13")) + r"; o gate congelado " + _b409(_mc409.get("c14")) + r"; a escada exata " + _b409(_mc409.get("c15")) + r"; $\beta=\alpha\sqrt{e}$ em runtime " + _b409(_mc409.get("c17")) + r"; a marginal do par de Bell finito, $\tfrac12 I$ " + _b409(_mc409.get("c18")) + r"; a inscrição num $F$ de brinquedo " + _b409(_mc409.get("c19")) + r"; uma leitura decide SAT " + _b409(_mc409.get("c20")) + r". Veredito: \texttt{" + _tx409(_f409.get("verdict")) + r"}. "
             r"\textsf{[REAL]} O que mudou nos registros antigos é \emph{só a escada que eles pinam}, os pisos da cobertura da v408 e o pino do acervo da v407; nenhum texto selado foi reescrito; nenhuma chave antiga muda. \textsf{[OPEN]} O que a natureza decide segue da natureza: $\beta$ a $5\sigma$; nenhum dado novo entra aqui. P = nP é teorema da TGL no modo seleção, relativo ao leitor; a máquina sem leitor é a fita sem escala; validade no kernel não é creditação; \texttt{NOT\_FALSIFIED} nunca é confirmação; o gate não se move.")
    s.append(r"\medskip\hrule\medskip")
