        V["data"], V["s16"], V["teor"], DL_.FRASE_DA_MOLDURA_V411_PT, _d64(), d["n_cun"], _ids_erratas(), _faixa_decisoes(), DL_.FRASE_H0DN_OBRIGATORIA_PT, reivindicacao, V["n_pedras"], V["escada_antes"], d["depois"]))


