# v411: o topico novo da memoria (um arquivo por versao)
def topico_novo(V):
    d = _d(V); DL_ = _dl()
    return (("---\nname: %s\ndescription: \"v411 SELADA (%s) `%s`: IALD2 e a escala: %d módulos novos no kernel (IALD2 e AEscala; o nome do módulo IALD2 é do operador, os das declarações da gerência, ratificados por ele em 09/11, D74 e D87); o leitor do código; IALD ao quadrado (reler não acrescenta); o algoritmo IALD, relativo ao leitor, e a máquina de Turing padrão sem o leitor fica fora; a forma de matriz finita é o signo; o atrator (tangenciado, jamais esgotado); a escala (três faces de ½, duas conjugadas; a pergunta do Clay na forma canônica, com a creditação do Clay); o H0DN × BG1 (%s) e o recibo documental HMS/13; validade no kernel não é creditação; %d inscrições por sha256; escada %s → %s; gate intocado\"\n"
             "metadata:\n  type: project\n---\n\n# v411 SELADA (%s)\n\n"
             "**O que é:** `um.py` **v411** `%s` (%s B) sobre a v410 `%s`; %s; COMPLETA; rc %s; gate intocado; conferidor `%s` (deve mudar %s; não pode mudar %s); o `um.py` cresce %s B (%s%%).\n\n"
             "**O que entrou:** %s.\n\n"
             "**As inscrições de %s** (embutidas por sha256; data, sha16, autor e tema — o nome do arquivo, não citação; o texto embutido está em `insumos\\cunhagens`):\n%s\n\n"
             "%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n%s\n\n"
             "**Pendências:** a decisão sobre publicar o resto da fala da D65 (ato do operador); o README pinado (D39, custódia); a pendência [LEGAL] (D2); a abertura do H0DN × BG1 (versão futura: a covariância física fechada e o vetor observado). " + DL_.costura_maiuscula(DL_.FRASE_H0DN_PODER_COM_RETORNO_PT) + ". Os nomes das declarações já foram ratificados por ele em 09/11 (D74 e D87). Pacote: `C:\\IALD\\Central de Patentes\\work\\cadeia_de_selo\\v411`.\n\n"
             "[[missao-ultima-flag-um-py]] [[estatuto-da-prova-07out]] [[handoff-v411-custodia]]\n") % (
        TOPICO_NOVO[:-3], V["data"], V["s16"], V["n_pedras"], DL_.FRASE_H0DN_OBRIGATORIA_PT, d["n_cun"], V["escada_antes"], d["depois"], V["data"], V["s16"], format(V["umb"], ","), V["base16"], V["teor"], V["rc"], V["conf16"], V["conf_dm"], V["conf_np"],
        format(d["delta"], ","), d["pct"], _num(V), d["periodo"], _cunhagens(V), _blocos_fecho(V), secao_h0dn(V), _leituras(V), _erratas_e(V), _decisoes(V), _pedra(V), _regra_do_4_44(V), _kernel_prova(V), _limites(V), _legal(V) + "\n\n" + _erratas(V)))


