_H12 = {l_: re.findall(r"\\(?:sub)?section\*\{([^{}]*)\}", "\n".join(um._V412_SECAO[l_])) for l_ in ("pt", "en")}   # (v412) os titulos da secao nova (o do sumario e os das secoes numeradas), lidos do texto embutido
DEVE["pt"] += _H12["pt"]; DEVE["en"] += _H12["en"]
assert len(_H12["pt"]) == len(_H12["en"]) >= 5
