    {
      "id": "different_content_not_repeat",
      "texts": [
        "K06R1|T01|TraducaoTuring|declares_type|LeitorDoFundo|FORMAL\n",
        "K06R1|T01|TraducaoTuring|declares_type|OtherReader|FORMAL\n"
      ],
      "expected_raw_pairs": [],
      "expected_canonical_pairs": []
