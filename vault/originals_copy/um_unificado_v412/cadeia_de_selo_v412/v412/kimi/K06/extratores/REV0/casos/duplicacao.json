    {
      "id": "a8_textually_distinct",
      "variant": "distinct_full_T",
      "expected_A8": 1,
      "expected_distinct_raw_in_5_8": 4,
      "expected_distinct_canonical_in_5_8": 4,
      "expected_admissible": true,
      "note": "Conteúdo estrangeiro distinto separa os hashes; isto só afasta duplicação, não prova independência estocástica nem atrator."
