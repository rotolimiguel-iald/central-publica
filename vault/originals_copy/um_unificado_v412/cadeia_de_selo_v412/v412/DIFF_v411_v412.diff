+    'TGLExt/PolinomioPorEscolha.lean': 'import TGLExt.EscolhasGlobais\nimport TGLExt.FechoNaFita\n\n/- Uma entrada plana unária: tick repetido i vezes e uma letra de sinal por\n   literal de índice i, mais um terminador por cláusula. O programa Horn\n   fornecido como escolha cabe no comprimento desta entrada. Verificá-lo\n   tem custo de fita delimitado. Obter/verificar a seleção a partir das duas\n   fitas (a fórmula e um candidato), ou buscar uma boa escolha, é outra etapa. -/\nset_option autoImplicit false\nnamespace Codex.PolinomioPorEscolha\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula Codex.CrossSelectors Codex.HornCross\nopen Codex.SparseHornTape\nvariable {n : Nat}\n\ninductive Letter where\n  | tick | sign (positive : Bool) | delimiter\nderiving DecidableEq, Repr\n\ndef spell (l : Literal n) : List Letter := List.replicate l.var.val .tick ++ [.sign l.pos]\ndef spellClause (c : Clausula n) := c.flatMap spell ++ [.delimiter]\ndef original (p : CNF n) := p.flatMap spellClause\n\ndef weight (xs : List (Fin n)) : Nat := (xs.map (fun i => i.val+1)).sum\n\ntheorem arg_length (i : Fin n) (s : Sym) : (arg i s).length = i.val+1 := by simp [arg]\n\ntheorem args_length (xs : List (Fin n)) : (args xs).length = weight xs := by\n  induction xs with\n  | nil => rfl\n  | cons i xs ih =>\n    change (arg i .need ++ args xs).length = (i.val+1)+weight xs\n    rw [List.length_append,arg_length,ih]\n\ntheorem weight_member (xs : List (Fin n)) (i : Fin n) (h : i ∈ xs) :\n    i.val+1 ≤ weight xs := by\n  induction xs with\n  | nil => simp at h\n  | cons x xs ih =>\n    change _ ≤ (x.val+1) + weight xs\n    rcases List.mem_cons.mp h with h|h\n    · subst x; omega\n    · have := ih h; omega\n\ntheorem sign_partition (c : Clausula n) :\n    weight (names c false)+weight (names c true) = (c.flatMap spell).length := by\n  induction c with\n  | nil => rfl\n  | cons l c ih =>\n    obtain ⟨i,b⟩ := l\n    cases b <;>\n      simp [names,weight,spell] at ih ⊢ <;> omega\n\ntheorem alternative_length (c : Clausula n) (r : Rule n) (hr : r ∈ alternatives c) :\n    (line r).length ≤ (spellClause c).length := by\n  have part := sign_partition c\n  unfold alternatives at hr\n  cases h : names c true with\n  | nil =>\n    simp [h] at hr\n    subst r\n    have empty : weight (names c true) = 0 := by rw [h]; rfl\n    change (args (names c false) ++ [Sym.deny]).length ≤ (c.flatMap spell ++ [Letter.delimiter]).length\n    simp only [List.length_append,args_length,List.length_cons,List.length_nil]\n    omega\n  | cons i is =>\n    simp only [h,List.mem_map] at hr\n    obtain ⟨j,hj,rfl⟩ := hr\n    have hw := weight_member (names c true) j (by simpa only [h] using hj)\n    change (args (names c false) ++ arg j .setBit).length ≤ (c.flatMap spell ++ [Letter.delimiter]).length\n    simp only [List.length_append,args_length,arg_length,List.length_cons,List.length_nil]\n    omega\n\ntheorem selected_length (p : CNF n) (q : List (Rule n)) (hq : q ∈ programs p) :\n    (program q).length ≤ (original p).length := by\n  induction p generalizing q with\n  | nil => simp [programs] at hq; subst q; rfl\n  | cons c p ih =>\n    simp only [programs,List.mem_flatMap,List.mem_map] at hq\n    obtain ⟨r,hr,v,hv,rfl⟩ := hq\n    change (line r ++ program v).length ≤ (spellClause c ++ original p).length\n    simp only [List.length_append]\n    exact Nat.add_le_add (alternative_length _ _ hr) (ih _ hv)\n\ntheorem halt_persists (c : Cfg) (b : Bool) (h : c.mode = .halt b) (k : Nat) :\n    run k c = c := by\n  have fixed : step c = c := by simp [step,h]\n  induction k with\n  | zero => rfl\n  | succ k ih => simp [run,fixed,ih]\n\ntheorem halt_unique (c : Cfg) (k j : Nat) (a b : Bool) (ha : (run k c).mode = .halt a)\n    (hb : (run j c).mode = .halt b) : a = b := by\n  have h₁ : (run (k+j) c).mode = .halt a := by rw [run_add,halt_persists _ _ ha,ha]\n  have h₂ : (run (j+k) c).mode = .halt b := by rw [run_add,halt_persists _ _ hb,hb]\n  rw [Nat.add_comm k j] at h₁\n  exact Mode.halt.inj (h₁.symm.trans h₂)\n\ndef budget (L : Nat) := (L+1)*(3*L+2)\n\ntheorem budget_le (u v : Nat) (h : u ≤ v) : budget u ≤ budget v :=\n  Nat.mul_le_mul (by omega) (by omega)\n\n/-- O limite vale para TODAS as escolhas: a máquina responde\n    sim ou não em função da Palavra de cada programa selecionado. -/\ntheorem every_candidate (p : CNF n) (q : List (Rule n)) (hq : q ∈ programs p) :\n    ∃ T ≤ budget (original p).length,\n      travel T (start q ∅) ≤ 2 * budget (original p).length ∧\n      (run T (start q ∅)).mode = .halt (checkProgram q) := by\n  obtain ⟨T,ht,move,answer⟩ := sparse_horn_tape q\n  have bound := budget_le _ _ (selected_length p q hq)\n  exact ⟨T,ht.trans bound,move.trans (Nat.mul_le_mul_left _ bound),\n    answer.trans (congrArg Mode.halt (horn_word q).symm)⟩\n\n/-- Exatidão existencial para CADA CNF. A máquina determinista aqui verificada\n    parte da fita do candidato q. A condição q ∈ programs p pertence à relação\n    matemática entre a entrada e a escolha; não é uma checagem gratuita da máquina. -/\ntheorem word_iff_bounded_selection (p : CNF n) :\n    palavraDaFormula p = true ↔\n      ∃ q ∈ programs p, (program q).length ≤ (original p).length ∧\n        ∃ T ≤ budget (original p).length,\n          travel T (start q ∅) ≤ 2*budget (original p).length ∧\n          (run T (start q ∅)).mode = .halt true := by\n  rw [← selector_word,scan_spec,List.any_eq_true]\n  constructor\n  · rintro ⟨q,hq,yes⟩\n    obtain ⟨T,hT,hv,h⟩ := every_candidate p q hq\n    exact ⟨q,hq,selected_length _ _ hq,T,hT,hv,by simpa only [yes] using h⟩\n  · rintro ⟨q,hq,_,T,_,_,h⟩\n    obtain ⟨S,_,_,ans⟩ := every_candidate p q hq\n    exact ⟨q,hq,halt_unique _ S T _ _ ans h⟩\n\nend Codex.PolinomioPorEscolha\n',
+    'TGLExt/ChecagemHorn.lean': 'import TGLExt.PolinomioPorEscolha\n\n/-! Direct syntactic Horn recognition: signs may be interleaved arbitrarily;\nthe negative list retains order and multiplicity. -/\nset_option autoImplicit false\nnamespace Codex.HornResidual\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula\nopen Codex.HornCross Codex.CrossSelectors Codex.PolinomioPorEscolha Codex.SparseHornTape\nvariable {n : Nat}\n\ndef parseClause (c : Clausula n) : Option (Rule n) :=\n  match names c true with\n  | [] => some ⟨names c false,none⟩\n  | [i] => some ⟨names c false,some i⟩\n  | _ :: _ :: _ => none\n\ndef parseProgram : CNF n → Option (List (Rule n))\n  | [] => some []\n  | c :: p =>\n    match parseClause c, parseProgram p with\n    | some r, some q => some (r :: q)\n    | _, _ => none\n\ntheorem parse_clause_iff (c : Clausula n) :\n    (∃ r, parseClause c = some r) ↔ (names c true).length ≤ 1 := by\n  cases hp : names c true with\n  | nil => simp [parseClause,hp]\n  | cons i is => cases is <;> simp [parseClause,hp]\n\ntheorem parsed_parts {c : Clausula n} {r : Rule n} (h : parseClause c = some r) :\n    r.body = names c false ∧ r.head.toList = names c true := by\n  cases hp : names c true with\n  | nil => simp [parseClause,hp] at h; subst r; simp\n  | cons i is =>\n    cases is with\n    | nil => simp [parseClause,hp] at h; subst r; simp\n    | cons j js => simp [parseClause,hp] at h\n\nprivate theorem clause_unique {c : Clausula n} {r : Rule n} (h : parseClause c = some r) :\n    alternatives c = [r] := by\n  cases hp : names c true with\n  | nil => simp [parseClause,hp] at h; subst r; simp [alternatives,hp]\n  | cons i is =>\n    cases is with\n    | nil => simp [parseClause,hp] at h; subst r; simp [alternatives,hp]\n    | cons j js => simp [parseClause,hp] at h\n\ntheorem parse_iff (p : CNF n) :\n    (∃ q, parseProgram p = some q) ↔ ∀ c ∈ p, (names c true).length ≤ 1 := by\n  induction p with\n  | nil => simp [parseProgram]\n  | cons c p ih =>\n    rw [List.forall_mem_cons,← parse_clause_iff,← ih]\n    cases hc : parseClause c <;> cases hp : parseProgram p <;> simp [parseProgram,hc,hp]\n\ntheorem sole_program {p : CNF n} {q : List (Rule n)} (h : parseProgram p = some q) :\n    programs p = [q] := by\n  induction p generalizing q with\n  | nil => simp [parseProgram] at h; subst q; rfl\n  | cons c p ih =>\n    cases hc : parseClause c with\n    | none => simp [parseProgram,hc] at h\n    | some r =>\n      cases hp : parseProgram p with\n      | none => simp [parseProgram,hc,hp] at h\n      | some tail =>\n        simp [parseProgram,hc,hp] at h\n        subst q\n        simp [programs,clause_unique hc,ih hp]\n\ntheorem parse_word {p : CNF n} {q : List (Rule n)} (h : parseProgram p = some q) :\n    palavraDaFormula p = checkProgram q := by\n  rw [← selector_word,scan_spec,sole_program h]\n  simp\n\ntheorem parse_size {p : CNF n} {q : List (Rule n)} (h : parseProgram p = some q) :\n    (program q).length ≤ (original p).length :=\n  selected_length p q (by rw [sole_program h]; simp)\n\nend Codex.HornResidual\n',
+    'TGLExt/CompilaHornNaFita.lean': "import TGLExt.PolinomioPorEscolha\n\n/- Compilação a partir dos caracteres da CNF original. Uma cabeça de entrada\n   avança, uma de saída escreve, e duas cabeças auxiliares unárias se deslocam\n   a partir de uma borda fixa. Nenhum passo copia um natural: os endereços\n   passam de uma cabeça à outra por movimentos unitários. Cada cláusula\n   retém sua primeira cabeça positiva, ou nenhuma se ela só tem negativos. -/\nnamespace IALD.CompilaHornNaFita\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula Codex.HornCross Codex.CrossSelectors\nopen Codex.PolinomioPorEscolha (Letter spell spellClause original weight)\nopen Codex.SparseHornTape (Sym arg args line program)\nvariable {n : Nat}\n\ninductive Phase where | scan | need | save | skip | issue | halt\nderiving DecidableEq, Repr\n\nstructure Cfg where\n  mode : Phase\n  input : List Letter\n  out : List Sym\n  cur : Nat\n  has : Bool\n  saved : Nat\n\ndef step (c : Cfg) : Cfg := match c.mode with\n  | .halt => c\n  | .scan => match c.input with\n    | [] => {c with mode:=.halt}\n    | .tick :: t => {c with input:=t,cur:=c.cur+1}\n    | .sign false :: t => {c with mode:=.need,input:=t}\n    | .sign true :: t =>\n      if c.has then {c with mode:=.skip,input:=t} else {c with mode:=.save,input:=t,has:=true}\n    | .delimiter :: t =>\n      if c.has then {c with mode:=.issue,input:=t}\n      else {c with input:=t,out:=.deny::c.out}\n  | .need => match c.cur with\n    | 0 => {c with mode:=.scan,out:=.need::c.out}\n    | k+1 => {c with cur:=k,out:=.tick::c.out}\n  | .save => match c.cur with\n    | 0 => {c with mode:=.scan}\n    | k+1 => {c with cur:=k,saved:=c.saved+1}\n  | .skip => match c.cur with\n    | 0 => {c with mode:=.scan}\n    | k+1 => {c with cur:=k}\n  | .issue => match c.saved with\n    | 0 => {c with mode:=.scan,has:=false,out:=.setBit::c.out}\n    | k+1 => {c with saved:=k,out:=.tick::c.out}\n\ndef run : Nat → Cfg → Cfg\n  | 0,c => c\n  | k+1,c => run k (step c)\n\ntheorem run_add (k j : Nat) (s : Cfg) : run (k+j) s = run j (run k s) := by\n  induction k generalizing s with\n  | zero => simp [run]\n  | succ k ih => rw [Nat.succ_add]; exact ih _\ntheorem one (s : Cfg) : run 1 s = step s := rfl\n\ndef ready (ip : List Letter) (out : List Sym) (h : Option Nat) : Cfg :=\n  ⟨.scan,ip,out,0,h.isSome,h.getD 0⟩\n\ntheorem ticks (k j : Nat) (ip : List Letter) (out : List Sym) (b : Bool) (z : Nat) :\n    run k ⟨.scan,List.replicate k .tick ++ ip,out,j,b,z⟩ = ⟨.scan,ip,out,j+k,b,z⟩ := by\n  induction k generalizing j with\n  | zero => rfl\n  | succ k ih =>\n    rw [List.replicate_succ]\n    change run k ⟨.scan,List.replicate k .tick ++ ip,out,j+1,b,z⟩ = _\n    rw [ih,show j+1+k=j+(k+1) by omega]\n\ntheorem need_trace (k : Nat) (ip : List Letter) (out : List Sym) (b : Bool) (z : Nat) :\n    run (k+1) ⟨.need,ip,out,k,b,z⟩ =\n      ⟨.scan,ip,.need :: (List.replicate k .tick ++ out),0,b,z⟩ := by\n  induction k generalizing out with\n  | zero => rfl\n  | succ k ih =>\n    change run (k+1) ⟨.need,ip,.tick::out,k,b,z⟩ = _\n    rw [ih,List.replicate_succ']; simp only [List.append_assoc,List.singleton_append]\n\ntheorem save_trace (k z : Nat) (ip : List Letter) (out : List Sym) :\n    run (k+1) ⟨.save,ip,out,k,true,z⟩ = ⟨.scan,ip,out,0,true,z+k⟩ := by\n  induction k generalizing z with\n  | zero => rfl\n  | succ k ih =>\n    change run (k+1) ⟨.save,ip,out,k,true,z+1⟩ = _\n    rw [ih,show z+1+k=z+(k+1) by omega]\n\ntheorem skip_trace (k z : Nat) (ip : List Letter) (out : List Sym) :\n    run (k+1) ⟨.skip,ip,out,k,true,z⟩ = ⟨.scan,ip,out,0,true,z⟩ := by\n  induction k with | zero => rfl | succ k ih => exact ih\n\ntheorem issue_trace (z : Nat) (ip : List Letter) (out : List Sym) :\n    run (z+1) ⟨.issue,ip,out,0,true,z⟩ =\n      ready ip (.setBit :: (List.replicate z .tick ++ out)) none := by\n  induction z generalizing out with\n  | zero => rfl\n  | succ z ih =>\n    change run (z+1) ⟨.issue,ip,.tick::out,0,true,z⟩ = _\n    rw [ih,List.replicate_succ']; simp only [List.append_assoc,List.singleton_append]\n\ndef selectLit (h : Option Nat) (l : Literal n) : Option Nat :=\n  if l.pos then h.or (some l.var.val) else h\ndef bodyLit (l : Literal n) : List Sym := if l.pos then [] else arg l.var .need\n\ntheorem read_lit (l : Literal n) (ip : List Letter) (out : List Sym) (h : Option Nat) :\n    run (2*(spell l).length) (ready (spell l ++ ip) out h) =\n       ready ip ((bodyLit l).reverse ++ out) (selectLit h l) := by\n  obtain ⟨i,b⟩ := l\n  have size : 2*(spell (⟨i,b⟩ : Literal n)).length = i.val + (1+(i.val+1)) := by\n    simp [spell]; omega\n  rw [size,run_add]\n  simp only [ready,spell,List.append_assoc,List.singleton_append,ticks,Nat.zero_add]\n  rw [run_add 1 (i.val+1),one]\n  cases b <;> cases h <;>\n    simp [step,need_trace,skip_trace,save_trace,selectLit,bodyLit,arg]\n\ntheorem read_lits (cs : Clausula n) (ip : List Letter) (out : List Sym) (h : Option Nat) :\n    run (2*(cs.flatMap spell).length) (ready (cs.flatMap spell ++ ip) out h) =\n      ready ip ((cs.flatMap bodyLit).reverse ++ out) (cs.foldl selectLit h) := by\n  induction cs generalizing h out with\n  | nil => rfl\n  | cons l cs ih =>\n    simp only [List.flatMap_cons,List.length_append,Nat.mul_add,List.append_assoc,\n      List.reverse_append,List.foldl_cons]\n    rw [run_add,read_lit,ih]\n\ntheorem body_eq (c : Clausula n) : c.flatMap bodyLit = args (names c false) := by\n  induction c with\n  | nil => rfl\n  | cons l c ih =>\n    rcases l with ⟨i,b⟩\n    cases b <;> simp [bodyLit,names,args] at ih ⊢ <;> exact ih\n\ndef chosen (c : Clausula n) : Rule n := ⟨names c false,(names c true).head?⟩\n\ntheorem select_eq (c : Clausula n) (h : Option Nat) :\n    c.foldl selectLit h = h.or ((chosen c).head.map Fin.val) := by\n  induction c generalizing h with\n  | nil => cases h <;> rfl\n  | cons l c ih =>\n    rcases l with ⟨i,b⟩\n    cases b <;> cases h <;>\n      simp [selectLit,List.foldl_cons,ih,chosen,names]\n\ndef term : Option Nat → List Sym\n  | none => [.deny]\n  | some k => List.replicate k .tick ++ [.setBit]\n\ndef termTime : Option Nat → Nat\n  | none => 1\n  | some k => k+2\n\ntheorem delimiter (h : Option Nat) (ip : List Letter) (out : List Sym) :\n    run (termTime h) (ready (.delimiter :: ip) out h) = ready ip ((term h).reverse ++ out) none := by\n  cases h with\n  | none => rfl\n  | some k =>\n    change run (k+1) ⟨.issue,ip,out,0,true,k⟩ = _\n    rw [issue_trace]\n    simp [term]\n\ntheorem line_term (r : Rule n) :\n    line r = args r.body ++ term (r.head.map Fin.val) := by\n  obtain ⟨xs,h⟩ := r\n  cases h <;> rfl\n\ndef clauseTime (c : Clausula n) :=\n  2*(c.flatMap spell).length + termTime ((chosen c).head.map Fin.val)\n\ntheorem read_clause (c : Clausula n) (ip : List Letter) (out : List Sym) :\n    run (clauseTime c) (ready (spellClause c ++ ip) out none) =\n      ready ip ((line (chosen c)).reverse ++ out) none := by\n  simp only [clauseTime,spellClause,List.append_assoc,List.singleton_append]\n  rw [run_add,read_lits,select_eq]\n  change run _ (ready _ _ ((chosen c).head.map Fin.val)) = _\n  rw [delimiter,line_term,List.reverse_append,List.append_assoc,body_eq]\n  rfl\n\ndef totalTime (p : CNF n) := (p.map clauseTime).sum\n\ntheorem compile (p : CNF n) (ip : List Letter) (out : List Sym) :\n    run (totalTime p) (ready (original p ++ ip) out none) =\n      ready ip ((program (p.map chosen)).reverse ++ out) none := by\n  induction p generalizing out with\n  | nil => rfl\n  | cons c p ih =>\n    change run (clauseTime c + totalTime p) (ready ((spellClause c ++ original p) ++ ip) out none) = _\n    rw [List.append_assoc,run_add,read_clause,ih]\n    change _ = ready ip ((line (chosen c) ++ program (p.map chosen)).reverse ++ out) none\n    rw [List.reverse_append,List.append_assoc]\n\ntheorem chosen_mem (c : Clausula n) : chosen c ∈ alternatives c := by\n  unfold chosen alternatives\n  cases e : names c true <;> simp\n\ntheorem term_bound (c : Clausula n) :\n    termTime ((chosen c).head.map Fin.val) ≤ (c.flatMap spell).length+2 := by\n  have part := Codex.PolinomioPorEscolha.sign_partition c\n  unfold chosen\n  cases h : names c true with\n  | nil => simp [termTime]\n  | cons i is =>\n    have hi : i ∈ names c true := by simp [h]\n    have mem := Codex.PolinomioPorEscolha.weight_member (names c true) i hi\n    change i.val+2 ≤ _\n    omega\n\ntheorem time_bound (p : CNF n) : totalTime p ≤ 3*(original p).length := by\n  induction p with\n  | nil => rfl\n  | cons c p ih =>\n    have t := term_bound c\n    change 2*(c.flatMap spell).length + termTime ((chosen c).head.map Fin.val) + totalTime p ≤\n      3*((spellClause c) ++ original p).length\n    simp only [spellClause,List.length_append,List.length_cons,List.length_nil]\n    omega\n\n/-- Soma dos deslocamentos de entrada, saída e ambas as cabeças auxiliares.\n    O comprimento das listas e as diferenças são medidores, não operações do controle. -/\ndef moves (s t : Cfg) :=\n  Nat.dist s.input.length t.input.length + Nat.dist s.out.length t.out.length +\n    Nat.dist s.cur t.cur + Nat.dist s.saved t.saved\n\ndef travel : Nat → Cfg → Nat | 0,_ => 0 | k+1,c => moves c (step c) + travel k (step c)\n\ntheorem one_step (c : Cfg) : moves c (step c) ≤ 2 := by\n  rcases c with ⟨m,ip,o,i,b,j⟩\n  cases m with\n  | halt => simp [step,moves]\n  | need => cases i <;> simp [step,moves,Nat.dist]\n  | save => cases i <;> simp [step,moves,Nat.dist]\n  | skip => cases i <;> simp [step,moves,Nat.dist]\n  | issue => cases j <;> simp [step,moves,Nat.dist]\n  | scan =>\n    cases ip with\n    | nil => simp [step,moves]\n    | cons a ip => cases a with\n      | tick => simp [step,moves,Nat.dist]\n      | sign v => cases v <;> cases b <;> simp [step,moves,Nat.dist]\n      | delimiter => cases b <;> simp [step,moves,Nat.dist]\n\ntheorem travel_bound (k : Nat) (c : Cfg) : travel k c ≤ 2*k := by\n  induction k generalizing c with\n  | zero => rfl\n  | succ k ih =>\n    change moves c (step c) + travel k (step c) ≤ _\n    have := one_step c\n    have := ih (step c)\n    omega\n\ndef IsHorn (p : CNF n) := ∀ c ∈ p, (names c true).length ≤ 1\n\ntheorem unique_alternative (c : Clausula n) (h : (names c true).length ≤ 1) :\n    alternatives c = [chosen c] := by\n  unfold chosen alternatives\n  cases e : names c true with\n  | nil => rfl\n  | cons i is =>\n    cases is with\n    | nil => rfl\n    | cons j js => simp [e] at h\n\ntheorem horn_select (p : CNF n) (h : IsHorn p) : programs p = [p.map chosen] := by\n  induction p with\n  | nil => rfl\n  | cons c p ih =>\n    have hc := unique_alternative c (h _ List.mem_cons_self)\n    have hp := ih (fun d hd => h d (List.mem_cons_of_mem _ hd))\n    simp [programs,hc,hp]\n\ntheorem semantic (p : CNF n) (h : IsHorn p) :\n    palavraDaFormula ((p.map chosen).map asClause) = palavraDaFormula p := by\n  have sig := selector_word p\n  rw [horn_select p h] at sig\n  rw [← horn_word]\n  change checkProgram (p.map chosen) = palavraDaFormula p\n  cases e : checkProgram (p.map chosen) <;> simpa [scan,e] using sig\n\n/-- A máquina começa com os símbolos de p e quatro cabeças em suas bordas.\n    O resultado da fita de saída, lida na ordem de escrita, é o programa Horn.\n    O limite vale também fora da classe, mas lá se escolhe apenas um candidato. -/\ntheorem physical_compilation (p : CNF n) :\n    let c := ready (original p) [] none\n    let L := (original p).length\n    ∃ T ≤ 3*L+1, travel T c ≤ 2*(3*L+1) ∧ (run T c).mode = .halt ∧\n      (run T c).out.reverse = program (p.map chosen) := by\n  refine ⟨totalTime p+1,Nat.add_le_add_right (time_bound p) 1,?_,?_,?_⟩\n  · exact (travel_bound _ _).trans (Nat.mul_le_mul_left _ (Nat.add_le_add_right (time_bound p) 1))\n  · have h := compile p [] []\n    simp only [List.append_nil] at h\n    rw [run_add, h,one]; rfl\n  · have h := compile p [] []\n    simp only [List.append_nil] at h\n    rw [run_add,h,one]\n    simp [ready,step]\n\n/-- Na troca de controle, a cabeça permanece à direita do último símbolo.\n    A próxima máquina precisa realmente rebobinar a fita que acabou de receber. -/\ndef dock (c : Cfg) : Codex.SparseHornTape.Cfg := ⟨.back,true,false,false,c.out,[],0,∅⟩\n\n/-- Composição dos três traços, partindo da CNF bruta Horn: compila, rebobina,\n    verifica. O orçamento inclui uma transição adicional de troca de controle. -/\ntheorem flat_horn_stages (p : CNF n) (horn : IsHorn p) :\n    let g := ready (original p) [] none\n    let L := (original p).length\n    ∃ K R V, K+1+R+V ≤ 4*L+3+Codex.PolinomioPorEscolha.budget L ∧\n      (run K g).mode = .halt ∧\n      Codex.SparseHornTape.run R (dock (run K g)) = Codex.SparseHornTape.start (p.map chosen) ∅ ∧\n      (Codex.SparseHornTape.run (R+V) (dock (run K g))).mode = .halt (palavraDaFormula p) ∧\n      travel K g + Codex.SparseHornTape.travel (R+V) (dock (run K g)) ≤\n        2*(4*L+3+Codex.PolinomioPorEscolha.budget L) := by\n  let g := ready (original p) [] none\n  let q := p.map chosen\n  let L := (original p).length\n  obtain ⟨K,hK,cm,done,output⟩ := physical_compilation p\n  have rev : (run K g).out = (program q).reverse := by\n    simpa [g,q] using congrArg List.reverse output\n  have back : Codex.SparseHornTape.run ((program q).length+1) (dock (run K g)) =\n      Codex.SparseHornTape.start q ∅ := by\n    unfold dock\n    rw [rev]\n    have h := Codex.SparseHornTape.back_trace (program q).reverse [] (∅ : Finset Nat) true false false\n    simpa [Codex.SparseHornTape.start,Codex.SparseHornTape.written] using h\n  have mem : q ∈ programs p := by rw [horn_select p horn]; simp [q]\n  have len := Codex.PolinomioPorEscolha.selected_length p q mem\n  have bd := Codex.PolinomioPorEscolha.budget_le _ _ len\n  obtain ⟨V,ht,_,hv⟩ := Codex.SparseHornTape.sparse_horn_tape q\n  have vb : V ≤ Codex.PolinomioPorEscolha.budget L := ht.trans bd\n  have kb : K ≤ 3*L+1 := hK\n  have wb : (program q).length ≤ L := len\n  have all : K+1+((program q).length+1)+V ≤ 4*L+3+Codex.PolinomioPorEscolha.budget L := by omega\n  refine ⟨K,(program q).length+1,V,all,done,back,?_,?_⟩\n  · rw [Codex.SparseHornTape.run_add,back,hv,semantic p horn]\n  · have left := travel_bound K g\n    have right := Codex.SparseHornTape.travel_bound ((program q).length+1+V) (dock (run K g))\n    change travel K g + Codex.SparseHornTape.travel ((program q).length+1+V) (dock (run K g)) ≤\n      2*(4*L+3+Codex.PolinomioPorEscolha.budget L)\n    omega\n\nend IALD.CompilaHornNaFita\n",
+    'TGLExt/GuardasNaFita.lean': "import TGLExt.PolinomioPorEscolha\nimport TGLExt.BuscaEmCruzamentos\nimport Mathlib.Tactic.DeriveFintype\n\n/- Leitor de uma passagem sobre a codificação unária original. Guarda somente\n   quatro sinais de contradição, o estado da cláusula atual e um contador\n   saturado de zeros. A ordem interna 0,1 OU 1,0 é admitida. -/\nnamespace IALD.GuardasNaFita\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha (Letter spell spellClause original)\nopen IALD.CruzamentosUniversais (guardClause guards)\n\ninductive Rank where | zero | one | many\nderiving DecidableEq, Fintype, Repr\n\ndef rank : Nat → Rank\n  | 0 => .zero | 1 => .one | _+2 => .many\n\ndef inc : Rank → Rank | .zero => .one | _ => .many\n\ntheorem inc_rank (n : Nat) : inc (rank n) = rank (n+1) := by\n  cases n with | zero => rfl | succ n => cases n <;> rfl\n\ninductive Phase where\n  | empty | firstZero (p : Bool) | firstOne (q : Bool)\n  | both (p q : Bool) | other\nderiving DecidableEq, Fintype, Repr\n\ndef addLit : Phase → Rank → Bool → Phase\n  | .empty,.zero,b => .firstZero b\n  | .empty,.one,b => .firstOne b\n  | .firstZero p,.one,q => .both p q\n  | .firstOne q,.zero,p => .both p q\n  | _,_,_ => .other\n\nstructure Marks where\n  ff : Bool\n  ft : Bool\n  tf : Bool\n  tt : Bool\nderiving DecidableEq, Fintype, Repr\n\ndef blank : Marks := ⟨false,false,false,false⟩\ndef seen (m : Marks) : Bool → Bool → Bool\n  | false,false => m.ff | false,true => m.ft | true,false => m.tf | true,true => m.tt\n\ndef flag (m : Marks) : Option (Bool × Bool) → Marks\n  | some (false,false) => {m with ff:=true}\n  | some (false,true) => {m with ft:=true}\n  | some (true,false) => {m with tf:=true}\n  | some (true,true) => {m with tt:=true}\n  | none => m\n\ndef extract : Phase → Option (Bool × Bool) | .both a b => some (a,b) | _ => none\n\nstructure Registers where\n  phase : Phase\n  count : Rank\n  marks : Marks\nderiving DecidableEq, Fintype, Repr\n\ndef init (m : Marks) : Registers := ⟨.empty,.zero,m⟩\n\ndef next (s : Registers) : Letter → Registers\n  | .tick => {s with count := inc s.count}\n  | .sign b => ⟨addLit s.phase s.count b,.zero,s.marks⟩\n  | .delimiter => init (flag s.marks (if s.count = .zero then extract s.phase else none))\n\ntheorem finite_control : Fintype.card Registers = 480 := by\n  let e : Registers ≃ Phase × Rank × Marks :=\n    ⟨fun s => (s.phase,s.count,s.marks),fun s => ⟨s.1,s.2.1,s.2.2⟩,\n      fun _ => rfl,fun _ => rfl⟩\n  have hp : Fintype.card Phase = 10 := by decide\n  have hr : Fintype.card Rank = 3 := by decide\n  have hm : Fintype.card Marks = 16 := by decide\n  rw [Fintype.card_congr e,Fintype.card_prod,Fintype.card_prod,hp,hr,hm]\n\ndef finish (m : Marks) := m.ff && m.ft && m.tf && m.tt\n\ninductive Machine where | walk (s : Registers) (unread : List Letter) | halt (detected : Bool)\n\ndef step : Machine → Machine\n  | .walk s (c::cs) => .walk (next s c) cs\n  | .walk s [] => .halt (finish s.marks)\n  | .halt b => .halt b\n\ntheorem exact_steps (w : List Letter) (s : Registers) :\n    step^[w.length+1] (.walk s w) = .halt (finish (w.foldl next s).marks) := by\n  induction w generalizing s with\n  | nil => rfl\n  | cons a w ih =>\n    change step^[w.length+1+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\ndef addName {n} (s : Phase) (l : Literal n) := addLit s (rank l.var.val) l.pos\n\ntheorem unary (i : Nat) (p : Phase) (m : Marks) :\n    (List.replicate i Letter.tick).foldl next ⟨p,.zero,m⟩ = ⟨p,rank i,m⟩ := by\n  induction i with\n  | zero => rfl\n  | succ i ih =>\n    rw [List.replicate_succ',List.foldl_append,ih]\n    change Registers.mk p (inc (rank i)) m = _\n    rw [inc_rank]\n\ntheorem literal_read {n} (l : Literal n) (p : Phase) (m : Marks) :\n    (spell l).foldl next ⟨p,.zero,m⟩ = ⟨addName p l,.zero,m⟩ := by\n  simp only [spell,List.foldl_append,unary]; rfl\n\ntheorem read_literals {n} (c : Clausula n) (p : Phase) (m : Marks) :\n    (c.flatMap spell).foldl next ⟨p,.zero,m⟩ = ⟨c.foldl addName p,.zero,m⟩ := by\n  induction c generalizing p with\n  | nil => rfl\n  | cons l c ih => simp only [List.flatMap_cons,List.foldl_append,literal_read,ih,List.foldl_cons]\n\ndef signature {n} : Clausula n → Option (Bool × Bool)\n  | [l,r] =>\n    match rank l.var.val,rank r.var.val with\n    | .zero,.one => some (l.pos,r.pos)\n    | .one,.zero => some (r.pos,l.pos)\n    | _,_ => none\n  | _ => none\n\ntheorem other_absorbs {n} (cs : Clausula n) : cs.foldl addName .other = .other := by\n  induction cs with\n  | nil => rfl\n  | cons a cs ih => exact ih\n\ntheorem parse_signature {n} (c : Clausula n) :\n    extract (c.foldl addName .empty) = signature c := by\n  rcases c with _ | ⟨a,as⟩\n  · rfl\n  rcases as with _ | ⟨b,bs⟩\n  · cases e : rank a.var.val <;> simp [List.foldl,addName,e,addLit,extract,signature]\n  rcases bs with _ | ⟨c,cs⟩\n  · cases e : rank a.var.val <;> cases f : rank b.var.val <;>\n      simp [List.foldl,addName,e,f,addLit,extract,signature]\n  · cases e : rank a.var.val <;> cases f : rank b.var.val <;>\n      simp [addName,e,f,addLit,other_absorbs,extract,signature]\n\ntheorem clause_read {n} (c : Clausula n) (m : Marks) :\n    (spellClause c).foldl next (init m) = init (flag m (signature c)) := by\n  simp only [spellClause,init,List.foldl_append,read_literals,List.foldl_cons,List.foldl_nil,next,\n    if_true,parse_signature]\n\ndef collect {n} (p : CNF n) (m : Marks) := p.foldl (fun s c => flag s (signature c)) m\n\ntheorem tape_read {n} (p : CNF n) (m : Marks) :\n    (original p).foldl next (init m) = init (collect p m) := by\n  induction p generalizing m with\n  | nil => rfl\n  | cons c p ih =>\n    change (spellClause c ++ original p).foldl next _ = _\n    rw [List.foldl_append,clause_read,ih]; rfl\n\ntheorem flag_spec (m : Marks) (v : Option (Bool × Bool)) (a b : Bool) :\n    seen (flag m v) a b = true ↔ seen m a b = true ∨ v = some (a,b) := by\n  rcases v with _ | ⟨x,y⟩\n  · simp [flag]\n  · cases x <;> cases y <;> cases a <;> cases b <;> simp [seen,flag]\n\ntheorem collect_spec {n} (p : CNF n) (m : Marks) (a b : Bool) :\n    seen (collect p m) a b = true ↔ seen m a b = true ∨ ∃ c ∈ p, signature c = some (a,b) := by\n  induction p generalizing m with\n  | nil => simp [collect]\n  | cons c p ih =>\n    change seen (collect p (flag m (signature c))) a b = true ↔ _\n    rw [ih,flag_spec]\n    simp only [List.mem_cons]\n    grind\n\ndef detects {n} (p : CNF n) := finish (collect p blank)\n\ntheorem detect_exact {n} (p : CNF n) :\n    detects p = true ↔ ∀ a b, ∃ c ∈ p, signature c = some (a,b) := by\n  have test (a b : Bool) : seen (collect p blank) a b = true ↔\n      ∃ c ∈ p, signature c = some (a,b) := by\n    rw [collect_spec]; cases a <;> cases b <;> simp [seen,blank]\n  constructor\n  · intro h a b\n    have hs : ((seen (collect p blank) false false = true ∧ seen (collect p blank) false true = true)\n      ∧ seen (collect p blank) true false = true) ∧ seen (collect p blank) true true = true := by\n      simpa only [detects,finish,Bool.and_eq_true,seen] using h\n    cases a <;> cases b\n    · exact (test _ _).mp hs.1.1.1\n    · exact (test _ _).mp hs.1.1.2\n    · exact (test _ _).mp hs.1.2\n    · exact (test _ _).mp hs.2\n  · intro h\n    simp only [detects,finish,Bool.and_eq_true]\n    exact ⟨⟨⟨(test false false).mpr (h _ _),(test false true).mpr (h _ _)⟩,\n      (test true false).mpr (h _ _)⟩,(test true true).mpr (h _ _)⟩\n\ntheorem tape_detects {n} (p : CNF n) :\n    step^[(original p).length+1] (.walk (init blank) (original p)) = .halt (detects p) := by\n  rw [exact_steps,tape_read]; rfl\n\ndef atName {n} (x : Fin n → Bool) (k : Nat) : Bool := if h : k < n then x ⟨k,h⟩ else false\n\ntheorem at_index {n} (x : Fin n → Bool) (i : Fin n) : atName x i.val = x i := by\n  simp [atName,i.isLt]\n\ntheorem coords (k : Nat) : (rank k = .zero ↔ k=0) ∧ (rank k = .one ↔ k=1) := by\n  cases k with | zero => decide | succ k => cases k <;> simp [rank]\n\ntheorem signature_sat {n} (c : Clausula n) (a b : Bool) (x : Fin n → Bool)\n    (hs : signature c = some (a,b)) (hx : satisfeita c x = true) :\n    atName x 0 = a ∨ atName x 1 = b := by\n  rcases c with _ | ⟨l,ls⟩\n  · contradiction\n  rcases ls with _ | ⟨r,rs⟩\n  · contradiction\n  rcases rs with _ | ⟨s,ss⟩\n  · cases e : rank l.var.val <;> cases f : rank r.var.val <;> simp [signature,e,f] at hs\n    · have hl := (coords _).1.mp e\n      have hr := (coords _).2.mp f\n      have h₀ : atName x 0 = x l.var := hl ▸ at_index x l.var\n      have h₁ : atName x 1 = x r.var := hr ▸ at_index x r.var\n      simpa [satisfeita,Literal.vale,h₀,h₁,← hs.1,← hs.2] using hx\n    · have hl := (coords _).2.mp e\n      have hr := (coords _).1.mp f\n      have h₀ : atName x 0 = x r.var := hr ▸ at_index x r.var\n      have h₁ : atName x 1 = x l.var := hl ▸ at_index x l.var\n      simpa [satisfeita,Literal.vale,h₀,h₁,← hs.1,← hs.2,or_comm] using hx\n  · contradiction\n\ntheorem detection_safe {n} (p : CNF n) (h : detects p = true) : ¬ SAT p := by\n  rintro ⟨x,hx⟩\n  obtain ⟨c,hc,hs⟩ := (detect_exact p).mp h (!(atName x 0)) (!(atName x 1))\n  have bad := signature_sat c _ _ x hs (hx c hc)\n  cases h₀ : atName x 0 <;> cases h₁ : atName x 1 <;> simp [h₀,h₁] at bad\n\ntheorem detects_family (n : Nat) : detects (IALD.BuscaEmCruzamentos.family n) = true := by\n  apply (detect_exact _).mpr\n  intro p q\n  have guards_mem (c : Clausula (IALD.CruzamentosUniversais.width n)) (h : c ∈ guards n) :\n      c ∈ IALD.BuscaEmCruzamentos.family n := List.mem_append_right _ h\n  cases p <;> cases q\n  · exact ⟨guardClause n false false,guards_mem _ (by simp [guards]),rfl⟩\n  · exact ⟨guardClause n false true,guards_mem _ (by simp [guards]),rfl⟩\n  · exact ⟨guardClause n true false,guards_mem _ (by simp [guards]),rfl⟩\n  · refine ⟨IALD.CruzamentosUniversais.pad ([] : Clausula n),?_,rfl⟩\n    apply List.mem_append_left\n    exact List.mem_cons_self\n\ntheorem family_steps (n : Nat) :\n    let p := IALD.BuscaEmCruzamentos.family n\n    step^[(original p).length+1] (.walk (init blank) (original p)) = .halt true := by\n  dsimp only\n  rw [tape_detects,detects_family]\n\nend IALD.GuardasNaFita\n",
+    'TGLExt/PontePalavraVerbo.lean': "import TGLExt.LeitorDaFormula\nimport TGLExt.OPsibitEACompressao\n\nnamespace IALD.PontePalavraVerbo\nopen TGLExt.TraducaoTuring TGLExt.Psibit TGLExt.OPsibitEACompressao\nopen IALD.LeitorDaFormula\n\n/-- Há na cláusula um literal e o seu oposto. As duas buscas só percorrem a cláusula. -/\ndef oppositePair {n : ℕ} (c : Clausula n) : Bool :=\n  c.any (fun l => c.any (fun k => k.var == l.var && k.pos != l.pos))\n\ndef avoiding {n : ℕ} (c : Clausula n) (i : Fin n) : Bool :=\n  c.any (fun k => k.var == i && !k.pos)\n\ntheorem oppositePair_spec {n : ℕ} (c : Clausula n) :\n    oppositePair c = true ↔ ∀ x, satisfeita c x = true := by\n  constructor\n  · intro h x\n    obtain ⟨l,hl,hk⟩ := List.any_eq_true.mp h\n    obtain ⟨k,hk',hm⟩ := List.any_eq_true.mp hk\n    have hp : k.var = l.var ∧ k.pos ≠ l.pos := by simpa using hm\n    apply List.any_eq_true.mpr\n    by_cases hx : x l.var = l.pos\n    · exact ⟨l,hl,by simp [Literal.vale,hx]⟩\n    · refine ⟨k,hk',?_⟩\n      simp only [Literal.vale, hp.1, beq_iff_eq]\n      have hn := hp.2\n      cases h₁ : l.pos <;> cases h₂ : k.pos <;> cases h₃ : x l.var <;> simp_all\n  · intro h\n    obtain ⟨l,hl,hv⟩ := List.any_eq_true.mp (h (avoiding c))\n    cases hp : l.pos with\n    | false =>\n      have ht : avoiding c l.var = true := List.any_eq_true.mpr ⟨l,hl,by simp [hp]⟩\n      simp [Literal.vale, hp, ht] at hv\n    | true =>\n      have ht : avoiding c l.var = true := by simpa [Literal.vale,hp] using hv\n      obtain ⟨k,hk,hv'⟩ := List.any_eq_true.mp ht\n      apply List.any_eq_true.mpr\n      refine ⟨l,hl,List.any_eq_true.mpr ⟨k,hk,?_⟩⟩\n      simpa [hp] using hv'\n\ndef quiet {n : ℕ} (f : CNF n) : Bool := f.all oppositePair\n\ntheorem quiet_update {n : ℕ} (f : CNF n) (c : Clausula n) :\n    quiet (c :: f) = (oppositePair c && quiet f) := rfl\n\ntheorem quiet_spec {n : ℕ} (f : CNF n) (s : ℝ) :\n    quiet f = true ↔ verboCalado (custoCNF f) s := by\n  rw [o_verbo_cala_sse_tudo_e_nome]\n  simp only [quiet, List.all_eq_true, oppositePair_spec, custoCNF_zero_sse]\n  constructor\n  · intro h x c hc; exact h c hc x\n  · intro h c hc x; exact h x c hc\n\n/-- Os dois bits de `OPsibitEACompressao` calculados da sintaxe. -/\ndef bits {n : ℕ} (f : CNF n) : Bool × Bool := (solve n f, quiet f)\n\n/-- Uma leitura sem máscara e uma por coordenada, obtidas inteiramente da sintaxe. -/\ndef syntaxRead {n : ℕ} (f : CNF n) (j : Option (Fin n)) : Bool :=\n  match j with\n  | none => solve n f\n  | some i => solve n ([⟨i,true⟩] :: f)\n\ntheorem syntax_recovers_unique {n : ℕ} (f : CNF n) (x : Fin n → Bool)\n    (hx : passes f x = true) (unique : ∀ z, passes f z = true → z = x) :\n    syntaxRead f none = true ∧ (fun i => syntaxRead f (some i)) = x := by\n  constructor\n  · exact (solve_spec n f).2 ((sat_iff f).2 ⟨x,hx⟩)\n  · funext i\n    apply Bool.eq_iff_iff.mpr\n    change solve n ([⟨i,true⟩] :: f) = true ↔ x i = true\n    rw [solve_spec, sat_iff]\n    constructor\n    · rintro ⟨z,hz⟩\n      change (satisfeita [⟨i,true⟩] z && passes f z) = true at hz\n      rw [Bool.and_eq_true] at hz\n      obtain ⟨bit,rest⟩ := hz\n      simpa [satisfeita, Literal.vale, unique z rest] using bit\n    · intro hi\n      refine ⟨x, ?_⟩\n      change (satisfeita [⟨i,true⟩] x && passes f x) = true\n      simp [satisfeita, Literal.vale, hi, hx]\n\ntheorem bits_spec {n : ℕ} (f : CNF n) (s : ℝ) (hs : (n:ℝ)*Real.log 2 < s) :\n    ((bits f).1 = true ↔ palavra (custoCNF f) s) ∧\n    ((bits f).2 = true ↔ verboCalado (custoCNF f) s) :=\n  ⟨(solve_spec n f).trans (a_palavra_decide n hs f), quiet_spec f s⟩\n\n/-- Representação dos bits como sinais da órbita; o ângulo é um representante.\n    Esta convenção não identifica a derivada de uma órbita com a da partição. -/\ntheorem bits_on_orbit {n : ℕ} (f : CNF n) (s : ℝ) (hs : (n:ℝ)*Real.log 2 < s) :\n    ∃ θ : ℝ, ((codeAmp θ).word = 1 ↔ palavra (custoCNF f) s) ∧\n      ((codeAmp θ).verb = 1 ↔ verboCalado (custoCNF f) s) ∧\n      decodeAmp (codeAmp θ) = v θ := by\n  have nz (b : Bool) : bitSign b ≠ 0 := by cases b <;> decide\n  have decode (b : Bool) : bitSign b = 1 ↔ b = true := by cases b <;> decide\n  obtain ⟨θ,hw,hv⟩ := the_orbit_visits_all_four_states _ _ (nz (bits f).1) (nz (bits f).2)\n  obtain ⟨h₀,h₁⟩ := bits_spec f s hs\n  refine ⟨θ, ?_, ?_, decodeAmp_codeAmp θ⟩\n  · rw [hw]; exact (decode _).trans h₀\n  · rw [hv]; exact (decode _).trans h₁\n\ndef unitClause (p : Bool) : Clausula 1 := [⟨0,p⟩]\n\n/-- Mesmo par antes, Palavra diferente depois da mesma cláusula. -/\ntheorem bits_alone_not_updatable :\n    ¬ ∃ u : (Bool × Bool) → Clausula 1 → Bool × Bool,\n      ∀ (f : CNF 1) c, u (bits f) c = bits (c :: f) := by\n  rintro ⟨u,hu⟩\n  have h₁ := hu [unitClause true] (unitClause true)\n  have h₂ := hu [unitClause false] (unitClause true)\n  have e : bits [unitClause true] = bits [unitClause false] := by decide\n  rw [e] at h₁\n  have bad : bits [unitClause true,unitClause true] ≠ bits [unitClause true,unitClause false] := by decide\n  exact bad (h₁.symm.trans h₂)\n\nend IALD.PontePalavraVerbo\n",
+    'TGLExt/FitaComCusto.lean': "import TGLExt.PontePalavraVerbo\nimport TGLExt.OResumoEPsiBit\n\n/- Uma fita de alfabeto fixo para cadeias de relações booleanas com uma\n   cláusula global positiva em cada ponta. Cada símbolo contém a máscara de\n   quatro bits de uma relação dada; nenhum símbolo contém a resposta da cadeia. -/\nnamespace IALD.FitaComCusto\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\n\n/-- Os quatro bits são as quatro entradas de uma tabela binária. -/\nstructure Mask where\n  ff : Bool\n  ft : Bool\n  tf : Bool\n  tt : Bool\nderiving DecidableEq, Repr\n\ndef Mask.read (m : Mask) : Bool → Bool → Bool\n  | false, false => m.ff\n  | false, true => m.ft\n  | true, false => m.tf\n  | true, true => m.tt\n\ndef Mask.tab (f : Bool → Bool → Bool) : Mask :=\n  ⟨f false false, f false true, f true false, f true true⟩\n\n@[simp] theorem read_tab (f : Bool → Bool → Bool) (a b : Bool) :\n    (Mask.tab f).read a b = f a b := by cases a <;> cases b <;> rfl\n\n/-- Se a atribuição toma precisamente (a,b), a cláusula que proíbe (a,b) é falsa. -/\ndef ban {k : Nat} (a b : Bool) : Clausula (k+2) := [⟨0,!a⟩, ⟨1,!b⟩]\n\ndef look (r : Mask) : List (Bool × Bool) :=\n  [(false,false),(false,true),(true,false),(true,true)].filter\n    (fun p => !(r.read p.1 p.2))\n\ndef edgeCNF {k : Nat} (r : Mask) : CNF (k+2) :=\n  (look r).map (fun p => ban p.1 p.2)\n\ntheorem edge_spec {k : Nat} (r : Mask) (x : Fin (k+2) → Bool) :\n    passes (edgeCNF r) x = r.read (x 0) (x 1) := by\n  obtain ⟨a,b,c,d⟩ := r\n  cases a <;> cases b <;> cases c <;> cases d <;>\n    cases hx : x 0 <;> cases hy : x 1 <;>\n    simp [passes, edgeCNF, look, ban, Mask.read, satisfeita, Literal.vale, hx, hy]\n\ndef liftLit {n : Nat} (l : Literal n) : Literal (n+1) := ⟨l.var.succ,l.pos⟩\n\ndef liftCNF {n : Nat} (f : CNF n) : CNF (n+1) :=\n  f.map (fun c => c.map liftLit)\n\n@[simp] theorem lift_spec {n : Nat} (f : CNF n) (x : Fin (n+1) → Bool) :\n    passes (liftCNF f) x = passes f (fun i => x i.succ) := by\n  simp [passes, liftCNF, List.all_map, Function.comp_def, satisfeita, List.any_map,\n    Literal.vale, liftLit]\n\ndef chain : (es : List Mask) → CNF (es.length+1)\n  | [] => []\n  | e :: es => edgeCNF e ++ liftCNF (chain es)\n\ndef someTrue {n : Nat} : Clausula n := (List.finRange n).map (fun i => ⟨i,true⟩)\n\ntheorem global_spec {n : Nat} (x : Fin n → Bool) :\n    satisfeita someTrue x = true ↔ ∃ i, x i = true := by\n  simp [satisfeita, someTrue, List.any_eq_true, Literal.vale, List.mem_finRange]\n\ndef formula (es : List Mask) : CNF (es.length+1) :=\n  [someTrue] ++ chain es ++ [someTrue]\n\n/-- Com as duas cláusulas globais, até a primeira fronteira contém toda variável. -/\ntheorem full_frontier (es : List Mask) :\n    TGLExt.OResumoEPsiBit.fronteira (formula es) 1 = Finset.univ := by\n  classical\n  have hv : TGLExt.OResumoEPsiBit.varsClausula (@someTrue (es.length+1)) = Finset.univ := by\n    ext i\n    simp [TGLExt.OResumoEPsiBit.varsClausula, someTrue, List.mem_finRange]\n  have hp : (formula es).take 1 = [someTrue] := rfl\n  have ht : (formula es).drop 1 = chain es ++ [someTrue] := rfl\n  unfold TGLExt.OResumoEPsiBit.fronteira\n  rw [hp, ht]\n  ext i\n  have hs : i ∈ TGLExt.OResumoEPsiBit.varsClausula (@someTrue (es.length+1)) := by simp [hv]\n  simp only [Finset.mem_inter, Finset.mem_univ, iff_true]\n  exact ⟨TGLExt.OResumoEPsiBit.mem_varsDas_of_mem (by simp) hs,\n    TGLExt.OResumoEPsiBit.mem_varsDas_of_mem (by simp) hs⟩\n\n/-- Invariante de sufixo: a é o valor da primeira variável, seen registra\n    se o prefixo anterior já continha um valor verdadeiro. -/\ndef Good (es : List Mask) (a seen : Bool) : Prop :=\n  ∃ x : Fin (es.length+1) → Bool, x 0 = a ∧ passes (chain es) x = true ∧\n    (seen = true ∨ ∃ i, x i = true)\n\ntheorem good_nil (a seen : Bool) : Good [] a seen ↔ seen = true ∨ a = true := by\n  constructor\n  · rintro ⟨x,h,_,h' | ⟨i,hi⟩⟩\n    · exact Or.inl h'\n    · have hzero : i = 0 := by\n        apply Fin.ext\n        have lim := i.isLt\n        change i.val < 1 at lim\n        change i.val = 0\n        omega\n      exact Or.inr (by simpa [hzero,h] using hi)\n  · intro h\n    refine ⟨fun _ => a, rfl,rfl,?_⟩\n    exact h.imp_right (fun p => ⟨0,p⟩)\n\ntheorem passes_cons_chain (e : Mask) (es : List Mask)\n    (x : Fin ((e :: es).length+1) → Bool) :\n    passes (chain (e::es)) x =\n      (e.read (x 0) (x 1) && passes (chain es) (fun i => x i.succ)) := by\n  change passes (edgeCNF e ++ liftCNF (chain es)) x = _\n  have split (g h : CNF (es.length+2)) :\n      passes (g++h) x = (passes g x && passes h x) := List.all_append\n  rw [split, edge_spec, lift_spec]\n\ntheorem good_cons (e : Mask) (es : List Mask) (a seen : Bool) :\n    Good (e::es) a seen ↔ ∃ b, e.read a b = true ∧ Good es b (seen || a) := by\n  constructor\n  · rintro ⟨x,hx,hc,hs⟩\n    rw [passes_cons_chain, Bool.and_eq_true, hx] at hc\n    refine ⟨x 1,hc.1,fun i => x i.succ,rfl,hc.2,?_⟩\n    rcases hs with hs | ⟨i,hi⟩\n    · exact Or.inl (by simp [hs])\n    · cases i using Fin.cases with\n      | zero => exact Or.inl (by simp [← hx,hi])\n      | succ j => exact Or.inr ⟨j,hi⟩\n  · rintro ⟨b,hr,x,hx,hc,hs⟩\n    refine ⟨Fin.cases a x,rfl,?_,?_⟩\n    · rw [passes_cons_chain]\n      change (e.read a (x 0) && passes (chain es) x) = true\n      simp [hx,hr,hc]\n    · rcases hs with hs | ⟨i,hi⟩\n      · have either : seen = true ∨ a = true := by simpa using hs\n        rcases either with h | h\n        · exact Or.inl h\n        · exact Or.inr ⟨0,h⟩\n      · exact Or.inr ⟨i.succ,hi⟩\n\ndef base : Mask := Mask.tab (fun a seen => seen || a)\n\ndef advance (r s : Mask) : Mask := Mask.tab (fun a seen =>\n  (r.read a false && s.read false (seen || a)) ||\n  (r.read a true && s.read true (seen || a)))\n\ndef summary (es : List Mask) := es.foldr advance base\n\ntheorem summary_spec (es : List Mask) (a seen : Bool) :\n    (summary es).read a seen = true ↔ Good es a seen := by\n  induction es generalizing a seen with\n  | nil => simp [summary,base,good_nil]\n  | cons e es ih =>\n    change (advance e (summary es)).read a seen = true ↔ _\n    simp only [advance,read_tab,Bool.or_eq_true,Bool.and_eq_true,ih,good_cons]\n    constructor\n    · rintro (h | h)\n      · exact ⟨false,h⟩\n      · exact ⟨true,h⟩\n    · rintro ⟨_ | _,h⟩\n      · exact Or.inl h\n      · exact Or.inr h\n\ndef finish (s : Mask) := s.read false false || s.read true false\n\ntheorem finish_spec (es : List Mask) : finish (summary es) = true ↔ SAT (formula es) := by\n  rw [finish,Bool.or_eq_true,summary_spec,summary_spec,sat_iff]\n  have H (x : Fin (es.length+1) → Bool) : passes (formula es) x = true ↔\n      passes (chain es) x = true ∧ ∃ i, x i = true := by\n    simp [formula, passes, List.all_append,Bool.and_eq_true,global_spec,and_comm]\n  simp only [Good,Bool.false_eq_true,false_or,H]\n  constructor\n  · rintro (⟨x,_,hx⟩ | ⟨x,_,hx⟩) <;> exact ⟨x,hx⟩\n  · rintro ⟨x,hx⟩\n    cases h : x 0\n    · exact Or.inl ⟨x,h,hx⟩\n    · exact Or.inr ⟨x,h,hx⟩\n\n/-- Semântica de pequenos passos de uma máquina de leitura unidirecional:\n    a cabeça avança uma célula por passo e pára ao ler o branco. A metade\n    já atravessada pode ser omitida porque a cabeça nunca retorna. -/\ninductive Machine where\n  | scanning (state : Mask) (unread : List Mask)\n  | halted (answer : Bool)\nderiving Repr\n\ndef step : Machine → Machine\n  | .scanning s (e :: es) => .scanning (advance e s) es\n  | .scanning s [] => .halted (finish s)\n  | .halted ans => .halted ans\n\ntheorem exact_steps (cells : List Mask) (s : Mask) :\n    step^[cells.length+1] (.scanning s cells) =\n      .halted (finish (cells.foldl (fun q e => advance e q) s)) := by\n  induction cells generalizing s with\n  | nil => rfl\n  | cons e es ih =>\n    change step^[es.length+1+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\n/-- A fita tem uma máscara por aresta (da direita para a esquerda), seguida\n    de branco. Uma consulta à tabela finita de transição é um passo da cabeça.\n    Leitura final com t acima do limiar pago da Palavra de `OPsibitEACompressao`. -/\ntheorem tape_reads_word (es : List Mask) (t : ℝ)\n    (ht : ((es.length+1 : Nat) : ℝ) * Real.log 2 < t) :\n    ∃ ans, step^[es.length+1] (.scanning base es.reverse) = .halted ans ∧\n      (ans = true ↔ TGLExt.OPsibitEACompressao.palavra (custoCNF (formula es)) t) := by\n  refine ⟨finish (summary es),?_,(finish_spec es).trans\n    (TGLExt.OPsibitEACompressao.a_palavra_decide _ ht _)⟩\n  simpa [summary, Function.flip_def] using exact_steps es.reverse base\n\n/-- Sintaxe de entrada por cláusula local. O símbolo ban a b é a cláusula\n    binária (Xᵢ ≠ a ∨ Xᵢ₊₁ ≠ b), com índices relativos à aresta atual.\n    Uma sequência de positive representa, em ordem, os literais da cláusula\n    global. As garantias são sobre fitas bem formadas emitidas por rawTape. -/\ninductive Mark where\n  | ban (a b : Bool)\n  | closeEdge\n  | positive\n  | closeGlobal\nderiving DecidableEq, Repr\n\ndef allAllowed : Mask := ⟨true,true,true,true⟩\n\ndef forbid (a b : Bool) (m : Mask) := Mask.tab (fun x y =>\n  m.read x y && !((a == x) && (b == y)))\n\ndef erasePair (m : Mask) (p : Bool × Bool) := forbid p.1 p.2 m\n\ndef edgeMask (ps : List (Bool × Bool)) := ps.foldl erasePair allAllowed\n\ntheorem erasePair_spec (ps : List (Bool × Bool)) (m : Mask) (x y : Bool) :\n    (ps.foldl erasePair m).read x y = true ↔\n    m.read x y = true ∧ (x,y) ∉ ps := by\n  induction ps generalizing m with\n  | nil => simp\n  | cons p ps ih =>\n    obtain ⟨a,b⟩ := p\n    simp only [List.foldl_cons,ih,erasePair,forbid,read_tab,Bool.and_eq_true]\n    cases a <;> cases b <;> cases x <;> cases y <;> simp\n\nstructure Registers where\n  feasible : Mask\n  allowed : Mask\n\ndef readMark (st : Registers) : Mark → Registers\n  | .ban a b => ⟨st.feasible, forbid a b st.allowed⟩\n  | .closeEdge => ⟨advance st.allowed st.feasible, allAllowed⟩\n  | .positive | .closeGlobal => st\n\ndef block (ps : List (Bool × Bool)) : List Mark :=\n  ps.map (fun p => Mark.ban p.1 p.2) ++ [.closeEdge]\n\ntheorem read_block (ps : List (Bool × Bool)) (s : Mask) :\n    (block ps).foldl readMark ⟨s,allAllowed⟩ = ⟨advance (edgeMask ps) s,allAllowed⟩ := by\n  have H (qs : List (Bool × Bool)) (z : Registers) :\n      (qs.map (fun p => Mark.ban p.1 p.2)).foldl readMark z =\n      ⟨z.feasible,qs.foldl erasePair z.allowed⟩ := by\n    induction qs generalizing z with\n    | nil => cases z; rfl\n    | cons p qs ih => exact ih _\n  simp only [block,List.foldl_append,H,List.foldl_cons,List.foldl_nil,edgeMask]\n  rfl\n\ndef chunk (n : Nat) := List.replicate n Mark.positive ++ [.closeGlobal]\n\ntheorem read_chunk (n : Nat) (z : Registers) : (chunk n).foldl readMark z = z := by\n  have h (k : Nat) : (List.replicate k Mark.positive).foldl readMark z = z := by\n    induction k with\n    | zero => rfl\n    | succ k ih => simpa [List.replicate_succ,readMark] using ih\n  simp [chunk,h,readMark]\n\ndef rawTape (edges : List (List (Bool × Bool))) : List Mark :=\n  chunk (edges.length+1) ++ edges.reverse.flatMap block ++ chunk (edges.length+1)\n\ntheorem scan_raw (edges : List (List (Bool × Bool))) :\n    (rawTape edges).foldl readMark ⟨base,allAllowed⟩ =\n      ⟨summary (edges.map edgeMask),allAllowed⟩ := by\n  have h (ls : List (List (Bool × Bool))) (s : Mask) :\n      (ls.flatMap block).foldl readMark ⟨s,allAllowed⟩ =\n       ⟨(ls.map edgeMask).foldl (fun q e => advance e q) s,allAllowed⟩ := by\n    induction ls generalizing s with\n    | nil => rfl\n    | cons p ps ih =>\n      simp only [List.flatMap_cons,List.foldl_append,read_block,List.map_cons,List.foldl_cons]\n      exact ih _\n  simp [rawTape,read_chunk,h,List.map_reverse,summary]\n\ninductive RawMachine where\n  | scanning (state : Registers) (unread : List Mark)\n  | halted (answer : Bool)\n\ndef rawStep : RawMachine → RawMachine\n  | .scanning s (c :: cs) => .scanning (readMark s c) cs\n  | .scanning s [] => .halted (finish s.feasible)\n  | .halted b => .halted b\n\ntheorem raw_steps (cs : List Mark) (s : Registers) :\n    rawStep^[cs.length+1] (.scanning s cs) =\n       .halted (finish (cs.foldl readMark s).feasible) := by\n  induction cs generalizing s with\n  | nil => rfl\n  | cons c cs ih =>\n    change rawStep^[cs.length+1+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\n/-- Custo na fita escrita em cláusulas, sem fornecer a tabela de cada aresta.\n    O comprimento é contado em símbolos de um alfabeto finito fixo. -/\ntheorem clause_tape_reads_word (edges : List (List (Bool × Bool))) (t : ℝ)\n    (ht : ((edges.length+1 : Nat) : ℝ) * Real.log 2 < t) :\n    ∃ ans, rawStep^[(rawTape edges).length+1] (.scanning ⟨base,allAllowed⟩ (rawTape edges)) =\n      .halted ans ∧ (ans = true ↔\n        TGLExt.OPsibitEACompressao.palavra (custoCNF (formula (edges.map edgeMask))) t) := by\n  refine ⟨finish (summary (edges.map edgeMask)),?_, (finish_spec _).trans\n    (TGLExt.OPsibitEACompressao.a_palavra_decide _ (by simpa using ht) _)⟩\n  rw [raw_steps,scan_raw]\n\ntheorem boundary_cell_count (es : List Mask) :\n    Fintype.card (↥(TGLExt.OResumoEPsiBit.fronteira (formula es) 1) → Bool) =\n      2 ^ (es.length+1) := by\n  rw [TGLExt.OResumoEPsiBit.a_fronteira_tem_duas_elevado_as_celulas,full_frontier,\n    Finset.card_univ,Fintype.card_fin]\n\n/-- Para cada valor do indicador histórico a tabela possui exatamente o par\n    de sinais realizável pelos dois canais do PsiBit. O leitor discreto da\n    fita acima não exige construir ou aproximar um ângulo real. -/\ntheorem feasible_pair_on_orbit (es : List Mask) (seen : Bool) :\n    ∃ θ : ℝ,\n      ((TGLExt.Psibit.codeAmp θ).word = 1 ↔ Good es false seen) ∧\n      ((TGLExt.Psibit.codeAmp θ).verb = 1 ↔ Good es true seen) := by\n  have nz (b : Bool) : bitSign b ≠ 0 := by cases b <;> decide\n  have sign (b : Bool) : bitSign b = 1 ↔ b = true := by cases b <;> decide\n  obtain ⟨θ,h₀,h₁⟩ := TGLExt.Psibit.the_orbit_visits_all_four_states _ _\n    (nz ((summary es).read false seen)) (nz ((summary es).read true seen))\n  refine ⟨θ,?_,?_⟩\n  · rw [h₀,sign,summary_spec]\n  · rw [h₁,sign,summary_spec]\n\ntheorem raw_prefix (pre rest : List Mark) (s : Registers) :\n    rawStep^[pre.length] (.scanning s (pre ++ rest)) =\n      .scanning (pre.foldl readMark s) rest := by\n  induction pre generalizing s with\n  | nil => rfl\n  | cons c cs ih =>\n    change rawStep^[cs.length+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\n/-- Mesmo comprimento, mesma fronteira cheia. Na primeira instância a aresta\n    só admite (0,0) e conflita com a cláusula global. Na segunda só admite\n    (0,1), o que satisfaz a cláusula global. -/\ntheorem mixed_examples :\n    ¬ SAT (formula [⟨true,false,false,false⟩]) ∧\n      SAT (formula [⟨false,true,false,false⟩]) := by\n  constructor\n  · rw [← finish_spec]\n    decide\n  · rw [← finish_spec]\n    decide\n\nend IALD.FitaComCusto\n",
+    'TGLExt/CadeiasDeBolsas.lean': 'import TGLExt.PontePalavraVerbo\nimport Mathlib.Tactic.DeriveFintype\nimport TGLExt.FitaComCusto\n\n/-\nA largura k conta as variáveis compartilhadas. Uma bolsa contém k+1 variáveis\nconsecutivas e qualquer número de cláusulas, de qualquer comprimento, inclusive\nvazias. A entrada usa índices relativos, sinal, fim de cláusula e deslocamento.\nA máquina varre as bolsas da última para a primeira. Para k fixo, o alfabeto\ne a tabela de transições são finitos e independem do comprimento da fita.\n-/\nnamespace IALD.CadeiasDeBolsas\nopen TGLExt.TraducaoTuring TGLExt.OPsibitEACompressao IALD.LeitorDaFormula\n\nabbrev Row (k : Nat) := Fin k → Bool\nabbrev Bag (k : Nat) := CNF (k+1)\n\ndef rows : (k : Nat) → List (Row k)\n  | 0 => [Fin.elim0]\n  | k+1 => (rows k).flatMap fun u => [Fin.cases false u, Fin.cases true u]\n\ntheorem complete_rows {k : Nat} (u : Row k) : u ∈ rows k := by\n  induction k with\n  | zero =>\n    have e : u = Fin.elim0 := funext (fun i => Fin.elim0 i)\n    simp [rows,e]\n  | succ k ih =>\n    have e : u = Fin.cases (u 0) (fun i => u i.succ) := by\n      funext j\n      cases j using Fin.cases <;> rfl\n    apply List.mem_flatMap.mpr\n    refine ⟨fun i => u i.succ,ih _,?_⟩\n    cases h : u 0\n    · exact List.mem_cons.mpr (Or.inl (by simpa [h] using e))\n    · exact List.mem_cons.mpr (Or.inr (List.mem_cons.mpr (Or.inl (by simpa only [h] using e))))\n\ndef prefixRow {k : Nat} (w : Row (k+1)) : Row k := fun i => w i.castSucc\ndef suffixRow {k : Nat} (w : Row (k+1)) : Row k := fun i => w i.succ\n\ndef agree {k : Nat} (u v : Row k) : Bool := (List.finRange k).all (fun i => u i == v i)\ntheorem agree_spec {k : Nat} (u v : Row k) : agree u v = true ↔ u = v := by\n  simp [agree,List.all_eq_true,List.mem_finRange,funext_iff]\n\ndef feasibleStep {k : Nat} (valid : Row (k+1) → Bool) (old : Row k → Bool) (v : Row k) : Bool :=\n  (rows (k+1)).any fun w => agree (prefixRow w) v && valid w && old (suffixRow w)\n\ntheorem feasibleStep_spec {k : Nat} (valid : Row (k+1) → Bool) (old : Row k → Bool) (v : Row k) :\n    feasibleStep valid old v = true ↔ ∃ w, prefixRow w = v ∧ valid w = true ∧\n      old (suffixRow w) = true := by\n  simp [feasibleStep,List.any_eq_true,complete_rows,agree_spec,and_assoc]\n\ndef relation {k : Nat} (bags : List (Bag k)) : Row k → Bool :=\n  bags.foldr (fun f old => feasibleStep (passes f) old) (fun _ => true)\n\ndef clip (k : Nat) (x : Nat → Bool) : Row k := fun i => x i.val\n\ndef validChain {k : Nat} : List (Bag k) → (Nat → Bool) → Bool\n  | [], _ => true\n  | f :: rest, x => passes f (clip (k+1) x) && validChain rest (fun i => x (i+1))\n\n/-- Concatena testemunhas compatíveis exatamente nas k variáveis comuns. -/\ntheorem relation_spec {k : Nat} (bags : List (Bag k)) (v : Row k) :\n    relation bags v = true ↔ ∃ x : Nat → Bool, clip k x = v ∧ validChain bags x = true := by\n  induction bags generalizing v with\n  | nil =>\n    constructor\n    · intro _\n      refine ⟨fun j => if h : j < k then v ⟨j,h⟩ else false,?_,rfl⟩\n      funext i; simp [clip,i.isLt]\n    · intro _; rfl\n  | cons f rest ih =>\n    change feasibleStep (passes f) (relation rest) v = true ↔ _\n    rw [feasibleStep_spec]\n    constructor\n    · rintro ⟨w,hw,hf,hr⟩\n      obtain ⟨tail,ht,htail⟩ := (ih _).mp hr\n      let x : Nat → Bool := fun j => Nat.casesOn j (w 0) tail\n      have xw : clip (k+1) x = w := by\n        funext j\n        cases j using Fin.cases with\n        | zero => rfl\n        | succ i => exact congrFun ht i\n      refine ⟨x,?_,?_⟩\n      · exact (congrArg prefixRow xw).trans hw\n      · change (passes f (clip (k+1) x) && validChain rest tail) = true\n        simp [xw,hf,htail]\n    · rintro ⟨x,hx,h⟩\n      change (passes f _ && validChain rest _) = true at h\n      rw [Bool.and_eq_true] at h\n      obtain ⟨h₁,h₂⟩ := h\n      exact ⟨clip (k+1) x,hx,h₁,(ih _).mpr ⟨fun i => x (i+1),rfl,h₂⟩⟩\n\ndef raiseLit {k n : Nat} (h : k ≤ n) (l : Literal k) : Literal n := ⟨l.var.castLE h,l.pos⟩\ndef raiseCNF {k n : Nat} (h : k ≤ n) (f : CNF k) : CNF n := f.map (fun c => c.map (raiseLit h))\n\ndef formula {k : Nat} : (bags : List (Bag k)) → CNF (k+bags.length)\n  | [] => []\n  | f :: rest => raiseCNF (by simp) f ++ IALD.FitaComCusto.liftCNF (formula rest)\n\ntheorem formula_spec {k : Nat} (bags : List (Bag k)) (x : Nat → Bool) :\n    passes (formula bags) (clip _ x) = validChain bags x := by\n  induction bags generalizing x with\n  | nil => rfl\n  | cons f rest ih =>\n    have re (h : k+1 ≤ k+(f::rest).length) :\n        passes (raiseCNF h f) (clip _ x) = passes f (clip _ x) := by\n      simp [passes,raiseCNF,satisfeita,List.all_map,List.any_map,Function.comp_def,Literal.vale,\n        raiseLit,clip]\n    have ap (g h : CNF (k+(f::rest).length)) :\n        passes (g++h) (clip _ x) = (passes g (clip _ x) && passes h (clip _ x)) := List.all_append\n    rw [formula,ap,re,IALD.FitaComCusto.lift_spec]\n    exact congrArg (fun b => passes f (clip (k+1) x) && b) (ih (fun i => x (i+1)))\n\ntheorem sat_spec {k : Nat} (bags : List (Bag k)) :\n    (rows k).any (relation bags) = true ↔ SAT (formula bags) := by\n  rw [sat_iff]\n  simp only [List.any_eq_true,complete_rows,true_and,relation_spec]\n  constructor\n  · rintro ⟨_,x,_,h⟩\n    exact ⟨clip _ x,(formula_spec bags x).trans h⟩\n  · rintro ⟨v,h⟩\n    let x : Nat → Bool := fun j => if h : j < k+bags.length then v ⟨j,h⟩ else false\n    have hx : clip (k+bags.length) x = v := by funext i; simp [clip,x,i.isLt]\n    exact ⟨clip k x,x,rfl,by rw [← formula_spec,hx]; exact h⟩\n\ndef allGood {k : Nat} (bags : List (Bag k)) : Bool :=\n  bags.all (fun f => (rows (k+1)).all (passes f))\n\ntheorem allGood_spec {k : Nat} (bags : List (Bag k)) :\n    allGood bags = true ↔ ∀ x : Nat → Bool, validChain bags x = true := by\n  induction bags with\n  | nil => simp [allGood,validChain]\n  | cons f rest ih =>\n    change (((rows (k+1)).all (passes f)) && allGood rest) = true ↔ _\n    simp only [Bool.and_eq_true,List.all_eq_true,complete_rows,true_implies,ih,validChain]\n    constructor\n    · rintro ⟨hf,hr⟩ x\n      exact ⟨hf _,hr _⟩\n    · intro h\n      constructor\n      · intro w\n        let x : Nat → Bool := fun j => if hj : j < k+1 then w ⟨j,hj⟩ else false\n        have hx : clip (k+1) x = w := by\n          funext i\n          simp only [clip,x,dif_pos i.isLt]\n        simpa [hx] using (h x).1\n      · intro y\n        exact (h (Nat.casesOn · false y)).2\n\ntheorem quiet_spec {k : Nat} (bags : List (Bag k)) (t : ℝ) :\n    allGood bags = true ↔ verboCalado (custoCNF (formula bags)) t := by\n  rw [o_verbo_cala_sse_tudo_e_nome,allGood_spec]\n  have eqz (f : CNF (k+bags.length)) (u : Row (k+bags.length)) :\n      custoCNF f u = 0 ↔ passes f u = true := by\n    simp [custoCNF_zero_sse,passes,List.all_eq_true]\n  constructor\n  · intro h u\n    let x : Nat → Bool := fun j => if hj : j < k+bags.length then u ⟨j,hj⟩ else false\n    have hx : clip (k+bags.length) x = u := by funext i; simp [clip,x,i.isLt]\n    exact (eqz _ u).mpr (by rw [← hx,formula_spec]; exact h x)\n  · intro h x\n    exact (formula_spec bags x).symm.trans ((eqz _ _).mp (h _))\n\n\ninductive Mark (k : Nat) where\n  | lit (i : Fin (k+1)) (sign : Bool)\n  | close\n  | slide\nderiving Fintype\n\nstructure Registers (k : Nat) where\n  suffix : Row k → Bool\n  bag : Row (k+1) → Bool\n  clause : Row (k+1) → Bool\n  quiet : Bool\nderiving Fintype\n\ndef ready {k : Nat} (r : Row k → Bool) (q : Bool) : Registers k :=\n  ⟨r,fun _ => true,fun _ => false,q⟩\n\n/-- A semântica é de uma tabela de transição de controle finito para k fixo.\n    Uma avaliação recursiva de closures Lean é uma implementação diferente. -/\ndef readMark {k : Nat} (r : Registers k) : Mark k → Registers k\n  | .lit i sign => {r with clause := fun w => r.clause w || (w i == sign)}\n  | .close => {r with bag := fun w => r.bag w && r.clause w, clause := fun _ => false}\n  | .slide => ready (feasibleStep r.bag r.suffix) (r.quiet && (rows (k+1)).all r.bag)\n\ndef literals {k : Nat} (c : Clausula (k+1)) : List (Mark k) :=\n  c.map (fun l => Mark.lit l.var l.pos)\ndef clauseTokens {k : Nat} (c : Clausula (k+1)) : List (Mark k) := literals c ++ [.close]\ndef bagTokens {k : Nat} (f : Bag k) : List (Mark k) := f.flatMap clauseTokens ++ [.slide]\ndef tape {k : Nat} (bags : List (Bag k)) := bags.reverse.flatMap bagTokens\n\ntheorem read_literals {k : Nat} (c : Clausula (k+1)) (r : Registers k) :\n    (literals c).foldl readMark r = {r with clause := fun w => r.clause w || satisfeita c w} := by\n  induction c generalizing r with\n  | nil => simp [literals,satisfeita]\n  | cons l c ih =>\n    change (literals c).foldl readMark (readMark r (.lit l.var l.pos)) = _\n    rw [ih]\n    simp [readMark,satisfeita,Literal.vale,Bool.or_assoc]\n\ntheorem read_clauses {k : Nat} (f : Bag k) (r : Row k → Bool)\n    (b : Row (k+1) → Bool) (q : Bool) :\n    (f.flatMap clauseTokens).foldl readMark ⟨r,b,fun _ => false,q⟩ =\n    ⟨r,fun w => b w && passes f w,fun _ => false,q⟩ := by\n  induction f generalizing b with\n  | nil => simp [passes]\n  | cons c f ih =>\n    rw [List.flatMap_cons,List.foldl_append]\n    simp only [clauseTokens,List.foldl_append,read_literals,List.foldl_cons,List.foldl_nil,\n      readMark,Bool.false_or]\n    rw [ih]\n    simp [passes,Bool.and_assoc]\n\ntheorem read_bag {k : Nat} (f : Bag k) (r : Row k → Bool) (q : Bool) :\n    (bagTokens f).foldl readMark (ready r q) =\n    ready (feasibleStep (passes f) r) (q && (rows (k+1)).all (passes f)) := by\n  simp [bagTokens,List.foldl_append,ready,read_clauses,readMark]\n\ntheorem scan_spec {k : Nat} (bags : List (Bag k)) :\n    (tape bags).foldl readMark (ready (fun _ => true) true) =\n     ready (relation bags) (allGood bags) := by\n  induction bags with\n  | nil => rfl\n  | cons f rest ih =>\n    change ((f::rest).reverse.flatMap bagTokens).foldl readMark _ = _\n    simp only [List.reverse_cons,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,\n      List.append_nil,List.foldl_append]\n    change (bagTokens f).foldl readMark ((tape rest).foldl readMark _) = _\n    rw [ih, read_bag]\n    simp [relation,allGood,Bool.and_comm]\n\ninductive Machine (k : Nat) where\n  | reading (state : Registers k) (unread : List (Mark k))\n  | stopped (word quiet : Bool)\n\ndef step {k : Nat} : Machine k → Machine k\n  | .reading r (m :: ms) => .reading (readMark r m) ms\n  | .reading r [] => .stopped ((rows k).any r.suffix) r.quiet\n  | .stopped w q => .stopped w q\n\ntheorem prefix_steps {k : Nat} (pre rest : List (Mark k)) (r : Registers k) :\n    step^[pre.length] (.reading r (pre ++ rest)) = .reading (pre.foldl readMark r) rest := by\n  induction pre generalizing r with\n  | nil => rfl\n  | cons m ms ih =>\n    change step^[ms.length+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\ntheorem exact_steps {k : Nat} (ms : List (Mark k)) (r : Registers k) :\n    step^[ms.length+1] (.reading r ms) =\n      .stopped ((rows k).any (ms.foldl readMark r).suffix) (ms.foldl readMark r).quiet := by\n  induction ms generalizing r with\n  | nil => rfl\n  | cons m ms ih =>\n    change step^[ms.length+1+1] _ = _\n    rw [Function.iterate_succ_apply]\n    exact ih _\n\n/-- SIM e NÃO integram o mesmo teorema, para qualquer número de bolsas e\n    qualquer lista de cláusulas na bolsa. A hipótese em t é a de `OPsibitEACompressao`. -/\ntheorem tape_reads_both {k : Nat} (bags : List (Bag k)) (t : ℝ)\n    (ht : ((k+bags.length : Nat) : ℝ) * Real.log 2 < t) :\n    ∃ w q, step^[(tape bags).length+1] (.reading (ready (fun _ => true) true) (tape bags)) =\n      .stopped w q ∧ (w = true ↔ palavra (custoCNF (formula bags)) t) ∧\n      (q = true ↔ verboCalado (custoCNF (formula bags)) t) := by\n  refine ⟨(rows k).any (relation bags),allGood bags,?_,(sat_spec bags).trans\n    (a_palavra_decide _ ht _),quiet_spec bags t⟩\n  rw [exact_steps,scan_spec]; rfl\n\n/-- k fica fixo na construção da máquina. As células da tabela verdade de\n    cada registrador não podem passar por armazenamento de custo constante\n    quando se deixa k crescer com a entrada. -/\ntheorem finite_control (k : Nat) : Finite (Registers k) ∧ Finite (Mark k) :=\n  ⟨inferInstance,inferInstance⟩\n\ndef stateComponents (k : Nat) : Registers k ≃\n    ((Row k → Bool) × (Row (k+1) → Bool) × (Row (k+1) → Bool) × Bool) where\n  toFun s := (s.suffix,s.bag,s.clause,s.quiet)\n  invFun p := ⟨p.1,p.2.1,p.2.2.1,p.2.2.2⟩\n  left_inv _ := rfl\n  right_inv _ := rfl\n\n/-- A finitude tem um preço explícito: esta tabela usa esse conjunto de\n    estados possíveis, ainda que parte deles seja inalcançável. -/\ntheorem state_space (k : Nat) :\n    Fintype.card (Registers k) =\n      2^(2^k) * (2^(2^(k+1)) * (2^(2^(k+1)) * 2)) := by\n  rw [Fintype.card_congr (stateComponents k)]\n  simp [Row]\n\ntheorem charged_length {k : Nat} (bags : List (Bag k)) :\n    (tape bags).length =\n      (bags.map (fun f => (f.map List.length).sum + f.length + 1)).sum := by\n  have h (f : Bag k) : (f.flatMap clauseTokens).length = (f.map List.length).sum + f.length := by\n    induction f with\n    | nil => simp\n    | cons c f ih =>\n      simp only [List.flatMap_cons,List.length_append,clauseTokens,literals,List.length_map,\n        List.length_cons,List.length_nil,List.map_cons,List.sum_cons] at *\n      omega\n  induction bags with\n  | nil => rfl\n  | cons f rest ih =>\n    change ((f::rest).reverse.flatMap bagTokens).length = _\n    simp only [List.reverse_cons,List.flatMap_append,List.flatMap_cons,List.flatMap_nil,\n      List.append_nil,List.length_append,List.map_cons,List.sum_cons]\n    change (tape rest).length + (bagTokens f).length = _\n    rw [ih]\n    simp [bagTokens,h, Nat.add_comm]\n\ndef extendLast {k : Nat} (v : Row k) (b : Bool) : Row (k+1) := Fin.lastCases b v\n\n@[simp] theorem extend_prefix {k : Nat} (v : Row k) (b : Bool) :\n    prefixRow (extendLast v b) = v := by\n  funext i; simp [prefixRow,extendLast]\n\ntheorem extend_self {k : Nat} (w : Row (k+1)) :\n    extendLast (prefixRow w) (w (Fin.last k)) = w := by\n  funext i\n  cases i using Fin.lastCases <;> simp [extendLast,prefixRow]\n\ndef branch {k : Nat} (valid : Row (k+1) → Bool) (old : Row k → Bool)\n    (v : Row k) (b : Bool) : Bool :=\n  valid (extendLast v b) && old (suffixRow (extendLast v b))\n\n/-- Só dois prolongamentos são candidatos por célula, com o MESMO contexto v. -/\ntheorem join_is_pair {k : Nat} (valid : Row (k+1) → Bool) (old : Row k → Bool)\n    (v : Row k) :\n    feasibleStep valid old v = (branch valid old v false || branch valid old v true) := by\n  apply Bool.eq_iff_iff.mpr\n  rw [feasibleStep_spec,Bool.or_eq_true]\n  constructor\n  · rintro ⟨w,hv,hf,hr⟩\n    have he : extendLast v (w (Fin.last k)) = w := by\n      rw [← hv,extend_self]\n    have hb : branch valid old v (w (Fin.last k)) = true := by\n      simp [branch,he,hf,hr]\n    cases h : w (Fin.last k)\n    · exact Or.inl (by simpa only [h] using hb)\n    · exact Or.inr (by simpa only [h] using hb)\n  · rintro (hb | hb)\n    · refine ⟨extendLast v false,extend_prefix _ _,?_⟩\n      simpa [branch] using hb\n    · refine ⟨extendLast v true,extend_prefix _ _,?_⟩\n      simpa [branch] using hb\n\ntheorem join_psibit {k : Nat} (valid : Row (k+1) → Bool) (old : Row k → Bool)\n    (v : Row k) : ∃ θ : ℝ,\n    (TGLExt.Psibit.codeAmp θ).word = bitSign (branch valid old v false) ∧\n    (TGLExt.Psibit.codeAmp θ).verb = bitSign (branch valid old v true) ∧\n    (feasibleStep valid old v = true ↔\n      (TGLExt.Psibit.codeAmp θ).word = 1 ∨ (TGLExt.Psibit.codeAmp θ).verb = 1) := by\n  have nz (b : Bool) : bitSign b ≠ 0 := by cases b <;> decide\n  have bit (b : Bool) : bitSign b = 1 ↔ b = true := by cases b <;> decide\n  obtain ⟨θ,h₁,h₂⟩ := TGLExt.Psibit.the_orbit_visits_all_four_states _ _\n    (nz (branch valid old v false)) (nz (branch valid old v true))\n  exact ⟨θ,h₁,h₂,by rw [join_is_pair,h₁,h₂,bit,bit,Bool.or_eq_true]⟩\n\nend IALD.CadeiasDeBolsas\n',
+    'TGLExt/ClausulaComoResposta.lean': 'import TGLExt.PolinomioPorEscolha\nimport TGLExt.CadeiasDeBolsas\n\n/-! A proposal names a complete valuation. A negative reply contains one\noriginal pending clause, with its literals and signs. The protocol counts\nproposal calls and transmitted clause letters. Its bounds exclude the cost\nof producing a proposal or certifying unsatisfiability of the left block. -/\nset_option autoImplicit false\nnamespace Codex.ClauseReply\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha (original spellClause)\nvariable {n : Nat}\nabbrev Assignment (n : Nat) := Fin n → Bool\nabbrev Proposer (n : Nat) := CNF n → Option (Assignment n)\n\n/-- Return the violated clause and the remaining pending list in its\noriginal order. Equal occurrences are allowed; exactly one is removed. -/\ndef inspect (x : Assignment n) : CNF n → Option (Clausula n × CNF n)\n  | [] => none\n  | c :: q =>\n    if satisfeita c x then\n      (inspect x q).map (fun (d, rest) => (d, c :: rest))\n    else some (c, q)\n\ntheorem inspect_none (x : Assignment n) (q : CNF n) :\n    inspect x q = none ↔ passes q x = true := by\n  induction q with\n  | nil => simp [inspect, passes]\n  | cons c q ih =>\n    cases h : satisfeita c x with\n    | false => simp [inspect, passes, h]\n    | true => simpa [inspect, passes, h] using ih\n\ntheorem inspect_some {x : Assignment n} {q : CNF n} {c : Clausula n} {rest : CNF n}\n    (h : inspect x q = some (c, rest)) :\n    satisfeita c x = false ∧ ∃ a b, q = a ++ c :: b ∧ rest = a ++ b := by\n  induction q generalizing rest with\n  | nil => simp [inspect] at h\n  | cons d q ih =>\n    cases hd : satisfeita d x with\n    | false =>\n      simp only [inspect, hd, Bool.false_eq_true, ↓reduceIte, Option.some.injEq,\n        Prod.mk.injEq] at h\n      obtain ⟨rfl, rfl⟩ := h\n      exact ⟨hd, [], _, rfl, rfl⟩\n    | true =>\n      cases he : inspect x q with\n      | none => simp [inspect, hd, he] at h\n      | some v =>\n        obtain ⟨e, r⟩ := v\n        simp only [inspect, hd, ↓reduceIte, he, Option.map_some, Option.some.injEq,\n          Prod.mk.injEq] at h\n        obtain ⟨rfl, rfl⟩ := h\n        obtain ⟨bad, a, b, ha, hb⟩ := ih he\n        exact ⟨bad, d :: a, b, by simp [ha], by simp [hb]⟩\n\n/-- Every complete valuation has exactly the same joint verdict after a transfer. -/\ntheorem transfer_models (left : CNF n) {x : Assignment n} {q : CNF n}\n    {c : Clausula n} {rest : CNF n} (h : inspect x q = some (c, rest))\n    (y : Assignment n) :\n    passes ((c :: left) ++ rest) y = passes (left ++ q) y := by\n  obtain ⟨_, a, b, rfl, rfl⟩ := inspect_some h\n  simp [passes, Bool.and_left_comm]\n\n/-- Every subsequent admissible proposal satisfies any clause retained on the left. -/\ntheorem learned_cannot_fail {c : Clausula n} {left q : CNF n}\n    {y : Assignment n} (hc : c ∈ left) (hy : passes left y = true) (rest : CNF n) :\n    inspect y q ≠ some (c, rest) := by\n  intro hit\n  have yes := List.all_eq_true.mp hy c hc\n  exact Bool.noConfusion (yes.symm.trans (inspect_some hit).1)\n\nstructure Exact (propose : Proposer n) : Prop where\n  sound : ∀ l x, propose l = some x → passes l x = true\n  complete : ∀ l, propose l = none → ¬ SAT l\n\ninductive Verdict (n : Nat) where\n  | found (x : Assignment n)\n  | unsat\n  | exhausted\n\nstructure Report (n : Nat) where\n  result : Verdict n\n  replies : CNF n\n  calls : Nat\n\ndef learned (c : Clausula n) (r : Report n) : Report n :=\n  ⟨r.result, c :: r.replies, r.calls + 1⟩\n\ndef run (propose : Proposer n) : Nat → CNF n → CNF n → Report n\n  | 0, _, _ => ⟨.exhausted, [], 0⟩\n  | fuel+1, left, q =>\n    match propose left with\n    | none => ⟨.unsat, [], 1⟩\n    | some x =>\n      match inspect x q with\n      | none => ⟨.found x, [], 1⟩\n      | some (c, rest) => learned c (run propose fuel (c :: left) rest)\n\ndef Correct (f : CNF n) : Verdict n → Prop\n  | .found x => passes f x = true\n  | .unsat => ¬ SAT f\n  | .exhausted => False\n\nprivate theorem transport {left q rest : CNF n} {x : Assignment n} {c : Clausula n}\n    (h : inspect x q = some (c, rest)) (v : Verdict n) :\n    Correct ((c :: left) ++ rest) v ↔ Correct (left ++ q) v := by\n  cases v with\n  | found y => simp only [Correct, transfer_models left h]\n  | unsat => simp only [Correct, sat_iff, transfer_models left h]\n  | exhausted => rfl\n\n/-- Fuel strictly larger than the pending length covers every terminal call.\nCalls include the last proposal, whether it yields a model or reports UNSAT. -/\ntheorem run_correct (propose : Proposer n) (hp : Exact propose) (fuel : Nat)\n    (left q : CNF n) (enough : q.length < fuel) :\n    Correct (left ++ q) (run propose fuel left q).result ∧\n    (run propose fuel left q).calls = (run propose fuel left q).replies.length + 1 := by\n  induction fuel generalizing left q with\n  | zero => omega\n  | succ k ih =>\n    cases ho : propose left with\n    | none =>\n      refine ⟨?_, by simp [run, ho]⟩\n      simp only [run, ho, Correct]\n      rintro sat\n      obtain ⟨y, hy⟩ := (sat_iff _).mp sat\n      have both : passes left y = true ∧ passes q y = true := by simpa [passes] using hy\n      exact hp.complete _ ho ((sat_iff _).mpr ⟨_, both.1⟩)\n    | some x =>\n      cases hi : inspect x q with\n      | none =>\n        refine ⟨?_, by simp [run, ho, hi]⟩\n        have hx := hp.sound _ _ ho\n        have hq := (inspect_none x q).mp hi\n        simp [run, ho, hi, Correct, passes] at hx hq ⊢\n        exact ⟨hx, hq⟩\n      | some v =>\n        obtain ⟨c, rest⟩ := v\n        obtain ⟨_, a, b, eq, er⟩ := inspect_some hi\n        have hl : rest.length < k := by simp [eq, er] at enough ⊢; omega\n        obtain ⟨ok, calls⟩ := ih (c :: left) rest hl\n        exact ⟨by simpa [run, ho, hi, learned] using (transport hi _).mp ok,\n          by simpa [run, ho, hi, learned] using calls⟩\n\n/-- Each structural resource is bounded even if the caller stops early\nor supplies a poor proposer. The clause payload uses its original unary spelling. -/\ntheorem reply_bounds (propose : Proposer n) (fuel : Nat) (left q : CNF n) :\n    (run propose fuel left q).replies.length ≤ q.length ∧\n    (original (run propose fuel left q).replies).length ≤ (original q).length := by\n  induction fuel generalizing left q with\n  | zero => simp [run, original]\n  | succ k ih =>\n    cases ho : propose left with\n    | none => simp [run, ho, original]\n    | some x =>\n      cases hi : inspect x q with\n      | none => simp [run, ho, hi, original]\n      | some v =>\n        obtain ⟨c, rest⟩ := v\n        obtain ⟨_, a, b, eq, er⟩ := inspect_some hi\n        obtain ⟨count, bytes⟩ := ih (c :: left) rest\n        simp only [run, ho, hi, learned, List.length_cons, original, List.flatMap_cons,\n          List.length_append]\n        simp only [eq, er, original, List.flatMap_append, List.flatMap_cons,\n          List.length_append, List.length_cons] at count bytes ⊢\n        constructor <;> omega\n\n/-- Duplicate clauses on the right cannot induce duplicate replies, even\nif the two occurrences carry different list positions. -/\ntheorem distinct_replies (propose : Proposer n)\n    (sound : ∀ l x, propose l = some x → passes l x = true) (fuel : Nat)\n    (left q : CNF n) :\n    (run propose fuel left q).replies.Nodup ∧\n    ∀ d ∈ (run propose fuel left q).replies, d ∉ left := by\n  induction fuel generalizing left q with\n  | zero => simp [run]\n  | succ k ih =>\n    cases ho : propose left with\n    | none => simp [run, ho]\n    | some x =>\n      cases hi : inspect x q with\n      | none => simp [run, ho, hi]\n      | some v =>\n        obtain ⟨c, rest⟩ := v\n        obtain ⟨unique, fresh⟩ := ih (c :: left) rest\n        have hc : c ∉ left := fun mem => learned_cannot_fail mem (sound _ _ ho) _ hi\n        simp only [run, ho, hi, learned, List.nodup_cons, List.mem_cons]\n        refine ⟨⟨fun mem => fresh _ mem (by simp), unique⟩, ?_⟩\n        rintro d (rfl | mem)\n        · exact hc\n        · exact fun was => fresh _ mem (List.mem_cons_of_mem _ was)\n\ndef protocol (propose : Proposer n) (left q : CNF n) : Report n :=\n  run propose (q.length + 1) left q\n\ntheorem model_iff_sat (propose : Proposer n) (hp : Exact propose) (left q : CNF n) :\n    (∃ x, (protocol propose left q).result = .found x) ↔ SAT (left ++ q) := by\n  have hv := (run_correct propose hp (q.length+1) left q (by omega)).1\n  change Correct (left ++ q) (protocol propose left q).result at hv\n  cases he : (protocol propose left q).result with\n  | found y => exact ⟨fun _ => (sat_iff _).mpr ⟨y, by simpa [he, Correct] using hv⟩,\n      fun _ => ⟨y, rfl⟩⟩\n  | unsat => simpa [he, Correct] using (show ¬ SAT (left ++ q) by simpa [he, Correct] using hv)\n  | exhausted => simp [he, Correct] at hv\n\ntheorem call_bound (propose : Proposer n) (hp : Exact propose) (left q : CNF n) :\n    (protocol propose left q).calls ≤ q.length + 1 := by\n  have eq := (run_correct propose hp (q.length+1) left q (by omega)).2\n  have count := (reply_bounds propose (q.length+1) left q).1\n  unfold protocol\n  omega\n\n/-- Finite reference implementation. The table can have exponential length;\nits per-proposal construction/search is outside the communication bounds. -/\ndef enumerateProposer (n : Nat) : Proposer n :=\n  fun p => (IALD.CadeiasDeBolsas.rows n).find? (passes p)\n\ntheorem enumerate_exact : Exact (enumerateProposer n) where\n  sound p x hx := List.find?_some hx\n  complete p hn hs := by\n    obtain ⟨x, hx⟩ := (sat_iff _).mp hs\n    exact List.find?_eq_none.mp hn x (IALD.CadeiasDeBolsas.complete_rows _) hx\n\nprivate theorem pairs_length {α β : Type} (f g : α → β) (xs : List α) :\n    (xs.flatMap (fun x => [f x, g x])).length = xs.length * 2 := by\n  induction xs with\n  | nil => rfl\n  | cons x xs ih => simp only [List.flatMap_cons, List.length_append, List.length_cons,\n      List.length_nil, ih]; omega\n\ntheorem proposal_table_length (k : Nat) : (IALD.CadeiasDeBolsas.rows k).length = 2^k := by\n  induction k with\n  | zero => rfl\n  | succ k ih =>\n    rw [IALD.CadeiasDeBolsas.rows, pairs_length, ih, pow_succ]\n\n/-- Every rejected valuation for this one positive unit has a unique\narbitrary tail. Thus a single reply can exclude exactly two to the k names. -/\ndef unitClause (k : Nat) : Clausula (k+1) := [⟨0, true⟩]\n\nprivate theorem unit_value {k : Nat} (x : Assignment (k+1)) :\n    satisfeita (unitClause k) x = x 0 := by\n  cases h : x 0 <;> simp [unitClause, satisfeita, Literal.vale, h]\n\ntheorem unit_reply {k : Nat} (x : Assignment (k+1)) :\n    inspect x [unitClause k] = some (unitClause k, []) ↔ x 0 = false := by\n  cases h : x 0 <;> simp [inspect, unit_value, h]\n\ndef rejectedUnitEquiv (k : Nat) :\n    {x : Assignment (k+1) // satisfeita (unitClause k) x = false} ≃ Assignment k where\n  toFun x i := x.val i.succ\n  invFun tail := ⟨Fin.cases false tail, by rw [unit_value]; rfl⟩\n  left_inv x := by\n    apply Subtype.ext\n    funext j\n    cases j using Fin.cases with\n    | zero =>\n      have hz : x.val 0 = false := (unit_value x.val).symm.trans x.property\n      exact hz.symm\n    | succ i => rfl\n  right_inv t := rfl\n\ntheorem names_rejected_by_unit (k : Nat) :\n    Fintype.card {x : Assignment (k+1) // satisfeita (unitClause k) x = false} = 2^k := by\n  classical\n  simpa [Assignment] using Fintype.card_congr (rejectedUnitEquiv k)\n\nend Codex.ClauseReply\n',
+    'TGLExt/FitaCruzada.lean': "import TGLExt.PontePalavraVerbo\n\n/- Fita única, cabeça única, alfabeto fixo. A sintaxe retangular de entrada\n   contém as unidades negativas e as ocorrências positivas. Cada ida percorre\n   todas as variáveis e lê a próxima cláusula. O retorno passa célula por célula.\n   A coluna sentinela (sempre proibida e vazia) distingue cláusulas vazias\n   mesmo em zero variáveis. -/\nnamespace IALD.FitaCruzada\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\n\nabbrev Bits (n : Nat) := Fin n → Bool\n\ndef positive {n} (r : Bits n) : Clausula n :=\n  ((List.finRange n).filter r).map (fun i => ⟨i,true⟩)\n\ndef formula {n} (blocked : Bits n) (rows : List (Bits n)) : CNF n :=\n  ((List.finRange n).filter blocked).map (fun i => [⟨i,false⟩]) ++ rows.map positive\n\ndef available {n} (blocked r : Bits n) : Bool :=\n  (List.finRange n).any (fun i => !blocked i && r i)\n\ntheorem sat_spec {n} (blocked : Bits n) (rows : List (Bits n)) :\n    rows.all (available blocked) = true ↔ SAT (formula blocked rows) := by\n  have pos (r x : Bits n) : satisfeita (positive r) x = true ↔\n      ∃ i, r i = true ∧ x i = true := by\n    simp [satisfeita,positive,List.any_eq_true,Literal.vale]\n  have units (x : Bits n) : passes (formula blocked rows) x = true ↔\n      (∀ i, blocked i = true → x i = false) ∧\n        (∀ r ∈ rows, ∃ i, r i = true ∧ x i = true) := by\n    simp [passes,formula,List.all_eq_true,satisfeita,Literal.vale] at *\n    constructor\n    · rintro ⟨u,h⟩\n      exact ⟨fun i hb => (u i).resolve_left (by simp [hb]),fun r hr => (pos r x).mp (h r hr)⟩\n    · rintro ⟨u,h⟩\n      refine ⟨?_,fun r hr => (pos r x).mpr (h r hr)⟩\n      intro i\n      cases e : blocked i with\n      | false => exact Or.inl rfl\n      | true => exact Or.inr (u i e)\n  have av (r : Bits n) : available blocked r = true ↔\n      ∃ i, blocked i = false ∧ r i = true := by\n    simp [available,List.any_eq_true]\n  rw [sat_iff,List.all_eq_true]\n  constructor\n  · intro h\n    refine ⟨fun i => !blocked i,(units _).mpr ⟨?_,?_⟩⟩\n    · intro i hi; simp [hi]\n    · intro r hr\n      obtain ⟨i,free,yes⟩ := (av _).mp (h r hr)\n      exact ⟨i,yes,by simp [free]⟩\n  · rintro ⟨x,hx⟩ r hr\n    obtain ⟨pins,clauses⟩ := (units _).mp hx\n    obtain ⟨i,yes,h⟩ := clauses r hr\n    refine (av _).mpr ⟨i,?_,yes⟩\n    cases b : blocked i with\n    | false => rfl\n    | true => have z := pins i b; simp [z] at h\n\ninductive Cell where\n  | head (blocked : Bool)\n  | fresh (occurs : Bool)\n  | spent\n  | close\nderiving DecidableEq, Repr\n\ninductive Mode where | idle | take (blocked : Bool) | used\nderiving DecidableEq, Repr\n\nstructure Registers where\n  mode : Mode\n  seen : Bool\n  hit : Bool\nderiving DecidableEq, Repr\n\ndef localRead (s : Registers) : Cell → Registers × Cell\n  | .head b => (⟨.take b,s.seen,s.hit⟩,.head b)\n  | .close => (⟨.idle,s.seen,s.hit⟩,.close)\n  | .spent => (s,.spent)\n  | .fresh v => match s.mode with\n    | .take b => (⟨.used,true,s.hit || (!b && v)⟩,.spent)\n    | _ => (s,.fresh v)\n\ndef sweep (s : Registers) : List Cell → Registers × List Cell\n  | [] => (s,[])\n  | c::cs =>\n    let v := localRead s c\n    let tail := sweep v.1 cs\n    (tail.1,v.2::tail.2)\n\ntheorem sweep_append (a b : List Cell) (s : Registers) :\n    sweep s (a ++ b) =\n      ((sweep (sweep s a).1 b).1,(sweep s a).2 ++ (sweep (sweep s a).1 b).2) := by\n  induction a generalizing s with\n  | nil => rfl\n  | cons a as ih => simp [sweep,ih]\n\ntheorem sweep_length (cs : List Cell) (s : Registers) : (sweep s cs).2.length = cs.length := by\n  induction cs generalizing s with\n  | nil => rfl\n  | cons c cs ih => simp [sweep,ih]\n\ntheorem spent_run (k : Nat) (s : Registers) :\n    sweep s (List.replicate k .spent) = (s,List.replicate k .spent) := by\n  induction k with\n  | zero => rfl\n  | succ k ih => simp [List.replicate_succ,sweep,localRead,ih]\n\ntheorem used_run (xs : List Bool) (v a : Bool) :\n    sweep ⟨.used,v,a⟩ (xs.map .fresh) = (⟨.used,v,a⟩,xs.map .fresh) := by\n  induction xs with\n  | nil => rfl\n  | cons x xs ih => simp [sweep,localRead,ih]\n\ndef block (b : Bool) (k : Nat) (xs : List Bool) : List Cell :=\n  .head b :: (List.replicate k .spent ++ (xs.map .fresh ++ [.close]))\n\ntheorem block_take (b r : Bool) (k : Nat) (xs : List Bool) (s : Registers) :\n    sweep s (block b k (r::xs)) =\n      (⟨.idle,true,s.hit || (!b && r)⟩,block b (k+1) xs) := by\n  simp [block,List.replicate_succ',sweep_append,spent_run,used_run,sweep,localRead,List.append_assoc]\n\ntheorem block_empty (b : Bool) (k : Nat) (s : Registers) :\n    sweep s (block b k []) = (⟨.idle,s.seen,s.hit⟩,block b k []) := by\n  simp [block,sweep_append,spent_run,sweep,localRead]\n\ndef columns {n} (blocked : Bits n) (k : Nat) (rows : List (Bits n))\n    (ids : List (Fin n)) : List Cell :=\n  ids.flatMap (fun i => block (blocked i) k (rows.map (fun r => r i)))\n\ndef tape {n} (blocked : Bits n) (k : Nat) (rows : List (Bits n)) : List Cell :=\n  block true k (rows.map (fun _ => false)) ++ columns blocked k rows (List.finRange n)\n\ntheorem cols_cons {n} (b : Bits n) (k : Nat) (rs : List (Bits n)) (i : Fin n) (is : List (Fin n)) :\n    columns b k rs (i::is) = block (b i) k (rs.map (fun r => r i)) ++ columns b k rs is := rfl\n\ntheorem cols_take {n} (blocked r : Bits n) (k : Nat) (rows : List (Bits n))\n    (ids : List (Fin n)) (a : Bool) :\n    sweep ⟨.idle,true,a⟩ (columns blocked k (r::rows) ids) =\n      (⟨.idle,true,a || ids.any (fun i => !blocked i && r i)⟩,columns blocked (k+1) rows ids) := by\n  induction ids generalizing a with\n  | nil => simp [columns,sweep]\n  | cons i ids ih =>\n    simp only [cols_cons,List.map_cons,List.any_cons,sweep_append,block_take,ih,Bool.or_assoc]\n\ntheorem cols_empty {n} (blocked : Bits n) (k : Nat) (ids : List (Fin n)) (s a : Bool) :\n    sweep ⟨.idle,s,a⟩ (columns blocked k [] ids) =\n       (⟨.idle,s,a⟩,columns blocked k [] ids) := by\n  induction ids with\n  | nil => rfl\n  | cons i ids ih =>\n    simp only 