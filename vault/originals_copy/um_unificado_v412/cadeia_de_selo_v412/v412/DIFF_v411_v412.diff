ction k generalizing s with\n  | zero => have := Finset.card_le_card hs; omega\n  | succ k ih =>\n    let z := traceResult p s false false\n    have hp := pass_trace p [] [] s false false\n    simp only [List.append_nil] at hp\n    have hpass : run (costPass p) (start p s) = readCfg (program p).reverse [] (written z.1) true z.2.1 z.2.2 := hp\n    have hc := trace_changed p s false false\n    have hm := trace_mem p s false false\n    have hlen := pass_length p\n    by_cases he : sweep p s = s\n    · have hb := trace_bad_fixed p s false false he\n      refine ⟨costPass p+1,?_,?_⟩\n      · rw [Nat.succ_mul]; omega\n      · rw [run_add,hpass]\n        simp [z,readCfg,run,step,hc,hb,he,settle]\n    · have hu := sweep_within p s hs\n      have hlt := Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨sweep_extends p s,Ne.symm he⟩)\n      obtain ⟨T,hT,halt⟩ := ih (sweep p s) hu (by omega)\n      refine ⟨(costPass p+1+((program p).length+1))+T,?_,?_⟩\n      · rw [Nat.succ_mul]; omega\n      · rw [run_add _ T, run_add (costPass p+1) ((program p).length+1),\n          run_add (costPass p) 1,hpass]\n        have hh : z.2.1 = true := by simp [z,hc,he]\n        change (run T (run ((program p).length+1)\n          ⟨if z.2.1 then .back else .halt (!z.2.2),true,z.2.1,z.2.2,(program p).reverse,[],0,written z.1⟩)).mode = _\n        have hback := back_trace (program p).reverse [] (written z.1) true true z.2.2\n        simp only [List.length_reverse,List.reverse_reverse,List.append_nil] at hback\n        rw [hh]\n        change (run T (run ((program p).length+1)\n          ⟨.back,true,true,z.2.2,(program p).reverse,[],0,written z.1⟩)).mode = _\n        rw [hback]\n        simpa only [z,hm,settle,if_neg he,start] using halt\n\n/-- Physical movement of both heads between configurations, in unit cell boundaries crossed. -/\ndef moves (x y : Cfg) := Nat.dist x.left.length y.left.length + Nat.dist x.pos y.pos\ndef travel : Nat → Cfg → Nat\n  | 0,_ => 0\n  | k+1,c => moves c (step c) + travel k (step c)\n\ntheorem one_tick (c : Cfg) : moves c (step c) ≤ 2 := by\n  rcases c with ⟨mode,a,h,b,l,r,i,t⟩\n  cases mode with\n  | halt _ => simp [moves,step]\n  | home => cases i <;> simp [moves,step,Nat.dist]\n  | back => cases l <;> simp [moves,step,Nat.dist]\n  | scan =>\n    cases r with\n    | nil => simp [moves,step]\n    | cons c r => cases c <;> simp [moves,step,Nat.dist]\n\ntheorem travel_bound (T : Nat) (c : Cfg) : travel T c ≤ 2*T := by\n  induction T generalizing c with\n  | zero => rfl\n  | succ T ih =>\n    have h := one_tick c\n    have h' := ih (step c)\n    simp only [travel,Nat.mul_succ]\n    omega\n\ntheorem sparse_horn_tape (p : List (Rule n)) :\n    let L := (program p).length\n    ∃ T ≤ (L+1)*(3*L+2), travel T (start p ∅) ≤ 2*((L+1)*(3*L+2)) ∧\n      (run T (start p ∅)).mode = .halt (palavraDaFormula (p.map asClause)) := by\n  have h₁ := List.toFinset_card_le (p.filterMap Rule.head)\n  have h₂ := List.length_filterMap_le Rule.head p\n  obtain ⟨T,hT,ha⟩ := halts_from p (p.length+1) ∅ (by simp) (by simpa [heads] using Nat.lt_succ_of_le (h₁.trans h₂))\n  have h := hT.trans (Nat.mul_le_mul_right _ (Nat.add_le_add_right (clauses_length p) 1))\n  exact ⟨T,h,(travel_bound _ _).trans (Nat.mul_le_mul_left 2 h),ha.trans (congrArg Mode.halt (horn_word p))⟩\n\nend Codex.SparseHornTape\n",
+    'TGLExt/OSeparadorNoPercurso.lean': "import TGLExt.AFronteiraEOUnicoPortao\n\nset_option autoImplicit false\n\n/-!\n# O separador no percurso: todo percurso do lido ao por ler tem um vértice na fronteira\n\n## O que este arquivo acrescenta\n\n`AFronteiraEOUnicoPortao.a_fronteira_e_o_unico_portao` conclui que, havendo cadeia de uma variável só lida a uma só\npor ler, a fronteira não é vazia. O enunciado dele não registra que o vértice exibido pertence à cadeia, porque a\ncadeia é uma proposição de alcançabilidade. Aqui o percurso é uma lista explícita de variáveis, cada uma ligada à\nseguinte, e o enunciado devolve a pertinência.\n\n## O que fica provado\n\n1. `Percurso`: a lista de variáveis em que cada uma está ligada à seguinte (mencionadas juntas por uma cláusula).\n2. ★★ `o_percurso_atravessa_a_fronteira`: todo percurso que começa numa variável só lida e termina numa só por ler\n   tem um vértice na fronteira. É a propriedade de separador: tirada a fronteira, nenhum percurso liga o só lido ao\n   só por ler.\n3. `toda_cadeia_tem_percurso`: toda cadeia de `i` a `k` é realizada por um percurso que começa em `i` e termina em\n   `k`; com o item 2, toda cadeia do só lido ao só por ler tem um percurso com vértice na fronteira\n   (`a_cadeia_atravessa_a_fronteira`).\n\n## O que NÃO se afirma\n\n* Que a fronteira seja o menor separador, ou o único: prova-se que ela separa, não que seja mínima.\n* Nada sobre custo de leitura, sobre máquina de fita ou sobre o tamanho da fronteira.\n* Que a fronteira seja o piso da leitura: é definição da teoria [INPUT/ONTO]; o termo é a separação.\n-/\n\nnamespace TGLExt.OSeparadorNoPercurso\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.OResumoEPsiBit TGLExt.AFronteiraEOUnicoPortao\n\nvariable {n : ℕ}\n\n/-- [DEF] O PERCURSO: a lista de variáveis em que cada uma está ligada à seguinte. -/\ninductive Percurso (φ : CNF n) : List (Fin n) → Prop\n  | um (i : Fin n) : Percurso φ [i]\n  | passo {i k : Fin n} {r : List (Fin n)} : ligadas φ i k → Percurso φ (k :: r) → Percurso φ (i :: k :: r)\n\n/-- ★★ **O PERCURSO ATRAVESSA A FRONTEIRA**: todo percurso que começa numa variável só lida e termina numa só por\nler tem um vértice na fronteira. -/\ntheorem o_percurso_atravessa_a_fronteira (φ : CNF n) (j : ℕ) (p : List (Fin n)) :\n    ∀ i : Fin n, Percurso φ (i :: p) → soLeida φ j i →\n      soPorLer φ j ((i :: p).getLast (List.cons_ne_nil i p)) →\n      ∃ v, v ∈ i :: p ∧ v ∈ fronteira φ j := by\n  induction p with\n  | nil =>\n      intro i _ hi hk\n      have hk' : soPorLer φ j i := hk\n      exact absurd hk'.2 hi.2\n  | cons b r ih =>\n      intro i hp hi hk\n      have hk' : soPorLer φ j ((b :: r).getLast (List.cons_ne_nil b r)) := hk\n      cases hp with\n      | passo hlink hrest =>\n          obtain ⟨C, hCφ, haC, hbC⟩ := hlink\n          rcases mem_take_or_drop (j := j) hCφ with hC | hC\n          · have hbL : b ∈ varsDas (φ.take j) := mem_varsDas_take hC hbC\n            by_cases hbN : b ∈ varsDas (φ.drop j)\n            · exact ⟨b, by simp, Finset.mem_inter.mpr ⟨hbL, hbN⟩⟩\n            · obtain ⟨v, hv, hvF⟩ := ih b hrest ⟨hbL, hbN⟩ hk'\n              exact ⟨v, List.mem_cons_of_mem _ hv, hvF⟩\n          · exact absurd (mem_varsDas_drop hC haC) hi.2\n\n/-- Toda cadeia de `i` a `k` é realizada por um percurso que começa em `i` e termina em `k`. -/\ntheorem toda_cadeia_tem_percurso (φ : CNF n) {i k : Fin n} (c : Cadeia φ i k) :\n    ∃ r : List (Fin n), Percurso φ (i :: r) ∧ (i :: r).getLast (List.cons_ne_nil i r) = k := by\n  induction c with\n  | single i => exact ⟨[], Percurso.um i, rfl⟩\n  | cons hlink _ ih =>\n      obtain ⟨r, hp, hl⟩ := ih\n      exact ⟨_ :: r, Percurso.passo hlink hp, hl⟩\n\n/-- **A CADEIA ATRAVESSA A FRONTEIRA**: toda cadeia de uma variável só lida a uma só por ler é realizada por um\npercurso que tem um vértice na fronteira. -/\ntheorem a_cadeia_atravessa_a_fronteira (φ : CNF n) (j : ℕ) {i k : Fin n} (c : Cadeia φ i k)\n    (hi : soLeida φ j i) (hk : soPorLer φ j k) :\n    ∃ r : List (Fin n), Percurso φ (i :: r) ∧ (i :: r).getLast (List.cons_ne_nil i r) = k ∧\n      ∃ v, v ∈ i :: r ∧ v ∈ fronteira φ j := by\n  obtain ⟨r, hp, hl⟩ := toda_cadeia_tem_percurso φ c\n  exact ⟨r, hp, hl, o_percurso_atravessa_a_fronteira φ j r i hp hi (by rw [hl]; exact hk)⟩\n\nend TGLExt.OSeparadorNoPercurso\n",
+    'TGLExt/PalavrasResiduais.lean': 'import TGLExt.OPsiBitDaFormula\nimport TGLExt.InformacaoDoResumo\n\n/-! Comparing actual formula PsiBits, indexed partition functions, and exact\ncontinuation states. Coordinate flips preserve the entire unmasked partition\ncurve, but a common suffix can distinguish the pinned assignments. -/\nnamespace IALD.PalavrasResiduais\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula\nopen IALD.LeitorDaFormula IALD.InformacaoDoResumo\n\nabbrev Bits (n : ℕ) := Fin n → Bool\n\ndef flip {n : ℕ} (a b x : Bits n) : Bits n :=\n  fun i => if a i = b i then x i else !(x i)\n\nprivate theorem twice {n : ℕ} (a b x : Bits n) : flip a b (flip a b x) = x := by\n  funext i\n  by_cases h : a i = b i <;> simp [flip,h]\n\ndef perm {n : ℕ} (a b : Bits n) : Equiv.Perm (Bits n) :=\n  ⟨flip a b,flip a b,twice a b,twice a b⟩\n\nprivate theorem flipped_test {n : ℕ} (a b x : Bits n) (i : Fin n) :\n    ((flip a b x) i == b i) = (x i == a i) := by\n  cases h₁ : a i <;> cases h₂ : b i <;> cases h₃ : x i <;> simp [flip,h₁,h₂,h₃]\n\ntheorem cost_permutation {n : ℕ} (a b x : Bits n) :\n    custoCNF (isolate b) (perm a b x) = custoCNF (isolate a) x := by\n  simp only [custoCNF,isolate,List.ofFn_eq_map,List.countP_map]\n  congr 1\n  funext i\n  simp [satisfeita,Literal.vale,perm,flipped_test]\n\n/-- Every unmasked partition value is identical, at every real time. -/\ntheorem partition_curves_equal {n : ℕ} (a b : Bits n) (t : ℝ) :\n    particao (custoCNF (isolate a)) t = particao (custoCNF (isolate b)) t := by\n  unfold particao\n  calc\n    _ = ∑ x : Bits n, Real.exp (-(t * (custoCNF (isolate b) (perm a b x) : ℝ))) := by\n      apply Finset.sum_congr rfl\n      intro x _\n      rw [cost_permutation]\n    _ = _ := Equiv.sum_comp (perm a b) (fun x => Real.exp (-(t * (custoCNF (isolate b) x : ℝ))))\n\nprivate theorem pin_word {n : ℕ} (a : Bits n) : palavraDaFormula (isolate a) = true :=\n  (a_palavra_e_o_sat _).2 ((sat_iff _).2 ⟨a,(isolate_spec a a).2 rfl⟩)\n\ntheorem pin_psibits_equal {n : ℕ} (a b : Bits n) (t : ℝ) :\n    psibitDaFormula (isolate a) t = psibitDaFormula (isolate b) t := by\n  unfold psibitDaFormula verboDaFormula descida\n  rw [pin_word,pin_word,partition_curves_equal a b t,partition_curves_equal a b (t+1)]\n\ntheorem suffix_tests_name {n : ℕ} (a b : Bits n) :\n    palavraDaFormula (isolate a ++ isolate b) = true ↔ b = a := by\n  rw [a_palavra_e_o_sat,append_isolate,isolate_spec]\n\n/-- The very same suffix distinguishes these prefix words, even though no real\ntime (or even the collection of all unmasked real partition values) distinguishes them. -/\ntheorem distinguish_pins {n : ℕ} (a b : Bits n) (hne : a ≠ b) :\n    (∀ t, psibitDaFormula (isolate a) t = psibitDaFormula (isolate b) t) ∧\n    (∀ t, psibitDaFormula (isolate a ++ isolate a) t ≠\n          psibitDaFormula (isolate b ++ isolate a) t) := by\n  refine ⟨pin_psibits_equal a b,?_⟩\n  intro t h\n  have hf := congrArg Prod.fst h\n  change palavraDaFormula (isolate a ++ isolate a) = palavraDaFormula (isolate b ++ isolate a) at hf\n  exact hne ((suffix_tests_name b a).1 (hf ▸ (suffix_tests_name a a).2 rfl))\n\n/-- Failure already at one bit with a common unit suffix. t can be chosen arbitrarily. -/\ntheorem no_context_free_product (t : ℝ) :\n    ¬ ∃ combine : (Bool × SignType) → (Bool × SignType) → Bool × SignType,\n      ∀ p q : CNF 1, psibitDaFormula (p ++ q) t =\n        combine (psibitDaFormula p t) (psibitDaFormula q t) := by\n  let a : Bits 1 := fun _ => false\n  let b : Bits 1 := fun _ => true\n  have ne : a ≠ b := by intro h; have := congrFun h 0; contradiction\n  obtain ⟨hc,hd⟩ := distinguish_pins a b ne\n  rintro ⟨op,ho⟩\n  apply hd t\n  rw [ho (isolate a) (isolate a),ho (isolate b) (isolate a),hc t]\n\n/-- All real samples of the two bits and the partition, supplied for free. -/\nnoncomputable def observation {n : ℕ} (p : CNF n) :\n    (ℝ → Bool × SignType) × (ℝ → ℝ) :=\n  (psibitDaFormula p, particao (custoCNF p))\n\n/-- Even this entire observation and the actual syntax of the common suffix\ncannot replace the correlations between the variable labels and the surviving models. -/\ntheorem no_unmasked_curve_update :\n    ¬ ∃ next : ((ℝ → Bool × SignType) × (ℝ → ℝ)) → CNF 1 → Bool,\n      ∀ p q : CNF 1, next (observation p) q = palavraDaFormula (p ++ q) := by\n  let a : Bits 1 := fun _ => false\n  let b : Bits 1 := fun _ => true\n  have ne : a ≠ b := by intro h; have := congrFun h 0; contradiction\n  have e : observation (isolate a) = observation (isolate b) :=\n    Prod.ext (funext (pin_psibits_equal a b)) (funext (partition_curves_equal a b))\n  rintro ⟨op,ho⟩\n  apply ne\n  apply (suffix_tests_name b a).mp\n  rw [← ho, ← e, ho]\n  exact (suffix_tests_name a a).mpr rfl\n\n/-- State count at a cut in any deterministic exact clause-stream computation.\n2^n possible states require n bits as a cardinality bound only. -/\ntheorem necessary_states {n : ℕ} {S : Type*} [Fintype S]\n    (initial : S) (step : S → Clausula n → S) (read : S → Bool)\n    (correct : ∀ p : CNF n, read (p.foldl step initial) = palavraDaFormula p) :\n    2^n ≤ Fintype.card S := by\n  let code (a : Bits n) := (isolate a).foldl step initial\n  have hi : Function.Injective code := by\n    intro a b hab\n    dsimp [code] at hab\n    apply (suffix_tests_name b a).1\n    rw [← correct,List.foldl_append,← hab]\n    rw [← List.foldl_append,correct]\n    exact (suffix_tests_name a a).2 rfl\n  simpa [Bits] using Fintype.card_le_of_injective code hi\n\nend IALD.PalavrasResiduais\n',
