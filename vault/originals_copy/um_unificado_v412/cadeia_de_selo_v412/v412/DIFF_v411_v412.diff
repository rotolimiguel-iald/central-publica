h_visited {α} (f : α → Bool × Nat) (a b : α) (h : (f a).1=false) :\n    (firstSuccess f [a,b]).2 = (f a).2 + (f b).2 := by\n  cases e : (f b).1 <;> simp [firstSuccess,h,e]\n\nprivate theorem first_charged {α} (f : α → Bool × Nat) (a : α) (ls : List α) :\n    (f a).2 ≤ (firstSuccess f (a::ls)).2 := by\n  cases h : (f a).1 <;> simp [firstSuccess,h]\n\ntheorem delayed_checks (k : Nat) (ms : List (Literal 4)) :\n    2^k ≤ (traced (delayed k) ms).2 := by\n  induction k generalizing ms with\n  | zero =>\n    change 1 ≤ (firstSuccess _ [_,_]).2\n    refine Nat.le_trans ?_ (first_charged _ _ _)\n    change 1 ≤ (firstSuccess _ [_,_]).2\n    exact first_charged (fun l : Literal 4 => traced [] (l :: ⟨1,false⟩ :: ms)) ⟨1,false⟩ [⟨3,false⟩]\n  | succ k ih =>\n    change 2^(k+1) ≤ (firstSuccess (fun l => traced (delayed k) (l::ms)) [_,_]).2\n    rw [both_visited (fun l : Literal 4 => traced (delayed k) (l::ms))\n      ⟨1,true⟩ ⟨2,true⟩ (first_failed k ms),pow_succ,Nat.mul_two]\n    exact Nat.add_le_add (ih _) (ih _)\n\nprivate theorem cell_one (k : Nat) : SignProfile.profile (delayed (k+1)) 1 =\n    ⟨true,true,false,false⟩ := by\n  induction k with\n  | zero => decide\n  | succ k ih =>\n    change SignProfile.join (SignProfile.flags choiceClause (SignProfile.singleton choiceClause) 1)\n      (SignProfile.profile (delayed (k+1)) 1) = _\n    rw [ih]\n    decide\n\ntheorem delayed_inconclusive (k : Nat) (b : Bool) :\n    ¬SignProfile.covered (delayed (k+1)) ∧\n      passes (delayed (k+1)) (SignProfile.value (delayed (k+1)) b) = false := by\n  constructor\n  · intro cls\n    have h := cls (1 : Fin 4) (by decide)\n    change SignProfile.allowed (SignProfile.profile (delayed (k+1)) 1) = true at h\n    rw [cell_one] at h\n    contradiction\n  · cases h : passes (delayed (k+1)) (SignProfile.value (delayed (k+1)) b) with\n    | false => rfl\n    | true =>\n      have fail := forces_low (k+1) _ h\n      change SignProfile.pick (SignProfile.profile (delayed (k+1)) 1) = false at fail\n      rw [cell_one] at fail\n      contradiction\n\ntheorem delayed_letters (k : Nat) : (original (delayed k)).length = 6*k+14 := by\n  induction k with\n  | zero => decide\n  | succ k ih =>\n    change (spellClause choiceClause ++ original (delayed k)).length = _\n    rw [List.length_append,ih]\n    have first : (spellClause choiceClause).length = 6 := by decide\n    omega\n\nend Codex.LiteralSearchCost\n',
+    'TGLExt/CacheDeRamos.lean': 'import TGLExt.CustoDaBuscaLiteral\n\n/-! Keys record signed literals on a single choice path. A layer contains\nonly distinct keys reached by that prefix. The counter below charges one\nextension attempt per (reached key, occurrence in the next clause). -/\nset_option autoImplicit false\n\nnamespace Codex.BranchCache\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\nopen Codex.LiteralSearchCost\nvariable {n : Nat}\n\nabbrev Key (n : Nat) := Finset (Fin n × Bool)\nabbrev Layer (n : Nat) := Finset (Key n)\n\ndef fits (s : Key n) (x : Fin n → Bool) : Prop := ∀ a ∈ s, x a.1 = a.2\ndef models (rows : Layer n) (x : Fin n → Bool) : Prop := ∃ s ∈ rows, fits s x\ndef initial (n : Nat) : Layer n := {∅}\n\ndef extend (s : Key n) (l : Literal n) : Layer n :=\n  if (l.var,!l.pos) ∈ s then ∅ else {insert (l.var,l.pos) s}\n\ndef children (s : Key n) : Clausula n → Layer n\n  | [] => ∅\n  | l::rest => extend s l ∪ children s rest\n\ndef advance (rows : Layer n) (c : Clausula n) : Layer n :=\n  rows.biUnion (fun s => children s c)\n\ndef run : CNF n → Layer n → Layer n\n  | [],rows => rows\n  | c::p,rows => run p (advance rows c)\n\nprivate theorem fits_insert (s : Key n) (l : Literal n) (x : Fin n → Bool) :\n    fits (insert (l.var,l.pos) s) x ↔ x l.var = l.pos ∧ fits s x := by\n  simp [fits]\n\nprivate theorem extend_models (s : Key n) (l : Literal n) (x : Fin n → Bool) :\n    models (extend s l) x ↔ fits s x ∧ x l.var = l.pos := by\n  by_cases opp : (l.var,!l.pos) ∈ s\n  · simp only [extend,if_pos opp,models,Finset.notMem_empty,false_and,exists_false,false_iff]\n    rintro ⟨hs,hit⟩\n    have incompatible := hs (l.var,!l.pos) opp\n    change x l.var = !l.pos at incompatible\n    rw [hit] at incompatible\n    cases sign : l.pos <;> simp [sign] at incompatible\n  · simp [extend,opp,models,fits_insert,and_comm]\n\nprivate theorem models_union (a b : Layer n) (x : Fin n → Bool) :\n    models (a ∪ b) x ↔ models a x ∨ models b x := by\n  simp only [models,Finset.mem_union,or_and_right,exists_or]\n\nprivate theorem children_models (s : Key n) (c : Clausula n) (x : Fin n → Bool) :\n    models (children s c) x ↔ fits s x ∧ satisfeita c x = true := by\n  induction c with\n  | nil => simp [children,models,satisfeita]\n  | cons l c ih =>\n    rw [children,models_union,extend_models,ih]\n    simp [satisfeita,Literal.vale,and_or_left]\n\ntheorem advance_models (rows : Layer n) (c : Clausula n) (x : Fin n → Bool) :\n    models (advance rows c) x ↔ models rows x ∧ satisfeita c x = true := by\n  constructor\n  · rintro ⟨t,ht,fit⟩\n    obtain ⟨s,hs,ht⟩ := Finset.mem_biUnion.mp ht\n    obtain ⟨old,hit⟩ := (children_models s c x).mp ⟨t,ht,fit⟩\n    exact ⟨⟨s,hs,old⟩,hit⟩\n  · rintro ⟨⟨s,hs,old⟩,hit⟩\n    obtain ⟨t,ht,fit⟩ := (children_models s c x).mpr ⟨old,hit⟩\n    exact ⟨t,Finset.mem_biUnion.mpr ⟨s,hs,ht⟩,fit⟩\n\ntheorem run_models (p : CNF n) (rows : Layer n) (x : Fin n → Bool) :\n    models (run p rows) x ↔ models rows x ∧ passes p x = true := by\n  induction p generalizing rows with\n  | nil => simp [run,passes]\n  | cons c p ih =>\n    rw [run,ih,advance_models]\n    simp [passes,and_assoc]\n\ntheorem initial_models (p : CNF n) (x : Fin n → Bool) :\n    models (run p (initial n)) x ↔ passes p x = true := by\n  rw [run_models]\n  simp [initial,models,fits]\n\ndef build (s : Key n) (i : Fin n) (b : Bool) (j : Fin n) : Bool :=\n  if j = i then b else decide ((j,true) ∈ s)\n\nprivate theorem reconstruct {s : Key n} {x : Fin n → Bool} {i : Fin n} {b : Bool}\n    (hs : fits s x) (pivot : x i = b) : fits s (build s i b) := by\n  rintro ⟨j,v⟩ hj\n  have seen : x j = v := hs (j,v) hj\n  by_cases eq : j = i\n  · subst j\n    simpa [build] using pivot.symm.trans seen\n  · cases v with\n    | true => simp [build,eq,hj]\n    | false =>\n      have notPos : (j,true) ∉ s := by\n        intro pos\n        have conflict : x j = true := hs (j,true) pos\n        simp [seen] at conflict\n      simp [build,eq,notPos]\n\ndef keyFits (s : Key n) (x : Fin n → Bool) : Bool :=\n  decide ((s.filter (fun a => x a.1 ≠ a.2)) = ∅)\n\nprivate theorem matches_spec (s : Key n) (x : Fin n → Bool) :\n    keyFits s x = true ↔ fits s x := by\n  simp [keyFits,Finset.filter_eq_empty_iff,fits]\n\ndef branch (rows : Layer n) (i : Fin n) (b : Bool) : Bool :=\n  decide ((rows.filter (fun s => keyFits s (build s i b) = true)).Nonempty)\n\n/-- Both bits share the same prefix computation. Querying any branch only\ninspects its stored keys and tests their signed marks. -/\ndef read (p : CNF n) (i : Fin n) : Bool × Bool :=\n  let rows := run p (initial n)\n  (branch rows i false, branch rows i true)\n\ntheorem branch_correct (p : CNF n) (i : Fin n) (b : Bool) :\n    branch (run p (initial n)) i b = true ↔ ∃ x, x i = b ∧ passes p x = true := by\n  unfold branch\n  rw [decide_eq_true_eq]\n  constructor\n  · rintro ⟨s,hs⟩\n    obtain ⟨mem,ok⟩ := Finset.mem_filter.mp hs\n    refine ⟨build s i b,by simp [build],(initial_models _ _).mp ?_⟩\n    exact ⟨s,mem,(matches_spec _ _).mp ok⟩\n  · rintro ⟨x,pivot,ok⟩\n    obtain ⟨s,mem,fit⟩ := (initial_models _ _).mpr ok\n    exact ⟨s,Finset.mem_filter.mpr ⟨mem,(matches_spec _ _).mpr (reconstruct fit pivot)⟩⟩\n\ntheorem pair_correct (p : CNF n) (i : Fin n) (b : Bool) :\n    (if b then (read p i).2 else (read p i).1) = true ↔\n      ∃ x, x i = b ∧ passes p x = true := by\n  cases b <;> exact branch_correct p i _\n\ndef attempts : CNF n → Layer n → Nat\n  | [],_ => 0\n  | c::p,rows => rows.card*c.length + attempts p (advance rows c)\n\ntheorem distinct_layers (rows : Layer n) : rows.card ≤ 2^(n*2) := by\n  simpa [Key] using (Finset.card_le_univ rows)\n\ntheorem attempt_bound (p : CNF n) (rows : Layer n) :\n    attempts p rows ≤ 2^(n*2) * (p.map List.length).sum := by\n  induction p generalizing rows with\n  | nil => simp [attempts]\n  | cons c p ih =>\n    simp only [attempts,List.map_cons,List.sum_cons,Nat.mul_add]\n    exact Nat.add_le_add (Nat.mul_le_mul_right _ (distinct_layers rows)) (ih _)\n\n/-- Three canonical keys survive any further copy after the first two. -/\ndef firstLayer := advance (initial 4) choiceClause\ndef stableLayer := advance firstLayer choiceClause\n\ntheorem delayed_stabilizes :\n    stableLayer.card = 3 ∧ advance stableLayer choiceClause = stableLayer := by decide\n\nprivate theorem delayed_stable_attempts (k : Nat) :\n    attempts (delayed k) stableLayer = 6*k+14 := by\n  induction k with\n  | zero => decide\n  | succ k ih =>\n    simp only [delayed,attempts,delayed_stabilizes.1,delayed_stabilizes.2,ih]\n    have width : choiceClause.length = 2 := rfl\n    rw [width]\n    omega\n\ntheorem delayed_exact_attempts (k : Nat) :\n    attempts (delayed (k+2)) (initial 4) = 6*k+20 := by\n  change (initial 4).card * choiceClause.length +\n      (firstLayer.card * choiceClause.length + attempts (delayed k) stableLayer) = _\n  rw [delayed_stable_attempts]\n  have a : (initial 4).card = 1 := by decide\n  have b : firstLayer.card = 2 := by decide\n  have c : choiceClause.length = 2 := rfl\n  rw [a,b,c]\n  omega\n\ntheorem delayed_branches (k : Nat) : read (delayed k) 0 = (true,true) := by\n  apply Prod.ext\n  · exact (branch_correct _ _ false).mpr (every_branch_possible k false)\n  · exact (branch_correct _ _ true).mpr (every_branch_possible k true)\n\nend Codex.BranchCache\n',
+    'TGLExt/DuasPassagens.lean': 'import TGLExt.PerfilDeSinais\nimport TGLExt.CircuitoNaFita\n\n/-! Read-only input, one work tape, two sweeps. At a sign the input head has\nadvanced, so the delimiter test uses the symbol it is now on. A work head\nmoves right once per tick and returns to its left marker at each sign. -/\nset_option autoImplicit false\nnamespace Codex.TwoSweeps\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha Codex.SignProfile\n\nabbrev Bank := Nat → Cell\nstructure Op (Q : Type) where\n  literal : Bool → Bool → Bool → Cell → Q → Cell × Q -- zero address, sign, unit\n  boundary : Q → Q\n\nstructure St (Q : Type) where\n  bank : Bank\n  control : Q\n  first : Bool\n  head : Nat\n\n/-- Each recursive call moves the work head exactly one cell left. -/\ndef home : Nat → Nat × Nat\n  | 0 => (0,0)\n  | k+1 => let r := home k; (r.1,r.2+1)\n@[simp] theorem home_trace (j : Nat) : home j = (0,j) := by\n  induction j with | zero => rfl | succ j ih => simp [home,ih]\n\ndef delimiterNext : List Letter → Bool\n  | .delimiter :: _ => true\n  | _ => false\n\ndef atSign {Q} (o : Op Q) (st : St Q) (s last : Bool) : St Q :=\n  let v := o.literal (st.head == 0) s (st.first && last) (st.bank st.head) st.control\n  ⟨Function.update st.bank st.head v.1,v.2,false,(home st.head).1⟩\n\ndef update {Q} (o : Op Q) (a : Letter) (next : List Letter) (st : St Q) : St Q :=\n  match a with\n  | .tick => {st with head := st.head+1}\n  | .sign s => atSign o st s (delimiterNext next)\n  | .delimiter => {st with first := true, control := o.boundary st.control}\n\n/-- Input advances one on every letter. Ticks also advance the work head;\nsigns also rewind it. The length of the unread tail is never consulted. -/\ndef workMoves (j : Nat) : Letter → Nat\n  | .tick => 1 | .sign _ => (home j).2 | .delimiter => 0\n\ndef scan {Q} (o : Op Q) : List Letter → St Q → St Q\n  | [],st => st\n  | a::w,st => scan o w (update o a w st)\ndef travel {Q} (o : Op Q) : List Letter → St Q → Nat\n  | [],_ => 0\n  | a::w,st => (1+workMoves st.head a) + travel o w (update o a w st)\n\n/-- Bookkeeping of the past of the SAME read-only input head during scan.\nThe zipper is an observation. Returning to the left uses rewind, cell by cell. -/\ndef past : List Letter → List Letter → List Letter\n  | [],left => left\n  | a::w,left => past w (a::left)\ntheorem past_spec (w left : List Letter) : past w left = w.reverse ++ left := by\n  induction w generalizing left with\n  | nil => rfl\n  | cons a w ih => simp [past,ih,List.append_assoc]\ndef returned (w : List Letter) := Codex.BranchCircuit.rewind (past w []) []\ntheorem returned_spec (w : List Letter) : returned w = (w,w.length) := by\n  simp [returned,Codex.BranchCircuit.rewind_trace,past_spec]\n\ntheorem count_le {Q} (o : Op Q) (w : List Letter) (s : St Q) :\n    travel o w s ≤ 3*w.length+s.head := by\n  induction w generalizing s with\n  | nil => simp [travel]\n  | cons a w ih =>\n    have h := ih (update o a w s)\n    cases a <;> simp [travel,update,atSign,workMoves,Nat.mul_add] at h ⊢ <;> omega\n\n/-- Macro at a literal boundary. Its index is used only to prove what raw scan\ncomputes. The executable scanner reaches it using the ticks of the input. -/\ndef applyLit {Q n} (o : Op Q) (l : Literal n) (unit : Bool) (s : St Q) : St Q :=\n  let r := o.literal (l.var.val == 0) l.pos unit (s.bank l.var.val) s.control\n  ⟨Function.update s.bank l.var.val r.1,r.2,false,0⟩\ndef lits {Q n} (o : Op Q) : Clausula n → St Q → St Q\n  | [],s => s\n  | l::ls,s => lits o ls (applyLit o l (s.first && ls.isEmpty) s)\ndef finish {Q} (o : Op Q) (s : St Q) : St Q := {s with first:=true,control:=o.boundary s.control}\ndef clauses {Q n} (o : Op Q) : CNF n → St Q → St Q\n  | [],s => s\n  | c::p,s => clauses o p (finish o (lits o c s))\n\nprivate theorem ticks {Q} (o : Op Q) (k : Nat) (w : List Letter) (s : St Q) :\n    scan o (List.replicate k .tick ++ w) s = scan o w {s with head:=s.head+k} := by\n  induction k generalizing s with\n  | zero => rfl\n  | succ k ih =>\n    rw [List.replicate_succ]\n    simp only [List.cons_append, scan, update, ih]\n    congr 1\n    simp [Nat.add_comm,Nat.add_left_comm]\n\nprivate theorem next_lit {n} (ls : Clausula n) (w : List Letter) :\n    delimiterNext (ls.flatMap spell ++ .delimiter :: w) = ls.isEmpty := by\n  cases ls with\n  | nil => rfl\n  | cons l ls => cases h : l.var.val <;> simp [spell,delimiterNext,h,List.replicate_succ,List.append_assoc]\n\nprivate theorem raw_lits {Q n} (o : Op Q) (ls : Clausula n) (w : List Letter)\n    (s : St Q) (h : s.head = 0) :\n    scan o (ls.flatMap spell ++ .delimiter :: w) s =\n    scan o (.delimiter :: w) (lits o ls s) := by\n  induction ls generalizing s with\n  | nil => rfl\n  | cons l ls ih =>\n    simp only [List.flatMap_cons,spell,List.append_assoc,List.singleton_append,ticks,scan]\n    change scan o (ls.flatMap spell ++ .delimiter :: w)\n        (atSign o {s with head:=s.head+l.var.val} l.pos (delimiterNext (ls.flatMap spell ++ .delimiter :: w))) = _\n    rw [h,Nat.zero_add,next_lit]\n    simp only [atSign,home_trace,lits,applyLit]\n    apply ih _ rfl\n\nprivate theorem lits_home {Q n} (o : Op Q) (ls : Clausula n) (s : St Q) (h : s.head=0) :\n    (lits o ls s).head=0 := by\n  induction ls generalizing s with | nil => exact h | cons l ls ih => exact ih _ rfl\n\ntheorem raw_clauses {Q n} (o : Op Q) (p : CNF n) (s : St Q) (h : s.head=0) :\n    scan o (original p) s = clauses o p s := by\n  induction p generalizing s with\n  | nil => rfl\n  | cons c p ih =>\n    change scan o ((c.flatMap spell ++ [.delimiter]) ++ original p) s = _\n    rw [List.append_assoc,List.singleton_append,raw_lits o c _ s h]\n    exact ih _ (lits_home o c s h)\n\ndef profileOp : Op Unit :=\n  ⟨fun _ pos unit cell _ => (join cell (mark pos unit),()),id⟩\ndef start {Q} (t : Bank) (q : Q) : St Q := ⟨t,q,true,0⟩\ndef emptyBank : Bank := fun _ => blank\n\nprivate theorem profile_lits {n} (ls : Clausula n) (s :