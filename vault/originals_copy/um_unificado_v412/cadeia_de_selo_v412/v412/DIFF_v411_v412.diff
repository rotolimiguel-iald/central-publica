+    'TGLExt/CanalDaClausula.lean': 'import TGLExt.ClausulaComoResposta\nimport TGLExt.TransporteDaInscricao\nimport TGLExt.EcoDaAtribuicao\n\n/-! The learned object is the original signed clause. Each reply is sent\non its own binary PsiBit channel. The source starts on the selected clause.\nFraming, search, proposal production and preparation of that source tape\nare separate operations. No concatenated transcript is supplied for free. -/\nset_option autoImplicit false\nnamespace Codex.ClauseChannel\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha Codex.InscriptionWire Codex.ClauseReply\nvariable {n : Nat}\n\ndef replyMoves (rewind : Bool) (c : Clausula n) : Nat :=\n  let w := spellClause c\n  let k := 2*w.length+1\n  shifts txStep txMoved k (.fetch w []) +\n    (if rewind then (encode w).length else 0) +\n    shifts rxStep rxMoved k (.first (encode w) [])\n\ntheorem receive_clause (c : Clausula n) :\n    let w := spellClause c\n    rxStep^[2*w.length+1] (.first (encode w) []) = .stop w.reverse := by\n  simpa using (receive (spellClause c) []).1\n\nprivate theorem price (rewind : Bool) (c : Clausula n) :\n    replyMoves rewind c = (if rewind then 8 else 6)*(spellClause c).length := by\n  have tx := (transmit (spellClause c) []).2\n  have rx := (receive (spellClause c) []).2\n  cases rewind <;> simp [replyMoves,tx,rx,encoded_length] <;> omega\n\nprivate theorem all_prices (r : Bool) (cs : CNF n) :\n    (cs.map (replyMoves r)).sum = (if r then 8 else 6)*(original cs).length := by\n  induction cs with\n  | nil => simp [original]\n  | cons c cs ih =>\n    change replyMoves r c + (cs.map (replyMoves r)).sum =\n      (if r then 8 else 6)*(spellClause c ++ original cs).length\n    rw [price, ih, List.length_append, Nat.mul_add]\n\n/-- The sum counts the actual head shifts for each returned packet, including\nits own rewind when requested. No hypothesis about proposal quality is needed. -/\ntheorem feedback_budget (rewind : Bool) (p : Proposer n) (a b : CNF n) :\n    ((protocol p a b).replies.map (replyMoves rewind)).sum ≤\n      (if rewind then 8 else 6)*(original b).length := by\n  rw [all_prices]\n  exact Nat.mul_le_mul_left _ (reply_bounds p (b.length+1) a b).2\n\n/-- The bottleneck already occurs on the special split with no remote clauses. -/\ntheorem no_pending_challenge (p : Proposer n) (a : CNF n) :\n    (protocol p a []).calls = 1 ∧\n    (∀ x, (protocol p a []).result = .found x ↔ p a = some x) := by\n  cases h : p a <;> simp [protocol, run, inspect, h]\n\nend Codex.ClauseChannel\n',
+    'TGLExt/DesafioNaFitaOriginal.lean': "import TGLExt.LocalizaARecusa\nimport TGLExt.CanalDaClausula\n\n/-! The receiver can retain one immutable copy of its formula. All failed\nclauses may be selected from that copy. Model selection belongs to the\nproposer. The cost below sums only the actual locator sweeps. -/\nset_option autoImplicit false\nnamespace Codex.FixedChallenge\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula Codex.ClauseReply\nopen Codex.PolinomioPorEscolha (original spellClause)\nopen Codex.ClauseLocator (locate)\nvariable {n : Nat}\n\ndef firstBad (q : CNF n) (x : Assignment n) := q.find? (fun c => !(satisfeita c x))\n\nprivate theorem inspect_first (x : Assignment n) (q : CNF n) :\n    (inspect x q).map Prod.fst = firstBad q x := by\n  induction q with\n  | nil => rfl\n  | cons c q ih =>\n    cases h : satisfeita c x <;> cases e : inspect x q <;> simp_all [inspect,firstBad,List.find?]\n\n/-- Execution over a fixed right-hand spelling, including the actual\nlocator cost of each proposal whose bit tape is ready at its origin. -/\ndef fixedRun (p : Proposer n) (base : CNF n) : Nat → CNF n → Report n × Nat\n  | 0, _ => (⟨.exhausted,[],0⟩,0)\n  | k+1, a =>\n    match p a with\n    | none => (⟨.unsat,[],1⟩,0)\n    | some x =>\n      let price := (locate (List.ofFn x) [] (original base)).2\n      match firstBad base x with\n      | none => (⟨.found x,[],1⟩,price)\n      | some c =>\n        let r := fixedRun p base k (c::a)\n        (learned c r.1, price + r.2)\n\ntheorem raw_reply (base : CNF n) (x : Assignment n) :\n    (locate (List.ofFn x) [] (original base)).1 = (firstBad base x).map spellClause :=\n  Codex.ClauseLocator.first_failed base x\n\nprivate theorem drop_accepted (pre post : CNF n) (c : Clausula n) (x : Assignment n)\n    (ok : satisfeita c x = true) :\n    firstBad (pre ++ c :: post) x = firstBad (pre ++ post) x := by\n  induction pre with\n  | nil => simp [firstBad,ok]\n  | cons h t ih =>\n    cases v : satisfeita h x <;> simp_all [firstBad,List.find?]\n\nprivate theorem couple (p : Proposer n) (hp : Exact p) (base : CNF n)\n    (fuel : Nat) (a q : CNF n)\n    (inv : ∀ y, passes a y = true → firstBad base y = firstBad q y) :\n    (fixedRun p base fuel a).1 = run p fuel a q := by\n  induction fuel generalizing a q with\n  | zero => rfl\n  | succ k ih =>\n    cases prop : p a with\n    | none => simp [fixedRun,run,prop]\n    | some x =>\n      have eq := (inv x (hp.sound _ _ prop)).trans (inspect_first x q).symm\n      cases test : inspect x q with\n      | none => simp [test] at eq; simp [fixedRun,run,prop,test,eq]\n      | some v =>\n        obtain ⟨c,rest⟩ := v\n        simp [test] at eq\n        have nextInv : ∀ y, passes (c::a) y = true → firstBad base y = firstBad rest y := by\n          intro y hit\n          obtain ⟨_,pre,post,old,new⟩ := inspect_some test\n          have h : satisfeita c y = true ∧ passes a y = true := by simpa [passes] using hit\n          rw [inv y h.2, old, new, drop_accepted pre post c y h.1]\n        simp [fixedRun,run,prop,test,eq,ih _ _ nextInv]\n\ntheorem same_protocol (p : Proposer n) (hp : Exact p) (a b : CNF n) :\n    (fixedRun p b (b.length+1) a).1 = protocol p a b :=\n  couple p hp b _ a b (fun _ _ => rfl)\n\ntheorem all_sweeps (p : Proposer n) (b : CNF n) (fuel : Nat) (a : CNF n) :\n    (fixedRun p b fuel a).2 ≤ fuel * (8*(original b).length) := by\n  induction fuel generalizing a with\n  | zero => simp [fixedRun]\n  | succ k ih =>\n    cases prop : p a with\n    | none => simp [fixedRun,prop]\n    | some x =>\n      have price := Codex.ClauseLocator.input_budget (List.ofFn x) (original b)\n      cases test : firstBad b x with\n      | none => simp [fixedRun,prop,test,Nat.succ_mul]; omega\n      | some c =>\n        have tail := ih (c::a)\n        change (fixedRun p b (k+1) a).2 ≤ _\n        calc\n          _ = (locate (List.ofFn x) [] (original b)).2 + (fixedRun p b k (c::a)).2 := by\n            simp only [fixedRun,prop,test]\n          _ ≤ 8*(original b).length + k*(8*(original b).length) := Nat.add_le_add price tail\n          _ = _ := by ring\n\nabbrev Packet := List Codex.PolinomioPorEscolha.Letter\n\n/-- The receiver branches directly on the tape reader's returned packet.\nThe proposer receives its accumulated packets, newest first. The accounting\nfield charges locator heads only. No typed clause search runs in rawRun. -/\ndef rawRun (p : List Packet → Option (Assignment n)) (base : Packet) :\n    Nat → List Packet → Verdict n × List Packet × Nat\n  | 0, _ => (.exhausted,[],0)\n  | k+1, a =>\n    match p a with\n    | none => (.unsat,[],0)\n    | some x =>\n      let z := locate (List.ofFn x) [] base\n      match z.1 with\n      | none => (.found x,[],z.2)\n      | some c =>\n        let r := rawRun p base k (c::a)\n        (r.1,c::r.2.1,z.2+r.2.2)\n\ntheorem packet_execution (p : Proposer n) (wire : List Packet → Option (Assignment n))\n    (same : ∀ a : CNF n, wire (a.map spellClause) = p a)\n    (b : CNF n) (fuel : Nat) (a : CNF n) :\n    let r := fixedRun p b fuel a\n    rawRun wire (original b) fuel (a.map spellClause) =\n      (r.1.result,r.1.replies.map spellClause,r.2) := by\n  induction fuel generalizing a with\n  | zero => rfl\n  | succ k ih =>\n    cases h : p a with\n    | none => simp [rawRun,fixedRun,same,h]\n    | some x =>\n      cases test : firstBad b x with\n      | none => simp [rawRun,fixedRun,same,h,raw_reply,test]\n      | some c =>\n        have tail := ih (c::a)\n        simp only [List.map_cons] at tail\n        simp [rawRun,fixedRun,same,h,raw_reply,test,tail,learned]\n\nend Codex.FixedChallenge\n",
+    'TGLExt/UmaChaveAngular.lean': 'import TGLExt.RelacaoEmFase\nimport TGLExt.CadeiaNaFita\n\n/-! Raw tape to one tagged turn, actual noisy decoder and composition.\nThe rational sample is a channel model; tape execution uses the four-bit\nsymbol. A complete physical truth assignment is never a machine input. -/\nset_option autoImplicit false\nnamespace Codex.SinglePhase\nopen Codex.OrthantRelation\nopen Codex.PolinomioPorEscolha (Letter original)\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\n\ndef slice (sample : ℚ) : Fin 16 :=\n  let tick : ℤ := ⌊16*sample+1/2⌋\n  ⟨(tick % 16).toNat % 16, Nat.mod_lt _ (by decide)⟩\n\ntheorem receives (t : Fin 16) (z : ℚ) (j : ℤ)\n    (h : |z - (turn t + j)| < 1/32) : slice z = t := by\n  obtain ⟨lo,hi⟩ := abs_lt.mp h\n  unfold turn at lo hi\n  have fl : ⌊16*z + 1/2⌋ = (t.val : ℤ) + 16*j := by\n    apply Int.floor_eq_iff.mpr\n    push_cast\n    constructor <;> linarith\n  have ht := t.isLt\n  have modq : ((t.val : ℤ) + 16*j) % 16 = (t.val : ℤ) := by omega\n  apply Fin.ext\n  change (⌊16*z+1/2⌋ % 16).toNat % 16 = t.val\n  rw [fl, modq]\n  exact Nat.mod_eq_of_lt ht\n\ndef fuse (left right : ℚ) : Fin 16 :=\n  phaseTag (join (fromPhase (slice left)) (fromPhase (slice right)))\n\ntheorem fuse_exact (l r : Key) (a b : ℚ) (i j : ℤ) (x y : Bool)\n    (ha : |a - (turn (phaseTag l) + i)| < 1/32)\n    (hb : |b - (turn (phaseTag r) + j)| < 1/32) :\n    atBit (fromPhase (fuse a b)) x y = true ↔\n      ∃ z, atBit l x z = true ∧ atBit r z y = true := by\n  simp only [fuse,receives _ _ _ ha,receives _ _ _ hb,phase_roundtrip,join_iff]\n\ntheorem same_join (l r : Key) : ChainTape.join l r = join l r := rfl\n\ndef keyOf (reg : ChainTape.Reg) := phaseTag (ChainTape.committed reg.acc)\n\ninductive Machine where\n  | walk (s : ChainTape.Reg) (src : List Letter)\n  | halt (tag : Fin 16)\n\ndef step : Machine → Machine\n  | .walk s [] => .halt (keyOf s)\n  | .walk s (a::w) => .walk (ChainTape.see s a) w\n  | .halt t => .halt t\n\ndef moved : Machine