 a)).verb = bitSign (atBit k a true) ∧\n      decodeAmp (codeAmp (angle a)) = v (angle a) := by\n  have nz (b : Bool) : bitSign b ≠ 0 := by cases b <;> decide\n  have repr (a : Bool) : ∃ θ : ℝ, (codeAmp θ).word = bitSign (atBit k a false) ∧\n      (codeAmp θ).verb = bitSign (atBit k a true) := by\n    exact the_orbit_visits_all_four_states _ _ (nz _) (nz _)\n  obtain ⟨lo,lw,lv⟩ := repr false\n  obtain ⟨hi,hw,hv⟩ := repr true\n  refine ⟨fun b => if b then hi else lo, ?_⟩\n  intro a\n  cases a\n  · exact ⟨lw,lv,decodeAmp_codeAmp lo⟩\n  · exact ⟨hw,hv,decodeAmp_codeAmp hi⟩\n\n/-- A single sign pair cannot be an exact free-standing code for all binary relations. -/\ntheorem no_single_orthant :\n    ¬ ∃ (compress : Key → Symbol) (restore : Symbol → Key), ∀ k, restore (compress k) = k := by\n  rintro ⟨compress,restore,h⟩\n  have inj : Function.Injective compress := fun x y e => (h x).symm.trans ((congrArg restore e).trans (h y))\n  have bound := Fintype.card_le_of_injective compress inj\n  exact (by decide : ¬ Fintype.card Key ≤ Fintype.card Symbol) bound\n\ndef equalityCNF : CNF 2 := [[⟨0,false⟩,⟨1,true⟩],[⟨0,true⟩,⟨1,false⟩]]\ndef inequalityCNF : CNF 2 := [[⟨0,true⟩,⟨1,true⟩],[⟨0,false⟩,⟨1,false⟩]]\ndef twoVarKey (p : CNF 2) : Key :=\n  encode (fun a b => passes p (fun i => if i.val=0 then a else b))\n\ndef forbid (k : Key) (a b : Bool) : CNF 2 :=\n  if atBit k a b then [] else [[⟨0,!a⟩,⟨1,!b⟩]]\n\n/-- Conjoin exactly the clauses forbidding the excluded endpoint pairs. -/\ndef materialize (k : Key) : CNF 2 :=\n  forbid k false false ++ forbid k false true ++ forbid k true false ++ forbid k true true\n\ntheorem all_keys_realized (k : Key) :\n    twoVarKey (materialize k) = k ∧ (materialize k).length ≤ 4 := by\n  rcases k with ⟨⟨a,b⟩,⟨c,d⟩⟩\n  cases a <;> cases b <;> cases c <;> cases d <;> decide\n\n/-- Even on two-variable binary CNFs, one orthant cannot recover the\nfour endpoint queries from its signs alone. -/\ntheorem no_single_for_cnf :\n    ¬ ∃ (compress : CNF 2 → Symbol) (restore : Symbol → Key), ∀ p, restore (compress p) = twoVarKey p := by\n  rintro ⟨compress,restore,h⟩\n  apply no_single_orthant\n  exact ⟨fun k => compress (materialize k),restore,fun k => (h _).trans (all_keys_realized k).1⟩\n\ntheorem same_marginals_opposite_entry :\n    (∀ a : Bool, (supported (twoVarKey equalityCNF) a ↔ supported (twoVarKey inequalityCNF) a)) ∧\n    (∀ b : Bool, ((∃ a, atBit (twoVarKey equalityCNF) a b = true) ↔\n                     (∃ a, atBit (twoVarKey inequalityCNF) a b = true))) ∧\n    atBit (twoVarKey equalityCNF) false false = true ∧\n    atBit (twoVarKey inequalityCNF) false false = false := by\n  unfold supported\n  decide\n\n/-- Four consecutive bits carry the two orthants of one complete key. -/\ndef packet (k : Key) := [k.1.1,k.1.2,k.2.1,k.2.2]\ninductive Frame where\n  | ready\n  | first (a : Bool)\n  | half (lo : Symbol)\n  | third (lo : Symbol) (c : Bool)\nabbrev Register := Key × Frame\n\ndef receive (s : Register) (b : Bool) : Register :=\n  match s.2 with\n  | .ready => (s.1,.first b)\n  | .first a => (s.1,.half (a,b))\n  | .half row => (s.1,.third row b)\n  | .third row c => (join s.1 (row,(c,b)),.ready)\n\ntheorem receive_packet (k next : Key) :\n    (packet next).foldl receive (k,.ready) = (join k next,.ready) := by\n  rfl\n\ndef wire (ks : List Key) := ks.flatMap packet\n\ntheorem wire_exact (ks : List Key) (initial : Key) :\n    (wire ks).foldl receive (initial,.ready) = (ks.foldl join initial,.ready) := by\n  induction ks generalizing initial with\n  | nil => rfl\n  | cons k ks ih =>\n    change (packet k ++ wire ks).foldl receive (initial,.ready) = _\n    rw [List.foldl_append,receive_packet]\n    exact ih (join initial k)\n\ntheorem wire_length (ks : List Key) : (wire ks).length = 4 * ks.length := by\n  induction ks with\n  | nil => rfl\n  | cons k ks ih =>\n    change (packet k ++ wire ks).length = 4*(ks.length+1)\n    rw [List.length_append,ih]\n    change 4 + 4*ks.length = _\n    omega\n\ninductive Machine where\n  | walk (s : Register) (unread : List Bool)\n  | halt (s : Register)\n\ndef step : Machine → Machine\n  | .walk s (b::w) => .walk (receive s b) w\n  | .walk s [] => .halt s\n  | .halt s => .halt s\n\ndef travel : Nat → Machine → Nat\n  | 0,_ => 0\n  | t+1, m => (match m with | .walk _ (_::_) => 1 | _ => 0) + travel t (step m)\n\nprivate theorem travel_scan (w : List Bool) (s : Register) :\n    step^[w.length+1] (.walk s w) = .halt (w.foldl receive s) ∧\n    travel (w.length+1) (.walk s w) = w.length := by\n  induction w generalizing s with\n  | nil => exact ⟨rfl,rfl⟩\n  | cons b w ih =>\n    obtain ⟨h,t⟩ := ih (receive s b)\n    constructor\n    · rw [List.length_cons,Function.iterate_succ_apply]\n      exact h\n    · change 1 + travel (w.length+1) (.walk (receive s b) w) = w.length+1\n      omega\n\n/-- Moves from a stream of already computed keys. Proof of\nconstruction costs for a particular raw CNF string belongs to the source reader. -/\ntheorem transmitted_chain (ks : List Key) (initial : Key) :\n    step^[4*ks.length+1] (.walk (initial,.ready) (wire ks)) =\n        .halt (ks.foldl join initial,.ready) ∧\n    travel (4*ks.length+1) (.walk (initial,.ready) (wire ks)) = 4*ks.length ∧\n    ∀ a c, atBit (ks.foldl join initial) a c = true ↔\n      ∃ b, atBit initial a b = true ∧ endToEnd ks b c := by\n  obtain ⟨halt,moves⟩ := travel_scan (wire ks) (initial,.ready)\n  rw [wire_length,wire_exact] at halt\n  rw [wire_length] at moves\n  exact ⟨halt,moves,path_iff ks initial⟩\n\nend Codex.OrthantRelation\n",
+    'TGLExt/RelacaoFronteira.lean': "import TGLExt.OResumoEPsiBit\nimport TGLExt.PontePalavraVerbo\n\n/-! Leitor discreto da Palavra. Cada linha verdadeira da tabela representa uma atribuição\nda fronteira extensível ao prefixo. A implementação materializa a nova lista a partir\nda lista anterior. As duas leituras de uma variável são alternativas sobre o mesmo\ncontexto; nenhuma cláusula é distribuída contra outra. -/\nnamespace IALD.RelacaoFronteira\n\nopen TGLExt.TraducaoTuring TGLExt.OResumoEPsiBit IALD.LeitorDaFormula\nopen TGLExt.OPsibitEACompressao\n\nabbrev Assignment (n : ℕ) := Fin n → Bool\n\ndef agree {n} (s : Finset (Fin n)) (x y : Assignment n) : Prop :=\n  ∀ i ∈ s, x i = y i\n\nprivate theorem restrictAgree {n} {s t : Finset (Fin n)} (h : s ⊆ t)\n    {x y : Assignment n} (a : agree t x y) : agree s x y :=\n  fun i hi => a i (h hi)\n\nprivate theorem flipAgree {n} {s : Finset (Fin n)} {x y : Assignment n}\n    (a : agree s x y) : agree s y x := fun i hi => (a i hi).symm\n\nprivate theorem chainAgree {n} {s : Finset (Fin n)} {x y z : Assignment n}\n    (a : agree s x y) (b : agree s y z) : agree s x z :=\n  fun i hi => (a i hi).trans (b i hi)\n\ndef keys {n} (s : Finset (Fin n)) : List (Fin n) :=\n  (List.finRange n).filter (fun i => decide (i ∈ s))\n\n@[simp] theorem mem_keys {n} {s : Finset (Fin n)} {i : Fin n} :\n    i ∈ keys s ↔ i ∈ s := by simp [keys]\n\ndef agrees {n} (s : Finset (Fin n)) (x y : Assignment n) : Bool :=\n  (keys s).all (fun i => x i == y i)\n\n@[simp] theorem agrees_spec {n} (s : Finset (Fin n)) (x y : Assignment n) :\n    agrees s x y = true ↔ agree s x y := by simp [agrees, agree, List.all_eq_true]\n\ndef enumerate {n} : List (Fin n) → List (Assignment n)\n  | [] => [fun _ => false]\n  | i :: tail => (enumerate tail).flatMap (fun z => [Function.update z i false, Function.update z i true])\n\nprivate theorem enumerate_complete {n} (is : List (Fin n)) (x : Assignment n) :\n    ∃ y ∈ enumerate is, ∀ i ∈ is, y i = x i := by\n  induction is with\n  | nil => exact ⟨_, List.mem_cons_self, by simp⟩\n  | cons i is ih =>\n    obtain ⟨y, hy, he⟩ := ih\n    refine ⟨Function.update y i (x i), List.mem_flatMap.mpr ⟨y,hy,?_⟩, ?_⟩\n    · cases h : x i <;> simp\n    · intro j hj\n      by_cases e : j = i\n      · subst j; simp\n      · rw [Function.update_of_ne e]\n        exact he j ((List.mem_cons.mp hj).resolve_left e)\n\ndef cells {n} (s : Finset (Fin n)) : List (Assignment n) := enumerate (keys s)\n\ntheorem cells_cover {n} (s : Finset (Fin n)) (x : Assignment n) :\n    ∃ y ∈ cells s, agree s y x := by\n  obtain ⟨y,hm,ha⟩ := enumerate_complete (keys s) x\n  exact ⟨y,hm,fun i hi => ha i (mem_keys.mpr hi)⟩\n\nprivate theorem enumerate_length {n} (is : List (Fin n)) :\n    (enumerate is).length = 2 ^ is.length := by\n  induction is with\n  | nil => rfl\n  | cons i is ih =>\n    simp [enumerate, List.length_flatMap, ih, Nat.pow_succ, Nat.mul_comm]\n\ntheorem cells_length {n} (s : Finset (Fin n)) :\n    (cells s).length = 2 ^ s.card := by\n  rw [cells, enumerate_length]\n  congr 1\n  have nd : (keys s).Nodup := (List.nodup_finRange n).filter _\n  have hs : (keys s).toFinset = s := by ext; simp\n  exact (List.toFinset_card_of_nodup nd).symm.trans (congrArg Finset.card hs)\n\ndef lookup {n} (s : Finset (Fin n)) (rows : List (Assignment n)) (x : Assignment n) : Bool :=\n  rows.any (fun y => agrees s y x)\n\n@[simp] theorem lookup_spec {n} (s : Finset (Fin n)) (rows : List (Assignment n)) (x : Assignment n) :\n    lookup s rows x = true ↔ ∃ y ∈ rows, agree s y x := by\n  simp [lookup, List.any_eq_true]\n\nprivate theorem lookup_transport {n} {s : Finset (Fin n)} {rows : List (Assignment n)}\n    {x y : Assignment n} (ha : agree s x y) (hx : lookup s rows x = true) :\n    lookup s rows y = true := by\n  obtain ⟨w,hw,he⟩ := (lookup_spec ..).mp hx\n  exact (lookup_spec ..).mpr ⟨w,hw,chainAgree he ha⟩\n\ndef bag {n} (s t : Finset (Fin n)) (c : Clausula n) := s ∪ t ∪ varsClausula c\n\n/-- Restrição à célula seguinte, teste da cláusula lida e projeção das variáveis esquecidas. -/\ndef advance {n} (s t : Finset (Fin n)) (c : Clausula n)\n    (old : List (Assignment n)) : List (Assignment n) :=\n  (cells t).filter (fun u => (cells (bag s t c)).any (fun z =>\n    lookup s old z && satisfeita c z && agrees t z u))\n\ntheorem advance_length {n} (s t : Finset (Fin n)) (c : Clausula n) (old : List (Assignment n)) :\n    (advance s t c old).length ≤ 2 ^ t.card := by\n  rw [← cells_length t]\n  exact List.length_filter_le ..\n\ntheorem advance_spec {n} (s t : Finset (Fin n)) (c : Clausula n)\n    (old : List (Assignment n)) (u : Assignment n) :\n    lookup t (advance s t c old) u = true ↔\n    ∃ z, lookup s old z = true ∧ satisfeita c z = true ∧ agree t z u := by\n  rw [lookup_spec]\n  simp only [advance, List.mem_filter, List.any_eq_true, Bool.and_eq_true, agrees_spec]\n  constructor\n  · rintro ⟨v,⟨_,z,_,⟨ho,hc⟩,hv⟩,hu⟩\n    exact ⟨z,ho,hc,chainAgree hv hu⟩\n  · rintro ⟨z,ho,hc,hu⟩\n    obtain ⟨v,hv,hvu⟩ := cells_cover t u\n    obtain ⟨w,hw,hwz⟩ := cells_cover (bag s t c) z\n    have hs : s ⊆ bag s t c := by intro i hi; simp [bag,hi]\n    have ht : t ⊆ bag s t c := by intro i hi; simp [bag,hi]\n    have hcl : varsClausula c ⊆ bag s t c := by intro i hi; simp [bag,hi]\n    refine ⟨v,⟨hv,w,hw,⟨lookup_transport (flipAgree (restrictAgree hs hwz)) ho,?_⟩,\n      chainAgree (chainAgree (restrictAgree ht hwz) hu) (flipAgree hvu)⟩,hvu⟩\n    exact (satisfeita_so_ve_as_suas_variaveis c (restrictAgree hcl hwz)).trans hc\n\ndef boundary {n} (p rest : CNF n) := varsDas p ∩ varsDas rest\n\ntheorem boundary_eq_kimi {n} (φ : CNF n) (j : ℕ) :\n    boundary (φ.take j) (φ.drop j) = fronteira φ j := rfl\n\ndef valid {n} (p rest : CNF n) (rows : List (Assignment n)) : Prop :=\n  ∀ u, lookup (boundary p rest) rows u = true ↔\n    ∃ x, passes p x = true ∧ agree (boundary p rest) x u\n\nprivate theorem prefix_congr {n} (p : CNF n) {x y : Assignment n}\n    (h : agree (varsDas p) x y) : passes p x = passes p y := by\n  apply Bool.eq_iff_iff.mpr\n  simp only [passes, List.all_eq_true]\n  apply forall_congr'\n  intro c\n  apply forall_congr'\n  intro hc\n  rw [satisfeita_so_ve_as_suas_variaveis c (fun i hi => h i (mem_varsDas_of_mem hc hi))]\n\nprivate theorem holds_append {n} (p : CNF n) (c : Clausula n) (x : Assignment n) :\n    passes (p ++ [c]) x = (passes p x && satisfeita c x) := by simp [passes]\n\n/-- A preservação das correlações: a mesma atribuição satisfaz o prefixo e a cláusula.\nQuando duas testemunhas concordam no corte, colam-se nas variáveis compartilhadas. -/\ntheorem advance_valid {n} (p rest : CNF n) (c : Clausula n) (rows : List (Assignment n))\n    (H : valid p (c :: rest) rows) :\n    valid (p ++ [c]) rest\n      (advance (boundary p (c :: rest)) (boundary (p ++ [c]) rest) c rows) := by\n  intro u\n  rw [advance_spec]\n  constructor\n  · rintro ⟨z,ho,hcz,hu⟩\n    obtain ⟨w,hw,hwz⟩ := (H z).mp ho\n    let y : Assignment n := fun i => if i ∈ varsDas p then w i else z i\n    have hp : agree (varsDas p) y w := by intro i hi; simp [y,hi]\n    have hf : agree (varsDas (c :: rest)) y z := by\n      intro i hi\n      by_cases hi' : i ∈ varsDas p\n      · simpa [y,hi'] using hwz i (Finset.mem_inter.mpr ⟨hi',hi⟩)\n      · simp [y,hi']\n    have hcl : varsClausula c ⊆ varsDas (c :: rest) := fun _ hi =>\n      mem_varsDas_of_mem List.mem_cons_self hi\n    have hr : varsDas rest ⊆ varsDas (c :: rest) := by\n      intro i hi\n      change i ∈ varsClausula c ∪ varsDas rest\n      exact Finset.mem_union_right _ hi\n    refine ⟨y,?_,?_⟩\n    · rw [holds_append, Bool.and_eq_true]\n      exact ⟨(prefix_congr p hp).trans hw,\n        (satisfeita_so_ve_as_suas_variaveis c (restrictAgree hcl hf)).trans hcz⟩\n    · exact chainAgree (restrictAgree (fun _ hi => hr (Finset.mem_inter.mp hi).2) hf) hu\n  · rintro ⟨x,hx,hu⟩\n    rw [holds_append, Bool.and_eq_true] at hx\n    exact ⟨x,(H x).mpr ⟨x,hx.1,fun _ _ => rfl⟩,hx.2,hu⟩\n\ndef zero {n : ℕ} : Assignment n := fun _ => false\n\ntheorem initial_valid {n} (rest : CNF n) : valid [] rest [zero] := by\n  intro u\n  simp [lookup, agrees, boundary, varsDas, keys, passes, agree]\n\n/-- Leitor em ordem de cláusulas. A tabela é uma lista materializada de células aceitas. -/\ndef scan {n} (p : CNF n) (rows : List (Assignment n)) : CNF n → List (Assignment n)\n  | [] => rows\n  | c :: rest => scan (p ++ [c])\n      (advance (boundary p (c :: rest)) (boundary (p ++ [c]) rest) c rows) rest\n\ntheorem scan_spec {n} (p rest : CNF n) (rows : List (Assignment n)) (h : valid p rest rows) :\n    lookup ∅ (scan p rows rest) zero = true ↔ SAT (p ++ rest) := by\n  induction rest generalizing p rows with\n  | nil =>\n    have hh := h zero\n    simpa [scan, boundary, varsDas, agree, sat_iff] using hh\n  | cons c rest ih =>\n    simpa only [scan, List.append_assoc, List.singleton_append] using ih (p ++ [c]) _\n      (advance_valid p rest c rows h)\n\n/-- Nenhuma atribuição global nem peso é entrada do leitor. -/\ndef read {n} (φ : CNF n) : Bool := lookup ∅ (scan [] [zero] φ) zero\n\ntheorem read_spec {n} (φ : CNF n) : read φ = true ↔ SAT φ := by\n  simpa [read] using scan_spec [] φ _ (initial_valid φ)\n\ntheorem read_word {n} (φ : CNF n) (s : ℝ) (hs : (n:ℝ) * Real.log 2 < s) :\n    read φ = true ↔ palavra (custoCNF φ) s := (read_spec φ).trans (a_palavra_decide n hs φ)\n\nend IALD.RelacaoFronteira\n",
+    'TGLExt/CustoDaTabela.lean': "import TGLExt.RelacaoFronteira\nimport Mathlib.Analysis.SpecificLimits.Normed\n\n/-! This concerns the explicitly materialized rows of this algorithm. The family is\neasy if its repeated long clause is handled symbolically. -/\nnamespace IALD.CustoDaTabela\nopen IALD.RelacaoFronteira IALD.LeitorDaFormula TGLExt.TraducaoTuring TGLExt.OResumoEPsiBit\n\ndef wide (n : ℕ) : Clausula (n+1) := (List.finRange (n+1)).map (fun i => ⟨i,true⟩)\n\ntheorem wide_vars (n : ℕ) : varsClausula (wide n) = Finset.univ := by\n  ext i\n  simp [wide,varsClausula,List.map_map,Function.comp_def]\n\ntheorem cut (n : ℕ) : boundary [wide n] [wide n] = Finset.univ := by\n  simp [boundary,varsDas,wide_vars]\n\ntheorem wide_passes (n : ℕ) (x : Assignment n) :\n    passes [wide n] (Fin.cases true x) = true := by\n  change ([wide n] : CNF (n+1)).all _ = true\n  simp only [List.all_cons,List.all_nil,Bool.and_true]\n  apply List.any_eq_true.mpr\n  exact ⟨⟨0,true⟩,List.mem_map.mpr ⟨0, List.mem_finRange _,rfl⟩,rfl⟩\n\n/-- After the first of two equal positive clauses, every assignment with first\nbit true is an actual, distinct *accepted* row, even if the table keeps only successes. -/\ntheorem required_rows (n : ℕ) (rows : List (Assignment (n+1)))\n    (good : valid [wide n] [wide n] rows) : 2 ^ n ≤ rows.length := by\n  classical\n  have hm (x : Assignment n) : Fin.cases true x ∈ rows := by\n    have hit := (good (Fin.cases true x)).mpr ⟨_,wide_passes n x, fun _ _ => rfl⟩\n    obtain ⟨y,hy,ha⟩ := (lookup_spec ..).mp hit\n    have he : y = Fin.cases true x := funext fun i => ha i (by rw [cut]; exact Finset.mem_univ _)\n    rwa [← he]\n  let code : Assignment n → ↥rows.toFinset := fun x => ⟨Fin.cases true x,List.mem_toFinset.mpr (hm x)⟩\n  have inj : Function.Injective code := by\n    intro a b h\n    have eq := congrArg Subtype.val h\n    exact funext fun i => congrFun eq i.succ\n  have hc := Fintype.card_le_of_injective code inj\n  calc\n    2 ^ n = Fintype.card (Assignment n) := by simp [Assignment]\n    _ ≤ Fintype.card ↥rows.toFinset := hc\n    _ ≤ rows.length := by\n      rw [Fintype.card_coe]\n      exact List.toFinset_card_le rows\n\ndef firstRows (n : ℕ) := advance (boundary [] [wide n,wide n]) (boundary [wide n] [wide n])\n    (wide n) [zero]\n\ntheorem actual_rows (n : ℕ) : 2 ^ n ≤ (firstRows n).length :=\n  required_rows n _ (advance_valid [] [wide n] (wide n) [zero] (initial_valid _))\n\n/-- Fixed finite alphabet. Unary indices, a sign terminating each literal, and one\nend marker per clause give a self-delimiting word. Variables are numbered from zero. -/\ninductive Mark | tick | pos | neg | stop deriving DecidableEq\ndef encodeClause {n : ℕ} (c : Clausula n) : List Mark :=\n  c.flatMap (fun l => List.replicate l.var.val .tick ++ [if l.pos then .pos else .neg]) ++ [.stop]\ndef input (n : ℕ) : List Mark := encodeClause (wide n) ++ encodeClause (wide n)\n\nprivate theorem literalTapeBound {n : ℕ} (c : Clausula n) :\n    (c.flatMap (fun l => List.replicate l.var.val Mark.tick ++ [if l.pos then .pos else .neg])).length ≤ c.length * n := by\n  induction c with\n  | nil => simp\n  | cons l c ih =>\n    simp only [List.flatMap_cons,List.length_append,List.length_replicate,List.length_cons,List.length_nil]\n    rw [Nat.add_mul]\n    have hv := l.var.isLt\n    omega\n\ntheorem short_input (n : ℕ) : (input n).length ≤ 2*((n+1)^2+1) := by\n  have hb := literalTapeBound (wide n)\n  have hl : (wide n).length = n+1 := by simp [wide]\n  rw [hl] at hb\n  simp only [input,encodeClause,List.length_append,List.length_cons,List.length_nil]\n  rw [pow_two]\n  omega\n\n/-- An explicit failure of every input-length polynomial for THIS row materialization. -/\ntheorem no_uniform_row_polynomial (C d : ℕ) :\n    ∃ n, C * (input n).length ^ d < (firstRows n).length := by\n  have ha : ∀ᶠ n : ℕ in Filter.atTop,\n      (n : ℝ)^(2*d) / (2:ℝ)^n < 1 / ((C:ℝ)*10^d+1) :=\n    (tendsto_pow_const_div_const_pow_of_one_lt (2*d) (by norm_num : (1:ℝ)<2)).eventually_lt_const\n      (by positivity)\n  obtain ⟨n,hn,he⟩ := (ha.and (Filter.eventually_ge_atTop 1)).exists\n  have hx : (input n).length ≤ 10*n^2 := by\n    have h := short_input n\n    have sq : n ≤ n^2 := by simpa [pow_two] using Nat.mul_le_mul_left n he\n    nlinarith\n  have hpos : 0 < (2:ℝ)^n := by positivity\n  have hp : 0 < (C:ℝ)*10^d+1 := by positivity\n  have hn' := (div_lt_div_iff₀ hpos hp).mp hn\n  have hN : (C:ℝ)*10^d*(n:ℝ)^(2*d) < (2:ℝ)^n := by\n    nlinarith [show 0 ≤ (n:ℝ)^(2*d) by positivity]\n  have hnat : C*(10*n^2)^d < 2^n := by\n    exact_mod_cast (by simpa [mul_pow, ← pow_mul, mul_assoc] using hN :\n      ((C:ℝ)*(10*(n:ℝ)^2)^d < (2:ℝ)^n))\n  exact ⟨n,lt_of_le_of_lt (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hx d)) (lt_of_lt_of_le hnat (actual_rows n))⟩\n\nend IALD.CustoDaTabela\n",
+    'TGLExt/PsiBitNaFronteira.lean': 'import TGLExt.RelacaoFronteira\nimport TGLExt.ParPonderado\n\n/-! A finite four-letter implementation for decision; an exact weighted contraction is\na separate mathematical identity. No real operation is used by the discrete reader. -/\nnamespace IALD.PsiBitNaFronteira\nopen TGLExt.TraducaoTuring TGLExt.Psibit TGLExt.OResumoEPsiBit\nopen IALD.LeitorDaFormula IALD.RelacaoFronteira\n\ninductive Letter | neither | left | right | both deriving DecidableEq, Repr\n\ndef encode : Bool → Bool → Letter\n  | false, false => .neither\n  | true, false => .left\n  | false, true => .right\n  | true, true => .both\n\ndef bits : Letter → Bool × Bool\n  | .neither => (false,false)\n  | .left => (true,false)\n  | .right => (false,true)\n  | .both => (true,true)\n\n@[simp] theorem bits_encode (a b : Bool) : bits (encode a b) = (a,b) := by\n  cases a <;> cases b <;> rfl\n\n/-- A concrete amplitude on the canonical unit orbit for each letter.\nIts positive squared first coordinate is always 9/25; only the signs vary. -/\nnoncomputable def amplitude (a : Letter) : ℝ × ℝ :=\n  (if (bits a).1 then 3/5 else -(3/5), if (bits a).2 then 4/5 else -(4/5))\n\ntheorem canonical_reading (a : Letter) :\n    ∃ θ : ℝ, v θ = amplitude a ∧\n      (codeAmp θ).word = bitSign (bits a).1 ∧\n      (codeAmp θ).verb = bitSign (bits a).2 ∧\n      (codeAmp θ).weight = 9/25 ∧ decodeAmp (codeAmp θ) = amplitude a := by\n  have h : amplitude a ∈ UnitVec := by\n    change (amplitude a).1 ^ 2 + (amplitude a).2 ^ 2 = 1\n    cases a <;> norm_num [amplitude,bits]\n  obtain ⟨θ,he⟩ := exists_angle_of_unit h\n  refine ⟨θ,he,?_,?_,?_,(decodeAmp_codeAmp θ).trans he⟩\n  all_goals rw [codeAmp, he]\n  all_goals cases a <;> norm_num [codeOf, amplitude, bits, bitSign, SignType.sign]\n\ndef accepts : Letter → Bool\n  | .neither => false\n  | _ => true\n\n@[simp] theorem accepts_encode (a b : Bool) : accepts (encode a b) = (a || b) := by\n  cases a <;> cases b <;> rfl\n\ndef testRow {n} (s t : Finset (Fin n)) (c : Clausula n) (old : List (Assignment n))\n    (target x : Assignment n) : Bool :=\n  lookup s old x && satisfeita c x && agrees t x target\n\nprivate theorem testRow_congr {n} (s t : Finset (Fin n)) (c : Clausula n)\n    (old : List (Assignment n)) (target x y : Assignment n)\n    (h : agree (bag s t c) x y) : testRow s t c old target x = testRow s t c old target y := by\n  have hs (i) (hi : i ∈ s) := h i (show i ∈ bag s t c by simp [bag,hi])\n  have ht (i) (hi : i ∈ t) := h i (show i ∈ bag s t c by simp [bag,hi])\n  have hc (i) (hi : i ∈ varsClausula c) := h i (show i ∈ bag s t c by simp [bag,hi])\n  apply Bool.eq_iff_iff.mpr\n  simp only [testRow,Bool.and_eq_true,lookup_spec,agrees_spec,satisfeita_so_ve_as_suas_variaveis c hc]\n  constructor\n  · rintro ⟨⟨⟨r,hr,ha⟩,hv⟩,hb⟩\n    exact ⟨⟨⟨r,hr,fun i hi => (ha i hi).trans (hs i hi)⟩,hv⟩,fun i hi => (ht i hi).symm.trans (hb i hi)⟩\n  · rintro ⟨⟨⟨r,hr,ha⟩,hv⟩,hb⟩\n    exact ⟨⟨⟨r,hr,fun i hi => (ha i hi).trans (hs i hi).symm⟩,hv⟩,fun i hi => (ht i hi).trans (hb i hi)⟩\n\n/-- Both branches use exactly the same outside assignment z and new-row target u. -/\ndef letterAt {n} (s t : Finset (Fin n)) (c : Clausula n) (old : List (Assignment n))\n    (u z : Assignment n) (i : Fin n) : Letter :=\n  encode (testRow s t c old u (Function.update z i false))\n         (testRow s t c old u (Function.update z i true))\n\ndef visitPairs {n} (s t : Finset (Fin n)) (c : Clausula n) (old : List (Assignment n))\n    (u : Assignment n) (i : Fin n) : Bool :=\n  (cells ((bag s t c).erase i)).any (fun z => accepts (letterAt s t c old u z i))\n\ntheorem visitPairs_spec {n} (s t : Finset (Fin n)) (c : Clausula n) (old : List (Assignment n))\n    (u : Assignment n) (i : Fin n) :\n    visitPairs s t c old u i = true ↔ ∃ x, testRow s t c old u x = true := by\n  simp only [visitPairs,List.any_eq_true,letterAt,accepts_encode,Bool.or_eq_true]\n  constructor\n  · rintro ⟨z,_,h | h⟩\n    · exact ⟨_,h⟩\n    · exact ⟨_,h⟩\n  · rintro