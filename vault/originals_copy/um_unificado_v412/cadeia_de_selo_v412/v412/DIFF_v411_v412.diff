+    'TGLExt/FatoresCruzados.lean': 'import TGLExt.ParesIndependentes\nimport TGLExt.RotulosCompartilhados\n\n/-! Boolean sum-product factors with a shared physical variable per label.\nIn a clause the running bond is a Bool: at least one literal has passed.\nDifferent clauses need not have disjoint scopes. -/\nnamespace IALD.FatoresCruzados\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\n\nabbrev Env (n : Nat) := Fin n → Bool\n\n/-- Boolean tensor contraction over exactly two values of the shared bond. -/\ndef join (a b : ParesIndependentes.Mask) : ParesIndependentes.Mask := ParesIndependentes.table fun i j =>\n  (ParesIndependentes.read a i false && ParesIndependentes.read b false j) || (ParesIndependentes.read a i true && ParesIndependentes.read b true j)\n\n/-- The two-by-two transition matrix for updating the "seen true" flag. -/\ndef flag (hit : Bool) : ParesIndependentes.Mask := ParesIndependentes.table (fun i j => j == (i || hit))\n\ntheorem flag_product (a b : Bool) : join (flag a) (flag b) = flag (a || b) := by\n  cases a <;> cases b <;> rfl\n\nstructure Core (n : Nat) where\n  label : Fin n\n  onFalse : ParesIndependentes.Mask\n  onTrue : ParesIndependentes.Mask\n\ndef compileLit {n} (l : Literal n) : Core n :=\n  ⟨l.var,flag (false == l.pos),flag (true == l.pos)⟩\ndef evaluate {n} (g : Core n) (x : Env n) := if x g.label then g.onTrue else g.onFalse\n\ntheorem core_spec {n} (l : Literal n) (x : Env n) :\n    evaluate (compileLit l) x = flag (l.vale x) := by\n  cases h : x l.var <;> simp [evaluate,compileLit,Literal.vale,h]\n\ntheorem core_psibit {n} (l : Literal n) (x : Env n) (incoming : Bool) :\n    ∃ θ : ℝ, (TGLExt.Psibit.codeAmp θ).word =\n      bitSign (ParesIndependentes.read (evaluate (compileLit l) x) incoming false) ∧\n      (TGLExt.Psibit.codeAmp θ).verb =\n      bitSign (ParesIndependentes.read (evaluate (compileLit l) x) incoming true) ∧\n      TGLExt.Psibit.decodeAmp (TGLExt.Psibit.codeAmp θ) = TGLExt.Psibit.v θ :=\n  ParesIndependentes.two_psibits _ _\n\ndef contract {n} (gs : List (Core n)) (x : Env n) :=\n  gs.foldr (fun g acc => join (evaluate g x) acc) (flag false)\n\ntheorem contract_clause {n} (c : Clausula n) (x : Env n) :\n    contract (c.map compileLit) x = flag (satisfeita c x) := by\n  induction c with\n  | nil => rfl\n  | cons l c ih =>\n    change join (evaluate (compileLit l) x) (contract (c.map compileLit) x) =\n      flag (l.vale x || satisfeita c x)\n    rw [core_spec,ih,flag_product]\n\n/-- Literals from any number of pairs, grouped into segments, may be\ncontracted separately under the same x. Each segment still has a two-state bond. -/\ntheorem contract_segments {n} (chunks : List (Clausula n)) (x : Env n) :\n    chunks.foldr (fun c tail => join (contract (c.map compileLit) x) tail) (flag false) =\n      flag (satisfeita chunks.flatten x) := by\n  induction chunks with\n  | nil => rfl\n  | cons c chunks ih =>\n    rw [List.foldr_cons,ih,contract_clause,flag_product]\n    simp [satisfeita]\n\ntheorem regroup {n} (p q : Clausula n) (h : p.Perm q) (x : Env n) :\n    contract (p.map compileLit) x = contract (q.map compileLit) x := by\n  rw [contract_clause,contract_clause]\n  apply congrArg flag\n  exact h.any_eq\n\ndef factorize {n} (p : CNF n) := p.map (List.map compileLit)\ndef output {n} (g : List (Core n)) (x : Env n) := ParesIndependentes.read (contract g x) false true\ndef accept {n} (p : List (List (Core n))) (x : Env n) := p.all (fun g => output g x)\n\ntheorem output_clause {n} (c : Clausula n) (x : Env n) :\n    output (c.map compileLit) x = satisfeita c x := by\n  rw [output,contract_clause]\n  cases h : satisfeita c x <;> rfl\n\ntheorem flat_exact {n} (p : CNF n) (x : Env n) :\n    accept (factorize p) x = passes p x := by\n  induction p with\n  | nil => rfl\n  | cons c p ih =>\n    change (output (c.map compileLit) x && accept (factorize p) x) =\n      (satisfeita c x && passes p x)\n    rw [output_clause,ih]\n\n/-- Intersect even an arbitrary previously correlated relation, pointwise.\nThe old relation and the new clause see the same external variable x[i] at\nevery occurrence; only the internal clause flag is existentially contracted. -/\ntheorem intersect_any {n} (r : Env n → Bool) (c : Clausula n) (x : Env n) :\n    (r x && output (c.map compileLit) x) = (r x && satisfeita c x) := by rw [output_clause]\n\nsection OneCrossing\nopen ParesIndependentes (Mask table read)\n\ndef existsPair (f : Bool → Bool → Bool) :=\n  (f false false || f false true) || (f true false || f true true)\n\nprivate theorem existsPair_spec (f : Bool → Bool → Bool) :\n    existsPair f = true ↔ ∃ a b, f a b = true := by simp [existsPair,Bool.exists_bool]\n\nprivate theorem join_spec (a b : Mask) (i j : Bool) :\n    read (join a b) i j = true ↔ ∃ k, read a i k = true ∧ read b k j = true := by\n  simp [join,Bool.exists_bool]\n\n/-- The first row data is any local correlation. The second says which of\nits four valuations satisfies the literals of the crossing clause at this pair. -/\nabbrev PairData := Mask × Mask\n\ndef eliminatePair (d : PairData) : Mask := table fun i j =>\n  existsPair (fun a b => read d.1 a b && (j == (i || read d.2 a b)))\n\nprivate theorem eliminatePair_spec (d : PairData) (i j : Bool) :\n    read (eliminatePair d) i j = true ↔\n      ∃ a b, read d.1 a b = true ∧ j = (i || read d.2 a b) := by\n  simp [eliminatePair,existsPair_spec]\n\ndef closePairs : List PairData → Mask × Nat\n  | [] => (flag false,0)\n  | d::ds =>\n    let t := closePairs ds\n    (join (eliminatePair d) t.1,t.2+1)\n\ndef trace : List PairData → List (Bool × Bool) → Bool → Bool → Bool\n  | [],[],i,j => j == i\n  | d::ds,(a,b)::cs,i,j =>\n    read d.1 a b && trace ds cs (i || read d.2 a b) j\n  | _,_,_,_ => false\n\ntheorem closePairs_spec (ds : List PairData) (i j : Bool) :\n    read (closePairs ds).1 i j = true ↔ ∃ cs, trace ds cs i j = true := by\n  induction ds generalizing i j with\n  | nil =>\n    constructor\n    · intro h; exact ⟨[],by simpa [closePairs,flag,trace] using h⟩\n    · rintro ⟨cs,h⟩; cases cs <;> simp_all [trace,closePairs,flag]\n  | cons d ds ih =>\n    change read (join (eliminatePair d) (closePairs ds).1) i j = true ↔ _\n    rw [join_spec]\n    constructor\n    · rintro ⟨k,hl,hr⟩\n      obtain ⟨a,b,ha,hk⟩ := (eliminatePair_spec d i k).mp hl\n      obtain ⟨cs,hs⟩ := (ih k j).mp hr\n      exact ⟨(a,b)::cs,by simpa [trace,ha,← hk] using hs⟩\n    · rintro ⟨cs,hs⟩\n      cases cs with\n      | nil => simp [trace] at hs\n      | cons ab cs =>\n        obtain ⟨a,b⟩ := ab\n        simp only [trace,Bool.and_eq_true] at hs\n        exact ⟨_,(eliminatePair_spec _ _ _).mpr ⟨a,b,hs.1,rfl⟩,\n          (ih _ _).mpr ⟨cs,hs.2⟩⟩\n\n/-- Exactly one constant-size pair elimination and one two-by-two matrix\ncontraction at each step. Label axes have already been grouped by pair. -/\ntheorem closePairs_steps (ds : List PairData) : (closePairs ds).2 = ds.length := by\n  induction ds with\n  | nil => rfl\n  | cons d ds ih => simp [closePairs,ih]\n\nend OneCrossing\n\nsection FlatCrossing\nopen ParesIndependentes (State LocalClause splitLit insert rule decode allows flatten)\n\nprivate theorem shared_lit {n} (l : Literal (n+n)) (x y : Env n) :\n    ParesIndependentes.literal (splitLit l).2 (x (splitLit l).1) (y (splitLit l).1) =\n      l.vale (Fin.append x y) := by\n  obtain ⟨i,b⟩ := l\n  cases i using Fin.addCases <;>\n    simp [splitLit,ParesIndependentes.literal,Literal.vale,-Fin.natAdd_eq_addNat]\n\ndef testLiteral {n} (s : State n) (l : Literal (n+n)) : Bool × Nat :=\n  let localLit := splitLit l\n  let updated := insert s localLit.1 (rule [localLit.2])\n  (decode updated.1,updated.2+n)\n\ntheorem literal_witness {n} (s : State n) (l : Literal (n+n)) :\n    (testLiteral s l).1 = true ↔\n    ∃ x y, allows s x y = true ∧ l.vale (Fin.append x y) = true := by\n  simp [testLiteral,ParesIndependentes.decode_spec,ParesIndependentes.insert_spec,\n    rule,ParesIndependentes.localPass,shared_lit]\n\n/-- Flat crossing clause, with no grouping supplied. Try each of its own\nliterals against the same independent-pair state. Short circuit on success.\nThe counter charges addresses actually visited and a full decode scan per try. -/\ndef oneCrossing {n} (s : State n) : Clausula (n+n) → Bool × Nat\n  | [] => (false,0)\n  | l::c =>\n    let a := testLiteral s l\n    if a.1 then a else\n      let b := oneCrossing s c\n      (b.1,a.2+b.2)\n\ntheorem one_witness {n} (s : State n) (c : Clausula (n+n)) :\n    (oneCrossing s c).1 = true ↔\n      ∃ x y, allows s x y = true ∧ satisfeita c (Fin.append x y) = true := by\n  induction c with\n  | nil => simp [oneCrossing,satisfeita]\n  | cons l c ih =>\n    have h₀ := literal_witness s l\n    have disj : (oneCrossing s (l::c)).1 =\n      ((testLiteral s l).1 || (oneCrossing s c).1) := by\n      change (if (testLiteral s l).1 then testLiteral s l else\n        ((oneCrossing s c).1,(testLiteral s l).2+(oneCrossing s c).2)).1 = _\n      cases h : (testLiteral s l).1 <;> simp [h]\n    rw [disj,Bool.or_eq_true,h₀,ih]\n    simp only [satisfeita,List.any_cons,Bool.or_eq_true]\n    aesop\n\ntheorem crossing_charge {n} (s : State n) (c : Clausula (n+n)) :\n    (oneCrossing s c).2 ≤ 2*n*c.length := by\n  induction c with\n  | nil => simp [oneCrossing]\n  | cons l c ih =>\n    have hc : (testLiteral s l).2 ≤ 2*n := by\n      simp only [testLiteral,ParesIndependentes.address_visits]\n      have hi := (splitLit l).1.isLt\n      omega\n    rw [List.length_cons,Nat.mul_succ]\n    change (if (testLiteral s l).1 then testLiteral s l else\n      ((oneCrossing s c).1,(testLiteral s l).2+(oneCrossing s c).2)).2 ≤ _\n    by_cases h : (testLiteral s l).1 = true\n    · rw [if_pos h]; omega\n    · rw [if_neg h]; change (testLiteral s l).2+(oneCrossing s c).2 ≤ _; omega\n\ntheorem one_flat_word {n} (base : List (LocalClause n)) (c : Clausula (n+n)) :\n    (oneCrossing (ParesIndependentes.run base (ParesIndependentes.full n)).1 c).1 =\n      palavraDaFormula (flatten base ++ [c]) := by\n  apply Bool.eq_iff_iff.mpr\n  rw [one_witness,a_palavra_e_o_sat,sat_iff]\n  have hp (z : Env (n+n)) : passes (flatten base ++ [c]) z =\n      (passes (flatten base) z && satisfeita c z) := by simp [passes]\n  simp only [ParesIndependentes.stream_spec,ParesIndependentes.full_allows,Bool.true_and,\n    hp,Bool.and_eq_true,ParesIndependentes.flat_pass]\n  constructor\n  · rintro ⟨x,y,hb,hc⟩\n    exact ⟨Fin.append x y,by simpa only [Fin.append_left,Fin.append_right] using hb,hc⟩\n  · rintro ⟨z,hb,hc⟩\n    exact ⟨_,_,hb,by simpa only [Fin.append_castAdd_natAdd] using hc⟩\n\nend FlatCrossing\n\ndef word {n} (p : List (List (Core n))) := RotulosCompartilhados.search n (accept p)\n\ntheorem global_word {n} (p : CNF n) : word (factorize p) = palavraDaFormula p := by\n  apply Bool.eq_iff_iff.mpr\n  simp only [word,RotulosCompartilhados.search_spec,flat_exact,a_palavra_e_o_sat,sat_iff]\n\ntheorem global_probes {n} (p : CNF n) (h : ¬ SAT p) :\n    RotulosCompartilhados.probes n (accept (factorize p)) = (false,2^n) := by\n  apply RotulosCompartilhados.probes_empty\n  intro x\n  rw [flat_exact]\n  cases hx : passes p x with\n  | false => rfl\n  | true => exact (h ((sat_iff p).2 ⟨x,hx⟩)).elim\n\n/-- Concrete fixed alphabet: binary labels, explicit sign or eight table bits,\nand one end-of-clause symbol. A label\'s terminating marker is common to both. -/\ninductive Mark | digit (b : Bool) | endLabel | bit (b : Bool) | endClause\ndef address (i : Nat) : List Mark := i.bits.map Mark.digit ++ [.endLabel]\ndef packMask (m : ParesIndependentes.Mask) : List Mark :=\n  [.bit m.low.word,.bit m.low.verb,.bit m.high.word,.bit m.high.verb]\ndef orig {n} (l : Literal n) := address l.var.val ++ [.bit l.pos]\ndef serial {n} (g : Core n) := address g.label.val ++ packMask g.onFalse ++ packMask g.onTrue\ndef input {n} (p : CNF n) := p.flatMap (fun c => c.flatMap orig ++ [.endClause])\ndef encoded {n} (p : List (List (Core n))) := p.flatMap (fun c => c.flatMap serial ++ [.endClause])\ndef occurrences {n} (p : CNF n) := (p.map List.length).sum\n\ntheorem local_size {n} (c : Clausula n) :\n    ((c.map compileLit).flatMap serial).length = (c.flatMap orig).length + 7*c.length := by\n  induction c with\n  | nil => rfl\n  | cons l c ih =>\n    simp only [List.map_cons,List.flatMap_cons,List.length_append,serial,compileLit,packMask,\n      List.length_cons,List.length_nil,orig] at ih ⊢\n    omega\n\ntheorem encoded_size {n} (p : CNF n) :\n    (encoded (factorize p)).length = (input p).length + 7*occurrences p := by\n  induction p with\n  | nil => rfl\n  | cons c p ih =>\n    change (((c.map compileLit).flatMap serial ++ [Mark.endClause]) ++ encoded (factorize p)).length =\n      ((c.flatMap orig ++ [Mark.endClause]) ++ input p).length + 7*(c.length+occurrences p)\n    simp only [List.length_append,List.length_cons,List.length_nil,local_size,ih]\n    omega\n\nprivate theorem literals_fit {n} (c : Clausula n) : c.length ≤ (c.flatMap orig).length := by\n  induction c with\n  | nil => rfl\n  | cons l c ih => simp only [List.flatMap_cons,List.length_append,List.length_cons,orig,List.length_nil]; omega\n\ntheorem linear_encoding {n} (p : CNF n) : (encoded (factorize p)).length ≤ 8*(input p).length := by\n  have bound : occurrences p ≤ (input p).length := by\n    induction p with\n    | nil => rfl\n    | cons c p ih =>\n      have h := literals_fit c\n      change c.length+occurrences p ≤ ((c.flatMap orig ++ [Mark.endClause]) ++ input p).length\n      simp only [List.length_append,List.length_cons,List.length_nil]\n      omega\n  rw [encoded_size]\n  omega\n\n/-- For one fixed global assignment, each literal contributes exactly one\n2-by-2 contraction, i.e. eight ANDs and four ORs in the dense implementation.\nNo head-movement or global existential cost is hidden inside this count. -/\ndef metered {n} : List (Core n) → Env n → ParesIndependentes.Mask × Nat\n  | [],_ => (flag false,0)\n  | g::gs,x =>\n    let t := metered gs x\n    (join (evaluate g x) t.1,t.2+12)\n\ntheorem metered_exact {n} (gs : List (Core n)) (x : Env n) :\n    metered gs x = (contract gs x,12*gs.length) := by\n  induction gs with\n  | nil => rfl\n  | cons g gs ih =>\n    simp [metered,ih,contract,Nat.mul_succ]\n\n/-- The pairs (a,b) and (c,d) are both constrained internally to equality.\nTwo genuinely crossing clauses force a and c to disagree, while two others\nforce them to agree. The two crossing blocks separately admit witnesses. -/\ndef xy (a b : Fin 4) (p q : Bool) : Clausula 4 := [⟨a,p⟩,⟨b,q⟩]\ndef equal (a b : Fin 4) : CNF 4 := [xy a b false true,xy a b true false]\ndef differ (a b : Fin 4) : CNF 4 := [xy a b true true,xy a b false false]\ndef seed : CNF 4 := equal 0 1 ++ equal 2 3\n\ntheorem crossing_contradiction :\n    word (factorize (seed ++ equal 0 2)) = true ∧\n    word (factorize (seed ++ differ 0 2)) = true ∧\n    word (factorize (seed ++ equal 0 2 ++ differ 0 2)) = false := by decide\n\nend IALD.FatoresCruzados\n',
+    'TGLExt/SegundaLeitura.lean': 'import TGLExt.DuasPassagens\n\n/-! One physical work tape. The signs and the unit-clause obligations observed\non the original input fix a common assignment away from the pivot. -/\nset_option autoImplicit false\nnamespace Codex.SecondRead\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha Codex.SignProfile Codex.TwoSweeps\n\nstructure Bits where\n  passed : Bool × Bool\n  clause : Bool × Bool\n  deriving DecidableEq, Repr\n\ndef beginBits : Bits := ⟨(true,true),(false,false)⟩\n\ndef choose (zero b : Bool) (cell : Cell) := if zero then b else pick cell\n\ndef readSign (zero pos : Bool) (cell : Cell) (bits : Bits) : Bits :=\n  ⟨bits.passed,\n   (bits.clause.1 || (choose zero false cell == pos),\n    bits.clause.2 || (choose zero true cell == pos))⟩\n\ndef endClause (bits : Bits) : Bits :=\n  ⟨(bits.passed.1 && bits.clause.1,bits.passed.2 && bits.clause.2),(false,false)⟩\n\ndef evalOp : Op Bits :=\n  ⟨fun zero pos _ cell bits => (cell,readSign zero pos cell bits),endClause⟩\n\ndef bankValue {n : Nat} (bank : Bank) (b : Bool) (i : Fin n) : Bool :=\n  choose (i.val == 0) b (bank i.val)\n\nprivate theorem literalState {n : Nat} (l : Literal n) (u : Bool) (st : St Bits) :\n    applyLit evalOp l u st =\n    ⟨st.bank,readSign (l.var.val == 0) l.pos (st.bank l.var.val) st.control,false,0⟩ := by\n  simp [applyLit,evalOp]\n\nprivate theorem literalList {n : Nat} (ls : Clausula n) (st : St Bits) :\n    (lits evalOp ls st).bank = st.bank ∧\n    (lits evalOp ls st).control = ⟨st.control.passed,\n      (st.control.clause.1 || satisfeita ls (bankValue st.bank false),\n       st.control.clause.2 || satisfeita ls (bankValue st.bank true))⟩ := by\n  induction ls generalizing st with\n  | nil =>\n    cases st with | mk t q f j => cases q; simp [lits,satisfeita]\n  | cons l ls ih =>\n    rw [lits,literalState]\n    obtain ⟨t,q⟩ := ih ⟨st.bank,readSign (l.var.val == 0) l.pos (st.bank l.var.val) st.control,false,0⟩\n    refine ⟨t,?_⟩\n    rw [q]\n    simp [readSign,satisfeita,Literal.vale,bankValue,Bool.or_assoc]\n\nprivate theorem evalClauses {n : Nat} (p : CNF n) (st : St Bits)\n    (fresh : st.control.clause = (false,false)) :\n    (clauses evalOp p st).control.passed =\n      (st.control.passed.1 && passes p (bankValue st.bank false),\n       st.control.passed.2 && passes p (bankValue st.bank true)) := by\n  induction p generalizing st with\n  | nil => simp [clauses,passes]\n  | cons c p ih =>\n    rw [clauses,ih _ rfl]\n    obtain ⟨t,q⟩ := literalList c st\n    change ((endClause (lits evalOp c st).control).passed.1 &&\n        passes p (bankValue (lits evalOp c st).bank false),\n      (endClause (lits evalOp c st).control).passed.2 &&\n        passes p (bankValue (lits evalOp c st).bank true)) = _\n    rw [t,q]\n    simp [endClause,fresh,passes,Bool.and_assoc]\n\ndef firstSweep (w : List Letter) := scan profileOp w (start emptyBank ())\n\n/-- The two components of home are the final position and its charged distance.\nThe input head returns on the original, immutable tape. -/\ndef resume (st : St Unit) : St Bits :=\n  ⟨st.bank,beginBits,true,(home st.head).1⟩\n\ndef read (w : List Letter) := (scan evalOp (returned w).1 (resume (firstSweep w))).control.passed\n\ndef movements (w : List Letter) :=\n  travel profileOp w (start emptyBank ()) + (home (firstSweep w).head).2 +\n    (returned w).2 + travel evalOp (returned w).1 (resume (firstSweep w))\n\ntheorem cost_with_position {Q : Type} (o : Op Q) (w : List Letter) (st : St Q) :\n    travel o w st + (scan o w st).head ≤ 3*w.length+st.head := by\n  induction w generalizing st with\n  | nil => simp [travel,scan]\n  | cons a w ih =>\n    have h := ih (TwoSweeps.update o a w st)\n    cases a <;> simp only [travel,scan,List.length_cons,workMoves,TwoSweeps.update,atSign,home_trace,\n      Nat.mul_add,Nat.mul_one] at h ⊢ <;> omega\n\ntheorem seven_movements_per_letter (w : List Letter) : movements w ≤ 7*w.length := by\n  have a := cost_with_position profileOp w (start emptyBank ())\n  have b := cost_with_position evalOp w (resume (firstSweep w))\n  change travel profileOp w (start emptyBank ()) + (firstSweep w).head ≤ 3*w.length+0 at a\n  simp only [resume,home_trace,Nat.add_zero] at b\n  unfold movements\n  rw [returned_spec,home_trace]\n  dsimp only [Prod.fst,Prod.snd]\n  simp only [resume,home_trace] at *\n  omega\n\ntheorem values_from_tape {n : Nat} (p : CNF (n+1)) :\n    read (original p) = (passes p (value p false), passes p (value p true)) := by\n  unfold read\n  rw [returned_spec]\n  have homeZero : (resume (firstSweep (original p))).head = 0 := by simp [resume]\n  rw [raw_clauses _ _ _ homeZero,evalClauses _ _ rfl]\n  have v (b : Bool) : bankValue (firstSweep (original p)).bank b = value p b := by\n    funext i\n    simp [bankValue,value,choose,firstSweep,builds_from_letters]\n  change (true && passes p (bankValue (firstSweep (original p)).bank false),\n          true && passes p (bankValue (firstSweep (original p)).bank true)) = _\n  rw [v,v]\n  simp\n\ndef lane (bits : Bool × Bool) (b : Bool) : Bool := if b then bits.2 else bits.1\n\ntheorem lane_is_witness {n : Nat} (p : CNF (n+1)) (b : Bool) :\n    lane (read (original p)) b = passes p (value p b) := by\n  cases b <;> simp [values_from_tape,lane]\n\ntheorem positive_is_sound {n : Nat} (p : CNF (n+1)) (b : Bool)\n    (h : lane (read (original p)) b = true) : present p b :=\n  witness_sound p b ((lane_is_witness p b).symm.trans h)\n\ntheorem branches_exact {n : Nat} {p : CNF (n+1)} (h : covered p) (b : Bool) :\n    lane (read (original p)) b = true ↔ present p b := by\n  rw [lane_is_witness,witness_complete h b]\n\ntheorem word_exact {n : Nat} {p : CNF (n+1)} (h : covered p) :\n    ((read (original p)).1 || (read (original p)).2) = palavraDaFormula p := by\n  apply Bool.eq_iff_iff.mpr\n  rw [Bool.or_eq_true,word_from_pair]\n  exact or_congr (branches_exact h false) (branches_exact h true)\n\n/-- A positive output on an arbitrary formula witnesses the Word. -/\ntheorem word_positive {n : Nat} (p : CNF (n+1))\n    (hit : ((read (original p)).1 || (read (original p)).2) = true) :\n    palavraDaFormula p = true := by\n  apply (word_from_pair p).mpr\n  exact (Bool.or_eq_true_iff.mp hit).imp (positive_is_sound p false) (positive_is_sound p true)\n\ntheorem certified {n : Nat} {p : CNF (n+1)} (h : covered p) :\n    (∀ b : Bool, lane (read (original p)) b = true ↔ present p b) ∧\n    (((read (original p)).1 || (read (original p)).2) = palavraDaFormula p) ∧\n    movements (original p) ≤ 7 * (original p).length :=\n  ⟨branches_exact h,word_exact h,seven_movements_per_letter _⟩\n\n/-- The unit obligation at address 2 is learned from the original letters. -/\nexample : read [.tick,.tick,.sign false,.delimiter] = (true,true) := by decide\n\n/-- A malformed input ending away from home is charged for returning there. -/\nexample : movements [.tick,.tick,.tick] = 18 := by decide\n\ndef crossed : CNF 3 :=\n  [[⟨1,true⟩,⟨2,true⟩],[⟨1,false⟩,⟨2,false⟩]]\n\ntheorem opposite_values_missing :\n    read (original crossed) = (false,false) ∧ (∀ b : Bool, present crossed b) := by\n  constructor\n  · decide\n  · intro b\n    refine ⟨fun i => if i.val = 0 then b else i.val == 1,?_,?_⟩\n    · simp\n    · rfl\n\nend Codex.SecondRead\n',
+    'TGLExt/LeitorDeReuso.lean': 'import TGLExt.SegundaLeitura\nimport TGLExt.CustoDaBuscaLiteral\n\n/-! A cache of obligations on each spoke, conditional on the one shared guard.\nTwo fixed hypotheses use separate initially blank work tapes and the same\nrewound input. The final two bits always describe checked witnesses. -/\nset_option autoImplicit false\nnamespace Codex.ReuseReader\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\nopen Codex.SignProfile Codex.TwoSweeps Codex.SecondRead Codex.PolinomioPorEscolha\nopen Codex.LiteralSearchCost (delayed suffix choiceClause)\n\n/-- Visit cell 1, pre-set the guard value, then home on the blank tape. -/\ndef prepare (h : Bool) : Bank × Nat :=\n  (Function.update emptyBank 1 ⟨false,false,h,!h⟩,1+(home 1).2)\n\ndef record (cell : Cell) (v : Bool) : Cell := {cell with seenPos:=cell.seenPos || v}\ntheorem record_twice (cell : Cell) (v : Bool) : record (record cell v) v = record cell v := by\n  cases cell; cases v <;> simp [record]\n\n/-- A failed guard and a positive spoke record a positive requirement.\nAn already present requirement is a cache hit, proved by record_twice. -/\ndef collect (h : Bool) : Op (Option Bool) :=\n  ⟨fun _ pos _ cell st => match st with\n    | none => (cell,some pos)\n    | some guard => (record cell ((guard != h) && pos),none),\n   fun _ => none⟩\n\ndef filled (h : Bool) (w : List Letter) := scan (collect h) w (start (prepare h).1 none)\ndef again (h : Bool) (w : List Letter) : St Bits :=\n  ⟨(filled h w).bank,beginBits,true,(home (filled h w).head).1⟩\ndef hypothesis (h : Bool) (w : List Letter) :=\n  (scan evalOp (returned w).1 (again h w)).control.passed\ndef read (w : List Letter) : Bool × Bool :=\n  let a := hypothesis false w\n  let b := hypothesis true (returned w).1\n  (a.1 || b.1,a.2 || b.2)\ndef hypCost (h : Bool) (w : List Letter) :=\n  (prepare h).2 + travel (collect h) w (start (prepare h).1 none) +\n    (home (filled h w).head).2 + (returned w).2 + travel evalOp (returned w).1 (again h w)\ndef movements (w : List Letter) := hypCost false w + (returned w).2 + hypCost true (returned w).1\n\nprivate theorem one_cost (h : Bool) (w : List Letter) : hypCost h w ≤ 7*w.length+2 := by\n  have a := cost_with_position (collect h) w (start (prepare h).1 none)\n  have b := count_le evalOp w (again h w)\n  change travel (collect h) w (start (prepare h).1 none) + (filled h w).head ≤ 3*w.length+0 at a\n  have homeZero : (again h w).head=0 := by simp [again]\n  rw [homeZero] at b\n  unfold hypCost\n  rw [returned_spec,home_trace]\n  have two : (prepare h).2 = 2 := by simp [prepare]\n  rw [two]\n  dsimp only [Prod.fst,Prod.snd]\n  omega\n\ntheorem linear_travel (w : List Letter) : movements w ≤ 15*w.length+4 := by\n  unfold movements\n  rw [returned_spec]\n  have a := one_cost true w\n  have b := one_cost false w\n  dsimp only [Prod.fst,Prod.snd]\n  omega\n\nprivate theorem literalState {n : Nat} (l : Literal n) (u : Bool) (st : St Bits) :\n    applyLit evalOp l u st =\n    ⟨st.bank,readSign (l.var.val == 0) l.pos (st.bank l.var.val) st.control,false,0⟩ := by\n  simp [applyLit,evalOp]\n\nprivate theorem literalList {n : Nat} (ls : Clausula n) (st : St Bits) :\n    (lits evalOp ls st).bank = st.bank ∧\n    (lits evalOp ls st).control = ⟨st.control.passed,\n      (st.control.clause.1 || satisfeita ls (bankValue st.bank false),\n       st.control.clause.2 || satisfeita ls (bankValue st.bank true))⟩ := by\n  induction ls generalizing st with\n  | nil =>\n    cases st with | mk t q f j => cases q; simp [lits,satisfeita]\n  | cons l ls ih =>\n    rw [lits,literalState]\n    obtain ⟨t,q⟩ := ih ⟨st.bank,readSign (l.var.val == 0) l.pos (st.bank l.var.val) st.control,false,0⟩\n    refine ⟨t,?_⟩\n    rw [q]\n    simp [readSign,satisfeita,Literal.vale,bankValue,Bool.or_assoc]\n\nprivate theorem evalClauses {n : Nat} (p : CNF n) (st : St Bits)\n    (fresh : st.control.clause = (false,false)) :\n    (clauses evalOp p st).control.passed =\n      (st.control.passed.1 && passes p (bankValue st.bank false),\n       st.control.passed.2 && passes p (bankValue st.bank true)) := by\n  induction p generalizing st with\n  | nil => simp [clauses,passes]\n  | cons c p ih =>\n    rw [clauses,ih _ rfl]\n    obtain ⟨t,q⟩ := literalList c st\n    change ((endClause (lits evalOp c st).control).passed.1 &&\n        passes p (bankValue (lits evalOp c st).bank false),\n      (endClause (lits evalOp c st).control).passed.2 &&\n        passes p (bankValue (lits evalOp c st).bank true)) = _\n    rw [t,q]\n    simp [endClause,fresh,passes,Bool.and_assoc]\n\ndef selected {n : Nat} (p : CNF n) (h b : Bool) : Fin n → Bool :=\n  bankValue (filled h (original p)).bank b\n\ntheorem hyp_witness {n : Nat} (p : CNF n) (h b : Bool) :\n    lane (hypothesis h (original p)) b = passes p (selected p h b) := by\n  unfold hypothesis\n  rw [returned_spec]\n  have homeZero : (again h (original p)).head = 0 := by simp [again]\n  rw [raw_clauses _ _ _ homeZero,evalClauses _ _ rfl]\n  cases b <;> simp [lane,again,beginBits,selected]\n\ntheorem reuse_witnesses {n : Nat} (p : CNF n) (b : Bool) :\n    lane (read (original p)) b =\n      (passes p (selected p false b) || passes p (selected p true b)) := by\n  unfold read\n  rw [returned_spec]\n  cases b with\n  | false => exact congrArg₂ Bool.or (hyp_witness p false false) (hyp_witness p true false)\n  | true => exact congrArg₂ Bool.or (hyp_witness p false true) (hyp_witness p true true)\n\ntheorem positive_sound {n : Nat} (p : CNF (n+1)) (b : Bool)\n    (hit : lane (read (original p)) b = true) : present p b := by\n  have deliver (h : Bool) (ok : passes p (selected p h b) = true) : present p b :=\n    ⟨_,by simp [selected,bankValue,choose],ok⟩\n  rw [reuse_witnesses] at hit\n  exact (Bool.or_eq_true_iff.mp hit).elim (deliver false) (deliver true)\n\nabbrev Edge (n : Nat) := Bool × Literal (n+2)\ndef guardLit {n : Nat} (g : Bool) : Literal (n+2) := ⟨1,g⟩\ndef edgeClause {n : Nat} (e : Edge n) : Clausula (n+2) := [guardLit e.1,e.2]\ndef star {n : Nat} (es : List (Edge n)) := es.map edgeClause\ndef requires {n : Nat} (e : Edge n) (h : Bool) (j : Nat) :=\n    (e.1 != h) && e.2.pos && (e.2.var.val == j)\ndef votes {n : Nat} (es : List (Edge n)) (h : Bool) (j : Nat) :=\n  es.any (fun e => requires e h j)\n\nprivate theorem edge_step {n : Nat} (e : Edge n) (h : Bool) (st : St (Option Bool))\n    (hs : st.control = none) (j : Nat) :\n    (finish (collect h) (lits (collect h) (edgeClause e) st)).bank j =\n      record (st.bank j) (requires e h j) := by\n  by_cases eq : e.2.var.val = j\n  · subst j\n    simp [edgeClause,guardLit,lits,applyLit,finish,collect,hs,requires]\n  · have back := Ne.symm eq\n    have miss : (e.2.var.val == j) = false := beq_eq_false_iff_ne.mpr eq\n    simp [edgeClause,lits,applyLit,finish,collect,hs,requires,miss,Function.update_of_ne back,record]\n\nprivate theorem cache_accumulates {n : Nat} (es : List (Edge n)) (h : Bool)\n    (st : St (Option Bool)) (hs : st.control=none) (j : Nat) :\n    (clauses (collect h) (star es) st).bank j = record (st.bank j) (votes es h j) := by\n  induction es generalizing st with\n  | nil => cases s : st.bank j; simp [clauses,star,votes,record,s]\n  | cons e es ih =>\n    change (clauses (collect h) (star es) (finish (collect h) (lits (collect h) (edgeClause e) st))).bank j = _\n    rw [ih _ rfl,edge_step _ _ _ hs]\n    simp [votes,record,Bool.or_assoc]\n\ntheorem built_cache {n : Nat} (es : List (Edge n)) (h : Bool) (j : Nat) :\n    (filled h (original (star es))).bank j = record ((prepare h).1 j) (votes es h j) := by\n  unfold filled\n  rw [raw_clauses _ _ _ rfl,cache_accumulates _ _ _ rfl]\n  rfl\n\ntheorem selected_on_star {n : Nat} (es : List (Edge n)) (h b : Bool) (i : Fin (n+2)) :\n    selected (star es) h b i =\n      (if i.val = 0 then b else if i.val = 1 then h else votes es h i.val) := by\n  simp only [selected,bankValue,choose,built_cache,beq_iff_eq]\n  by_cases z : i.val = 0\n  · simp [z]\n  by_cases o : i.val = 1\n  · cases h <;> simp [o,prepare,record,pick]\n  · simp [z,o,prepare,emptyBank,blank,record,pick]\n\nprivate theorem required_literal {n : Nat} {es : List (Edge n)} (x : Fin (n+2) → Bool)\n    (ok : passes (star es) x = true) {e : Edge n} (mem : e ∈ es)\n    (active : e.1 ≠ x 1) : x e.2.var = e.2.pos := by\n  have ec : edgeClause e ∈ star es := List.mem_map.mpr ⟨e,mem,rfl⟩\n  have hits := List.all_eq_true.mp ok _ ec\n  simp [edgeClause,guardLit,satisfeita,Literal.vale,Ne.symm active] at hits\n  exact hits\n\nprivate theorem star_witness {n : Nat} (es : List (Edge n)) (b : Bool)\n    (x : Fin (n+2) → Bool) (pivot : x 0 = b) (ok : passes (star es) x = true) :\n    passes (star es) (selected (star es) (x 1) b) = true := by\n  let h := x 1\n  let y := selected (star es) h b\n  have atGuard : y 1 = h := by simp [y,selected_on_star]\n  apply List.all_eq_true.mpr\n  intro c hc\n  obtain ⟨e,mem,rfl⟩ := List.mem_map.mp hc\n  change satisfeita (edgeClause e) y = true\n  by_cases coveredByGuard : e.1 = h\n  · simp [edgeClause,guardLit,satisfeita,Literal.vale,atGuard,coveredByGuard]\n  have forced := required_literal x ok mem coveredByGuard\n  have spoke : y e.2.var = e.2.pos := by\n    rw [show y e.2.var = _ from selected_on_star es h b e.2.var]\n    by_cases z : e.2.var.val=0\n    · have iz : e.2.var=0 := Fin.ext z\n      simpa [z,iz] using pivot.symm.trans (iz ▸ forced : x 0=e.2.pos)\n    by_cases o : e.2.var.val=1\n    · have io : e.2.var=1 := Fin.ext o\n      simpa [z,o,h] using (io ▸ forced : x 1=e.2.pos)\n    simp only [z,o,if_false]\n    cases ep : e.2.pos with\n    | true =>\n      apply List.any_eq_true.mpr\n      exact ⟨e,mem,by simp [requires,coveredByGuard,ep]⟩\n    | false =>\n      apply Bool.eq_false_iff.mpr\n      intro has\n      obtain ⟨other,hm,activepos⟩ := List.any_eq_true.mp has\n      have obligations : (other.1 ≠ h ∧ other.2.pos=true) ∧ other.2.var.val=e.2.var.val := by\n        simpa [requires] using activepos\n      have otherForced := required_literal x ok hm obligations.1.1\n      have eqv : other.2.var = e.2.var := Fin.ext obligations.2\n      rw [eqv,obligations.1.2,forced,ep] at otherForced\n      contradiction\n  change satisfeita (edgeClause e) y = true\n  simp [edgeClause,guardLit,satisfeita,Literal.vale,spoke]\n\ntheorem exact_stars {n : Nat} (es : List (Edge n)) (b : Bool) :\n    lane (read (original (star es))) b = true ↔ present (star es) b := by\n  refine ⟨positive_sound _ b,?_⟩\n  rintro ⟨x,hx,ok⟩\n  have witness := star_witness es b x hx ok\n  rw [reuse_witnesses,Bool.or_eq_true]\n  cases e : x 1\n  · exact Or.inl (e ▸ witness)\n  · exact Or.inr (e ▸ witness)\n\ndef delayedEdges : Nat → List (Edge 2)\n  | 0 => [(false,⟨3,true⟩),(false,⟨3,false⟩)]\n  | k+1 => (true,⟨2,true⟩)::delayedEdges k\n\ntheorem delayed_is_star (k : Nat) : delayed k = star (delayedEdges k) := by\n  induction k with\n  | zero => rfl\n  | succ k ih => change choiceClause :: delayed k = choiceClause :: star (delayedEdges k); rw [ih]\n\ntheorem delayed_result (k : Nat) :\n    read (original (delayed k)) = (true,true) ∧\n    movements (original (delayed k)) ≤ 15*(6*k+14)+4 := by\n  refine ⟨?_,?_⟩\n  · have hit (b : Bool) := (exact_stars (delayedEdges k) b).mpr\n        (delayed_is_star k ▸ LiteralSearchCost.every_branch_possible k b)\n    rw [delayed_is_star]\n    exact Prod.ext (hit false) (hit true)\n  · simpa [LiteralSearchCost.delayed_letters] using linear_travel (original (delayed k))\n\ntheorem duplicate_cache {n : Nat} (e : Edge n) (es : List (Edge n)) (h : Bool) :\n    (filled h (original (star (e::e::es)))).bank =\n    (filled h (original (star (e::es)))).bank := by\n  funext j\n  simp only [built_cache,votes,List.any_cons]\n  cases requires e h j <;> rfl\n\ntheorem star_word {n : Nat} (es : List (Edge n)) :\n    let p := star es\n    ((read (original p)).1 || (read (original p)).2) = palavraDaFormula p := by\n  dsimp only\n  apply Bool.eq_iff_iff.mpr\n  rw [Bool.or_eq_true,word_from_pair]\n  exact or_congr (exact_sta