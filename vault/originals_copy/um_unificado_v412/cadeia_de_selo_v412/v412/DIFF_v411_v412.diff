+    'TGLExt/EcoDaAtribuicao.lean': 'import TGLExt.DuasPassagens\n\n/-! A general CNF on the original unary input tape; a finite, read-only bit\ntape supplied by the caller. The second head starts on its first bit. Its\nleft boundary is the empty left stack. Reuse the local one-cell rewind.\nA move is one head moving by one cell; a tick moves both heads. -/\nset_option autoImplicit false\nnamespace Codex.EcoDaAtribuicao\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula IALD.LeitorDaFormula\nopen Codex.PolinomioPorEscolha (Letter spell spellClause original)\nopen Codex.BranchCircuit (rewind rewind_trace)\n\nprivate def charge (k : Nat) (r : Bool × Nat) : Bool × Nat := (r.1,k+r.2)\n\n/-- The output pairs the decision with the measured head movements.\nAn exhausted echo at a required cell rejects. The left stack consists of\nthe very bits traversed, in reverse order, and the right starts at the head. -/\ndef scan : List Letter → List Bool → List Bool → Bool → Bool → Bool × Nat\n  | [], _, _, ok, _ => (ok, 0)\n  | .tick :: _, _, [], _, _ => (false, 1)\n  | .tick :: w, left, b :: right, ok, hit =>\n    charge 2 (scan w (b :: left) right ok hit)\n  | .sign _ :: _, _, [], _, _ => (false, 1)\n  | .sign s :: w, left, b :: right, ok, hit =>\n    let home := rewind left (b :: right)\n    charge (1 + home.2) (scan w [] home.1 ok (hit || (b == s)))\n  | .delimiter :: w, left, right, ok, hit =>\n    charge 1 (scan w left right (ok && hit) false)\n\ndef verify (w : List Letter) (bits : List Bool) : Bool × Nat :=\n  scan w [] bits true false\n\nprivate theorem ticks (pre right left : List Bool) (w : List Letter) (ok hit : Bool) :\n    (scan (List.replicate pre.length .tick ++ w) left (pre ++ right) ok hit).1 =\n      (scan w (pre.reverse ++ left) right ok hit).1 := by\n  induction pre generalizing left with\n  | nil => simp\n  | cons b pre ih =>\n    simp only [List.length_cons,List.replicate_succ,List.cons_append,scan,charge,\n      List.reverse_cons,List.append_assoc]\n    exact ih (b :: left)\n\nprivate theorem at_literal {n : Nat} (l : Literal n) (x : Fin n → Bool)\n    (w : List Letter) (ok hit : Bool) :\n    (scan (spell l ++ w) [] (List.ofFn x) ok hit).1 =\n      (scan w [] (List.ofFn x) ok (hit || l.vale x)).1 := by\n  let bits := List.ofFn x\n  let i := l.var.val\n  let pre := bits.take i\n  let tail := bits.drop (i+1)\n  have hi : i < bits.length := by simp [i,bits]\n  have len : pre.length = i := List.length_take_of_le (Nat.le_of_lt hi)\n  have decomp : pre ++ x l.var :: tail = bits := by\n    have cut := List.drop_eq_getElem_cons hi\n    have bit : bits[i] = x l.var := by simp [bits,i]\n    rw [bit] at cut\n    change bits.take i ++ x l.var :: bits.drop (i+1) = bits\n    rw [← cut,List.take_append_drop]\n  change (scan ((List.replicate i .tick ++ [.sign l.pos]) ++ w) [] bits ok hit).1 = _\n  rw [List.append_assoc,List.singleton_append]\n  conv_lhs => rw [← len,← decomp]\n  rw [ticks]\n  simp only [List.append_nil,scan,charge,rewind_trace,List.reverse_reverse,decomp,Literal.vale]\n  rfl\n\nprivate theorem clause {n : Nat} (c : Clausula n) (x : Fin n → Bool)\n    (w : List Letter) (ok hit : Bool) :\n    (scan (c.flatMap spell ++ w) [] (List.ofFn x) ok hit).1 =\n      (scan w [] (List.ofFn x) ok (hit || satisfeita c x)).1 := by\n  induction c generalizing hit with\n  | nil => simp [satisfeita]\n  | cons l c ih =>\n    rw [List.flatMap_cons,List.append_assoc,at_literal,ih]\n    simp [satisfeita,Bool.or_assoc]\n\nprivate theorem formula {n : Nat} (p : CNF n) (x : Fin n → Bool) (ok : Bool) :\n    (scan (original p) [] (List.ofFn x) ok false).1 = (ok && passes p x) := by\n  induction p generalizing ok with\n  | nil => simp [original,scan,passes]\n  | cons c p ih =>\n    change (scan ((c.flatMap spell ++ [.delimiter]) ++ original p) [] (List.ofFn x) ok false).1 = _\n    rw [List.append_assoc,List.singleton_append,clause]\n    change (scan (original p) [] (List.ofFn x) (ok && (false || satisfeita c x)) false).1 = _\n    simp [ih,passes,Bool.and_assoc]\n\n/-- Valid for every CNF, including n = 0, empty formulas and empty clauses. -/\ntheorem verify_assignment {n : Nat} (p : CNF n) (x : Fin n → Bool) :\n    (verify (original p) (List.ofFn x)).1 = passes p x := by\n  simpa [verify] using formula p x true\n\nprivate theorem travel (w : List Letter) (left right : List Bool) (ok hit : Bool) :\n    (scan w left right ok hit).2 ≤ 3 * w.length + left.length := by\n  induction w generalizing left right ok hit with\n  | nil => simp [scan]\n  | cons a w ih =>\n    cases a with\n    | delimiter =>\n      have h := ih left right (ok && hit) false\n      simp only [scan,charge,List.length_cons] at *\n      omega\n    | tick =>\n      cases right with\n      | nil => simp [scan]; omega\n      | cons b right =>\n        have h := ih (b :: left) right ok hit\n        simp only [scan,charge,List.length_cons] at *\n        omega\n    | sign s =>\n      cases right with\n      | nil => simp [scan]; omega\n      | cons b right =>\n        have h := ih [] (left.reverse ++ b :: right) ok (hit || (b == s))\n        simp only [scan,charge,rewind_trace,List.length_cons,List.length_nil] at *\n        omega\n\n/-- On either answer, at most three movements per original input symbol.\nThe echo is already on the second tape; its production is outside this bound. -/\ntheorem at_most_three (w : List Letter) (bits : List Bool) :\n    (verify w bits).2 ≤ 3*w.length := by\n  simpa [verify] using travel w [] bits true false\n\n/-- Existence of a length-n bit string accepted by this verifier. -/\ntheorem word_iff_echo {n : Nat} (p : CNF n) :\n    palavraDaFormula p = true ↔\n      ∃ bits : List Bool, bits.length = n ∧ (verify (original p) bits).1 = true := by\n  rw [a_palavra_e_o_sat,sat_iff]\n  constructor\n  · rintro ⟨x,h⟩\n    exact ⟨List.ofFn x,List.length_ofFn, (verify_assignment p x).trans h⟩\n  · rintro ⟨bits,rfl,h⟩\n    let x : Fin bits.length → Bool := fun i => bits[i.val]\n    have rep : List.ofFn x = bits := List.ofFn_getElem\n    exact ⟨x,by rwa [← verify_assignment,rep]⟩\n\nend Codex.EcoDaAtribuicao\n',
+    'TGLExt/EliminacaoDePares.lean': "import TGLExt.CustoDaBuscaLiteral\n\n/-! Existentially eliminate a pivot once, preserving the same outside\nassignment on both branches. For binary clauses the resulting cache has a\nquadratic universe of keys. This module counts keys, not tape moves. -/\nset_option autoImplicit false\nnamespace Codex.PairElimination\nopen TGLExt.TraducaoTuring IALD.LeitorDaFormula\nvariable {n : Nat}\nlocal instance : DecidableEq (Literal n) := fun a b => by\n  cases a with | mk i s =>\n    cases b with | mk j t =>\n      exact decidable_of_iff (i = j ∧ s = t) (by simp)\n\ndef assign (x : Fin n → Bool) (v : Fin n) (b : Bool) (i : Fin n) :=\n  if i = v then b else x i\n\ndef used (v : Fin n) (c : Clausula n) := c.any (fun l => l.var == v)\ndef hit (v : Fin n) (b : Bool) (c : Clausula n) :=\n  c.any (fun l => l.var == v && l.pos == b)\ndef cut (v : Fin n) (c : Clausula n) := c.filter (fun l => !(l.var == v))\n\nprivate theorem read_cut (v : Fin n) (b : Bool) (c : Clausula n) (x : Fin n → Bool) :\n    satisfeita c (assign x v b) = (hit v b c || satisfeita (cut v c) x) := by\n  induction c with\n  | nil => rfl\n  | cons l c ih =>\n    by_cases h : l.var = v\n    · change (l.vale (assign x v b) || satisfeita c (assign x v b)) = _ \n      simp only [ih]\n      cases b <;> cases e : l.pos <;>\n        simp [Literal.vale,assign,h,e,hit,cut,satisfeita,List.any_cons]\n    · change (l.vale (assign x v b) || satisfeita c (assign x v b)) = _\n      simp only [ih]\n      simp [Literal.vale,assign,h,beq_eq_false_iff_ne.mpr h,hit,cut,satisfeita,Bool.or_left_comm]\n\nprivate theorem untouched (v : Fin n) (c : Clausula n) (h : used v c = false) :\n    cut v c = c := by\n  simpa [used,cut] using h\n\nprivate theorem hit_used (v : Fin n) (b : Bool) (c : Clausula n)\n    (h : hit v b c = true) : used v c = true := by\n  obtain ⟨l,hl,hh⟩ := List.any_eq_true.mp h\n  have t : (l.var == v) = true ∧ (l.pos == b) = true := by simpa only [Bool.and_eq_true] using hh\n  exact List.any_eq_true.mpr ⟨l,hl,t.1⟩\n\ndef fixed (v : Fin n) (p : CNF n) := p.filter (fun c => !(used v c))\ndef arm (v : Fin n) (b : Bool) (p : CNF n) :=\n  (p.filter (fun c => used v c && !(hit v b c))).map (cut v)\n\nprivate theorem branch_spec (v : Fin n) (b : Bool) (p : CNF n) (x : Fin n → Bool) :\n    passes p (assign x v b) = (passes (fixed v p) x && passes (arm v b p) x) := by\n  induction p with\n  | nil => rfl\n  | cons c p ih =>\n    have hc := read_cut v b c x\n    change (satisfeita c (assign x v b) && passes p (assign x v b)) = _\n    change satisfeita c (assign x v b) = _ at hc\n    rw [hc,ih]\n    cases u : used v c <;> cases h : hit v b c\n    · have eqc := untouched v c u\n      simp [fixed,arm,passes,u,h,eqc,Bool.and_assoc]\n    · have contra := hit_used v b c h\n      simp [u] at contra\n    · simp [fixed,arm,passes,u,h]\n      grind\n    · simp [fixed,arm,passes,u,h]\n\n\ndef join (p q : CNF n) := p.flatMap (fun a => q.map (fun b => a ++ b))\n\nprivate theorem join_spec (p q : CNF n) (x : Fin n → Bool) :\n    passes (join p q) x = (passes p x || passes q x) := by\n  apply Bool.eq_iff_iff.mpr\n  simp [passes,join,satisfeita,List.all_eq_true,List.any_append]\n  grind\n\ndef eliminate (v : Fin n) (p : CNF n) :=\n  fixed v p ++ join (arm v false p) (arm v true p)\n\n/-- Both arms refer to exactly the same values outside the pivot. -/\ntheorem eliminate_exact (v : Fin n) (p : CNF n) (x : Fin n → Bool) :\n    passes (eliminate v p) x = (passes p (assign x v false) || passes p (assign x v true)) := by\n  rw [branch_spec,branch_spec]\n  have e : passes (eliminate v p) x =\n    (passes (fixed v p) x && passes (join (arm v false p) (arm v true p)) x) := by\n    simp [eliminate,passes,List.all_append]\n  rw [e,join_spec]\n  grind\n\ndef Binary (p : CNF n) := ∀ c ∈ p, c.length ≤ 2\n\nprivate theorem shorter (v : Fin n) (c : Clausula n) (h : used v c = true) :\n    (cut v c).length < c.length := by\n  induction c with\n  | nil => contradiction\n  | cons l c ih =>\n    by_cases e : l.var = v\n    · have lim := List.length_filter_le (fun l : Literal n => !(l.var == v)) c\n      simpa [cut,e] using (Nat.lt_succ_of_le lim)\n    · have ht : used v c = true := by simpa only [used,List.any_cons,beq_eq_false_iff_ne.mpr e,Bool.false_or] using h\n      simpa [cut,e] using ih ht\n\nprivate theorem arm_short {v : Fin n} {p : CNF n} (h : Binary p)\n    {b : Bool} {c : Clausula n} (hc : c ∈ arm v b p) : c.length ≤ 1 := by\n  obtain ⟨d, hd, rfl⟩ := List.mem_map.mp hc\n  obtain ⟨hp,hb⟩ := List.mem_filter.mp hd\n  have hb' : used v d = true ∧ (!(hit v b d)) = true := by simpa only [Bool.and_eq_true] using hb\n  have sm := shorter v d hb'.1\n  have := h d hp\n  omega\n\ntheorem binary_closed (v : Fin n) (p : CNF n) (h : Binary p) : Binary (eliminate v p) := by\n  intro c hc\n  rcases List.mem_append.mp hc with a|a\n  · exact h c (List.mem_filter.mp a).1\n  · obtain ⟨d,hd,t⟩ := List.mem_flatMap.mp a\n    obtain ⟨e,he,rfl⟩ := List.mem_map.mp t\n    have := arm_short h hd\n    have := arm_short h he\n    simp only [List.length_append]\n    omega\n\ndef alphabet (n : Nat) : List (Literal n) :=\n  (List.finRange n).flatMap (fun i => [⟨i,false⟩, ⟨i,true⟩])\ndef keys (n : Nat) : CNF n :=\n  [[]] ++ (alphabet n).map (fun a => [a]) ++\n    (alphabet n).flatMap (fun a => (alphabet n).map (fun b => [a,b]))\ndef pack (p : CNF n) : CNF n := (keys n).filter (fun c => decide (c ∈ p))\n\nprivate theorem alphabet_full (a : Literal n) : a ∈ alphabet n := by\n  obtain ⟨i,b⟩ := a\n  cases b <;> simp [alphabet,List.mem_flatMap]\n\nprivate theorem keys_full (c : Clausula n) (h : c.length ≤ 2) : c ∈ keys n := by\n  cases c with\n  | nil => simp [keys]\n  | cons a t =>\n    cases t with\n    | nil => simp [keys,List.mem_map,alphabet_full]\n    | cons b t =>\n      cases t with\n      | nil =>\n        apply List.mem_append_right\n        exact List.mem_flatMap.mpr ⟨a,alphabet_full _,List.mem_map.mpr ⟨b,alphabet_full _,rfl⟩⟩\n      | cons _ _ => simp at h\n\nprivate theorem regular_length {α β : Type} (ls : List α) (f : α → List β) (m : Nat)\n    (h : ∀ a, (f a).length = m) : (ls.flatMap f).length = ls.length*m := by\n  induction ls with\n  | nil => simp\n  | cons a ls ih => simp [ih,h,Nat.succ_mul,Nat.add_comm]\n\ntheorem key_count (n : Nat) : (keys n).length = 1+2*n+(2*n)^2 := by\n  have a : (alphabet n).length = n*2 := by\n    unfold alphabet\n    rw [regular_length _ _ 2 (by intro; rfl)]\n    simp\n  unfold keys\n  rw [List.length_append,List.length_append,regular_length _ _ (n*2) (by simp [a])]\n  simp [a,pow_two,Nat.mul_comm]\n\ntheorem pack_bound (p : CNF n) : (pack p).length ≤ 1+2*n+(2*n)^2 := by\n  rw [← key_count]\n  apply List.length_filter_le\n\ntheorem pack_exact (p : CNF n) (h : Binary p) (x : Fin n → Bool) :\n    passes (pack p) x = passes p x := by\n  apply Bool.eq_iff_iff.mpr\n  simp [pack,passes,List.all_eq_true]\n  grind [keys_full,Binary]\n\n\n/-- Quantification over the eliminated coordinates at a fixed outside assignment. -/\ndef outside (vs : List (Fin n)) (x y : Fin n → Bool) :=\n  ∀ i, i ∉ vs → y i = x i\n\ndef reduce : List (Fin n) → CNF n → CNF n\n  | [], p => p\n  | v :: vs, p => reduce vs (pack (eliminate v p))\n\nprivate theorem packed_binary (p : CNF n) (h : Binary p) : Binary (pack p) :=\n  fun c hc => h c (of_decide_eq_true (List.mem_filter.mp hc).2)\n\ntheorem reduce_exact (vs : List (Fin n)) (p : CNF n) (h : Binary p) (x : Fin n → Bool) :\n    passes (reduce vs p) x = true ↔ ∃ y, outside vs x y ∧ passes p y = true := by\n  induction vs generalizing p x with\n  | nil =>\n    constructor\n    · intro ok\n      exact ⟨x,fun _ _ => rfl,ok⟩\n    · rintro ⟨y,agree,ok⟩\n      have eq : y = x := funext (fun i => agree i (by simp))\n      simpa [reduce,eq] using ok\n  | cons v vs ih =>\n    simp only [reduce]\n    have bin := binary_closed v p h\n    rw [ih _ (packed_binary _ bin)]\n    constructor\n    · rintro ⟨y,agree,ok⟩\n      rw [pack_exact _ bin,eliminate_exact,Bool.or_eq_true] at ok\n    