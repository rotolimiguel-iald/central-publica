Z : RegOp) (hZ : Z ∈ core) (hZ' : Z ∈ core.commutant)\n    (t : ℝ) : Z * fibre (boostCLM fockFlow t) = fibre (boostCLM fockFlow t) * Z := by\n  have hreg := (VonNeumannAlgebra.mem_commutant_iff.mp hZ') _ (regular_mem t)\n  have hsh := (VonNeumannAlgebra.mem_commutant_iff.mp\n    (F1Fecho.RegularCoreFixed.shift_mem_regularCommutant fockFlow M (-t))) _ hZ\n  have hab : regularUnitary t * shift (-t) = fibre (boostCLM fockFlow t) := by\n    change (fibre (boostCLM fockFlow t) * shift t) * shift (-t) = _\n    rw [mul_assoc, shift_mul, add_neg_cancel, shift_zero, mul_one]\n  rw [← hab]\n  exact (show Commute Z (regularUnitary t) from hreg.symm).mul_right\n    (show Commute Z (shift (-t)) from hsh)\n\n/-- Every two-sided finite-set matrix coefficient of an actual central element\n    is scalar on the physical Fock space. -/\ntheorem central_fibre_slice_scalar (Z : RegOp) (hZ : Z ∈ core)\n    (hZ' : Z ∈ core.commutant) (s t : FiniteFibreSet) :\n    ∃ c : ℂ, fibreSlice Z s t = c • (1 : Op) := by\n  apply commute_wedge_boost_scalar\n  · intro b hb\n    have h := congrArg (fun T : RegOp => fibreSlice T s t)\n      ((VonNeumannAlgebra.mem_commutant_iff.mp hZ') _ (fibre_mem b hb)).symm\n    simpa only [fibreSlice_left, fibreSlice_right] using h\n  · intro r\n    have h := congrArg (fun T : RegOp => fibreSlice T s t)\n      (central_commutes_boost Z hZ hZ' r)\n    simpa only [fibreSlice_left, fibreSlice_right] using h\n\n/-- The central operator commutes with *every* constant Fock operator,\n    including operators outside the represented wedge. -/\ntheorem central_commutes_all_fibres (Z : RegOp) (hZ : Z ∈ core)\n    (hZ' : Z ∈ core.commutant) (B : Op) : Z * fibre B = fibre B * Z := by\n  apply sub_eq_zero.mp\n  apply fibreSlice_zero\n  intro s t\n  rw [fibreSlice_sub, fibreSlice_left, fibreSlice_right]\n  obtain ⟨c,hc⟩ := central_fibre_slice_scalar Z hZ hZ' s t\n  rw [hc, smul_mul_assoc, mul_smul_comm, mul_one, one_mul, sub_self]\n\nend K07.PhysicalCoreCenter\n",
+    'TGLExt/PhysicalCoreMultipliers.lean': "import TGLExt.PhysicalCoreCenter\nimport TGLExt.F1Fecho394.BoundedScalarL2LimitR3\n\n/-! Matrix coefficients of the physical boost give centralizing multiplication\noperators on the same regular Hilbert space. -/\nset_option autoImplicit false\nset_option maxHeartbeats 900000\nset_option synthInstance.maxHeartbeats 160000\nnoncomputable section\nopen MeasureTheory Filter\nopen scoped Topology\nnamespace K07.PhysicalCoreCenter\nopen TGLV350.Regular F1Rede.BosonicFock\nopen F1Fecho.CanonicalFockRegular\nopen F1Fecho.RegularCovariantCore (boostCLM)\nopen F1Fecho.RegularCoreFixed (twistedCommutantField)\n\ndef coefficient (u v : F) (x : ℝ) : ℂ := inner ℂ u (boostCLM fockFlow x v)\n\ntheorem coefficient_continuous (u v : F) : Continuous (coefficient u v) :=\n  continuous_const.inner (fockFlow.strong v)\n\ntheorem coefficient_bound (u v : F) (x : ℝ) :\n    ‖coefficient u v x‖ ≤ ‖u‖ * ‖v‖ :=\n  (norm_inner_le_norm _ _).trans_eq\n    (congrArg (fun t : ℝ => ‖u‖ * t) ((fockFlow.U x).norm_map v))\n\ndef coefficientOp (u v : F) : RegOp :=\n  F1Fecho.BoundedScalarL2.multiply (coefficient u v) (coefficient_continuous u v)\n    (‖u‖*‖v‖) (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (coefficient_bound u v)\n\ntheorem coefficientOp_ae (u v : F) (f : Reg) :\n    coefficientOp u v f =ᵐ[volume] fun x => coefficient u v x • f x :=\n  F1Fecho.BoundedScalarL2.multiply_ae _ _ _ _ _ _\n\n/-- Applying the multiplier to any test vector gives a bounded linear map\nin the second physical vector. The bound is uniform on the unit ball of tests. -/\ndef coefficientCLM (u : F) (f : Reg) : F →L[ℂ] Reg := by\n  let L : F →ₗ[ℂ] Reg :=\n    { toFun := fun v => coefficientOp u v f\n      map_add' := by\n        intro v w\n        apply Lp.ext\n        filter_upwards [coefficientOp_ae u (v+w) f, coefficientOp_ae u v f,\n          coefficientOp_ae u w f, Lp.coeFn_add (coefficientOp u v f) (coefficientOp u w f)]\n            with x h1 h2 h3 h4\n        change (coefficientOp u (v+w) f) x =\n          (coefficientOp u v f + coefficientOp u w f) x\n        rw [h1,h4]\n        simp only [Pi.add_apply,h2,h3,coefficient,map_add,inner_add_right,add_smul]\n      map_smul' := by\n        intro c v\n        apply Lp.ext\n        filter_upwards [coefficientOp_ae u (c • v) f, coefficientOp_ae u v f,\n          Lp.coeFn_smul c (coefficientOp u v f)] with x h1 h2 h3\n        change (coefficientOp u (c • v) f) x = (c • coefficientOp u v f) x\n        rw [h1,h3]\n        simp only [Pi.smul_apply,h2,coefficient,map_smul,inner_smul_right,smul_smul] }\n  have bound (v : F) : ‖L v‖ ≤ (‖u‖ * ‖f‖) * ‖v‖ := by\n    have hop : ‖coefficientOp u v‖ ≤ ‖u‖ * ‖v‖ :=\n      operatorFieldLift_norm_le (F1Fecho.BoundedScalarL2.field (H := F)\n        (coefficient u v) (coefficient_continuous u v) (‖u‖*‖v‖)\n        (mul_nonneg (norm_nonneg u) (norm_nonneg v)) (coefficient_bound u v))\n    exact ((coefficientOp u v).le_of_opNorm_le hop f).trans_eq (by ring)\n  refine { toLinearMap := L, cont := ?_ }\n  have hlip : LipschitzWith (‖u‖₊ * ‖f‖₊) L := by\n    apply LipschitzWith.of_dist_le_mul\n    intro v w\n    simpa only [dist_eq_norm, ← map_sub, NNReal.coe_mul, coe_nnnorm] using bound (v-w)\n  exact hlip.continuous\n\nprivate def ketBra (a b : F) : Op := (innerSL ℂ b).smulRight a\n\nprivate theorem ketBra_apply (a b v : F) : ketBra a b v = inner ℂ b v • a := rfl\n\n/-- A rank-one compression of the twisted commutant field extracts a\n    boost coefficient, pointwise on L². -/\nprivate theorem coefficient_compression (a u : F) (D : Op) :\n    coefficientOp u (D vacuum) * fibre (ketBra a vacuum) =\n    (fibre (ketBra a u) * operatorFieldLift (twistedCommutantField fockFlow D)) *\n      fibre (ketBra vacuum vacuum) := by\n  let R := operatorFieldLift (twistedCommutantField fockFlow D)\n  have hv (x : ℝ) :\n      (twistedCommutantField fockFlow D).op x vacuum = boostCLM fockFlow x (D vacuum) := by\n    change F1Fecho.RegularCovariantCore.automorphism fockFlow x D vacuum = _\n    rw [F1Fecho.RegularCovariantCore.boostAd_sandwich,\n        F1Fecho.RegularCovariantCore.boostCLM_star]\n    change boostCLM fockFlow x (D (boostCLM fockFlow (-x) vacuum)) = _\n    rw [show boostCLM fockFlow (-x) vacuum = vacuum from gamma_vacuum _]\n  ext1 f\n  apply Lp.ext\n  filter_upwards [coefficientOp_ae u (D vacuum) (fibre (ketBra a vacuum) f),\n    fibre_ae (ketBra a vacuum) f,\n    fibre_ae (ketBra a u) (R (fibre (ketBra vacuum vacuum) f)),\n    operatorFieldLift_ae (twistedCommutantField fockFlow D) (fibre (ketBra vacuum vacuum) f),\n    fibre_ae (ketBra vacuum vacuum) f] with x h1 h2 h3 h4 h5\n  change (coefficientOp u (D vacuum) (fibre (ketBra a vacuum) f)) x =\n    (fibre (ketBra a u) (R (fibre (ketBra vacuum vacuum) f))) x\n  change (R (fibre (ketBra vacuum vacuum) f)) x = _ at h4\n  rw [h1,h2,h3,h4,h5]\n  simp only [ketBra_apply, map_smul, hv, coefficient, smul_smul]\n  rw [mul_comm]\n\n/-- The orbits of the complementary wedge are already dense in Fock space.\n    Hence bounded Weyl operators in the physical commutant have total orbit. -/\ntheorem right_vacuum_cyclic :\n    Dense ((Submodule.span ℂ ((fun D : Op => D vacuum) '' (M.commutant : Set Op)) :\n      Submodule ℂ F) : Set F) := by\n  let K := F1Rede.CanonicalWedge.KWR\n  apply (F1Fecho.WedgeCyclic.vacuum_cyclic K.symplComp).mono\n  apply Submodule.span_mono\n  rintro _ ⟨D,hD,rfl⟩\n  refine ⟨D,?_,rfl⟩\n  change D ∈ M.commutant\n  rw [VonNeumannAlgebra.mem_commutant_iff]\n  intro A hA\n  exact (F1Fecho.FieldWeyl.R_local _ _\n    (fun u hu v hv => ClosedSubmodule.mem_symplComp_iff.mp hv u hu) A hA D hD).eq\n\ntheorem central_commutes_orbit_coefficient (Z : RegOp) (hZ : Z ∈ core)\n    (hZ' : Z ∈ core.commutant) (u : F) (D : Op) (hD : D ∈ M.commutant) :\n    Commute Z (coefficientOp u (D vacuum)) := by\n  let W := coefficientOp u (D vacuum)\n  let R := operatorFieldLift (twistedCommutantField fockFlow D)\n  have hR : Commute Z R :=\n    (VonNeumannAlgebra.mem_commutant_iff.mp (F1Fecho.RegularCoreFixed.twistedCommutantLift_mem\n      fockFlow M F1Fecho.CanonicalFockFaithfulWeight.boost_normalizes D hD)) _ hZ\n  have hf (a b : F) : Commute Z (fibre (ketBra a b)) :=\n    central_commutes_all_fibres Z hZ hZ' _\n  have hzero (a : F) : (Z*W-W*Z) * fibre (ketBra a vacuum) = 0 := by\n    let V := fibre (ketBra a vacuum)\n    have h1 : Commute Z (W*V) := by\n      rw [show W*V = _ from coefficient_compression a u D]\n      exact ((hf a u).mul_right hR).mul_right (hf vacuum vacuum)\n    have h2 := (hf a vacuum).eq\n    change Z*V = V*Z at h2\n    change (Z*W-W*Z)*V = 0\n    rw [sub_mul]\n    apply sub_eq_zero.mpr\n    calc\n      (Z*W)*V = Z*(W*V) := mul_assoc _ _ _\n      _ = (W*V)*Z := h1.eq\n      _ = (W*Z)*V := by simp only [mul_assoc, h2]\n  apply sub_eq_zero.mp\n  apply fibreSlice_zero\n  intro s t\n  ext1 a\n  have eq := congrArg (fun T : RegOp => fibreSlice T s t) (hzero a)\n  rw [fibreSlice_right] at eq\n  have hz : fibreSlice (0 : RegOp) s t = 0 := by simp [fibreSlice]\n  rw [hz] at eq\n  have ev := congrArg (fun B : Op => B vacuum) eq\n  have unit : inner ℂ vacuum vacuum = 1 := by\n    rw [inner_self_eq_norm_sq_to_K, F1Rede.BosonicFock.vacuum_norm]; norm_num\n  change fibreSlice (Z*W-W*Z) s t (ketBra a vacuum vacuum) = 0 at ev\n  rwa [ketBra_apply, unit, one_smul] at ev\n\ntheorem central_commutes_coefficient (Z : RegOp) (hZ : Z ∈ core)\n    (hZ' : Z ∈ core.commutant) (u v : F) : Commute Z (coefficientOp u v) := by\n  ext1 f\n  let left : F →L[ℂ] Reg := Z.comp (coefficientCLM u f)\n  let right : F →L[ℂ] Reg := coefficientCLM u (Z f)\n  have he : left = right := by\n    apply ContinuousLinearMap.ext_on right_vacuum_cyclic\n    rintro _ ⟨D,hD,rfl⟩\n    exact congrArg (fun A : RegOp => A f)\n      (central_commutes_orbit_coefficient Z hZ hZ' u D hD).eq\n  exact congrArg (fun A : F →L[ℂ] Reg => A v) he\n\nend K07.PhysicalCoreCenter\n",
+    'TGLExt/PhysicalCoreFactor.lean': "import TGLExt.PhysicalCoreMultipliers\nimport TGLExt.FockCharacters\n\n/-! Strong limits of physical boost coefficients determine the scalar centre\nof the actual regular core. The only geometric input of the final implication\nis an independently meaningful approximation of real characters. -/\nset_option autoImplicit false\nset_option maxHeartbeats 900000\nset_option synthInstance.maxHeartbeats 160000\nnoncomputable section\nopen MeasureTheory Filter\nopen scoped Topology\nnamespace K07.PhysicalCoreCenter\nopen TGLV350.Regular F1Rede.BosonicFock\nopen F1Fecho.CanonicalFockRegular\n\n/-- Rephase by the inverse character and apply dominated convergence in L². -/\ntheorem coefficientOp_tendsto_character (s : ℝ) (v : ℕ → F)\n    (hn : ∀ n, ‖v n‖ ≤ 1)\n    (hv : ∀ x, Tendsto (fun n => coefficient (v n) (v n) x) atTop\n      (𝓝 (characterPhase s x))) (f : Reg) :\n    Tendsto (fun n => coefficientOp (v n) (v n) f) atTop (𝓝 (characterMultiplier s f)) := by\n  let w (n : ℕ) (x : ℝ) := characterPhase (-s) x * coefficient (v n) (v n) x\n  have hc (n) : Continuous (w n) :=\n    (characterPhase_continuous (-s)).mul (coefficient_continuous (v n) (v n))\n  have hb (n x) : ‖w n x‖ ≤ 1 := by\n    change ‖characterPhase (-s) x * coefficient (v n) (v n) x‖ ≤ 1\n    rw [norm_mul, characterPhase_norm, one_mul]\n    exact (coefficient_bound _ _ _).trans\n      ((mul_le_mul (hn n) (hn n) (norm_nonneg _) zero_le_one).trans_eq (one_mul _))\n  have hl (x) : Tendsto (fun n => w n x) atTop (𝓝 1) := by\n    have h := (tendsto_const_nhds (x := characterPhase (-s) x)).mul (hv x)\n    simpa only [characterPhase_add, neg_add_cancel, characterPhase_zero] using h\n  let W (n) : RegOp := F1Fecho.BoundedScalarL2.multiply (w n) (hc n) 1 zero_le_one (hb n)\n  have hW : Tendsto (fun n => W n f) atTop (𝓝 f) :=\n    F1Fecho.BoundedScalarL2.multiply_tendsto w hc 1 zero_le_one hb hl f\n  have he (n) : characterMultiplier s (W n f) = coefficientOp (v n) (v n) f := by\n    apply Lp.ext\n    filter_upwards [characterMultiplier_ae s (W n f),\n      F1Fecho.BoundedScalarL2.multiply_ae (w n) (hc n) 1 zero_le_one (hb n) f,\n      coefficientOp_ae (v n) (v n) f] with x h1 h2 h3\n    change (W n f) x = _ at h2\n    rw [h1,h2,h3,smul_smul]\n    change (characterPhase s x * (characterPhase (-s) x * _)) • f x = _\n    rw [← mul_assoc,characterPhase_add,add_neg_cancel,characterPhase_zero,one_mul]\n  exact (((characterMultiplier (H := F) s).continuous.tendsto f).comp hW).congr\n    (fun n => he n)\n\n/-- A single character in the pointwise closure is enough to force central\n    operators to commute with that dual character. -/\ntheorem central_commutes_character (s : ℝ) (v : ℕ → F)\n    (hn : ∀ n, ‖v n‖ ≤ 1)\n    (hv : ∀ x, Tendsto (fun n => coefficient (v n) (v n) x) atTop (𝓝 (characterPhase s x)))\n    (Z : RegOp) (hZ : Z ∈ core) (hZ' : Z ∈ core.commutant) :\n    Commute Z (characterMultiplier s) := by\n  ext1 f\n  change Z (characterMultiplier s f) = characterMultiplier s (Z f)\n  have left := (Z.continuous.tendsto _).comp (coefficientOp_tendsto_character s v hn hv f)\n  have right := coefficientOp_tendsto_character s v hn hv (Z f)\n  apply tendsto_nhds_unique left\n  exact right.congr (fun n => congrArg (fun A : RegOp => A f)\n    (central_commutes_coefficient Z hZ hZ' (v n) (v n)).eq.symm)\n\n/-- The scalar-centre condition is the literal one on the concrete crossed\n    product. The hypothesis concerns only the physical boost on Fock vectors. -/\ntheorem physical_core_center_from_boost_characters\n    (h : ∀ s : ℝ, ∃ v : ℕ → F, (∀ n, ‖v n‖ ≤ 1) ∧\n      ∀ x, Tendsto (fun n => coefficient (v n) (v n) x) atTop (𝓝 (characterPhase s x)))\n    (Z : RegOp) (hZ : Z ∈ core) (hZ' : Z ∈ core.commutant) :\n    ∃ c : ℂ, Z = c • (1 : RegOp) := by\n  have hz (s : ℝ) : dualAmbient s Z = Z := by\n    obtain ⟨v,hn,hv⟩ := h s\n    exact (dualAmbient_fixed_iff_commutes s Z).mpr\n      (central_commutes_character s v hn hv Z hZ hZ').eq.symm\n  obtain ⟨C,_,rfl⟩ := (F1Fecho.CanonicalFockFaithfulWeight.fixed_core_is_base Z).mp ⟨hZ,hz⟩\n  have hc (B : Op) : C*B=B*C := by\n    apply fibre_injective\n    rw [fibre_mul, fibre_mul]\n    exact central_commutes_all_fibres (fibre C) hZ hZ' B\n  obtain ⟨c,hc'⟩ := commute_wedge_boost_scalar C (fun b _ => hc b) (fun t => hc _)\n  refine ⟨c,?_⟩\n  rw [hc',fibre_smul,fibre_one]\n\n/-- The actual continuous core of the physical Maxwell wedge is a factor. -/\ntheorem physical_core_is_factor (Z : RegOp) (hZ : Z ∈ core) (hZ' : Z ∈ core.commutant) :\n    ∃ c : ℂ, Z = c • (1 : RegOp) := by\n  refine physical_core_center_from_boost_characters ?_ Z hZ hZ'\n  intro s\n  obtain ⟨v,hn,hv⟩ := Vinculo.FockCharacters.fock_character_approximation s\n  exact ⟨v,fun n => (hn n).le,hv⟩\n\n/-- Literal equality of the centre and the scalar operators. -/\ntheorem physical_core_center_eq_scalars (Z : RegOp) :\n    (Z ∈ core ∧ Z ∈ core.commutant) ↔ ∃ c : ℂ, Z = c • (1 : RegOp) := by\n  constructor\n  · rintro ⟨hZ,hZ'⟩\n    exact physical_core_is_factor Z hZ hZ'\n  · rintro ⟨c,rfl⟩\n    exact ⟨core.toStarSubalgebra.smul_mem core.toStarSubalgebra.one_mem c,\n      core.commutant.toStarSubalgebra.smul_mem core.commutant.toStarSubalgebra.one_mem c⟩\n\n/-- Kernel of the dual action restricted to the centre of the continuous core. -/\ndef logPeriods : Set ℝ :=\n  {s | ∀ Z : RegOp, Z ∈ core → Z ∈ core.commutant → dualAmbient s Z = Z}\n\ntheorem physical_log_periods (s : ℝ) : s ∈ logPeriods := by\n  intro Z hm hc\n  obtain ⟨c,rfl⟩ := physical_core_is_factor Z hm hc\n  rw [map_smul, map_one]\n\n/-- Concrete value of the Connes–Takesaki flow-of-weights formula.\nThe general comparison with the intersection over all modular weights is\nthe classification theorem, independent of this concrete computation. -/\ntheorem physical_flow_of_weights_spectrum :\n    insert (0 : ℝ) (Real.exp '' logPeriods) = Set.Ici 0 := by\n  ext r\n  change (r = 0 ∨ ∃ t ∈ logPeriods, Real.exp t = r) ↔ 0 ≤ r\n  constructor\n  · rintro (rfl | ⟨t, _, rfl⟩)\n    · exact le_rfl\n    · exact (Real.exp_pos t).le\n  · intro hr\n    rcases eq_or_lt_of_le hr with hz | hp\n    · exact Or.inl hz.symm\n    · exact Or.inr ⟨Real.log r, physical_log_periods _, Real.exp_log hp⟩\n\nend K07.PhysicalCoreCenter\n",
+    'TGLExt/TowerWedgeIndex.lean': "import TGLExt.ModularFlowSpectrum\nimport TGLExt.AffineClockAndRegion\nimport TGLExt.V350WedgeModularData\nimport TGLExt.FlagNetV31\nimport TGLExt.LightRhoStar\nimport TGLExt.F1Fecho394.CanonicalFockModularCoreInputR1\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\n\n/-! Vínculo entre os rótulos modulares da torre e o observador da cunha direita.\n    A orientação de rapidez é fixada por `wedgeBoostMap_nullDir`. -/\nnoncomputable section\nnamespace K07.TowerWedge\n\nopen TGLExt ChatgptAudit TGLExt.ImportedSQ TGLExt.ContratoQGv31 TGL.SpecificAQFT\nopen F1Fecho.CanonicalFockModularCoreInputR1\n\n/-- Rapidez que tem por fator de dilatação o autovalor modular da unidade\nmatricial (i,j) na representação da torre. -/\ndef rapidity (P : SiteProfile) (N : ℕ) (i j : chainIdx N) : ℝ :=\n  Real.log (localEigenvalue P N i j)\n\ntheorem exp_rapidity (P : SiteProfile) (N : ℕ) (i j : chainIdx N) :\n    Real.exp (rapidity P N i j) = localEigenvalue P N i j :=\n  Real.exp_log (localEigenvalue_pos N i j)\n\ntheorem rapidity_unique (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (s : ℝ) :\n    Real.exp s = localEigenvalue P N i j ↔ s = rapidity P N i j := by\n  rw [← exp_rapidity P N i j, Real.exp_injective.eq_iff]\n\n/-- As unidades matriciais componíveis somam suas rapidezes. -/\ntheorem rapidity_comp (P : SiteProfile) (N : ℕ) (i j k : chainIdx N) :\n    rapidity P N i j + rapidity P N j k = rapidity P N i k := by\n  simp only [rapidity, localEigenvalue, Real.log_div (towerW_pos P N _).ne'\n    (towerW_pos P N _).ne']\n  ring\n\n/-- O embutimento da torre envia Eᵢⱼ a Eᵢⱼ ⊗ 1. Cada parcela diagonal\nna letra acrescentada guarda exatamente a rapidez anterior. -/\ntheorem rapidity_refine (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (a : Fin 2) :\n    rapidity P (N+1) (i,a) (j,a) = rapidity P N i j := by\n  have ha := (siteW_pos (P.pos (N+1)) (P.lt_one (N+1)) a).ne'\n  simp only [rapidity, localEigenvalue, towerW, mul_div_mul_right _ _ ha]\n\ntheorem tower_unit_flow (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (t : ℝ) :\n    modularFlow P t (localEigenvector P N i j) =\n      modularPhase t (rapidity P N i j) • localEigenvector P N i j :=\n  modularFlow_eigenvector t N i j\n\nvariable {L : LightOneParticle} (C : FockCertificate L)\n\n/-- O boost de rapidez lida na torre atua na translação física de Fock. -/\ntheorem indexed_boost_translation (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (l : ℝ) :\n    ((lightBoost C).V (rapidity P N i j)).conjStarAlgEquiv ((lightNet C).U (l • nullDir)) =\n      (lightNet C).U ((localEigenvalue P N i j * l) • nullDir) := by\n  rw [(lightBoost C).V_translations, wedgeBoostMap_smul, wedgeBoostMap_nullDir,\n    smul_smul, exp_rapidity, mul_comm l]\n\nset_option backward.isDefEq.respectTransparency false in\n/-- A mesma operação é um instante do relógio modular da cunha. -/\ntheorem indexed_modular_translation (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (l : ℝ) :\n    (lightDelta C (-(rapidity P N i j)/(2*Real.pi))).conjStarAlgEquiv\n      ((lightNet C).U (l • nullDir)) =\n      (lightNet C).U ((localEigenvalue P N i j * l) • nullDir) := by\n  have ht : -(2*Real.pi*(-(rapidity P N i j)/(2*Real.pi))) = rapidity P N i j := by\n    field_simp [Real.pi_ne_zero]\n  unfold lightDelta\n  rw [ht]\n  exact indexed_boost_translation C P N i j l\n\ndef rapidityLabels (P : SiteProfile) : Set ℝ :=\n  {s | ∃ (N : ℕ) (i j : chainIdx N), s = rapidity P N i j}\n\ntheorem first_mixed_rapidity :\n    rapidity mixProfile 0 0 1 = Real.log ((1:ℝ)/2) := by\n  norm_num [rapidity, localEigenvalue, towerW, siteW, mixProfile]\n\ntheorem second_mixed_rapidity :\n    rapidity mixProfile 1 (0,0) (0,1) = Real.log ((1:ℝ)/3) := by\n  norm_num [rapidity, localEigenvalue, towerW, siteW, mixProfile]\n\ntheorem mixed_generators :\n    ({Real.log ((1:ℝ)/2), Real.log ((1:ℝ)/3)} : Set ℝ) ⊆ rapidityLabels mixProfile := by\n  intro s hs\n  rcases hs with h | h\n  · exact ⟨0,0,1,h.trans first_mixed_rapidity.symm⟩\n  · exact ⟨1,(0,0),(0,1),(Set.mem_singleton_iff.mp h).trans second_mixed_rapidity.symm⟩\n\ntheorem mixed_rapidities_dense :\n    Dense ((AddSubgroup.closure (rapidityLabels mixProfile) : AddSubgroup ℝ) : Set ℝ) :=\n  the_mixing_mark.mono (AddSubgroup.closure_mono mixed_generators)\n\n/-- Em cada vetor de Fock, a órbita de todos os boosts é aproximada pelas\ncomposições dos boosts indexados. A topologia usada aqui é a norma do vetor. -/\ntheorem mixed_boost_orbit_dense (v : C.F) :\n    Set.range (fun s : ℝ => (lightBoost C).V s v) ⊆\n      closure ((fun s : ℝ => (lightBoost C).V s v) ''\n        ((AddSubgroup.closure (rapidityLabels mixProfile) : AddSubgroup ℝ) : Set ℝ)) :=\n  ((lightBoost C).V_continuous v).range_subset_closure_image_dense mixed_rapidities_dense\n\nabbrev towerAlgebra (P : SiteProfile) := (theFactorObject P).toStarSubalgebra\nabbrev wedgeAlgebra := (C.R (L.K rightWedge)).toStarSubalgebra\n\n/-- Unidade matricial dentro do objeto de von Neumann da torre. -/\ndef towerUnit (P : SiteProfile) (N : ℕ) (i j : chainIdx N) : towerAlgebra P :=\n  ⟨towerPi P (Matrix.single i j 1), towerPi_mem_factor _⟩\n\ntheorem tower_unit_character (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (t : ℝ) :\n    V350Continuous.factorFlow P t (towerUnit P N i j) =\n      modularPhase t (rapidity P N i j) • towerUnit P N i j := by\n  apply Subtype.ext\n  change modularConjugation P t (towerPi P (Matrix.single i j 1)) =\n    modularPhase t (rapidity P N i j) • towerPi P (Matrix.single i j 1)\n  rw [modularConjugation_local, flowLevel_single, towerPi_smul]\n  rfl\n\n/-- Cunha direita deslocada no gerador nulo futuro. -/\ndef nullWedge (l : ℝ) : Set (Fin 4 → ℝ) :=\n  TGL.SpecificAQFT.translate (l • nullDir) rightWedge\n\ntheorem boost_null_wedge (s l : ℝ) :\n    wedgeBoostMap s '' nullWedge l = nullWedge (Real.exp s * l) := by\n  change wedgeBoostMap s '' ((fun x => x + l • nullDir) '' rightWedge) =\n    (fun x => x + (Real.exp s * l) • nullDir) '' rightWedge\n  calc\n    _ = (fun y => y + (Real.exp s * l) • nullDir) '' (wedgeBoostMap s '' rightWedge) := by\n      rw [Set.image_image, Set.image_image]\n      apply Set.image_congr\n      intro x _\n      change wedgeBoostMap s (x + l • nullDir) = wedgeBoostMap s x + (Real.exp s * l) • nullDir\n      have hadd : wedgeBoostMap s (x + l • nullDir) =\n          wedgeBoostMap s x + wedgeBoostMap s (l • nullDir) := by\n        unfold wedgeBoostMap\n        rw [Matrix.mulVec_add]\n      rw [hadd, wedgeBoostMap_smul, wedgeBoostMap_nullDir, smul_smul, mul_comm l]\n    _ = _ := by rw [FlagNet.boost_image_rightWedge]\n\n/-- Em álgebras locais, o mesmo índice transporta a cunha inteira. -/\ntheorem indexed_local_covariance (P : SiteProfile) (N : ℕ) (i j : chainIdx N) (l : ℝ)\n    (a : (lightNet C).H →L[ℂ] (lightNet C).H) (ha : a ∈ (lightNet C).net (nullWedge l)) :\n    ((lightBoost C).V (rapidity P N i j)).conjStarAlgEquiv a ∈\n      (lightNet C).net (nullWedge (localEigenvalue P N i j * l)) := by\n  have h := (lightBoost C).V_net (rapidity P N i j) (nullWedge l) a ha\n  rwa [boost_null_wedge, exp_rapidity] at h\n\nprivate theorem translations_injective : Function.Injective (lightNet C).U := by\n  intro a b hab\n  have h0 : (lightNet C).U (a + -b) = 1 := by\n    rw [(lightNet C).U_add, hab, ← (lightNet C).U_add, add_neg_cancel, (lightNet C).U_zero]\n  exact sub_eq_zero.mp (by simpa [sub_eq_add_neg] using light_translations_faithful C _ h0)\n\n/-- A ação em uma translação nula unitária discrimina quaisquer duas\nrapidezes; a identificação da escala também é fiel na representação. -/\ntheorem null_translation_reads_rapidity :\n    Function.Injective (fun s : ℝ =>\n      ((lightBoost C).V s).conjStarAlgEquiv ((lightNet C).U nullDir)) := by\n  intro s t h\n  change ((lightBoost C).V s).conjStarAlgEquiv ((lightNet C).U nullDir) =\n    ((lightBoost C).V t).conjStarAlgEquiv ((lightNet C).U nullDir) at h\n  rw [(lightBoost C).V_translations, (lightBoost C).V_translations,\n    wedgeBoostMap_nullDir, wedgeBoostMap_nullDir] at h\n  have hcoord := congrFun (translations_injective C h) (0 : Fin 4)\n  apply Real.exp_injective\n  simpa [nullDir] using hcoord\n\n/-- Períodos do vetor no grupo unitário do observador da cunha. -/\ndef boostPeriods (v : C.F) : AddSubgroup ℝ where\n  carrier := {s | (lightBoost C).V s v = v}\n  zero_mem' := by change (lightBoost C).V 0 v = v; rw [(lightBoost C).V_zero]; rfl\n  add_mem' := by\n    intro s t hs ht\n    change (lightBoost C).V s v = v at hs\n    change (lightBoost C).V t v = v at ht\n    change (lightBoost C).V (s+t) v = v\n    rw [(lightBoost C).V_add, LinearIsometryEquiv.trans_apply, ht, hs]\n  neg_mem' := by\n    intro s hs\n    change (lightBoost C).V s v = v at hs\n    change (lightBoost C).V (-s) v = v\n    calc\n      (lightBoost C).V (-s) v = (lightBoost C).V (-s) ((lightBoost C).V s v) := congrArg _ hs.symm\n      _ = (lightBoost C).V (-s + s) v := by rw [(lightBoost C).V_add]; rfl\n      _ = v := by rw [neg_add_cancel, (lightBoost C).V_zero]; rfl\n\n/-- Duas leituras efetivas dos primeiros andares da torre recuperam a\nreta do vácuo no espaço de Fock completo. -/\ntheorem two_tower_boosts_read_vacuum (v : C.F) :\n    ((lightBoost C).V (rapidity mixProfile 0 0 1) v = v ∧\n      (lightBoost C).V (rapidity mixProfile 1 (0,0) (0,1)) v = v) ↔\n      v ∈ (ℂ ∙ C.Ω) := by\n  rw [first_mixed_rapidity, second_mixed_rapidity]\n  constructor\n  · intro ⟨hh,ht⟩\n    have hsub : AddSubgroup.closure\n        {Real.log ((1:ℝ)/2),Real.log ((1:ℝ)/3)} ≤ boostPeriods C v :=\n      (AddSubgroup.closure_le _).mpr (by\n        intro s hs\n        rcases hs with h | h\n        · rw [h]; exact hh\n        · rw [Set.mem_singleton_iff.mp h]; exact ht)\n    have hclosed : IsClosed ((boostPeriods C v : AddSubgroup ℝ) : Set ℝ) :=\n      isClosed_eq ((lightBoost C).V_continuous v) continuous_const\n    apply (QGReaderUVLock.light_modular_fixed_iff_vacuum C v).mp\n    intro t\n    exact (closure_minimal (show\n      ((AddSubgroup.closure {Real.log ((1:ℝ)/2),Real.log ((1:ℝ)/3)} : AddSubgroup ℝ) : Set ℝ)\n        ⊆ (boostPeriods C v : Set ℝ) from hsub) hclosed) (the_mixing_mark (-(2*Real.pi*t)))\n  · intro hv\n    obtain ⟨c,rfl⟩ := Submodule.mem_span_singleton.mp hv\n    have h (s : ℝ) : (lightBoost C).V s (c • C.Ω) = c • C.Ω := by\n      change C.Γ (B0 s) (c • C.Ω) = c • C.Ω\n      rw [map_smul, C.Γ_vac]\n    exact ⟨h _,h _⟩\n\ndef modularTime (s : ℝ) : ℝ := -s / (2*Real.pi)\n\ntheorem boost_parameter_at_modular_time (s : ℝ) :\n    -(2*Real.pi*modularTime s) = s := by\n  unfold modularTime\n  field_simp [Real.pi_ne_zero]\n\nprivate theorem boost_vector_fixed (s : ℝ) (a : wedgeAlgebra C)\n    (h : C.flow (modularTime s) a = a) :\n    (lightBoost C).V s ((a : C.F →L[ℂ] C.F) C.Ω) = (a : C.F →L[ℂ] C.F) C.Ω := by\n  have had := C.flow_is_Ad (modularTime s) a\n  rw [h, boost_parameter_at_modular_time] at had\n  have hv := congrArg (fun T : C.F →L[ℂ] C.F => T C.Ω) had\n  have hsym : (C.Γ (B0 s)).symm C.Ω = C.Ω := by\n    apply (C.Γ (B0 s)).injective\n    rw [LinearIsometryEquiv.apply_symm_apply, C.Γ_vac]\n  simp only [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply,hsym] at hv\n  exact hv.symm\n\n/-- Os dois instantes determinados na torre separam os escalares de todos\nos demais observáveis da cunha por dois testes exatos de fixidez. -/\ntheorem two_tower_times_read_scalars (a : wedgeAlgebra C) :\n    (C.flow (modularTime (rapidity mixProfile 0 0 1)) a = a ∧\n      C.flow (modularTime (rapidity mixProfile 1 (0,0) (0,1))) a = a) ↔\n      ∃ c : ℂ, a = algebraMap ℂ (wedgeAlgebra C) c := by\n  constructor\n  · intro ⟨h₁,h₂⟩\n    have hline := (two_tower_boosts_read_vacuum C ((a : C.F →L[ℂ] C.F) C.Ω)).mp\n      ⟨boost_vector_fixed C _ a h₁, boost_vector_fixed C _ a h₂⟩\n    obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp hline\n    let b := a - algebraMap ℂ (wedgeAlgebra C) c\n    have hb : (b : C.F →L[ℂ] C.F) C.Ω = 0 := by\n      simp [b, Algebra.algebraMap_eq_smul_one, ← hc]\n    have hz := C.wedge_separating _ b.property hb\n    refine ⟨c, sub_eq_zero.mp ?_⟩\n    exact Subtype.ext hz\n  · rintro ⟨c,rfl⟩\n    exact ⟨AlgHomClass.commutes _ c,AlgHomClass.commutes _ c⟩\n\n/-- Projeção de um sítio da torre, dentro do bicomutante. -/\ndef siteProjection (P : SiteProfile) (n : ℕ) : towerAlgebra P :=\n  ⟨siteOperator P n (Matrix.single 0 0 1), siteOperator_mem_factor _ _⟩\n\ntheorem site_fixed (P : SiteProfile) (n : ℕ) (t : ℝ) :\n    V350Continuous.factorFlow P t (siteProjection P n) = siteProjection P n :=\n  Subtype.ext (Cocycle030.site_zero_modular_fixed P n t)\n\n/-- O confronto com E₀₁, no mesmo sítio, exclui qualquer valor escalar. -/\ntheorem site_nonscalar (P : SiteProfile) (n : ℕ) (c : ℂ) :\n    siteProjection P n ≠ algebraMap ℂ (towerAlgebra P) c := by\n  intro h\n  have he := congrArg (fun a : towerAlgebra P => (a : TowerHilbert P →L[ℂ] TowerHilbert P)) h\n  change siteOperator P n (Matrix.single 0 0 1) =\n    algebraMap ℂ (TowerHilbert P →L[ℂ] TowerHilbert P) c at he\n  apply Clock040.region_site_noncommutation (P := P) n\n  rw [he]\n  exact Algebra.commutes c _\n\n/-- Nenhuma injeção algébrica unital e complexa entrelaça os dois fluxos\ncom seus estados escolhidos, mesmo admitindo qualquer reparametrização\ndo tempo da torre como função do tempo da cunha. -/\ntheorem no_flow_intertwining_embedding (P : SiteProfile) (clock : ℝ → ℝ)\n    (φ : towerAlgebra P →ₐ[ℂ] wedgeAlgebra C) (hinj : Function.Injective φ)\n    (hcov : ∀ (t : ℝ) (a : towerAlgebra P),\n      φ (V350Continuous.factorFlow P (clock t) a) = C.flow t (φ a)) : False := by\n  let p := siteProjection P 0\n  have hfix (t : ℝ) : C.flow t (φ p) = φ p := by\n    rw [← hcov]\n    exact congrArg φ (site_fixed P 0 (clock t))\n  obtain ⟨c, hc⟩ := LightRhoStar.centralizer_is_trivial C (φ p) hfix\n  apply site_nonscalar P 0 c\n  apply hinj\n  rw [φ.commutes]\n  apply Subtype.ext\n  simpa [Algebra.algebraMap_eq_smul_one] using hc\n\ntheorem physical_wedge_index (N : ℕ) (i j : chainIdx N) (l : ℝ) :\n    ((lightBoost physicalFockCertificate).V (rapidity mixProfile N i j)).conjStarAlgEquiv\n      ((lightNet physicalFockCertificate).U (l • nullDir)) =\n      (lightNet physicalFockCertificate).U ((localEigenvalue mixProfile N i j * l) • nullDir) :=\n  indexed_boost_translation physicalFockCertificate mixProfile N i j l\n\ntheorem physical_no_flow_intertwining_embedding (P : SiteProfile) (clock : ℝ → ℝ)\n    (φ : towerAlgebra P →ₐ[ℂ] wedgeAlgebra physicalFockCertificate) (hinj : Function.Injective φ)\n    (hcov : ∀ (t : ℝ) (a : towerAlgebra P),\n      φ (V350Continuous.factorFlow P (clock t) a) = physicalFockCertificate.flow t (φ a)) : False :=\n  no_flow_intertwining_embedding physicalFockCertificate P clock φ hinj hcov\n\n\nend K07.TowerWedge\n",
+    'TGLExt/TipoIIIUmSoBoost.lean': 'import TGLExt.TowerWedgeIndex\nimport TGLExt.ErgodicidadeDeMautner\n\nset_option autoImplicit false\nnoncomputable section\n\n/-!\n# Um só número da Torre já lê o vácuo\n\n`K07.TowerWedge.two_tower_boosts_read_vacuum` prova que um vetor fixo por DOIS boosts indexados pela Torre\nestá na reta do vácuo. `ErgodicidadeDeMautner` prova que UM boost não nulo basta.\nAqui os dois se encontram: a Torre, que é índice, não precisa de dois números para apontar o vácuo; um só,\ndesde que não nulo, aponta. A hipótese de dois boosts é, portanto, mais forte do que o necessário,\ne a equivalência abaixo o diz por termo.\n\nDepende de `ErgodicidadeDeMautner`, por isso fica em arquivo separado de\n`TipoIIIControles`.\n-/\n\nnamespace Vinculo.Controles\n\nopen TGLExt ChatgptAudit TGLExt.ImportedSQ TGLExt.ContratoQGv31 TGL.SpecificAQFT\nopen F1Fecho.CanonicalFockModularCoreInputR1 (physicalFockCertificate)\nopen K07.TowerWedge\n\n/-- O primeiro número da Torre (nível 0, unidade (0,1)) não é zero. -/\ntheorem o_primeiro_numero_da_torre_nao_e_zero : rapidity mixProfile 0 0 1 ≠ 0 := by\n  rw [first_mixed_rapidity]\n  exact (Real.log_neg (by norm_num) (by norm_num)).ne\n\n/-- ★ Um vetor fixo pelo boost de UM só número da Torre está na reta do vácuo. -/\ntheorem um_so_numero_da_torre_le_o_vacuo (v : physicalFockCertificate.F)\n    (h : (lightBoost physicalFockCertificate).V (rapidity mixProfile 0 0 1) v = v) :\n    v ∈ (ℂ ∙ physicalFockCertificate.Ω) := by\n  obtain ⟨c, hc⟩ := (TGLExt.ErgodicidadeDeMautner.os_fixos_de_um_so_boost_da_luz_sao_a_reta_do_vacuo\n    _ o_primeiro_numero_da_torre_nao_e_zero v).mp h\n  exact Submodule.mem_span_singleton.mpr ⟨c, hc.symm⟩\n\n/-- A hipótese de dois boosts equivale à de um só: o segundo número não acrescenta. -/\ntheorem dois_numeros_nao_acrescentam_a_um (v : physicalFockCertificate.F) :\n    ((lightBoost physicalFockCertificate).V (rapidity mixProfile 0 0 1) v = v ∧\n      (lightBoost physicalFockCertificate).V (rapidity mixProfile 1 (0,0) (0,1)) v = v) ↔\n      (lightBoost physicalFockCertificate).V (rapidity mixProfile 0 0 1) v = v :=\n  ⟨fun h => h.1, fun h =>\n    (two_tower_boosts_read_vacuum physicalFockCertificate v).mpr (um_so_numero_da_torre_le_o_vacuo v h)⟩\n\n\nend Vinculo.Controles\n',
+    'TGLExt/WedgeFactor.lean': "import TGLExt.F1Fecho394.CanonicalFockModularCoreInputR1\nimport TGLExt.F1Fecho394.CanonicalFockRegularCoreR2\nimport TGLExt.QGReaderUVLock\nimport TGLExt.V351ModularFixedVectors\n\n/-! The centre of the Maxwell wedge from the Tomita graph of its vacuum.\nThe half-eigenvector calculation below specializes the existing calculation\nin TGLExt.V351ModularFixedVectors to the actual Weyl vacuum resolvent. -/\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nnoncomputable section\nnamespace Vinculo.WedgeFactor\nopen TGLExt ChatgptAudit TGLV350.Regular F1Rede.BosonicFock\nopen F1Fecho.CanonicalFockRegular F1Fecho.CanonicalFockPolar ORDEM016.D6\nopen F1Fecho.CanonicalFockModularCoreInputR1 (physicalFockCertificate)\n\nprivate theorem phase_at_half {H : Type} [NormedAddCommGroup H]\n    [InnerProductSpace ℂ H] [CompleteSpace H]\n    (T : H →L[ℂ] H) (hT : IsSelfAdjoint T) (x : H)\n    (hx : T x = (1/2 : ℂ) • x) (t : ℝ) :\n    resolventPhaseOperator T t x = (1/4 : ℂ) • x := by\n  by_cases hz : x = 0\n  · simp [hz]\n  let L : H →L[ℂ] H := InnerProductSpace.rankOne ℂ x x\n  let Q : H →L[ℂ] H := algebraMap ℂ (H →L[ℂ] H) (1/2)\n  have hQ : IsSelfAdjoint Q := by\n    change star (algebraMap ℂ (H →L[ℂ] H) (1/2)) = _\n    rw [← algebraMap_star_comm]\n    norm_num [Q]\n  have hL : T*L = L*Q := by\n    ext1 y\n    change T ((inner ℂ x y) • x) =\n      (inner ℂ x ((1/2 : ℂ) • y)) • x\n    rw [map_smul,hx,inner_smul_right,smul_smul]\n    congr 1\n    ring\n  have hp : resolventPhaseOperator Q t =\n      algebraMap ℂ (H →L[ℂ] H) (1/4) := by\n    change cfc (fun z : ℂ => resolventPhaseFunction t z.re)\n      (algebraMap ℂ (H →L[ℂ] H) (1/2)) = _\n    rw [cfc_algebraMap]\n    congr 1\n    norm_num [resolventPhaseFunction,resolventDamping,modularPhase]\n  have he := congrArg (fun B : H →L[ℂ] H => B x)\n    (resolventPhaseOperator_intertwines T Q L hT hQ hL t)\n  rw [hp] at he\n  change resolventPhaseOperator T t ((inner ℂ x x) • x) =\n    (inner ℂ x ((1/4 : ℂ) • x)) • x at he\n  rw [map_smul,inner_smul_right] at he\n  apply smul_right_injective H (inner_self_ne_zero.mpr hz : inner ℂ x x ≠ 0)\n  calc\n    _ = ((1/4 : ℂ) * inner ℂ x x) • x := he\n    _ = _ := by\n      dsimp only\n      rw [smul_smul,mul_comm]\n\nabbrev Op := F →L[ℂ] F\n\n/-- The vacuum trace identity for z* puts (zΩ,zΩ) in the graph of S*S. -/\ntheorem vacuum_square_fixed (z : Op) (hz : z ∈ M)\n    (hω : ∀ a ∈ M, inner ℂ vacuum ((star z) (a vacuum)) =\n      inner ℂ vacuum (a ((star z) vacuum))) :\n    (z vacuum, z vacuum) ∈ antilinearSquareGraph actualGraph := by\n  refine ⟨(star z) vacuum, subset_closure ⟨z, hz, rfl⟩, ?_⟩\n  intro y sy hy\n  let K : Set (F × F) := {p | inner ℂ (z vacuum) p.1 = inner ℂ p.2 ((star z) vacuum)}\n  have hclosed : IsClosed K := isClosed_eq\n    (continuous_const.inner continuous_fst) (continuous_snd.inner continuous_const)\n  apply (closure_minimal (t := K) ?_ hclosed) hy\n  rintro _ ⟨a, ha, rfl⟩\n  change inner ℂ (z vacuum) (a vacuum) = inner ℂ ((star a) vacuum) ((star z) vacuum)\n  rw [← z.adjoint_inner_right, ContinuousLinearMap.star_eq_adjoint a, a.adjoint_inner_left]\n  exact hω a ha\n\ntheorem vacuum_trace_scalar (z : Op) (hz : z ∈ M)\n    (hω : ∀ a ∈ M, inner ℂ vacuum ((star z) (a vacuum)) =\n      inner ℂ vacuum (a ((star z) vacuum))) : ∃ c : ℂ, z = c • (1 : Op) := by\n  let x := z vacuum\n  have hinv := modularR_inverse x x (vacuum_square_fixed z hz hω)\n  have hx : modularR x = (1/2 : ℂ) • x := by\n    have hh := congrArg (fun y : F => (1/2 : ℂ) • y) hinv\n    rw [map_add, ← two_smul ℂ, smul_smul] at hh\n    norm_num at hh\n    exact hh\n  have hd : resolventDampingOperator modularR x = (1/4 : ℂ) • x := by\n    change modularR (x - modularR x) = _\n    rw [map_sub, hx, map_smul, hx, smul_smul, ← sub_smul]\n    norm_num\n  have fixed (t : ℝ) : TGLExt.ImportedSQ.lightDelta physicalFockCertificate t x = x := by\n    have hp := phase_at_half modularR (IsSelfAdjoint.of_nonneg modularR_nonneg) x hx t\n    have he := actualModularFlow_readout t x\n    rw [hd, hp, map_smul] at he\n    have hf := smul_right_injective F (by norm_num : (1/4 : ℂ) ≠ 0) he\n    exact (F1Fecho.CanonicalFockBW.actualModularFlow_eq_gamma_apply t x).symm.trans hf\n  obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp\n    ((TGLExt.QGReaderUVLock.light_modular_fixed_iff_vacuum physicalFockCertificate x).mp fixed)\n  refine ⟨c, sub_eq_zero.mp (F1Fecho.WedgeCyclic.canonical_wedge_separating\n    (z-c • (1 : Op)) (M.sub_mem hz (M.smul_mem M.one_mem c)) ?_)⟩\n  change z vacuum - c • vacuum = 0\n  exact sub_eq_zero.mpr hc.symm\n\nprivate theorem central_state_identity {H : Type} [NormedAddCommGroup H]\n    [InnerProductSpace ℂ H] [CompleteSpace H] (A : VonNeumannAlgebra H) (Ω : H)\n    (z : H →L[ℂ] H) (hz : z ∈ A.commutant) (a : H →L[ℂ] H) (ha : a ∈ A) :\n    inner ℂ Ω ((star z) (a Ω)) = inner ℂ Ω (a ((star z) Ω)) := by\n  have hs : star z ∈ A.commutant := A.commutant.toStarSubalgebra.star_mem' hz\n  have hc : a * star z = star z * a :=\n    (VonNeumannAlgebra.mem_commutant_iff (S := A) (z := star z)).mp hs a ha\n  change inner ℂ Ω ((star z * a) Ω) = inner ℂ Ω ((a * star z) Ω)\n  rw [hc]\n\ntheorem wedge_center_scalar (z : Op) (hz : z ∈ M) (hz' : z ∈ M.commutant) :\n    ∃ c : ℂ, z = c • (1 : Op) :=\n  vacuum_trace_scalar z hz (central_state_identity M vacuum z hz')\n\nend Vinculo.WedgeFactor\n",
+    'TGLExt/WedgeHorizonObserver.lean': "import TGLExt.F1Fecho394.PhysicalFockNetRealizationR2\nimport TGLExt.FlagNetV31\n\n/-! Covariant two-sided reading of the actual right-wedge boundary and its\nMaxwell Weyl algebra. A transverse shear supplies a negative control. -/\n\nset_option autoImplicit false\nset_option maxHeartbeats 1200000\nnoncomputable section\n\nnamespace K07.Horizon\nopen Filter Topology TGL.SpecificAQFT TGLExt TGLExt.ContratoQGv31\nopen TGLExt.ImportedSQ F1Rede.BosonicFock F1Fecho.MaxwellLocalization\nopen F1Fecho.OrbitalScreen F1Fecho.OrbitalSpatial F1Fecho.SpacetimeLorentz\nopen F1Fecho.MaxwellGlobal F1Fecho.PhysicalFockNet\n\nabbrev Point := Fin 4 → ℝ\n\ndef u (x : Point) := x 1 + x 0\ndef v (x : Point) := x 1 - x 0\ndef futureSheet : Set Point := {x | v x = 0 ∧ 0 ≤ u x}\ndef pastSheet : Set Point := {x | u x = 0 ∧ 0 ≤ v x}\n\ntheorem wedge_read (x : Point) : x ∈ rightWedge ↔ 0 < u x ∧ 0 < v x := by\n  change |x 0| < x 1 ↔ _\n  rw [abs_lt]\n  unfold u v\n  constructor <;> intro h <;> constructor <;> linarith [h.1, h.2]\n\ntheorem closure_rightWedge :\n    closure rightWedge = {x : Point | |x 0| ≤ x 1} := by\n  apply Set.Subset.antisymm\n  · refine closure_minimal ?_ (isClosed_le (by fun_prop) (by fun_prop))\n    intro x hx\n    exact (show |x 0| < x 1 from hx).le\n  · intro x hx\n    change |x 0| ≤ x 1 at hx\n    let d : Point := fun i => if i=1 then 1 else 0\n    let p : ℝ → Point := fun t => x + t • d\n    have hc : Continuous p := by dsimp [p]; fun_prop\n    have ht : Tendsto (fun n : ℕ => p (1 / ((n:ℝ)+1))) atTop (𝓝 x) := by\n      have h := (hc.continuousAt (x := 0)).tendsto.comp\n        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))\n      simpa [Function.comp_def,p] using h\n    apply mem_closure_of_tendsto ht\n    apply Eventually.of_forall\n    intro n\n    change |(p (1/((n:ℝ)+1))) 0| < (p (1/((n:ℝ)+1))) 1\n    change |x 0 + (1 / ((n:ℝ)+1)) * (0:ℝ)| < x 1 + (1 / ((n:ℝ)+1)) * 1\n    rw [mul_zero,add_zero,mul_one]\n    exact lt_add_of_le_of_pos hx (by positivity)\n\ntheorem boundary_two_sheets : frontier rightWedge = futureSheet ∪ pastSheet := by\n  have ho : IsOpen rightWedge := isOpen_lt (by fun_prop) (by fun_prop)\n  rw [frontier, closure_rightWedge, ho.interior_eq]\n  ext x\n  change (|x 0| ≤ x 1 ∧ ¬ |x 0| < x 1) ↔\n    (v x = 0 ∧ 0 ≤ u x) ∨ (u x = 0 ∧ 0 ≤ v x)\n  unfold u v\n  constructor\n  · intro h\n    have he := le_antisymm h.1 (le_of_not_gt h.2)\n    rcases le_total 0 (x 0) with hp | hn\n    · rw [abs_of_nonneg hp] at he\n      exact Or.inl ⟨by linarith, by linarith⟩\n    · rw [abs_of_nonpos hn] at he\n      exact Or.inr ⟨by linarith, by linarith⟩\n  · rintro (⟨he,h⟩ | ⟨he,h⟩)\n    · rw [abs_of_nonneg (show 0 ≤ x 0 by linarith)]\n      exact ⟨by linarith, by linarith⟩\n    · rw [abs_of_nonpos (show x 0 ≤ 0 by linarith)]\n      exact ⟨by linarith, by linarith⟩\n\ntheorem bifurcation (x : Point) :\n    x ∈ futureSheet ∩ pastSheet ↔ x 0 = 0 ∧ x 1 = 0 := by\n  change ((x 1-x 0=0 ∧ 0≤x 1+x 0) ∧ (x 1+x 0=0 ∧ 0≤x 1-x 0)) ↔ _\n  constructor\n  · rintro ⟨⟨h1,_⟩,h2,_⟩\n    exact ⟨by linarith, by linarith⟩\n  · rintro ⟨h1,h2⟩\n    simp [h1,h2]\n\ndef readPoint (x : Point) : Point := ![u x,v x,x 2,x 3]\n\ntheorem readPoint_injective : Function.Injective readPoint := by\n  intro x y he\n  have h0 : x 1+x 0=y 1+y 0 := congrFun he 0\n  have h1 : x 1-x 0=y 1-y 0 := congrFun he 1\n  funext i\n  fin_cases i\n  · change x 0 = y 0\n    linarith\n  · change x 1 = y 1\n    linarith\n  · exact congrFun he 2\n  · exact congrFun he 3\n\ntheorem boost_read (s : ℝ) (x : Point) :\n    u (wedgeBoostMap s x)=Real.exp s*u x ∧\n    v (wedgeBoostMap s x)=Real.exp (-s)*v x ∧\n    wedgeBoostMap s x 2=x 2 ∧ wedgeBoostMap s x 3=x 3 := by\n  unfold u v\n  rw [wedgeBoostMap_apply0,wedgeBoostMap_apply1,←Real.cosh_add_sinh,←Real.cosh_sub_sinh]\n  refine ⟨by ring, by ring, ?_, ?_⟩ <;>\n    simp [wedgeBoostMap,boostMat,Matrix.mulVec,dotProduct,Fin.sum_univ_four]\n\ndef observerChart (L : generatedLorentz) (a : Point) : Point ≃ₜ Point where\n  toFun x := lorentzEquiv L.val x + a\n  invFun x := (lorentzEquiv L.val).symm (x - a)\n  left_inv x := by simp\n  right_inv x := by simp\n  continuous_toFun := (lorentzEquiv L.val).toContinuousLinearEquiv.continuous.add continuous_const\n  continuous_invFun := (lorentzEquiv L.val).symm.toContinuousLinearEquiv.continuous.comp\n    (continuous_id.sub continuous_const)\n\ntheorem observer_region (L : generatedLorentz) (a : Point) (O : Set Point) :\n    observerChart L a '' O = TGL.SpecificAQFT.translate a (lorentzEquiv L.val '' O) := by\n  ext y\n  constructor\n  · rintro ⟨x,hx,rfl⟩\n    exact ⟨lorentzEquiv L.val x,⟨x,hx,rfl⟩,rfl⟩\n  · rintro ⟨_,⟨x,hx,rfl⟩,rfl⟩\n    exact ⟨x,hx,rfl⟩\n\ntheorem coordinate_lorentz_region (L : generatedLorentz) (O : Set Point) :\n    coordinateRegion (lorentzEquiv L.val '' O) = lorentzRegion L (coordinateRegion O) := by\n  ext x\n  constructor\n  · rintro ⟨y,hy,he⟩\n    refine ⟨spacetimeOf y,hy,?_⟩\n    apply PiLp.ext\n    intro i\n    exact congrFun he i\n  · rintro ⟨y,hy,rfl⟩\n    exact ⟨fun i => y i,hy,rfl⟩\n\ndef observerUnitary (L : generatedLorentz) (a : Point) : H1 ≃ₗᵢ[ℂ] H1 :=\n  (helicityUnitary L).trans (U1 a)\n\ntheorem canonical_one_particle_covariance (L : generatedLorentz) (a : Point)\n    (O : Set Point) (f : H1) :\n    f ∈ physicalCanonicalNet.K O ↔ observerUnitary L a f ∈\n        physicalCanonicalNet.K (observerChart L a '' O) := by\n  rw [observer_region]\n  change f ∈ compactPhysicalNet O ↔ U1 a (helicityUnitary L f) ∈ compactPhysicalNet _\n  have hL := compactLocalized_lorentz_iff L (coordinateRegion O) f\n  rw [←coordinate_lorentz_region] at hL\n  exact hL.trans (compactPhysicalNet_translate a (lorentzEquiv L.val '' O) (helicityUnitary L f))\n\ntheorem observer_and_wedge_algebra (L : generatedLorentz) (a : Point)\n    (A : F →L[ℂ] F) :\n    frontier (observerChart L a '' rightWedge) =\n      (observerChart L a '' futureSheet) ∪ (observerChart L a '' pastSheet) ∧\n    (A ∈ net rightWedge ↔ (gamma 