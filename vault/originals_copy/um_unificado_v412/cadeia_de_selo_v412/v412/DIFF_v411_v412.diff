prediction z = seed XOR flip. For seed=false\nthe first clause is active and for seed=true the second clause is active. -/\ndef predict (right : Bool) (z : Fin n) (flip : Bool) : List (Row n) :=\n  [⟨right,true,z,flip⟩,⟨right,false,z,!flip⟩]\n\ntheorem prediction_semantics (a b z : Fin n) (side flip : Bool) (x : Fin n → Bool) :\n    passes (formula a b (predict side z flip)) x = true ↔\n      x z = Bool.xor (if side then x b else x a) flip := by\n  rw [evaluations a b _ (x a) (x b) x rfl rfl]\n  cases side <;> cases flip <;> cases x a <;> cases x b <;> simp [predict,forced]\n\ntheorem common_name_parity (a b z : Fin n) (l r : Bool) (x : Fin n → Bool)\n    (h : passes (formula a b (predict false z l ++ predict true z r)) x = true) :\n    Bool.xor (x a) (x b) = Bool.xor l r := by\n  have both : passes (formula a b (predict false z l)) x = true ∧\n      passes (formula a b (predict true z r)) x = true := by simpa [formula,passes] using h\n  have lhs := (prediction_semantics a b z false l x).mp both.1\n  have rhs := (prediction_semantics a b z true r x).mp both.2\n  cases h₁ : x a <;> cases h₂ : x b <;> cases l <;> cases r <;> simp_all\n\nprivate def sample (change : Bool) : List (Row 4) :=\n  predict false 2 false ++ predict false 3 true ++\n  predict true 3 (!change) ++ predict true 2 false\n\ntheorem two_names_control :\n    let p := fun c => original (formula (0:Fin 4) 1 (sample c))\n    let tbl := fun c => ((reader false false (p c)).value, (reader false true (p c)).value,\n      (reader true false (p c)).value, (reader true true (p c)).value)\n    (tbl false, tbl true) = ((true,false,false,true),(false,false,false,false)) := by decide\n\nend Codex.NamedTape\n",
+    'TGLExt/MovimentosDoPlano.lean': 'import TGLExt.LeituraIntegrada\n\n/-! A lower bound in *physical head movements*, for the defined eager pivot\nreader and its unary Horn leaf machine. Every residual keeps a real clause. -/\nset_option autoImplicit false\nnamespace Codex.PlanTravel\nopen TGLExt.TraducaoTuring TGLExt.OPsiBitDaFormula\nopen Codex.SharedBranch Codex.SharedReader Codex.CaudaDisjunta Codex.HornResidual\nopen Codex.CrossSelectors Codex.FormulaPlan Codex.IntegratedRead Codex.PolinomioPorEscolha\nopen Codex.SparseHornTape Codex.HornCross\nvariable {n : Nat}\n\nprivate theorem untouched (c : Clausula n) (i : Fin n) (b : Bool)\n    (h : ∀ l ∈ c, l.var ≠ i) : restrictClause i b c = some c := by\n  have skip : c.any (fun l => l.var == i && l.pos == b) = false := by\n    apply List.any_eq_false.mpr\n    intro l hl\n    have e : (l.var == i) = false := beq_eq_false_iff_ne.mpr (h l hl)\n    simp [e]\n  have keep : c.filter (fun l => l.var != i) = c := by\n    apply List.filter_eq_self.mpr\n    intro l hl\n    simpa using h l hl\n  simp only [restrictClause,skip,Bool.false_eq_true,if_false,keep]\n\nprivate theorem parsed_nonempty {p : CNF n} {q : List (Rule n)}\n    (hp : p ≠ []) (h : parseProgram p = some q) : q ≠ [] := by\n  cases p with\n  | nil => contradiction\n  | cons c cs =>\n    cases hc : parseClause c <;> cases hs : parseProgram cs <;> simp [parseProgram,hc,hs] at h\n    subst q\n    simp\n\nprivate theorem leaf_moves {q : List (Rule n)} {a : Bool} {t : Nat}\n    (hn : q ≠ []) (hh : (run t (start q ∅)).mode = .halt a) :\n    1 ≤ travel t (start q ∅) := by\n  have positive : 0 < (program q).length :=\n    lt_of_lt_of_le (List.length_pos_iff.mpr hn) (clauses_length q)\n  cases t with\n  | zero => contradiction\n  | succ k =>\n    cases h : program q with\n    | nil => simp [h] at positive\n    | cons sym rest =>\n      rw [travel]\n      have moved : 1 ≤ moves (start q ∅) (step (start q ∅)) := by\n        cases sym <;> simp [start,readCfg,h,step,moves