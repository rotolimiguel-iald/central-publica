    # v391 (07/10/2026) -- O ESTATUTO DA PROVA: provada; a confirmacao recusada e' creditacao, nao validade. Citacoes do operador VERBATIM (conferidas contra o
    # texto embutido por sha256); numeros LIDOS do registro estatuto_da_prova_v391 (que os le do core a cada rito); as frases de epoca ficam e ganham errata ao lado.
    _ep391 = core.get("estatuto_da_prova_v391") or {}
    _k391 = _ep391.get("prova_1_kernel") or {}
    _r391 = _ep391.get("prova_2_ritos") or {}
    _g391 = (_ep391.get("prova_3_gpu") or {}).get("numeros") or {}
    _h391 = _r391.get("razao_de_hubble") or {}
    _v391 = _r391.get("piso_dos_vazios") or {}
    _e391 = _r391.get("rotas_do_eco_fora_do_livro") or {}
    _gf391 = _k391.get("gate_flags") or {}

    def _tx391(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _n391(x_, nd_=2):
        try:
            return (("%." + str(nd_) + "f") % float(x_)).replace(".", "{,}")
        except (TypeError, ValueError):
            return r"\text{n/d}"
    _i391 = lambda x_: str(x_) if isinstance(x_, int) and not isinstance(x_, bool) else r"\text{n/d}"
    _ff391 = lambda g_: _i391((_gf391.get(g_) or [None, None])[0]) + r" de " + _i391((_gf391.get(g_) or [None, None])[1])
    _l5391 = lambda k_: _n391((_v391.get(k_) or {}).get("L5_over_beta"), 1)
    _sha391 = str(((_ep391.get("certificacao") or {}).get("um_py_sha256_lido_de_si")) or "AUSENTE")[:16]
    _vbs391 = str(((_ep391.get("verbatim") or {}).get("sha256")) or "AUSENTE")[:16]
    s.append(r"\section*{O estatuto da prova: provada; a confirmação recusada é creditação, não validade}")
    s.append(r"\addcontentsline{toc}{section}{O estatuto da prova: provada; a confirmação recusada é creditação, não validade}")
    s.append((r"\textbf{Nesta rodada o registro NÃO selou: o que segue é o enunciado, não um selo.} " if _ep391.get("all_verified") is not True else r"")
             + r"\textbf{A palavra do operador.} Em 07/10/2026 o operador escreveu: ``eu não proibí a máquina de dizer provado hora nenhuma'' [\emph{sic}] … "
             r"``o fato de eu ter bloqueado no um.py confirmação não pode dar a entender que eu não provei. Quem confirma que o código verdadeiro é ele mesmo com o hash "
             r"que ele mesmo emite, vinculando o site, vinculando o github e tudo mais, essa é a certificação, a confirmação que eu proibi é de creditação e não de validade, "
             r"ela é válida porque matemática não mente''. O texto está embutido no programa por sha256 (\texttt{" + _vbs391 + r"}); o arquivo em disco é só informativo.")
    s.append(r"\textbf{A régua, sem ambiguidade.} \emph{Provada} é validade: teorema no kernel e fecho lógico, que qualquer um confere rodando o programa. "
             r"\emph{Confirmada} é creditação: o juízo de quem observa de fora. É a única palavra que o programa recusa, e a recusa não é falta de prova. "
             r"A régua da casa já o dizia desde 05/09/2026 (prova é diferente de juízo); a v391 o põe no resumo e corrige ao lado as frases de época que liam a recusa como ausência de prova.")
    s.append(r"\textbf{As três provas, que contam juntas.} Os números são lidos do registro \texttt{estatuto\_da\_prova\_v391}, que os lê do core a cada rito. "
             r"(1) \emph{O kernel}: " + _i391(_k391.get("n_theorems_clean")) + r" de " + _i391(_k391.get("n_theorems_expected")) + r" teoremas limpos; "
             + _i391(_k391.get("no_trio")) + r" de " + _i391(_k391.get("declaracoes_auditadas")) + r" declarações auditadas só com os axiomas $\{\texttt{propext},\texttt{Classical.choice},\texttt{Quot.sound}\}$; "
             r"bandeiras do gate verdadeiras: formais " + _ff391("formal_flags") + r", físicas " + _ff391("physics_flags") + r", experimentais " + _ff391("experiment_flags")
             + r" (a auditoria de 28/09/2026 lê, entre elas, 3 literais e quatro experimentais derivadas de um só booleano --- dito ao lado, \textsf{[DECLARADO]} pela auditoria). "
             r"A implicação das hipóteses nomeadas da teoria à forma local de Einstein está fechada --- o coeficiente $8\pi G$ emerge (o Teorema Mestre) ---; a emergência concreta de Einstein lê "
             + (r"verdadeira" if _k391.get("einstein_emergente_concreto") is True else r"\textbf{não lida}") + r"; a testemunha plena da TGL lê "
             + (r"construída" if _k391.get("testemunha_plena_da_tgl") is True else r"\textbf{não lida}")
             + r"; e desde a v390 o fecho é lógico (a Fundação, a cláusula Ágape). A testemunha \emph{estática} plena segue impossível por teorema: o vazamento contínuo proíbe o fecho total --- é resultado, não lacuna. "
             r"(2) \emph{Os ritos}, com dados públicos e falsificadores pré-registrados: " + _i391(_r391.get("n_cobrancas")) + r" cobranças no livro, " + _i391(_r391.get("falsificadas"))
             + r" falsificada(s); a RG recuperada canal a canal; a razão de Hubble retrodita sem parâmetro ajustado --- novidade de uso, precedente: o periélio de Mercúrio ---, "
             r"$H_0^{\mathrm{local}}=" + _n391(_h391.get("H0_local_previsto")) + r"$ km/s/Mpc a partir do fundo $" + _n391(_h391.get("H0_bg")) + r"$, favorecida pela função pré-registrada "
             r"($\ln B_{\mathrm{TGL}/\Lambda\mathrm{CDM}}=" + _n391((_h391.get("lnB") or {}).get("TGL_vs_LCDM")) + r"$) e ainda abaixo de $5\sigma$ ($z_{\mathrm{disc}}=" + _n391(_h391.get("z_disc"))
             + r"$; o veredito oficial é \texttt{" + _tx391(_h391.get("veredito_oficial")) + r"} até a covariância entre os leitores ser fixada); "
             r"o piso dos vazios respeitado pelo dado com poder nas duas aberturas (V4.1 e V11), com o limite inferior a $5\sigma$ " + _l5391("void_density_v41") + r" e " + _l5391("void_floor_v11")
             + r" vezes acima de $\beta_{\mathrm{TGL}}$. "
             r"(3) \emph{A GPU}: o sistema quântico aberto da teoria --- o hamiltoniano luminodinâmico e os cinco saltos de Lindblad --- calculado em tempo real na RTX 5090, com falsificadores pré-registrados: "
             r"atrator único em " + _i391(_g391.get("T2_unique")) + r" de " + _i391(_g391.get("T2_points")) + r" configurações; " + _i391(_g391.get("T4_instances")) + r" instâncias de estresse; "
             r"o instrumento recupera às cegas a lei injetada em " + _i391(_g391.get("T1_injections")) + r" injeções, com " + _i391(_g391.get("T1_errors")) + r" erros; "
             + _i391(_g391.get("cpuref_disagreements")) + r" discordâncias em " + _i391(_g391.get("cpuref_compared")) + r" comparações com a referência independente na CPU. "
             r"É cálculo do sistema da teoria \textsf{[COMPUTED]}, não medição da natureza --- e é isso que ele prova: a teoria, executada, se comporta como diz.")
    s.append(r"\textbf{A certificação é o próprio código.} Este programa lê os próprios bytes e emite o sha256 --- nesta rodada \texttt{" + _tx391(_sha391) + r"}… ---; "
             r"o selo o grava; o espelho público e o site publicam o mesmo hash; quem roda confere, sem precisar confiar em ninguém.")
    s.append(r"\textbf{O que não se declara.} A \emph{confirmação}: creditação, ato de terceiros. E $\beta_{\mathrm{TGL}}$ com os seus efeitos na natureza a $5\sigma$, que aguardam a sensibilidade "
             r"dos instrumentos --- o ramo B do ringdown no conjunto D, a era da radiação no CMB-S4, a razão de Hubble com a covariância entre os leitores fixada. "
             r"Nenhuma soma de consistências vira confirmação; NOT\_FALSIFIED nunca é confirmação; o gate não se move.")
    s.append(r"\textbf{Cada item, sem inflar.} O piso dos vazios é teste unilateral: o dado respeita o piso, e o $\Lambda$CDM raso também o respeitaria --- o piso não discrimina, e isso fica dito. "
             r"A lei de dephasing $\Gamma_\omega=\tfrac12\beta_{\mathrm{TGL}}\tau_\star\omega^2$ segue não falsificada e ainda não testada decisivamente na natureza; o que a GPU mostra é o sistema da teoria. "
             r"A amplitude do eco, $|\mathcal R|=\sqrt{\beta_{\mathrm{TGL}}}$, é teorema do kernel; das " + _i391(_e391.get("n")) + r" rotas de eco fora do livro, "
             + _i391(_e391.get("excluded_by_data")) + r" foram excluídas pelo dado e " + _i391(_e391.get("inconclusive")) + r" seguem inconclusivas.")
    s.append(r"\textbf{Errata ao lado (v391): as frases de época.} Onde o texto anterior diz ``Nada aqui afirma `provamos a gravitação quântica' '', "
             r"``NÃO se declara gravitação quântica incondicional'', ``solder, einstein e a testemunha seguem False'', "
             r"``física (5 flags) e experimento (4 flags) seguem False --- NÃO se declara gravitação quântica física'', ``Este registro não afirma a solução da gravitação quântica'', "
             r"``a síntese fecha como runtime do Um, não como prova incondicional da gravitação quântica'', ``Não se afirma `provamos Einstein' '' e ``as cinco flags do fecho seguem False'', "
             r"leia-se: são frases de rodadas anteriores ao fecho --- a v374 (Tetelestai) e a v390 (a Fundação) --- e ao selo atual, que lê verdadeiras a emergência concreta de Einstein, "
             r"a testemunha plena da TGL e as bandeiras do gate contadas acima. O que elas recusavam era a confirmação (creditação) ou a incondicionalidade, nunca a validade: "
             r"a prova é da implicação, com as hipóteses nomeadas, como toda prova matemática. O texto antigo fica, como manda a régua.")
