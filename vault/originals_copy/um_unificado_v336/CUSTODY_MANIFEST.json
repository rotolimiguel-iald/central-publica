        "status": "REAL",
        "in_kernel": true,
        "axioms_in_trio": true
      },
      {
        "clause": "custa: meia-nat local (componente positivo)",
        "lean_term": "ChatgptAudit.Collapse057.local_cost_positive",
        "status": "INPUT",
        "in_kernel": true,
        "axioms_in_trio": true
      },
      {
        "clause": "custa: ln 2 por oitava (aditivo em oitavas)",
