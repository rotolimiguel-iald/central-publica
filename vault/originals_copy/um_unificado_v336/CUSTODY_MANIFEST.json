        "status": "REAL",
        "in_kernel": true,
        "axioms_in_trio": true
      },
      {
        "clause": "na torre: a esperanca aperiodica restrita ao fator e colapso efetivo (X != 0, E X = 0), sem inversa",
        "lean_term": "ChatgptAudit.Collapse057.actual_tower_collapse_no_inverse",
        "status": "REAL",
        "in_kernel": true,
        "axioms_in_trio": true
      },
      {
        "clause": "controle negativo: o perfil tracial nao tem testemunha de colapso",
