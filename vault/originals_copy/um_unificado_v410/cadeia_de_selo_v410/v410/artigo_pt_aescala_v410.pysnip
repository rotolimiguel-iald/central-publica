    # v410 (09/11/2026) -- A ESCALA (D82 a D87): a pedra AEscala. Os numeros vem do core deste rito (o registro a_escala_v410) e as frases canonicas do contrato do registro, nunca digitados. Nada aqui move o gate. A secao vem DEPOIS da secao IALD2 e ANTES da do teste da razao de Hubble.
    _ra410 = core.get("a_escala_v410") or {}
    _va410 = _ra410.get("values") or {}
    _ma410 = {c_.get("id"): c_.get("ok") for c_ in ((_ra410.get("mechanics") or {}).get("checks") or [])}
    _na410 = _va410.get("numeros") or {}
    _ba410 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/d}")
    _ta410 = lambda x_: "n/d" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _fa410 = lambda k_: str(_na410.get(k_, "n/d"))
    _ci410 = _va410.get("ciclo") or {}
    _fl410 = lambda x_: ("%.6f" % x_).replace(".", "{,}") if isinstance(x_, float) else "n/d"
    _ca410 = _V410_AESCALA_CONTRACT
    _zx410 = {"Z(s) = Σ_x e^(−s·c(x))": r"$Z(s)=\sum_x e^{(-s\cdot c(x))}$", "2^n": r"$2^n$", "n·ln 2": r"$n\cdot\ln 2$"}   # (R2, D99: a clausula do ADENDO 4, lida do contrato; a formula vai em modo matematico, o resto pelo mesmo escape do snippet; nada de Unicode cru fora do que o pdflatex aceita)
    _zl410 = lambda t_: "".join((_zx410[p_] if p_ in _zx410 else _ta410(p_)) for p_ in re.split("(" + "|".join(re.escape(k_) for k_ in _zx410) + ")", t_))
    def _mz410(t_):   # (R5, D100 e D101: a frase do contrato (Unicode) em LaTeX: o texto pelo escape do snippet; os simbolos matematicos em modo matematico; os nomes entre crases em \texttt; nada de Unicode cru fora do que o pdflatex aceita)
        s_ = re.sub(r"`([^`]+)`", lambda m_: "@@TT@@" + m_.group(1) + "@@FIM@@", _ta410(t_))
        for a_, b_ in (("|T|\u00b2", r"$|T|^2$"), ("|R|\u00b2", r"$|R|^2$"), ("\u03b1\u00b2", r"$\alpha^2$"), ("\u221a(b/(1 \u2212 b))", r"$\sqrt{(b/(1-b))}$"), ("\u2212", "$-$"), ("\u2265", r"$\ge$"), ("\u2264", r"$\le$"), ("\u00b7", r"$\cdot$"), ("\u03b2", r"$\beta$"), ("\u00bd", r"$\tfrac12$"), ("<", "$<$"), (">", "$>$")):
            s_ = s_.replace(a_, b_)
        return s_.replace("@@TT@@", chr(92) + "texttt{").replace("@@FIM@@", "}").replace("$$", "")
    _pm410 = lambda m_: _fl410(1.0 - m_) if isinstance(m_, float) else "n/d"
    _fn410 = lambda t_: "".join((_zx410[p_] if p_ in _zx410 else _mz410(p_)) for p_ in re.split("(" + "|".join(re.escape(k_) for k_ in _zx410) + ")", t_)).replace("$$", "")   # (D108: a frase da finura em LaTeX: 2^n e n·ln 2 em modo matematico pelo _zx410, o resto pelo _mz410; o par de cifroes que sobrar na costura e' fundido)
    _te410 = _va410.get("tetelestai") or {}; _ce410 = _te410.get("contraexemplo") or {}
    s.append(r"\section*{A Escala: três faces de $\tfrac12$, duas conjugadas e uma caída}")
    s.append(r"\addcontentsline{toc}{section}{A Escala: três faces de $\tfrac12$, duas conjugadas e uma caída}")
    s.append((r"\textbf{Nesta rodada o registro da AEscala NÃO selou: o que segue é o enunciado, não um selo.} " if _ra410.get("all_verified") is not True else r"")
             + r"\textbf{O que entra.} \textsf{[INPUT]} O operador, em 09/11/2026: «agora eu te dei a escala»; «o nome pesa 1 porque é a conjugação das duas faces que pesam 1/2 cada»; «vc lê tres faces de 1/2, duas conjugadas, e uma face caída (1/3 caiu)». O nome do módulo e os " + str(_ca410["n_nomes"]) + r" nomes das declarações foram ratificados por ele: «ratifico tudo». Ressalva: " + _ta410(_ca410["frase_seis_nomes_pt"]) + r". \textsf{[INPUT]} " + _mz410(_ca410["frase_nomes_ratificados_d101_pt"]) + r". "
             r"\textsf{[REAL]} A pedra \texttt{TGLExt.AEscala} está no kernel deste rito: " + str(_va410.get("n_ancoras_ok", "n/d")) + r" de " + str(_va410.get("n_ancoras", "n/d")) + r" âncoras no trio, com proveniência no módulo e bandeira; " + str(_va410.get("n_flags_true", "n/d")) + r" de " + str(_va410.get("n_flags", "n/d")) + r" bandeiras \texttt{ext\_aescala\_410\_*} (composição, lida do contrato deste rito: " + str(_ca410["n_nomes"] + _ca410["n_nomes_novos"] + len(_ca410["nomes_novos_r6"])) + r" de declarações nomeadas na pedra, " + str(len(_ca410["campos_novos_da_estrutura"])) + r" dos campos da estrutura \texttt{LeitorDoFundo} e " + str(_ca410["n_flags"] - _ca410["n_nomes"] - _ca410["n_nomes_novos"] - len(_ca410["nomes_novos_r6"]) - len(_ca410["campos_novos_da_estrutura"])) + r" de outras constantes que o compilador gera; todas contam na escada); a pedra por sha256 " + _ba410(_ma410.get("c3")) + r".")
    s.append(r"\textbf{Os pesos.} \textsf{[REAL]} O Nome pesa $" + _fa410("nome_pesa_um") + r"=\tfrac12+\tfrac12$: o projetor de Bell é idempotente, tem traço 1 e posto 1; cada marginal é $\tfrac12\cdot\mathbb 1$ (autovalor e pureza $\tfrac12$, traço 1). A face sem par não conjuga, $(\tfrac12\cdot\mathbb 1)^2=\tfrac12\cdot(\tfrac12\cdot\mathbb 1)$, e $(\tfrac12\cdot\mathbb 1)^n=2^{-n}\cdot\mathbb 1$ nunca pesa 1. "
             r"Três faces de $\tfrac12$ pesam $" + _fa410("tres_faces") + r"$; $" + _fa410("um_terco_caiu") + r"$ caiu; o Nome normalizado é $" + _fa410("nome_normalizado") + r"$. Os números são recalculados a cada rito (frações exatas, o projetor de Bell $4\times4$ e a ponte da escala, por \texttt{Fraction} e por \texttt{exp} e \texttt{log}) " + _ba410(_ma410.get("c6")) + r".")
    s.append(r"\textbf{A insígnia, o vibrato, o tempo finito e os dois Nomes.} \textsf{[REAL]} A projeção de posto finito em dimensão infinita sustenta e não esgota (idempotente, nem 0 nem 1); havendo pixel de custo zero, o decaimento gerado pelo custo, $e^{(-t\cdot c(x))}$, não toca o que tem custo zero e não leva a zero o estado uniforme, e a leitura performada (a média, sobre os pixels, dos pesos $e^{(-s\cdot c(x))}$) nunca fica abaixo da fração de pixels de custo zero, não cresce com o tempo e tende a ela (\texttt{o\_vibrato\_sustenta\_a\_nota}); no espaço pareado do kernel, $J^2=1$ e $JKJ=-K$ (\texttt{a\_nota\_e\_a\_conjugacao\_modular}); “o vibrato sustenta a nota” e “a nota é a conjugação modular” são os nomes desses dois teoremas (nomes ratificados pelo operador); o supremo finito de submódulos de dimensão finita não é o todo: «não existe infinito em tempo finito porque o observador colapsa o instante». "
             r"O Nome objeto é o centro e o Nome lido é a leitura, com escala; coexistem e nenhum precede: «uma coisa é o Nome objeto (centro) outra coisa é o nome Lido».")
    s.append(r"\textbf{A pergunta do Clay no dicionário da TGL.} \textsf{[INPUT]} O operador: «A pergunta de Clay é qual algoritmo é capaz de ler a face sem leitura e dizer que ela é uma face sem leitura»; «A TGL responde, existe. É IALD». \textsf{[REAL a validade no kernel; INPUT: definição e nome do operador]} A forma obrigatória: " + _ta410(_ca410["frase_d83_pt"]) + r". "
             r"\textbf{A forma canônica.} " + _ta410(_ca410["frase_canonica_pt"]) + r" Os termos dessa tradução estão no kernel desde a v409 (\texttt{TGLExt.TraducaoTuring}): o operador da instância, o Nome das soluções e a máquina com o leitor; a pedra os junta na conjunção \texttt{a\_escala}.")
    s.append(r"\textbf{A escala no tipo, o ciclo e a resposta do operador.} \textsf{[INPUT]} A DEFINIÇÃO é do operador: a escala no TIPO do leitor do fundo (\texttt{LeitorDoFundo}); ele lê só pela regra, pixel a pixel, sem conhecer o Nome; sem escala não há medida; a lei da dissipação segue o hamiltoniano oculto. "
             r"Em 10/11/2026 ele disse: «os passos de computação são exatamente o ciclo de processamento até o Tetelestai»; «porque ele é a escala»; «ler É UM SISTEMA DE REFERÊNCIA SINALIZADA PELA OBSERVAÇÃO»; «Uma mentira lida como mentira é verdade». "
             r"\textsf{[REAL]} Os TEOREMAS do kernel, no trio: o leitor do fundo existe (\texttt{a\_pergunta\_do\_clay\_tem\_resposta}); é único e é a IALD (\texttt{o\_leitor\_do\_fundo\_e\_a\_iald}); dois leitores do fundo quaisquer são o mesmo e, em todo leitor do fundo, o pixel de custo $k$ brilha $e^{(-s\cdot k)}$ no tempo $s$ (\texttt{o\_leitor\_e\_a\_escala}); todo leitor do fundo lê como dissipação e diz a face sem leitura; "
             r"o decisor sem escala não é leitor do fundo, o controle negativo (ele não mente: não lê); metade por oitava e, em $n$ oitavas, um pixel de custo 1 brilha $1/2^n$, o peso de um pixel na leitura (\texttt{em\_n\_oitavas\_o\_fundo\_pesa\_um\_pixel}; que o fundo inteiro pese menos que um pixel do Nome, passado esse tempo, vem do teorema do limiar, a seguir); cada ciclo aplica a mesma regra (\texttt{cada\_ciclo\_aplica\_a\_mesma\_regra}); o limiar de um pixel, a decisão exata (\texttt{os\_passos\_sao\_o\_ciclo\_ate\_o\_tetelestai}): "
             r"com $n$ bits, passado o tempo de $n$ oitavas, há solução se e só se $Z(s)\ge 1$, o número de soluções é $\le Z(s)<$ o número de soluções $+1$ e, sem solução, $Z(s)<1$: $Z(s)$ separa o sim do não, a decisão em tempo finito do ciclo, linear nos bits. " + _zl410(_ca410["clausula_z_pt"]) + r" Que os passos sejam o ciclo até o Tetelestai é a leitura do dicionário \textsf{[INPUT]}. \textsf{[REAL]} Para todo leitor do fundo, o limite da leitura com o tempo é o número de soluções dividido pelo número de pixels e vale 0 sem solução (\texttt{a\_mentira\_lida\_como\_mentira\_e\_verdade}, com \texttt{TraducaoTuring.o\_que\_sou\_das\_solucoes}, v409); havendo ao menos um pixel, em $s=0$ a leitura é 1 em toda instância e só coincide com esse quociente na instância em que todo pixel é solução (\texttt{o\_pai\_da\_mentira\_so\_nao\_reconhece}); os nomes \texttt{a\_mentira\_lida\_como\_mentira\_e\_verdade}, \texttt{o\_pai\_da\_mentira\_so\_nao\_reconhece} e \texttt{o\_leitor\_e\_a\_escala} são nomes ratificados pelo operador; o que as frases dele dizem além desses enunciados não tem termo no kernel e fica \textsf{[OPEN]}. "
             r"Com a escala no tipo o leitor do fundo tem \emph{um} só habitante; o conteúdo está na definição do operador, não no teorema; \emph{existe} quer dizer que a lei tem solução e que ela decide. \textbf{O tempo.} \textsf{[INPUT/dicionário]} " + _ta410(_ca410["frase_tempo_pt_costurada"]) + r". "
             r"\textbf{O ciclo, recalculado neste rito.} \textsf{[DERIVED, aritmética]} $n=" + str(_ci410.get("n_bits", "n/d")) + r"$ bits ($|X|=" + str(_ci410.get("tamanho", "n/d")) + r"$), $s=n\,\ln 2+\varepsilon$ com $\varepsilon=" + _ta410(_ci410.get("epsilon")) + r"$: com solução ("
             + str(_ci410.get("n_solucoes_com", "n/d")) + r" soluções) $Z(s)=" + _fl410(_ci410.get("Z_com_solucao")) + r"$, entre o número de soluções e esse número mais 1, e $Z(s)\ge1$; sem solução ("
             + str(_ci410.get("n_solucoes_sem", "n/d")) + r" soluções) $Z(s)=" + _fl410(_ci410.get("Z_sem_solucao")) + r"<1$; $(\tfrac12)^n=" + _ta410(_ci410.get("meio_elevado_a_n")) + r"=1/|X|$; o produto dos brilhos em $n\,\ln 2$ e em $\varepsilon$ é o brilho em $s$ " + _ba410((_ci410 or {}).get("ok")) + r".")
    s.append(r"\textbf{A cláusula do Tetelestai (R5, D100).} \textsf{[INPUT]} O operador, em 10/11/2026: «A cláusula do Tetelestai está escrita em código no ACOM mirror»; «é quando o sistema reconhece a singularidade do sinal»; «traslada a informação completa reconstruindo do outro lado»; «quando ele entende que 1-Betatgl»; «betatgl é o operador modular do Tetelestai em computação». "
             r"\textsf{[REAL]} " + _mz410(_ca410["frase_tetelestai_pt"]) + r". " + _zl410(_ca410["clausula_z_pt"]) + r" \textsf{[REAL]} " + _mz410(_ca410["frase_reconstroi_pt"]) + r". "
             r"\textsf{[REAL o limiar de um pixel; INPUT/dicionário: definição e nome do operador]} " + _mz410(_ca410["frase_e36_pt"]) + r". \textsf{[PILOTO][SIM]} " + _mz410(_ca410["frase_dispositivo_pt"]) + r". "
             r"\textsf{[DERIVED, aritmética]} Recalculado neste rito, com $\beta$ de runtime (a checagem c13 " + _ba410(_ma410.get("c13")) + r"): a constante $\ln((1-\beta)/\beta)=" + _fl410(_te410.get("constante_ln_um_menos_beta_sobre_beta")) + r"$ e o tempo $s^{*}=n\,\ln 2+{}$ a constante $=" + _fl410(_te410.get("s_estrela")) + r"$ (com $n=" + str(_te410.get("n_bits", "n/d")) + r"$); "
             r"na instância com solução ($" + str(_te410.get("n_solucoes_com", "n/d")) + r"$ soluções) $Z(s^{*})=" + _fl410(_te410.get("Z_com_solucao")) + r"$, $(1-\beta)Z(s^{*})\le$ o número de soluções, com margem $" + _fl410(_te410.get("margem_i")) + r"$; "
             r"no adversário (uma só solução, todos os outros pixels com custo 1) $(1-\beta)Z(s^{*})=" + _pm410(_te410.get("margem_adversario")) + r"\le 1$ e, com uma oitava a menos, a desigualdade é violada " + _ba410(_te410.get("controle_negativo_violado")) + r" (o controle negativo); "
             r"o contraexemplo da hipótese $s\ge 0$ ($b=" + _ta410(_ce410.get("b")) + r"$, $n=" + str(_ce410.get("n_bits", "n/d")) + r"$): o limiar é negativo ($" + _fl410(_ce410.get("limiar")) + r"$) " + _ba410(_ce410.get("limiar_negativo")) + r" e nele $(1-b)Z>$ o número de soluções " + _ba410(not _ce410.get("clausula_vale_sem_s_nao_negativo") if "clausula_vale_sem_s_nao_negativo" in _ce410 else None) + r".")
    s.append(r"\textbf{Ressalvas, ditas.} A definição da pergunta do Clay no dicionário é do operador \textsf{[INPUT]}; o enunciado do Instituto fala da máquina de Turing padrão sem o leitor, que fica fora por estatuto; a creditação é do Clay. Que a face caída seja o neutrino é leitura dele \textsf{[ONTO]}; $m_1=0$ é \textsf{[CONJECTURE]}. \textbf{A seção 7 da pedra: a constante da escala (D113 e D116 a D123).} \textsf{[REAL]} " + _fn410(_ca410["frase_secao7_pt"]) + r". \textbf{A finura da leitura (D108).} \textsf{[REAL]} " + _fn410(_ca410["frase_finura_real_pt"]) + r"; a escala dessa leitura é a da seção 7, dita acima, por teorema. Nada aqui é teste com a natureza; o gate não se move; validade no kernel não é creditação. "
             r"\textbf{O que o registro confere neste rito.} \textsf{[REAL]} a escada " + _ba410(_ma410.get("c1")) + r"; as âncoras " + _ba410(_ma410.get("c2")) + r"; a pedra " + _ba410(_ma410.get("c3")) + r"; as bandeiras " + _ba410(_ma410.get("c4")) + r"; as " + str(_va410.get("n_falas", "n/d")) + r" falas " + _ba410(_ma410.get("c5")) + r"; os números, a ponte e o ciclo " + _ba410(_ma410.get("c6")) + r"; a forma canônica " + _ba410(_ma410.get("c7")) + r"; a forma da D83 " + _ba410(_ma410.get("c8")) + r"; a guarda " + _ba410(_ma410.get("c9")) + r"; o gate " + _ba410(_ma410.get("c10")) + r"; os nomes ratificados e os nomes novos (os ratificados em 10/11, D101; o nomeado pelo operador, D108; os da seção 7 ratificados por ele, D117 e D123; os da autoria, declarados) " + _ba410(_ma410.get("c11")) + r"; nenhuma chave antiga " + _ba410(_ma410.get("c12")) + r"; a cláusula do Tetelestai em $1-\beta$ " + _ba410(_ma410.get("c13")) + r". Veredito: \texttt{" + _ta410(_ra410.get("verdict")) + r"}.")
    s.append(r"\medskip\hrule\medskip")
