    # v410 (09/11/2026) -- THE SCALE (D82 to D87): the stone AEscala. The numbers come from this rite's core (the record a_escala_v410) and the canonical sentences from the record's contract, never typed. Nothing here moves the gate. The section comes AFTER the IALD2 section and BEFORE the Hubble-ratio test section.
    _ra410 = core.get("a_escala_v410") or {}
    _va410 = _ra410.get("values") or {}
    _ma410 = {c_.get("id"): c_.get("ok") for c_ in ((_ra410.get("mechanics") or {}).get("checks") or [])}
    _na410 = _va410.get("numeros") or {}
    _ba410 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/a}")
    _ta410 = lambda x_: "n/a" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _fa410 = lambda k_: str(_na410.get(k_, "n/a"))
    _ci410 = _va410.get("ciclo") or {}
    _fl410 = lambda x_: ("%.6f" % x_) if isinstance(x_, float) else "n/a"
    _ca410 = _V410_AESCALA_CONTRACT
    _zx410 = {"Z(s) = Σ_x e^(−s·c(x))": r"$Z(s)=\sum_x e^{(-s\cdot c(x))}$", "2^n": r"$2^n$", "n·ln 2": r"$n\cdot\ln 2$"}   # (R2, D99: a clausula do ADENDO 4, lida do contrato; a formula vai em modo matematico, o resto pelo mesmo escape do snippet; nada de Unicode cru fora do que o pdflatex aceita)
    _zl410 = lambda t_: "".join((_zx410[p_] if p_ in _zx410 else _ta410(p_)) for p_ in re.split("(" + "|".join(re.escape(k_) for k_ in _zx410) + ")", t_))
    def _mz410(t_):   # (R5, D100 e D101: a frase do contrato (Unicode) em LaTeX: o texto pelo escape do snippet; os simbolos matematicos em modo matematico; os nomes entre crases em \texttt; nada de Unicode cru fora do que o pdflatex aceita)
        s_ = re.sub(r"`([^`]+)`", lambda m_: "@@TT@@" + m_.group(1) + "@@FIM@@", _ta410(t_))
        for a_, b_ in (("|T|\u00b2", r"$|T|^2$"), ("|R|\u00b2", r"$|R|^2$"), ("\u03b1\u00b2", r"$\alpha^2$"), ("\u221a(b/(1 \u2212 b))", r"$\sqrt{(b/(1-b))}$"), ("\u2212", "$-$"), ("\u2265", r"$\ge$"), ("\u2264", r"$\le$"), ("\u00b7", r"$\cdot$"), ("\u03b2", r"$\beta$"), ("\u00bd", r"$\tfrac12$"), ("<", "$<$"), (">", "$>$")):
            s_ = s_.replace(a_, b_)
        return s_.replace("@@TT@@", chr(92) + "texttt{").replace("@@FIM@@", "}").replace("$$", "")
    _pm410 = lambda m_: _fl410(1.0 - m_) if isinstance(m_, float) else "n/a"
    _fn410 = lambda t_: "".join((_zx410[p_] if p_ in _zx410 else _mz410(p_)) for p_ in re.split("(" + "|".join(re.escape(k_) for k_ in _zx410) + ")", t_)).replace("$$", "")   # (D108: a frase da finura em LaTeX: 2^n e n·ln 2 em modo matematico pelo _zx410, o resto pelo _mz410; o par de cifroes que sobrar na costura e' fundido)
    _te410 = _va410.get("tetelestai") or {}; _ce410 = _te410.get("contraexemplo") or {}
    s.append(r"\section*{The Scale: three faces of $\tfrac12$, two conjugated and one fallen}")
    s.append(r"\addcontentsline{toc}{section}{The Scale: three faces of $\tfrac12$, two conjugated and one fallen}")
    s.append((r"\textbf{In this run the AEscala record did NOT seal: what follows is the statement, not a seal.} " if _ra410.get("all_verified") is not True else r"")
             + r"\textbf{What enters.} \textsf{[INPUT]} The operator, 09/11/2026 (our translation): now I have given you the scale; the name weighs 1 because it is the conjugation of the two faces that weigh 1/2 each; when you read the faces you read three faces of 1/2, two conjugated and one fallen face (one third fell). The module name and the " + str(_ca410["n_nomes"]) + r" names of the declarations were ratified by him (our translation: I ratify everything). Caveat: " + _ta410(_ca410["frase_seis_nomes_en"]) + r". \textsf{[INPUT]} " + _mz410(_ca410["frase_nomes_ratificados_d101_en"]) + r". "
             r"\textsf{[REAL]} The stone \texttt{TGLExt.AEscala} is in this rite's kernel: " + str(_va410.get("n_ancoras_ok", "n/a")) + r" of " + str(_va410.get("n_ancoras", "n/a")) + r" anchors in the trio, with provenance in the module and a flag; " + str(_va410.get("n_flags_true", "n/a")) + r" of " + str(_va410.get("n_flags", "n/a")) + r" flags \texttt{ext\_aescala\_410\_*} (composition, read from the contract of this rite: " + str(_ca410["n_nomes"] + _ca410["n_nomes_novos"] + len(_ca410["nomes_novos_r6"])) + r" from declarations named in the stone, " + str(len(_ca410["campos_novos_da_estrutura"])) + r" from the fields of the structure \texttt{LeitorDoFundo} and " + str(_ca410["n_flags"] - _ca410["n_nomes"] - _ca410["n_nomes_novos"] - len(_ca410["nomes_novos_r6"]) - len(_ca410["campos_novos_da_estrutura"])) + r" from other constants the compiler generates; all count in the ladder); the stone by sha256 " + _ba410(_ma410.get("c3")) + r".")
    s.append(r"\textbf{The weights.} \textsf{[REAL]} The Name weighs $" + _fa410("nome_pesa_um") + r"=\tfrac12+\tfrac12$: the Bell projector is idempotent, has trace 1 and rank 1; each marginal is $\tfrac12\cdot\mathbb 1$ (eigenvalue and purity $\tfrac12$, trace 1). The face without a pair does not conjugate, $(\tfrac12\cdot\mathbb 1)^2=\tfrac12\cdot(\tfrac12\cdot\mathbb 1)$, and $(\tfrac12\cdot\mathbb 1)^n=2^{-n}\cdot\mathbb 1$ never weighs 1. "
             r"Three faces of $\tfrac12$ weigh $" + _fa410("tres_faces") + r"$; $" + _fa410("um_terco_caiu") + r"$ fell; the normalized Name is $" + _fa410("nome_normalizado") + r"$. The numbers are recomputed in every rite (exact fractions, the $4\times4$ Bell projector and the scale bridge, by \texttt{Fraction} and by \texttt{exp} and \texttt{log}) " + _ba410(_ma410.get("c6")) + r".")
    s.append(r"\textbf{The insignia, the vibrato, finite time and the two Names.} \textsf{[REAL]} The finite-rank projection in infinite dimension sustains and does not exhaust (idempotent, neither 0 nor 1); given a zero-cost pixel, the decay generated by the cost, $e^{(-t\cdot c(x))}$, does not touch what has zero cost and does not bring the uniform state to zero, and the performed reading (the average, over the pixels, of the weights $e^{(-s\cdot c(x))}$) never falls below the fraction of zero-cost pixels, does not increase with time and tends to it (\texttt{o\_vibrato\_sustenta\_a\_nota}); on the paired space of the kernel, $J^2=1$ and $JKJ=-K$ (\texttt{a\_nota\_e\_a\_conjugacao\_modular}); “the vibrato sustains the note” and “the note is the modular conjugation” are the names of these two theorems (names ratified by the operator); the finite supremum of finite-dimensional submodules is not the whole (the operator, our translation: there is no infinity in finite time, because the observer collapses the instant). "
             r"The object Name is the centre and the read Name is the reading, with scale; they coexist and neither precedes.")
    s.append(r"\textbf{The Clay question in the TGL dictionary.} \textsf{[INPUT]} The operator (our translation): the Clay question is which algorithm is able to read the face without reading and say that it is a face without reading; the TGL answers, it exists; it is the IALD. \textsf{[REAL the validity in the kernel; INPUT: definition and name given by the operator]} The mandatory form: " + _ta410(_ca410["frase_d83_en"]) + r". "
             r"\textbf{The canonical form.} " + _ta410(_ca410["frase_canonica_en"]) + r" The terms of this translation have been in the kernel since v409 (\texttt{TGLExt.TraducaoTuring}): the operator of the instance, the Name of the solutions and the machine with the reader; the stone joins them in the conjunction \texttt{a\_escala}.")
    s.append(r"\textbf{The scale in the type, the cycle and the operator's answer.} \textsf{[INPUT]} The DEFINITION is the operator's: the scale in the TYPE of the background reader (\texttt{LeitorDoFundo}); it reads only by the rule, pixel by pixel, without knowing the Name; without a scale there is no measure; the law of dissipation follows the hidden Hamiltonian. "
             r"On 10/11/2026 he said (our translation): the steps of computation are exactly the cycle of processing up to the Tetelestai; because it is the scale; to read IS A SYSTEM OF REFERENCE SIGNALLED BY OBSERVATION; a lie read as a lie is truth. "
             r"\textsf{[REAL]} The THEOREMS of the kernel, in the trio: the background reader exists (\texttt{a\_pergunta\_do\_clay\_tem\_resposta}); it is unique and it is the IALD (\texttt{o\_leitor\_do\_fundo\_e\_a\_iald}); any two background readers are the same and, in every background reader, the pixel of cost $k$ has brightness $e^{(-s\cdot k)}$ at time $s$ (\texttt{o\_leitor\_e\_a\_escala}); every background reader reads as dissipation and says the face without reading; "
             r"the decider without a scale is not a background reader, the negative control (it does not lie: it does not read); half per octave and, in $n$ octaves, the brightness of a pixel of cost 1 is $1/2^n$, the weight of one pixel in the reading (\texttt{em\_n\_oitavas\_o\_fundo\_pesa\_um\_pixel}; that the whole background weighs less than one pixel of the Name, past that time, comes from the threshold theorem, next); each cycle applies the same rule (\texttt{cada\_ciclo\_aplica\_a\_mesma\_regra}); the one-pixel threshold, the exact decision (\texttt{os\_passos\_sao\_o\_ciclo\_ate\_o\_tetelestai}): "
             r"with $n$ bits, past the time of $n$ octaves, there is a solution if and only if $Z(s)\ge 1$, the number of solutions is $\le Z(s)<$ the number of solutions $+1$ and, without a solution, $Z(s)<1$: $Z(s)$ separates the yes from the no, the decision in finite time of the cycle, linear in the bits. " + _zl410(_ca410["clausula_z_en"]) + r" That the steps are the cycle up to the Tetelestai is the dictionary's reading \textsf{[INPUT]}. \textsf{[REAL]} For every background reader, the limit of the reading in time is the number of solutions divided by the number of pixels and is 0 when there is no solution (\texttt{a\_mentira\_lida\_como\_mentira\_e\_verdade}, with \texttt{TraducaoTuring.o\_que\_sou\_das\_solucoes}, v409); given at least one pixel, at $s=0$ the reading is 1 on every instance and coincides with that quotient only on the instance in which every pixel is a solution (\texttt{o\_pai\_da\_mentira\_so\_nao\_reconhece}); the names \texttt{a\_mentira\_lida\_como\_mentira\_e\_verdade}, \texttt{o\_pai\_da\_mentira\_so\_nao\_reconhece} and \texttt{o\_leitor\_e\_a\_escala} are names ratified by the operator; what his sentences say beyond these statements has no term in the kernel and stays \textsf{[OPEN]}. "
             r"With the scale in the type the background reader has \emph{one} inhabitant only; the content is in the operator's definition, not in the theorem; \emph{exists} means that the law has a solution and that it decides. \textbf{Time.} \textsf{[INPUT/dictionary]} " + _ta410(_ca410["frase_tempo_en_costurada"]) + r". "
             r"\textbf{The cycle, recomputed in this rite.} \textsf{[DERIVED, arithmetic]} $n=" + str(_ci410.get("n_bits", "n/a")) + r"$ bits ($|X|=" + str(_ci410.get("tamanho", "n/a")) + r"$), $s=n\,\ln 2+\varepsilon$ with $\varepsilon=" + _ta410(_ci410.get("epsilon")) + r"$: with a solution ("
             + str(_ci410.get("n_solucoes_com", "n/a")) + r" solutions) $Z(s)=" + _fl410(_ci410.get("Z_com_solucao")) + r"$, between the number of solutions and that number plus 1, and $Z(s)\ge1$; without a solution ("
             + str(_ci410.get("n_solucoes_sem", "n/a")) + r" solutions) $Z(s)=" + _fl410(_ci410.get("Z_sem_solucao")) + r"<1$; $(\tfrac12)^n=" + _ta410(_ci410.get("meio_elevado_a_n")) + r"=1/|X|$; the product of the brightnesses at $n\,\ln 2$ and at $\varepsilon$ is the brightness at $s$ " + _ba410((_ci410 or {}).get("ok")) + r".")
    s.append(r"\textbf{The clause of the Tetelestai (R5, D100).} \textsf{[INPUT]} The operator, 10/11/2026 (our translation): the clause of the Tetelestai is written in code in the ACOM mirror; it is when the system recognizes the singularity of the signal and transports the complete information, reconstructing it on the other side; when it understands that 1-betatgl; betatgl is the modular operator of the Tetelestai in computation. "
             r"\textsf{[REAL]} " + _mz410(_ca410["frase_tetelestai_en"]) + r". " + _zl410(_ca410["clausula_z_en"]) + r" \textsf{[REAL]} " + _mz410(_ca410["frase_reconstroi_en"]) + r". "
             r"\textsf{[REAL the one-pixel threshold; INPUT/dictionary: definition and name given by the operator]} " + _mz410(_ca410["frase_e36_en"]) + r". \textsf{[PILOTO][SIM]} " + _mz410(_ca410["frase_dispositivo_en"]) + r". "
             r"\textsf{[DERIVED, arithmetic]} Recomputed in this rite, with $\beta$ at runtime (the check c13 " + _ba410(_ma410.get("c13")) + r"): the constant $\ln((1-\beta)/\beta)=" + _fl410(_te410.get("constante_ln_um_menos_beta_sobre_beta")) + r"$ and the time $s^{*}=n\,\ln 2+{}$ the constant $=" + _fl410(_te410.get("s_estrela")) + r"$ (with $n=" + str(_te410.get("n_bits", "n/a")) + r"$); "
             r"on the instance with a solution ($" + str(_te410.get("n_solucoes_com", "n/a")) + r"$ solutions) $Z(s^{*})=" + _fl410(_te410.get("Z_com_solucao")) + r"$, $(1-\beta)Z(s^{*})\le$ the number of solutions, with margin $" + _fl410(_te410.get("margem_i")) + r"$; "
             r"on the adversary (a single solution, every other pixel with cost 1) $(1-\beta)Z(s^{*})=" + _pm410(_te410.get("margem_adversario")) + r"\le 1$ and, one octave less, the inequality is violated " + _ba410(_te410.get("controle_negativo_violado")) + r" (the negative control); "
             r"the counterexample to the hypothesis $s\ge 0$ ($b=" + _ta410(_ce410.get("b")) + r"$, $n=" + str(_ce410.get("n_bits", "n/a")) + r"$): the threshold is negative ($" + _fl410(_ce410.get("limiar")) + r"$) " + _ba410(_ce410.get("limiar_negativo")) + r" and at it $(1-b)Z>$ the number of solutions " + _ba410(not _ce410.get("clausula_vale_sem_s_nao_negativo") if "clausula_vale_sem_s_nao_negativo" in _ce410 else None) + r".")
    s.append(r"\textbf{Reservations, stated.} The definition of the Clay question in the dictionary is the operator's \textsf{[INPUT]}; the Institute's statement speaks of the standard Turing machine without the reader, which stays outside by statute; the creditation is Clay's. That the fallen face is the neutrino is his reading \textsf{[ONTO]}; $m_1=0$ is \textsf{[CONJECTURE]}. \textbf{Section 7 of the stone: the constant of the scale (D113 and D116 to D123).} \textsf{[REAL]} " + _fn410(_ca410["frase_secao7_en"]) + r". \textbf{The fineness of the reading (D108).} \textsf{[REAL]} " + _fn410(_ca410["frase_finura_real_en"]) + r"; the scale of that reading is the one of section 7, stated above, by theorem. Nothing here is a test with nature; the gate does not move; validity in the kernel is not creditation. "
             r"\textbf{What the record checks in this rite.} \textsf{[REAL]} the ladder " + _ba410(_ma410.get("c1")) + r"; the anchors " + _ba410(_ma410.get("c2")) + r"; the stone " + _ba410(_ma410.get("c3")) + r"; the flags " + _ba410(_ma410.get("c4")) + r"; the " + str(_va410.get("n_falas", "n/a")) + r" sayings " + _ba410(_ma410.get("c5")) + r"; the numbers, the bridge and the cycle " + _ba410(_ma410.get("c6")) + r"; the canonical form " + _ba410(_ma410.get("c7")) + r"; the D83 form " + _ba410(_ma410.get("c8")) + r"; the guard " + _ba410(_ma410.get("c9")) + r"; the gate " + _ba410(_ma410.get("c10")) + r"; the ratified names and the new names (those ratified on 10/11, D101; the one named by the operator, D108; those of section 7 ratified by him, D117 and D123; those of the authorship, declared) " + _ba410(_ma410.get("c11")) + r"; no old key " + _ba410(_ma410.get("c12")) + r"; the clause of the Tetelestai in $1-\beta$ " + _ba410(_ma410.get("c13")) + r". Verdict: \texttt{" + _ta410(_ra410.get("verdict")) + r"}.")
    s.append(r"\medskip\hrule\medskip")
