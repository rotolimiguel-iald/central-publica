                 "a_trava_sem_conhecer_o_nome", "negar_o_zero", "a_selecao_esquece", "a_fotografia_sem_leitor", "psionCornerF_scalarises", "euSou", "oQueSou", "p_igual_np_nas_classes_do_dicionario", "tetelestai", "physicalFockCertificate", "BosonicFock")
