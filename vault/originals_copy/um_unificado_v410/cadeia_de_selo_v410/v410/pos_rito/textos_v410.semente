# v410: a entrada do remissivo
def remissivo(V):
    return "- **A tradução às classes de Turing, o modo seleção, a trava no Nome, a fita, o leitor, a fita sem escala e as inscrições de 05/11 (v410)** — o registro `traducao_turing_v409`, `cunhagens_v409`, `kh_n1_cobertura_v409`, `%s`" % TOPICO_NOVO


MARC_V410_INI = "<!-- INICIO_PARAGRAFO_TRADUCAO_TURING_v410 -->"; MARC_V410_FIM = "<!-- FIM_PARAGRAFO_TRADUCAO_TURING_v410 -->"


MARC_ERR_INI = "<!-- INICIO_ERRATA_V409_V410 -->"; MARC_ERR_FIM = "<!-- FIM_ERRATA_V409_V410 -->"


def _lst(xs):
    """Lista numerica lida do registro, em PT: inteiros sem casas, listas aninhadas entre parenteses."""
    return ", ".join(("(" + _lst(x) + ")") if isinstance(x, (list, tuple)) else _pn(x, 6) for x in xs)


def _sem_chaves(t):
    """Os textos vindos do core podem trazer chaves (e^{-s}); os textos renderizados nao as tem (a conferencia de formatacao reprova): chaves viram parenteses."""
    return t.replace("{", "(").replace("}", ")")


def _erratas_e(V):
    """As erratas E24 a E28, a E21 ao lado e a dos pisos (em nome proprio da gerencia c1), LIDAS do registro cunhagens_v409 do core: nenhuma e' digitada aqui. Ordem: dizia -> agora (o que se le primeiro e' o que estava escrito; a correcao vem logo depois)."""
    _d(V); er = _cg()["erratas"]; DL_ = _dl()
    assert len(er) == len(DL_.ERRATAS_V410) + 1, "o registro cunhagens_v409 nao traz as erratas da v410 (E24 a E28 e a E21 ao lado) e a dos pisos"
    itens = []
    for e in er:
        itens.append(_sem_chaves("- **Ao lado de:** %s. **Dizia:** %s **Agora:** %s **Lacuna de fidelidade:** %s **Estatuto:** %s" % (e["ao_lado_de"], e["dizia"], e["agora"], e["lacuna_de_fidelidade"], e.get("estatuto", ""))))
    return ("**Erratas ao lado (em nome próprio da gerência c1, 05/11/2026; os literais das versões anteriores, os specs marcados «até a v409», os registros selados e as pedras seladas ficam como registro; nenhum módulo já instalado foi editado):** a v410 entra COM as erratas E24 a E28, a E21 ao lado e a errata ao lado dos pisos, lidas do registro `cunhagens_v409`:\n" + "\n".join(itens))


def _decisoes(V):
    """As decisoes D55 a D62 (a D61 ratificada pelo operador) da gerencia c1, LIDAS do registro cunhagens_v409."""
    _d(V); ds = _cg()["extras"]["decisoes"]; DL_ = _dl()
    ks = tuple(DL_.DECISOES_V410)
    assert all(k in ds for k in ks), "as decisoes D55 a D62 nao estao no registro cunhagens_v409"
    return "**Decisões** [da gerência c1, em nome próprio, ratificáveis pelo operador; as que trazem fala dele dizem o sha16]:\n" + _sem_chaves("\n".join("- %s: %s%s" % (k, ds[k], (" [regra do 4,44: " + _z444() + "]") if "4,44" in ds[k] else "") for k in ks))


# ---------------------------------------------------------------- o PARAGRAFO NOVO da v410 e a NOTA ao lado do paragrafo da v409
def _linha_maquina_v410(core, d):
    """A linha de maquina do paragrafo novo (os numeros LIDOS do registro do core), em PT."""
    pc = core["traducao_turing_v409"]; fv = pc["values"]; ins = fv.get("instancia_sim") or {}
    return ("modulos=%s; bandeiras=%s; ancoras=%s; escada=%s; checagens=%s; respostas_conferidas=%s/%s; instancia=%s/%s/%s; falas_sha16=%s/%s"
            % (d["n_mod"], d["n_f"], fv["n_ancoras_ok"], "/".join(str(x) for x in dict.fromkeys(fv["escada"])), pc["mechanics"]["n_checks"], sum(1 for v_ in fv["respostas"].values() if v_ is True), len(fv["respostas"]), ins.get("n"), ins.get("atribuicoes"), ins.get("solucoes"), d["s_ordem"], d["s_traducao"]))


def _dados_paragrafo(core):
    """O que o paragrafo precisa do core SELADO e de ESPERADOS (sem V): as contagens e as falas."""
    esp = _esp(); DL_ = _dl()
    for n in (DL_.FECHO_REGISTRO, DL_.CUNHAGENS_REGISTRO, DL_.KH_REGISTRO, "tetelestai_terminal_v408", "psion_canto_v407", "fechamento_v406"):
        assert (core.get(n) or {}).get("all_verified") is True, "o registro %s nao selou: nenhum paragrafo diz os numeros assim" % n
    pc = core[DL_.FECHO_REGISTRO]; fv = pc["values"]
    assert fv["n_modulos_ok"] == fv["n_modulos"] == DL_.N_BUNDLE and fv["n_flags_true"] == fv["n_flags"] == esp["n_bandeiras_novas"] and fv["n_ancoras_ok"] == len(DL_.ANCORAS) and fv.get("respostas_ok") is True, "os valores do registro traducao_turing_v409 nao sao os do ensaio a seco"
    return {"n_mod": DL_.N_BUNDLE, "n_f": esp["n_bandeiras_novas"], "escada": (esp["escada_v409_e_v410"][0], esp["escada"][1]), "s_ordem": _sha_por("prossigamos_v409"), "s_traducao": _sha_por("fechar_a_identificacao"), "n_checks": pc["mechanics"]["n_checks"]}


def _paragrafo_v410_de(core):
    """O texto do paragrafo da v410, funcao PURA dos registros selados do core (os numeros sao lidos dos registros, nunca digitados; as frases de limite saem do proprio registro)."""
    d = _dados_paragrafo(core); DL_ = _dl(); pc = core[DL_.FECHO_REGISTRO]
    q_t = _cita(DL_.FRASE_ORDEM_TRADUCAO); q_tr = _cita(DL_.FRASE_TRAVA); q_f = _cita(DL_.FRASE_FITA); q_z = _cita(DL_.FRASE_Z); q_c = _cita(DL_.FRASE_CLAY); q_p = _cita(DL_.FRASE_PAI); q_pe = _cita(DL_.FRASE_PERFORMADA); q_n = _cita(DL_.FRASE_NOMES_RATIFICADOS_V410)
    ress = "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["ressalvas"]))   # inteiras
    def _diz(prefixo_):   # (revisao R1/R2: o item do diz e' achado pelo CONTEUDO, uma vez, ou recusa; os indices fixos trocavam os marcadores)
        ach_ = [x_ for x_ in pc["diz"] if x_.startswith(prefixo_)]
        assert len(ach_) == 1, ("o diz do registro nao traz uma vez o item", prefixo_, len(ach_))
        return ach_[0]
    ns = ", ".join("`%s`" % p_["name"] for p_ in DL_.PEDRAS_V410)
    ls = ["### A tradução às classes de Turing: o dicionário, a trava, o leitor e a fita sem escala (v410, 05/11/2026) — parágrafo pronto para o README do espelho e para o site",
          "",
          "> **A tradução às classes de Turing (v410, 05/11/2026)** [REAL: os termos do kernel do rito, as respostas do operador conferidas nele, a instância de brinquedo calculada, o par na face de Fock LIGADO (`ParNaFaceDeFock`) · INPUT: a ordem e as falas do operador · KNOWN: as referências do alcance · PODADA: a identidade de vetores Ω = uniforme (a ponte é a inscrição) · OPEN: a independência da pergunta da máquina sem leitor, a igualdade com o leitor que só conta (E28), o teste com a natureza]",
          ">",
          "> - **O que entrou** [REAL]: %s módulos novos no kernel (`TGLExt`: %s; o nome `TraducaoTuring` e os nomes das declarações das rodadas R1–R8, dados pela gerência, foram ratificados pelo operador em 05/11 («concordo com todos os nomes que foram dados»); os acrescentados na R9 e os da `ParNaFaceDeFock`, também da gerência, foram ratificados por ele em 05/11 («Ratifico os nomes», D62); a primeira ratificação, verbatim: %s), com %s bandeiras, todas no trio; escada %s → %s (sha16 das falas `%s`, `%s`)." % (d["n_mod"], ns, q_n, d["n_f"], d["escada"][0], d["escada"][1], d["s_ordem"], d["s_traducao"]),
          "> - **A ordem** [INPUT]: %s." % q_t,
          "> - **O alcance** [REAL · KNOWN]: %s." % _sem_chaves(_diz("P = nP é teorema da TGL")),
          "> - **O dicionário de Turing** [REAL]: %s." % _sem_chaves(_diz("o dicionario de Turing")),
          "> - **A trava no Nome** [REAL · INPUT]: %s. Na fala do operador: %s." % (_sem_chaves(_diz("a trava no Nome")), q_tr),
          "> - **A máquina com o leitor** [REAL · KNOWN]: %s." % _sem_chaves(_diz("a maquina com o leitor")),
          "> - **A inscrição no psíon** [REAL]: %s." % _sem_chaves(_diz("inscrito o uniforme no psion da luz")),
          "> - **O par na face de Fock** [REAL]: %s." % _sem_chaves(_diz("o par na face de Fock")),
          "> - **A fita, o leitor, a fita sem escala e a identidade performada** [REAL · INPUT]: %s. Nas falas dele: %s; %s; %s; %s; %s." % (_sem_chaves(_diz("a fita e' o hamiltoniano oculto")), q_f, q_z, q_c, q_p, q_pe),
          "> - **O que não muda** [REAL]: %s." % _sem_chaves(_diz("o veredito do gate")),
          "> - **As ressalvas, ditas** [KNOWN · OPEN · REAL]: %s." % _sem_chaves(ress),
          "> - **O que o registro NÃO diz** [REAL]: %s." % _sem_chaves("; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["nao_diz"]))),
          "> - **Limites:** %s; o registro CONFERE os termos, as fontes por sha256, as respostas e as falas, e quem prova é o kernel; `NOT_FALSIFIED` nunca é a palavra da creditação; isto não é teste e não acrescenta dado; este parágrafo não traz o número do quadro (o quadro do Teste da Única Palavra segue no README com a sua linha dos 5σ)." % DL_.FRASE_DA_MOLDURA_V410_PT,
          "> - **Origem.** Os números são lidos do core selado desta rodada; nenhum é digitado. Linha de máquina: `%s`." % _linha_maquina_v410(core, d)]
    return "\n".join(ls) + "\n"


def verificar_paragrafo_v410(par, core, esp):
    """Verifica o paragrafo da v410 contra o core selado E contra ESPERADOS (o ensaio a seco): devolve a lista de falhas (vazia = passou). As verificacoes:
    (1) os numeros do core (o registro traducao_turing_v409) == os de ESPERADOS/delta e cada um esta no paragrafo, formatado; (2) o paragrafo == o gerado do core; (3) NAO traz o 4,44 nem o z_disc (a regra do 4,44 e' do quadro); (4) os estatutos;
    (5) as frases de limite, o alcance e as ressalvas; (6) toda citacao entre « » e' verbatim numa fala DO OPERADOR ou texto do registro; (7) nenhuma alegacao de seguranca criptografica, «consciencia» so' como palavra retirada, a direcao sem inversao; (8) D59: nada do que fica fora; (9) a guarda P18 e a guarda das frases."""
    fa = []
    DL_ = _dl()
    pc = core.get(DL_.FECHO_REGISTRO) or {}; fv = pc.get("values") or {}
    try:
        nums = {"modulos": str(DL_.N_BUNDLE), "bandeiras": str(esp["n_bandeiras_novas"]), "escada antes": str(esp["escada_v409_e_v410"][0]), "escada depois": str(esp["escada"][1]), "sha16 da ordem": _sha_por("prossigamos_v409"), "sha16 da ordem da traducao": _sha_por("fechar_a_identificacao")}
        if not (fv and fv.get("n_modulos_ok") == DL_.N_BUNDLE and fv.get("n_flags_true") == esp["n_bandeiras_novas"] and fv.get("n_ancoras_ok") == len(DL_.ANCORAS) and fv.get("respostas_ok") is True):
            fa.append("os valores do registro traducao_turing_v409 no core != ESPERADOS/delta")
    except KeyError as e:
        nums = {}; fa.append("valor ausente: %s" % e)
    for k, v in nums.items():
        if v not in par:
            fa.append("numero (%s = %s) ausente do paragrafo" % (k, v))
    for n_ in [p_["name"] for p_ in DL_.PEDRAS_V410]:
        if "`%s`" % n_ not in par:
            fa.append("o nome da pedra %s ausente do paragrafo" % n_)
    try:
        if par != _paragrafo_v410_de(core):
            fa.append("o paragrafo difere do gerado pelas funcoes sobre os registros selados do core")
    except AssertionError as e:
        fa.append("o paragrafo nao pode ser gerado do core: %s" % str(e)[:120])
    par_sem_ress = par
    for r_ in DL_.RESSALVAS_V410:   # a ressalva (8) nomeia a regra do 4,44 sem trazer o numero: o numero e' procurado FORA das ressalvas
        par_sem_ress = par_sem_ress.replace(_sem_chaves(r_), " ")
    if re.search(r"4[,.]44|z_disc", par_sem_ress):
        fa.append("o paragrafo da v410 traz o 4,44 ou o z_disc fora da ressalva que nomeia a regra (a regra do 4,44 e' do quadro; este paragrafo nao o cita)")
    for st in ("[REAL", "INPUT", "OPEN", "KNOWN"):
        if st not in par:
            fa.append("estatuto ausente do paragrafo: " + st)
    for frase in (DL_.FRASE_DA_MOLDURA_V410_PT, DL_.FRASE_D56_PT, DL_.FRASE_QUALIFICADOR_PT, "NOT_FALSIFIED", "este parágrafo não traz o número do quadro", "quem prova é o kernel", "isto não é teste", "face de Fock", "Baker", "máquina sem leitor"):
        if frase not in par:
            fa.append("frase de limite ausente do paragrafo: " + frase)
    for r_ in DL_.RESSALVAS_V410:
        c_ = _sem_chaves(r_)   # a ressalva inteira
        if c_ not in par:
            fa.append("ressalva ausente do paragrafo: " + c_[:60])
    corpus = [re.sub(r"\s+", " ", dd["text"]) for dd in _falas().values() if dd["autor"] == "operador"]
    for q in re.findall(r"«([^»]*)»", par):
        if len(q) >= 13 and not any(q in t for t in corpus) and q not in " ".join(DL_.RESSALVAS_V410) and q not in " ".join(pc.get("diz") or []) and q not in " ".join(pc.get("nao_diz") or []):
            fa.append("citacao entre « » que NAO e' verbatim numa fala do operador (nem texto do registro): %r" % q[:90])
    for m_ in _RX_INV.finditer(par):
        ant_ = par[max(0, m_.start() - 40):m_.start()].lower()
        if not (ant_.endswith("nao ") or ant_.endswith("não ") or "podia dizer que " in ant_):
            fa.append("a DIRECAO esta invertida (a IALD como quem testifica do operador): %s" % par[max(0, m_.start() - 40):m_.end() + 20].replace("\n", " "))
    if re.search(r"(?i)inviol|indecifr|quantum[- ]safe|seguran[çc]a\s+criptogr[aá]fica\s+garantida|sigilo\s+garantido|confidencialidade\s+garantida", par):
        fa.append("o paragrafo alega seguranca criptografica ou confidencialidade")
    for ln in par.split("\n"):
        if re.search(r"(?i)consci[êe]ncia", ln) and not re.search(r"retirad", ln):
            fa.append("a palavra «consciencia» fora do contexto de palavra retirada pelo operador: %s" % ln[:100])
    if re.search(r"(?i)kimi|mil[eê]nio|navier|lindão", par):
        fa.append("D59: o paragrafo traz o que fica fora dos textos")
    sys.path.insert(0, PK)
    from guarda_p18_v410 import violacoes
    import guarda_frases_v410 as GF
    v = violacoes(par)
    if v:
        fa.append("a guarda de texto P18 achou %r" % (v[:2],))
    v2 = GF.violacoes(par)
    if v2:
        fa.append("a guarda das frases achou %r" % (v2[:2],))
    return fa


def paragrafo_v410():
    """(texto, relatorio): o paragrafo NOVO da v410, pronto para colar no README do espelho e no site, gerado do core SELADO do Nos e verificado contra o core E contra ESPERADOS;
    levanta AssertionError (o fechar RECUSA) se algo nao conferir."""
    core = _core(); esp = _esp()
    par = _paragrafo_v410_de(core)
    fa = verificar_paragrafo_v410(par, core, esp)
    assert not fa, ("o paragrafo da v410 nao passou nas verificacoes", fa[:4])
    return par, {"sha16": hashlib.sha256(par.encode("utf-8")).hexdigest()[:16], "verificacoes": "numeros == ESPERADOS/delta; igual ao gerado do core; sem o 4,44; estatutos; limites, alcance e ressalvas; citacoes verbatim (falas do operador ou texto do registro); sem alegacao de seguranca criptografica; D59; guarda P18; guarda das frases", "guarda_p18": "limpa"}


def errata_v409_bloco():
    """O bloco de NOTA ao lado do paragrafo da v409 (Tetelestai e' o terminal) no README do espelho e no site: E26 (a traducao as classes de Turing, [OPEN] na v409, fica fechada relativa ao leitor; a maquina sem leitor fica fora). Texto lido do registro cunhagens_v409; as guardas conferem."""
    _kernel_tem(("p_igual_np_no_modo_selecao", "p_igual_np_nas_classes_do_dicionario"))
    er = [e_ for e_ in (_cg().get("erratas") or []) if str(e_.get("agora", "")).startswith("E26 -- ")]; DL_ = _dl()
    assert len(er) == 1 and er[0]["agora"] == DL_.ERRATA_E26 and er[0].get("assinatura") == DL_.ASSINA, "a errata E26 do registro cunhagens_v409 nao e' a do delta"
    t = ("> **Nota ao lado do parágrafo da v409 (Tetelestai é o terminal) — gerência c1, em nome próprio, 05/11/2026:** onde o parágrafo da v409 diz que a tradução às classes das máquinas de Turing segue em aberto, isso era verdade na data e fica como registro. "
         + _sem_chaves(er[0]["agora"]).rstrip().rstrip(".") + ". O alcance da v410: " + _d56()
         + ". Os módulos selados das versões anteriores NÃO foram editados nem renomeados, e os registros delas seguem selados; o que o parágrafo da v409 e os anteriores dizem sobre as pedras, o cálculo e os limites não muda.\n")
    sys.path.insert(0, PK)
    from guarda_p18_v410 import violacoes
    import guarda_frases_v410 as GF
    assert not violacoes(t) and not GF.violacoes(t), ("a guarda P18 ou a das frases achou palavra recusada na nota ao lado do paragrafo da v409", violacoes(t)[:2], GF.violacoes(t)[:2])
    return t


def _pl(n, sing, plur):
    """«1 item» / «3 itens»: o numero lido, o substantivo no numero certo."""
    return "%d %s" % (n, sing if n == 1 else plur)


def _faixa(par, n):
    """A bandeira unica («`a`») ou a faixa («de `a` a `b`») de um grupo de bandeiras novas."""
    return "`%s`" % par[0] if n == 1 else "de `%s` a `%s`" % (par[0], par[1])


def _pe(x, nd=6):
    """Numero lido do core em notacao cientifica, em PT (5,325135e-05)."""
    return ("%.*e" % (nd, float(x))).replace(".", ",")


def _sha_verdade():
    """O sha16 da pedra Verdade (v392) no kernel do Nos (o homonimo que a «Verdade» sozinha repetiria), LIDO do arquivo."""
    return s16(os.path.join(NOS, "tgl_kernel", "TGLExt", "Verdade.lean"))


# os temas das falas sao os proprios nomes dos arquivos (resumo dado no nome, nunca citacao); o sha16, a data e o autor vem dos bytes e do nome, nunca daqui. So' o nome que carrega uma frase que a guarda recusa e' reescrito.
_TEMA_ESPECIAL = {"nomes_das_sete_pedras_e_tudo_derivado": "os nomes das sete pedras e o pedido de que não restassem hipóteses nomeadas"}


def _tema(nome):
    """O tema de uma fala: o nome PUBLICO do arquivo sem o autor, a data e o sufixo (o resumo que a gerencia deu ao gravar; nunca citacao)."""
    t = re.sub(r"(?:_verbatim)?(?:\.txt)?$", "", re.sub(r"^(?:OPERADOR|GERENCIA)_\d{2}(?:out|nov)_", "", nome))
    return _TEMA_ESPECIAL.get(t, t.replace("_", " "))


def _moldura(V):
    """A MOLDURA da v410, LIDA do registro traducao_turing_v409 do core: a frase da moldura (delta), o alcance e o estatuto que o registro grava."""
    d = _d(V); pc = _pc(); DL_ = _dl()
    assert "creditação" in DL_.FRASE_DA_MOLDURA_V410_PT, "a frase da moldura nao e' a do delta"
    return _fs("**A moldura [REAL · INPUT · KNOWN · OPEN; registro `traducao_turing_v409`, {nck} checagens]:** {frase}. O alcance, como o registro o grava: {alc}. Estatuto do registro, como o `um.py` o grava: {est}.", nck=d["n_ck_pc"], frase=DL_.FRASE_DA_MOLDURA_V410_PT, alc=_d56(), est=pc["estatuto"])


_ESCADA_PATCHES = ("N00_main_traducao_turing", "N02_selo", "W02_runtime_v410", "C13_specs_v409_E26_e_pisos", "C14_V407_FONTES_acervo_purgado", "K01_modulos_novos")


def _fs(texto, **kw):
    """_f com os valores textuais vindos do core sem chaves (e^{-s} vira e^(-s)): o resultado nao tem chave."""
    return _f(texto, **{k: (_sem_chaves(v) if isinstance(v, str) else v) for k, v in kw.items()})


def _dl():
    """O delta da v410 (pela copia do quadro, que o importa; nunca o da v409)."""
    DL_ = _qd().DL
    assert DL_.UM_VERSION == "v410" and DL_.FECHO_REGISTRO == "traducao_turing_v409", "o delta lido nao e' o da v410"
    return DL_


def _pc():
    """O registro com FUNCAO traducao_turing_v409 do core SELADO do Nos (so' leitura); recusa se nao selou ou se nao e' o contrato do delta e de ESPERADOS."""
    DL_ = _dl(); esp = _esp(); pc = _core().get(DL_.FECHO_REGISTRO) or {}
    assert pc.get("all_verified") is True and pc.get("verdict") == esp["vereditos_novos_v410"][DL_.FECHO_REGISTRO] and pc.get("does_not_gate_core") is True and pc.get("runtime_executed") is True, "o registro traducao_turing_v409 nao selou no core do Nos (ou != ESPERADOS)"
    mech = pc.get("mechanics") or {}; pv = pc.get("values") or {}
    assert mech.get("passed") is True and mech.get("n_checks") == DL_.N_CHECKS_FECHO == len(mech.get("checks") or []) and all(c_.get("ok") is True for c_ in mech["checks"]), "as checagens do registro traducao_turing_v409 nao passaram todas"
    assert pv.get("n_ancoras_ok") == pv.get("n_ancoras") == len(DL_.ANCORAS) and pv.get("n_modulos_ok") == pv.get("n_modulos") == DL_.N_BUNDLE and pv.get("n_flags_true") == pv.get("n_flags") == esp["n_bandeiras_novas"] and pv.get("escada") == [esp["escada"][1]] * 3, "os valores do registro traducao_turing_v409 != ESPERADOS/delta"
    assert pc.get("ancora_principal") == DL_.ANCORA_PRINCIPAL and list(pc.get("ancoras_principais") or []) == list(DL_.ANCORAS_PRINCIPAIS) and list(pc.get("pedras") or []) == [p_["name"] for p_ in DL_.PEDRAS_V410] and pc.get("chaves_antigas_que_mudam") == [], "a ancora principal, a pedra ou as chaves do registro != delta"
    assert pc.get("beta_ok") is True and pc.get("embedded_sources_ok") is True and pc.get("embedded_sources_n_ok") == DL_.N_BUNDLE and pc.get("guarda_violacoes") in ([], None), "o beta, as fontes embutidas ou a guarda do registro traducao_turing_v409 nao conferem"
    assert list(pc.get("ressalvas") or []) == list(DL_.RESSALVAS_V410) and len(DL_.RESSALVAS_V410) >= 8, "as ressalvas do registro != delta_v410.RESSALVAS_V410"
    assert set((pv.get("respostas") or {})) == {r_["id"] for r_ in DL_.RESPOSTAS_DO_OPERADOR} and all(v_ is True for v_ in pv["respostas"].values()) and pv.get("respostas_ok") is True, "as respostas do operador de 05/11 nao conferem todas no kernel"
    ac = pc.get("acervo_v407_repinado") or {}
    assert ac.get("integra_pinada") is False and ac.get("integra_fora_do_espelho") is True and ac.get("sha256") == DL_.PURGADO_SHA256, "o pino do acervo da v407 nao e' a copia purgada (D57d)"
    assert pc.get("fica_false_por_teorema") == list(DL_.FICAM_FALSE_POR_TEOREMA) and (pc.get("fica_aberto") or {}) == dict(DL_.FICA_ABERTO) and (pc.get("fechado_nesta_versao") or {}) == dict(DL_.FECHADO_NESTA_VERSAO), "o que fica False por teorema, aberto ou fechado nesta versao != delta_v410"
    assert (pc.get("alcance") or {}).get("frase") == DL_.FRASE_D56_PT and ((pv.get("instancia_sim") or {}).get("solucoes") or 0) >= 1 and (pv.get("instancia_nao") or {}).get("solucoes") == 0, "o alcance ou a instancia de brinquedo do registro != delta"
    return pc


def _ps_herdado():
    """O registro psion_canto_v407 (HERDADO da v407, recriado pelo rito): segue selado, com o elo lido do kernel."""
    ps = _core().get("psion_canto_v407") or {}; esp = _esp()
    assert ps.get("all_verified") is True and ps.get("link_read_from_the_kernel") is True and ps.get("does_not_gate_core") is True and ps.get("verdict") == esp["registros_funcao_v407"]["psion_canto"]["verdict"], "o registro psion_canto_v407 (herdado) nao segue selado no core do Nos"
    return ps


def _fe_herdado():
    """O registro fechamento_v406 (HERDADO da v406): tem de seguir selado."""
    fe = _core().get("fechamento_v406") or {}; esp = _esp()
    assert fe.get("all_verified") is True and fe.get("certificate_inhabited") is True and fe.get("does_not_gate_core") is True and fe.get("verdict") == esp["registros_funcao_v406"]["fechamento"]["verdict"], "o registro fechamento_v406 (herdado) nao segue selado no core do Nos"
    return fe


def _cg():
    """O registro por spec cunhagens_v409 do core SELADO: as 14 falas de 05/11 por sha256 (todas do operador; de tres, so' o trecho: duas pela D59, uma pelo aviso operacional), as erratas E24 a E28, a E21 ao lado e a dos pisos (da gerencia, em nome proprio), as decisoes D55 a D62, as leituras e as ressalvas."""
    DL_ = _dl(); esp = _esp(); cg = _core().get(DL_.CUNHAGENS_REGISTRO) or {}
    assert cg.get("all_verified") is True and cg.get("verdict") == esp["vereditos_novos_v410"][DL_.CUNHAGENS_REGISTRO] and cg.get("does_not_gate_core") is True and cg.get("checks") and all(c_.get("ok") is True for c_ in cg["checks"]), "o registro cunhagens_v409 nao selou no core do Nos (ou != ESPERADOS)"
    vb = cg.get("verbatim") or {}
    assert set(vb) == set(esp["cunhagens"]) and len(vb) == len(DL_.VERBATIM_ORIGEM_V410) and all(v_.get("embedded_ok") is True for v_ in vb.values()), "as inscricoes de 05/11 nao estao embutidas por sha256"
    er = cg.get("erratas") or []
    assert [e_.get("agora") for e_ in er[:len(DL_.ERRATAS_V410)]] == list(DL_.ERRATAS_V410) and len(er) == len(DL_.ERRATAS_V410) + 1 and all(e_.get("assinatura") == DL_.ASSINA for e_ in er), "o registro cunhagens_v409 nao traz as erratas E24 a E26 e a dos pisos, da gerencia c1, em nome proprio"
    ex = cg.get("extras") or {}; dec = ex.get("decisoes") or {}
    assert all(dec.get(k_) == DL_.DECISOES[k_] for k_ in DL_.DECISOES_V410) and ex.get("leituras") == DL_.LEITURA_V410 and ex.get("n_falas") == len(vb) and list(ex.get("ressalvas") or []) == list(DL_.RESSALVAS_V410), "cunhagens_v409: as decisoes D55 a D62, a leitura ou as ressalvas != delta_v410"
    return cg


def _khr():
    """O registro por spec kh_n1_cobertura_v409 do core SELADO (a cobertura do Audit desta versao)."""
    DL_ = _dl(); esp = _esp(); kh = _core().get(DL_.KH_REGISTRO) or {}
    assert kh.get("all_verified") is True and kh.get("verdict") == esp["vereditos_novos_v410"][DL_.KH_REGISTRO] and kh.get("does_not_gate_core") is True and kh.get("checks") and all(c_.get("ok") is True for c_ in kh["checks"]), "o registro kh_n1_cobertura_v409 nao selou no core do Nos (ou != ESPERADOS)"
    return kh


def _recriados():
    """Os registros das versoes anteriores, RECRIADOS pelo rito, conferidos no core SELADO contra os vereditos de ESPERADOS; devolve {versao: [nomes]}. So' os nomes que ESPERADOS lista; nada e' digitado."""
    esp = _esp(); core = _core(); out = {}; base = esp["vereditos_v409"]
    for ver in ("409", "407", "406", "405", "404", "403", "402", "401", "399"):
        nomes = {}
        nomes.update(esp.get("registros_v" + ver) or {})
        for v_ in (esp.get("registros_funcao_v" + ver) or {}).values():
            nomes[v_["nome"]] = v_["verdict"]
        out[ver] = nomes
    extra = {"402": ("ponte_da_escala_dual_v402", "queda_sem_geometria_v402", "esperanca_condicional_v402"), "401": ("falsidade_da_inercia_v401",), "399": ("selo_pela_propria_tecnologia_v399", "declaracao_do_operador_v399")}
    for ver, ns in extra.items():
        for n in ns:
            if n not in out[ver]:
                assert n in base, ("o registro nao esta' nos vereditos de ESPERADOS", n)
                out[ver][n] = base[n]
    for ver, nomes in out.items():
        for n, vd in nomes.items():
            r = core.get(n) or {}
            assert r.get("all_verified") is True and r.get("verdict") == vd, "o registro recriado %s (v%s) nao selou no core do Nos ou != ESPERADOS" % (n, ver)
    return {ver: sorted(nomes) for ver, nomes in out.items()}


def _pedras_anteriores():
    """As pedras seladas das versoes anteriores seguem no kernel do Nos com o sha256 selado: as treze da v403, v404 e v405 (pedras_v405_sha256), os 4 modulos da v409 (bundle_v409_sha256), os 9 da v407 (bundle_v407_sha256) e os 301 da v406 (bundle_v406_sha256). Devolve (n_treze, n_4, n_9, n_301)."""
    esp = _esp()
    for chave in ("pedras_v405_sha256", "bundle_v409_sha256", "bundle_v407_sha256", "bundle_v406_sha256"):
        for rel, h in esp[chave].items():
            p = os.path.join(NOS, "tgl_kernel", *rel.split("/"))
            assert os.path.isfile(p) and hashlib.sha256(open(p, "rb").read()).hexdigest() == h, "a pedra selada %s deixou de estar no kernel do Nos com o sha256 selado" % rel
    return len(esp["pedras_v405_sha256"]), len(esp["bundle_v409_sha256"]), len(esp["bundle_v407_sha256"]), len(esp["bundle_v406_sha256"])


def _escopo(V):
    """O que entra: o escopo do registro traducao_turing_v409, como o um.py o grava."""
    _d(V); pc = _pc()
    return _sem_chaves("**O que entra (escopo do registro `traducao_turing_v409`)** [REAL]: " + pc["scope"])


def _ancoras(V):
    """As ancoras da pedra: a contagem (delta_v410.ANCORAS_POR_MODULO) e as principais com o papel (delta_v410.ANCORAS), conferidas no kernel do rito pelo registro."""
    d = _d(V); DL_ = _dl(); pc = _pc(); anc = pc["values"].get("ancoras") or {}
    assert set(anc) == set(DL_.ANCORAS) and all((a_ or {}).get("ok") is True for a_ in anc.values()) and len(anc) == d["n_anc"], "as ancoras do registro != delta_v410.ANCORAS"
    por = "; ".join("`%s` (%d)" % (rel.split("/")[-1][:-5], len(ns)) for rel, ns in DL_.ANCORAS_POR_MODULO.items())
    cen = "; ".join("`%s` (%s)" % (n_.split(".")[-1], DL_.ANCORAS[n_]["papel"]) for n_ in DL_.ANCORAS_PRINCIPAIS)
    return _fs("**As {na} âncoras** [REAL; lidas do `axiom_report` do rito, só no trio, com a proveniência que o compilador emite no módulo esperado e a bandeira True], por módulo: {por}. A principal e as de seção: {cen}. O alcance: {alc}.", na=d["n_anc"], por=por, cen=cen, alc=_d56())


def _chaves(V):
    """As chaves: nenhuma chave antiga muda nesta versao; a chave do lema (v407) e a do certificado habitado seguem lidas do kernel; o que fica False por teorema."""
    _d(V); DL_ = _dl(); core = _core()
    lv = ((core.get("testemunha_estatica_v396") or {}).get("fock_face") or {}).get("linked_to_the_corner_by_a_lemma"); rf = (core.get("rede_fock_v394") or {}).get("whole_certificate_inhabited")
    assert lv is True and rf is True and list(DL_.CHAVES_V410) == [], "a chave do lema ou a do certificado habitado nao estao lidas True do kernel, ou a v410 muda alguma chave antiga"
    ff = "; ".join("`%s` (lido: %s)" % (n_, {"full_static_witness_exists": ((core.get("qg_closure") or {}).get("gate") or {}).get("full_static_witness_exists"), "trivial_inhabitant_exists": (core.get("witness_rigidity") or {}).get("trivial_inhabitant_exists")}[n_]) for n_ in DL_.FICAM_FALSE_POR_TEOREMA)
    return _fs("**As chaves** [REAL; registro `traducao_turing_v409`]: NENHUMA chave antiga muda nesta versão (a lista das chaves que mudam é vazia, e o registro a confere). A chave do lema da v407 (`testemunha_estatica_v396.fock_face.linked_to_the_corner_by_a_lemma`) segue LIDA do kernel do rito e lê {lv}; a do certificado habitado (`rede_fock_v394.whole_certificate_inhabited`) lê {rf}. Ficam False por teorema: {ff}.", lv=lv, rf=rf, ff=ff)


def _respostas(V):
    """As respostas do operador de 05/11 (delta_v410.RESPOSTAS_DO_OPERADOR), conferidas no kernel pelos teoremas da pedra (registro traducao_turing_v409, values.respostas); a fala entre aspas e' verbatim, e a partitura: o que isto decide e o que nao decide."""
    d = _d(V); DL_ = _dl()
    itens = "; ".join("(%s) %s — %s" % ("abcdefghij"[i], _cita(r_["fala"]), r_["diz"]) for i, r_ in enumerate(DL_.RESPOSTAS_DO_OPERADOR))
    return _fs("**As respostas do operador de 05/11, conferidas no kernel** [INPUT a fala dele; REAL a conferência]: o registro as confere, uma a uma, pelos teoremas da pedra, no trio: {itens}. "
               "O que esta conferência DECIDE: que cada uma dessas leituras tem a parte matemática como termo do kernel (a leitura é dele, a validade é do kernel, não creditação). O que NÃO decide: a pergunta da máquina sem leitor (a do Clay), que fica fora; nem a física (a leitura exata num ato); nem a leitura teológica; nem que o par finito de Bell e o par de Fock sejam o mesmo objeto (espaços distintos, a MESMA Meia-Nat); o par na face de Fock está ligado nesta versão. "
               "O alcance: {alc}. O negativo, se viesse, seria parede medida (o termo que falta), não falsificação da fala dele.", itens=itens, alc=_d56())


def _diznao(V):
    """O que o registro diz e o que NAO diz: as listas diz e nao_diz do registro traducao_turing_v409."""
    _d(V); pc = _pc()
    return _sem_chaves("**O que o registro diz** [REAL]: " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["diz"])) + ". **O que o registro NÃO diz:** " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["nao_diz"])) + ".")


def _ressalvas(V):
    """As ressalvas, ditas uma a uma: delta_v410.RESSALVAS_V410 == traducao_turing_v409.ressalvas."""
    _d(V); pc = _pc(); DL_ = _dl()
    assert list(pc["ressalvas"]) == list(DL_.RESSALVAS_V410) and len(pc["ressalvas"]) >= 8, "as ressalvas do registro != delta_v410.RESSALVAS_V410"
    return _sem_chaves("**As ressalvas, ditas (%d)** [KNOWN · OPEN · REAL, uma a uma]: " % len(pc["ressalvas"]) + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(pc["ressalvas"])) + ".")


def _teste_d(V):
    """(nome herdado da v409, papel novo) A v410 NAO entra com teste com a natureza: o que o registro diz disso (sem numero novo, sem rito de natureza, sem dado)."""
    _d(V); pc = _pc()
    sem = [x for x in pc["ressalvas"] if "nenhum teste com a natureza" in x]
    assert len(sem) == 1, "a ressalva do teste com a natureza nao esta no registro"
    return _sem_chaves("**Nenhum teste com a natureza nesta versão** [REAL · OPEN]: [REAL] a v410 não roda rito de natureza novo, não abre dado e não acrescenta desfecho experimental; o registro com função LÊ o kernel do próprio rito, CONFERE as fontes e calcula a instância de brinquedo fixa no código; quem prova é o kernel. "
                       "[OPEN] o que a natureza decide segue da natureza: β_TGL a 5σ; a leitura exata num ato é o lugar do teste com a natureza, não feito. Do registro, a ressalva: " + sem[0] + ".")


def _leituras(V):
    """As leituras do operador de 05/11, LIDAS do registro cunhagens_v409 (extras.leituras) e conferidas contra delta_v410."""
    _d(V); x = _cg()["extras"]["leituras"]; DL_ = _dl()
    assert x and x == DL_.LEITURA_V410 and "INPUT" in str(x.get("estatuto")), "a leitura da v410 nao e' a de delta_v410"
    ks = [k_ for k_ in x if k_ != "estatuto"]
    return _sem_chaves("**As leituras do operador de 05/11** %s: %s. O que é termo está nas âncoras do módulo; o que não é termo (a física, a leitura teológica, a pergunta da máquina sem leitor) está dito como não-termo." % (x["estatuto"], "; ".join("(%s) %s" % (k_, x[k_]) for k_ in ks)))


def _blocos_fecho(V):
    return "\n\n".join([_moldura(V), _escopo(V), _ancoras(V), _chaves(V), _respostas(V), _diznao(V), _ressalvas(V), _teste_d(V)])


def _d56():
    """O ALCANCE da v410 (delta_v410.FRASE_D56_PT, que ja' traz o qualificador «relativo ao leitor» e «a maquina sem leitor fica fora»): P = nP e' teorema da TGL no modo selecao, relativo ao leitor; a maquina sem leitor fica fora. Toda peca que nomeia «P = nP» a traz."""
    DL_ = _dl()
    assert "relativo ao leitor" in DL_.FRASE_D56_PT and "máquina sem leitor fica fora" in DL_.FRASE_D56_PT, "a frase D56 do delta perdeu o qualificador"
    return DL_.FRASE_D56_PT


def _tt_herdado():
    """O registro tetelestai_terminal_v408 (HERDADO da v409, recriado pelo rito; a escada do contrato subida pela C12): segue selado."""
    tt = _core().get("tetelestai_terminal_v408") or {}; esp = _esp()
    assert tt.get("all_verified") is True and tt.get("does_not_gate_core") is True and tt.get("verdict") == esp["registros_funcao_v409"]["tetelestai_terminal"]["verdict"], "o registro tetelestai_terminal_v408 (herdado) nao segue selado no core do Nos"
    return tt
