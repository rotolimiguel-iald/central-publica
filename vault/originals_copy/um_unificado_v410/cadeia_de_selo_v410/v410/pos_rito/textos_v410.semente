_NOMES_UM = ("SEALED_CODATA_ALPHA", "traducao_turing_v409", "cunhagens_v409", "kh_n1_cobertura_v409", "_V409_TRADUCAO_CONTRACT", "_v409_guarda_frases", "v409_traducao_mechanics", "tetelestai_terminal_v408", "cunhagens_v408", "kh_n1_cobertura_v408", "_V408_TERMINAL_CONTRACT",
             "psion_canto_v407", "cunhagens_v407", "kh_n1_cobertura_v407", "_V407_FONTES", "fechamento_v406", "cunhagens_v406", "kh_n1_cobertura_v406", "rede_fock_v394", "psibit_v395", "testemunha_estatica_v396",
             "prove_qg_closure_gate", "evaluate_quantum_gravity_closure", "prove_neutrino_mass_gravitational", "ramo_b_preregistration_v386", "ledger_errata_v386", "angle_status", "GA_WINDOW_STATUS", "prove_ga_mass_audit", "prove_joint_coincidence_result_v3",
             "selo_pela_propria_tecnologia_v399", "declaracao_do_operador_v399", "selo_acom_sidecar_v399", "teste_de_veracidade_fase9_v397", "hubble_ratio_opening_v388", "_v397_quadro_md", "_v397_atomos", "_V397_FRASE_444")
s16 = lambda p: hashlib.sha256(open(p, "rb").read()).hexdigest()[:16]
_CACHE = {}
# a DIRECAO (v399): nenhuma frase pode por a IALD como quem testifica DO operador (fora da fala em que ele a recusa); a mesma regex do conferidor (C12)
_RX_INV = re.compile(r"IALD\s+testifica\s+(?:a\s+mim|do\s+operador|de\s+mim)")
ERRATA_TEOREMAS = "a escada conta bandeiras — declarações nomeadas, teoremas e definições — com axiomas no trio; o rótulo «teoremas limpos» fica como registro de máquina"   # (a mesma frase de delta_v410.ERRATA_TEOREMAS_PT; o harness confere)


def _g(d, *ks):
    for k in ks:
        d = (d or {}).get(k) if isinstance(d, dict) else None
    return d


def _kernel_tem(nomes):
    """Fail-closed: cada nome de termo citado aqui tem de existir em algum .lean de TGLExt/ do Nos (lido na hora)."""
    if "kernel" not in _CACHE:
        base = os.path.join(NOS, "tgl_kernel", "TGLExt"); blob = []
        for r, ds, fs in os.walk(base, followlinks=False):
            ds[:] = [d for d in ds if not os.path.islink(os.path.join(r, d))]
            for f in fs:
                if f.endswith(".lean"):
                    blob.append(open(os.path.join(r, f), encoding="utf-8", errors="replace").read())
        _CACHE["kernel"] = "\n".join(blob)
    for n in nomes:
        assert n in _CACHE["kernel"], "termo citado nao esta no kernel do Nos: %s" % n


def _modulos_tem(nomes):
    """Cada modulo citado existe como arquivo .lean em TGLExt/ (o da v410, os 4 da v409, os 9 da v407) ou em TGLExt/F1Fecho394/ (os 301 da v406) do Nos."""
    for n in nomes:
        assert any(os.path.isfile(os.path.join(NOS, "tgl_kernel", "TGLExt", *p, n + ".lean")) for p in ((), ("F1Fecho394",))), "modulo citado nao esta no kernel do Nos: %s" % n


def _um_tem(nomes):
    """Cada identificador do um.py citado aqui existe no um.py do Nos (lido na hora)."""
    if "um" not in _CACHE:
        _CACHE["um"] = open(os.path.join(NOS, "um.py"), encoding="utf-8", errors="replace").read()
    for n in nomes:
        assert n in _CACHE["um"], "identificador citado nao esta no um.py do Nos: %s" % n


def _conferir_nomes():
    if "nomes_ok" not in _CACHE:
        _kernel_tem(_NOMES_KERNEL); _modulos_tem(_MODULOS_KERNEL); _um_tem(_NOMES_UM)
        _CACHE["nomes_ok"] = True


# ---------------------------------------------------------------- leitura dos insumos, do ESPERADOS e do core (tudo por script; nenhum numero, hash ou citacao vem da memoria)
def _esp():
    """ESPERADOS_v410.json (gerado pelo ensaio a seco do candidato), lido uma vez."""
    if "esp" not in _CACHE:
        _CACHE["esp"] = json.load(open(os.path.join(PK, "ESPERADOS_v410.json"), encoding="utf-8"))
    return _CACHE["esp"]


def _core():
    """O core do Nos (so' leitura), para os campos que so' existem depois do rito; ausente e' falha visivel."""
    if "core" not in _CACHE:
        _CACHE["core"] = json.load(open(os.path.join(NOS, "um_absoluto.json"), encoding="utf-8"))["core"]
    return _CACHE["core"]


def _base_core():
    """O core da v409 selada (a copia de bytes em base_v409): de onde saem os numeros da errata ao lado e a medida da proveniencia."""
    if "base_core" not in _CACHE:
        _CACHE["base_core"] = json.load(open(os.path.join(PK, "base_v409", "um_absoluto.json"), encoding="utf-8"))["core"]
    return _CACHE["base_core"]


def _qd():
    """O modulo quadro_v397 (da pasta do pacote, copia intocada): as MESMAS funcoes que o artigo, o .md e o paragrafo do README/site usam para o quadro do Teste da Unica Palavra."""
    if "qd" not in _CACHE:
        if PK not in sys.path:
            sys.path.insert(0, PK)
        import quadro_v397 as QD
        _CACHE["qd"] = QD
    return _CACHE["qd"]


def _res_path(esp):
    """O resultado pinado do Teste da Unica Palavra: a copia em PK/insumos/fase9 (so' existe no SANDBOX do harness) ou, no real, a copia duravel da v397 (ESPERADOS[veracidade][resultado][duravel]); o sha256 e' conferido contra ESPERADOS."""
    nome = os.path.basename(esp["veracidade"]["resultado"]["duravel"])
    loc = os.path.join(PK, "insumos", "fase9", nome)
    return loc if os.path.exists(loc) else esp["veracidade"]["resultado"]["duravel"]


def _atomos():
    """Os atomos numericos do quadro (PT) sobre o registro SELADO no core do Nos: o menos de verdade e a virgula decimal ja vem dentro; recusa se o registro nao selou."""
    a = _qd().Q._v397_atomos(_core().get("teste_de_veracidade_fase9_v397") or {}, "pt")
    assert a["sealed"] is True, "o registro teste_de_veracidade_fase9_v397 nao sela no core do Nos (algum numero ausente ou all_verified falso): nenhum texto diz o 4,44 assim"
    return a


def _z444():
    """A clausula-padrao do 4,44, USADA toda vez que o numero entra num texto: o z_disc, o p calibrado e a linha dos 5 sigma na mesma frase (regra da ordem do operador)."""
    a = _atomos()
    return "z_disc = %s (calibrado; p unilateral %s), abaixo do degrau de 5σ da creditação, que não foi alcançado (%s < 5)" % (a["z_disc"]["md"], a["p_disc"]["md"], a["z_disc"]["md"])


def _falas():
    """As inscricoes de 05/11 embutidas no um.py: o texto vem do arquivo em insumos/cunhagens e o sha256 e' conferido contra ESPERADOS (fail-closed). Devolve {sha16: {sha16, arquivo, nome, text, autor, misto, trecho, autor_do_arquivo}}.
    Nas duas da D59 (so' o trecho que fica) a chave e' o sha16 do ARQUIVO INTEIRO e o texto embutido (e o unico citavel) e' o TRECHO (o arquivo .trecho_que_fica.txt, conferido contra ESPERADOS[cunhagens][..][sha256]); o arquivo inteiro NAO esta em insumos
    (nao vai ao espelho) e e' conferido so' por sha256 contra a origem que o delta lista. O nome e' o da copia duravel (o nome publico; D59). Todas sao falas do operador; nenhuma e' da gerencia nem de autor misto."""
    if "falas" not in _CACHE:
        ec = _esp()["cunhagens"]; out = {}; pasta = os.path.join(PK, "insumos", "cunhagens"); suf = ".trecho_que_fica.txt"
        orig = {hashlib.sha256(open(p_, "rb").read()).hexdigest() for p_ in _dl().VERBATIM_ORIGEM_V410}
        for k, meta in ec.items():
            s = k[len("v410_cun_"):]
            trecho = bool(meta.get("sha256_arquivo_inteiro"))
            fs = [f for f in sorted(os.listdir(pasta)) if f.startswith(s + "_") and (f.endswith(suf) if trecho else not f.endswith(suf))]
            assert len(fs) == 1, ("a inscricao %s nao tem arquivo unico em insumos/cunhagens" % s, fs)
            b = open(os.path.join(pasta, fs[0]), "rb").read()
            assert hashlib.sha256(b).hexdigest() == meta["sha256"] and len(b) == meta["bytes"], "a inscricao %s nao confere com o sha256 de ESPERADOS" % s
            if trecho:
                assert meta["sha256_arquivo_inteiro"][:16] == s and meta["sha256_arquivo_inteiro"] in orig, "o arquivo inteiro da inscricao %s (D59) nao confere com a origem por sha256" % s
                nome = fs[0][len(s) + 1:-len(suf)]
            else:
                assert meta["sha256"][:16] == s and meta["sha256"] in orig, "a chave da inscricao %s nao e' o sha16 do arquivo" % s
                nome = fs[0][len(s) + 1:]
            assert nome.startswith("OPERADOR_05nov_") and "milenio" not in nome.lower() and "kimi" not in nome.lower(), ("a v410 so' tem falas do operador de 05/11, com o nome publico (D59)", s)
            out[s] = {"sha16": s, "arquivo": fs[0], "nome": nome, "text": b.decode("utf-8"), "autor": "operador", "misto": False, "trecho": trecho, "autor_do_arquivo": "operador"}
        assert sum(1 for d in out.values() if d["trecho"]) == len(_dl().VERBATIM_SO_O_TRECHO) == 3, "a v410 tem exatamente tres inscricoes so' com o trecho (duas pela D59; uma, a ratificacao da D61, pelo aviso operacional)"
        _CACHE["falas"] = out
    return _CACHE["falas"]


def _sha_por(sub):
    """O sha16 da unica inscricao cujo arquivo de origem contem `sub` (as inscricoes sao achadas assim, nunca digitadas)."""
    r = [s for s, d in _falas().items() if sub in d["nome"]]
    assert len(r) == 1, ("inscricao nao unica ou ausente", sub, r)
    return r[0]


def _cita(trecho):
    """Fail-closed: o trecho tem de estar numa das falas DO OPERADOR, palavra por palavra e na mesma ordem; devolve «trecho». Citacao fora dos bytes derruba a geracao.
    So' uma coisa e' relevada: uma quebra de linha ou um espaco duplo do ARQUIVO vale como um espaco; o trecho citado nunca tem espaco duplo nem quebra."""
    assert "\n" not in trecho and "  " not in trecho, "o trecho citado tem quebra de linha ou espaco duplo"
    corpus = [re.sub(r"\s+", " ", d["text"]) for d in _falas().values() if d["autor"] == "operador"]
    assert any(trecho in t for t in corpus), "citacao fora dos bytes das falas do operador: %r" % trecho[:70]
    return "«" + trecho + "»"


def _um_texto_tem(frase):
    """A frase do KERNEL embutido no um.py do Nos (a docstring do 0_abs, sem a marca de negrito): fail-closed."""
    if "um" not in _CACHE:
        _CACHE["um"] = open(os.path.join(NOS, "um.py"), encoding="utf-8", errors="replace").read()
    assert frase in _CACHE["um"].replace("**", ""), "a frase do kernel nao esta no um.py do Nos: %r" % frase[:70]
    return "«" + frase + "»"


def _frase_444():
    """A frase do operador do quadro (v397), VERBATIM, conferida contra os bytes do arquivo da v397 (pelo sha16 que ESPERADOS[quadro] registra): devolve «frase»."""
    if "f444" not in _CACHE:
        esp = _esp(); frase = esp["quadro"]["frase_do_operador"]; h = esp["quadro"]["frase_sha16"]
        pasta = os.path.join(WK, "cadeia_de_selo", "v397", "insumos", "cunhagens")
        fs = [f for f in sorted(os.listdir(pasta)) if f.startswith(h + "_")]
        assert len(fs) == 1, ("o arquivo da fala do 4,44 nao e' unico em v397\\insumos\\cunhagens", fs)
        b = open(os.path.join(pasta, fs[0]), "rb").read()
        assert hashlib.sha256(b).hexdigest()[:16] == h and frase in re.sub(r"\s+", " ", b.decode("utf-8")), "a frase do 4,44 nao esta nos bytes da fala pinada"
        assert frase == _qd().DL.FRASE_DO_OPERADOR_4_44 == _qd().Q._V397_FRASE_444, "a frase do quadro != a verbatim"
        _CACHE["f444"] = frase
    return "«" + _CACHE["f444"] + "»"


def _data_fala(d, V):
    m = re.match(r"(?:OPERADOR|GERENCIA)_(\d{2})(out|nov)_", d["nome"])
    assert m, ("o nome do arquivo da inscricao nao traz a data", d["nome"])
    return "%s/%s/%s" % (m.group(1), "10" if m.group(2) == "out" else "11", V["data"][-4:])


def _cov_base():
    """A cobertura do Audit e a arvore formal da v409 selada (o core guardado em base_v409): de onde saem os numeros da errata ao lado dos pisos."""
    if "cov_base" not in _CACHE:
        kf = _base_core()["kernel_formalization"]
        cov = kf["axiom_coverage_v392"]
        _CACHE["cov_base"] = {"decl": cov["decl"], "thm": cov["thm"], "h8": len(kf["formal_files_sha256"]), "axr": len(kf["axiom_report"])}
    return _CACHE["cov_base"]


def _bancada():
    """A geracao do manifesto que a Bancada de producao pina (do recibo pre_selo pinado em PINOS_BN) e a versao que ela pina; o passo e' simples (sem salto e sem cadeia de selos)."""
    p = json.load(open(os.path.join(PK, "PINOS_BN_v410.json"), encoding="utf-8"))
    rp = p["recibo_pre_selo"]; bp = rp["bancada_pina"]
    m = re.match(r"^B(\d+)-", str(bp["deployment_id"]))
    assert m and bp["version"] == "v409" and rp.get("sem_salto") is True and "cadeia_de_selos" not in p, "o PINOS_BN nao descreve um passo simples v409 -> v410 (sem salto)"
    return {"de": bp["version"], "geracao": int(m.group(1)), "proxima": int(m.group(1)) + 1}


def _proveniencia(esp):
    """A proveniencia que o compilador emite atribui ao modulo da pedra N declaracoes; todas sao NOVAS no axiom_report (nenhuma reatribuida), e o FLAGS_v410.json do sandbox concorda (as contagens de
    publicas, privadas, nomeadas e auxiliares so' existem la')."""
    if "prov" not in _CACHE:
        kf = _core()["kernel_formalization"]; src = kf["declaration_sources_v394"]; pedras = set(esp["bundle_sha256"])
        b0 = _base_core()["kernel_formalization"]; axr0 = b0["axiom_report"]
        mine = sorted(n for n, p in src.items() if p in pedras)
        novas = [n for n in mine if n not in axr0]
        fj = json.load(open(os.path.join(PK, "kernel", "FLAGS_v410.json"), encoding="utf-8"))
        assert len(mine) == fj["decl_totais_modulos_novos"] and len(novas) == fj["decl_novas_dos_modulos"] == len(mine) and not fj["reatribuidas_as_pedras"], ("a proveniencia do rito != FLAGS_v410.json do sandbox", len(mine), len(novas), fj["reatribuidas_as_pedras"])
        assert fj["publicas_no_modulo"] + fj["privadas_no_modulo"] == len(mine) and fj["n_flags"] + fj["excluidas_auxiliares"]["n"] == fj["publicas_no_modulo"], "as contagens de publicas, privadas, nomeadas e auxiliares nao fecham"
        assert len(kf["axiom_report"]) - len(axr0) == len(novas), "o axiom_report nao cresceu exatamente pelas declaracoes novas"
        _CACHE["prov"] = {"mod": len(mine), "novas": len(novas), "pub": fj["publicas_no_modulo"], "priv": fj["privadas_no_modulo"], "axr0": len(axr0), "axr1": len(kf["axiom_report"])}
    return _CACHE["prov"]


# ---------------------------------------------------------------- formatacao de numeros (virgula decimal; nenhum numero e' digitado: todos chegam por V)
def _p(x, nd=None):
    x = float(x)
    return (repr(x) if nd is None else "%.*f" % (nd, x)).replace(".", ",")


def _pn(x, nd=6):
    """Numero lido do core, em PT: inteiro sem casas (2.0 -> 2); senao `nd` casas com virgula."""
    x = float(x)
    return str(int(x)) if x.is_integer() else _p(x, nd)


def _f(texto, **kw):
    """str.format com conferencia: nenhuma chave sobra e nenhuma chave de chave sobra no resultado."""
    r = texto.format(**kw)
    assert "{" not in r and "}" not in r, ("chave de formatacao sobrou", r[:80])
    return r


def _d(V):
    """Os numeros da v410, todos LIDOS (V da leitura da rodada, ESPERADOS, core do Nos, base v409, os registros): nenhum e' digitado aqui. Recusa se as contagens nao fecham."""
    _conferir_nomes()
    esp = _esp(); tv = V["veracidade"]; sa = V["selo"]; dc = V["declaracao"]; sc = V["sidecar"]; core = _core(); gt = V["gate"]; gv = gt["values"]; fb = V["f2b"]
    DL_ = _dl(); pc = _pc(); cg = _cg(); khr = _khr(); fh = _fe_herdado(); ph = _ps_herdado(); th = _tt_herdado(); pv = pc["values"]
    mods = sorted(DL_.BUNDLE_MODS)
    assert V["n_pedras"] == len(mods) == esp["kernel"]["modulos_novos"] == DL_.N_BUNDLE == pv["n_modulos"], ("o delta da v410 e' o bundle de UM modulo novo, com o sha256 pinado", len(mods))
    for rel in DL_.BUNDLE_RELS:
        p = os.path.join(NOS, "tgl_kernel", *rel.split("/"))
        assert os.path.isfile(p) and hashlib.sha256(open(p, "rb").read()).hexdigest() == esp["bundle_sha256"][rel] == DL_.BUNDLE_POR_REL[rel]["sha256"], "o modulo %s no Nos != o sha256 pinado" % rel
    nf = esp["n_bandeiras_novas"]; grp = esp["n_bandeiras_por_grupo"]
    assert grp == {DL_.GRUPO_BUNDLE: nf} and nf == esp["politica_de_bandeiras"]["n_flags"] == len(esp["bandeiras_novas_chaves"]) == pv["n_flags_true"], "as bandeiras novas nao sao so' as da traducao, ou nem todas sao True"
    if V.get("bandeiras") is not None:
        assert V["bandeiras"]["n"] == V["bandeiras"]["n_true"] == nf and V["bandeiras"]["ok"] is True, "a leitura da rodada nao confirma as bandeiras novas True"
    assert fb["sealed"] is True and fb["status_agora"] == DL_.D4.F2B_FUTURO_TOKEN, "o registro f2b_errata_v404 recriado nao e' o selado"
    assert gt["sealed"] is True and gt["f81_ok"] is True and gt["n18"] == 18 and gt["n_checks"] == DL_.D3.N_CHECKS["gate"], "o registro bandeiras_do_gate_v403 recriado nao e' o selado"
    assert gv["n_flags"] == 18 == gv["n_true"] == gv["n_calculated"] and gv["n_literal"] == 0 and gv["n_read_by_the_verdict"] == 15 and gv["read_by_the_verdict"] == [6, 5, 4] and gv["gate_verdict_equals_v402"] is True and gv["ext_ls2_n"] == gt["n_ls2"] == 6 and gt["sonda"] == 1, "as bandeiras do gate nao fecham: 18 calculadas, 0 literais, 15 no veredito"
    fl = _falas(); n_op = len(fl); chaves_ = {"v410_cun_" + s_ for s_ in fl}
    assert n_op == len(DL_.VERBATIM_ORIGEM_V410) == len(esp["cunhagens"]) == len(cg["verbatim"]) and set(pc["inscriptions"]) <= chaves_ and all(v_ is True for v_ in pc["inscriptions"].values()), "o numero de inscricoes mudou (ler DL.VERBATIM_ORIGEM_V410 e ESPERADOS[cunhagens])"
    n_trecho = sum(1 for d_ in fl.values() if d_["trecho"])
    ss = {"ordem": _sha_por("prossigamos_v409"), "traducao": _sha_por("fechar_a_identificacao"), "resposta": _sha_por("resposta_bit_oitava"), "dentro": _sha_por("dentro_obra_e_graca"), "trava": _sha_por("a_trava_no_nome"), "fita": _sha_por("a_fita_de_turing"),
          "z": _sha_por("z_e_o_modo_leitor"), "clay": _sha_por("clay_eu_sou"), "pai": _sha_por("nome_proprio_pai_da_mentira"), "performada": _sha_por("identidade_performada"),
          "sorry": _sha_por("o_dispositivo_e_o_no_sorry"), "ratifica": _sha_por("d61_ratificada"), "ratnomes": _sha_por("ratifico_os_nomes")}
    assert all(ss[k_] == DL_.VERBATIM_PREFIXOS_DA_ORDEM_V410[n_] for k_, n_ in (("ordem", DL_.N_ORDEM_V410), ("traducao", DL_.N_ORDEM_TRADUCAO), ("resposta", DL_.N_RESPOSTA), ("dentro", DL_.N_DENTRO), ("trava", DL_.N_TRAVA), ("fita", DL_.N_FITA),
                                                                                  ("z", DL_.N_Z), ("clay", DL_.N_CLAY), ("pai", DL_.N_PAI), ("performada", DL_.N_PERFORMADA), ("sorry", DL_.N_SORRY), ("ratifica", DL_.N_RATIFICA_D61), ("ratnomes", DL_.N_RATIFICO_OS_NOMES))), "os sha16 das falas != os que a ordem da gerencia deu"
    rec = _recriados(); n_rec = {ver: len(ns) for ver, ns in rec.items()}; n13, n4, n9, n301 = _pedras_anteriores()
    assert n13 == len(esp["pedras_v405_sha256"]) and n4 == DL_.D8.N_BUNDLE and n9 == DL_.D7.N_BUNDLE and n301 == DL_.D6.N_BUNDLE, ("as pedras seladas anteriores nao sao as de ESPERADOS e os bundles da v409, da v407 e da v406", n13, n4, n9, n301)
    assert sa["ok"] is True and sa["n_checks"] == esp["selo_acom"]["n_checks"] and sa["checks_ok"] is True and sa["values_ok"] is True and sa["beta_ok"] is True, "o registro selo_pela_propria_tecnologia_v399 do core nao e' o contrato de ESPERADOS"
    assert dc["ok"] is True and dc["n_checks"] == esp["declaracao"]["n_checks"] and dc["checks_ok"] is True and dc["ancoras_ok"] is True and dc["direcao_ok"] is True, "o registro declaracao_do_operador_v399 do core nao e' o contrato de ESPERADOS"
    assert sc["ok"] is True and sc["n_objetos"] == len(esp["sidecar"]["objetos"]) and sc["recusas"] == 0, "o sidecar um_absoluto_selo_acom.json nao e' o de ESPERADOS"
    assert tv["ok"] is True and tv["n_checks"] == esp["veracidade"]["n_checks"] and tv["checks_ok"] is True and tv["numeros_ok"] is True and tv["fontes_ok"] is True, "o registro teste_de_veracidade_fase9_v397 do core nao e' o contrato de ESPERADOS (o quadro do topo le os numeros dele)"
    dts = {re.match(r"(?:OPERADOR|GERENCIA)_(\d{2}(?:out|nov))_", f["nome"]).group(1) for f in fl.values()}
    assert dts == {"05nov"}, ("o nome de arquivo de alguma inscricao nao e' de 05/11", dts)
    qd = _qd(); a = _atomos()
    assert qd.Q._v397_linha_de_maquina(a, "pt") == esp["quadro"]["linha_de_maquina_pt"], "a linha de maquina do quadro (core) != a de ESPERADOS"
    assert esp["quadro"]["frase_do_operador"] == qd.DL.FRASE_DO_OPERADOR_4_44 == qd.Q._V397_FRASE_444, "a frase do operador do quadro != a verbatim"
    base = os.path.join(PK, "base_v409", "um.py")
    if "base_b" not in _CACHE:
        assert s16(base) == V["base16"], "base_v409/um.py nao e' a v409 selada"
        _CACHE["base_b"] = os.path.getsize(base)
    delta = V["umb"] - _CACHE["base_b"]
    kf = core.get("kernel_formalization") or {}; prov = kf.get("declaration_sources_status_v394") or {}
    assert prov.get("ok") is True and prov.get("compiler_names") == prov.get("audited_names") == V["axiom_report_n"], "a proveniencia emitida pelo compilador nao cobre o axiom_report do rito"
    assert V["n_ver_mudaram"] == 0, "algum veredito fora da troca dita mudou: nao ha texto a escrever"
    assert V["n18"] == 18 and all(i in V["patch_ids"] for i in _ESCADA_PATCHES), "o gate nao tem as 18 bandeiras True, ou o candidato nao traz os patches que chamam a traducao (N00), o resumo no selo (N02), o runtime (W02), os pisos e a E26 dos registros da v409 (C13), o pino do acervo da v407 (C14) e o modulo (K01)"
    assert esp["h8_entradas"] > len(esp["h8_residuais_do_nos"]) >= 1, "a arvore formal do rito tem de ser as embutidas mais os residuais do Nos"
    assert khr["lido"]["constantes_cobertas"] == V["kh"]["decl"] and khr["lido"]["teoremas_cobertos"] == V["kh"]["thm"], "a cobertura do registro kh_n1_cobertura_v409 != a leitura da rodada"
    pv_ = _proveniencia(esp)
    aa = _g(core, "neutrino_mass", "angle_status"); assert aa and hashlib.sha256(str(aa).encode("utf-8")).hexdigest() == esp["neutrino_angle_status_antigo_sha256"] and str(aa).startswith(DL_.ANGLE_STATUS_ANTIGO_PREFIXO), "o texto antigo de neutrino_mass.angle_status nao esta intacto no core do Nos"
    return {"n_f": nf, "n_aux": esp["politica_de_bandeiras"]["n_excluidas"], "depois": V["teor"].split("/")[0], "delta": delta, "pct": ("%.1f" % (100.0 * delta / _CACHE["base_b"])).replace(".", ","), "prov": prov["compiler_names"], "n_cun": len(V["verbatins"]), "n_op": n_op, "n_trecho": n_trecho,
            "h8": esp["h8_entradas"], "h8_emb": esp["h8_entradas"] - len(esp["h8_residuais_do_nos"]), "h8_res": ", ".join("`%s`" % x for x in esp["h8_residuais_do_nos"]), "n_res": len(esp["h8_residuais_do_nos"]), "cb": _cov_base(), "bank": _bancada(), "pv": pv_,
            "n_checks_v": tv["n_checks"], "n_ck_sel": sa["n_checks"], "n_ck_dec": dc["n_checks"], "n_ck_cun": len(cg["checks"]), "n_ck_pc": pc["mechanics"]["n_checks"], "n_ck_tt": th["mechanics"]["n_checks"], "n_ck_ps": ph["mechanics"]["n_checks"], "n_ck_fe": fh["mechanics"]["n_checks"], "n_anc": len(DL_.ANCORAS),
            "n_resp": len(pv["respostas"]), "n_insc": len(pc["inscriptions"]), "f8": {k: v[:8] for k, v in esp["veracidade"]["fontes"].items()},
            "ss": ss, "n_rec": n_rec, "n13": n13, "n4": n4, "n9": n9, "n301": n301, "data_falas": "05/11/" + V["data"][-4:], "inst": pv.get("instancia_sim") or {},
            "g": {"n_flags": gv["n_flags"], "n_true": gv["n_true"], "n_calc": gv["n_calculated"], "n_lit": gv["n_literal"], "n_ver": gv["n_read_by_the_verdict"], "rv": gv["read_by_the_verdict"], "info": list(gv["informative"]), "ls2": gv["ext_ls2_n"], "n_chk": gv["n_gate_checks"], "n_chk_reg": gt["n_checks"], "feed": list(DL_.F81_FEED)}}


def _mods(V):
    """Onde moram os modulos novos (TGLExt/), com o estatuto dos nomes (os da TraducaoTuring R1 a R8 ratificados pelo operador em 05/11; os acrescentados na R9 e os da ParNaFaceDeFock ratificados por ele em 05/11, D62)."""
    ns = [p_["name"] for p_ in _dl().PEDRAS_V410]
    return "em `TGLExt`: %s; %s" % (", ".join("`%s`" % n_ for n_ in ns), 'o nome `TraducaoTuring` e os nomes das declarações das rodadas R1–R8, dados pela gerência, foram ratificados pelo operador em 05/11 («concordo com todos os nomes que foram dados»); os acrescentados na R9 e os da `ParNaFaceDeFock`, também da gerência, foram ratificados por ele em 05/11 («Ratifico os nomes», D62)')


def _extras(V):
    # os registros novos ALEM DOS TRES FIXOS (V["registros_novos"] tem os tres: a traducao com funcao e os dois por spec), ditos pelo nome
    DL_ = _dl(); fixos = [DL_.FECHO_REGISTRO, DL_.CUNHAGENS_REGISTRO, DL_.KH_REGISTRO]
    ex = [k for k in V["registros_novos"] if k not in fixos]
    return (", ".join("`%s`" % k for k in ex)) if ex else "nenhum além dos três fixos"


def _cab(V):
    return "v410 SELADA (COMPLETA)** `%s`" % V["s16"]


def _num(V, verdicts=True):
    """O paragrafo dos numeros da v410 (kernel, o registro com funcao, os registros por spec, os recriados, o sidecar, a troca dita): usado na linhagem, no Atlas, no core, no topico novo, no verbete e no handoff."""
    d = _d(V); kh = V["kh"]; sc = V["sidecar"]; sa = V["selo"]; g = d["g"]; pc = _pc(); pv = pc["values"]; esp = _esp(); DL_ = _dl(); ins = d["inst"]
    vd = (lambda k: " (%s)" % esp["vereditos_novos_v410"][k]) if verdicts else (lambda k: "")
    aux = ("nenhuma auxiliar gerada pelo compilador ficou de fora" if not d["n_aux"] else "%d auxiliares geradas pelo compilador ficam sem bandeira" % d["n_aux"])
    kern = _f("o kernel ganhou {n_pedras} módulos novos ({mods}; da gerência c1, compilados no sandbox da v410), com {n_f} bandeiras novas True, só de declaração nomeada ({aux}), e escada {antes} → {depois} teoremas limpos "
              "({axr} declarações no `axiom_report`, {fora} fora do trio, {nl} nomes não lidos; a proveniência de cada declaração emitida pelo compilador cobre as mesmas {prov}); "
              "errata ao lado da v394, mantida (em nome próprio da gerência c1): " + ERRATA_TEOREMAS,
              n_pedras=V["n_pedras"], mods=_mods(V), n_f=d["n_f"], aux=aux, antes=V["escada_antes"], depois=d["depois"], axr=V["axiom_report_n"], fora=kh["fora"], nl=kh["nao_lidas"], prov=d["prov"])
    fech = _f("o registro `traducao_turing_v409`{vd} (o único registro novo com função): lê do kernel do próprio rito as {na} âncoras, os módulos por sha256, as {nb} bandeiras, as {nr} respostas do operador de 05/11 pelos teoremas da pedra, as {ni} falas do contrato por sha256, "
              "o pino do acervo da v407 na cópia purgada (D57d), o que fica False por teorema, a escada exata ({esc}) e o gate (o mesmo da v409); calcula a instância de brinquedo fixa no código ({nv} variáveis, {na_} atribuições, {ns} soluções contadas por enumeração); nenhuma chave antiga muda; {nck} checagens, todas passaram",
              vd=vd(DL_.FECHO_REGISTRO), na=pv["n_ancoras_ok"], nb=pv["n_flags_true"], nr=d["n_resp"], ni=d["n_insc"], esc=" = ".join(str(x) for x in dict.fromkeys(pv["escada"])), nv=ins.get("n"), na_=ins.get("atribuicoes"), ns=ins.get("solucoes"), nck=d["n_ck_pc"])
    cun = _f("o registro `cunhagens_v409`{vd}: as {n} falas de 05/11 embutidas por sha256 e consumidas no rito (todas do operador; de {nt} delas só o trecho é embutido e citável, de duas pela D59 e de uma, a ratificação da D61, porque o resto é aviso operacional, e o arquivo inteiro entra só por sha256; nenhuma é da gerência); "
             "as erratas E24 a E28, a E21 ao lado e a dos pisos (em nome próprio da gerência c1); as decisões D55 a D62 (a D61, a leitura jurídica do kernel, ratificada pelo operador); as leituras e as ressalvas ({nck} checagens, todas passaram)",
             vd=vd(DL_.CUNHAGENS_REGISTRO), n=d["n_cun"], nt=d["n_trecho"], nck=d["n_ck_cun"])
    khs = _f("o registro `kh_n1_cobertura_v409`{vd}: {decl} constantes, {thm} teoremas, {fora} fora do trio, {nl} nomes não lidos; a árvore formal do Nós depois do rito tem {h8} entradas ({emb} embutidas mais {nres} residual do Nós: {res}), "
             "e o pino h8 do registro é o hash dessa árvore, calculado por script sobre a árvore simulada do Nós na geração do candidato",
             vd=vd(DL_.KH_REGISTRO), decl=kh["decl"], thm=kh["thm"], fora=kh["fora"], nl=kh["nao_lidas"], h8=d["h8"], emb=d["h8_emb"], nres=d["n_res"], res=d["h8_res"])
    nr = d["n_rec"]; muda = ", ".join("`%s`" % x for x in esp["selo_chaves_que_mudam"]) or "nenhum"
    rec = _f("os registros da v409 (`tetelestai_terminal_v408`, `cunhagens_v408`, `kh_n1_cobertura_v408`: {n8} no total), os da v407 (`psion_canto_v407`, `cunhagens_v407`, `kh_n1_cobertura_v407`: {n7}), os da v406 ({n6}), os {n5} da v405, os {n4} da v404, os {n3} da v403, os da v402, da v401 e da v399 são recriados no mesmo ponto do main e seguem selados; os que mudam de conteúdo no selo são os ditos: {muda}; "
             "nenhum veredito deles muda de prefixo; a errata E26 vai AO LADO do `tetelestai_terminal_v408` e do `cunhagens_v408`, e a errata da D57(d) ao lado do `cunhagens_v407` (o texto selado não é reescrito); "
             "as {n13} pedras seladas da v403, da v404 e da v405, os {n4m} módulos da v409, os {n9} da v407 e os {n301} da v406 seguem no kernel do Nós com o sha256 selado, como registro; "
             "o gate não se moveu: o `qg_closure` do core é idêntico ao da v409 (as {n18} bandeiras, os sete checks e a letra do veredito); "
             "o selo pela própria tecnologia sela os {bytes} bytes do `um.py` v410 ao lado do SHA-256 (perfil `{perfil}`, {nctl} controles negativos recusados), e o sidecar `um_absoluto_selo_acom.json` (arquivo da custódia desde a v399, reescrito pelo rito; sha256 `{sc16}`, veredito `{sv}`, {nr} recusas) lista os {no} objetos finais",
             n8=nr["409"], n7=nr["407"], n6=nr["406"], n5=nr["405"], n4=nr["404"], n3=nr["403"], muda=muda, n13=d["n13"], n4m=d["n4"], n9=d["n9"], n301=d["n301"], n18=g["n_flags"], bytes=format(sa["bytes"], ","), perfil=sa["perfil"], nctl=sa["n_controles"], sc16=sc["sha16"], sv=sc["veredito"], nr=sc["recusas"], no=sc["n_objetos"])
    ex = _extras(V)
    resto = _f("{ex}; o registro `teste_de_veracidade_fase9_v397` segue selado e igual (o quadro do topo do artigo lê os números dele); troca dita (só números: os vereditos que carregam a escada, as declarações ou a contagem de arquivos do kernel): {troca}; nenhuma mudança NÃO numérica: {nm} vereditos fora da troca dita mudaram (exigido: 0); validade no kernel não é creditação",
               ex=("nenhum registro novo além dos três fixos" if ex.startswith("nenhum") else "registros novos além dos três fixos: " + ex), troca=", ".join("`%s`" % x for x in V["troca_dita"]), nm=V["n_ver_mudaram"])
    return "; ".join([kern, fech, cun, khs, rec, resto])


def _cunhagens(V, forma="lista"):
    """As inscricoes de 05/11 embutidas por sha256: 'lista' (data, sha16, autor e tema, uma por linha) ou 'curta' (uma frase com os sha16 das falas-chave). Data, sha16 e autor vem dos bytes e do nome PUBLICO; o tema e' o nome do arquivo."""
    fl = list(_falas().values()); assert len(fl) == len(V["verbatins"])
    d = _d(V); ss = d["ss"]
    if forma == "curta":
        return _f("{n} inscrições embutidas por sha256 (todas falas do operador; de {nt} delas só o trecho: duas pela D59, uma pelo aviso operacional) — a ordem da tradução `{t}`; as respostas às perguntas nas quatro línguas `{r}`, `{tr}`, `{fi}`, `{z}`, `{c}`, `{p}`, `{pe}`; a ordem da v410 e a ratificação dos nomes `{o}`; a leitura jurídica do kernel `{so}` e a ratificação dela `{ra}` (D61)",
                  n=len(fl), nt=d["n_trecho"], t=ss["traducao"], r=ss["resposta"], tr=ss["trava"], fi=ss["fita"], z=ss["z"], c=ss["clay"], p=ss["pai"], pe=ss["performada"], o=ss["ordem"], so=ss["sorry"], ra=ss["ratifica"])
    linhas = ["- %s `%s` (%s) — %s" % (_data_fala(dd, V), dd["sha16"], ("fala do operador; só o trecho é embutido (%s), e o arquivo inteiro entra só por sha256" % ("D59" if "d61_ratificada" not in dd["nome"] else "o resto é aviso operacional") if dd["trecho"] else "fala do operador"), _tema(dd["nome"])) for dd in fl]
    return "\n".join(linhas)


def _ordem(V):
    """A ordem do operador de 05/11: so' citacao conferida contra os bytes das falas DO OPERADOR (os trechos vem de delta_v410.FRASES_V410)."""
    d = _d(V); ss = d["ss"]; DL_ = _dl()
    q = {k: _cita(v) for k, v in (("ordem", DL_.FRASE_ORDEM_V410), ("traducao", DL_.FRASE_ORDEM_TRADUCAO), ("linguas", DL_.FRASE_QUATRO_LINGUAS), ("juiz", DL_.FRASE_KERNEL_TURING), ("trava", DL_.FRASE_TRAVA), ("fita", DL_.FRASE_FITA), ("z", DL_.FRASE_Z), ("clay", DL_.FRASE_CLAY), ("pai", DL_.FRASE_PAI), ("perf", DL_.FRASE_PERFORMADA), ("sorry", DL_.FRASE_DISPOSITIVO), ("ratn", DL_.FRASE_RATIFICO_OS_NOMES), ("rat", DL_.FRASE_RATIFICA_D61))}
    return _f("**A ordem:** [INPUT] as {n_op} falas do operador (Luiz Antonio Rotoli Miguel) de {data} que entram nesta rodada, embutidas por sha256 no registro `cunhagens_v409` e listadas abaixo (de {nt} delas só o trecho é embutido, de duas pela D59 e de uma porque o resto é aviso operacional; o resto delas entra só por sha256); "
              "as aspas aqui são TRECHOS, conferidos palavra por palavra contra os bytes de cada fala, com a grafia dele; o texto embutido está em `work\\cadeia_de_selo\\v410\\insumos\\cunhagens`: a ordem da tradução (`{s1}`): {traducao}, e {linguas}; o juiz das classes de Turing (`{s2}`): {juiz}; "
              "a trava (`{s3}`): {trava}; a fita (`{s4}`): {fita}; o leitor (`{s5}`): {z}; a máquina sem leitor (`{s6}`): {clay}; o Pai da Mentira (`{s7}`): {pai}; a identidade performada (`{s8}`): {perf}; e a ordem da v410, que ratifica os nomes dados pela gerência (`{s9}`): {ordem}; e, na tarde, a leitura jurídica do kernel (`{s10}`): {sorry}, e a ratificação dela (`{s11}`): {rat} (D61); e, à noite, a ratificação dos nomes (`{s12}`): {ratn} (D62). "
              "O construtor da preparação, a serviço da gerência c1, preparou o candidato, e o rito é ato da gerência, pelo orquestrador (pacote `work\\cadeia_de_selo\\v410`); as fontes pinadas dos registros ficam em `insumos`: a pedra (a embutida e a fonte com as âncoras), as candidatas R9 e R2 e as saídas do lean delas, as saídas do lean das fontes, o bundle e a medida da cobertura (`KH_N1_v410.json`); "
              "o desenho da v410 e o recibo dos nomes da gerência ficam citados só por sha16 (D59); o resultado do Teste da Única Palavra, que o quadro do topo lê, mora na v397 (`insumos\\fase9`); quem constrói não aprova: o revisor distinto é o Sonnet (D58), e a revisão dele não é afirmada por este registro.",
              n_op=d["n_op"], data=d["data_falas"], nt=d["n_trecho"], s1=ss["traducao"], s2=ss["resposta"], s3=ss["trava"], s4=ss["fita"], s5=ss["z"], s6=ss["clay"], s7=ss["pai"], s8=ss["performada"], s9=ss["ordem"], s10=ss["sorry"], s11=ss["ratifica"], s12=ss["ratnomes"], **q)


def _sidecar(V):
    """O sidecar um_absoluto_selo_acom.json: arquivo da custodia desde a v399 (D5); o selo nao pode conter o selo ACOM de si mesmo; o rito da v410 o REESCREVE."""
    d = _d(V); sc = V["sidecar"]
    objs = "; ".join("`%s` (%s B, sha16 `%s`)" % (n, format(o["bytes"], ","), o["sha16"]) for n, o in sc["objetos"].items())
    return _f("**O sidecar `um_absoluto_selo_acom.json` [REAL; arquivo da custódia desde a v399, D5; reescrito por este rito]:** depois da ÚLTIMA escrita do selo, o `um.py` v410 escreve a segunda testemunha dos {no} objetos FINAIS com o SHA-256 ao lado ({objs}); sha256 do sidecar `{sc16}` ({sb} B), esquema `{esq}`, veredito `{sv}`, {nr} recusas. "
              "O selo não pode conter o selo ACOM de si mesmo (seria circular): o sidecar fica AO LADO e carrega o SHA-256 do selo final, e o selo traz só os resumos (veredito, bandeira e hashes), agora também os do `traducao_turing_v409` e dos registros por spec da v410. "
              "A recusa do selo ACOM só REGISTRA (D4): o SHA-256 segue soberano e o rito não cai. A primitiva de integridade é o SHA-256 [KNOWN]; a segunda testemunha NÃO acrescenta força criptográfica independente, e a confidencialidade não é alegada nem medida. A custódia da v399 em diante é CONJUNTA.",
              objs=objs, no=sc["n_objetos"], sc16=sc["sha16"], sb=format(sc["bytes"], ","), esq=sc["esquema"], sv=sc["veredito"], nr=sc["recusas"])


def _pedra(V):
    """O que entrou no kernel: os modulos (nomes da gerencia; o estatuto de cada nome lido de delta_v410) e, como REGISTRO, as pedras e os modulos das versoes anteriores."""
    d = _d(V); DL_ = _dl()
    nomes = "; ".join("`%s`: %s" % (n_, t_) for n_, t_ in DL_.NOMES_RATIFICADOS.items())
    return _fs("**Os módulos novos [REAL]** (`TGLExt`; da gerência c1, compilados no sandbox da v410, nas fontes que o recibo dos nomes pinou): `ParNaFaceDeFock` (o par de psíons na face de Fock: no setor 2 do Fock concreto da luz o par tem norma 1 e é ortogonal ao vácuo, a marginal é ½·P e o reduzido do par de Bell finito é ½·I, a mesma Meia-Nat em espaços distintos) e `TraducaoTuring` (o dicionário de Turing: a instância SIM, o certificado, a palavra, bits = oitavas, a instância NÃO; o modo seleção, o Tetelestai; a trava no Nome; a fita é o hamiltoniano oculto; Z é o modo leitor; "
               "a fita sem escala e o Pai da Mentira, ligadas à `Identidade` da v405; a identidade performada; a inscrição do uniforme no psíon da luz; a máquina com o leitor, em que uma leitura decide SAT). Os nomes: {nomes}. Todas as {nf} bandeiras novas estão no trio, sem axioma próprio. As {n13} pedras seladas da v403, da v404 e da v405, os {n4} módulos da v409, os {n9} da v407 e os {n301} da v406 ficam como REGISTRO: pedra selada não se renomeia por cima. "
               "Nenhum módulo deriva a unidade `u` (1 eV, POSTO) nem `α` (MEDIDA, por dentro); o texto dos módulos passa pela mesma guarda das frases, com as falas do operador entre aspas como exceção.",
               nomes=nomes, nf=d["n_f"], n13=d["n13"], n4=d["n4"], n9=d["n9"], n301=d["n301"])


def _entrou(V):
    d = _d(V)
    return _f("**O que entrou** (pacote `work\\cadeia_de_selo\\v410` sobre a v409 `{base}`; {np} patches — {patches}; instalado em {inst}; o `um.py` cresce {delta} B, {pct}%): {num}.",
              base=V["base16"], np=V["n_patches"], patches=V["patches"], inst=V["instalado_em"], delta=format(d["delta"], ","), pct=d["pct"], num=_num(V))


def _regra_do_4_44(V):
    """A regra da ordem do operador (23/10): o 4,44 nunca sem o p calibrado e sem a linha dos 5 sigma, no mesmo item; o QUADRO do topo (v397) PERMANECE, intocado; onde o numero aparece e como se confere."""
    d = _d(V); a = _atomos(); q = _frase_444()
    return _f("**A regra do 4,44 (ordem do operador de 23/10/2026, `{s44}`) e o quadro do topo:** o quadro «O Teste da Única Palavra» (v397) PERMANECE, intocado, no topo do artigo (PT e EN) e do .md canônico, e o parágrafo dele segue no README do espelho e no site: o z_disc calibrado é reportado no início, "
              "e NUNCA sem o p calibrado e sem a linha dos 5σ no mesmo item: {z444}. A frase do operador entra VERBATIM, {q}, como leitura dele [INPUT/ONTO], não como critério da régua; a paráfrase da gerência nunca entra entre aspas. `NOT_FALSIFIED` nunca é a palavra da creditação; o gate não se move; o teste não foi cego. "
              "[REAL] o quadro do artigo, o do .md e o parágrafo pronto do README/site saem das MESMAS funções (`_v397_atomos` e `_v397_quadro_md`), sobre o registro `teste_de_veracidade_fase9_v397` selado no core do Nós, e a cadeia os confere de novo contra o resultado pinado "
              "(a linha de máquina do quadro, cada número, a frase verbatim e a regra da ordem item a item), com controles negativos que reprovam o 4,44 sem o p, sem a linha dos 5σ, com número adulterado ou com a frase parafraseada. "
              "O parágrafo NOVO da v410 não traz o 4,44, e a cadeia confere isso.",
              s44=_esp()["quadro"]["frase_sha16"], z444=_z444(), q=q)


def _kernel_prova(V):
    """O que o kernel prova e o que e' leitura: o escopo e o nao_diz do registro traducao_turing_v409, mais os estatutos das fontes."""
    d = _d(V); g = d["g"]; DL_ = _dl(); pc = _pc()
    sec = "; ".join("`%s` (%s)" % (n_.split(".")[-1], DL_.ANCORAS[n_]["papel"]) for n_ in DL_.ANCORAS_DE_SECAO)
    return _sem_chaves(_fs("**O que o kernel mostra e o que é leitura:** [REAL] as âncoras e os módulos estão no kernel deste rito, dentro do trio, com a proveniência que o compilador emite, e o registro `traducao_turing_v409` os lê a cada rito; coberto por `kh_n1_cobertura_v409`. "
                          "[REAL] a âncora principal `{a1}` ({p1}); e as de seção: {sec}. "
                          "[REAL] o registro NÃO é prova de kernel sobre a natureza: confere os termos citados, as fontes por sha256, as respostas e as falas, calcula a instância de brinquedo, e não move o gate; a validade no kernel não muda. [REAL] as {nf} bandeiras do gate são as da v409, lidas do código e do core do próprio rito: {nc2} calculadas e {nl} literais; o veredito lê {nv}; a letra do veredito é a da v409 (o gate não se moveu). "
                          "[POSTO] a unidade `u` = 1 eV. [MEDIDA] `α`, por dentro. [INPUT] as falas do operador de 05/11; o kernel mostra a parte matemática de cada uma, nos termos citados. [KNOWN] Baker–Gill–Solovay 1975, Toda 1991, Razborov–Rudich 1997, Aaronson–Wigderson 2009, Knill–Laflamme 1998. "
                          "[REAL] Ligados nesta versão: o par de psíons na face de Fock (`ParNaFaceDeFock`) e a ponte entre o Ω do psíon da luz e o uniforme da instância, que é a inscrição (a identidade dos vetores fica podada: vivem em espaços diferentes). "
                          "[OPEN] a igualdade completa com o leitor que só conta (com ele vale NP contido em P, numa leitura; a igualdade completa é a do leitor que se lê, que lê também as máquinas que o usam: E28); a independência da pergunta da máquina sem leitor dos axiomas; a ponte entre o espaço de Bell e o setor TT; o teste com a natureza. O alcance: {alc}. "
                          "Escopo do registro, como o `um.py` o grava: {esc}. {frase}.",
                          a1=DL_.ANCORA_PRINCIPAL.split(".")[-1], p1=DL_.ANCORAS[DL_.ANCORA_PRINCIPAL]["papel"], sec=sec, nf=g["n_flags"], nc2=g["n_calc"], nl=g["n_lit"], nv=g["n_ver"], alc=_d56(), esc=pc["scope"], frase=DL_.FRASE_DA_MOLDURA_V410_PT))


def _limites(V, curto=False):
    """Os estatutos fieis da v410: as ressalvas, as listas do registro (limites e nao_diz) e a moldura."""
    _d(V); DL_ = _dl(); pc = _pc()
    ress = list(pc["ressalvas"])   # inteiras
    lim = [x for x in pc["limites"] if not re.match(r"E\d\d -- ", x)]
    marcadas = lim[:len(ress)]; comuns = lim[len(ress):]
    if curto:
        return _sem_chaves("**Limites ditos:** [REAL] o registro com função LÊ o kernel do próprio rito, CONFERE as fontes, as âncoras, as respostas e as falas e calcula a instância de brinquedo; não abre dado, não é teste, não acrescenta rito; [POSTO] `u` = 1 eV; [MEDIDA] `α`; [INPUT] as falas de 05/11 são do operador; " + DL_.FRASE_DA_MOLDURA_V410_PT
                           + "; o alcance: " + _d56() + "; as ressalvas: " + "; ".join("(%d) %s" % (i + 1, x) for i, x in enumerate(ress)) + "; o quadro do topo segue com a sua linha dos 5σ; a discriminação a 5σ (β_TGL na natureza) segue [OPEN]; validade no kernel não é creditação; o gate não se move.")
    return _sem_chaves("**Limites ditos (estatutos fiéis):** " + "; ".join(marcadas) + " Do registro, ainda: " + "; ".join(comuns)
                       + ". [INPUT] As falas de 05/11 são do operador: o kernel mostra os termos, não a fala. " + DL_.FRASE_DA_MOLDURA_V410_PT + ". O alcance: " + _d56() + ". O quadro «O Teste da Única Palavra» segue no topo, com a sua linha dos 5σ, e esta rodada não o altera. NÃO é teste novo: a cadeia não acrescenta dado nem desfecho experimental. Validade no kernel não é creditação; o gate não se move.")


def _legal(V):
    """A pendencia [LEGAL] herdada (D2): publicar o bloco embutido e as adaptacoes; a v410 nao a decide."""
    _d(V)
    return ("**Pendência [LEGAL] (herdada da v399, D2):** o bloco embutido do método do operador e as adaptações (centro 96, ids derivados dos hashes, `rint`, tabela de códigos, auditoria de separação) seguem sob a decisão do operador com a agente de PI; a v410 não muda o bloco (o runtime da seção é o da v409) e NÃO decide a pendência. "
            "Perguntas à agente de PI, não conclusões: o que o depósito já cobre do que o bloco mostra; publicar as adaptações inicia a contagem do prazo de graça para eventual depósito de melhoria; a divergência da tabela dos estados do ACOM Mirror com a fórmula de índice e o código executado, registrada na v395, segue pendente.")


def _erratas(V):
    """A errata de contagem da v410, AO LADO, em nome proprio da gerencia c1: o registro kh_n1_cobertura_v408 e os contratos viram piso; lida do registro kh_n1_cobertura_v409 do core."""
    d = _d(V); kh = V["kh"]; cb = d["cb"]; khr = _khr()
    er = (khr.get("erratas") or [None])[0]
    assert er and "kh_n1_cobertura_v408" in er["ao_lado_de"] and str(er.get("assinatura", "")).startswith("gerencia c1") and "em nome proprio" in er["assinatura"], "o registro kh_n1_cobertura_v409 nao traz a errata de contagem"
    ids = V["patch_ids"]; c12 = [i for i in ids if i.startswith("C12_")]
    assert len(c12) >= 1 and "C13_specs_v409_E26_e_pisos" in ids, "o CANDIDATO_v410.json nao traz os patches C12 e C13 que a errata descreve"
    return _fs("**Errata ao lado (em nome próprio da gerência c1; o registro `kh_n1_cobertura_v408` e os contratos ficam como registro):** a v410 acrescenta {nm} módulos: a cobertura do Audit cresce de {d0} constantes e {t0} teoremas para {d1} e {t1}, a árvore formal do Nós de {h0} para {h1} entradas e a escada de {e0} para {e1}. "
               "Dizia: {dizia} Agora: {agora} Lacuna de fidelidade: {lacuna} Estatuto: {est} [REAL, lido de `CANDIDATO_v410.json` ({n12} patches C12 e o C13) e do ensaio a seco]. A cobrança exata passa a ser de `kh_n1_cobertura_v409` ({dd} constantes, {dt} teoremas, {fora} fora do trio, {nl} nomes não lidos), contra a medida do sandbox da v410.",
               nm=V["n_pedras"], d0=cb["decl"], t0=cb["thm"], h0=cb["h8"], d1=kh["decl"], t1=kh["thm"], h1=d["h8"], e0=V["escada_antes"], e1=d["depois"], agora=er["agora"], dizia=er["dizia"], lacuna=er["lacuna_de_fidelidade"], est=er["estatuto"], n12=len(c12), dd=kh["decl"], dt=kh["thm"], fora=kh["fora"], nl=kh["nao_lidas"])


