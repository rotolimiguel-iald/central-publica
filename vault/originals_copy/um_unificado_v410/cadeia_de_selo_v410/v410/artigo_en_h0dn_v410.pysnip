    _cf410 = _rf410.get("campos") or {}
    s.append((r"\textbf{In this run the documentary HMS/13 receipt did NOT seal: what follows is the statement, not a seal.} " if _rf410.get("all_verified") is not True else r"")
             + r"\textbf{The documentary HMS/13 receipt (D80), additive and posterior to \texttt{FREEZE\_R2}.} \textsf{[INPUT]} The operator, 09/11/2026 (our translation): Kimi did the work and has already delivered it to you. \textsf{[REAL\_DOCUMENTAL]} The record \texttt{h0dn\_fontes\_hms13\_v410} embeds by sha256, read at build time (in the rite no file of Kimi's delivery is opened), four documentary artifacts of Kimi's independent review: "
             r"the source-and-covariance map of the " + str(_vf410.get("n_calibradores") if isinstance(_vf410.get("n_calibradores"), int) else "n/a") + r" calibrators outside R22, the manifest of the " + str(_vf410.get("n_fontes_primarias") if isinstance(_vf410.get("n_fontes_primarias"), int) else "n/a") + r" primary sources (title, URL, sha256 of the file and of the extracted text), the validation and the readable survey: "
             r"\emph{documentary source coverage, not a closed physical covariance; nothing opened}. The error factors are partial, by line of the upstream files (the SN, the host, the anchor N4258, the MAS, the group); the full HMS form is a diagnostic, not admitted (the HMS diagonal is already in the distance-modulus error and would double the variance). "
             r"The ten mandatory fields of Kimi's ORDER \textsf{[DECLARED by Kimi; ratified by the operator by sha256]}: status \texttt{" + _th410(_cf410.get("estatuto")) + r"}; primary sources " + str(_cf410.get("fontes_primarias", "n/a")) + r"; calibrators " + str(_cf410.get("calibradores", "n/a")) + r"; \texttt{partial\_components\_only} " + _bh410(_cf410.get("partial_components_only")) + r"; \texttt{full\_13x13\_covariance\_available} " + _bh410(_cf410.get("full_13x13_covariance_available")) + r"; \texttt{within\_SN\_full\_decomposition\_available} " + _bh410(_cf410.get("within_SN_full_decomposition_available")) + r"; \texttt{physical\_covariance\_closed} " + _bh410(_cf410.get("physical_covariance_closed")) + r"; \texttt{independent\_physical\_review\_complete} " + _bh410(_cf410.get("independent_physical_review_complete")) + r"; \texttt{full\_HMS\_admitted} " + _bh410(_cf410.get("full_HMS_admitted")) + r"; \texttt{opening\_allowed} " + _bh410(_cf410.get("opening_allowed")) + r". "
