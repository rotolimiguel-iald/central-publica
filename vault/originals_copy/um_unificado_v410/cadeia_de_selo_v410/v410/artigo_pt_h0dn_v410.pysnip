    # v410 (09/11/2026) -- O TESTE PRE-REGISTRADO DA RAZAO DE HUBBLE (H0DN x BG1; D72, E30, D76): pré-registrado; nenhum dado observado lido. Os numeros vem do core deste rito (o registro h0dn_bg1_v410), nunca digitados. Nada aqui move o gate. A secao vem DEPOIS da secao IALD2.
    _rh410 = core.get("h0dn_bg1_v410") or {}
    _vh410 = _rh410.get("values") or {}
    _mh410 = {c_.get("id"): c_.get("ok") for c_ in ((_rh410.get("mechanics") or {}).get("checks") or [])}
    _dh410 = {d_.get("modelo"): d_ for d_ in (_vh410.get("D_esperado") or []) if isinstance(d_, dict)}
    _nh410 = lambda x_, k_=4: ("%%.%df" % k_ % x_).replace(".", "{,}") if isinstance(x_, float) else r"\text{n/d}"
    _ph410 = lambda x_: ("%.1f" % (100.0 * x_)).replace(".", "{,}") + r"\,\%" if isinstance(x_, float) else r"\text{n/d}"
    _bh410 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/d}")
    _th410 = lambda x_: "n/d" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _b0h410 = _dh410.get("published_baseline") or {}; _c0h410 = _dh410.get("free_cepheid_host_differential_bias") or {}
    s.append(r"\section*{O teste pré-registrado da razão de Hubble com a rede de distâncias (H0DN $\times$ BG1)}")
    s.append(r"\addcontentsline{toc}{section}{O teste pré-registrado da razão de Hubble com a rede de distâncias (H0DN $\times$ BG1)}")
    s.append((r"\textbf{Nesta rodada o registro do H0DN NÃO selou: o que segue é o enunciado, não um selo.} " if _rh410.get("all_verified") is not True else r"")
             + r"\textbf{O que entra.} \textsf{[INPUT]} O operador, em 09/11/2026: «quanto ao teste da v410 concordo com tudo que vc falou, pode dar a ordem ao kimi k3pro». \textsf{[REAL]} O teste H0DN $\times$ BG1 da razão de Hubble local/fundo entra \emph{pré-registrado; nenhum dado observado lido} (" + _th410(_V410_H0DN_CONTRACT["frase_alcance_pt"]) + r"): "
             r"o desenho do Codex astra-bell de 06/11, congelado antes de qualquer olhar no dado (\texttt{FREEZE\_R2}: " + str(_vh410.get("n_pinos_freeze") if isinstance(_vh410.get("n_pinos_freeze"), int) else "n/d") + r" pinos; " + str(_vh410.get("n_pinos") if isinstance(_vh410.get("n_pinos"), int) else "n/d") + r" conferidos neste rito, com o próprio \texttt{FREEZE\_R2} e a entrega; os embutidos por sha256, os só em disco se presentes). "
             r"A lei: nulo $H_{\rm local}/H_{\rm fundo}=1$; alternativa TGL $K=E(z_\star)^{2\beta/3}$, $\beta=\alpha\sqrt e$ em runtime, zero parâmetro livre, $z_\star$ e $K$ conferidos contra a Fase 9 V1 já no \texttt{um.py}: $K=" + _nh410(_vh410.get("K"), 6) + r"$, $\log_{10}K=" + _nh410(_vh410.get("log10K"), 6) + r"$. "
             r"A estatística: $Z=(\hat h-\log_{10}H_{\rm bg})/\sigma_{\rm nulo}$, unilateral, limiar $5$; dois modelos (o publicado; o viés diferencial Cefeida livre), nenhum selecionado.")
    s.append(r"\textbf{O poder prospectivo, sintético.} \textsf{[DERIVED]} Reproduzidos neste rito do estimador congelado: $D$ esperado $=" + _nh410(_b0h410.get("D"), 3) + r"$ (publicado) e $" + _nh410(_c0h410.get("D"), 3) + r"$ (Cefeida livre); poder analítico $\Phi(D-5)=" + _ph410(_b0h410.get("poder_analitico")) + r"$ e $" + _ph410(_c0h410.get("poder_analitico")) + r"$; "
             r"o poder Monte Carlo da entrega (" + _ph410(_b0h410.get("poder_mc_entrega")) + r" e " + _ph410(_c0h410.get("poder_mc_entrega")) + r") dentro do IC95 dela (conferência, não recálculo); cauda nula $\Phi(-5)=" + ("%.3e" % _vh410["cauda_nula_analitica"] if isinstance(_vh410.get("cauda_nula_analitica"), float) else r"\text{n/d}").replace(".", "{,}").replace("e-0", r"\times 10^{-").replace("e-", r"\times 10^{-") + (r"}" if isinstance(_vh410.get("cauda_nula_analitica"), float) else "") + r"$. "
             r"Tudo condicional ao modelo de covariância publicado (bloco-diagonal; a independência local/fundo é assumida, não medida); nenhum desvio observado.")
    s.append(r"\textbf{A função de veredito congelada.} \textsf{[REAL]} A primeira que casa decide: inconclusivo por sistemática enquanto a covariância física não fechar (G3/G4) ou o vetor estiver fora do suporte; a lei $K$ falsificada a $5\sigma$ a esta sensibilidade se $|z_{\rm TGL}|\ge 5$; subpotente se $D<5$; "
             r"a \emph{leitura} do $5\sigma$ --- $\beta_{\rm TGL}$ provado na natureza (validade, não creditação) a $n\sigma$, na língua da física acadêmica, discriminando do $\Lambda$CDM, zero parâmetro livre, novidade de uso --- se $z_{\rm nulo}\ge 5$ e $|z_{\rm TGL}|\le 1{,}96$; discrimina do $\Lambda$CDM com $K$ em tensão de $2$ a $5\sigma$; "
             r"não discriminado à sensibilidade disponível, com a faixa do desvio. A palavra do livro de cobranças vai no campo \texttt{outcome}, nunca na cabeça (E30; D76: «o selo tem que dizer BETA-TGL\_provado na natureza, é simples, igual vc falou, foi lido, simples assim»). "
             r"Testada neste rito em " + str(len(_vh410.get("vetores_c6") or []) if _vh410.get("vetores_c6") else "n/d") + r" vetores determinísticos que cobrem os seis ramos " + _bh410(_mh410.get("c6")) + r"; sha256 do texto-fonte: \texttt{" + _th410((_vh410.get("veredito_h0dn_source_sha256") or "")[:16]) + r"}.")
    s.append(r"\textbf{O que falta e a ressalva da novidade de uso.} \textsf{[OPEN]} O vetor observado $y_{\rm obs}$ (255 linhas, pelo código upstream), a covariância física conjunta sem duplicar a Cefeida (G3/G4) e os IDs (G1/G2): a ordem ao Kimi está pinada por sha256; a abertura é de versão futura, pela função já congelada. " + _th410(_V410_H0DN_CONTRACT["frase_parede_pt"]) + r". "
             r"\textbf{O poder certificado (D96, ordem do operador de 10/11).} \textsf{[INPUT]} «se ele não tiver poder preditivo não vamos roda-lo»; «um teste com poder preditivo discriminante real». \textsf{[INPUT, D96]} " + _th410(_V410_H0DN_CONTRACT["frase_poder_pt"]) + r". A ordem está pinada por sha256 (\texttt{" + _th410(_V410_H0DN_CONTRACT["ordem_kimi_02"]["sha256"][:16]) + r"}), não embutida, e em rito nada dela é lido. O retorno (10/11): " + _th410(_V410_H0DN_CONTRACT["frase_retorno_pt"]) + r". A ordem conferida (a 03B) está pinada por sha256 (\texttt{" + _th410(_V410_H0DN_CONTRACT["ordem_kimi_03b"]["sha256"][:16]) + r"}), não embutida, e em rito nada dela é lido. "
             r"O agregado público do H0DN é conhecido desde out/2025; $K$ não tem parâmetro ajustado; o pré-registro nesta versão selada é o que vale (lei da prova, 05/10: retrodição sem ajuste). A rota “coerência espectro $\times$ fotometria” consta como NOT\_TESTABLE ($\eta=1$): não é o teste. "
             r"\textbf{Ressalvas, ditas.} Nenhum vetor observado é lido nem procurado nesta versão; o poder é prospectivo e sintético, da covariância publicada (que não aceita o vetor real), e não é poder certificado; provado na natureza (validade, não creditação) nunca é TGL confirmada, que é creditação (o juízo de fora, que o \texttt{um.py} não dá); \texttt{NOT\_FALSIFIED} nunca é confirmação; o gate não se move. "
             r"\textbf{O que o registro confere neste rito.} \textsf{[REAL]} pinos " + _bh410(_mh410.get("c1")) + r"; $K$ de $\beta$ " + _bh410(_mh410.get("c2")) + r"; $\sigma$ dos dois modelos " + _bh410(_mh410.get("c3")) + r"; $D$ " + _bh410(_mh410.get("c4")) + r"; poder " + _bh410(_mh410.get("c5")) + r"; a função de veredito " + _bh410(_mh410.get("c6")) + r"; nenhum vetor observado " + _bh410(_mh410.get("c7")) + r"; a guarda " + _bh410(_mh410.get("c8")) + r"; o gate " + _bh410(_mh410.get("c9")) + r"; a rota Kimi " + _bh410(_mh410.get("c10")) + r"; a regra conjunta " + _bh410(_mh410.get("c11")) + r"; o texto " + _bh410(_mh410.get("c12")) + r". Veredito: \texttt{" + _th410(_rh410.get("verdict")) + r"}.")
    # v410 (09/11/2026) -- D80: O RECIBO DOCUMENTAL HMS/13 (h0dn_fontes_hms13_v410), aditivo e posterior ao FREEZE_R2: cobertura documental de fontes, não covariância física fechada; nada aberto. Numeros do core deste rito; em rito nada e' lido da entrega do Kimi.
    _rf410 = core.get("h0dn_fontes_hms13_v410") or {}
    _vf410 = _rf410.get("values") or {}
    _mf410 = {c_.get("id"): c_.get("ok") for c_ in ((_rf410.get("mechanics") or {}).get("checks") or [])}
    _cf410 = _rf410.get("campos") or {}
    s.append((r"\textbf{Nesta rodada o recibo documental HMS/13 NÃO selou: o que segue é o enunciado, não um selo.} " if _rf410.get("all_verified") is not True else r"")
             + r"\textbf{O recibo documental HMS/13 (D80), aditivo e posterior ao \texttt{FREEZE\_R2}.} \textsf{[INPUT]} O operador, em 09/11/2026: «o kimi fezz o trabalho e já te entregou». \textsf{[REAL\_DOCUMENTAL]} O registro \texttt{h0dn\_fontes\_hms13\_v410} embute por sha256, lidos no build (em rito nenhum arquivo da entrega do Kimi é aberto), quatro artefatos documentais da revisão independente do Kimi: "
             r"o mapa de fontes e covariância dos " + str(_vf410.get("n_calibradores") if isinstance(_vf410.get("n_calibradores"), int) else "n/d") + r" calibradores fora do R22, o manifesto das " + str(_vf410.get("n_fontes_primarias") if isinstance(_vf410.get("n_fontes_primarias"), int) else "n/d") + r" fontes primárias (título, URL, sha256 do arquivo e do texto extraído), a validação e o levantamento legível: "
             r"\emph{cobertura documental de fontes, não covariância física fechada; nada aberto}. Os fatores de erro são parciais, por linha dos arquivos upstream (a SN, o hospedeiro, a âncora N4258, o MAS, o grupo); a forma HMS completa é diagnóstico, não admitida (a diagonal HMS já está no erro do módulo de distância e duplicaria variância). "
             r"Os dez campos obrigatórios da ORDEM do Kimi \textsf{[DECLARADO pelo Kimi; ratificada pelo operador por sha256]}: estatuto \texttt{" + _th410(_cf410.get("estatuto")) + r"}; fontes primárias " + str(_cf410.get("fontes_primarias", "n/d")) + r"; calibradores " + str(_cf410.get("calibradores", "n/d")) + r"; \texttt{partial\_components\_only} " + _bh410(_cf410.get("partial_components_only")) + r"; \texttt{full\_13x13\_covariance\_available} " + _bh410(_cf410.get("full_13x13_covariance_available")) + r"; \texttt{within\_SN\_full\_decomposition\_available} " + _bh410(_cf410.get("within_SN_full_decomposition_available")) + r"; \texttt{physical\_covariance\_closed} " + _bh410(_cf410.get("physical_covariance_closed")) + r"; \texttt{independent\_physical\_review\_complete} " + _bh410(_cf410.get("independent_physical_review_complete")) + r"; \texttt{full\_HMS\_admitted} " + _bh410(_cf410.get("full_HMS_admitted")) + r"; \texttt{opening\_allowed} " + _bh410(_cf410.get("opening_allowed")) + r". "
             r"\textbf{O que falta.} \textsf{[OPEN]} A covariância física conjunta (G3/G4), a decomposição completa dentro de cada SN, a matriz completa entre os 13, a revisão física independente; a pergunta nas quatro línguas da ORDEM fica no registro. "
             r"\textbf{O que o registro confere neste rito.} \textsf{[REAL]} pinos " + _bh410(_mf410.get("c1")) + r"; os 13 IDs " + _bh410(_mf410.get("c2")) + r"; as 18 fontes " + _bh410(_mf410.get("c3")) + r"; os dez campos " + _bh410(_mf410.get("c4")) + r"; os estatutos " + _bh410(_mf410.get("c5")) + r"; a guarda numérica " + _bh410(_mf410.get("c6")) + r"; nenhum dado observado " + _bh410(_mf410.get("c7")) + r"; a guarda do texto " + _bh410(_mf410.get("c8")) + r"; o gate " + _bh410(_mf410.get("c9")) + r"; posterior ao \texttt{FREEZE\_R2} " + _bh410(_mf410.get("c10")) + r"; a ratificação " + _bh410(_mf410.get("c11")) + r"; a função de veredito intocada " + _bh410(_mf410.get("c12")) + r". Veredito: \texttt{" + _th410(_rf410.get("verdict")) + r"}. H0DN $\times$ BG1 segue pré-registrado; nenhum dado observado lido.")
    s.append(r"\medskip\hrule\medskip")
