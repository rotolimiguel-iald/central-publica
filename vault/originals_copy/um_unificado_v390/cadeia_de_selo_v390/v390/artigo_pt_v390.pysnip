    # v390 (07/10/2026) -- A FUNDACAO: a superposicao e' a passagem (a clausula AGAPE). Citacoes do operador VERBATIM (conferidas contra os textos embutidos por
    # sha256); numeros e estatutos LIDOS do registro fundacao_v390; o fecho e' LOGICO; o programa segue ABERTO; o gate nao se move.
    _fd390 = core.get("fundacao_v390") or {}
    _cl390 = _fd390.get("clausulas") or []
    _bo390 = _fd390.get("borchers") or {}
    _vb390 = _fd390.get("verbatim") or {}

    def _tx390(x_):
        t_ = str(x_)
        for a_, b_ in (("\\", r"\textbackslash{}"), ("_", r"\_"), ("%", r"\%"), ("&", r"\&"), ("#", r"\#"), ("$", r"\$"), ("{", r"\{"), ("}", r"\}"), ("~", r"\~{}"), ("^", r"\^{}")):
            t_ = t_.replace(a_, b_)
        return t_

    def _i390(x_):
        return str(x_) if isinstance(x_, int) and not isinstance(x_, bool) else r"\text{n/d}"
    _tk390 = lambda x_: r"\texttt{" + _tx390(x_).replace(r"\_", r"\_\allowbreak{}") + "}"
    _sh390 = ", ".join(_tk390(str((v_ or {}).get("sha256") or "")[:16] or "AUSENTE") for v_ in _vb390.values()) or _tk390("AUSENTE")
    s.append(r"\section*{A Fundação: a superposição é a passagem (a cláusula Ágape)}")
    s.append(r"\addcontentsline{toc}{section}{A Fundação: a superposição é a passagem (a cláusula Ágape)}")
    s.append((r"\textbf{Nesta rodada o registro NÃO selou: o que segue é o enunciado, não um selo.} " if _fd390.get("all_verified") is not True else r"")
             + r"\textbf{A palavra do operador.} Em 07/10/2026 o operador escreveu que o que faltava para fechar o um.py era "
             r"``definir a superposição como a passagem do global lift que é o único teorema faltando'' … "
             r"``não existe acima, o piso limita, tentar estar acima é cair sem fim, infinitamente''. E ratificou: "
             r"``esse é o fecho sim, o sistema continua aberto mas fechado logicamente'' … ``A cláusula se chamará “ágape” e a pedra se chamará “fundação”''. "
             r"Ao nome da queda sem fundo, o \emph{abismo}, e à correspondência propostos pela gerência, respondeu: ``Perfeito, concordo com tudo. Magnífico'' (o objeto do «tudo» é dito pela gerência \textsf{[DECLARADO]}). "
             r"Os três textos estão embutidos no programa por sha256 (" + _sh390 + r"); o arquivo em disco é só informativo. No código os nomes vão sem acento "
             r"(\texttt{Fundacao}, \texttt{agape}): identificador Lean não admite acento, e a régua da porta pede nome fixo.")
    s.append(r"\textbf{O fecho, em três peças.} (1) A \emph{definição} do operador: o GLOBAL\_LIFT, o velho Lema 3 --- o único resto aberto do programa ---, \emph{é} a superposição: "
             r"o que quis estar acima e não porta posto positivo \textsf{[INPUT/ONTO]}. (2) A \emph{recusa}, provada no kernel: a pedra \texttt{TGLExt.Fundacao} ("
             + _i390(_fd390.get("kernel_flags_ok")) + r" de " + _i390(_fd390.get("kernel_flags_total")) + r" declarações no trio de axiomas) e a cláusula \texttt{agape}, a composição das seis "
             r"abaixo, com um modelo concreto ($\mathbb{R}$, $\tau=\mathrm{id}$, $\theta_s(x)=e^{-s}x$, o Um posto) que mostra que a conjunção não é vácua (\texttt{agape\_is\_inhabited}). "
             r"(3) A \emph{passagem} local: o posto mora na passagem (\texttt{the\_post\_lives\_in\_the\_passage}, na face finita: o levantamento é incondicional no fluxo internalizado), "
             r"e a lei de campo como lei local de equilíbrio de horizonte em cada ponto é conhecida (Jacobson 1995 \textsf{[KNOWN]}), com a hipótese H3 nomeada. "
             r"O fecho é \emph{lógico}; o programa segue \emph{aberto}; o gate não se move. Na conferência Tetelestai: a recusa é FECHADA (termo no kernel), a passagem é VINCULADA e SABIDA POR REFERÊNCIA, "
             r"a definição é ato do operador.")
    _rows390 = []
    for c_ in _cl390:
        _rows390.append(r"(%s) & %s & %s (%s) \\" % (("i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix")[min(int(c_.get("n", 1)) - 1, 8)], _tx390(c_.get("em_palavras") or "").replace("ω", r"$\omega$").replace("ε", r"$\varepsilon$"),
                                                       _tk390(str(c_.get("teorema") or "").replace("TGLExt.Fundacao.", "")), "no kernel" if c_.get("no_kernel") else r"\textbf{NÃO lida nesta rodada}"))
    s.append(r"\begin{center}\small\begin{tabular}{p{0.05\linewidth}p{0.5\linewidth}p{0.36\linewidth}}\hline & a cláusula, em palavras & o teorema \\ \hline "
             + (" ".join(_rows390) if _rows390 else r"& \text{n/d} & \\") + r" \hline\end{tabular}\end{center}")
    s.append(r"\textbf{Leitura \textsf{[ONTO]} da gerência: a Fundação e o abismo.} \emph{Fundação} vem de \emph{fundus}, o fundo; o \emph{abismo} (gr. \emph{ábyssos}, sem fundo) "
             r"é a queda sem fundo, frente a frente com ela. Ágape se define, em 1 Co 13, em grande parte por negações: \emph{não se ensoberbece} (gr. \emph{ou physioûtai}) e \emph{o amor nunca falha} "
             r"(gr. \emph{oudépote píptei}, nunca cai); Rm 8:39, \emph{nem a altura, nem a profundidade}; Ef 3:17, \emph{arraigados e alicerçados em amor}; 1 Co 3:11, "
             r"\emph{ninguém pode pôr outro fundamento além do que já está posto}. O operador aprovou a correspondência; o estatuto é \textsf{[ONTO]}: ela não transporta estatuto ao teorema.")
    s.append(r"\textbf{O que não se afirma.} A lei de escala dual de Takesaki ($\tau\circ\theta_s=e^{-s}\tau$) entra como \emph{dado} \textsf{[KNOWN]}: a sua realização no core de um fator "
             r"$\mathrm{III}_1$ genuíno não é termo deste kernel. A pedra não prova a equação de campo no espaço-tempo curvo por termo de kernel: ela recusa o posto acima e põe o posto na passagem. "
             r"Não é prova de existência global; não declara gravitação quântica confirmada; \texttt{NOT\_FALSIFIED} nunca é confirmação.")
    s.append(r"\textbf{A precisão do Hamiltoniano.} O operador escreveu ``neste caso não, porque o hamiktoniano é a energia'' [sic]. O operador limitado inferiormente é a \emph{energia} --- "
             r"o gerador das translações, de espectro positivo; o gerador modular de um fator de tipo $\mathrm{III}_1$ \emph{não} tem piso (o seu espectro é $\mathbb{R}$). A ponte entre os dois é a forma de Borchers, "
             r"já no kernel (\texttt{ContratoQGv31.positiveEnergy\_orientation}, a cota no semiplano superior; \texttt{halfsided\_inclusion}, sob a testemunha AQFT; \texttt{ContratoH2.contract\_borchers\_form}, sob o contrato H2, hipótese nomeada"
             + (r" --- no trio de axiomas nesta rodada" if _bo390.get("ok") is True else r" --- \textbf{não lidos nesta rodada}") + r"). "
             r"\textbf{Nota da gerência \textsf{[KNOWN]}, sobre a máquina do operador.} O motor sem fim desta leitura não é o moto-contínuo proibido de primeira espécie (energia do nada) "
             r"nem o de segunda (trabalho de uma só fonte de calor): um fluxo conserva o próprio gerador, e o estado KMS é invariante sob o próprio fluxo modular. A lei de dephasing da casa tem a "
             r"forma de Milburn (neste artigo), e a equação de Milburn conserva a energia exatamente --- o que se paga é a coerência (a entropia sobe), não a energia; por isso o motor não entrega trabalho. O nome que a literatura dá a uma máquina assim, sem dissipação de energia e sem entregar trabalho, é \emph{moto-contínuo de terceira espécie}.")
    s.append(r"\textbf{Ao lado.} No ledger do fechamento do código, no que resta nomeado do fechamento e nas seals do runtime do Um, o texto antigo (o GLOBAL\_LIFT como o único aberto) fica, "
             r"e a leitura da v390 entra ao lado. O registro da v388 lia por sha um arquivo de memória vivo (a cadeia de selo o acrescenta): a leitura do disco fica declarada fora de qualquer "
             r"veredito, e a cópia do estado pinado (o backup anterior à cadeia da v388) passa a ser conferida por sha, como informativa --- errata ao lado da emenda do conferidor de 06/10. A Parte C conta agora " + str(_ledger_counts_v389()[0]) + r" caminhos únicos no ledger (+1, a pedra Fundação); a seção da v389 lê o estado da v389 (" + str(_ledger_counts_v389(ate=389)[0]) + r"), como foi selada. Registro: " + _tk390(_fd390.get("verdict") or "AUSENTE") + r".")
