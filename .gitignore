# ── Central de Patentes — .gitignore (blindagem: segredos e confidenciais NUNCA sobem) ──

# segredos e configuração sensível
backend/central.env
backend/*.env
*.key
*.pem
.env
.env.*

# CONFIDENCIAIS (engenharia nativa IALD — jamais em repositório algum)
**/iald_stack_v7*
**/iald_psion_state*
**/iald_web_server*
**/token_huggin*

# venvs / dependências
backend/.venv/
**/.venv/
**/venv/
node_modules/

# build / cache
frontend/dist/
**/__pycache__/
*.pyc
*.pyo

# dados vivos reconstrutíveis (índice + logs + auditoria + backups)
backend/data/
logs/
backups/
*.db
*.db-wal
*.db-shm
*.log

# scratch / temporários
scratchpad*/
sd_*/
*.acom

# SO
Thumbs.db
.DS_Store

# wheels baixados por IPv4 (contorno do IPv6 quebrado) — binario de terceiro, nao versionar
.wheels_ipv4/

# Monitor de patentes — store de runtime (regenerado; last_run/audit mudam a cada rodada)
andamentos/last_run.json
andamentos/deadline_audit.json
andamentos/andamentos_para_o_compiler.md

# logs de runtime do uvicorn (o launcher redireciona a saida para ca)
backend/logs/
backend/uvicorn*.log

