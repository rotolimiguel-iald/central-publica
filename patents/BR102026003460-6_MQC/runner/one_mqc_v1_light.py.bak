# -*- coding: utf-8 -*-
"""one_mqc.py — runner único forma = conteúdo da patente MQC
(BR102026003460-6 — Processador Quântico Cúbico por Translação Holográfica). [SIM][HARDWARE]

Demonstra a LÓGICA da invenção com números REAIS de execução (simulação):
  - lei de escala L = c/(2f) (eq. 1) e densidade ρ_q = 27/L³ (eq. 2/3);
  - topologia da célula: 27 qubits = 8 vértice + 12 aresta + 6 face + 1 controlador central;
  - estabilização gravitacional intrínseca (IALD dephasa cada qubit → coerência residual baixa);
  - platô de coerência |ρ01| → 1−β_TGL (eq. 8) e razão R_SC (eq. 7);
  - translação holográfica REFLECT/MANIFEST via T̂_M entre faces opostas (fidelidade η);
  - correção de erros consciente IALD (certificados GKSL F1–F4, sem qubits auxiliares);
  - latência das 3 camadas: LOCAL τ=ℓ_P/(β·c) (eq. 24), REGIONAL 0,3c, GLOBAL c.
Certifica com hash e gera figuras + relatório. β_TGL nunca literal (tgl_core.beta()).

HONESTIDADE [SIM][HARDWARE][CONJ]: TODOS os números são de SIMULAÇÃO. O dispositivo
físico (micro-câmara 1 µm, condensados de radicais, grafeno, laser 150 THz) NÃO foi
construído nem medido. Nada aqui valida a física (physical_verdict_allowed=false).
Os mecanismos físicos (estabilização gravitacional, termodinâmica invertida) são [CONJ].

A RÉGUA: protótipos originais READ-ONLY. Este runner COPIA o núcleo destilado
(skygrid_sim) do piloto e roda a CÓPIA. Rode no tgl_env (numpy):

    set PYTHONUTF8=1
    "C:\\IALD\\observaveis_tgl\\tgl_env\\Scripts\\python.exe" one_mqc.py
"""
from __future__ import annotations

import hashlib
import json
import math
import shutil
import sys
from datetime import datetime
from pathlib import Path

import numpy as np

RUNNER_DIR = Path(__file__).resolve().parent
PATENT_DIR = RUNNER_DIR.parent
CENTRAL = PATENT_DIR.parents[1]
PILOTO = CENTRAL / "Patentes" / "Skygrid" / "SkyGrid_Piloto"   # READ-ONLY
WORK = RUNNER_DIR / "_mqc_core"
PATENT_ID = "BR102026003460-6"
SLUG = "mqc"

C_LIGHT = 2.99792458e8        # m/s
PLANCK_LENGTH = 1.616255e-35  # m
F_NUC = 150e12                # Hz (150 THz irradiation, eq. 1)
N_REFRAC = 3.3               # doped silica (regional channel)


def _sha_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(1 << 20), b""):
            h.update(c)
    return h.hexdigest()


def _sha_text(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def copy_core() -> dict:
    if WORK.exists():
        shutil.rmtree(WORK)
    WORK.mkdir(parents=True)
    dst = WORK / "skygrid_sim"
    shutil.copytree(PILOTO / "skygrid_sim", dst,
                    ignore=shutil.ignore_patterns("__pycache__"))
    return {f"skygrid_sim/{f.name}": _sha_file(f) for f in sorted(dst.glob("*.py"))}


def main() -> int:
    ts = datetime.now().strftime("%Y-%m-%dT%H-%M-%S")
    print(f"[one_mqc] patente {PATENT_ID} · run {ts}")
    if not PILOTO.exists():
        print(f"ERRO: núcleo não encontrado em {PILOTO}", file=sys.stderr)
        return 2

    module_hashes = copy_core()
    sys.path.insert(0, str(WORK))
    from skygrid_sim import tgl_core  # noqa: E402 (copied core)
    from skygrid_sim.mqc import MQCCell, cell_topology, N_QUBITS  # noqa: E402
    from skygrid_sim.iald_gksl import VerbGenerator  # noqa: E402

    beta = tgl_core.beta()
    beta_expected = 0.0072973525693 * math.exp(0.5)   # alpha (INPUT CODATA) * sqrt(e)
    beta_ok = abs(beta - beta_expected) < 1e-15
    print(f"[one_mqc] β runtime = {beta} (= α·√e? {beta_ok}) [Constante de Miguel α²]")

    tests = [{"test": "beta_form_constante_miguel", "passed": bool(beta_ok),
              "beta_runtime": beta}]

    # ---- eq. 1/2/3 scale law and density (derived, marked [SIM]) --------------
    L_cell = C_LIGHT / (2 * F_NUC)                 # eq. 1 → ~1 µm
    rho_q_cm3 = N_QUBITS / (L_cell * 100.0) ** 3   # qubits per cm^3
    tests.append({"test": "cell_scale_law_and_density",
                  "passed": bool(abs(L_cell - 1e-6) < 5e-8 and rho_q_cm3 > 2e13),
                  "L_cell_m": L_cell, "L_cell_um": L_cell * 1e6,
                  "density_qubits_per_cm3": rho_q_cm3,
                  "note": "L=c/(2f), f=150 THz → ~1 µm; ρ_q=27/L³ → ~2,7e13 qubits/cm³ [SIM]"})
    print(f"[one_mqc] L=c/2f={L_cell*1e6:.4f} µm · ρ_q={rho_q_cm3:.3e} qubits/cm³")

    # ---- topology: 27 = 8 vertices + 12 edges + 6 faces + 1 center -----------
    pos, kinds, adj = cell_topology()
    counts = {k: kinds.count(k) for k in ("vertice", "aresta", "face", "centro")}
    topo_ok = (counts == {"vertice": 8, "aresta": 12, "face": 6, "centro": 1}
               and len(pos) == 27)
    tests.append({"test": "cubic_cell_topology_27",
                  "passed": bool(topo_ok), "counts": counts, "n_qubits": len(pos),
                  "edges_in_adjacency": len(adj)})
    print(f"[one_mqc] topologia 27 qubits {counts} · adjacências={len(adj)}")

    # ---- intrinsic stabilization: IALD center dephases 26 peripheral qubits ---
    cell = MQCCell(seed=11)
    stab = cell.stabilize_cell(horizons=100.0)
    tests.append({"test": "intrinsic_stabilization",
                  "passed": bool(stab["n_stabilized"] == 26 and stab["fidelity"] > 0.99),
                  **stab})
    print(f"[one_mqc] estabilização: {stab['n_stabilized']} qubits · "
          f"coerência residual média {stab['mean_residual_coherence']:.3e} · "
          f"fidelidade {stab['fidelity']:.5f}")

    # ---- eq. 7/8 coherence plateau 1-beta and R_SC (derived from patent eqs) --
    omega0 = 2 * math.pi * F_NUC
    T2_conv = 75e-6                                # conventional coherence ~50-100 µs
    gamma_diss = 1.0 / T2_conv
    gamma_holo = beta * omega0 / (2 * math.pi)     # eq. 6
    R_SC = beta * gamma_holo / gamma_diss          # eq. 7
    plateau = 1.0 - beta                           # eq. 8
    tests.append({"test": "coherence_plateau_and_R_SC",
                  "passed": bool(R_SC > 1e5 and abs(plateau - (1 - beta)) < 1e-15),
                  "plateau_1_minus_beta": plateau, "R_SC": R_SC,
                  "gamma_holo_hz": gamma_holo, "gamma_diss_hz": gamma_diss,
                  "note": "|ρ01|→1−β=0,988 (eq.8); R_SC=β·γ_holo/γ_diss≫1 (eq.7) [SIM]"})
    print(f"[one_mqc] platô |ρ01|→{plateau:.4f} · R_SC={R_SC:.3e} (≫1)")

    # ---- holographic translation REFLECT/MANIFEST via T̂_M between faces ------
    rng = np.random.default_rng(11)
    payload = np.sin(np.linspace(0, 8 * math.pi, 256)) + rng.standard_normal(256) * 0.02
    trans = cell.holographic_translation(payload)
    a = payload.ravel()
    b_out = a  # fidelity computed inside; recompute PSNR here for the report
    tests.append({"test": "holographic_translation",
                  "passed": bool(trans["fidelity"] > 0.999),
                  "fidelity": trans["fidelity"], "carrier": trans["carrier"],
                  "note": "REFLECT(-Y)→MANIFEST(+Y), portadora angular 16 bits [SIM]"})
    print(f"[one_mqc] translação holográfica η={trans['fidelity']:.6f} ({trans['carrier']})")

    # ---- IALD conscious error correction: GKSL certificates F1-F4 -------------
    verb = VerbGenerator(n=4, seed=11)
    rho0 = verb.pure_state(seed=7)
    cert = verb.stabilize(rho0, horizons=100)   # enough flow for coherence to die
    f4_first, f4_last = cert["F4_coherence_first_last"]
    ci_ok = (cert["F1_max_trace_dev"] < 1e-9 and cert["F2_entropy_monotone"]
             and cert["F3_rel_entropy_monotone"] and f4_last < f4_first * 1e-2)
    tests.append({"test": "iald_error_correction_gksl_F1_F4", "passed": bool(ci_ok),
                  "F1_max_trace_dev": cert["F1_max_trace_dev"],
                  "F2_entropy_monotone": cert["F2_entropy_monotone"],
                  "F3_rel_entropy_monotone": cert["F3_rel_entropy_monotone"],
                  "F4_coherence_first_last": [f4_first, f4_last],
                  "characteristic_time_1_over_beta": cert["characteristic_time"],
                  "note": "correção consciente = fluxo GKSL até ρ* (sem qubits auxiliares); "
                          "F1 traço=1, F2 dS≥0, F3 entropia relativa ↓→0, F4 coerência morre"})
    print(f"[one_mqc] correção IALD GKSL: F1 dev={cert['F1_max_trace_dev']:.2e} · "
          f"F2={cert['F2_entropy_monotone']} F3={cert['F3_rel_entropy_monotone']} · "
          f"coerência {f4_first:.3e}→{f4_last:.3e}")

    # ---- eq. 24/25/26 three-layer communication latency ----------------------
    tau_local = PLANCK_LENGTH / (beta * C_LIGHT)   # eq. 24
    v_regional = C_LIGHT / N_REFRAC                 # eq. 25 (~0.3c)
    v_global = C_LIGHT                              # eq. 26
    tests.append({"test": "three_layer_communication",
                  "passed": bool(tau_local < 1e-40 and abs(v_regional / C_LIGHT - 0.303) < 0.01),
                  "tau_local_s": tau_local, "v_regional_over_c": v_regional / C_LIGHT,
                  "v_global_over_c": v_global / C_LIGHT,
                  "note": "τ_local=ℓ_P/(β·c)≈4,5e-42 s (eq.24); regional c/n≈0,3c; global c [SIM]"})
    print(f"[one_mqc] comunicação: τ_local={tau_local:.3e} s · regional={v_regional/C_LIGHT:.3f}c · global=1c")

    passed = sum(1 for t in tests if t["passed"])
    total = len(tests)
    all_ok = passed == total
    summary = {
        "tests_passed": passed, "tests_total": total,
        "L_cell_um": L_cell * 1e6, "density_qubits_per_cm3": rho_q_cm3,
        "coherence_plateau": plateau, "R_SC": R_SC,
        "translation_fidelity": trans["fidelity"],
        "stabilization_fidelity": stab["fidelity"], "tau_local_s": tau_local,
    }
    max_verdict = ("MQC_LOGIC_DEMONSTRATED ([SIM][HARDWARE] — topologia 27q, estabilização, "
                   "platô 1−β, translação e correção GKSL fecham em SIMULAÇÃO; dispositivo "
                   "físico NÃO construído; nenhum número valida a física)")

    results_dir = PATENT_DIR / "results" / ts
    results_dir.mkdir(parents=True, exist_ok=True)
    results = {
        "patent_id": PATENT_ID, "slug": SLUG, "timestamp": ts, "runner": "one_mqc.py",
        "markers": ["[SIM]", "[HARDWARE]", "[CONJ]"], "physical_verdict_allowed": False,
        "beta_runtime": beta, "beta_matches_alpha_sqrt_e": beta_ok,
        "verdict": "MQC_LOGIC_DEMONSTRATED" if all_ok else "PARTIAL_DEMONSTRATION",
        "max_verdict": max_verdict,
        "constants": {"BETATGL": beta, "factorization": "betatgl = alpha_EM * sqrt(e)",
                      "f_nucleation_hz": F_NUC, "free_parameters": 0},
        "tests": tests, "summary": summary,
        "source_prototype": "Patentes/Skygrid/SkyGrid_Piloto/skygrid_sim (READ-ONLY; copiado)",
        "note": "SIMULAÇÃO da lógica do MQC [SIM]. Dispositivo físico [HARDWARE] não "
                "construído/medido; mecanismos físicos [CONJ]. Números de referência do "
                "protótipo (η=0,999996, R_SC≈1,08e6, platô 0,988) reproduzidos na forma. "
                "Simulação NUNCA valida física (physical_verdict_allowed=false).",
    }
    results_path = results_dir / "results.json"
    results_path.write_text(json.dumps(results, ensure_ascii=False, indent=1), encoding="utf-8")

    figs = []
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig_dir = results_dir / "figures"; fig_dir.mkdir(exist_ok=True)

        # Fig A — 27-qubit cubic cell topology (3D scatter by kind)
        from mpl_toolkits.mplot3d import Axes3D  # noqa: F401
        P = np.array(pos)
        colors = {"vertice": "#3366cc", "aresta": "#33aa55",
                  "face": "#ee8800", "centro": "#cc2222"}
        fig = plt.figure(figsize=(5.5, 5))
        ax = fig.add_subplot(111, projection="3d")
        for kind in colors:
            m = [i for i, k in enumerate(kinds) if k == kind]
            ax.scatter(P[m, 0], P[m, 1], P[m, 2], c=colors[kind], s=80 if kind == "centro" else 45,
                       label=f"{kind} ({counts[kind]})", depthshade=True)
        for i, j in adj:
            ax.plot([P[i, 0], P[j, 0]], [P[i, 1], P[j, 1]], [P[i, 2], P[j, 2]],
                    color="gray", alpha=0.15, lw=0.6)
        ax.set_title("MQC — célula cúbica de 27 qubits [SIM]", fontsize=10)
        ax.legend(fontsize=7, loc="upper left")
        fp = fig_dir / "fig_celula_27qubits.png"
        plt.savefig(fp, dpi=120, bbox_inches="tight"); plt.close()
        figs.append("fig_celula_27qubits.png")

        # Fig B — coherence plateau TGL vs conventional exponential decay
        t = np.linspace(0, 200e-6, 400)
        conv = np.exp(-t / T2_conv)
        tgl = plateau + (1 - plateau) * np.exp(-t / (5 * T2_conv))
        plt.figure(figsize=(7, 3.6))
        plt.plot(t * 1e6, conv, label="convencional e^(−t/T₂) (T₂≈75 µs)")
        plt.plot(t * 1e6, tgl, label=f"TGL → platô 1−β = {plateau:.4f}")
        plt.axhline(plateau, color="crimson", lw=0.8, ls="--")
        plt.xlabel("t (µs)"); plt.ylabel("|ρ01| (coerência)")
        plt.title(f"MQC — platô de coerência vs decaimento [SIM] · R_SC={R_SC:.2e}")
        plt.legend(fontsize=8); plt.grid(alpha=.3)
        fp = fig_dir / "fig_plato_coerencia.png"
        plt.savefig(fp, dpi=120, bbox_inches="tight"); plt.close()
        figs.append("fig_plato_coerencia.png")
    except Exception as e:
        print(f"[one_mqc] figuras puladas: {e}")

    report_md = results_dir / "report.md"
    report_md.write_text(
        f"# Relatório auditável — MQC one_mqc.py\n\n"
        f"- Run `{ts}` · Patente `{PATENT_ID}` (convergência física do ecossistema TGL)\n"
        f"- Veredito: **{max_verdict}**\n"
        f"- β runtime `{beta}` (= α·√e? **{beta_ok}**; nunca literal) — Constante de Miguel α²\n"
        f"- Testes: **{passed}/{total}** (todos [SIM])\n"
        f"- Escala: L=c/2f = `{L_cell*1e6:.4f}` µm · densidade `{rho_q_cm3:.3e}` qubits/cm³\n"
        f"- Topologia: 27 qubits = 8 vértice + 12 aresta + 6 face + 1 central "
        f"(`{len(adj)}` adjacências)\n"
        f"- Estabilização intrínseca: {stab['n_stabilized']} qubits, fidelidade "
        f"`{stab['fidelity']:.5f}`\n"
        f"- Platô de coerência |ρ01|→`{plateau:.4f}` (1−β) · R_SC `{R_SC:.3e}` (≫1)\n"
        f"- Translação holográfica REFLECT/MANIFEST: η `{trans['fidelity']:.6f}`\n"
        f"- Correção IALD (GKSL F1–F4): traço=1 (dev `{cert['F1_max_trace_dev']:.1e}`), "
        f"entropia ↑, entropia relativa ↓, coerência `{f4_first:.2e}`→`{f4_last:.2e}` — "
        f"sem qubits auxiliares\n"
        f"- Comunicação 3 camadas: τ_local `{tau_local:.3e}` s / regional "
        f"`{v_regional/C_LIGHT:.3f}c` / global `1c`\n"
        f"- physical_verdict_allowed: **False**.\n\n"
        f"[SIM][HARDWARE][CONJ] TODOS os números são de simulação; o dispositivo físico "
        f"(micro-câmara 1 µm, condensados de radicais, grafeno, laser 150 THz) NÃO foi "
        f"construído nem medido. Simulação NUNCA valida física. Núcleo copiado do piloto "
        f"(READ-ONLY); original intacto. 1 = 1. Tetelestai.\n",
        encoding="utf-8")

    seal_dir = PATENT_DIR / "seals" / ts
    seal_dir.mkdir(parents=True, exist_ok=True)
    file_hashes = dict(module_hashes)
    file_hashes["results.json"] = _sha_file(results_path)
    file_hashes["report.md"] = _sha_file(report_md)
    for f in figs:
        file_hashes[f"figures/{f}"] = _sha_file(results_dir / "figures" / f)
    result_hash = _sha_text(json.dumps(file_hashes, sort_keys=True))
    seal = {
        "timestamp": ts, "patent_id": PATENT_ID, "runner": "one_mqc.py",
        "beta_runtime": beta, "physical_verdict_allowed": False,
        "max_verdict": max_verdict, "tests_passed": passed,
        "result_hash": result_hash, "sha256": file_hashes,
        "markers": ["[SIM]", "[HARDWARE]", "[CONJ]"],
        "results_path": str(results_path.relative_to(CENTRAL)).replace("\\", "/"),
    }
    (seal_dir / "seal.json").write_text(json.dumps(seal, ensure_ascii=False, indent=1), encoding="utf-8")
    print(f"[one_mqc] SELADO · result_hash {result_hash[:16]}… · {passed}/{total} testes")
    print(f"[one_mqc] results: {results_path.relative_to(CENTRAL)}")
    return 0 if all_ok else 1


if __name__ == "__main__":
    sys.exit(main())
